{
  "name": "vnedge-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:browser": "tsc --noEmit -p tsconfig.e2e.json && playwright test",
    "format": "prettier --write src e2e test playwright.config.ts",
    "format:check": "prettier --check src e2e test playwright.config.ts"
  },
  "dependencies": {
    "@luxalgo/vela": "0.10.19",
    "@luxalgo/vela-pinets": "0.3.5",
    "@tanstack/react-query": "^5.90.0",
    "pinets": "0.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.0"
  }
}
