//@version=5
indicator(title="SuperTrend Fisher [AlgoAlpha]", shorttitle = "AlgoAlpha - 🦈 SuperTrend Fisher", format=format.price, precision=2)
period_ = input.int(14, title="Fair-value Period", minval=1)
leng = input.int(14, title="EMA Length", minval=1)
len = input.int(9, minval=1, title="Fisher Period")
stFactor = input.float(0.3, title="SuperTrend Factor", minval=0.1, step=0.1)
stPeriod = input.int(10, title="SuperTrend Period", minval=1)
green = input.color(#00ffbb, "Up Color") //#00ffbb
red = input.color(#ff1100, "Down Color") //#ff1100
l = 20

atrr(float source, int atr_length) =>
	highest = ta.highest(source, atr_length)
    lowest = ta.lowest(source, atr_length)
    trueRange = na(highest[1]) ? highest - lowest : math.max(math.max(highest - lowest, math.abs(highest - source[1])), math.abs(lowest - source[1]))
    ta.rma(trueRange, atr_length)

supertrend(factor, atrPeriod, srcc) =>
    src = srcc
    atr = atrr(srcc, atrPeriod)
    upperBand = src + factor * atr
    lowerBand = src - factor * atr
    prevLowerBand = nz(lowerBand[1])
    prevUpperBand = nz(upperBand[1])

    lowerBand := lowerBand > prevLowerBand or src[1] < prevLowerBand ? lowerBand : prevLowerBand
    upperBand := upperBand < prevUpperBand or src[1] > prevUpperBand ? upperBand : prevUpperBand
    int stDirection = na
    float stValue = na
    prevStValue = stValue[1]
    if na(atr[1])
        stDirection := 1
    else if prevStValue == prevUpperBand
        stDirection := src > upperBand ? -1 : 1
    else
        stDirection := src < lowerBand ? 1 : -1
    stValue := stDirection == -1 ? lowerBand : upperBand
    [stValue, stDirection]

barsback = period_/2 + 1
ma = ta.sma(close, period_)
dpo = close - ma[barsback]
sd = dpo / (ta.ema(high - low, period_)) * 100

src = sd
high_ = ta.highest(src, len)
low_ = ta.lowest(src, len)
value = 0.0
round_(val) => val > .99 ? .999 : val < -.99 ? -.999 : val
value := round_(.66 * ((src - low_) / (high_ - low_) - .5) + .67 * nz(value[1]))
fish1 = 0.0
fish1 := .5 * math.log((1 + value) / (1 - value)) + .5 * nz(fish1[1])
fish1 := ta.hma(fish1, l)
[stValue, stDirection] = supertrend(stFactor, stPeriod, fish1)
hline(0, "0", color=#797979)

p1 = plot(fish1, color = fish1 > stValue ? green : red)
p2 = plot(stValue, color = fish1 > stValue ? green : red)
q = plot(ta.ema(fish1, 3), color = color.white, display = display.none)
plot(ta.ema(fish1, leng), color = color.gray)

// Overbought and Oversold Bands
obLevel = 4.0
osLevel = -4.0
obColor = color.new(#ff1100, 90)
osColor = color.new(#00ffbb, 90)

// Filled Bands
obupper = plot(obLevel, "Overbought", obColor)
obmid = plot(obLevel + 0.9, "Overbought Mid", obColor)
oblower = plot(obLevel + 2, "Overbought Lower", obColor)
osupper = plot(osLevel, "Oversold", osColor)
osmid = plot(osLevel - 0.9, "Oversold Mid", osColor)
oslower = plot(osLevel - 2, "Oversold Lower", osColor)

fill(obupper, oblower, color.new(obColor, 90))
fill(osupper, oslower, color.new(osColor, 90))
fill(obmid, oblower, color.new(obColor, 90))
fill(osmid, oslower, color.new(osColor, 90))

fill(p1, p2, fish1, stValue, fish1 > stValue ? color.new(green, 50) : color.new(red, 50), color.new(chart.bg_color, 80))

// Alerts for crossing the zero line
alertcondition(ta.crossover(fish1, 0), title="Cross Above Zero", message="The Fisher indicator has crossed above the zero line on {{exchange}}:{{ticker}}.")
alertcondition(ta.crossunder(fish1, 0), title="Cross Below Zero", message="The Fisher indicator has crossed below the zero line on {{exchange}}:{{ticker}}.")

// Alerts for crossing the SuperTrend
alertcondition(ta.crossover(fish1, stValue), title="Cross Above SuperTrend", message="The Fisher indicator has crossed above the SuperTrend on {{exchange}}:{{ticker}}.")
alertcondition(ta.crossunder(fish1, stValue), title="Cross Below SuperTrend", message="The Fisher indicator has crossed below the SuperTrend on {{exchange}}:{{ticker}}.")
