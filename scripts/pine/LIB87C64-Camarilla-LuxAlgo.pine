//@version=6
indicator("Camarilla", "Camarilla", overlay = true, format = format.price, max_labels_count = 20)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
const float RANGE_SCALE = 1.1

const color RES_COLOR     = #f23645 // resistance rungs H1 to H5
const color SUP_COLOR     = #089981 // support rungs L1 to L5
const color NEUTRAL_COLOR = #787b86 // rotation band and rotation day type - structure

const color DASH_BG     = #161616
const color DASH_FRAME  = #2E2E2E
const color DASH_HEADER = #808080
const color DASH_TEXT   = #DBDBDB

const int MINOR_TRANSP = 55
const int EXT_TRANSP   = 35

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
anchorInput = input.string("Daily", "Anchor Period", options = ["Daily", "Weekly", "Monthly"], group = "Settings",
  tooltip = "Prior period supplying the high, low and close the ladder is built from. Daily bars are the standard input; weekly and monthly Camarilla apply the same math to larger bars. Use a chart timeframe below the anchor.")

showL1Input = input.bool(true, "H1 / L1", group = "Levels",
  tooltip = "Innermost rungs, offset from the prior close by 1.1/12 of the prior range.")
showL2Input = input.bool(true, "H2 / L2", group = "Levels",
  tooltip = "Inner rungs, offset from the prior close by 1.1/6 of the prior range.")
showL3Input = input.bool(true, "H3 / L3", group = "Levels",
  tooltip = "Reversion rungs, offset from the prior close by 1.1/4 of the prior range. The classic play fades tests of H3 and L3 while the session holds inside the band between them.")
showL4Input = input.bool(true, "H4 / L4", group = "Levels",
  tooltip = "Breakout rungs, offset from the prior close by 1.1/2 of the prior range. Acceptance beyond H4 or L4 marks a potential trend day.")
showL5Input = input.bool(true, "H5 / L5", group = "Levels",
  tooltip = "Non-standard extensions used as trend-day targets. This script uses the common variant H5 = (H / L) × C, with L5 placed the same distance below the close.")

resColorInput = input.color(RES_COLOR, "Resistance", inline = "colors", group = "Style",
  tooltip = "Color of the resistance rungs (H1 to H5).")
supColorInput = input.color(SUP_COLOR, "Support", inline = "colors", group = "Style",
  tooltip = "Color of the support rungs (L1 to L5).")

rotFillInput  = input.bool(true, "Rotation Band Fill", inline = "fill", group = "Style",
  tooltip = "Shade the band between L3 and H3 where range-day rotation tactics apply.")
rotColorInput = input.color(color.new(NEUTRAL_COLOR, 90), "", inline = "fill", group = "Style",
  tooltip = "Fill color of the L3 - H3 rotation band.")

lineWidthInput  = input.int(1, "Line Width", minval = 1, maxval = 4, group = "Style",
  tooltip = "Width of the level lines.")
showLabelsInput = input.bool(true, "Level Labels", group = "Style",
  tooltip = "Display the rung name and price to the right of the current ladder.")

showDashInput = input.bool(true, "Day-Type Panel", group = "Dashboard",
  tooltip = "Classify the session by where it opened relative to the ladder: between L3 and H3 favors rotation tactics, beyond H4 or L4 favors continuation.")
dashPosInput  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Dashboard",
  tooltip = "Position of the day-type panel on the chart.")
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = "Dashboard",
  tooltip = "Text size of the day-type panel.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Level line color, blanked on the anchor change bar to break the steps between ladders
levelColor(color baseColor, int transp, bool isNewPeriod) =>
    isNewPeriod ? color(na) : color.new(baseColor, transp)

// Push a right-side name + price label for one rung of the current ladder
drawLevelLabel(array<label> labelArray, float price, string levelName, color labelColor) =>
    if not na(price)
        labelArray.push(label.new(bar_index + 3, price, levelName + " " + str.tostring(price, format.mintick),
          color = #00000000, textcolor = labelColor, style = label.style_label_left, size = size.small))

//---------------------------------------------------------------------------------------------------------------------}
// Camarilla ladder
//---------------------------------------------------------------------------------------------------------------------{
anchorTf = switch anchorInput
    "Daily"  => "D"
    "Weekly" => "W"
    => "M"

newPeriod = timeframe.change(anchorTf)

// Completed prior anchor period high / low / close (confirmed data, non-repainting)
[prevHigh, prevLow, prevClose] = request.security(syminfo.tickerid, anchorTf, [high[1], low[1], close[1]],
  lookahead = barmerge.lookahead_on)

chartSeconds  = timeframe.in_seconds()
anchorSeconds = timeframe.in_seconds(anchorTf)
anchorValid   = not na(chartSeconds) and chartSeconds < anchorSeconds

levelsValid = anchorValid and not na(prevHigh) and not na(prevLow) and not na(prevClose) and prevLow > 0
camRange    = prevHigh - prevLow

// Offsets scale the prior range by 1.1, every rung is measured from the prior close (no averaged pivot)
float h1 = levelsValid ? prevClose + camRange * RANGE_SCALE / 12 : na
float h2 = levelsValid ? prevClose + camRange * RANGE_SCALE / 6  : na
float h3 = levelsValid ? prevClose + camRange * RANGE_SCALE / 4  : na
float h4 = levelsValid ? prevClose + camRange * RANGE_SCALE / 2  : na
float h5 = levelsValid ? prevHigh / prevLow * prevClose          : na
float l1 = levelsValid ? prevClose - camRange * RANGE_SCALE / 12 : na
float l2 = levelsValid ? prevClose - camRange * RANGE_SCALE / 6  : na
float l3 = levelsValid ? prevClose - camRange * RANGE_SCALE / 4  : na
float l4 = levelsValid ? prevClose - camRange * RANGE_SCALE / 2  : na
float l5 = levelsValid ? prevClose - (h5 - prevClose)            : na

//---------------------------------------------------------------------------------------------------------------------}
// Day type & level interactions
//---------------------------------------------------------------------------------------------------------------------{
// Session open location relative to the ladder selects the playbook
var float periodOpen = na

var bool brokeAboveH4 = false
var bool brokeBelowL4 = false

if newPeriod
    periodOpen   := open
    brokeAboveH4 := false
    brokeBelowL4 := false

[dayTypeText, dayTypeColor] = if na(periodOpen) or not levelsValid
    ["—", DASH_HEADER]
else if periodOpen > h4
    ["Breakout Up (open > H4)", supColorInput]
else if periodOpen < l4
    ["Breakout Down (open < L4)", resColorInput]
else if periodOpen > h3
    ["Upper Band (H3 - H4)", DASH_TEXT]
else if periodOpen < l3
    ["Lower Band (L3 - L4)", DASH_TEXT]
else
    ["Rotation (L3 - H3)", NEUTRAL_COLOR]

// Cross events, each computed unconditionally on every bar (on the boundary bar a cross would compare two ladders, so it is skipped below)
h3CrossUp = ta.crossover(high, h3)
l3CrossDn = ta.crossunder(low, l3)
h4CrossUp = ta.crossover(close, h4)
h4CrossDn = ta.crossunder(close, h4)
l4CrossDn = ta.crossunder(close, l4)
l4CrossUp = ta.crossover(close, l4)

// Reversion rung tests and breakout rung crossings
h3Test      = not newPeriod and h3CrossUp
l3Test      = not newPeriod and l3CrossDn
h4Breakout  = not newPeriod and h4CrossUp
l4Breakdown = not newPeriod and l4CrossDn

// Re-entry inside the ladder after a level-4 break is the standard false-breakout warning
falseBreakH4 = not newPeriod and brokeAboveH4 and h4CrossDn
falseBreakL4 = not newPeriod and brokeBelowL4 and l4CrossUp

if not na(h4) and close > h4
    brokeAboveH4 := true
if not na(l4) and close < l4
    brokeBelowL4 := true

//---------------------------------------------------------------------------------------------------------------------}
// Level lines & rotation band
//---------------------------------------------------------------------------------------------------------------------{
h5Plot = plot(showL5Input ? h5 : na, "H5", levelColor(resColorInput, EXT_TRANSP, newPeriod), lineWidthInput, plot.style_linebr)
h4Plot = plot(showL4Input ? h4 : na, "H4", levelColor(resColorInput, 0, newPeriod), lineWidthInput, plot.style_linebr)
h3Plot = plot(showL3Input ? h3 : na, "H3", levelColor(resColorInput, 0, newPeriod), lineWidthInput, plot.style_linebr)
h2Plot = plot(showL2Input ? h2 : na, "H2", levelColor(resColorInput, MINOR_TRANSP, newPeriod), lineWidthInput, plot.style_linebr)
h1Plot = plot(showL1Input ? h1 : na, "H1", levelColor(resColorInput, MINOR_TRANSP, newPeriod), lineWidthInput, plot.style_linebr)
l1Plot = plot(showL1Input ? l1 : na, "L1", levelColor(supColorInput, MINOR_TRANSP, newPeriod), lineWidthInput, plot.style_linebr)
l2Plot = plot(showL2Input ? l2 : na, "L2", levelColor(supColorInput, MINOR_TRANSP, newPeriod), lineWidthInput, plot.style_linebr)
l3Plot = plot(showL3Input ? l3 : na, "L3", levelColor(supColorInput, 0, newPeriod), lineWidthInput, plot.style_linebr)
l4Plot = plot(showL4Input ? l4 : na, "L4", levelColor(supColorInput, 0, newPeriod), lineWidthInput, plot.style_linebr)
l5Plot = plot(showL5Input ? l5 : na, "L5", levelColor(supColorInput, EXT_TRANSP, newPeriod), lineWidthInput, plot.style_linebr)

fill(h3Plot, l3Plot, rotFillInput ? rotColorInput : na, "Rotation Band (L3 - H3)")

//---------------------------------------------------------------------------------------------------------------------}
// Level labels
//---------------------------------------------------------------------------------------------------------------------{
var array<label> levelLabelArray = array.new<label>()

if barstate.islast
    if levelLabelArray.size() > 0
        for i = 0 to levelLabelArray.size() - 1
            label.delete(levelLabelArray.get(i))
        levelLabelArray.clear()
    if showLabelsInput
        drawLevelLabel(levelLabelArray, showL5Input ? h5 : na, "H5", color.new(resColorInput, EXT_TRANSP))
        drawLevelLabel(levelLabelArray, showL4Input ? h4 : na, "H4", resColorInput)
        drawLevelLabel(levelLabelArray, showL3Input ? h3 : na, "H3", resColorInput)
        drawLevelLabel(levelLabelArray, showL2Input ? h2 : na, "H2", color.new(resColorInput, MINOR_TRANSP))
        drawLevelLabel(levelLabelArray, showL1Input ? h1 : na, "H1", color.new(resColorInput, MINOR_TRANSP))
        drawLevelLabel(levelLabelArray, showL1Input ? l1 : na, "L1", color.new(supColorInput, MINOR_TRANSP))
        drawLevelLabel(levelLabelArray, showL2Input ? l2 : na, "L2", color.new(supColorInput, MINOR_TRANSP))
        drawLevelLabel(levelLabelArray, showL3Input ? l3 : na, "L3", supColorInput)
        drawLevelLabel(levelLabelArray, showL4Input ? l4 : na, "L4", supColorInput)
        drawLevelLabel(levelLabelArray, showL5Input ? l5 : na, "L5", color.new(supColorInput, EXT_TRANSP))

//---------------------------------------------------------------------------------------------------------------------}
// Day-type panel
//---------------------------------------------------------------------------------------------------------------------{
dashPosition = switch dashPosInput
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

dashTextSize = switch dashSizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    => size.normal

var table dashTable = showDashInput ? table.new(dashPosition, 2, 2, bgcolor = DASH_BG, border_width = 0,
  frame_color = DASH_FRAME, frame_width = 1) : na

if showDashInput and barstate.islast
    dashTable.cell(0, 0, "Anchor", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
    dashTable.cell(1, 0, anchorInput, text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    dashTable.cell(0, 1, "Open", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
    dashTable.cell(1, 1, dayTypeText, text_color = dayTypeColor, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(h3Test, "H3 Test", "Camarilla: price pushed up into H3 — reversion rung, the classic playbook watches for rejection to fade back through the band.")
alertcondition(l3Test, "L3 Test", "Camarilla: price pushed down into L3 — reversion rung, the classic playbook watches for rejection to fade back through the band.")
alertcondition(h4Breakout, "H4 Breakout", "Camarilla: close crossed above H4 — breakout rung, potential trend day toward H5.")
alertcondition(l4Breakdown, "L4 Breakdown", "Camarilla: close crossed below L4 — breakout rung, potential trend day toward L5.")
alertcondition(falseBreakH4, "False Breakout Above H4", "Camarilla: price re-entered the ladder after breaking H4 — standard false-breakout warning.")
alertcondition(falseBreakL4, "False Breakdown Below L4", "Camarilla: price re-entered the ladder after breaking L4 — standard false-breakout warning.")

//---------------------------------------------------------------------------------------------------------------------}
