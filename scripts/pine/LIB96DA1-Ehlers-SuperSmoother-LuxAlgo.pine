//@version=6
indicator("Ehlers SuperSmoother", shorttitle = "Ehlers SuperSmoother", overlay = true)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
SQRT2             = math.sqrt(2)
THREE_POLE_K      = 1.738 // John Ehlers' published pole-placement constant for the 3-pole variant
BULL_COLOR        = #089981
BEAR_COLOR        = #f23645
NEUTRAL_COLOR     = #787b86
FILL_PRICE_TRANSP = 60    // gradient transparency at the price end of the fill
FILL_FILT_TRANSP  = 100   // gradient transparency at the filter end of the fill

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput    = input.source(close, "Source", group = "Settings",
     tooltip = "Price series the filter smooths. Ehlers' published work commonly applies the filter to the close or the bar midpoint (hl2).")

lengthInput = input.int(10, "Cutoff Period", minval = 2, group = "Settings",
     tooltip = "Cutoff wavelength in bars. Price swings that take longer than this to complete pass through largely intact, while faster fluctuations are strongly attenuated. Ehlers frequently uses 10 bars — set it to the shortest swing you care about.")

polesInput  = input.int(2, "Poles", options = [2, 3], group = "Settings",
     tooltip = "Number of filter poles. 2 poles is Ehlers' common default with the best lag-to-smoothness balance; 3 poles rejects noise above the cutoff more steeply and draws a visibly smoother line at the cost of a little more lag.")

trendColorInput   = input.bool(true, "Slope Trend Coloring", group = "Style",
     tooltip = "Colors the SuperSmoother by its slope — bullish while the filter is rising, bearish while it is falling. Disable to draw the line in the neutral color.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Bullish color, used while the filter slope is rising and for bullish crossings/fill.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Bearish color, used while the filter slope is falling and for bearish crossings/fill.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral", group = "Style",
     tooltip = "Line color used when slope trend coloring is disabled, or when the slope is flat.")

showFillInput     = input.bool(true, "Price / Filter Gradient Fill", group = "Style",
     tooltip = "Fills the area between the source and the filter with a vertical gradient — bullish while price holds above the SuperSmoother, bearish while below — fading to fully transparent at the filter line.")

showSignalsInput  = input.bool(false, "Price Crossing Markers", group = "Style",
     tooltip = "Displays small triangle markers when the source crosses over or under the SuperSmoother. Off by default to keep the chart clean — the crossing alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Two-pole SuperSmoother — John Ehlers' published Butterworth-derived recipe:
// a1 = e^(-sqrt(2)*pi/P), b1 = 2*a1*cos(sqrt(2)*pi/P), c2 = b1, c3 = -a1^2, c1 = 1 - c2 - c3,
// filt = c1*(price + price[1])/2 + c2*filt[1] + c3*filt[2], seeded with price
superSmoother2(float src, simple int period) =>
    arg = SQRT2 * math.pi / period
    a1  = math.exp(-arg)
    b1  = 2 * a1 * math.cos(arg)
    c2  = b1
    c3  = -a1 * a1
    c1  = 1 - c2 - c3
    float filt = na
    filt := c1 * (src + nz(src[1], src)) / 2 + c2 * nz(filt[1], src) + c3 * nz(filt[2], src)
    filt

// Three-pole SuperSmoother — Ehlers' published 3-pole coefficients (steeper attenuation, slightly more lag):
// a1 = e^(-pi/P), b1 = 2*a1*cos(1.738*pi/P), c1 = a1^2,
// filt = coef1*price + coef2*filt[1] + coef3*filt[2] + coef4*filt[3], seeded with price
superSmoother3(float src, simple int period) =>
    a1    = math.exp(-math.pi / period)
    b1    = 2 * a1 * math.cos(THREE_POLE_K * math.pi / period)
    c1    = a1 * a1
    coef2 = b1 + c1
    coef3 = -(c1 + b1 * c1)
    coef4 = c1 * c1
    coef1 = 1 - coef2 - coef3 - coef4
    float filt = na
    filt := coef1 * src + coef2 * nz(filt[1], src) + coef3 * nz(filt[2], src) + coef4 * nz(filt[3], src)
    filt

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// Both variants run on every bar so their recursive histories stay consistent
twoPole   = superSmoother2(srcInput, lengthInput)
threePole = superSmoother3(srcInput, lengthInput)

filt = polesInput == 2 ? twoPole : threePole

// Slope of the filter — the trend read of the smoother
slope = filt - nz(filt[1], filt)

// Price crossings — read exactly like a moving average
crossUp   = ta.crossover(srcInput, filt)
crossDown = ta.crossunder(srcInput, filt)

// Slope reversals of the filter
slopeTurnUp   = slope > 0 and nz(slope[1]) <= 0
slopeTurnDown = slope < 0 and nz(slope[1]) >= 0

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
filtColor = trendColorInput ? (slope > 0 ? bullColorInput : slope < 0 ? bearColorInput : neutralColorInput) : neutralColorInput

priceAbove      = srcInput > filt
fillTopColor    = showFillInput ? (priceAbove ? color.new(bullColorInput, FILL_PRICE_TRANSP) : color.new(bearColorInput, FILL_FILT_TRANSP)) : na
fillBottomColor = showFillInput ? (priceAbove ? color.new(bullColorInput, FILL_FILT_TRANSP) : color.new(bearColorInput, FILL_PRICE_TRANSP)) : na

srcPlotId  = plot(srcInput, "Source", color = na, editable = false, display = display.none)
filtPlotId = plot(filt, "SuperSmoother", color = filtColor, linewidth = 2)

fill(srcPlotId, filtPlotId, top_value = math.max(srcInput, filt), bottom_value = math.min(srcInput, filt), top_color = fillTopColor, bottom_color = fillBottomColor, title = "Price / Filter Gradient Fill")

plotshape(showSignalsInput and crossUp, "Bullish Cross", shape.triangleup, location.belowbar, color = bullColorInput, size = size.tiny)
plotshape(showSignalsInput and crossDown, "Bearish Cross", shape.triangledown, location.abovebar, color = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Bullish Price Cross", "Price crossed above the Ehlers SuperSmoother on {{ticker}} ({{interval}})")
alertcondition(crossDown, "Bearish Price Cross", "Price crossed below the Ehlers SuperSmoother on {{ticker}} ({{interval}})")
alertcondition(slopeTurnUp, "SuperSmoother Slope Up", "Ehlers SuperSmoother slope turned upward on {{ticker}} ({{interval}})")
alertcondition(slopeTurnDown, "SuperSmoother Slope Down", "Ehlers SuperSmoother slope turned downward on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
