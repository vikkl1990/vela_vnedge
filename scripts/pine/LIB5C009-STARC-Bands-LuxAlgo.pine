//@version=6
indicator("STARC Bands", shorttitle = "STARC Bands", overlay = true, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_COLOR = #089981
BEARISH_COLOR = #f23645
NEUTRAL_COLOR = #787b86 // centerline - structure, not a side

FILL_BAND_TRANSP  = 80  // gradient transparency at the bands (strongest shading, at the stretch zones)
FILL_BASIS_TRANSP = 100 // gradient transparency at the centerline (fully transparent, the neutral zone)
OUTER_BAND_TRANSP = 50  // the optional outer extreme rails draw lighter than the standard bands

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Price series the centerline is averaged on. Closing prices are the standard form. The band offset itself always comes from true range, so gaps count toward the channel width either way.")

smaLengthInput = input.int(5, "Average Length", minval = 1
  , group   = "Settings"
  , tooltip = "Length of the simple moving average centerline. Stoller's classic form keeps it short - five or six bars - so the channel hugs recent price and a band touch reads as stretch against the immediate swing rather than the broader trend.")

atrLengthInput = input.int(15, "ATR Length", minval = 1
  , group   = "Settings"
  , tooltip = "Lookback of the average true range that sets the band offset. 15 bars is the widely published STARC setting. Because true range includes gaps, the channel responds to overnight jumps that close-to-close statistics understate.")

multInput = input.float(2.0, "ATR Multiplier", minval = 0.1, step = 0.1
  , group   = "Settings"
  , tooltip = "How many average true ranges the bands sit above and below the centerline. About two is the classic published form: far enough out that a touch marks a genuine stretch relative to recent average range, close enough that touches actually occur.")

showOuterInput = input.bool(false, "Outer Extreme Bands", inline = "outer"
  , group   = "Settings"
  , tooltip = "Layers a wider multiplier on as an outer extreme, stacking a second threshold outside the standard bands the way double-band systems stack theirs. Tags of the outer rail mark exceptional stretch.")

outerMultInput = input.float(3.0, "Multiplier", minval = 0.1, step = 0.1, inline = "outer"
  , group   = "Settings"
  , tooltip = "ATR multiplier of the outer extreme bands. Keep it comfortably above the standard multiplier so the outer rail only comes into play on exceptional range.")

upperColorInput = input.color(BEARISH_COLOR, "Upper Band"
  , group   = "Style"
  , tooltip = "Color of the upper band and the gradient above the centerline - the rail capping bullish stretch. By construction a fresh long against it is entered at a level already extended relative to recent average range.")

basisColorInput = input.color(NEUTRAL_COLOR, "Centerline"
  , group   = "Style"
  , tooltip = "Color of the short moving average at the channel center - the neutral reference. Price near it is unstretched, and the rotations that follow band rejections aim back at it.")

lowerColorInput = input.color(BULLISH_COLOR, "Lower Band"
  , group   = "Style"
  , tooltip = "Color of the lower band and the gradient below the centerline - the rail capping bearish stretch, the mirror-image zone where fresh shorts are extended and countertrend setups are hunted.")

showFillInput = input.bool(true, "Channel Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient from the centerline out to each band - fully transparent at the centerline, strongest at the band - so channel space intensifies toward the stretch zones. Purely visual, the levels are unaffected.")

showMarkersInput = input.bool(false, "Band Tag Markers"
  , group   = "Style"
  , tooltip = "Optional circles on bars where price tags a standard band. Off by default to keep the chart clean - the tag and rejection alerts cover the same events regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Stoller Average Range Channel: a short simple moving average with bands offset by a multiple of average true range.
// The offset is denominated in realized range - gaps included - so the channel widens in fast markets, tightens in
// quiet ones, and doubles as a position-sizing reference
basis    = ta.sma(srcInput, smaLengthInput)
atrValue = ta.atr(atrLengthInput)

bandOffset = multInput * atrValue

upperBand = basis + bandOffset
lowerBand = basis - bandOffset

// Optional outer extreme: the same construction one multiplier ring further out
outerOffset    = outerMultInput * atrValue
outerUpperBand = basis + outerOffset
outerLowerBand = basis - outerOffset

channelReady = not na(basis) and not na(atrValue)

//---------------------------------------------------------------------------------------------------------------------}
// Channel Events
//---------------------------------------------------------------------------------------------------------------------{
// A tag is price pushing into a band: by construction the move is stretched relative to recent average range, so the
// band argues against fresh entries in that direction rather than for chasing them
upperTagCross = ta.crossover(high, upperBand)
lowerTagCross = ta.crossunder(low, lowerBand)

outerUpperTagCross = ta.crossover(high, outerUpperBand)
outerLowerTagCross = ta.crossunder(low, outerLowerBand)

centerCrossUpRaw   = ta.crossover(close, basis)
centerCrossDownRaw = ta.crossunder(close, basis)

upperTag = channelReady and upperTagCross
lowerTag = channelReady and lowerTagCross

// How a touch resolves decides the read: a tag that closes back inside suggests rotation toward the centerline, while
// repeated closes hugging one band signal a trend strong enough to keep paying the stretch
upperRejection = channelReady and not na(upperBand[1]) and high[1] >= upperBand[1] and close < upperBand
lowerRejection = channelReady and not na(lowerBand[1]) and low[1] <= lowerBand[1] and close > lowerBand

// Centerline crosses: the stretch fully resets, and centerline-trailing exits are hit
centerCrossUp   = channelReady and centerCrossUpRaw
centerCrossDown = channelReady and centerCrossDownRaw

// Outer extreme tags only fire while the outer bands are enabled, so alerts match the channel on the chart
outerUpperTag = showOuterInput and channelReady and outerUpperTagCross
outerLowerTag = showOuterInput and channelReady and outerLowerTagCross

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
upperPlotId = plot(upperBand, "Upper Band", color = upperColorInput, linewidth = 2)
basisPlotId = plot(basis, "Centerline", color = basisColorInput, linewidth = 2)
lowerPlotId = plot(lowerBand, "Lower Band", color = lowerColorInput, linewidth = 2)

plot(showOuterInput ? outerUpperBand : na, "Outer Upper Band", color = color.new(upperColorInput, OUTER_BAND_TRANSP), style = plot.style_linebr)
plot(showOuterInput ? outerLowerBand : na, "Outer Lower Band", color = color.new(lowerColorInput, OUTER_BAND_TRANSP), style = plot.style_linebr)

fill(basisPlotId, upperPlotId
  , top_value    = upperBand
  , bottom_value = basis
  , top_color    = showFillInput ? color.new(upperColorInput, FILL_BAND_TRANSP) : na
  , bottom_color = showFillInput ? color.new(upperColorInput, FILL_BASIS_TRANSP) : na
  , title        = "Upper Channel Gradient Fill")

fill(basisPlotId, lowerPlotId
  , top_value    = basis
  , bottom_value = lowerBand
  , top_color    = showFillInput ? color.new(lowerColorInput, FILL_BASIS_TRANSP) : na
  , bottom_color = showFillInput ? color.new(lowerColorInput, FILL_BAND_TRANSP) : na
  , title        = "Lower Channel Gradient Fill")

plotshape(showMarkersInput and upperTag, "Upper Band Tag Marker", shape.circle, location.abovebar, color = upperColorInput, size = size.tiny)
plotshape(showMarkersInput and lowerTag, "Lower Band Tag Marker", shape.circle, location.belowbar, color = lowerColorInput, size = size.tiny)

// Data-window readout of the band distance: because it is denominated in ATR, it doubles as a sizing and stop reference
plot(bandOffset, "Band Offset (Multiplier x ATR)", color = basisColorInput, display = display.data_window)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(upperTag, "Upper Band Tag", "STARC Bands: price tagged the upper band on {{ticker}} - stretched relative to recent average range, so a fresh long here is entered at elevated risk ({{interval}})")
alertcondition(lowerTag, "Lower Band Tag", "STARC Bands: price tagged the lower band on {{ticker}} - stretched relative to recent average range, so a fresh short here is entered at elevated risk ({{interval}})")
alertcondition(upperRejection, "Upper Band Rejection", "STARC Bands: price closed back inside after tagging the upper band on {{ticker}} - a single-tag rejection, arguing for rotation back toward the centerline ({{interval}})")
alertcondition(lowerRejection, "Lower Band Rejection", "STARC Bands: price closed back inside after tagging the lower band on {{ticker}} - a single-tag rejection, arguing for rotation back toward the centerline ({{interval}})")
alertcondition(centerCrossUp, "Centerline Cross Up", "STARC Bands: price closed above the centerline on {{ticker}} - the lower-half stretch has reset at the neutral reference ({{interval}})")
alertcondition(centerCrossDown, "Centerline Cross Down", "STARC Bands: price closed below the centerline on {{ticker}} - the upper-half stretch has reset, and centerline-trailing exits on longs are hit ({{interval}})")
alertcondition(outerUpperTag, "Outer Upper Band Tag", "STARC Bands: price tagged the outer extreme band above on {{ticker}} - an exceptional stretch beyond the standard channel ({{interval}})")
alertcondition(outerLowerTag, "Outer Lower Band Tag", "STARC Bands: price tagged the outer extreme band below on {{ticker}} - an exceptional stretch beyond the standard channel ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
