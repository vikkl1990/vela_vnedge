//@version=6
indicator("Chande Momentum Oscillator", "CMO", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // positive momentum - readings above zero, and the oversold zone
BEAR_COLOR    = #f23645 // negative momentum - readings below zero, and the overbought zone
NEUTRAL_COLOR = #787b86 // exact zero / warm-up readings and the reference levels

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill
ZONE_TRANSP      = 92  // transparency of the soft overbought / oversold zone shading

SCALE_TOP    = 100  // bounded scale of the oscillator
SCALE_BOTTOM = -100
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(9, "Length", minval = 1, group = "Settings", tooltip = "Number of bars over which up moves and down moves are summed")
srcInput    = input.source(close, "Source", group = "Settings", tooltip = "Price series used to measure bar-to-bar changes")

obLevelInput = input.float(50, "Overbought Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level above which the oscillator is considered overbought")
osLevelInput = input.float(-50, "Oversold Level", minval = -100, maxval = 0, step = 1, group = "Settings", tooltip = "Level below which the oscillator is considered oversold")

cmoColorInput   = input.color(NEUTRAL_COLOR, "CMO Line", group = "Style", tooltip = "Color of the CMO line")
bullColorInput  = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style", tooltip = "Line and fill color while momentum is positive, and shading of the oversold zone")
bearColorInput  = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style", tooltip = "Line and fill color while momentum is negative, and shading of the overbought zone")
levelColorInput = input.color(NEUTRAL_COLOR, "Levels", group = "Style", tooltip = "Color of the overbought, oversold, and zero lines")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
srcChange = ta.change(srcInput)

upSum   = math.sum(math.max(srcChange, 0), lengthInput)
downSum = math.sum(math.max(-srcChange, 0), lengthInput)

sumTotal = upSum + downSum
cmoValue = sumTotal == 0 ? 0.0 : 100 * (upSum - downSum) / sumTotal
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish momentum above zero, bearish below, neutral at zero
cmoColor = cmoValue > 0 ? bullColorInput : cmoValue < 0 ? bearColorInput : cmoColorInput

cmoPlotId  = plot(cmoValue, "CMO", cmoColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward the zero line, following the line color
fill(cmoPlotId, zeroPlotId, math.max(cmoValue, 0), math.min(cmoValue, 0), cmoValue > 0 ? color.new(cmoColor, FILL_LINE_TRANSP) : color.new(cmoColor, FILL_ZERO_TRANSP), cmoValue > 0 ? color.new(cmoColor, FILL_ZERO_TRANSP) : color.new(cmoColor, FILL_LINE_TRANSP), title = "CMO Gradient")

hline(obLevelInput, "Overbought", levelColorInput, hline.style_dashed)
hline(osLevelInput, "Oversold", levelColorInput, hline.style_dashed)
hline(0, "Zero Line", levelColorInput, hline.style_dotted)

// Soft zone shading - overbought band above the upper level, oversold band below the lower level
obZoneId     = plot(obLevelInput, "Overbought Anchor", color(na), editable = false, display = display.none)
osZoneId     = plot(osLevelInput, "Oversold Anchor", color(na), editable = false, display = display.none)
topAnchorId  = plot(SCALE_TOP, "Top Anchor", color(na), editable = false, display = display.none)
botAnchorId  = plot(SCALE_BOTTOM, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(bearColorInput, ZONE_TRANSP), title = "Overbought Zone")
fill(osZoneId, botAnchorId, color.new(bullColorInput, ZONE_TRANSP), title = "Oversold Zone")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossAboveOb = ta.crossover(cmoValue, obLevelInput)
crossBelowOs = ta.crossunder(cmoValue, osLevelInput)
crossZero    = ta.cross(cmoValue, 0)

alertcondition(crossAboveOb, "Overbought Cross", "CMO crossed above the overbought level")
alertcondition(crossBelowOs, "Oversold Cross", "CMO crossed below the oversold level")
alertcondition(crossZero, "Zero Cross", "CMO crossed the zero line")
//----------------------------------------------------------------------------------------------------------------------}
