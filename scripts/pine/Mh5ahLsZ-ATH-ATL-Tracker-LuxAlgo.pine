//@version=5
indicator("ATH/ATL Tracker [LuxAlgo]", "LuxAlgo - ATH/ATL Tracker", max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)
//---------------------------------------------------------------------------------------------------------------------}
//Settings
//---------------------------------------------------------------------------------------------------------------------{

//General
freq = input.timeframe("D", title = "Duration", tooltip = "Maximum Frequency at which ATH & ATL will be updated.\nExample: 'D' will have up to 1 new ATH and ATL per Day.\n\nThis is used avoid tracking insignificant Highs and Lows. Keeping this value at '1 day +' is reccomended.")
order = input.string("Chronological", title = "Order", options = ["Chronological", "Reversed"], tooltip = "Chronological: Oldest - Newest\nReversed: Newest - Oldest")
//Style
barWidth = input.int(4, minval = 1, title = "Bar Width", group = "Style", tooltip = "Width of each Bar.")
barSpace = input.int(1, minval = 0, title = "Bar Spacing", group = "Style", tooltip = "Spacing between Bars.")
green = input.color(#089981, title = "Bullish Color", group = "Style")
red = input.color(#f23645, title = "Bearish Color", group = "Style")
invis = color.rgb(0,0,0,100)

showDash = input.bool(true, "Show Dashboard", group = "Dashboard")
dashLoc  = input.string("Top Right" , "Location"  , options = ["Top Right", "Middle Right", "Bottom Right", "Bottom Center" , "Bottom Left"] , group = "Dashboard")
textSize = str.lower( input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal", "Large"], group = "Dashboard") )

//warns for users ❗
warn_override = timeframe.in_seconds(freq) < timeframe.in_seconds(timeframe.period)
warn_day = timeframe.in_seconds(freq) < timeframe.in_seconds("D")

//overriding user's inputs
tf_override = warn_override ? timeframe.period : freq


//---------------------------------------------------------------------------------------------------------------------}
//UDTs
//---------------------------------------------------------------------------------------------------------------------{

type data
    float h
    float l
    float h_dif
    float l_dif
    string t
    int b

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
//For use in security call to find the time at bar_index 0 so that the HTFs can stop calculating before the lower tfs start.
get_bz_time() =>
    var int bz_time = na
    if bar_index == 0 
        bz_time := time
    bz_time

bz = request.security("",tf_override,get_bz_time(), lookahead = barmerge.lookahead_on)

//Getting High and Low before the ltf chart starts so that when it does start, it already has values for the current ATH&ATL
get_hl_upto(_time) =>
    var float ath = high
    var float atl = low
    bz_time = get_bz_time()
    if na(_time)
        if high > ath
            ath := high
        if low < atl
            atl := low
    [ath,atl,bz_time]

//For the Lowest timeframe (duration timeframe), to get ATH & ATL
get_athl(_h,_l) =>
    var _data = array.new<data>(na)
    var last_time = time

    if _data.size() >= 500
        _data.shift()

    var float ath = nz(_h,high)
    var float atl = nz(_l,low)
    
    h_dif = high-ath > 0 ? high-ath : na
    l_dif = low-atl < 0 ? low-atl : na

    date =  str.tostring(month)+"/"+str.tostring(dayofmonth)+"/"+str.tostring(year)

    if (not na(h_dif) or not na(l_dif))
        _data.push(data.new(high, low, h_dif, l_dif, date, time - last_time))
        last_time := time

    if not na(h_dif)
        ath := high
    
    if not na(l_dif)
        atl := low

    [barstate.islast ? _data : array.new<data>(na)
      ,barstate.islast ? ath: 0
      ,barstate.islast ? atl: 0 ]

//Send data array to chart
draw_data(_data, _width, _space, _order) =>
    if not na(_data) and _data.size() > 0
        for i = 0 to _data.size()-1
            id = _order == 1 ? (_data.size()-1) - i : i
            d = _data.get(id) 
            hitbox = "-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-\n-"
            place = bar_index-i-(i*_space)
            if not na(d.h_dif)
                line.new(place,d.h_dif,place,0, color = green, width = _width)
                label.new(place, d.h_dif, style = label.style_label_up, text = hitbox, tooltip = d.t + "\nAll-Time High: " + str.tostring(d.h), color = invis, textcolor = invis, size = size.tiny)
            if not na(d.l_dif)
                line.new(place,0,place,d.l_dif, color = red, width = _width)
                label.new(place, 0, style = label.style_label_up, text = hitbox,tooltip = d.t + "\nAll-Time Low: " + str.tostring(d.l), color = invis, textcolor = invis, size = size.tiny)
 
//Calculating averages from data array for averages.
t_avg(_ary) =>
    temp = array.new_float(na)
    for v in _ary
        if not na(v.b)
            temp.push(v.b)
    temp.avg()

change_avg(_ary) =>
    temp = array.new_float(na)
    for v in _ary
        if not na(v.h_dif)
            temp.push(v.h_dif)
        if not na(v.l_dif)
            temp.push(v.l_dif)
    temp.avg()

//---------------------------------------------------------------------------------------------------------------------}
//Calculations
//---------------------------------------------------------------------------------------------------------------------{
bar_order = order ==  "Chronological" ? 1 : 0

[y_ath,y_atl,y_time] = request.security("","12M",get_hl_upto(bz))
[hy_ath,hy_atl,hy_time] = request.security("","6M",get_hl_upto(bz))
[m_ath,m_atl,m_time] = request.security("","M",get_hl_upto(bz))
[w_ath,w_atl,w_time] = request.security("","W",get_hl_upto(bz))
[d_ath,d_atl,d_time] = request.security("","D",get_hl_upto(bz))

h_ath = math.max(y_ath,hy_ath,m_ath,w_ath,d_ath)
h_atl = math.min(y_atl,hy_atl,m_atl,w_atl,d_atl)

[athl_data,ath,atl] = request.security("",tf_override,get_athl(h_ath,h_atl))

b_avg = t_avg(athl_data)

c_avg = change_avg(athl_data)

//---------------------------------------------------------------------------------------------------------------------}
//Display
//---------------------------------------------------------------------------------------------------------------------{
//Remove all lines and labels first
for ln in line.all
    ln.delete()
for lab in label.all
    lab.delete()

//Re-Populate Display
if barstate.islast
    draw_data(athl_data,barWidth,barSpace,bar_order)

//---------------------------------------------------------------------------------------------------------------------}
//Table
//---------------------------------------------------------------------------------------------------------------------{

table_position = str.lower(str.replace(dashLoc," ","_"))

var t = table.new(table_position, 2, 2
  , bgcolor      = #1e222d
  , border_color = #373a46
  , border_width = 1
  , frame_color  = #373a46
  , frame_width  = 1)

warn_day_tt = warn_day?"❗ > It is reccomended to keep the 'Duration' Setting '1D' or Higher.\n\n":""
warn_override_tt = warn_override?"❗ > 'Duration' has been overridden to the chart's timeframe.\n\n":""

if barstate.islast and showDash
    //titles
    t.cell(0,0,"Average Duration (Days)" + (warn_day or warn_override?" ❗":"") , bgcolor = chart.bg_color, text_color = chart.fg_color, text_size  = textSize, tooltip = warn_day_tt + warn_override_tt + "Average # of Days inbetween New ATH/ATL Data. \n\nNote: Does NOT include Single Bar New Highs/Lows.")
    t.cell(1,0,"Average Change", bgcolor = chart.bg_color, text_color = chart.fg_color, text_size  = textSize, tooltip = "Average change occured when setting New ATHs & ATLs.")
    //values
    t.cell(0,1,str.tostring(b_avg/86400000,"#.##"), text_color = chart.fg_color, text_size  = textSize)
    t.cell(1,1,str.tostring(math.round_to_mintick(c_avg)), text_color = chart.fg_color, text_size  = textSize)

//---------------------------------------------------------------------------------------------------------------------}