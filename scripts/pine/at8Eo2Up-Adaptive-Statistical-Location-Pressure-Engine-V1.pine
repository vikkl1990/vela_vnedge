bool zone = input.bool(false, "Current statistical region only", group=G5, display=display.none)
bool points = input.bool(false, "Small state-entry markers", group=G5, display=display.none)
bool researchMarks = input.bool(false, "Historical event / outcome labels", group=G5, tooltip="Optional historical entry/outcome text. Requires Research: allow text labels on price. It does not change training or probabilities.", display=display.none)
