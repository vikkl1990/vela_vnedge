string tz3 = input.string("Europe/London", "IANA timezone", inline="3t", group=G2, display=display.none)
bool en4 = input.bool(true, "New York", inline="4", group=G2, display=display.none)
string ss4 = input.session("0900-1500", "", inline="4", group=G2, display=display.none)
string tz4 = input.string("America/New_York", "IANA timezone", inline="4t", group=G2, display=display.none)
