int dayMinute = input.int(0, "Trading-day start minute", minval=0, maxval=59, group=G1, display=display.none)
int regLen = input.int(10, "Completed-day regime mean length", minval=3, maxval=60, group=G1, display=display.none)
float maxRange = input.float(50, "Reject period range above % (data guard)", minval=2, maxval=500, group=G1, display=display.none)
bool condReg = input.bool(true, "Regime in movement hierarchy", group=G1, display=display.none)
bool condPrev = input.bool(true, "Previous state in movement hierarchy", group=G1, display=display.none)
