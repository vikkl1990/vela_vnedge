float priorStrength = input.float(20, "Empirical prior strength", minval=0, maxval=100, group=G4, tooltip="Shrinkage weight toward a disjoint broader historical group, used only when that group has at least 20 records. This weight is not additional observed evidence.", display=display.none)
int horizonMinutes = input.int(120, "Maximum outcome horizon minutes", minval=15, maxval=480, group=G4, tooltip="First-touch observation window, capped at the source session end. Must be an exact multiple of the chart timeframe. Changing this rebuilds outcome labels.", display=display.none)
float continueMultiple = input.float(0.25, "Continuation distance × frozen Q50", minval=0.05, maxval=2, step=0.05, group=G4, display=display.none)
float revertMultiple = input.float(0.35, "Toward-open distance × Q50 (capped at open)", minval=0.05, maxval=2, step=0.05, group=G4, display=display.none)
float minimumDisplacement = input.float(0.10, "Minimum event displacement × Q50", minval=0.05, maxval=1, step=0.05, group=G4, display=display.none)
bool featureGate = input.bool(true, "Prequential gate for optional outcome features", group=G4, display=display.none)
int evalCap = input.int(200, "Paired Brier evaluation window", minval=60, maxval=500, group=G4, display=display.none)
