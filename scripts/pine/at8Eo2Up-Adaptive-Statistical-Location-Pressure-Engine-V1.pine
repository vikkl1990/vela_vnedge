string ss5 = input.session("1500-1700", "", inline="5", group=G2, display=display.none)
string tz5 = input.string("America/New_York", "IANA timezone", inline="5t", group=G2, display=display.none)
string focus = input.string("Auto priority", "Display / event session", options=["Auto priority", "Asia", "London", "LON/NY", "New York", "NY PM"], group=G2, tooltip="Auto priority selects the highest-numbered enabled active session: NY PM, New York, LON/NY, London, Asia. Each session keeps independent statistics. A reference change can reset the plotted location.", display=display.none)
float centralQ = input.float(25, "Central boundary percentile", minval=5, maxval=45, group=G3, display=display.none)
