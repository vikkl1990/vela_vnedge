//@version=6
indicator("Adaptive Statistical Location + Pressure Engine V1", shorttitle="ASLP V1", overlay=false, precision=1, max_bars_back=1000, max_labels_count=450, max_lines_count=450, max_boxes_count=2)

// First public release: V1. Author: uPaSKaL.
// Asymmetric empirical location, block pressure and causal first-touch outcomes.
// Location is a percentile, not a reversal probability.
// Event forecasts are frozen at entry; insufficient samples suppress probabilities.
// Loaded-chart history only. This indicator does not calculate strategy returns.
// All state mutation is confirmed-bar only. Outcome training is delayed one bar.
const string G1 = "01 · Sampling"
const string G2 = "02 · Independent sessions"
const string G3 = "03 · Location / pressure"
const string G4 = "04 · Empirical outcomes"
const string G5 = "05 · Display"
int periodCap = input.int(1200, "Completed session records", minval=200, maxval=2400, group=G1, display=display.none)
int dayCap = input.int(500, "Completed day records", minval=60, maxval=1000, group=G1, display=display.none)
int blockCap = input.int(2400, "Completed marginal blocks", minval=300, maxval=5000, group=G1, display=display.none)
int minDist = input.int(30, "Minimum distribution n", minval=20, maxval=150, group=G1, tooltip="Minimum completed periods in the selected movement distribution. Fallback broadens conditioning when needed. Increasing the record cap cannot load extra chart history.", display=display.none)
bool weekends = input.bool(false, "Include weekends (enable for crypto)", group=G1, display=display.none)
string dayBoundaryMode = input.string("Symbol trading day", "Daily reset reference", options=["Symbol trading day", "Custom timezone boundary"], group=G1,
 tooltip="Symbol trading day follows the feed's 1D bar boundaries, including overnight sessions. Custom mode uses the timezone/hour/minute below. Chart display timezone does not control either mode.", display=display.none)
string dayTZ = input.string("America/New_York", "Day IANA timezone", group=G1, display=display.none)
