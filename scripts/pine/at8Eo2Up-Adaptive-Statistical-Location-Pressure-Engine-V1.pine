bool priceLabels = input.bool(false, "Research: allow text labels on price", group=G5, tooltip="Master switch for text labels on price. Also enable the desired state markers, historical labels, event paths or nearest levels. Off keeps the publication chart clean.", display=display.none)
bool dailyResetTint = input.bool(true, "Subtle daily reset marker in history pane", group=G5, display=display.none)
