// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
indicator("Average Daily Range", "ADR", overlay = true, max_labels_count = 50)

// --- Constants ---
string DAILY_TIMEFRAME = "D"
string GROUP_CALCULATION = "Calculation"
string GROUP_DISPLAY = "Display"
string GROUP_STYLE = "Style"

// --- Inputs ---
int lengthInput = input.int(14, "ADR Length", minval = 1, tooltip = "Number of completed daily ranges used to calculate the ADR.", group = GROUP_CALCULATION)
string basisInput = input.string("Daily", "Range Basis", options = ["Daily", "Regular session"], tooltip = "Daily uses the exchange daily candle. Regular session uses the chart symbol's regular-session daily candle when available.", group = GROUP_CALCULATION)
bool showOpenInput = input.bool(true, "Show Daily Open", tooltip = "Display the current day's opening price.", group = GROUP_DISPLAY)
bool showMidInput = input.bool(true, "Show ADR Midpoint", tooltip = "Display the midpoint between the projected ADR high and low.", group = GROUP_DISPLAY)
bool showTableInput = input.bool(true, "Show Information Table", tooltip = "Display the current ADR value and progress in a compact table.", group = GROUP_DISPLAY)
color highColorInput = input.color(#089981, "ADR High", tooltip = "Color of the projected ADR high.", group = GROUP_STYLE)
color lowColorInput = input.color(#f23645, "ADR Low", tooltip = "Color of the projected ADR low.", group = GROUP_STYLE)
color openColorInput = input.color(#5b9cf6, "Daily Open", tooltip = "Color of the daily open.", group = GROUP_STYLE)

// --- Data ---
string dailyTimeframe = basisInput == "Daily" ? DAILY_TIMEFRAME : timeframe.period
[previousRanges, currentOpen, currentHigh, currentLow, newDay] = request.security(syminfo.tickerid, dailyTimeframe, [ta.sma(high[1] - low[1], lengthInput), open, high, low, ta.change(time)], lookahead = barmerge.lookahead_on)

// --- Core calculations ---
float adr = previousRanges
float adrHigh = currentOpen + adr * 0.5
float adrLow = currentOpen - adr * 0.5
float adrMid = currentOpen
float currentRange = currentHigh - currentLow
float adrProgress = adr > 0.0 ? currentRange / adr * 100.0 : na

// --- Visual elements ---
plot(showOpenInput ? currentOpen : na, "Daily Open", color = openColorInput, linewidth = 2, style = plot.style_linebr)
plot(adrHigh, "ADR High", color = highColorInput, linewidth = 2, style = plot.style_linebr)
plot(adrLow, "ADR Low", color = lowColorInput, linewidth = 2, style = plot.style_linebr)
plot(showMidInput ? adrMid : na, "ADR Midpoint", color = color.new(chart.fg_color, 35), linewidth = 1, style = plot.style_linebr)

highPlot = plot(adrHigh, "ADR High Fill", color = color.new(highColorInput, 100), display = display.none)
lowPlot = plot(adrLow, "ADR Low Fill", color = color.new(lowColorInput, 100), display = display.none)
fill(highPlot, lowPlot, color = color.new(chart.fg_color, 92), title = "ADR Zone")

// --- Information table ---
var table infoTable = table.new(position.top_right, 2, 4, bgcolor = color.new(chart.bg_color, 10), frame_color = color.new(chart.fg_color, 75), frame_width = 1, border_color = color.new(chart.fg_color, 85), border_width = 1)
if barstate.islast
    if showTableInput
        table.cell(infoTable, 0, 0, "ADR", text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 0, str.tostring(adr, format.mintick), text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 0, 1, "ADR %", text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 1, str.tostring(adr / currentOpen * 100.0, "#.##") + "%", text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 0, 2, "Range used", text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 2, str.tostring(lengthInput) + " days", text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 0, 3, "Progress", text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 3, str.tostring(adrProgress, "#.##") + "%", text_color = adrProgress >= 100.0 ? highColorInput : chart.fg_color, text_size = size.small)
    else
        table.clear(infoTable, 0, 0, 1, 3)

// --- Alerts ---
alertcondition(ta.crossover(high, adrHigh), "ADR High Reached", "Price reached the projected ADR high.")
alertcondition(ta.crossunder(low, adrLow), "ADR Low Reached", "Price reached the projected ADR low.")
alertcondition(ta.crossover(adrProgress, 100.0), "ADR Completed", "The current day's range reached 100% of ADR.")
