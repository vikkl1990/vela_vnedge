//@version=6
indicator("MTF Trend Dashboard [PineLogic]", shorttitle = "MTF board", overlay = true)

// ── Inputs ─────────────────────────────────────────────────────────
grpTF = "Timeframes"
tf1 = input.timeframe("15",  "Timeframe 1", group = grpTF)
tf2 = input.timeframe("60",  "Timeframe 2", group = grpTF)
tf3 = input.timeframe("240", "Timeframe 3", group = grpTF)
tf4 = input.timeframe("D",   "Timeframe 4", group = grpTF)
tf5 = input.timeframe("W",   "Timeframe 5", group = grpTF)

grpI = "Indicators"
fastLen = input.int(21, "Fast EMA",   minval = 1, group = grpI)
slowLen = input.int(50, "Slow EMA",   minval = 1, group = grpI)
rsiLen  = input.int(14, "RSI Length", minval = 1, group = grpI)

grpS = "Style"
tablePos = input.string("Top Right", "Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpS)
txtSize  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = grpS)

// ── Per-timeframe metrics ──────────────────────────────────────────
f_metrics() =>
    emaF = ta.ema(close, fastLen)
    emaS = ta.ema(close, slowLen)
    r    = ta.rsi(close, rsiLen)
    [macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)
    t = close > emaS and emaF > emaS ? 1 : close < emaS and emaF < emaS ? -1 : 0
    [t, r, hist]

[t1, r1, h1] = request.security(syminfo.tickerid, tf1, f_metrics())
[t2, r2, h2] = request.security(syminfo.tickerid, tf2, f_metrics())
[t3, r3, h3] = request.security(syminfo.tickerid, tf3, f_metrics())
[t4, r4, h4] = request.security(syminfo.tickerid, tf4, f_metrics())
[t5, r5, h5] = request.security(syminfo.tickerid, tf5, f_metrics())

// ── Table ──────────────────────────────────────────────────────────
f_pos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : position.bottom_left

f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal

colUp   = color.new(#089981, 0)
colDown = color.new(#f23645, 0)
colFlat = color.new(#787b86, 0)
bgUp    = color.new(#089981, 80)
bgDown  = color.new(#f23645, 80)
bgFlat  = color.new(#787b86, 85)
bgHead  = color.new(#131722, 10)
txtHead = color.new(#d1d4dc, 0)

var table tbl = table.new(f_pos(tablePos), 4, 7, border_width = 1, border_color = color.new(#131722, 60))

f_row(int rowIdx, string tfTxt, int t, float r, float h) =>
    sz = f_size(txtSize)
    trendTxt = t == 1 ? "▲ Up" : t == -1 ? "▼ Down" : "− Flat"
    trendBg  = t == 1 ? bgUp : t == -1 ? bgDown : bgFlat
    trendCol = t == 1 ? colUp : t == -1 ? colDown : colFlat
    rsiCol   = r >= 70 ? colDown : r <= 30 ? colUp : txtHead
    macdTxt  = h >= 0 ? "+" : "−"
    macdCol  = h >= 0 ? colUp : colDown
    table.cell(tbl, 0, rowIdx, tfTxt,                    text_color = txtHead,  text_size = sz, bgcolor = bgHead)
    table.cell(tbl, 1, rowIdx, trendTxt,                 text_color = trendCol, text_size = sz, bgcolor = trendBg)
    table.cell(tbl, 2, rowIdx, str.tostring(r, "#.0"),   text_color = rsiCol,   text_size = sz, bgcolor = bgHead)
    table.cell(tbl, 3, rowIdx, macdTxt,                  text_color = macdCol,  text_size = sz, bgcolor = bgHead)

if barstate.islast
    sz = f_size(txtSize)
    // Header
    table.cell(tbl, 0, 0, "TF",    text_color = txtHead, text_size = sz, bgcolor = bgHead)
    table.cell(tbl, 1, 0, "Trend", text_color = txtHead, text_size = sz, bgcolor = bgHead)
    table.cell(tbl, 2, 0, "RSI",   text_color = txtHead, text_size = sz, bgcolor = bgHead)
    table.cell(tbl, 3, 0, "MACD",  text_color = txtHead, text_size = sz, bgcolor = bgHead)
    // Rows
    f_row(1, tf1, t1, r1, h1)
    f_row(2, tf2, t2, r2, h2)
    f_row(3, tf3, t3, r3, h3)
    f_row(4, tf4, t4, r4, h4)
    f_row(5, tf5, t5, r5, h5)
    // Overall bias
    score = t1 + t2 + t3 + t4 + t5
    biasTxt = score >= 3 ? "BULLISH" : score <= -3 ? "BEARISH" : "MIXED"
    biasBg  = score >= 3 ? bgUp : score <= -3 ? bgDown : bgFlat
    biasCol = score >= 3 ? colUp : score <= -3 ? colDown : colFlat
    table.cell(tbl, 0, 6, "Bias", text_color = txtHead, text_size = sz, bgcolor = bgHead)
    table.merge_cells(tbl, 1, 6, 3, 6)
    table.cell(tbl, 1, 6, biasTxt + "  (" + str.tostring(score) + "/5)", text_color = biasCol, text_size = sz, bgcolor = biasBg)

// Note: values on the developing HTF bar update live until that bar closes — standard
// dashboard behavior, disclosed in the published description.
