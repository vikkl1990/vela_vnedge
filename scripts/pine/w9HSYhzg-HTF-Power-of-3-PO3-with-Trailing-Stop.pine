//@version=6
indicator('HTF Power of 3 (PO3) with Trailing Stop', overlay = true, max_lines_count = 500)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

//  Color Constants (Premium Theme) 
color COLOR_ACCUM = color.orange // Vibrant Gold for Accumulation Thresholds
color COLOR_BULL = #00B0FF // Precision Light Blue for Bullish HTF Candles
color COLOR_BEAR = #e61717 // Neo-Scarlet for Bearish HTF Candles
color COLOR_WICK = #78909C // Cool Slate Gray for Wicks and Neutral Accents
color COLOR_OPEN_LINE = #ECEFF1 // Soft Off-White for HTF Open Horizontal Trailing

//  Inputs with Descriptive Tooltips 
bool autoHTF = input.bool(true, title = 'Auto HTF Matrix Mode', group = 'PO3 Core Settings', tooltip = 'When enabled, the indicator automatically scales the HTF matrix dynamically based on your current chart timeframe context.')
string manualHTF = input.timeframe('D', title = 'Manual HTF Selection', group = 'PO3 Core Settings', tooltip = 'The higher timeframe session layer used to anchor open levels if Auto HTF Mode is disabled.', active = not autoHTF)
int accumMultiplier = input.int(10, title = 'Accumulation Phase Length (Bars)', group = 'PO3 Core Settings', tooltip = 'Defines the maximum duration (in bars) for the initial Accumulation (consolidation) phase. Once this bar count is reached and breakout occurs, the indicator triggers the Manipulation phase.')

int candleOffset = input.int(10, title = 'HTF Candle Right Offset (Bars)', group = 'Display & Matrix Engine', tooltip = 'The number of bars to offset the real-time visual HTF candle projection layout to the right of your active price feed.')
int candleWidth = input.int(8, title = 'HTF Candle Width (Bars)', group = 'Display & Matrix Engine', tooltip = 'Visual horizontal block width of the projected real-time HTF structural candle layout.')

color bullColor = input.color(color.new(COLOR_BULL, 20), title = 'Bullish Body Color', group = 'Aesthetic Profile')
color bearColor = input.color(color.new(COLOR_BEAR, 20), title = 'Bearish Body Color', group = 'Aesthetic Profile')
color accumColor = input.color(color.new(COLOR_ACCUM, 0), title = 'Accumulation Lines Color', group = 'Aesthetic Profile')
color openLineColor = input.color(color.new(COLOR_OPEN_LINE, 75), title = 'HTF Open Line Color', group = 'Aesthetic Profile')
color wickColor = input.color(color.new(COLOR_WICK, 30), title = 'Wick Structure Color', group = 'Aesthetic Profile')

//  Label Size 
sizeStr = input.string(
     title="Label Text Size", 
     defval="Small", 
     options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], 
     group="Aesthetic Profile",
     tooltip="Select the text size for the labels."
     )

//  Function to convert input string to Pine Script label.size format 
getLabelSize(sizeStr) =>
    switch sizeStr
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.small // Default fallback

float trailMultiplier = input.float(3.0, title = 'Trailing Stop ATR Multiplier', group = 'Trailing Volatility Settings', tooltip = 'The sensitivity footprint multiplier applied to the short-term ATR value to create the dynamic trailing protection boundary lines.')
int atrPeriod = input.int(14, title = 'Trailing Stop ATR Period', group = 'Trailing Volatility Settings', tooltip = 'The lookback period calculation length used to smooth the standard ATR volatility baseline engine.')

// }

// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
// Dynamic Auto Timeframe Scaling Engine 
f_getAutoHTF() =>
    string tf = timeframe.period
    string result = manualHTF
    if autoHTF
        if timeframe.isintraday
            int m = timeframe.multiplier
            if timeframe.isseconds
                result := '45' // Default to 1m for second charts
                result
            else // Dynamic scaling mapping ladder
                if m <= 1
                    result := '120' // 1m -> 2H Session
                    result
                else if m <= 5
                    result := '720' // 5m -> 12H Session
                    result
                else if m <= 15
                    result := '2D' // 15m -> 2D Session
                    result
                else if m <= 60
                    result := 'W' // 1H -> Weekly Session
                    result
                else if m <= 120
                    result := '2W' // 2H -> 2 Week Session
                    result
                else if m <= 60 * 6
                    result := 'M' // 6H -> Monthly Session 
                    result
                else
                    result := '2M' // else -> 2 Months Session
                    result


        else if timeframe.isdaily
            int d = timeframe.multiplier
            if d <= 1
                result := '5M' // 1D -> 5 Months Session
                result
            else
                result := '6M' // Multi-day -> 6 Months Session 
                result
        else if timeframe.isweekly
            result := '10M'  // Weekly -> 10 Months Session
            result
        else if timeframe.ismonthly
            result := '50M'  // Monthly -> 50 Months Session
            result
    result


// Resolve the operational HTF layer string
string htfInput = f_getAutoHTF()

bool isNewHTF = timeframe.change(htfInput)

//  Local Tracking Variables for HTF Open, High, Low, Close 
var float htfOpen = na
var float htfHigh = na
var float htfLow = na
float htfClose = close

if isNewHTF
    htfOpen := open
    htfHigh := high
    htfLow := low
    htfLow
else
    htfHigh := math.max(nz(htfHigh, high), high)
    htfLow := math.min(nz(htfLow, low), low)
    htfLow

//  State Tracking Variables 
var line htfOpenLine = na

var line htfHighLine = na
var line htfLowLine = na


var line accumTopLine = na
var line accumBotLine = na
var line accumMidLine = na

var bool manipulated = false
var int breakoutDir = 0
var bool sessionDone = false
var bool inDistribution = false

// Trailing stop tracking variables
var float trailingStop = na
float currentAtr = ta.atr(atrPeriod)

var box htfBody = na
var line htfTopWick = na
var line htfBotWick = na
var label htfValueLabel = na

var label DistributionPeak = na
var label ManipulationPeak = na

color colorSeparator = color(na)

// Calculate structural channel layout boundaries using the configurable input multiplier
var trailCol = color(na)



//  PO3 Structure & Trailing Logic 
if isNewHTF

    htfOpenLine.set_x2(bar_index)
    htfHighLine.set_x2(bar_index)
    htfLowLine.set_x2(bar_index)

    // DistributionPeak.delete()
    // ManipulationPeak.delete()


    colorSeparator := openLineColor

    // Reset all parameters for the new HTF session
    manipulated := false
    sessionDone := false
    inDistribution := false
    breakoutDir := 0
    trailingStop := na

    // Draw the HTF Open Level Line using local tracked open
    htfOpenLine := line.new(x1 = bar_index, y1 = htfOpen, x2 = bar_index + candleOffset, y2 = htfOpen, color = openLineColor, style = line.style_dashed, width = 1)

    htfHighLine := line.new(x1 = bar_index, y1 = htfHigh, x2 = bar_index + candleOffset, y2 = htfHigh, color = openLineColor, style = line.style_dashed, width = 1)
    htfLowLine  := line.new(x1 = bar_index, y1 = htfLow, x2 = bar_index + candleOffset, y2 = htfLow, color = openLineColor, style = line.style_dashed, width = 1)

    // Draw the Top Line (Open + ATR Threshold) and Bottom Line (Open - ATR Threshold)
    accumTopLine := line.new(x1 = bar_index, y1 = htfOpen, x2 = bar_index, y2 = htfOpen, color = accumColor, style = line.style_solid, width = 1)
    accumBotLine := line.new(x1 = bar_index, y1 = htfOpen, x2 = bar_index, y2 = htfOpen, color = accumColor, style = line.style_solid, width = 1)
    accumMidLine := line.new(x1 = bar_index, y1 = htfOpen, x2 = bar_index, y2 = htfOpen, color = accumColor, style = line.style_dashed, width = 1)
    
    linefill.new(accumTopLine, accumBotLine, color.new(accumColor, 80))

else // Continuously extend the HTF open line to the current bar + offset boundary

    if not na(htfOpenLine)
        line.set_x2(htfOpenLine, bar_index + candleOffset)

    if not na(htfHighLine)
        line.set_x2(htfHighLine, bar_index + candleOffset+int(candleWidth/2))
        line.set_y1(htfHighLine, htfHigh)
        line.set_y2(htfHighLine, htfHigh)

    if not na(htfLowLine)
        line.set_x2(htfLowLine, bar_index + candleOffset+int(candleWidth/2))
        line.set_y1(htfLowLine, htfLow)
        line.set_y2(htfLowLine, htfLow)


    // Phase A: Accumulation (Before any breakout happens)
    if not na(accumTopLine) and not manipulated
        line.set_x2(accumTopLine, bar_index)
        line.set_x2(accumBotLine, bar_index)
        line.set_x2(accumMidLine, bar_index)

        if bar_index - accumTopLine.get_x1() <= accumMultiplier
            accumTopLine.set_y1(math.max(line.get_y1(accumTopLine), high))
            accumTopLine.set_y2(math.max(line.get_y1(accumTopLine), high))

            accumBotLine.set_y1(math.min(line.get_y1(accumBotLine), low))
            accumBotLine.set_y2(math.min(line.get_y1(accumBotLine), low))

            accumMidLine.set_y1(math.avg(line.get_y1(accumTopLine), line.get_y1(accumBotLine)))
            accumMidLine.set_y2(math.avg(line.get_y1(accumTopLine), line.get_y1(accumBotLine)))


        float topBoundary = line.get_y1(accumTopLine)
        float botBoundary = line.get_y1(accumBotLine)

        // Check if price breaks out of the accumulation high/low boundaries
        if close > topBoundary and barstate.isconfirmed
            manipulated := true
            breakoutDir := 1
            trailingStop := close - currentAtr * trailMultiplier

            accumTopLine := na
            accumBotLine := na
            accumMidLine := na

            label.new(x = bar_index, y = trailingStop, text = 'Manipulation', color = color.new(COLOR_BULL, 30), textcolor = color.white, style = label.style_label_up, size = getLabelSize(sizeStr))
            trailCol := COLOR_BULL
            

            ManipulationPeak := label.new(bar_index, high, "M", style = label.style_label_down, color = color.new(COLOR_BULL, 100), textcolor = COLOR_BULL, tooltip = "Peak Manipulation", size = getLabelSize(sizeStr))

        else if close < botBoundary and barstate.isconfirmed
            manipulated := true
            breakoutDir := -1
            trailingStop := close + currentAtr * trailMultiplier

            accumTopLine := na
            accumBotLine := na
            accumMidLine := na

            trailCol := COLOR_BEAR

            label.new(x = bar_index, y = trailingStop, text = 'Manipulation', color = color.new(COLOR_BEAR, 30), textcolor = color.white, style = label.style_label_down, size = getLabelSize(sizeStr))

            ManipulationPeak := label.new(bar_index, low, "M", style = label.style_label_up, color = color.new(COLOR_BEAR, 100), textcolor = COLOR_BEAR, tooltip = "Peak Manipulation", size = getLabelSize(sizeStr))


    // Phase B: Manipulation & Post-Breakout Expansion Trailing
    if manipulated and not sessionDone
        // Check for Trailing Stop Breach / Hit
        bool stopHit = false
        if breakoutDir == 1 and close < trailingStop
            stopHit := true

        else if breakoutDir == -1 and close > trailingStop
            stopHit := true
            stopHit



        if high > ManipulationPeak.get_y() and not inDistribution and breakoutDir == 1
            ManipulationPeak.set_xy(bar_index, high)

        if low < ManipulationPeak.get_y() and not inDistribution and breakoutDir == -1
            ManipulationPeak.set_xy(bar_index, low)



        //  Check for Stop Hits/Breakouts 
        if stopHit
            if not inDistribution
                //  Transitioning from Manipulation to Distribution 
                inDistribution := true

                if breakoutDir == 1
                    breakoutDir := -1
                    trailingStop := close + currentAtr * trailMultiplier
                    label.new(x = bar_index, y = trailingStop, text = 'Distribution', color = color.new(COLOR_BEAR, 30), textcolor = color.white, style = label.style_label_down, size = getLabelSize(sizeStr))
                    trailCol := COLOR_BEAR

                    DistributionPeak := label.new(bar_index, low, "D", style = label.style_label_up, color = color.new(COLOR_BEAR, 100), textcolor = COLOR_BEAR, tooltip = "Peak Distribution", size = getLabelSize(sizeStr))

                else
                    breakoutDir := 1
                    trailingStop := close - currentAtr * trailMultiplier
                    trailCol := COLOR_BULL
                    label.new(x = bar_index, y = trailingStop, text = 'Distribution', color = color.new(COLOR_BULL, 30), textcolor = color.white, style = label.style_label_up, size = getLabelSize(sizeStr))


                    DistributionPeak := label.new(bar_index, high, "D", style = label.style_label_down, color = color.new(COLOR_BULL, 100), textcolor = COLOR_BULL, tooltip = "Peak Distribution", size = getLabelSize(sizeStr))


            else //  Distribution Trailing Stop Broken 
                trailingStop := na
                sessionDone := true
                sessionDone

        if inDistribution
            if breakoutDir == -1
                if low < DistributionPeak.get_y()
                    DistributionPeak.set_xy(bar_index, low)


            if breakoutDir == 1
                if high > DistributionPeak.get_y()
                    DistributionPeak.set_xy(bar_index, high)



        // Active Trailing Calculation Matrix (Only update trailing lines when session isn't finished)
        if not sessionDone
            if breakoutDir == 1
                float targetStop = close - currentAtr * trailMultiplier
                if not na(trailingStop)
                    trailingStop := math.max(trailingStop, targetStop)
                    trailingStop
            else if breakoutDir == -1
                float targetStop = close + currentAtr * trailMultiplier
                if not na(trailingStop)
                    trailingStop := math.min(trailingStop, targetStop)
                    trailingStop
// }


// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

//  Dynamic Trailing Stop & Cloud Fill 
pt = plot(breakoutDir != breakoutDir[1] ? float(na) : trailingStop, title = 'PO3 Trailing Stop', color = trailCol, style = plot.style_linebr, linewidth = 3)
pp = plot(hl2, 'Price', display = display.none, editable = false)

fill(pt, pp, breakoutDir != breakoutDir[1] ? float(na) : trailingStop, hl2, color.new(trailCol, 100), color.new(trailCol, 80))

//  Right-Aligned HTF Candle & Information Label Engine 
if barstate.islast
    int bodyLeft = bar_index + candleOffset
    int bodyRight = bodyLeft + candleWidth
    int wickX = bodyLeft + math.floor(candleWidth / 2)

    color bodyColor = htfClose >= htfOpen ? bullColor : bearColor
    float bodyTop = math.max(htfOpen, htfClose)
    float bodyBot = math.min(htfOpen, htfClose)

    // Clear last historical instances
    box.delete(htfBody)
    line.delete(htfTopWick)
    line.delete(htfBotWick)
    label.delete(htfValueLabel)

    // Draw Candle Structure using purely local tracked values
    htfBody := box.new(left = bodyLeft, top = bodyTop, right = bodyRight, bottom = bodyBot, bgcolor = bodyColor, border_color = bodyColor)
    htfTopWick := line.new(x1 = wickX, y1 = htfHigh, x2 = wickX, y2 = bodyTop, color = wickColor, width = 2)
    htfBotWick := line.new(x1 = wickX, y1 = htfLow, x2 = wickX, y2 = bodyBot, color = wickColor, width = 2)

    // Dynamic Resolution Clean Text Formatting Logic
    string cleanTimeframe = htfInput
    if not(htfInput == 'D' or htfInput == 'W' or htfInput == 'M' or str.contains(htfInput, 'D'))
        int tfMinutes = int(str.tonumber(htfInput))
        if not na(tfMinutes)
            if tfMinutes >= 60
                cleanTimeframe := str.tostring(math.floor(tfMinutes / 60)) + 'H'
                cleanTimeframe
            else
                cleanTimeframe := str.tostring(tfMinutes) + 'M'
                cleanTimeframe
    else // Handles multi-day or absolute clean string presentations directly
        cleanTimeframe := htfInput
        cleanTimeframe

    // Construct Information Text Value String
    string labelText = cleanTimeframe + ' SESSION INFO\n\n' + ' O: ' + str.tostring(htfOpen) + '\n' + ' H: ' + str.tostring(htfHigh) + '\n' + ' L: ' + str.tostring(htfLow) + '\n' + ' C: ' + str.tostring(htfClose)

    // Generate Info Box sitting safely above the upper wick limit
    htfValueLabel := label.new(x = wickX, y = htfHigh, text = labelText, color = color.new(chart.bg_color, 10), textcolor = chart.fg_color, style = label.style_label_lower_left, size = getLabelSize(sizeStr), textalign = text.align_left, tooltip = "Session Timeframe\nOpen Price\nHigh Price\nLow Price\nClose Price")
    htfValueLabel

bgcolor(colorSeparator)

// }
