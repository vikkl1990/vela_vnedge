//@version=6
indicator("ATR-based Stop Distance", shorttitle = "ATR-based Stop Distance", overlay = true, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
RMA_SMOOTHING = "RMA (Wilder)"
SMA_SMOOTHING = "SMA"
EMA_SMOOTHING = "EMA"
WMA_SMOOTHING = "WMA"

CLOSE_ANCHOR = "Close"
ENTRY_ANCHOR = "Entry Price"

TOP_RIGHT    = "Top Right"
TOP_LEFT     = "Top Left"
BOTTOM_RIGHT = "Bottom Right"
BOTTOM_LEFT  = "Bottom Left"

TINY_SIZE   = "Tiny"
SMALL_SIZE  = "Small"
NORMAL_SIZE = "Normal"

LONG_COLOR    = #089981
SHORT_COLOR   = #f23645
NEUTRAL_COLOR = #787b86

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

FILL_PRICE_TRANSP = 50  // gradient transparency at the price end of each fill
FILL_STOP_TRANSP  = 100 // gradient transparency at the stop end of each fill

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
atrLengthInput = input.int(14, "ATR Length", minval = 1, group = "ATR",
     tooltip = "Averaging window of the Average True Range. Wilder's original work used 14 periods, the standard default.")

smoothingInput = input.string(RMA_SMOOTHING, "Smoothing", options = [RMA_SMOOTHING, SMA_SMOOTHING, EMA_SMOOTHING, WMA_SMOOTHING], group = "ATR",
     tooltip = "Moving average applied to the true range. RMA reproduces Wilder's original ATR; the alternatives react faster or weight recent bars differently.")

atrTimeframeInput = input.timeframe("", "ATR Timeframe", group = "ATR",
     tooltip = "Timeframe the ATR is measured on. Leave empty for the chart timeframe — the noise the position must survive bar to bar. Some traders measure one level higher for extra buffer on swing entries.")

atrMultipleInput = input.float(2.0, "ATR Multiple", minval = 0.1, step = 0.1, group = "ATR",
     tooltip = "Stop distance in ATR units. Published practice mostly falls between about 1.5 for short-term trades and 3 for trend-following, to be validated on your own market.")

anchorModeInput = input.string(CLOSE_ANCHOR, "Anchor", options = [CLOSE_ANCHOR, ENTRY_ANCHOR], group = "Anchor",
     tooltip = "'Close' measures the distance from each bar's close, showing where an ATR stop would sit for an entry at that price. 'Entry Price' anchors both levels to the fixed reference entry set below.")

entryPriceInput = input.price(0.0, "Entry Price", group = "Anchor",
     tooltip = "Reference entry price used when Anchor is 'Entry Price'. Leave at 0 to fall back to the latest close.")

entryTimeInput = input.time(0, "Entry Time", group = "Anchor",
     tooltip = "Optional time of the reference entry. When set, the entry-anchored levels are only drawn from that bar onward.")

freezeAtrInput = input.bool(true, "Freeze ATR at Entry", group = "Anchor",
     tooltip = "Measures the ATR once, on the entry bar, so the placed level stays fixed — the convention of never widening a stop after entry. Needs an Entry Time to locate that bar. Disable to re-derive the distance from the live ATR on every bar.")

showDashboardInput = input.bool(true, "Show Dashboard", group = "Dashboard",
     tooltip = "Stop distance readout: the effective ATR, the distance in price units, as a percentage of the anchor price and in ticks, plus both stop levels.")

dashboardPositionInput = input.string(TOP_RIGHT, "Position", options = [TOP_RIGHT, TOP_LEFT, BOTTOM_RIGHT, BOTTOM_LEFT], group = "Dashboard",
     tooltip = "Chart corner the dashboard is anchored to.")

dashboardSizeInput = input.string(SMALL_SIZE, "Size", options = [TINY_SIZE, SMALL_SIZE, NORMAL_SIZE], group = "Dashboard",
     tooltip = "Dashboard text size.")

showLongInput = input.bool(true, "Long Stop", inline = "long", group = "Style",
     tooltip = "Level a long position's stop would sit at — the anchor minus the ATR multiple.")

longColorInput = input.color(LONG_COLOR, "", inline = "long", group = "Style",
     tooltip = "Color of the long stop line and its gradient fill.")

showShortInput = input.bool(true, "Short Stop", inline = "short", group = "Style",
     tooltip = "Level a short position's stop would sit at — the anchor plus the ATR multiple.")

shortColorInput = input.color(SHORT_COLOR, "", inline = "short", group = "Style",
     tooltip = "Color of the short stop line and its gradient fill.")

showEntryLineInput = input.bool(true, "Entry Line", inline = "entry", group = "Style",
     tooltip = "Draws the reference entry price when Anchor is 'Entry Price'.")

entryColorInput = input.color(NEUTRAL_COLOR, "", inline = "entry", group = "Style",
     tooltip = "Color of the reference entry line.")

fillInput = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Vertical gradient between the anchor price and each stop level — fully transparent at the stop, strongest near price — visualizing the room the stop gives to ordinary fluctuation.")

lineWidthInput = input.int(1, "Line Width", minval = 1, maxval = 5, group = "Style",
     tooltip = "Width of the stop level lines.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Format a price-denominated value at symbol precision, with a placeholder while it is not yet available
formatPrice(float value) =>
    na(value) ? "n/a" : str.tostring(value, format.mintick)

// Table corner from the dashboard position option
tableLocation(string positionText) =>
    switch
        positionText == TOP_RIGHT    => position.top_right
        positionText == TOP_LEFT     => position.top_left
        positionText == BOTTOM_RIGHT => position.bottom_right
        => position.bottom_left

// Table text size from the dashboard size option
tableTextSize(string sizeText) =>
    switch
        sizeText == TINY_SIZE  => size.tiny
        sizeText == SMALL_SIZE => size.small
        => size.normal

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// True range smoothed with the selected method — every variant computed unconditionally on every bar
trueRange = ta.tr(true)
rmaAtr    = ta.rma(trueRange, atrLengthInput)
smaAtr    = ta.sma(trueRange, atrLengthInput)
emaAtr    = ta.ema(trueRange, atrLengthInput)
wmaAtr    = ta.wma(trueRange, atrLengthInput)

float selectedAtr = switch
    smoothingInput == RMA_SMOOTHING => rmaAtr
    smoothingInput == SMA_SMOOTHING => smaAtr
    smoothingInput == EMA_SMOOTHING => emaAtr
    => wmaAtr

// ATR measured on the chart timeframe, or one chosen level higher for extra buffer
float atrValue = request.security(syminfo.tickerid, atrTimeframeInput, selectedAtr, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

bool entryMode     = anchorModeInput == ENTRY_ANCHOR
bool entryPriceSet = entryPriceInput > 0
bool entryTimeSet  = entryTimeInput > 0

// First bar at or after the reference entry time — the bar the stop was placed on
bool entryStartBar = entryTimeSet and time >= entryTimeInput and (na(time[1]) or time[1] < entryTimeInput)
float entryBarAtr  = ta.valuewhen(entryStartBar, atrValue, 0)

// Distance frozen at entry per convention, or re-derived from the live measurement each bar
bool atrFrozen     = entryMode and freezeAtrInput and entryTimeSet and not na(entryBarAtr)
float effectiveAtr = atrFrozen ? entryBarAtr : atrValue

// The stop distance itself — the ATR multiple in price units — and the two levels it maps to,
// below the anchor for longs and above it for shorts
float stopDistance = atrMultipleInput * effectiveAtr

bool anchorActive = not entryMode or not entryTimeSet or time >= entryTimeInput
float anchorPrice = entryMode and entryPriceSet ? entryPriceInput : close

float longStop  = anchorActive ? anchorPrice - stopDistance : na
float shortStop = anchorActive ? anchorPrice + stopDistance : na

// Stop-hit events, taken against the level as it stood on the prior bar — the resting order a trader would have held into this bar
bool longStopHit  = not na(longStop[1]) and low <= longStop[1] and (na(longStop[2]) or low[1] > longStop[2])
bool shortStopHit = not na(shortStop[1]) and high >= shortStop[1] and (na(shortStop[2]) or high[1] < shortStop[2])

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
float anchorValue = anchorActive ? anchorPrice : na
float longValue   = showLongInput ? longStop : na
float shortValue  = showShortInput ? shortStop : na

bool entryLineVisible = entryMode and entryPriceSet and showEntryLineInput

// Vertical gradients between the anchor and each stop — fully transparent at the stop, strongest near price
color longFillPrice  = fillInput ? color.new(longColorInput, FILL_PRICE_TRANSP) : na
color longFillStop   = fillInput ? color.new(longColorInput, FILL_STOP_TRANSP) : na
color shortFillPrice = fillInput ? color.new(shortColorInput, FILL_PRICE_TRANSP) : na
color shortFillStop  = fillInput ? color.new(shortColorInput, FILL_STOP_TRANSP) : na

anchorPlotId = plot(anchorValue, "Anchor", color = na, editable = false, display = display.none)
longPlotId   = plot(longValue, "Long Stop", color = longColorInput, linewidth = lineWidthInput, style = plot.style_linebr)
shortPlotId  = plot(shortValue, "Short Stop", color = shortColorInput, linewidth = lineWidthInput, style = plot.style_linebr)

plot(entryLineVisible ? anchorValue : na, "Entry Price", color = entryColorInput, linewidth = 1, style = plot.style_linebr)

fill(anchorPlotId, longPlotId, top_value = anchorValue, bottom_value = longValue, top_color = longFillPrice, bottom_color = longFillStop, title = "Long Stop Gradient")
fill(shortPlotId, anchorPlotId, top_value = shortValue, bottom_value = anchorValue, top_color = shortFillStop, bottom_color = shortFillPrice, title = "Short Stop Gradient")

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashboardTable = na

if barstate.islast and showDashboardInput
    if na(dashboardTable)
        dashboardTable := table.new(tableLocation(dashboardPositionInput), 2, 6, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

    string textSize  = tableTextSize(dashboardSizeInput)
    color labelColor = DASH_HEADER
    color valueColor = DASH_TEXT

    float distancePct = na(stopDistance) or anchorPrice == 0 ? na : stopDistance / anchorPrice * 100
    string pctText    = na(distancePct) ? "n/a" : str.tostring(distancePct, "#.##") + "%"
    string ticksText  = na(stopDistance) ? "n/a" : str.tostring(math.round(stopDistance / syminfo.mintick))
    string atrLabel   = "ATR " + str.tostring(atrLengthInput) + (atrFrozen ? " (entry)" : "")
    string distLabel  = "Stop Distance (" + str.tostring(atrMultipleInput) + "x)"

    table.cell(dashboardTable, 0, 0, atrLabel, text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 0, formatPrice(effectiveAtr), text_color = valueColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 1, distLabel, text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 1, formatPrice(stopDistance), text_color = valueColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 2, "Distance %", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 2, pctText, text_color = valueColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 3, "Distance Ticks", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 3, ticksText, text_color = valueColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 4, "Long Stop", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 4, formatPrice(longStop), text_color = longColorInput, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 5, "Short Stop", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 5, formatPrice(shortStop), text_color = shortColorInput, text_size = textSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(longStopHit, "Long Stop Hit", "Price traded down to the long ATR stop level on {{ticker}} ({{interval}})")
alertcondition(shortStopHit, "Short Stop Hit", "Price traded up to the short ATR stop level on {{ticker}} ({{interval}})")
alertcondition(longStopHit or shortStopHit, "Any Stop Hit", "Price reached an ATR stop level on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
