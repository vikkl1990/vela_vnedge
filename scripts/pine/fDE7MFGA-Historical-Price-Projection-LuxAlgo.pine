//@version=5
indicator('Historical Price Projection [LuxAlgo]', 'LuxAlgo - Historical Price Projection', overlay = true, max_bars_back = 5000)
//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
GREEN                   = #089981
RED                     = #F23645
GRAY                    = color.new(color.gray, 80)

DATA_GROUP              = 'Data Gathering'
TRANSFORMATION_GROUP    = 'Data transformation'
STYLE_GROUP             = 'Style'

anchoringPointTooltip   = 'Starting point to gather data from, up to 500 bars will be used.'
growthFactorTooltip     = 'Values from 0 to 100, represents how much drift will be used to calculate next price in the serie.'
areaGrowthFactorTooltip = 'Values from 0 to 100, controls the width of the area around the forecast as an increment/decrement of the growth factor.'
lineWidthTooltip        = 'Size and color of the projection line'
lineConnectorTooltip    = 'Display the line connecting the price located at the anchor point and the price of the most recent confirmed bar'
areaColorTooltip        = 'Display forecasting area'

anchoringPointInput     = input.time(   timestamp('1 Jan 2099 00:00 +0100'),    'Anchor point',         group = DATA_GROUP,             tooltip = anchoringPointTooltip,    confirm = true)
growthFactorInput       = input.int(    0,                                      'Growth Factor',        group = TRANSFORMATION_GROUP,   tooltip = growthFactorTooltip,      maxval = 100) / 100
areaGrowthFactorInput   = input.int(    5,                                      'Area Width',           group = TRANSFORMATION_GROUP,   tooltip = areaGrowthFactorTooltip,  minval = 0,     maxval = 100) / 100

lineWidthInput          = input.int(    1,                                      'Projection Line Width',group = STYLE_GROUP,            tooltip = lineWidthTooltip,         inline = '1',   minval = 1)
bullishColorInput       = input.color(  GREEN,                                  '',                     group = STYLE_GROUP,            tooltip = '',                       inline = '1')
bearishColorInput       = input.color(  RED,                                    '',                     group = STYLE_GROUP,            tooltip = '',                       inline = '1')

lineConnectorInput      = input.bool(   true ,                                  'Execution Window Line',group = STYLE_GROUP,            tooltip = lineConnectorTooltip)

showAreaInput           = input.bool(   true,                                   'Show Area',            group = STYLE_GROUP,            tooltip = areaColorTooltip,         inline = '2')
areaColorInput          = input.color(  GRAY,                                   '',                     group = STYLE_GROUP,            tooltip = areaColorTooltip,         inline = '2')

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
// @variable   negative returns storage
var negativeDrift       = array.new<float>()
// @variable   positive returns storage
var positiveDrift       = array.new<float>()
// @variable   array for the two chart points for the polyline representing the window execution line
var points              = array.new<chart.point>(2)
// @variable   main storage used for the delta percent from close to close
var barDeltaPercents    = array.new<float>()
// @variable   execution window fisrt price, used for window execution line
var float windowOpen    = 0
// @variable   execution window last price, used for window execution line
var float windowClose   = 0
// @variable   execution window first bar index
var int firstBarIndex   = 0

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
// @function        Draw a table with custom text
// @param message   (string) Text to display
// @returns         void
showInfoPanel(string message) =>
    var table t_able = table.new(position.top_right, 1, 1)
    table.cell(t_able, 0, 0, message, text_color = chart.fg_color,text_halign = text.align_right)

// @function    Add currrent delta percent to main atorage array
// @returns     void
getBarDeltaPercent() =>
    array.push(barDeltaPercents, close/close[1])

// @function    Delete all polylines
// @returns     void
flushPolylines() =>
    for eachPolyline in polyline.all
        polyline.delete(eachPolyline)

// @function            Draw polylines (price projection and area) up to 500 chart points
// @param drift         (float) Drift used for the next price
// @param polylineColor (color) Color used on the polyline
// @returns             polyline ID
drawProjectedPrice(float drift, color polylineColor) =>
    anchorPrice     = close
    upperPrice      = close
    lowerPrice      = close

    chartPoints = array.new<chart.point>()
    upperPoints = array.new<chart.point>()
    lowerPoints = array.new<chart.point>()

    barIndex    = 0

    for eachDeltaPercent in barDeltaPercents
        barIndex    += 1

        // we calculate and store the chart points for the projected price line
        anchorPrice *= (eachDeltaPercent + drift * growthFactorInput)
        array.push(chartPoints, chart.point.new(na, last_bar_index + barIndex, anchorPrice))

        // we calculate and store the chart points for the upper and lower area extremes
        if showAreaInput
            upperPrice *= (eachDeltaPercent + drift * (growthFactorInput + areaGrowthFactorInput))
            lowerPrice *= (eachDeltaPercent + drift * (growthFactorInput - areaGrowthFactorInput))

            array.push(     upperPoints, chart.point.new(na, last_bar_index + barIndex, upperPrice))
            array.unshift(  lowerPoints, chart.point.new(na, last_bar_index + barIndex, lowerPrice))

    // we draw the projected price line
    polyline.new(chartPoints, line_color = polylineColor, line_width = lineWidthInput)
    
    // we draw the area around the projected price line
    if showAreaInput
        areaPoints = upperPoints.concat(lowerPoints)
        polyline.new(areaPoints, line_color = color(na), fill_color = areaColorInput, line_width = lineWidthInput)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
totalProcessedBars  = array.size(barDeltaPercents)
timeWindow          = time >= anchoringPointInput

if timeWindow
    if not timeWindow[1]
        windowOpen := open
        firstBarIndex := bar_index

        if lineConnectorInput
            // we set the first point for the execution window line
            array.set(points,0,chart.point.new(na,bar_index,windowOpen))
   
    if barstate.isconfirmed
        // we allow a period selection within last 5000 bars
        if  firstBarIndex < last_bar_index - 5000
            showInfoPanel('Oops... Starting point is too far away from current bar. Select a closer starting point.')
        else
            // we only gather the first 500 bars from the execution window start
            if totalProcessedBars < 500
                windowClose := close
                getBarDeltaPercent()
                array.push(close < close[1] ? negativeDrift : positiveDrift, close/close[1] - 1)

                if lineConnectorInput
                    // we set the last point for the execution window line
                    array.set(points, 1, chart.point.new(na, bar_index, windowClose))

            if barstate.islastconfirmedhistory or barstate.islast
                flushPolylines()
                polylineColor = windowClose >= windowOpen ? bullishColorInput : bearishColorInput

                // we draw the execution window line with a `polyline.new()` call
                if lineConnectorInput
                    polyline.new(points, line_color = polylineColor, line_width = 1)

                // we calculate the drift and draw the projected price line
                drift = windowClose >= windowOpen ? -1 * array.avg(negativeDrift) : -1 * array.avg(positiveDrift)
                drawProjectedPrice(drift, polylineColor)

//---------------------------------------------------------------------------------------------------------------------}