//@version=6
indicator("Polarized Fractal Efficiency"
  , shorttitle = "Polarized Fractal Efficiency"
  , overlay    = false
  , format     = format.price
  , precision  = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

float UPPER_BOUND = 100.0  // Reading of a perfectly efficient uptrend
float LOWER_BOUND = -100.0 // Reading of a perfectly efficient downtrend

int FULL_TRANSP = 100
int HALF_TRANSP = 50
int BG_TRANSP   = 90

string GROUP_OSC    = "Oscillator"
string GROUP_EVENTS = "Levels & Events"
string GROUP_STYLE  = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

sourceInput = input.source(close, "Source"
  , group   = GROUP_OSC
  , tooltip = "Price series measured for path efficiency. Hannula's recipe uses the close.")

lengthInput = input.int(10, "Length"
  , minval  = 2
  , maxval  = 500
  , group   = GROUP_OSC
  , tooltip = "Number of bars in the efficiency window. The straight-line distance between the current source and the source that many bars ago is compared with the bar-by-bar path length traced between them; 9 or 10 bars are the common settings. Longer windows make the regime call steadier but later.")

smoothLengthInput = input.int(5, "Smoothing"
  , minval  = 1
  , maxval  = 100
  , group   = GROUP_OSC
  , tooltip = "Length of the exponential moving average applied to the raw signed ratio, keeping single bars from whipping the reading around. 5 periods is the common setting; 1 disables smoothing.")

scaleAdjustInput = input.bool(false, "Scale-Adjusted Changes"
  , group   = GROUP_OSC
  , tooltip = "Divides every price change by the close anchoring the window (the source 'Length' bars ago, expressed in percent) before squaring, reducing sensitivity to the instrument's price scale. Readings differ from the plain form.")

trendLevelInput = input.float(50, "Trending Level"
  , minval  = 0
  , maxval  = 100
  , step    = 5
  , group   = GROUP_EVENTS
  , tooltip = "Absolute reading treated as trending conditions. Persistent readings beyond it favor pullback entries in the trend direction, while readings oscillating around zero argue for range tactics; the level also anchors the trending-regime and efficiency-decay events.")

regimeBgInput = input.bool(false, "Trending Regime Background"
  , group   = GROUP_STYLE
  , tooltip = "Tints the pane background while the reading holds beyond the trending level, marking the stretches graded as an efficient trend.")

showCrossMarkersInput = input.bool(false, "Zero Cross Markers"
  , group   = GROUP_STYLE
  , tooltip = "Shows circles on the zero line where the net move over the window flips sign. The alerts cover these events even when markers are hidden.")

bullColorInput = input.color(#089981, "Bullish Color", group = GROUP_STYLE)

bearColorInput = input.color(#f23645, "Bearish Color", group = GROUP_STYLE)

levelsColorInput = input.color(#787b86, "Levels Color", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// Raw polarized fractal efficiency: the straight-line distance between the current
// source and the source `length` bars ago is divided by the bar-by-bar path length
// traced between them, with time counted as a distance dimension (+length^2 across
// the window, +1 per bar), scaled to 100 and signed by the direction of the net move.
rawPfe(float src, int length, bool scaleAdjusted) =>
    float anchor = src[length]
    float raw    = na
    if not na(anchor)
        float netChange = scaleAdjusted ? 100 * (src - anchor) / anchor : src - anchor
        float direct    = math.sqrt(netChange * netChange + length * length)
        float path      = 0.0
        for i = 0 to length - 1
            float barChange = src[i] - src[i + 1]
            if scaleAdjusted
                barChange := 100 * barChange / anchor
            path += math.sqrt(barChange * barChange + 1)
        raw := 100 * direct / path
        if src < anchor
            raw := -raw
    raw

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{

// Raw signed efficiency ratio over the lookback window
float rawEfficiency = rawPfe(sourceInput, lengthInput, scaleAdjustInput)

// Polarized Fractal Efficiency: the raw ratio smoothed by a short exponential average
float pfe = ta.ema(rawEfficiency, smoothLengthInput)

// Zero-line crosses: the net move over the window flips sign
bool bullZeroCross = ta.crossover(pfe, 0)
bool bearZeroCross = ta.crossunder(pfe, 0)

// Trending-regime transitions around the +/- trending level
bool bullRegimeStart = ta.crossover(pfe, trendLevelInput)
bool bearRegimeStart = ta.crossunder(pfe, -trendLevelInput)
bool bullDecay       = ta.crossunder(pfe, trendLevelInput)
bool bearDecay       = ta.crossover(pfe, -trendLevelInput)

// Current regime grading
bool bullTrending = pfe > trendLevelInput
bool bearTrending = pfe < -trendLevelInput

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

color oscColor = pfe > 0 ? bullColorInput : bearColorInput

oscPlotId  = plot(pfe, "Polarized Fractal Efficiency", oscColor, 1)
zeroPlotId = plot(0, "Zero Anchor", editable = false, display = display.none)

fill(oscPlotId, zeroPlotId
  , top_value    = math.max(pfe, 0)
  , bottom_value = math.min(pfe, 0)
  , top_color    = pfe > 0 ? color.new(bullColorInput, HALF_TRANSP) : color.new(bearColorInput, FULL_TRANSP)
  , bottom_color = pfe > 0 ? color.new(bullColorInput, FULL_TRANSP) : color.new(bearColorInput, HALF_TRANSP)
  , title        = "Gradient Fill")

hline(UPPER_BOUND, "Upper Bound", levelsColorInput, hline.style_dotted)
hline(trendLevelInput, "Upper Trending Level", levelsColorInput, hline.style_dashed)
hline(0, "Zero Line", levelsColorInput, hline.style_dotted)
hline(-trendLevelInput, "Lower Trending Level", levelsColorInput, hline.style_dashed)
hline(LOWER_BOUND, "Lower Bound", levelsColorInput, hline.style_dotted)

bgcolor(regimeBgInput and bullTrending ? color.new(bullColorInput, BG_TRANSP)
  : regimeBgInput and bearTrending     ? color.new(bearColorInput, BG_TRANSP)
  : na
  , title = "Trending Regime Background")

plot(showCrossMarkersInput and bullZeroCross ? 0.0 : na, "Bullish Zero Cross", bullColorInput, 3, plot.style_circles)
plot(showCrossMarkersInput and bearZeroCross ? 0.0 : na, "Bearish Zero Cross", bearColorInput, 3, plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bullZeroCross, "Bullish Zero Cross", "Polarized Fractal Efficiency crossed above zero on {{ticker}} ({{interval}})")
alertcondition(bearZeroCross, "Bearish Zero Cross", "Polarized Fractal Efficiency crossed below zero on {{ticker}} ({{interval}})")
alertcondition(bullRegimeStart, "Bullish Trending Regime", "Polarized Fractal Efficiency crossed above its upper trending level on {{ticker}} ({{interval}})")
alertcondition(bearRegimeStart, "Bearish Trending Regime", "Polarized Fractal Efficiency crossed below its lower trending level on {{ticker}} ({{interval}})")
alertcondition(bullDecay, "Bullish Efficiency Decay", "Polarized Fractal Efficiency bent back below its upper trending level on {{ticker}} ({{interval}})")
alertcondition(bearDecay, "Bearish Efficiency Decay", "Polarized Fractal Efficiency bent back above its lower trending level on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
