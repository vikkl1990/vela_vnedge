//@version=6
indicator("Wave Trend Oscillator", shorttitle = "Wave Trend Oscillator", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
CCI_SCALE         = 0.015   // scaling factor shared with the CCI construction
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // WT2 signal line color
LEVELS_COLOR      = #787b86 // overbought/oversold levels and zero line color
FILL_VALUE_TRANSP = 50      // gradient transparency at the WT1 value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line
ZONE_TRANSP       = 88      // transparency of the overbought/oversold zone fills

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(hlc3, "Source"
  , group   = "Settings"
  , tooltip = "Price series the oscillator measures. The classic construction uses the average of high, low and close (HLC3).")

channelLengthInput = input.int(10, "Channel Length", minval = 1
  , group   = "Settings"
  , tooltip = "Length of the exponential average forming the channel mean, and of the exponential average of the absolute distance between price and that mean. The widely used default is 10.")

averageLengthInput = input.int(21, "Average Length", minval = 1
  , group   = "Settings"
  , tooltip = "Length of the exponential average that smooths the scaled deviation into WT1. This second smoothing turns the jagged CCI-style ratio into legible waves, at the cost of lag. The widely used default is 21.")

signalLengthInput = input.int(4, "Signal Length", minval = 1
  , group   = "Settings"
  , tooltip = "Number of bars in the simple average of WT1 forming the WT2 signal line. The popular construction uses 4.")

//---------------------------------------------------------------------------------------------------------------------}
// Thresholds
//---------------------------------------------------------------------------------------------------------------------{
obLevel1Input = input.float(53, "Overbought 1", minval = 0, step = 1
  , group   = "Thresholds"
  , tooltip = "Inner overbought level. Bearish WT1/WT2 crosses only count as extreme when both lines sit above it, and crossings of this level drive the overbought entry/exit alerts. The popular version draws it at 53.")

obLevel2Input = input.float(60, "Overbought 2", minval = 0, step = 1
  , group   = "Thresholds"
  , tooltip = "Outer overbought level. The band between the two overbought levels is shaded as the overbought zone. The popular version draws it at 60.")

osLevel1Input = input.float(-53, "Oversold 1", maxval = 0, step = 1
  , group   = "Thresholds"
  , tooltip = "Inner oversold level, mirroring the inner overbought level below zero. Bullish WT1/WT2 crosses only count as extreme when both lines sit below it, and crossings of this level drive the oversold entry/exit alerts.")

osLevel2Input = input.float(-60, "Oversold 2", maxval = 0, step = 1
  , group   = "Thresholds"
  , tooltip = "Outer oversold level, mirroring the outer overbought level below zero. The band between the two oversold levels is shaded as the oversold zone.")

showMarkersInput = input.bool(false, "Extreme Cross Markers"
  , group   = "Thresholds"
  , tooltip = "Displays a circle on the signal line whenever a WT1/WT2 cross fires beyond an inner level. Off by default to keep the pane clean - the extreme cross alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of WT1 and of the gradient fill while WT1 holds above its WT2 signal line.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of WT1 and of the gradient fill while WT1 holds below its WT2 signal line.")

signalColorInput = input.color(SIGNAL_COLOR, "Signal Line"
  , group   = "Style"
  , tooltip = "Color of the WT2 signal line, the short simple average of WT1.")

levelsColorInput = input.color(LEVELS_COLOR, "Levels Color"
  , group   = "Style"
  , tooltip = "Color of the dashed overbought/oversold levels and of the dotted zero line.")

gradientInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between WT1 and the zero line, fully transparent at zero and strongest at the oscillator value, colored by the WT1/WT2 cross state.")

zoneFillInput = input.bool(true, "Extreme Zone Fill"
  , group   = "Style"
  , tooltip = "Shades the bands between the paired overbought and oversold levels, where signal-line crosses carry the most weight.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Channel core - an exponential average of price forms the channel mean (esa), and an exponential
// average of the absolute distance between price and that mean measures the typical deviation (d)
channelMean = ta.ema(srcInput, channelLengthInput)
channelDev  = ta.ema(math.abs(srcInput - channelMean), channelLengthInput)

// CCI-style ratio (ci) - how far price sits from its mean, scaled by 0.015 times the average absolute
// deviation so roughly +/-100 brackets most of the action. A dead-flat window would divide by zero,
// so price sitting exactly on a zero-deviation mean maps to 0 instead
deviationRatio = na(channelDev) ? na : channelDev != 0 ? (srcInput - channelMean) / (CCI_SCALE * channelDev) : 0

// Double smoothing - a further exponential average turns the jagged ratio into legible waves (WT1),
// and a short simple average of WT1 forms the WT2 signal line
wt1 = ta.ema(deviationRatio, averageLengthInput)
wt2 = ta.sma(wt1, signalLengthInput)

// Signal grammar - crosses weighted by location. At a crossover WT1 sits on top, so WT1 below the
// inner oversold level means both lines are beneath it (and symmetrically for crossunders above the
// inner overbought level); mid-range crosses are left to the cross-state coloring
bullCross = ta.crossover(wt1, wt2)
bearCross = ta.crossunder(wt1, wt2)

bullExtremeCross = bullCross and wt1 < osLevel1Input
bearExtremeCross = bearCross and wt1 > obLevel1Input

// Zone traversal and centerline regime - entries into and exits out of the extreme zones, plus which
// side of zero the waves are unfolding on
overboughtEntry = ta.crossover(wt1, obLevel1Input)
overboughtExit  = ta.crossunder(wt1, obLevel1Input)
oversoldEntry   = ta.crossunder(wt1, osLevel1Input)
oversoldExit    = ta.crossover(wt1, osLevel1Input)

zeroCrossUp   = ta.crossover(wt1, 0)
zeroCrossDown = ta.crossunder(wt1, 0)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// WT1 carries the cross state - bullish while it holds above its signal line, bearish while below
crossStateColor = wt1 >= wt2 ? bullColorInput : bearColorInput

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the WT1 value,
// sharing the wave's cross-state color
fillTopColor    = wt1 >= 0 ? color.new(crossStateColor, FILL_VALUE_TRANSP) : color.new(crossStateColor, FILL_ZERO_TRANSP)
fillBottomColor = wt1 >= 0 ? color.new(crossStateColor, FILL_ZERO_TRANSP) : color.new(crossStateColor, FILL_VALUE_TRANSP)

wt1PlotId = plot(wt1, "WT1", crossStateColor, 2)

plot(wt2, "WT2 Signal Line", signalColorInput, 1)

zeroPlotId = plot(0, "Zero Anchor", editable = false, display = display.none)

fill(wt1PlotId, zeroPlotId
  , math.max(wt1, 0)
  , math.min(wt1, 0)
  , gradientInput ? fillTopColor : na
  , gradientInput ? fillBottomColor : na
  , title = "Zero-line Gradient Fill")

// Dashed extreme levels, dotted zero line, and soft fills marking the zones between the paired levels
hline(obLevel2Input, "Overbought 2", levelsColorInput, hline.style_dashed)
hline(obLevel1Input, "Overbought 1", levelsColorInput, hline.style_dashed)
hline(0, "Zero Line", color.new(levelsColorInput, 50), hline.style_dotted)
hline(osLevel1Input, "Oversold 1", levelsColorInput, hline.style_dashed)
hline(osLevel2Input, "Oversold 2", levelsColorInput, hline.style_dashed)

obLevel1PlotId = plot(obLevel1Input, "Overbought 1 Anchor", editable = false, display = display.none)
obLevel2PlotId = plot(obLevel2Input, "Overbought 2 Anchor", editable = false, display = display.none)
osLevel1PlotId = plot(osLevel1Input, "Oversold 1 Anchor", editable = false, display = display.none)
osLevel2PlotId = plot(osLevel2Input, "Oversold 2 Anchor", editable = false, display = display.none)

fill(obLevel1PlotId, obLevel2PlotId, zoneFillInput ? color.new(bearColorInput, ZONE_TRANSP) : na, title = "Overbought Zone")
fill(osLevel1PlotId, osLevel2PlotId, zoneFillInput ? color.new(bullColorInput, ZONE_TRANSP) : na, title = "Oversold Zone")

// Optional markers for the classic extreme triggers, drawn at the signal line where the cross fired
plot(showMarkersInput and bullExtremeCross ? wt2 : na, "Bullish Extreme Cross", color = bullColorInput, linewidth = 2, style = plot.style_circles)
plot(showMarkersInput and bearExtremeCross ? wt2 : na, "Bearish Extreme Cross", color = bearColorInput, linewidth = 2, style = plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullExtremeCross, "Bullish Extreme Cross", "WaveTrend WT1 crossed above WT2 with both lines below the oversold level on {{ticker}} - the classic oversold reversal trigger ({{interval}})")
alertcondition(bearExtremeCross, "Bearish Extreme Cross", "WaveTrend WT1 crossed below WT2 with both lines above the overbought level on {{ticker}} - the classic overbought reversal trigger ({{interval}})")
alertcondition(overboughtEntry, "Overbought Entry", "WaveTrend WT1 crossed above its inner overbought level on {{ticker}} - waves stretched to the upside, watching for a bearish signal cross ({{interval}})")
alertcondition(overboughtExit, "Overbought Exit", "WaveTrend WT1 crossed back below its inner overbought level on {{ticker}} - the overbought stretch is unwinding ({{interval}})")
alertcondition(oversoldEntry, "Oversold Entry", "WaveTrend WT1 crossed below its inner oversold level on {{ticker}} - waves stretched to the downside, watching for a bullish signal cross ({{interval}})")
alertcondition(oversoldExit, "Oversold Exit", "WaveTrend WT1 crossed back above its inner oversold level on {{ticker}} - the oversold stretch is unwinding ({{interval}})")
alertcondition(zeroCrossUp, "Bullish Zero Cross", "WaveTrend WT1 crossed above zero on {{ticker}} - waves now unfolding on the bullish side of the centerline ({{interval}})")
alertcondition(zeroCrossDown, "Bearish Zero Cross", "WaveTrend WT1 crossed below zero on {{ticker}} - waves now unfolding on the bearish side of the centerline ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
