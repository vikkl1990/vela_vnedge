sbGrid    = input.bool(false, 'Exit grid (research)', group = g14d,
     tooltip = 'Replays every TAKEN entry against 4 stop rules — as set, zone edge, retest-candle wick, and retest wick with break-even on the next candle — × 4 fixed targets (10 / 15 / 20 / 30 points) at the same time, so one chart load scores 16 exit combinations.' +
     '\n\nEach cell shows net points and win %, then net points for the OLDER and NEWER half of the trades. A combination that only wins in one half is noise.' +
     '\n\nBreak-even applies to the fourth row only. Loaded bars only.')
sbGridMax = input.float(0.0, 'Grid — skip trades whose stop is wider than (points, 0 = off)', minval = 0, step = 1, group = g14d,
