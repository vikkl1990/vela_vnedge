// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Combined from:
//   © TFlab — "ICT Venom Trading Model [TradingFinder] SMC NY Session"
//   © TFlab — "Silver Bullet ICT Strategy [TradingFinder] 10-11 AM NY Time +FVG"
//   © tradeforopp (TFO) — displacement detection logic
//
//@version=6
// ==============================================================
// ICT Combined — Venom + Silver Bullet + Displacement + Liquidity
//
// FOUR INDEPENDENT MODULES, one indicator:
//
//   1. VENOM NY MODEL   — dedicated instance, own sessions/toggle.
//   2. SILVER BULLET A/B — two more instances of the same CISD engine,
//                          defaulting to the 10-11 and 14-15 NY windows.
//   3. DISPLACEMENT      — TFO stdev-of-range displacement + FVG marker.
//   4. LIQUIDITY LEVELS  — prior day/week/month H/L, Asia H/L, London H/L,
//                          with raid+rejection sweep detection.
//   5. PREMARKET RANGE   — the 07:00–09:00 NY dealing range graded into
//                          quadrants and octants, carried forward. Sets
//                          premium/discount for the session.
//   6. BODY / WICK LAW   — wicks may violate a 50% level, bodies may not.
//                          Runs against the premarket grid, the first
//                          presented FVG and the opening range gap.
//   ⑭ SB ENTRIES         — graded entry markers where the modules line
//                          up inside a Silver Bullet window: raid → FVG /
//                          IFVG retest, or a first-presented FVG flip,
//                          gated by the ORG CE draw, with a scorecard.
//
// The two TFlab scripts run the SAME CISD engine and differ only in
// session wiring, staleness window and zone extension, so the engine is
// parameterised once and instantiated three times. Each call site gets
// its own `var` state, so the three run fully independently.
//
// FIXES APPLIED vs. the source scripts:
//   1. Bar Back Check input is actually wired through (was hardcoded 120)
//   2. Dead `ta.change(...)` clause removed (no-op, and in a bad scope)
//   3. max_boxes_count declared (Drawing library was capped at 50)
//   4. CISD colour inputs are actually used (were declared, never referenced)
//   5. Opening range no longer absorbs the first bar of the trading window
//   6. Phantom trigger on chart-left removed (CISD level 0.0 gate)
//   7. Displacement bar colour + alert no longer repaint intrabar
// ==============================================================
indicator("ICT Combined — Venom / Silver Bullet / Displacement / Liquidity", "ICT Combo", overlay = true,
     max_bars_back = 5000, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
     dynamic_requests = true)

// Order Block Refiner
import TFlab/OrderBlockRefiner_TradingFinder/2 as Refiner
// Order Block Drawing
import TFlab/OrderBlockDrawing_TradingFinder/4 as Drawing
// FVG Detector
import TFlab/FVGDetectorLibrary/3 as FVG

TZ = 'America/New_York'


// ==============================================================
// INPUTS — VENOM NY MODEL (independent)
// ==============================================================
gV = '① Venom NY Model'
useV   = input.bool(true, 'Enable Venom model', group = gV)
orV    = input.session('0800-0930', 'Opening range',  group = gV)
tsV    = input.session('0930-1700', 'Trading permit', group = gV)
staleV = input.int(270, 'CISD staleness (bars)', minval = 10, group = gV,
     tooltip = 'A CISD level older than this many bars stops being monitored. Venom original: 270.')
extV   = input.int(240, 'Zone extension (bars)', minval = 10, group = gV,
     tooltip = 'How far right Order Block / FVG zones are projected. Venom original: 240.')

// ==============================================================
// INPUTS — SILVER BULLET WINDOWS
// ==============================================================
gWA = '② Silver Bullet — Window A'
useA    = input.bool(true, 'Enable Window A', group = gWA)
presetA = input.string('Silver Bullet AM', 'Preset', ['Silver Bullet AM', 'Silver Bullet PM', 'London Silver Bullet', 'Custom'],
     tooltip = 'Silver Bullet AM      : OR 0900-1000 / trade 1000-1100' +
     '\nSilver Bullet PM      : OR 1300-1400 / trade 1400-1500' +
     '\nLondon Silver Bullet : OR 0200-0300 / trade 0300-0400', group = gWA)
custORA = input.session('0900-1000', 'Custom opening range',  group = gWA)
custTA  = input.session('1000-1100', 'Custom trading permit', group = gWA)

gWB = '③ Silver Bullet — Window B'
useB    = input.bool(true, 'Enable Window B', group = gWB)
presetB = input.string('Silver Bullet PM', 'Preset', ['Silver Bullet AM', 'Silver Bullet PM', 'London Silver Bullet', 'Custom'], group = gWB)
custORB = input.session('1300-1400', 'Custom opening range',  group = gWB)
custTB  = input.session('1400-1500', 'Custom trading permit', group = gWB)

gSB = 'Silver Bullet — shared settings'
staleSB = input.int(90, 'CISD staleness (bars)', minval = 10, group = gSB,
     tooltip = 'Silver Bullet original: 90.')
extSB   = input.int(60, 'Zone extension (bars)', minval = 10, group = gSB,
     tooltip = 'Silver Bullet original: 60.')

gSess = 'Session Frame Display'
showFrameV = input.bool(true, 'Draw Venom frame',    group = gSess, inline = 'fv')
frameColV  = input.color(#9598a1, '',                group = gSess, inline = 'fv')
showFrameA = input.bool(true, 'Draw Window A frame', group = gSess, inline = 'fa')
frameColA  = input.color(#767f99, '',                group = gSess, inline = 'fa')
showFrameB = input.bool(true, 'Draw Window B frame', group = gSess, inline = 'fb')
frameColB  = input.color(#99857f, '',                group = gSess, inline = 'fb')


// ==============================================================
// INPUTS — ENGINE LOGIC (shared by all three instances)
// ==============================================================
gOB = 'Order Blocks Logical Setting'
Refine   = input.bool(true, 'Refine Order Block', group = gOB, inline = 'Refine')
RefineMe = input.string('Defensive', '', ['Defensive', 'Aggressive'], group = gOB, inline = 'Refine')
MLOB     = input.string('Proximal', 'Mitigation Level OB', ['Proximal', '50 % OB', 'Distal'],
     tooltip = 'Determines which level price must react to inside an Order Block.', group = gOB)

gF = 'FVG Logical Setting'
PFVGFilter     = input.bool(false, 'FVG Filter ............', group = gF, inline = 'FVG Filter')
PFVGFilterType = input.string('Defensive', '', ['Very Aggressive', 'Aggressive', 'Defensive', 'Very Defensive'], group = gF, inline = 'FVG Filter',
     tooltip = 'If "On", filters FVGs by zone width. From "Very Aggressive" to "Very Defensive" the required width increases.')
MLFVG          = input.string('Proximal', 'Mitigation Level FVG', ['Proximal', '50 % OB', 'Distal'],
     tooltip = 'Determines which level price must react to inside an FVG.', group = gF)

gC = 'CISD Logical Setting'
BarBackCheck = input.int(120, 'Bar Back Check', minval = 1,
     tooltip = 'How far back to scan for the first opposing-body candle when setting the CISD level.' +
     '\nNOTE: the published TFlab scripts hardcoded this to 120 and ignored their own input. 120 is kept as the default to match that behaviour.', group = gC)


// ==============================================================
// INPUTS — ZONE DISPLAY
// ==============================================================
gDOB = 'Order Block Display Setting'
DOBShow  = input.bool(true, 'Demand Order Block', inline = 'DMOLB', group = gDOB)
DOBColor = input.color(#3dec266b, '', inline = 'DMOLB', group = gDOB)
SOBShow  = input.bool(true, 'Supply Order Block', inline = 'SSOLB', group = gDOB)
SOBColor = input.color(#ff1e1e73, '', inline = 'SSOLB', group = gDOB)

gDF = 'FVG Display Setting'
DFVGShow  = input.bool(true, 'Demand FVG', inline = 'DFVG', group = gDF)
DFVGColor = input.color(#4aa9f76c, '', inline = 'DFVG', group = gDF)
SFVGShow  = input.bool(true, 'Supply FVG', inline = 'SFVG', group = gDF)
SFVGColor = input.color(#f8a93270, '', inline = 'SFVG', group = gDF)

gDC = 'CISD Display Setting'
CISD_AShow   = input.bool(true, 'Show All CISD', group = gDC)
CISD_HShow   = input.bool(true, 'Show High CISD', group = gDC, inline = 'CH')
CISD_LShow   = input.bool(true, 'Show Low CISD',  group = gDC, inline = 'CL')
CISD_HNColor = input.color(#ed1212, 'Name', group = gDC, inline = 'CH')
CISD_LNColor = input.color(#16e61d, 'Name', group = gDC, inline = 'CL')
CISD_HLColor = input.color(#b90000b8, 'Line', group = gDC, inline = 'CH')
CISD_LLColor = input.color(#069206a7, 'Line', group = gDC, inline = 'CL')


// ==============================================================
// INPUTS — DISPLACEMENT MODULE (TFO)
// ==============================================================
gD = '④ Displacement (TFO)'
showDisp       = input.bool(true, 'Enable displacement module', group = gD)
dispWindowOnly = input.bool(true, 'Only inside an active trading window', group = gD)
dispType       = input.string('Open to Close', 'Displacement type', ['Open to Close', 'High to Low'], group = gD)
stdLen         = input.int(100, 'Displacement length', minval = 1, group = gD)
stdX           = input.float(4.0, 'Displacement strength', minval = 0.0, step = 0.5, group = gD)
showDispFvg    = input.bool(true, 'Draw displacement FVG marker box', group = gD)
barsRight      = input.int(5, 'Extend marker right (bars)', minval = 1, maxval = 100, group = gD)
dispColor      = input.color(color.yellow, 'Displacement bar colour', group = gD)
cBullD         = input.color(color.new(color.green, 80), 'Bullish marker box', group = gD)
cBearD         = input.color(color.new(color.red, 80),   'Bearish marker box', group = gD)


// ==============================================================
// INPUTS — LIQUIDITY LEVELS & SWEEPS
// ==============================================================
gL = '⑤ Liquidity Levels'
useLiq     = input.bool(true, 'Enable liquidity levels', group = gL)
liqTrail   = input.bool(false, 'Leave historical level trail', group = gL,
     tooltip = 'Off  = one moving line per level (clean, cheap).' +
     '\nOn = a new segment each time the level updates, leaving prior days/weeks on the chart.' +
     '\nTradingView caps drawings at 500, so a trail across many levels will purge the oldest.')
liqLblSize = input.string('tiny', 'Level label size', ['tiny', 'small', 'normal'], group = gL)

gLd = 'Liquidity — which levels'
sPDH = input.bool(true,  'Prior Day High / Low',   group = gLd, inline = 'pd')
cPD  = input.color(#f7a600, '',                    group = gLd, inline = 'pd')
sPWH = input.bool(true,  'Prior Week High / Low',  group = gLd, inline = 'pw')
cPW  = input.color(#e040fb, '',                    group = gLd, inline = 'pw')
sPMH = input.bool(false, 'Prior Month High / Low', group = gLd, inline = 'pm')
cPM  = input.color(#00bcd4, '',                    group = gLd, inline = 'pm')
sASI = input.bool(true,  'Asia High / Low',        group = gLd, inline = 'as')
cASI = input.color(#7e57c2, '',                    group = gLd, inline = 'as')
sLDN = input.bool(true,  'London High / Low',      group = gLd, inline = 'ld')
cLDN = input.color(#26a69a, '',                    group = gLd, inline = 'ld')
asiaSess = input.session('2000-0000', 'Asia session',   group = gLd, tooltip = 'New York time.')
ldnSess  = input.session('0200-0500', 'London session', group = gLd, tooltip = 'New York time.')

gLs = 'Liquidity — sweep detection'
showSweep  = input.bool(true, 'Mark liquidity sweeps', group = gLs,
     tooltip = 'A sweep is a raid + rejection: price trades THROUGH the level and closes back on the original side. A clean break that closes beyond the level is not a sweep.')
sweepColB  = input.color(#ef5350, 'Buy-side swept (high taken)',  group = gLs)
sweepColS  = input.color(#26a69a, 'Sell-side swept (low taken)',  group = gLs)
dynAlerts  = input.bool(true, 'Emit dynamic alert() on sweeps', group = gLs,
     tooltip = 'Adds a message to the "Any alert() function call" alert type, including the level name, level price and current price.')


// ==============================================================
// INPUTS — FIRST PRESENTED FVG (AM / PM)
// ==============================================================
gFP = '⑥ First Presented FVG'
useFP     = input.bool(true, 'Enable first-presented FVG', group = gFP)
fpAM      = input.session('0931-1300', 'AM session', group = gFP,
     tooltip = 'The window is tested against the MIDDLE candle of the 3-candle pattern — the candle that creates the gap.' +
     '\n\n0931 therefore means the 09:30 opening candle is never the FVG-forming candle.')
fpPM      = input.session('1331-1600', 'PM session', group = gFP,
     tooltip = 'As with the AM window, 1331 means the 13:30 candle is never the FVG-forming candle.')
fpMinSize = input.float(0.0, 'Minimum gap size', minval = 0, step = 0.25, group = gFP,
     tooltip = 'Ignore gaps narrower than this, in price units. 0 accepts any gap.')
fpKeepDays = input.int(10, 'Keep last N days of gaps', minval = 1, maxval = 30, group = gFP,
     tooltip = 'How many days of first-presented gaps stay on the chart. Older ones are deleted as new days form.')
fpCarryAll = input.bool(true, 'Carry every retained gap to the current bar', group = gFP,
     tooltip = 'On: all retained gaps keep extending right, so a Friday chart still shows the whole week plus the tail of the week before.' +
     '\n\nOff: a gap stops at the end of its own day, unless the Monday rule below keeps it going.')
fpCarryMon = input.bool(true, 'Always carry Monday through its week', group = gFP,
     tooltip = 'Monday gaps keep extending until the end of that calendar week even when the setting above is off.')
fpShowCE  = input.bool(true, 'Show consequent encroachment (50%)', group = gFP)
fpBullCol = input.color(#26a69a33, 'Bullish', group = gFP, inline = 'fpc')
fpBearCol = input.color(#ef535033, 'Bearish', group = gFP, inline = 'fpc')
fpCECol   = input.color(#b2b5be, 'CE line', group = gFP, inline = 'fpc')


// ==============================================================
// INPUTS — OPENING RANGE GAP
// ==============================================================
gOG = '⑦ Opening Range Gap'
useOG    = input.bool(true, 'Enable opening range gap', group = gOG)
ogSess   = input.session('0930-1615', 'RTH session', group = gOG,
     tooltip = 'The gap runs from the CLOSE of this session on the prior day to its OPEN today — the ICT Opening Range Gap. Consequent Encroachment is the 50% midpoint.' +
     '\n\nDefault ends 16:15 to match CME index-futures RTH settlement. Use 0930-1600 for cash equities and indices.')
ogMinSize = input.float(5.0, 'Minimum gap size', minval = 0, step = 0.25, group = gOG,
     tooltip = 'Gaps narrower than this are ignored. In price units, not ticks.')
ogExtend = input.int(120, 'Extend right (bars)', minval = 10, group = gOG)
ogShowCE = input.bool(true, 'Show consequent encroachment (50%)', group = gOG)
ogShowQt = input.bool(true, 'Show quadrants (25% / 75%)', group = gOG)
ogCol    = input.color(#78909c26, 'Gap fill', group = gOG, inline = 'ogc')
ogCECol  = input.color(#ffb74d, 'CE line', group = gOG, inline = 'ogc')
ogQtCol  = input.color(#78909c99, 'Quadrants', group = gOG, inline = 'ogc')


// ==============================================================
// INPUTS — PREMARKET DEALING RANGE (07:00–09:00 NY)
// ==============================================================
g8 = '⑧ Premarket Dealing Range'
usePM      = input.bool(true, 'Enable premarket dealing range', group = g8,
     tooltip = 'The 07:00–09:00 New York pre-market dealing range, graded into quadrants and octants and carried forward across the session.' +
     '\n\nAbove the 50% line the market is in PREMIUM, below it DISCOUNT — measured against THIS range, not the RTH or daily range.' +
     '\n\nIntraday timeframes only.')
pmSess     = input.session('0700-0900', 'Premarket window', group = g8,
     tooltip = 'New York time. The highest high and lowest low of this window define the dealing range. It locks when the window closes and is then projected forward.')
pmKeepDays = input.int(2, 'Keep last N days', minval = 1, maxval = 10, group = g8,
     tooltip = 'How many days of grids stay on the chart. Older ones are deleted, drawings and all.')
pmShowBox  = input.bool(true, 'Shade the window',        group = g8)
pmShowEQ   = input.bool(true, 'Equilibrium (50%)',       group = g8)
pmShowQt   = input.bool(true, 'Quadrants (25% / 75%)',   group = g8)
pmShowOc   = input.bool(true, 'Octants (12.5% steps)',   group = g8)
pmShowLbl  = input.bool(true, 'Level labels',            group = g8)
pmHLCol    = input.color(#2962ff, 'Range H/L', group = g8, inline = 'pm1')
pmEQCol    = input.color(#ffb74d, 'EQ',        group = g8, inline = 'pm1')
pmQtCol    = input.color(#78909c, 'Quadrants', group = g8, inline = 'pm2')
pmOcCol    = input.color(#546e7a, 'Octants',   group = g8, inline = 'pm2')
pmBoxCol   = input.color(#2962ff14, 'Window shade', group = g8)


// ==============================================================
// INPUTS — BODY / WICK LAW
// ==============================================================
g9 = '⑨ Body / Wick Law'
useBW   = input.bool(true, 'Enable body/wick law', group = g9,
     tooltip = 'A PD array holds while the CANDLE BODIES stay on the correct side of its 50% (consequent encroachment):' +
     '\n\n• Demand / bullish array — bodies stay in the UPPER half' +
     '\n• Supply / bearish array — bodies stay in the LOWER half' +
     '\n\nWicks are allowed to violate CE freely. Only a CLOSED body through CE counts as a violation.' +
     '\n\nThe same test runs against the ⑧ grid levels: a wick that tags an octant while the body fails to reach it is a rejection.')
bwTaps  = input.int(2, 'Taps to confirm', minval = 1, maxval = 10, group = g9,
     tooltip = 'How many respected interactions before the array is marked confirmed. 1 fires on the first tap.')
bwPMDR  = input.bool(true, 'Test ⑧ grid levels (wick tag, body fails)', group = g9)
bwScope = input.string('Key levels', 'Grid levels to test', ['EQ only', 'Key levels', 'All drawn levels'], group = g9,
     tooltip = 'Which grid levels generate rejection signals. This does not change which levels are DRAWN.' +
     '\n\nKey levels means the range extremes, the quadrants and equilibrium. Testing all nine on a rangebound day produces more markers than the chart can usefully carry.')
bwOnce  = input.bool(true, 'One signal per level per session', group = g9,
     tooltip = 'A level that has signalled stays quiet for the rest of the session, the same way module ⑤ fires each swept level once.' +
     '\n\nWith this off, a level re-signals every time the tap count is met — which on a day spent oscillating around equilibrium means a marker every few bars.')
bwFP    = input.bool(true, 'Test ⑥ first-presented FVG',                group = g9)
bwORG   = input.bool(true, 'Test ⑦ opening range gap',                  group = g9)
bwMark  = input.bool(true, 'Draw markers', group = g9)
bwOkCol = input.color(#26a69a, 'Respected', group = g9, inline = 'bwc')
bwBadCol= input.color(#ef5350, 'Violated',  group = g9, inline = 'bwc')


// ==============================================================
// INPUTS — AM REGIME CLASSIFIER
// ==============================================================
g10 = '⑩ AM Regime'
useRG = input.bool(true, 'Enable AM regime classifier', group = g10,
     tooltip = 'Grades the 07:00–09:00 window and scores how likely the AM session is to consolidate rather than expand.' +
     '\n\nTHIS IS A MEASUREMENT, NOT A RULE. It encodes a claim that has not been tested on your instrument. Run it read-only, compare the score against the realised outcome for a couple of months, then set the weights from your own data.')
rgAM  = input.session('0930-1130', 'AM session to grade', group = g10,
     tooltip = 'The window whose realised behaviour is compared against the premarket classification.')

rgERthr  = input.float(1.60, 'Trending — efficiency (ER × √N) at least', minval = 0.5, step = 0.1, group = g10,
     tooltip = 'Efficiency ratio is net displacement divided by the distance actually travelled, scaled by the square root of the bar count.' +
     '\n\nA random walk sits near 1.0 on ANY timeframe, which is what makes this threshold portable. Higher means more directional.')
rgCLRthr = input.float(0.70, 'Trending — close location at least', minval = 0.5, maxval = 1.0, step = 0.05, group = g10,
     tooltip = 'Where the 09:00 close sits in the window range. 0.70 means the close is in the top 30% (up) or, mirrored, the bottom 30% (down).' +
     '\n\nThis is the measure closest to what the eye judges as "trending".')
rgExpMin = input.float(0.90, 'Trending — range vs 20-day median at least', minval = 0.1, step = 0.05, group = g10,
     tooltip = 'Guards against efficient but tiny. A quiet directional drift is not a trend.')
rgNeed   = input.int(2, 'Factors required to call it trending', minval = 1, maxval = 3, group = g10)

rgTagNear = input.float(0.50, 'Key level counts only within this fraction of the range', minval = 0.05, maxval = 1.0, step = 0.05, group = g10,
     tooltip = 'A level merely sitting inside the window range is not the same as the range having gone TO it. If price blew through a level on its way somewhere else, that level was not the destination and should not score.' +
     '\n\n0.50 means the level must lie in the outer half of the range, measured from whichever extreme is relevant. The nearest level is still reported either way — this only controls whether it scores.')
rgShallow = input.float(0.20, 'Shallow raid — penetration as a fraction of range', minval = 0.01, maxval = 1.0, step = 0.05, group = g10,
     tooltip = 'How far past a key level counts as "barely got there". A shallow raid implies unfinished business and a likely revisit.')
rgWide    = input.float(1.50, 'Range already expanded — multiple of median', minval = 1.0, step = 0.1, group = g10)

rgWtrend = input.int(50, 'Score — trending',              minval = 0, maxval = 100, group = g10)
rgWtag   = input.int(25, 'Score — key level tagged',      minval = 0, maxval = 100, group = g10)
rgWshall = input.int(15, 'Score — raid was shallow',      minval = 0, maxval = 100, group = g10)
rgWwide  = input.int(10, 'Score — range already expanded',minval = 0, maxval = 100, group = g10)
rgConsAt = input.int(70, 'Consolidation expected at or above', minval = 0, maxval = 100, group = g10)
rgExpAt  = input.int(40, 'Expansion likely below',             minval = 0, maxval = 100, group = g10)

rgGate = input.bool(false, 'Let the score suppress ⑥ and ⑨ alerts on consolidation days', group = g10,
     tooltip = 'OFF by default and it should stay off until you have calibrated the weights above against your own sessions.' +
     '\n\nWhen ON, first-presented-FVG retest/CE alerts and body-law grid signals are silenced on days scoring at or above the consolidation threshold. Drawings are unaffected.')


// ==============================================================
// INPUTS — DASHBOARD
// ==============================================================
g11 = 'Dashboard'
useDash  = input.bool(true, 'Show regime dashboard', group = g11)
dashMode = input.string('Trade', 'Detail', ['Trade', 'Diagnostic'], group = g11,
     tooltip = 'TRADE — two lines of fact: the premarket range, and where price sits inside it. Nothing that requires interpretation, nothing unproven. This is the default because a readout you consult mid-session should not be asking you to weigh evidence.' +
     '\n\nDIAGNOSTIC — the full ⑩ breakdown: every factor, its pass or fail, and the composite score. Useful when reviewing, too much while trading.')
dashPos  = input.string('Top right', 'Position', ['Top right', 'Middle right', 'Bottom right', 'Top left', 'Bottom left'], group = g11)
dashSize = input.string('small', 'Text size', ['tiny', 'small', 'normal'], group = g11)
dashHist = input.int(0, 'History rows', minval = 0, maxval = 25, group = g11,
     tooltip = 'A rolling log of prior sessions: premarket classification against the realised AM outcome. This is the calibration record, not a trading readout — leave it at 0 during the session and raise it when reviewing.' +
     '\n\nHistory only accumulates over bars the chart has actually loaded.')
dashStats = input.bool(true, 'Show calibration study', group = g11,
     tooltip = 'Sorts every logged session by how directional its premarket was, splits them into four equal groups, and reports the MEDIAN realised AM efficiency of each.' +
     '\n\nThis answers the question without anyone having to guess a threshold first. If a directional premarket really does imply a choppy morning, the column falls as you read down — and the bottom group, the most directional premarkets, sits clearly below the top one.' +
     '\n\nIf the four numbers are flat, there is no effect to threshold and ⑩ should be switched off. A binary trending/not split cannot tell you that; it can only tell you about whatever cut you already chose.' +
     '\n\nNeeds at least 8 completed sessions. A minute chart loads days; a 5-minute chart loads months.')
dashBg   = input.color(#1e222dcc, 'Background', group = g11, inline = 'dsh')
dashTxt  = input.color(#d1d4dc,   'Text',       group = g11, inline = 'dsh')


// ==============================================================
// INPUTS — SUSPENSION BLOCKS
// ==============================================================
g12 = '⑫ Suspension Blocks'
useSP = input.bool(true, 'Enable suspension blocks', group = g12,
     tooltip = 'A suspension block is an FVG carrying a volume imbalance at BOTH ends — the middle candle\'s body is gapped away from its neighbour\'s body above AND below.' +
     '\n\nAn ordinary FVG leaves one span of unvisited price. A suspension block leaves three stacked spans with no body trade anywhere across them, which is why it tends to be defended harder on the return.' +
     '\n\nDetected on the CHART timeframe, not sourced from 1m — a suspension block is a property of the candles you are looking at.' +
     '\n\nThe test is independent of the master geometry switch: whether a gap IS a suspension block is a fact about the candles, so it does not change when you stop drawing the extension.')
spScope = input.string('Trading windows only', 'Where to scan', ['Everywhere', 'RTH only', 'Trading windows only'], group = g12,
     tooltip = 'TRADING WINDOWS — only inside an active ①②③ permit. Fewest blocks, all of them inside a window you actually trade.' +
