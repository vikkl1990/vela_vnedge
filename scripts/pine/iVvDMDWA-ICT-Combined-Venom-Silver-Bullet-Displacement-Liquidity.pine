spSess    = input.session('0930-1600', 'RTH session', group = g12, tooltip = 'New York time. Used only by the RTH scope.')
spMinSize = input.float(0.0, 'Minimum gap size', minval = 0, step = 0.25, group = g12,
     tooltip = 'Measured wick-to-wick on the FVG itself, before the volume imbalance is added — the same convention module ⑥ uses. 0 keeps every one.')
spKeep    = input.int(8, 'Keep last N', minval = 1, maxval = 50, group = g12,
     tooltip = 'Older blocks are deleted, drawings and all. These accumulate faster than session-scoped zones do.')
