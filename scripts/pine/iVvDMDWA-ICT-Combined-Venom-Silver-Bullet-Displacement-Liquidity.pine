alertcondition(FvgBearTrigA, 'A: Bearish CISD + FVG', 'SHORT {{ticker}} {{interval}} — bearish CISD + unmitigated supply FVG, Window A. Price {{close}}')

alertcondition(BullTrigB, 'B: Bullish CISD', 'LONG  {{ticker}} {{interval}} — bullish CISD confirmed, Window B. Price {{close}}')
alertcondition(BearTrigB, 'B: Bearish CISD', 'SHORT {{ticker}} {{interval}} — bearish CISD confirmed, Window B. Price {{close}}')
alertcondition(FvgBullTrigB, 'B: Bullish CISD + FVG', 'LONG  {{ticker}} {{interval}} — bullish CISD + unmitigated demand FVG, Window B. Price {{close}}')
alertcondition(FvgBearTrigB, 'B: Bearish CISD + FVG', 'SHORT {{ticker}} {{interval}} — bearish CISD + unmitigated supply FVG, Window B. Price {{close}}')

alertcondition(confDisp,  'Displacement candle',  'Displacement + FVG candle formed — {{ticker}} {{interval}} @ {{close}}')
alertcondition(confBullD, 'Bullish displacement', 'LONG  {{ticker}} {{interval}} — bullish displacement + FVG @ {{close}}')
alertcondition(confBearD, 'Bearish displacement', 'SHORT {{ticker}} {{interval}} — bearish displacement + FVG @ {{close}}')

alertcondition(anyBuySide,  'Sweep: any high taken', 'SHORT bias {{ticker}} {{interval}} — buy-side liquidity swept (raid + rejection of a prior high) @ {{close}}')
alertcondition(anySellSide, 'Sweep: any low taken',  'LONG  bias {{ticker}} {{interval}} — sell-side liquidity swept (raid + rejection of a prior low) @ {{close}}')
alertcondition(swPDH, 'Sweep: PDH',     'SHORT bias {{ticker}} {{interval}} — prior day high swept @ {{close}}')
alertcondition(swPDL, 'Sweep: PDL',     'LONG  bias {{ticker}} {{interval}} — prior day low swept @ {{close}}')
alertcondition(swPWH, 'Sweep: PWH',     'SHORT bias {{ticker}} {{interval}} — prior week high swept @ {{close}}')
alertcondition(swPWL, 'Sweep: PWL',     'LONG  bias {{ticker}} {{interval}} — prior week low swept @ {{close}}')
alertcondition(swPMH, 'Sweep: PMH',     'SHORT bias {{ticker}} {{interval}} — prior month high swept @ {{close}}')
alertcondition(swPML, 'Sweep: PML',     'LONG  bias {{ticker}} {{interval}} — prior month low swept @ {{close}}')
alertcondition(swASH, 'Sweep: Asia H',  'SHORT bias {{ticker}} {{interval}} — Asia session high swept @ {{close}}')
alertcondition(swASL, 'Sweep: Asia L',  'LONG  bias {{ticker}} {{interval}} — Asia session low swept @ {{close}}')
