alertcondition(FvgBearTrigV, 'Venom: Bearish CISD + FVG', 'SHORT {{ticker}} {{interval}} — bearish CISD + unmitigated supply FVG, Venom NY. Price {{close}}')

alertcondition(BullTrigA, 'A: Bullish CISD', 'LONG  {{ticker}} {{interval}} — bullish CISD confirmed, Window A. Price {{close}}')
alertcondition(BearTrigA, 'A: Bearish CISD', 'SHORT {{ticker}} {{interval}} — bearish CISD confirmed, Window A. Price {{close}}')
