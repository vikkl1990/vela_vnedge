g14g = '⑭ Entries — ORG gate and grading'
sbGateIn  = input.bool(true, 'ORG gate — do not fade the draw to CE', group = g14g,
     tooltip = 'While today\'s ⑦ opening range gap has NOT had its CE tagged, and price is within the distance below of that CE, entries AGAINST the draw are blocked.' +
     '\n\nGap up → draw is DOWN to CE → longs blocked.\nGap down → draw is UP to CE → shorts blocked.' +
