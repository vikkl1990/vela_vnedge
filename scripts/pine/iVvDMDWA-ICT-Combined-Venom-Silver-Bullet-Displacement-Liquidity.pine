alertcondition(swLDL, 'Sweep: London L','LONG  bias {{ticker}} {{interval}} — London session low swept @ {{close}}')

alertcondition(fpAMform, 'FPFVG AM: formed',  'First presented FVG of the AM session formed — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpAMret and not rgGateOn, 'FPFVG AM: retest',  'First presented AM FVG retested — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpAMce  and not rgGateOn, 'FPFVG AM: CE tap',  'First presented AM FVG consequent encroachment (50%) tapped — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpPMform, 'FPFVG PM: formed',  'First presented FVG of the PM session formed — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpPMret and not rgGateOn, 'FPFVG PM: retest',  'First presented PM FVG retested — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpPMce  and not rgGateOn, 'FPFVG PM: CE tap',  'First presented PM FVG consequent encroachment (50%) tapped — {{ticker}} {{interval}} @ {{close}}')

alertcondition(ogForm,   'ORG: formed',       'Opening range gap set for the day — {{ticker}} {{interval}} @ {{close}}')
alertcondition(ogCEtap,  'ORG: CE tap',       'Opening range gap consequent encroachment (50%) tapped — {{ticker}} {{interval}} @ {{close}}')
alertcondition(ogFilled, 'ORG: filled',       'Opening range gap filled to the prior close — {{ticker}} {{interval}} @ {{close}}')

alertcondition(pmLocked,    'PMDR: range locked',   'Premarket dealing range locked at 09:00 — {{ticker}} {{interval}} @ {{close}}')
alertcondition(pmEnterPrem, 'PMDR: into premium',   'SHORT bias {{ticker}} {{interval}} — price crossed above premarket equilibrium, now in PREMIUM @ {{close}}')
alertcondition(pmEnterDisc, 'PMDR: into discount',  'LONG  bias {{ticker}} {{interval}} — price crossed below premarket equilibrium, now in DISCOUNT @ {{close}}')

alertcondition(pmRejUp and not rgGateOn, 'Body law: grid rejection from below', 'SHORT bias {{ticker}} {{interval}} — wicks tag a premarket grid level, bodies fail to reach it @ {{close}}')
alertcondition(pmRejDn and not rgGateOn, 'Body law: grid rejection from above', 'LONG  bias {{ticker}} {{interval}} — wicks pierce a premarket grid level, bodies hold above it @ {{close}}')

alertcondition(pmFresh, 'Regime: classified at 09:00', 'Premarket window graded — {{ticker}} {{interval}}. See the dashboard for the score and factor breakdown.')
alertcondition(pmFresh and rgScore >= rgConsAt, 'Regime: consolidation expected', 'CAUTION {{ticker}} {{interval}} — premarket trended into a key level. AM session scored as likely to consolidate. Treat morning signals sceptically.')
alertcondition(pmFresh and rgScore <  rgExpAt,  'Regime: expansion likely',       'CLEAR {{ticker}} {{interval}} — premarket did not trend. AM session scored as likely to expand. Normal playbook.')
alertcondition(amFresh, 'Regime: AM outcome recorded', 'AM session closed and graded — {{ticker}} {{interval}}. Compare against the premarket call in the dashboard log.')

alertcondition(fpAMbwOk,  'Body law: FPFVG AM holding',   'First presented AM FVG holding — bodies respecting CE — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpAMbwBad, 'Body law: FPFVG AM violated',  'First presented AM FVG compromised — body closed through CE — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpPMbwOk,  'Body law: FPFVG PM holding',   'First presented PM FVG holding — bodies respecting CE — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpPMbwBad, 'Body law: FPFVG PM violated',  'First presented PM FVG compromised — body closed through CE — {{ticker}} {{interval}} @ {{close}}')
alertcondition(ogBwOk,    'Body law: ORG holding',        'Opening range gap holding — bodies respecting CE — {{ticker}} {{interval}} @ {{close}}')
alertcondition(ogBwBad,   'Body law: ORG violated',       'Opening range gap compromised — body closed through CE — {{ticker}} {{interval}} @ {{close}}')

alertcondition(spBull, 'Suspension block: bullish', 'LONG  bias {{ticker}} {{interval}} — bullish suspension block formed (FVG with volume imbalance at both ends) @ {{close}}')
alertcondition(spBear, 'Suspension block: bearish', 'SHORT bias {{ticker}} {{interval}} — bearish suspension block formed (FVG with volume imbalance at both ends) @ {{close}}')
alertcondition(spBull or spBear, 'Suspension block: any', 'Suspension block formed — {{ticker}} {{interval}} @ {{close}}')

alertcondition(nwFormed, 'NWOG: formed', 'New week opening gap set — {{ticker}} {{interval}} @ {{close}}')
alertcondition(ndFormed, 'NDOG: formed', 'New day opening gap set — {{ticker}} {{interval}} @ {{close}}')

alertcondition(fpAMsusp, 'FPFVG AM: is a suspension block', 'First presented AM FVG is a SUSPENSION BLOCK — imbalance at both ends — {{ticker}} {{interval}} @ {{close}}')
alertcondition(fpPMsusp, 'FPFVG PM: is a suspension block', 'First presented PM FVG is a SUSPENSION BLOCK — imbalance at both ends — {{ticker}} {{interval}} @ {{close}}')

alertcondition(sbSigL, 'SB entry: LONG (any grade)',  'LONG  {{ticker}} {{interval}} — Silver Bullet entry: retest of raid / IFVG / first-presented zone @ {{close}}')
alertcondition(sbSigS, 'SB entry: SHORT (any grade)', 'SHORT {{ticker}} {{interval}} — Silver Bullet entry: retest of raid / IFVG / first-presented zone @ {{close}}')
alertcondition(sbSigL and sbGradeL == 0, 'SB entry: LONG A+',  'LONG  {{ticker}} {{interval}} — Silver Bullet A+ entry @ {{close}}')
alertcondition(sbSigS and sbGradeS == 0, 'SB entry: SHORT A+', 'SHORT {{ticker}} {{interval}} — Silver Bullet A+ entry @ {{close}}')
