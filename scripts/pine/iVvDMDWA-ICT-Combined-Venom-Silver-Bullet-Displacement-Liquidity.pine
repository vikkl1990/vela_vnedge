sbColX    = input.color(#9598a1, 'Blocked', group = g14d, inline = 'sbc')

// --- effective ⑭ settings: the Prop profile overrides the inputs above ---
sbUseA     = sbProp ? true             : sbUseAIn
sbUseB     = sbProp ? false            : sbUseBIn
