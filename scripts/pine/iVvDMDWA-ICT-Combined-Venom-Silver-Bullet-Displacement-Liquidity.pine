sbGridPos = input.string('Bottom left', 'Grid position', ['Top right', 'Middle right', 'Top left', 'Bottom left'], group = g14d)
sbGridSel = input.string('All taken', 'Grid — which trades', ['All taken', 'A+', 'A', 'B', '1st FVG flips'], group = g14d,
     tooltip = 'Score only one grade, or only the first-presented flips. With "1st FVG flips" the top row is the flip stop you have set and the Zone edge row is the old far-edge stop, so one load compares the two.')
sbColAP   = input.color(#00e676, 'A+', group = g14d, inline = 'sbc')
sbColA    = input.color(#29b6f6, 'A',  group = g14d, inline = 'sbc')
