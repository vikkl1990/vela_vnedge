nwKeep = input.int(5, 'Keep last N', minval = 1, maxval = 20, group = g13)

useND = input.bool(true, 'New Day Opening Gap (NDOG)', group = g13,
     tooltip = 'The prior session\'s settlement print to the new session\'s 18:00 open, for each trading day.' +
