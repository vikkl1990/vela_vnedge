g13 = '⑬ NDOG / NWOG'
useNW = input.bool(true, 'New Week Opening Gap (NWOG)', group = g13,
     tooltip = 'Friday\'s settlement print to Sunday\'s 18:00 open — the gap the whole week opens against.' +
