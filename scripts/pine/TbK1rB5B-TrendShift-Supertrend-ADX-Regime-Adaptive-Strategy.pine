//@version=6
strategy("Supertrend + Volatility Regime Switch", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=1, calc_on_every_tick=false)

// ================= INPUTS =================
grpRegime = "Regime Detection (ADX)"
adxLen      = input.int(14, "ADX / DI Length", group=grpRegime)
adxSmooth   = input.int(14, "ADX Smoothing", group=grpRegime)
adxTrendTh  = input.float(25, "Trending Threshold (ADX >)", group=grpRegime)
adxChopTh   = input.float(20, "Choppy Threshold (ADX <)", group=grpRegime)

grpST = "Supertrend"
atrLen        = input.int(10, "ATR Length", group=grpST)
tightMult     = input.float(1.75, "Trending Multiplier (tight)", step=0.25, group=grpST)
wideMult      = input.float(4.5, "Choppy Multiplier (wide)", step=0.25, group=grpST)
disableChop   = input.bool(true, "Disable new entries in choppy regime", group=grpST)
flattenOnChop = input.bool(false, "Flatten open position if regime turns choppy", group=grpST)

grpRisk = "Risk Management"
useTrailing = input.bool(false, "Use trailing stop",group = grpRisk)
riskPct        = input.float(1.0, "Risk per Trade (% of Equity)", minval=0.1, step=0.1, group=grpRisk)
useTP          = input.bool(true, "Use Take Profit (R multiple)", group=grpRisk)
rMultiple      = input.float(2.0, "Take Profit (R multiple)", step=0.5, group=grpRisk)
maxBarsInTrade = input.int(0, "Max Bars in Trade (0 = off)", minval=0, group=grpRisk)

grpDate = "Date Filter"
useDateFilter = input.bool(false, "Use Date Filter", group=grpDate)
startDate     = input.time(timestamp("1 Jan 2024 00:00"), "Start Date", group=grpDate)
endDate       = input.time(timestamp("1 Jan 2030 00:00"), "End Date", group=grpDate)

grpVis = "Visualization"
C_BULL   = input.color(#00FF9D, "Bull / Uptrend", group=grpVis)
C_BEAR   = input.color(#FF0055, "Bear / Downtrend", group=grpVis)
C_CHOP   = input.color(#64748B, "Choppy / No-Trade", group=grpVis)
showFill = input.bool(true, "Gradient Fill", group=grpVis)
showFlips = input.bool(true, "Minimal Flip Labels", group=grpVis)
showRegimeBg = input.bool(false, "Regime Background Tint", group=grpVis)

grpDisp = "Dashboard"
showTable = input.bool(true, "Show Regime Info Table", group=grpDisp)

// ================= REGIME DETECTION =================
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmooth)

bool isTrending = adxVal > adxTrendTh
bool isChoppy   = adxVal < adxChopTh
// values between the two thresholds are a neutral zone -> hold previous regime (hysteresis, avoids flicker)

var string regime = "NEUTRAL"
if isTrending
    regime := "TRENDING"
else if isChoppy
    regime := "CHOPPY"

// ================= DYNAMIC MULTIPLIER =================
var float effectiveMult = tightMult
if regime == "TRENDING"
    effectiveMult := tightMult
else if regime == "CHOPPY"
    effectiveMult := wideMult
// neutral zone keeps whatever multiplier was last active

// ================= SUPERTREND (dynamic multiplier) =================
[stLine, stDir] = ta.supertrend(effectiveMult, atrLen)
// stDir: -1 = uptrend, 1 = downtrend

bool bullFlip = ta.change(stDir) != 0 and stDir == -1
bool bearFlip = ta.change(stDir) != 0 and stDir == 1

// ================= ENTRY GATING =================
bool entriesAllowed = not (isChoppy and disableChop)
bool longSignal  = bullFlip and entriesAllowed
bool shortSignal = bearFlip and entriesAllowed

bool inDateRange = useDateFilter ? (time >= startDate and time <= endDate) : true

// ================= POSITION SIZING =================
float stopDist = math.abs(close - stLine)
float riskAmt  = strategy.equity * (riskPct / 100)
float qty      = stopDist > 0 ? riskAmt / stopDist : 0

// ================= ENTRIES =================
if inDateRange
    if longSignal and strategy.position_size <= 0 and qty > 0
        strategy.entry("Long", strategy.long, qty=qty, comment="LONG")

    if shortSignal and strategy.position_size >= 0 and qty > 0
        strategy.entry("Short", strategy.short, qty=qty, comment="SHORT")

// ================= EXITS (Supertrend trailing stop + optional R-multiple TP) =================
float longTP  = strategy.position_avg_price + stopDist * rMultiple
float shortTP = strategy.position_avg_price - stopDist * rMultiple

if useTrailing and strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=stLine, limit=useTP ? longTP : na)

if useTrailing and strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=stLine, limit=useTP ? shortTP : na)

// optional: flatten immediately if regime turns choppy mid-trade
if flattenOnChop and isChoppy and strategy.position_size != 0
    strategy.close_all(comment="Close (Choppy)")

// optional: time-based exit
var int barsInTrade = 0
barsInTrade := strategy.position_size != 0 ? barsInTrade + 1 : 0
if maxBarsInTrade > 0 and barsInTrade >= maxBarsInTrade and strategy.position_size != 0
    strategy.close_all(comment="Max Bars Exit")

// ================= VISUALS (clean: glow line + fill, minimal flip labels) =================
color lineColor = regime == "CHOPPY" ? C_CHOP : stDir == -1 ? C_BULL : C_BEAR

// soft glow: a couple of wider, more transparent copies of the line sit behind the main line
plot(stLine, "Glow Outer", color=color.new(lineColor, 85), linewidth=6)
plot(stLine, "Glow Inner", color=color.new(lineColor, 65), linewidth=3)
p_st    = plot(stLine, "Supertrend", color=color.new(lineColor, 15), linewidth=2)
p_price = plot(hl2, "Price Mid", display=display.none)

fill(p_price, p_st, color = showFill ? color.new(lineColor, 82) : na, title="Trend Fill")

bgcolor(showRegimeBg ? (regime == "CHOPPY" ? color.new(C_CHOP, 90) : regime == "TRENDING" ? color.new(C_BULL, 95) : na) : na)

// minimal text flip labels (only on confirmed bars, no big shapes)
if showFlips and barstate.isconfirmed
    if longSignal
        label.new(bar_index, stLine, "▲", style=label.style_label_up,
             color=color.new(C_BULL, 30), textcolor=color.white, size=size.small)
    if shortSignal
        label.new(bar_index, stLine, "▼", style=label.style_label_down,
             color=color.new(C_BEAR, 30), textcolor=color.white, size=size.small)

// ================= INFO TABLE ("shifting gears" readout) =================
if showTable
    var table infoTable = table.new(position.top_right, 2, 4, border_width=1)
    table.cell(infoTable, 0, 0, "Regime", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(infoTable, 1, 0, regime,
         bgcolor=regime == "TRENDING" ? color.new(C_BULL, 60) : regime == "CHOPPY" ? color.new(C_CHOP, 60) : color.new(color.orange, 60),
         text_color=color.white)
    table.cell(infoTable, 0, 1, "ADX", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(adxVal, "#.##"), bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(infoTable, 0, 2, "Multiplier", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(effectiveMult, "#.##"), bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(infoTable, 0, 3, "Position", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(infoTable, 1, 3, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         bgcolor=color.new(color.black, 0), text_color=color.white)

