//@version=6
indicator("%B", shorttitle = "%B", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MIDLINE           = 0.5     // %B value of the middle band (the basis)
BULL_COLOR        = #089981
BEAR_COLOR        = #f23645
LEVELS_COLOR      = #787b86
FILL_VALUE_TRANSP = 50      // gradient transparency at the %B value
FILL_MID_TRANSP   = 100     // gradient transparency at the midline

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 2
  , group   = "Settings"
  , tooltip = "Number of bars used for the Bollinger Bands basis (a simple moving average) and for the standard deviation. John Bollinger's default is 20.")

srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Price series the bands and %B are computed from. The formula is typically applied to the close.")

multInput = input.float(2.0, "Multiplier", minval = 0.001, step = 0.25
  , group   = "Settings"
  , tooltip = "Standard deviation multiplier for the upper and lower bands. %B is derived entirely from the bands, so the band settings determine everything downstream. Bollinger's default is 2.")

//---------------------------------------------------------------------------------------------------------------------}
// Thresholds
//---------------------------------------------------------------------------------------------------------------------{
obInput = input.float(1.0, "Overbought", step = 0.05
  , group   = "Thresholds"
  , tooltip = "Level treated as overbought. 1 is the upper band itself, so readings above the default mean price is outside the bands - statistically uncommon, but a strong trend can pin %B there for many bars while price walks the band. Lower it to flag approaches before an actual band tag.")

osInput = input.float(0.0, "Oversold", step = 0.05
  , group   = "Thresholds"
  , tooltip = "Level treated as oversold. 0 is the lower band itself, so readings below the default mean price is outside the bands. Raise it to flag approaches before an actual band tag.")

showMarkersInput = input.bool(false, "Extreme Markers"
  , group   = "Thresholds"
  , tooltip = "Displays a small circle on %B whenever it sits beyond a threshold, with price at or outside the bands. Off by default to keep the pane clean - the overbought/oversold alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of %B above the 0.5 midline, where price trades in the upper half of the bands.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of %B below the 0.5 midline, where price trades in the lower half of the bands.")

gradientFillInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between %B and the 0.5 midline, fully transparent at the midline and more opaque at the oscillator value.")

levelsColorInput = input.color(LEVELS_COLOR, "Levels Color"
  , group   = "Style"
  , tooltip = "Color of the dashed overbought/oversold levels and of the dotted midline.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Bollinger Bands - simple moving average basis with bands a multiple of the standard deviation away
basis = ta.sma(srcInput, lengthInput)
dev   = multInput * ta.stdev(srcInput, lengthInput)

upperBand = basis + dev
lowerBand = basis - dev
bandSpan  = upperBand - lowerBand

// %B - where price sits within the bands: (price - lower band) / (upper band - lower band).
// 1 = at the upper band, 0.5 = at the basis, 0 = at the lower band. The scale is not hard-bounded:
// readings above 1 or below 0 mean price is outside the bands.
// A zero-width band (flat lookback window, zero standard deviation) would divide by zero and returns na instead.
percentB = not na(bandSpan) and bandSpan != 0 ? (srcInput - lowerBand) / bandSpan : na

// Threshold states and events
overbought = not na(percentB) and percentB > obInput
oversold   = not na(percentB) and percentB < osInput

overboughtEntry = ta.crossover(percentB, obInput)
overboughtExit  = ta.crossunder(percentB, obInput)
oversoldEntry   = ta.crossunder(percentB, osInput)
oversoldExit    = ta.crossover(percentB, osInput)
bullishMidCross = ta.crossover(percentB, MIDLINE)
bearishMidCross = ta.crossunder(percentB, MIDLINE)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
percentBColor = percentB > MIDLINE ? bullColorInput : bearColorInput

fillTopColor    = percentB > MIDLINE ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_MID_TRANSP)
fillBottomColor = percentB > MIDLINE ? color.new(bullColorInput, FILL_MID_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

percentBPlotId = plot(percentB, "%B", percentBColor, 1)
midPlotId      = plot(MIDLINE, "Midline", editable = false, display = display.none)

fill(percentBPlotId, midPlotId
  , math.max(percentB, MIDLINE)
  , math.min(percentB, MIDLINE)
  , gradientFillInput ? fillTopColor : na
  , gradientFillInput ? fillBottomColor : na
  , title = "%B Gradient Fill")

hline(obInput, "Overbought", levelsColorInput, hline.style_dashed)
hline(osInput, "Oversold", levelsColorInput, hline.style_dashed)
hline(MIDLINE, "Midline", color.new(levelsColorInput, 50), hline.style_dotted)

plot(showMarkersInput and overbought ? percentB : na, "Overbought Marker", color = bullColorInput, linewidth = 2, style = plot.style_circles)
plot(showMarkersInput and oversold ? percentB : na, "Oversold Marker", color = bearColorInput, linewidth = 2, style = plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(overboughtEntry, "Overbought Entry", "%B crossed above its overbought level on {{ticker}} - at the default threshold of 1 price has moved outside the upper band ({{interval}})")
alertcondition(overboughtExit, "Overbought Exit", "%B crossed back below its overbought level on {{ticker}} - price pulling back inside the bands from above ({{interval}})")
alertcondition(oversoldEntry, "Oversold Entry", "%B crossed below its oversold level on {{ticker}} - at the default threshold of 0 price has moved outside the lower band ({{interval}})")
alertcondition(oversoldExit, "Oversold Exit", "%B crossed back above its oversold level on {{ticker}} - price recovering back inside the bands from below ({{interval}})")
alertcondition(bullishMidCross, "Bullish Midline Cross", "%B crossed above 0.5 on {{ticker}} - price reclaimed the middle band ({{interval}})")
alertcondition(bearishMidCross, "Bearish Midline Cross", "%B crossed below 0.5 on {{ticker}} - price lost the middle band ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
