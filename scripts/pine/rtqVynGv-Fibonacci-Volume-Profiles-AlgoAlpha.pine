//@version=6
indicator("Fibonacci Volume Profiles [AlgoAlpha]", "AlgoAlpha - Fibonacci Volume", true, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// Main Settings
fib_mode = input.string("Continuous", "Fibonacci Mode", options = ["Continuous", "Custom Period"], group = "Main Settings", tooltip = "Choose between continuous Fibonacci levels or a custom time period")
extend_right = input.bool(false, "Extend Fibonacci Lines Right", group = "Main Settings", tooltip = "When using Custom Period mode, extend Fibonacci lines to the right of the chart")
shw_profile = input.bool(true, "Show Profile", group = "Main Settings", tooltip = "Toggle visibility of the volume profile")
pivlen = input.int(30, "Time Horizon (Continuous Mode)", group = "Main Settings", tooltip = "Number of bars to look back for pivot points")

int   DEFAULT_POINT1 = timestamp("2025-02-01")
int   DEFAULT_POINT2 = timestamp("2025-02-07")

int    entryTimeInput      = input.time(DEFAULT_POINT1, "Fibonacci Start", confirm = false, group = "Time Settings", tooltip = "Start time for Custom Period mode")
int    exitTimeInput       = input.time(DEFAULT_POINT2, "Fibonacci End", confirm = false, group = "Time Settings", tooltip = "End time for Custom Period mode")

res = input.int(40, "Profile Resolution", group = "Profile Settings", tooltip = "Number of price levels in the volume profile")
scale = input.int(30, "Profile Horizontal Scale", group = "Profile Settings", tooltip = "Controls the width of the volume profile")
pt = input.int(30, "Profile Transparency", group = "Profile Settings", tooltip = "Controls the transparency of the profile")
pblue = input.color(color.blue, "Profile Color 1", group = "Profile Settings", tooltip = "Controls the color of the profile")
pred = input.color(color.red, "Profile Color 2", group = "Profile Settings", tooltip = "Controls the color of the profile")

// Fibonacci Level Colors
color fib_color_0 = input.color(color.red, "Fib Level 0% Color", group = "Fibonacci Colors", tooltip = "Color for 0% Fibonacci level")
color fib_color_236 = input.color(color.fuchsia, "Fib Level 23.6% Color", group = "Fibonacci Colors", tooltip = "Color for 23.6% Fibonacci level") 
color fib_color_382 = input.color(color.purple, "Fib Level 38.2% Color", group = "Fibonacci Colors", tooltip = "Color for 38.2% Fibonacci level")
color fib_color_500 = input.color(color.blue, "Fib Level 50% Color", group = "Fibonacci Colors", tooltip = "Color for 50% Fibonacci level")
color fib_color_618 = input.color(color.green, "Fib Level 61.8% Color", group = "Fibonacci Colors", tooltip = "Color for 61.8% Fibonacci level")
color fib_color_786 = input.color(color.yellow, "Fib Level 78.6% Color", group = "Fibonacci Colors", tooltip = "Color for 78.6% Fibonacci level")
color fib_color_1000 = input.color(color.orange, "Fib Level 100% Color", group = "Fibonacci Colors", tooltip = "Color for 100% Fibonacci level")

// Fill Colors
color fill_color_0_236 = input.color(color.new(color.red, 90), "Fill 0-23.6%", group = "Fill Colors", tooltip = "Fill color between 0% and 23.6% levels")
color fill_color_236_382 = input.color(color.new(color.orange, 90), "Fill 23.6-38.2%", group = "Fill Colors", tooltip = "Fill color between 23.6% and 38.2% levels")
color fill_color_382_500 = input.color(color.new(color.yellow, 90), "Fill 38.2-50%", group = "Fill Colors", tooltip = "Fill color between 38.2% and 50% levels")
color fill_color_500_618 = input.color(color.new(color.green, 90), "Fill 50-61.8%", group = "Fill Colors", tooltip = "Fill color between 50% and 61.8% levels")
color fill_color_618_786 = input.color(color.new(color.blue, 90), "Fill 61.8-78.6%", group = "Fill Colors", tooltip = "Fill color between 61.8% and 78.6% levels")
color fill_color_786_1000 = input.color(color.new(color.purple, 90), "Fill 78.6-100%", group = "Fill Colors", tooltip = "Fill color between 78.6% and 100% levels")

piv_high = ta.pivothigh(pivlen, pivlen)
piv_low = ta.pivotlow(pivlen, pivlen)

// Function to calculate volume profile based on timestamps
profileCalculation(start_index, end_index, res, scale) =>
    top_boundaries = array.new_float(res)
    bottom_boundaries = array.new_float(res)
    binlen = array.new_float(res)
    highs = array.new_float()
    lows = array.new_float()
    volumes = array.new_float()

    for i = bar_index-start_index to bar_index-end_index
        highs.push(high[i])
        lows.push(low[i])
        volumes.push(volume[i])

    maxx = array.max(highs)
    minn = array.min(lows)
    size = array.size(highs)

    poc = 0.0

    if size > 0
        step = (maxx - minn) / res
        granularity = res
        for i = 0 to granularity - 1
            bin_size = 0.0
            bottom = minn + (i * step)
            top = minn + ((i + 1) * step)
            bottom_boundaries.insert(i, bottom)
            top_boundaries.insert(i, top)
            for j = 0 to array.size(highs) - 1
                candle_above_hbar = lows.get(j) > top
                candle_below_hbar = highs.get(j) < bottom
                is_candle_in_bucket = not (candle_above_hbar or candle_below_hbar)
                bin_size += is_candle_in_bucket ? volumes.get(j) : 0
            array.insert(binlen, i, bin_size)
        boc = binlen.max()
        boci = binlen.indexof(boc) > 0 ? binlen.indexof(boc) : 0
        poc := math.avg(top_boundaries.get(boci), bottom_boundaries.get(boci))

    [top_boundaries, bottom_boundaries, binlen, poc]

if fib_mode == "Continuous"

    var last_piv_dir = 0

    var last_piv_high = 0.0
    var last_piv_low = 0.0

    if not na(piv_high)
        last_piv_dir := 1
        last_piv_high := piv_high
    else if not na(piv_low)
        last_piv_dir := -1
        last_piv_low := piv_low

    l = ta.lowest(pivlen)
    h = ta.highest(pivlen)

    var fib = array.new_line()
    if not na(piv_high) or not na(piv_low)
        if fib.size() > 0
            for i = 0 to fib.size() - 1
                fib.get(i).set_x2(bar_index - pivlen)
        if last_piv_dir[1] > 0
            fib.get(6).set_y2(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 1)
            fib.get(6).set_y1(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 1)
            fib.get(5).set_y2(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.786)
            fib.get(5).set_y1(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.786)
            fib.get(4).set_y2(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.618)
            fib.get(4).set_y1(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.618)
            fib.get(3).set_y2(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.5)
            fib.get(3).set_y1(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.5)
            fib.get(2).set_y2(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.382)
            fib.get(2).set_y1(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.382)
            fib.get(1).set_y2(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.236)
            fib.get(1).set_y1(l[pivlen+1] + (last_piv_high - l[pivlen+1]) * 0.236)
            fib.get(0).set_y2(l[pivlen+1])
            fib.get(0).set_y1(l[pivlen+1])

        if last_piv_dir[1] < 0
            fib.get(0).set_y2(h[pivlen+1])
            fib.get(0).set_y1(h[pivlen+1])
            fib.get(1).set_y2(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.236)
            fib.get(1).set_y1(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.236)
            fib.get(2).set_y2(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.382)
            fib.get(2).set_y1(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.382)
            fib.get(3).set_y2(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.5)
            fib.get(3).set_y1(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.5)
            fib.get(4).set_y2(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.618)
            fib.get(4).set_y1(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.618)
            fib.get(5).set_y2(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.786)
            fib.get(5).set_y1(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 0.786)
            fib.get(6).set_y2(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 1)
            fib.get(6).set_y1(h[pivlen+1] - (h[pivlen+1] - last_piv_low) * 1)

        fib.clear()

        if not na(piv_high)
            fib.unshift(line.new(bar_index - pivlen, l, bar_index, l, color = fib_color_0))
            fib.unshift(line.new(bar_index - pivlen, l + (last_piv_high - l) * 0.236, bar_index, l + (last_piv_high - l) * 0.236, color = fib_color_236))
            fib.unshift(line.new(bar_index - pivlen, l + (last_piv_high - l) * 0.382, bar_index, l + (last_piv_high - l) * 0.382, color = fib_color_382))
            fib.unshift(line.new(bar_index - pivlen, l + (last_piv_high - l) * 0.5, bar_index, l + (last_piv_high - l) * 0.5, color = fib_color_500))
            fib.unshift(line.new(bar_index - pivlen, l + (last_piv_high - l) * 0.618, bar_index, l + (last_piv_high - l) * 0.618, color = fib_color_618))
            fib.unshift(line.new(bar_index - pivlen, l + (last_piv_high - l) * 0.786, bar_index, l + (last_piv_high - l) * 0.786, color = fib_color_786))
            fib.unshift(line.new(bar_index - pivlen, l + (last_piv_high - l) * 1, bar_index, l + (last_piv_high - l) * 1, color = fib_color_1000))
            linefill.new(fib.get(0), fib.get(1), fill_color_0_236)
            linefill.new(fib.get(1), fib.get(2), fill_color_236_382)
            linefill.new(fib.get(2), fib.get(3), fill_color_382_500)
            linefill.new(fib.get(3), fib.get(4), fill_color_500_618)
            linefill.new(fib.get(4), fib.get(5), fill_color_618_786)
            linefill.new(fib.get(5), fib.get(6), fill_color_786_1000)
            
        else if not na(piv_low)
            fib.unshift(line.new(bar_index - pivlen, h, bar_index, h, color = fib_color_0))
            fib.unshift(line.new(bar_index - pivlen, h - (h - last_piv_low) * 0.236, bar_index, h - (h - last_piv_low) * 0.236, color = fib_color_236))
            fib.unshift(line.new(bar_index - pivlen, h - (h - last_piv_low) * 0.382, bar_index, h - (h - last_piv_low) * 0.382, color = fib_color_382))
            fib.unshift(line.new(bar_index - pivlen, h - (h - last_piv_low) * 0.5, bar_index, h - (h - last_piv_low) * 0.5, color = fib_color_500))
            fib.unshift(line.new(bar_index - pivlen, h - (h - last_piv_low) * 0.618, bar_index, h - (h - last_piv_low) * 0.618, color = fib_color_618))
            fib.unshift(line.new(bar_index - pivlen, h - (h - last_piv_low) * 0.786, bar_index, h - (h - last_piv_low) * 0.786, color = fib_color_786))
            fib.unshift(line.new(bar_index - pivlen, h - (h - last_piv_low) * 1, bar_index, h - (h - last_piv_low) * 1, color = fib_color_1000))
            linefill.new(fib.get(0), fib.get(1), fill_color_0_236)
            linefill.new(fib.get(1), fib.get(2), fill_color_236_382)
            linefill.new(fib.get(2), fib.get(3), fill_color_382_500)
            linefill.new(fib.get(3), fib.get(4), fill_color_500_618)
            linefill.new(fib.get(4), fib.get(5), fill_color_618_786)
            linefill.new(fib.get(5), fib.get(6), fill_color_786_1000)

    if fib.size() > 0
        for i = 0 to fib.size() - 1
            fib.get(i).set_x2(bar_index)
        if last_piv_dir == 1 and l < fib.get(0).get_y2()
            fib.get(0).set_y1(l)
            fib.get(0).set_y2(l)
            fib.get(1).set_y1(l + (last_piv_high - l) * 0.236)
            fib.get(1).set_y2(l + (last_piv_high - l) * 0.236)
            fib.get(2).set_y1(l + (last_piv_high - l) * 0.382)
            fib.get(2).set_y2(l + (last_piv_high - l) * 0.382)
            fib.get(3).set_y1(l + (last_piv_high - l) * 0.5)
            fib.get(3).set_y2(l + (last_piv_high - l) * 0.5)
            fib.get(4).set_y1(l + (last_piv_high - l) * 0.618)
            fib.get(4).set_y2(l + (last_piv_high - l) * 0.618)
            fib.get(5).set_y1(l + (last_piv_high - l) * 0.786)
            fib.get(5).set_y2(l + (last_piv_high - l) * 0.786)
            fib.get(6).set_y1(l + (last_piv_high - l) * 1)
            fib.get(6).set_y2(l + (last_piv_high - l) * 1)
        else if last_piv_dir == -1 and h > fib.get(0).get_y2()
            fib.get(0).set_y1(h)
            fib.get(0).set_y2(h)
            fib.get(1).set_y1(h - (h - last_piv_low) * 0.236)
            fib.get(1).set_y2(h - (h - last_piv_low) * 0.236)
            fib.get(2).set_y1(h - (h - last_piv_low) * 0.382)
            fib.get(2).set_y2(h - (h - last_piv_low) * 0.382)
            fib.get(3).set_y1(h - (h - last_piv_low) * 0.5)
            fib.get(3).set_y2(h - (h - last_piv_low) * 0.5)
            fib.get(4).set_y1(h - (h - last_piv_low) * 0.618)
            fib.get(4).set_y2(h - (h - last_piv_low) * 0.618)
            fib.get(5).set_y1(h - (h - last_piv_low) * 0.786)
            fib.get(5).set_y2(h - (h - last_piv_low) * 0.786)
            fib.get(6).set_y1(h - (h - last_piv_low) * 1)
            fib.get(6).set_y2(h - (h - last_piv_low) * 1)

    barsince_high = ta.barssince(not na(piv_high))
    barsince_low = ta.barssince(not na(piv_low))

    /////////////////////////////Volume Profile

    plook = (last_piv_dir == 1 ? barsince_high : barsince_low) + pivlen

    // Calculate start and end indices based on timestamps
    start_index = bar_index - plook
    end_index = bar_index

    // Call the profile calculation function
    [top_boundaries, bottom_boundaries, binlen, poc] = profileCalculation(start_index, end_index, res, scale)

    // Draw the profile based on the returned parameters
    var boxes = array.new_box()

    while boxes.size() > 0
        boxes.shift().delete()

    if shw_profile
        for i = 0 to res - 1
            box_right = bar_index + 7 + scale // binlen.max()
            box_left = box_right - math.round(binlen.get(i)) / math.round(binlen.max()) * scale
            box_top = array.get(top_boundaries, i)
            box_bottom = array.get(bottom_boundaries, i)
            gradient_color = color.from_gradient(binlen.get(i), 0, binlen.max(), pblue, pred)
            array.push(boxes, box.new(box_left, box_top, box_right, box_bottom, border_style = line.style_solid, border_color = gradient_color, border_width = 1, bgcolor = gradient_color))



    var boxes1 = array.new_box()

    // while boxes1.size() > 500
    //     boxes1.shift().delete()

    if not na(piv_high) or not na(piv_low)
        start_index1 = start_index[1]
        end_index1 = start_index - 1

        // Call the profile calculation function
        [top_boundaries1, bottom_boundaries1, binlen1, poc1] = profileCalculation(start_index1, end_index1, res, scale)
        
        if shw_profile
            // Draw the profile based on the returned parameters
            for i = 0 to res - 1
                box_left1 = start_index1 // binlen.max()
                box_right1 = box_left1 + math.round(binlen1.get(i)) / math.round(binlen1.max()) * int(math.abs(end_index1-start_index1)/2)
                box_top1 = array.get(top_boundaries1, i)
                box_bottom1 = array.get(bottom_boundaries1, i)
                gradient_color1 = color.new(color.from_gradient(binlen1.get(i), 0, binlen1.max(), pblue, pred), pt)
                array.push(boxes1, box.new(box_left1, box_top1, box_right1, box_bottom1, border_style = line.style_solid, border_color = gradient_color1, border_width = 1, bgcolor = gradient_color1))

else 
    start_index = ta.valuewhen(time == entryTimeInput, bar_index, 0)
    end_index = ta.valuewhen(time == exitTimeInput, bar_index, 0)

    start_price = ta.valuewhen(time == entryTimeInput, close, 0)
    end_price = ta.valuewhen(time == exitTimeInput, close, 0)
    
    [top_boundaries, bottom_boundaries, binlen, poc] = profileCalculation(start_index, end_index, res, scale)

    if barstate.islast
        if shw_profile
            // Draw volume profile
            for i = 0 to res - 1
                box_left = start_index // binlen.max()
                box_right = box_left + math.round(binlen.get(i)) / math.round(binlen.max()) * int(math.abs(end_index-start_index)/2)
                box_top = array.get(top_boundaries, i)
                box_bottom = array.get(bottom_boundaries, i)
                gradient_color = color.new(color.from_gradient(binlen.get(i), 0, binlen.max(), pblue, pred), pt)
                box.new(box_left, box_top, box_right, box_bottom, border_style = line.style_solid, border_color = gradient_color, border_width = 1, bgcolor = gradient_color)
    
        // Calculate high and low for the custom period
        custom_high = top_boundaries.max()
        custom_low = bottom_boundaries.min()

        // Draw Fibonacci levels based on price direction
        if start_price > end_price
            // Downtrend
            var line0 = line.new(start_index, custom_high, end_index, custom_high, color = fib_color_0)
            var line236 = line.new(start_index, custom_high - (custom_high - custom_low) * 0.236, end_index, custom_high - (custom_high - custom_low) * 0.236, color = fib_color_236)
            var line382 = line.new(start_index, custom_high - (custom_high - custom_low) * 0.382, end_index, custom_high - (custom_high - custom_low) * 0.382, color = fib_color_382)
            var line500 = line.new(start_index, custom_high - (custom_high - custom_low) * 0.5, end_index, custom_high - (custom_high - custom_low) * 0.5, color = fib_color_500)
            var line618 = line.new(start_index, custom_high - (custom_high - custom_low) * 0.618, end_index, custom_high - (custom_high - custom_low) * 0.618, color = fib_color_618)
            var line786 = line.new(start_index, custom_high - (custom_high - custom_low) * 0.786, end_index, custom_high - (custom_high - custom_low) * 0.786, color = fib_color_786)
            var line1000 = line.new(start_index, custom_low, end_index, custom_low, color = fib_color_1000)

            // Add fills between levels
            linefill.new(line0, line236, fill_color_0_236)
            linefill.new(line236, line382, fill_color_236_382)
            linefill.new(line382, line500, fill_color_382_500)
            linefill.new(line500, line618, fill_color_500_618)
            linefill.new(line618, line786, fill_color_618_786)
            linefill.new(line786, line1000, fill_color_786_1000)

            if extend_right
                // Draw extended dashed lines
                line.new(end_index, custom_high, bar_index + 50, custom_high, color = fib_color_0, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_high - (custom_high - custom_low) * 0.236, bar_index + 50, custom_high - (custom_high - custom_low) * 0.236, color = fib_color_236, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_high - (custom_high - custom_low) * 0.382, bar_index + 50, custom_high - (custom_high - custom_low) * 0.382, color = fib_color_382, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_high - (custom_high - custom_low) * 0.5, bar_index + 50, custom_high - (custom_high - custom_low) * 0.5, color = fib_color_500, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_high - (custom_high - custom_low) * 0.618, bar_index + 50, custom_high - (custom_high - custom_low) * 0.618, color = fib_color_618, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_high - (custom_high - custom_low) * 0.786, bar_index + 50, custom_high - (custom_high - custom_low) * 0.786, color = fib_color_786, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_low, bar_index + 50, custom_low, color = fib_color_1000, style = line.style_dashed, extend = extend.right)

        else
            // Uptrend
            var line0 = line.new(start_index, custom_low, end_index, custom_low, color = fib_color_0)
            var line236 = line.new(start_index, custom_low + (custom_high - custom_low) * 0.236, end_index, custom_low + (custom_high - custom_low) * 0.236, color = fib_color_236)
            var line382 = line.new(start_index, custom_low + (custom_high - custom_low) * 0.382, end_index, custom_low + (custom_high - custom_low) * 0.382, color = fib_color_382)
            var line500 = line.new(start_index, custom_low + (custom_high - custom_low) * 0.5, end_index, custom_low + (custom_high - custom_low) * 0.5, color = fib_color_500)
            var line618 = line.new(start_index, custom_low + (custom_high - custom_low) * 0.618, end_index, custom_low + (custom_high - custom_low) * 0.618, color = fib_color_618)
            var line786 = line.new(start_index, custom_low + (custom_high - custom_low) * 0.786, end_index, custom_low + (custom_high - custom_low) * 0.786, color = fib_color_786)
            var line1000 = line.new(start_index, custom_high, end_index, custom_high, color = fib_color_1000)

            // Add fills between levels
            linefill.new(line0, line236, fill_color_0_236)
            linefill.new(line236, line382, fill_color_236_382)
            linefill.new(line382, line500, fill_color_382_500)
            linefill.new(line500, line618, fill_color_500_618)
            linefill.new(line618, line786, fill_color_618_786)
            linefill.new(line786, line1000, fill_color_786_1000)

            if extend_right
                // Draw extended dashed lines
                line.new(end_index, custom_low, bar_index + 50, custom_low, color = fib_color_0, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_low + (custom_high - custom_low) * 0.236, bar_index + 50, custom_low + (custom_high - custom_low) * 0.236, color = fib_color_236, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_low + (custom_high - custom_low) * 0.382, bar_index + 50, custom_low + (custom_high - custom_low) * 0.382, color = fib_color_382, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_low + (custom_high - custom_low) * 0.5, bar_index + 50, custom_low + (custom_high - custom_low) * 0.5, color = fib_color_500, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_low + (custom_high - custom_low) * 0.618, bar_index + 50, custom_low + (custom_high - custom_low) * 0.618, color = fib_color_618, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_low + (custom_high - custom_low) * 0.786, bar_index + 50, custom_low + (custom_high - custom_low) * 0.786, color = fib_color_786, style = line.style_dashed, extend = extend.right)
                line.new(end_index, custom_high, bar_index + 50, custom_high, color = fib_color_1000, style = line.style_dashed, extend = extend.right)