//@version=6
indicator("Ulcer Index", "Ulcer Index", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
int   MAX_LENGTH    = 500
color METRIC_COLOR  = #787b86 // calm readings - the line blends toward the stress color as it approaches the threshold
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput    = input.int(14, "Length", minval = 2, maxval = MAX_LENGTH, group = "Settings", tooltip = "Lookback window n. At each bar of the window the percentage drawdown from the running maximum (from the start of the window through that bar) is squared, the squares are averaged over the n bars, and the square root is taken. 14 is a common charting default; fund analysis often uses much longer windows.")
srcInput       = input.source(close, "Source", group = "Settings", tooltip = "Price series the Ulcer Index is computed on. Close is the standard choice.")
thresholdInput = input.float(5.0, "Alert Threshold", minval = 0.0, step = 0.25, group = "Settings", tooltip = "Reference level drawn as a dashed line and used by the threshold alerts. There is no universal good value; the index scales with the instrument's volatility and the window length, so set it relative to the instrument's own history.")

uiColorInput        = input.color(METRIC_COLOR, "Ulcer Index", inline = "ui", group = "Style", tooltip = "Color of the Ulcer Index near zero. The line and fill blend toward the stress color as the reading approaches the alert threshold.")
stressColorInput    = input.color(BEAR_COLOR, "", inline = "ui", group = "Style")
showFillInput       = input.bool(true, "Gradient Fill", group = "Style", tooltip = "Vertical gradient between zero and the Ulcer Index, fully transparent at zero.")
showDdInput         = input.bool(false, "Drawdown %", inline = "dd", group = "Style", tooltip = "Plot the current percentage drawdown from the window high as columns below zero, the raw ingredient the Ulcer Index averages. Zero at new highs, negative below them.")
ddColorInput        = input.color(color.new(BEAR_COLOR, 50), "", inline = "dd", group = "Style")
thresholdColorInput = input.color(NEUTRAL_COLOR, "Threshold", group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Ulcer Index
//---------------------------------------------------------------------------------------------------------------------{
max_bars_back(srcInput, MAX_LENGTH)

float sumSq       = 0.0
float runMax      = na
bool  windowValid = bar_index >= lengthInput - 1

if windowValid
    for i = 0 to lengthInput - 1
        //oldest bar of the window first, current bar last
        float price = srcInput[lengthInput - 1 - i]

        if na(price)
            windowValid := false
            break

        //running maximum from the start of the window through bar i
        runMax := na(runMax) ? price : math.max(runMax, price)

        if runMax <= 0
            windowValid := false
            break

        //percentage drawdown at bar i, zero at new highs, negative below them
        float dd = 100 * (price - runMax) / runMax
        sumSq += dd * dd

//percentage drawdown of the current bar from the window maximum
float ddCur = windowValid ? 100 * (srcInput - runMax) / runMax : na

//root mean square of the window's percentage drawdowns
float ui = windowValid ? math.sqrt(sumSq / lengthInput) : na

//---------------------------------------------------------------------------------------------------------------------}
// Events
//---------------------------------------------------------------------------------------------------------------------{
bool atHigh      = windowValid and ddCur == 0
bool eventsReady = windowValid and windowValid[1]

//drawdown persists until price reclaims its high
bool drawdownStart = eventsReady and not atHigh and atHigh[1]
bool highReclaimed = eventsReady and atHigh and not atHigh[1]

bool thresholdCrossUp   = ta.crossover(ui, thresholdInput)
bool thresholdCrossDown = ta.crossunder(ui, thresholdInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
//state coloring - calm color at zero blending into the stress color at the alert threshold and beyond
color uiColor = thresholdInput > 0 ? color.from_gradient(ui, 0, thresholdInput, uiColorInput, stressColorInput) : stressColorInput

uiPlotId   = plot(ui, "Ulcer Index", uiColor)
zeroPlotId = plot(0, "Zero Base", color(na), editable = false, display = display.none)

fill(uiPlotId, zeroPlotId, top_value = ui, bottom_value = 0, top_color = showFillInput ? color.new(uiColor, 50) : color(na), bottom_color = showFillInput ? color.new(uiColor, 100) : color(na), title = "Gradient Fill")

plot(showDdInput ? ddCur : na, "Drawdown %", ddColorInput, 1, plot.style_columns)

hline(0, "Zero Level", color.new(NEUTRAL_COLOR, 50), hline.style_dotted)
hline(thresholdInput, "Alert Threshold", thresholdColorInput, hline.style_dashed)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(thresholdCrossUp, "Threshold Cross Up", "Ulcer Index crossed above the alert threshold on {{ticker}} ({{interval}}), drawdown stress is elevated")
alertcondition(thresholdCrossDown, "Threshold Cross Down", "Ulcer Index crossed below the alert threshold on {{ticker}} ({{interval}}), drawdown stress is easing")
alertcondition(drawdownStart, "Drawdown Started", "Price on {{ticker}} ({{interval}}) moved below its lookback high, a new drawdown is underway")
alertcondition(highReclaimed, "Lookback High Reclaimed", "Price on {{ticker}} ({{interval}}) reclaimed its lookback high, percentage drawdown reset to zero")

//---------------------------------------------------------------------------------------------------------------------}
