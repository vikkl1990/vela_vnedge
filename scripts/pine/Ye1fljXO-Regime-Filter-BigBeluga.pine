//@version=6
indicator("Regime Filter [BigBeluga]")

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
len = input.int(20, "Length")

trend = 0
voltrend = 0

// }


// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
hma = ta.hma(hlc3, 15)
vol = ta.hma(volume, 15)

for i = 0 to len 
    if hma > hma[i]
        trend += 1
    else 
        trend -= 1

for i = 0 to len 
    if vol > vol[i]
        voltrend += 1
    else 
        voltrend -= 1


coeff = 10 / len

trend := trend * coeff
voltrend := voltrend * coeff

color_t = trend > 0 ? color.from_gradient(trend, 0, 10, color.orange, color.lime) : color.from_gradient(trend, -10, 0, color.red, color.orange)
// }


// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
plot(voltrend, "Volume Value", color = chart.fg_color)
pt = plot(trend, "Trend Value", color = color_t)
p0 = plot(0, "Zero Line", color = color_t)

fill(p0, pt, 10, 0, color.lime, na)
fill(p0, pt, 0, -10, color(na), color.red)

barcolor(color_t)
plotcandle(open, high, low, close, title='Candles Color', color = color_t, wickcolor=color_t, bordercolor = color_t, force_overlay = true)

val_trend = math.round((trend+10)/2)
val_volum = math.round((voltrend+10)/2)

if barstate.islast

    label.delete(label.new(bar_index, trend, "Trend "+str.tostring(trend, "#.##"), style = label.style_label_left, textcolor = chart.bg_color, color = color_t)[1])
    label.delete(label.new(bar_index, voltrend, "Volume "+str.tostring(voltrend, "#.##"), style = label.style_label_left, textcolor = chart.bg_color, color = chart.fg_color)[1])


    dash = table.new(position.bottom_right, 100, 100, force_overlay = true, border_color = chart.bg_color, border_width = 1)

    dash.merge_cells(1, 0, 11, 0)
    dash.merge_cells(0, 1, 0, 11)

    dash.cell(0, 1, "➕\n\nVOLUME\n\n➖", text_color = chart.fg_color)
    dash.cell(1, 0, "➖  TREND  ➕", text_color = chart.fg_color)

    color_up = #318d5f
    color_pre_dn = #8d3131

    color_pre_up = #366ca7
    color_dn = #8d7c31

    point_col =  val_trend+1 < 6 and 11-val_volum < 6 ? color.from_gradient(11-val_volum, -4, 6, na, color_pre_dn)
                             : val_trend+1 > 6 and 11-val_volum > 6 ? color.from_gradient(11-val_volum, 1, 12, color_pre_up, na)
                             : val_trend+1 > 6 and 11-val_volum < 6 ? color.from_gradient(11-val_volum, -4, 6, na, color_up)
                             : val_trend+1 < 6 and 11-val_volum > 6 ? color.from_gradient(11-val_volum, 1, 12, color_dn, na)
                             : val_trend+1 == 6 and 11-val_volum == 6 ? #2d3e76
                             : #1b2445
    for row = 1 to 11
        for col = 1 to 11
            if row > 0
                dash.cell(col, row
                 , bgcolor =   col < 6 and row < 6 ? color.from_gradient(row, -4, 6, na, color_pre_dn)
                             : col > 6 and row > 6 ? color.from_gradient(row, 1, 12, color_pre_up, na)
                             : col > 6 and row < 6 ? color.from_gradient(row, -4, 6, na, color_up)
                             : col < 6 and row > 6 ? color.from_gradient(row, 1, 12, color_dn, na)
                             : col == 6 and row == 6 ? #2d3e76
                             : #1b2445, height = 3, width = 1)

    dash.cell(val_trend+1, 11-val_volum, height = 3, bgcolor = point_col, text = "🔵", width = 1)

// }
