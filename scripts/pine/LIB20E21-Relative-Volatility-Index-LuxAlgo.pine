//@version=6
indicator("Relative Volatility Index", "RVI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SMOOTH_EMA = "EMA"
SMOOTH_RMA = "Wilder (RMA)"

BULL_COLOR    = #089981 // high readings - volatility concentrated on up moves
BEAR_COLOR    = #f23645 // low readings - volatility concentrated on down moves
NEUTRAL_COLOR = #787b86 // midline readings and the levels themselves

LEVEL_COLOR = NEUTRAL_COLOR
ZONE_TRANSP = 92 // transparency of the soft overbought / oversold zone shading
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
stdevLengthInput = input.int(10, "Stdev Length", minval = 1, group = "Settings", tooltip = "Number of bars used for the standard deviation of closing prices that serves as each bar's volatility reading.")
smoothLengthInput = input.int(14, "Smoothing Length", minval = 1, group = "Settings", tooltip = "Number of bars used to smooth the up and down volatility streams.")
smoothTypeInput = input.string(SMOOTH_EMA, "Smoothing Type", options = [SMOOTH_EMA, SMOOTH_RMA], group = "Settings", tooltip = "Moving average applied to the volatility streams. EMA is Dorsey's classic calculation, Wilder (RMA) matches platforms that use Wilder smoothing.")
obLevelInput = input.float(80, "Overbought Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level above which volatility is considered concentrated on up moves.")
osLevelInput = input.float(20, "Oversold Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level below which volatility is considered concentrated on down moves.")

rviColorInput = input.color(NEUTRAL_COLOR, "RVI Line", group = "Style", tooltip = "Color of the RVI line at the midline. Toward the overbought level it blends into the up-volatility color, toward the oversold level into the down-volatility color.")
upColorInput  = input.color(BULL_COLOR, "Up Volatility", inline = "zones", group = "Style", tooltip = "Color of the line and zone shading at and above the overbought level - volatility concentrated on up moves.")
dnColorInput  = input.color(BEAR_COLOR, "Down Volatility", inline = "zones", group = "Style", tooltip = "Color of the line and zone shading at and below the oversold level - volatility concentrated on down moves.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
sigma = ta.stdev(close, stdevLengthInput)

upVol = close > close[1] ? sigma : 0
dnVol = close < close[1] ? sigma : 0

// both smoothing variants are computed on every bar, the selector only picks the result
emaU = ta.ema(upVol, smoothLengthInput)
emaD = ta.ema(dnVol, smoothLengthInput)
rmaU = ta.rma(upVol, smoothLengthInput)
rmaD = ta.rma(dnVol, smoothLengthInput)

avgU = switch smoothTypeInput
    SMOOTH_EMA => emaU
    SMOOTH_RMA => rmaU

avgD = switch smoothTypeInput
    SMOOTH_EMA => emaD
    SMOOTH_RMA => rmaD

denom = nz(avgU) + nz(avgD)
rvi = denom == 0 ? 0 : 100 * nz(avgU) / denom
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
midLevel = (obLevelInput + osLevelInput) / 2
rviColor = na(rvi) ? rviColorInput : rvi <= midLevel ? color.from_gradient(rvi, osLevelInput, midLevel, dnColorInput, rviColorInput) : color.from_gradient(rvi, midLevel, obLevelInput, rviColorInput, upColorInput)

plot(rvi, "RVI", rviColor, 2)

// Soft zone shading anchored on hidden plots
obZoneId       = plot(obLevelInput, "Overbought Zone Anchor", color(na), editable = false, display = display.none)
osZoneId       = plot(osLevelInput, "Oversold Zone Anchor", color(na), editable = false, display = display.none)
topAnchorId    = plot(100, "Top Anchor", color(na), editable = false, display = display.none)
bottomAnchorId = plot(0, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(upColorInput, ZONE_TRANSP), title = "Up Volatility Zone")
fill(osZoneId, bottomAnchorId, color.new(dnColorInput, ZONE_TRANSP), title = "Down Volatility Zone")

hline(obLevelInput, "Overbought Level", color = LEVEL_COLOR, linestyle = hline.style_dashed)
hline(osLevelInput, "Oversold Level", color = LEVEL_COLOR, linestyle = hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossAboveOb = ta.crossover(rvi, obLevelInput)
crossBelowOb = ta.crossunder(rvi, obLevelInput)
crossBelowOs = ta.crossunder(rvi, osLevelInput)
crossAboveOs = ta.crossover(rvi, osLevelInput)

alertcondition(crossAboveOb, "Overbought Enter", "RVI crossed above the overbought level")
alertcondition(crossBelowOb, "Overbought Exit", "RVI crossed below the overbought level")
alertcondition(crossBelowOs, "Oversold Enter", "RVI crossed below the oversold level")
alertcondition(crossAboveOs, "Oversold Exit", "RVI crossed above the oversold level")
//----------------------------------------------------------------------------------------------------------------------}
