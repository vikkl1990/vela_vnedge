//@version=6
indicator("Elder Impulse System", "Elder Impulse", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
STATE_GREEN =  1
STATE_RED   = -1
STATE_BLUE  =  0

BULL_COLOR    = #089981 // trend EMA and histogram both rising
BEAR_COLOR    = #f23645 // trend EMA and histogram both falling
NEUTRAL_COLOR = #787b86 // the two components disagree
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
emaLengthInput    = input.int(13, "EMA Length",         minval = 1, group = "Settings", tooltip = "Length of the trend EMA applied to close, whose bar-to-bar slope gives the trend component of the impulse.")
fastLengthInput   = input.int(12, "MACD Fast Length",   minval = 1, group = "Settings", tooltip = "Length of the fast EMA of the MACD line.")
slowLengthInput   = input.int(26, "MACD Slow Length",   minval = 1, group = "Settings", tooltip = "Length of the slow EMA of the MACD line.")
signalLengthInput = input.int(9,  "MACD Signal Length", minval = 1, group = "Settings", tooltip = "Length of the EMA applied to the MACD line to build the signal line, the histogram being MACD minus signal.")

bullishColorInput = input.color(BULL_COLOR, "Bullish Bars", group = "Style", tooltip = "Bar color when both the trend EMA and the MACD histogram are rising.")
bearishColorInput = input.color(BEAR_COLOR, "Bearish Bars", group = "Style", tooltip = "Bar color when both the trend EMA and the MACD histogram are falling.")
neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral Bars", group = "Style", tooltip = "Bar color when the trend EMA slope and the MACD histogram slope do not agree.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
trendEma   = ta.ema(close, emaLengthInput)
macdLine   = ta.ema(close, fastLengthInput) - ta.ema(close, slowLengthInput)
signalLine = ta.ema(macdLine, signalLengthInput)
histogram  = macdLine - signalLine

emaRising   = trendEma > trendEma[1]
emaFalling  = trendEma < trendEma[1]
histRising  = histogram > histogram[1]
histFalling = histogram < histogram[1]

impulseState = emaRising and histRising ? STATE_GREEN : emaFalling and histFalling ? STATE_RED : STATE_BLUE

impulseColor = switch impulseState
    STATE_GREEN => bullishColorInput
    STATE_RED   => bearishColorInput
    => neutralColorInput
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
barcolor(impulseColor, title = "Impulse Bars")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
prevImpulseState = nz(impulseState[1], STATE_BLUE)

turnedGreen = impulseState == STATE_GREEN and prevImpulseState != STATE_GREEN
turnedRed   = impulseState == STATE_RED   and prevImpulseState != STATE_RED
turnedBlue  = impulseState == STATE_BLUE  and prevImpulseState != STATE_BLUE

alertcondition(turnedGreen, "Impulse Turned Green", "Elder Impulse System turned green: trend EMA and MACD histogram both rising")
alertcondition(turnedRed,   "Impulse Turned Red",   "Elder Impulse System turned red: trend EMA and MACD histogram both falling")
alertcondition(turnedBlue,  "Impulse Turned Blue",  "Elder Impulse System turned blue: trend EMA and MACD histogram no longer aligned")
//----------------------------------------------------------------------------------------------------------------------}
