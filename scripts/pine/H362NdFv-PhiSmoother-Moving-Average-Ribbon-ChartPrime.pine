        => // '87/90 crossings'
            fastHalo := phiSmooth87
            slowHalo := phiSmooth90
            if cross(phiSmooth87, phiSmooth90)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 87/90' + originalMessage, alertFrequency)
plot(fastHalo, '', #DDDDDD50, 4)
plot(slowHalo, '', #DDDDDD50, 4)



array<float> aPhis = array.from( phiSmooth03, phiSmooth06, phiSmooth09, phiSmooth12, phiSmooth15, phiSmooth18, phiSmooth21, phiSmooth24, phiSmooth27, phiSmooth30,
                                 phiSmooth33, phiSmooth36, phiSmooth39, phiSmooth42, phiSmooth45, phiSmooth48, phiSmooth51, phiSmooth54, phiSmooth57, phiSmooth60,
                                 phiSmooth63, phiSmooth66, phiSmooth69, phiSmooth72, phiSmooth75, phiSmooth78, phiSmooth81, phiSmooth84, phiSmooth87, phiSmooth90)
array<color> aColorGradients = aPhis.chameleonColor(colorScheme, colorBullish, colorBearish)

plot(phiSmooth03, '03', aColorGradients.get( 0))
plot(phiSmooth06, '06', aColorGradients.get( 1))
plot(phiSmooth09, '09', aColorGradients.get( 2))
