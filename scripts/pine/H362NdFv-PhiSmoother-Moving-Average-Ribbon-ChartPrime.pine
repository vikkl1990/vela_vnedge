indicator('PhiSmoother Moving Average Ribbon [ChartPrime]', 'PhiSmoother [ChartPrime]', true)

PhiSmoother(series float Source, simple int Length, simple float Phase=3.7) => // @ChartPrime 
    const float SQRT_PIx2  = math.sqrt(2.0 * math.pi)
    const float MULTIPLIER = -0.5 / 0.93
    float sma2 = math.avg(Source, nz(Source[1], Source))
    if Length > 1
        var int   length_1 = Length - 1
        var float length_2 = Length * 0.52353
        float E = 0.0,  float W = 0.0
        for int i=0 to length_1
            float alpha = (i + Phase - length_2) * MULTIPLIER
            float  beta = 1.0 / (0.2316419 * math.abs(alpha) + 1.0)
            float   phi = (math.exp(math.pow(alpha, 2) * -0.5)
                          *-0.398942280) * beta *
                          ( 0.319381530  + beta *
                          (-0.356563782  + beta *
                          ( 1.781477937  + beta *
                          (-1.821255978  + beta
                          * 1.330274429)))) + 1.011
            if alpha < 0.0
                phi := 1.0 - phi
            float weight = phi / SQRT_PIx2
            W  += weight * sma2[i]
            E  += weight
        W / E
    else
        Source

cross(series float Series1, series float Series2) =>
    (Series1 >  Series2   and Series1[1] <=  Series2[1])
 or (Series1 <  Series2   and Series1[1] >=  Series2[1])

method chameleonColor( series array<float>  Source,
                     simple string ChameleonScheme,
                     simple color     ColorBullish,
                     simple color     ColorBearish) =>
    var array<color> aColors = array.new<color>(Source.size())
    var int   sizeOfSource_1 = Source.size() - 1
    if ChameleonScheme == 'Progression'
        for int i=0 to sizeOfSource_1
            float rank = 0.0
            for int j=0 to sizeOfSource_1
                if i == j
                    continue
                if Source.get(i) > Source.get(j)
                    rank += math.sign(j - i)
                else if Source.get(i) < Source.get(j)
                    rank -= math.sign(j - i)
            aColors.set(i, color.from_gradient(rank, -sizeOfSource_1, sizeOfSource_1, ColorBearish, ColorBullish))
    else if ChameleonScheme == 'Chameleon'
        for int i=0 to sizeOfSource_1
            float rank = 0.0
            for int j=0 to i
                if i == j
                    continue
                if Source.get(i) > Source.get(j)
                    rank += math.sign(j - i)
                else if Source.get(i) < Source.get(j)
                    rank -= math.sign(j - i)
            aColors.set(i, color.from_gradient(rank, -sizeOfSource_1, sizeOfSource_1, ColorBearish, ColorBullish))
    else // ChameleonScheme == 'Binary'
        if not na(Source[1])
            for int i=0 to sizeOfSource_1
                if Source.get(i) > array.get(Source[1],i)
                    aColors.set(i, ColorBullish)
                else
                    aColors.set(i, ColorBearish)
    aColors



string controls = 'PhiSmoother Controls'
float    source = input.source(close,  'Price Source', group=controls,                       tooltip='Select a price source')
float     phase = input.float (  3.7, 'Phase Control', group=controls, maxval=4.5, step=0.5, tooltip='This allows for subtle adjustment (tweaking) of the phase/lag')

string      colors = 'Coloring Preferences'
string colorScheme = input.string('Chameleon', 'Chameleon Color Magic', group=colors, options=['Progression','Chameleon','Binary'])
color colorBullish = input.color (    #FFCC00,   'Coloring - Bullish:', group=colors,  inline='tiles')
color colorBearish = input.color (    #5500CC,            '  Bearish:', group=colors,  inline='tiles')

string         alerts = ' Alert Controls'
string      alertMode = input.string('OFF', 'Alert Mode:', group=alerts, options=['OFF', '3/6 crossings',  '6/9 crossings', '9/12 crossings','12/15 crossings','15/18 crossings','18/21 crossings','21/24 crossings','24/27 crossings','27/30 crossings','30/33 crossings',
                                                                                       '33/36 crossings','36/39 crossings','39/42 crossings','42/45 crossings','45/48 crossings','48/51 crossings','51/54 crossings','54/57 crossings','57/60 crossings','60/63 crossings',
                                                                                       '63/66 crossings','66/69 crossings','69/72 crossings','72/75 crossings','75/78 crossings','78/81 crossings','81/84 crossings','84/87 crossings','87/90 crossings'], tooltip='Select a critical period pairing to alert() on')
string  customMessage = input.text_area( 'Default Message Here...', 'Custom Alert Message:', group=alerts, tooltip='Insert a preferred custom alert() message here. ANY modification of this overrides the original formatted alert message')
string alertFrequency = input.string(alert.freq_once_per_bar_close,      'Alert Frequency:', group=alerts, options=[ alert.freq_all,                 // ALL alert() function calls trigger the alert
                                                                                                                     alert.freq_once_per_bar,        // Only the 1st bar's alert() occurrence triggers one alert
                                                                                                                     alert.freq_once_per_bar_close]) // The alert() function is called lastly at the bar's closure
var bool CUSTOM_ALERT_IS_SET = customMessage != 'Default Message Here...'
var bool ALERTS_ARE_ENABLED  =     alertMode != 'OFF'



float phiSmooth03 = PhiSmoother(source,  3, phase)
float phiSmooth06 = PhiSmoother(source,  6, phase)
float phiSmooth09 = PhiSmoother(source,  9, phase)
float phiSmooth12 = PhiSmoother(source, 12, phase)
float phiSmooth15 = PhiSmoother(source, 15, phase)
float phiSmooth18 = PhiSmoother(source, 18, phase)
float phiSmooth21 = PhiSmoother(source, 21, phase)
float phiSmooth24 = PhiSmoother(source, 24, phase)
float phiSmooth27 = PhiSmoother(source, 27, phase)
float phiSmooth30 = PhiSmoother(source, 30, phase)
float phiSmooth33 = PhiSmoother(source, 33, phase)
float phiSmooth36 = PhiSmoother(source, 36, phase)
float phiSmooth39 = PhiSmoother(source, 39, phase)
float phiSmooth42 = PhiSmoother(source, 42, phase)
float phiSmooth45 = PhiSmoother(source, 45, phase)
float phiSmooth48 = PhiSmoother(source, 48, phase)
float phiSmooth51 = PhiSmoother(source, 51, phase)
float phiSmooth54 = PhiSmoother(source, 54, phase)
float phiSmooth57 = PhiSmoother(source, 57, phase)
float phiSmooth60 = PhiSmoother(source, 60, phase)
float phiSmooth63 = PhiSmoother(source, 63, phase)
float phiSmooth66 = PhiSmoother(source, 66, phase)
float phiSmooth69 = PhiSmoother(source, 69, phase)
float phiSmooth72 = PhiSmoother(source, 72, phase)
float phiSmooth75 = PhiSmoother(source, 75, phase)
float phiSmooth78 = PhiSmoother(source, 78, phase)
float phiSmooth81 = PhiSmoother(source, 81, phase)
float phiSmooth84 = PhiSmoother(source, 84, phase)
float phiSmooth87 = PhiSmoother(source, 87, phase)
float phiSmooth90 = PhiSmoother(source, 90, phase)



float fastHalo = na
float slowHalo = na
if ALERTS_ARE_ENABLED
    var string TICKER = syminfo.tickerid
    string closePrice = str.tostring(close, '0.##')
    string originalMessage = ' crossing occurred at the price: ' + closePrice + ' on ' + TICKER // This may be altered for customization from this original format
    switch alertMode
        '3/6 crossings'  =>
            fastHalo := phiSmooth03
            slowHalo := phiSmooth06
            if cross(phiSmooth03, phiSmooth06)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 3/6'   + originalMessage, alertFrequency)
        '6/9 crossings' =>
            fastHalo := phiSmooth06
            slowHalo := phiSmooth09
            if cross(phiSmooth06, phiSmooth09)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 6/9'   + originalMessage, alertFrequency)
        '9/12 crossings' =>
            fastHalo := phiSmooth09
            slowHalo := phiSmooth12
            if cross(phiSmooth09, phiSmooth12)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 9/12'  + originalMessage, alertFrequency)
        '12/15 crossings' =>
            fastHalo := phiSmooth12
            slowHalo := phiSmooth15
            if cross(phiSmooth12, phiSmooth15)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 12/15' + originalMessage, alertFrequency)
        '15/18 crossings' =>
            fastHalo := phiSmooth15
            slowHalo := phiSmooth18
            if cross(phiSmooth15, phiSmooth18)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 15/18' + originalMessage, alertFrequency)
        '18/21 crossings' =>
            fastHalo := phiSmooth18
            slowHalo := phiSmooth21
            if cross(phiSmooth18, phiSmooth21)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 18/21' + originalMessage, alertFrequency)
        '21/24 crossings' =>
            fastHalo := phiSmooth21
            slowHalo := phiSmooth24
            if cross(phiSmooth21, phiSmooth24)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 21/24' + originalMessage, alertFrequency)
        '24/27 crossings' =>
            fastHalo := phiSmooth24
            slowHalo := phiSmooth27
            if cross(phiSmooth24, phiSmooth27)
