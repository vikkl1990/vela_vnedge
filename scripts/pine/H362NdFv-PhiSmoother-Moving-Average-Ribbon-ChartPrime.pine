        '39/42 crossings' =>
            fastHalo := phiSmooth39
            slowHalo := phiSmooth42
            if cross(phiSmooth39, phiSmooth42)
                alert(CUSTOM_ALERT_IS_SET ? customMessage : 'A 39/42' + originalMessage, alertFrequency)
        '42/45 crossings' =>
