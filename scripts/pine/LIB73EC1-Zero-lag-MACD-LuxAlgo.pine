//@version=6
indicator("Zero-lag MACD", shorttitle = "Zero-lag MACD", overlay = false, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // signal line color
ZERO_LINE_TRANSP  = 90      // zero line transparency
FILL_VALUE_TRANSP = 50      // gradient transparency at the MACD value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line
HIST_GROW_TRANSP  = 40      // histogram transparency while the spread widens
HIST_FADE_TRANSP  = 70      // histogram transparency once the spread narrows

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput          = input.source(close, "Source", group = "Settings",
     tooltip = "Price series fed into the de-lagged averages. Closing prices are the standard choice.")

fastLengthInput   = input.int(12, "Fast Length", minval = 1, group = "Settings",
     tooltip = "Length of the fast de-lagged EMA. Each average is error-corrected as twice the EMA minus the EMA of that EMA, which removes most of the smoothing delay so crossovers arrive a few bars earlier than the classic MACD. The default of 12 keeps comparisons with the standard study meaningful.")

slowLengthInput   = input.int(26, "Slow Length", minval = 1, group = "Settings",
     tooltip = "Length of the slow de-lagged EMA subtracted from the fast one to form the MACD line. Standard default is 26. Shortening the periods compounds responsiveness and noise on top of the de-lag correction, so lengths are usually the second lever rather than the first.")

signalLengthInput = input.int(9, "Signal Length", minval = 1, group = "Settings",
     tooltip = "Length of the signal line that smooths the MACD line. A 9-period average is the standard default inherited from MACD.")

delagSignalInput  = input.bool(true, "De-lag Signal Line", group = "Settings",
     tooltip = "Applies the same 2 x EMA - EMA(EMA) correction to the signal line, so all three components are de-lagged. Published versions differ on which lines they correct; disable to smooth the MACD line with a plain EMA for a slightly steadier, later trigger. Lag compensation is a tradeoff, not a free lunch: signals fire earlier, paid for with overshoot past sharp turns and extra crosses in sideways chop.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Color of the MACD line, gradient fill and histogram above the zero line.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Color of the MACD line, gradient fill and histogram below the zero line.")

signalColorInput  = input.color(SIGNAL_COLOR, "Signal Line", group = "Style",
     tooltip = "Color of the signal line.")

showHistInput     = input.bool(true, "Show Histogram", group = "Style",
     tooltip = "Displays the histogram (MACD line minus signal line) as columns. Bright columns mark a spread that is still widening, faded columns mark a spread already narrowing back toward the signal line - the early inflection cue of the MACD grammar.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the zero line and the MACD line with a vertical gradient, fully transparent at zero and strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// De-lagged fast and slow averages - the double-EMA error correction (twice the EMA minus the EMA of that EMA,
// Mulloy's 1994 construction) compensates most of the smoothing delay, so the resulting lines hug price turns more
// tightly and cross earlier. Visible overshoot beyond a sharp turn followed by a snap back is the correction
// working as designed
fastEma       = ta.ema(srcInput, fastLengthInput)
fastEmaSmooth = ta.ema(fastEma, fastLengthInput)
fastZeroLag   = 2 * fastEma - fastEmaSmooth

slowEma       = ta.ema(srcInput, slowLengthInput)
slowEmaSmooth = ta.ema(slowEma, slowLengthInput)
slowZeroLag   = 2 * slowEma - slowEmaSmooth

// MACD line - the spread between the de-lagged averages
macdLine = fastZeroLag - slowZeroLag

// Signal line - both constructions are computed on every bar, the input selects which one is used
signalEma       = ta.ema(macdLine, signalLengthInput)
signalEmaSmooth = ta.ema(signalEma, signalLengthInput)
signalLine      = delagSignalInput ? 2 * signalEma - signalEmaSmooth : signalEma

// Histogram - MACD line minus its signal line
histogram = macdLine - signalLine

// Standard MACD grammar shifted earlier - signal-line crossovers trigger, zero-line crosses set bias, histogram
// turns read acceleration. Bar-to-bar histogram change is na-guarded over the warmup bars
bullCross     = ta.crossover(macdLine, signalLine)
bearCross     = ta.crossunder(macdLine, signalLine)
zeroCrossUp   = ta.crossover(macdLine, 0)
zeroCrossDown = ta.crossunder(macdLine, 0)

histDelta    = histogram - nz(histogram[1], histogram)
histTurnUp   = histDelta > 0 and nz(histDelta[1]) <= 0
histTurnDown = histDelta < 0 and nz(histDelta[1]) >= 0

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// Histogram shading encodes spread direction - bright while the lines pull apart, faded once they converge again
histExpanding   = histogram >= 0 ? histDelta > 0 : histDelta < 0
histStrongColor = histogram >= 0 ? color.new(bullColorInput, HIST_GROW_TRANSP) : color.new(bearColorInput, HIST_GROW_TRANSP)
histSoftColor   = histogram >= 0 ? color.new(bullColorInput, HIST_FADE_TRANSP) : color.new(bearColorInput, HIST_FADE_TRANSP)
histColor       = histExpanding ? histStrongColor : histSoftColor

plot(showHistInput ? histogram : na, "Histogram", style = plot.style_columns, color = histColor)

zeroPlotId = plot(0, "Zero Line", color = color.new(chart.fg_color, ZERO_LINE_TRANSP), linewidth = 1)

plot(signalLine, "Signal Line", color = signalColorInput, linewidth = 1)

macdPlotId = plot(macdLine, "MACD Line", color = macdLine > 0 ? bullColorInput : bearColorInput, linewidth = 1)

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the MACD value
fillTopColor    = macdLine > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_ZERO_TRANSP)
fillBottomColor = macdLine > 0 ? color.new(bullColorInput, FILL_ZERO_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(macdPlotId, zeroPlotId, top_value = math.max(macdLine, 0), bottom_value = math.min(macdLine, 0), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Zero-line Gradient Fill")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullCross, "Bullish Signal Cross", "Zero-lag MACD crossed above its signal line on {{ticker}} - early upside trigger, expect it a few bars ahead of the classic MACD ({{interval}})")
alertcondition(bearCross, "Bearish Signal Cross", "Zero-lag MACD crossed below its signal line on {{ticker}} - early downside trigger, expect it a few bars ahead of the classic MACD ({{interval}})")
alertcondition(zeroCrossUp, "Bullish Zero Cross", "Zero-lag MACD crossed above zero on {{ticker}} - the de-lagged fast average is back above the slow one, bullish bias ({{interval}})")
alertcondition(zeroCrossDown, "Bearish Zero Cross", "Zero-lag MACD crossed below zero on {{ticker}} - the de-lagged fast average dropped under the slow one, bearish bias ({{interval}})")
alertcondition(histTurnUp, "Histogram Turn Up", "Zero-lag MACD histogram turned up on {{ticker}} - the spread between the lines is swinging back in favor of buyers ({{interval}})")
alertcondition(histTurnDown, "Histogram Turn Down", "Zero-lag MACD histogram turned down on {{ticker}} - the spread between the lines is swinging back in favor of sellers ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
