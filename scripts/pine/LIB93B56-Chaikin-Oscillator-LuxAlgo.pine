//@version=6
indicator("Chaikin Oscillator", "Chaikin Osc", overlay = false, format = format.volume)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // accumulation - readings above zero
BEAR_COLOR    = #f23645 // distribution - readings below zero
NEUTRAL_COLOR = #787b86 // exact zero / warm-up readings and the zero line

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
fastInput = input.int(3, "Fast Length", minval = 1, group = "Settings", tooltip = "Length of the fast EMA applied to the accumulation/distribution line.")
slowInput = input.int(10, "Slow Length", minval = 1, group = "Settings", tooltip = "Length of the slow EMA applied to the accumulation/distribution line.")

oscColorInput  = input.color(NEUTRAL_COLOR, "Oscillator", group = "Style", tooltip = "Color of the Chaikin Oscillator line.")
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style", tooltip = "Line and fill color while the oscillator reads above zero (accumulation).")
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style", tooltip = "Line and fill color while the oscillator reads below zero (distribution).")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
moneyFlowVolume = high == low ? 0. : (2 * close - low - high) / (high - low) * nz(volume)
adLine = ta.cum(moneyFlowVolume)

chaikinOsc = ta.ema(adLine, fastInput) - ta.ema(adLine, slowInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish above zero, bearish below, neutral at zero
oscColor = chaikinOsc > 0 ? bullColorInput : chaikinOsc < 0 ? bearColorInput : oscColorInput

oscPlotId  = plot(chaikinOsc, "Chaikin Oscillator", oscColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward the zero line, following the line color
fill(oscPlotId, zeroPlotId, math.max(chaikinOsc, 0), math.min(chaikinOsc, 0), chaikinOsc > 0 ? color.new(oscColor, FILL_LINE_TRANSP) : color.new(oscColor, FILL_ZERO_TRANSP), chaikinOsc > 0 ? color.new(oscColor, FILL_ZERO_TRANSP) : color.new(oscColor, FILL_LINE_TRANSP), title = "Oscillator Gradient")

hline(0, "Zero Line", NEUTRAL_COLOR, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossUp = ta.crossover(chaikinOsc, 0)
crossDown = ta.crossunder(chaikinOsc, 0)

alertcondition(crossUp, "Zero Cross Up", "Chaikin Oscillator crossed above zero")
alertcondition(crossDown, "Zero Cross Down", "Chaikin Oscillator crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
