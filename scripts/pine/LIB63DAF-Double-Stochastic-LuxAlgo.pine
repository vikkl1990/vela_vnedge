//@version=6
indicator("Double Stochastic", "Double Stochastic", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
VARIANT_BRESSERT = "Bressert (Two-Pass %K)"
VARIANT_BLAU     = "Blau (Double-Smoothed Components)"

MID_LEVEL = 50.

CALC_GROUP   = "Calculation"
LEVELS_GROUP = "Levels"
STYLE_GROUP  = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
variantInput = input.string(VARIANT_BRESSERT, "Variant", options = [VARIANT_BRESSERT, VARIANT_BLAU], group = CALC_GROUP, tooltip = "Published recipe used for the double pass. The Bressert variant ranks price within its high/low range, smooths the result with an EMA, then ranks and smooths that output a second time. The Blau variant applies the two EMA stages separately to the stochastic numerator and denominator before taking their ratio, preserving slightly more responsiveness for the same smoothness.")

srcInput = input.source(close, "Source", group = CALC_GROUP, tooltip = "Price series ranked within the highest high / lowest low range of the first stochastic pass.")

firstLengthInput = input.int(10, "First Stochastic Length", minval = 1, group = CALC_GROUP, tooltip = "Lookback of the first stochastic pass, i.e. the number of bars used for the highest high / lowest low range the source is ranked within.")

firstSmoothInput = input.int(3, "First Smoothing Length", minval = 1, group = CALC_GROUP, tooltip = "EMA length of the first smoothing stage, applied to the first %K pass (Bressert) or to the raw numerator and denominator (Blau).")

secondLengthInput = input.int(10, "Second Stochastic Length", minval = 1, group = CALC_GROUP, tooltip = "Lookback of the second stochastic pass that re-ranks the smoothed first pass within its own range. Used by the Bressert variant only.")

secondSmoothInput = input.int(3, "Second Smoothing Length", minval = 1, group = CALC_GROUP, tooltip = "EMA length of the second smoothing stage, applied to the second %K pass (Bressert) or as the second EMA on the numerator and denominator (Blau).")

obInput = input.float(80, "Overbought Level", minval = 50, maxval = 100, step = 1, group = LEVELS_GROUP, tooltip = "Level above which the oscillator is considered overbought. Double smoothing makes visits to this zone less frequent and more deliberate than on a raw stochastic.")

osInput = input.float(20, "Oversold Level", minval = 0, maxval = 50, step = 1, group = LEVELS_GROUP, tooltip = "Level below which the oscillator is considered oversold. In an uptrend these visits are commonly read as pullback depth rather than reversal setups.")

bullColorInput = input.color(#089981, "Bullish Color", group = STYLE_GROUP, tooltip = "Oscillator and gradient color when the Double Stochastic is above the 50 midline.")

bearColorInput = input.color(#f23645, "Bearish Color", group = STYLE_GROUP, tooltip = "Oscillator and gradient color when the Double Stochastic is below the 50 midline.")

levelsColorInput = input.color(#787b86, "Levels Color", group = STYLE_GROUP, tooltip = "Color of the dashed overbought/oversold levels and of the dotted 50 midline.")

showMarkersInput = input.bool(false, "Extreme Turn Markers", group = STYLE_GROUP, tooltip = "Marks oscillator troughs formed at or below the oversold level and crests formed at or above the overbought level. Off by default to keep the pane clean, the matching alerts cover these events either way.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// First pass range of price
lowestLow = ta.lowest(low, firstLengthInput)
hlRange   = ta.highest(high, firstLengthInput) - lowestLow

// Bressert: %K of price -> EMA -> %K of that output -> EMA
k1        = fixnan(hlRange > 0 ? 100 * (srcInput - lowestLow) / hlRange : na)
smoothK1  = ta.ema(k1, firstSmoothInput)
lowestK1  = ta.lowest(smoothK1, secondLengthInput)
kRange    = ta.highest(smoothK1, secondLengthInput) - lowestK1
k2        = fixnan(kRange > 0 ? 100 * (smoothK1 - lowestK1) / kRange : na)
dssBressert = ta.ema(k2, secondSmoothInput)

// Blau: numerator and denominator are double-smoothed separately before taking the ratio
blauNum = ta.ema(ta.ema(srcInput - lowestLow, firstSmoothInput), secondSmoothInput)
blauDen = ta.ema(ta.ema(hlRange, firstSmoothInput), secondSmoothInput)
dssBlau = fixnan(blauDen > 0 ? 100 * blauNum / blauDen : na)

float dss = variantInput == VARIANT_BRESSERT ? dssBressert : dssBlau

// Level crossing events
bool overboughtEntry = ta.crossover(dss, obInput)
bool overboughtExit  = ta.crossunder(dss, obInput)
bool oversoldEntry   = ta.crossunder(dss, osInput)
bool oversoldExit    = ta.crossover(dss, osInput)

// Rounded turns at the extremes (swing/cycle timing)
bool turnedUp        = not na(dss[2]) and dss > dss[1] and dss[1] <= dss[2]
bool turnedDown      = not na(dss[2]) and dss < dss[1] and dss[1] >= dss[2]
bool oversoldTrough  = turnedUp and dss[1] <= osInput
bool overboughtCrest = turnedDown and dss[1] >= obInput

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
bool isBull = dss > MID_LEVEL

dssPlot = plot(dss, "Double Stochastic", isBull ? bullColorInput : bearColorInput)
midPlot = plot(MID_LEVEL, "Midline Anchor", color = na, editable = false, display = display.none)

// Centered gradient fill, fully transparent at the 50 midline
fill(dssPlot, midPlot, math.max(dss, MID_LEVEL), math.min(dss, MID_LEVEL), isBull ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100), isBull ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50), "Gradient Fill")

hline(obInput, "Overbought", color = levelsColorInput, linestyle = hline.style_dashed)
hline(osInput, "Oversold", color = levelsColorInput, linestyle = hline.style_dashed)
hline(MID_LEVEL, "Midline", color = color.new(levelsColorInput, 50), linestyle = hline.style_dotted)

// Optional extreme turn markers, drawn at the trough/crest bar
plot(showMarkersInput and oversoldTrough ? dss[1] : na, "Oversold Trough Marker", bullColorInput, 2, plot.style_circles, offset = -1)
plot(showMarkersInput and overboughtCrest ? dss[1] : na, "Overbought Crest Marker", bearColorInput, 2, plot.style_circles, offset = -1)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(overboughtEntry, "Overbought Entry", "Double Stochastic on {{ticker}} crossed above its overbought level")
alertcondition(overboughtExit, "Overbought Exit", "Double Stochastic on {{ticker}} crossed back below its overbought level")
alertcondition(oversoldEntry, "Oversold Entry", "Double Stochastic on {{ticker}} crossed below its oversold level")
alertcondition(oversoldExit, "Oversold Exit", "Double Stochastic on {{ticker}} crossed back above its oversold level")
alertcondition(oversoldTrough, "Oversold Trough Turn", "Double Stochastic on {{ticker}} turned up from a trough in the oversold zone")
alertcondition(overboughtCrest, "Overbought Crest Turn", "Double Stochastic on {{ticker}} turned down from a crest in the overbought zone")

//---------------------------------------------------------------------------------------------------------------------}
