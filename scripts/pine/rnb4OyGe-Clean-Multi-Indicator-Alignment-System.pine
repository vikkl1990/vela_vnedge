//@version=5

indicator("Clean Alignment System (No Auto Close)", overlay=true)

// --- INPUTS FOR SCALPING ---

// Shorter lengths for faster reaction
ema9Length = input.int(5, "EMA 9 Length (Scalp)", minval=1, maxval=15)
ema20Length = input.int(10, "EMA 20 Length (Scalp)", minval=1, maxval=30)
rsiLength = input.int(7, "RSI Length (Scalp)", minval=1, maxval=14)
macdFast = input.int(8, "MACD Fast Length (Scalp)", minval=1, maxval=15)
macdSlow = input.int(17, "MACD Slow Length (Scalp)", minval=1, maxval=30)
macdSignal = input.int(5, "MACD Signal Length (Scalp)", minval=1, maxval=10)

// Volume Confirmation for Scalping
volumeLookback = input.int(15, "Volume Avg Lookback", minval=1, maxval=50)
minVolumeConfirm = input.float(1.6, "Min Volume Confirm Multiplier", minval=0.5, step=0.1, tooltip="Volume must be X times the average for confirmation. Aim for 1.5-2.0 for NASDAQ momentum.")

// Time Filter Inputs - 24/7 Trading
enableTimeFilter = input.bool(false, "Enable Time Filter", tooltip="Turn on to restrict trading to specific hours")
string tradingSession = "0930-1610" // Only used if time filter enabled
string sessionTimezone = "America/New_York"

// --- TOGGLE FOR STATUS TABLE ---
showStatusTable = input.bool(true, "Show Status Table")

// --- DISPLAY OPTIONS ---
showEMAs = input.bool(true, "Show EMAs")
showVWAP = input.bool(true, "Show VWAP")

// --- CANDLE BORDER COLOR INPUTS ---
showCandleBorders = input.bool(true, "Show Candle Colors")
buyEntryBorderColor = input.color(color.new(color.lime, 0), "Buy Entry Color")
sellEntryBorderColor = input.color(color.new(color.red, 0), "Sell Entry Color")
exitBorderColor = input.color(color.new(color.orange, 0), "Exit Signal Color")

// --- CALCULATE INDICATORS ---
ema9 = ta.ema(close, ema9Length)
ema20 = ta.ema(close, ema20Length)
vwap = ta.vwap(hlc3)
rsi = ta.rsi(close, rsiLength)
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
avgVolume = ta.ema(volume, volumeLookback)

// --- DETERMINE CONDITIONS ---
ema9Bullish = close > ema9
ema20Bullish = close > ema20
vwapBullish = close > vwap
rsiBullish = rsi > 50
macdBullish = macdLine > signalLine
volumeConfirmation = volume > (avgVolume * minVolumeConfirm)

ema9Bearish = close < ema9
ema20Bearish = close < ema20
vwapBearish = close < vwap
rsiBearish = rsi < 50
macdBearish = macdLine < signalLine

// --- ALIGNMENT CONDITIONS ---
bullishAlignment = ema9Bullish and ema20Bullish and vwapBullish and rsiBullish and macdBullish and volumeConfirmation
bearishAlignment = ema9Bearish and ema20Bearish and vwapBearish and rsiBearish and macdBearish and volumeConfirmation

// --- TIME FILTER LOGIC ---
bool isSessionTime = enableTimeFilter ? time(timeframe.period, tradingSession, sessionTimezone) : true

// --- STATE MANAGEMENT VARIABLES ---
// Tracks the implied position direction (0=flat, 1=long, -1=short)
var int currentSignalDirection = 0

// Tracks if an entry has occurred and we are currently "in a trade" awaiting an exit
var bool isPositionActive = false

// --- ENTRY SIGNAL LOGIC ---
// Initial Entries: Only if flat
bool initialBuySignal = bullishAlignment and not isPositionActive
bool initialSellSignal = bearishAlignment and not isPositionActive

// Continuation Entries
bool continuationBuySignal = false
bool continuationSellSignal = false

// Logic for continuation, only if already in that direction and no active position
if currentSignalDirection == 1 and not isPositionActive
    bool pullbackToEMA9 = low <= ema9 and close > ema9
    bool trendStillBullish = ema20Bullish and rsiBullish and macdBullish
    continuationBuySignal := pullbackToEMA9 and trendStillBullish and volumeConfirmation

if currentSignalDirection == -1 and not isPositionActive
    bool pullbackToEMA9 = high >= ema9 and close < ema9
    bool trendStillBearish = ema20Bearish and rsiBearish and macdBearish
    continuationSellSignal := pullbackToEMA9 and trendStillBearish and volumeConfirmation

// Combine all valid entry points
bool showBuyEntry = (initialBuySignal or continuationBuySignal) and isSessionTime
bool showSellEntry = (initialSellSignal or continuationSellSignal) and isSessionTime

// --- EXIT SIGNAL LOGIC (ONLY SIGNAL-BASED EXITS) ---
bool exitLongSignal = false
if currentSignalDirection == 1 and isPositionActive
    bool exitCond1 = close < ema9 and rsi < 50
    bool exitCond2 = macdLine < signalLine and close < ema20
    exitLongSignal := exitCond1 or exitCond2

bool exitShortSignal = false
if currentSignalDirection == -1 and isPositionActive
    bool exitCond1 = close > ema9 and rsi > 50
    bool exitCond2 = macdLine > signalLine and close > ema20
    exitShortSignal := exitCond1 or exitCond2

// --- UPDATE STATE VARIABLES (NO FORCED CLOSES) ---
if (exitLongSignal or exitShortSignal)
    isPositionActive := false
    currentSignalDirection := 0
else if showBuyEntry and not nz(showBuyEntry[1]) and barstate.isconfirmed
    isPositionActive := true
    currentSignalDirection := 1
else if showSellEntry and not nz(showSellEntry[1]) and barstate.isconfirmed
    isPositionActive := true
    currentSignalDirection := -1

// --- CANDLE COLOR CHANGE ---
signalColor = color(na)

if showCandleBorders
    if showBuyEntry and not nz(showBuyEntry[1]) and barstate.isconfirmed
        signalColor := buyEntryBorderColor
    else if showSellEntry and not nz(showSellEntry[1]) and barstate.isconfirmed
        signalColor := sellEntryBorderColor
    else if (exitLongSignal or exitShortSignal) and not nz((exitLongSignal or exitShortSignal)[1]) and barstate.isconfirmed
        signalColor := exitBorderColor

barcolor(signalColor != color(na) ? signalColor : na, offset=-1, title="Signal Bar Colors")

// --- PLOT INDICATORS ---
plot(showEMAs ? ema9 : na, "EMA 9", color=color.blue, linewidth=1)
plot(showEMAs ? ema20 : na, "EMA 20", color=color.red, linewidth=1)
plot(showVWAP ? vwap : na, "VWAP", color=color.purple, linewidth=1)

// --- STATUS TABLE ---
if showStatusTable and barstate.islast
    var table alignmentTable = table.new(position.top_right, 2, 12, border_width=1, bgcolor=color.black)
   
    // Header
    table.cell(alignmentTable, 0, 0, "Indicator", bgcolor=color.gray, text_color=color.white)
    table.cell(alignmentTable, 1, 0, "Status", bgcolor=color.gray, text_color=color.white)

    // Individual indicator status
    table.cell(alignmentTable, 0, 1, "EMA 9", text_color=color.white)
    table.cell(alignmentTable, 1, 1, ema9Bullish ? "Bullish" : "Bearish", bgcolor=ema9Bullish ? color.green : color.red, text_color=color.white)
    table.cell(alignmentTable, 0, 2, "EMA 20", text_color=color.white)
    table.cell(alignmentTable, 1, 2, ema20Bullish ? "Bullish" : "Bearish", bgcolor=ema20Bullish ? color.green : color.red, text_color=color.white)
    table.cell(alignmentTable, 0, 3, "VWAP", text_color=color.white)
    table.cell(alignmentTable, 1, 3, vwapBullish ? "Bullish" : "Bearish", bgcolor=vwapBullish ? color.green : color.red, text_color=color.white)
    table.cell(alignmentTable, 0, 4, "RSI", text_color=color.white)
    table.cell(alignmentTable, 1, 4, rsiBullish ? "Bullish" : "Bearish", bgcolor=rsiBullish ? color.green : color.red, text_color=color.white)
    table.cell(alignmentTable, 0, 5, "MACD", text_color=color.white)
    table.cell(alignmentTable, 1, 5, macdBullish ? "Bullish" : "Bearish", bgcolor=macdBullish ? color.green : color.red, text_color=color.white)
    table.cell(alignmentTable, 0, 6, "Volume", text_color=color.white)
    table.cell(alignmentTable, 1, 6, volumeConfirmation ? "Confirm" : "Weak", bgcolor=volumeConfirmation ? color.green : color.gray, text_color=color.white)

    // Alignment Status
    table.cell(alignmentTable, 0, 7, "Full Align", text_color=color.white)
    table.cell(alignmentTable, 1, 7, bullishAlignment ? "Bullish" : bearishAlignment ? "Bearish" : "None", bgcolor=bullishAlignment ? color.green : bearishAlignment ? color.red : color.gray, text_color=color.white)
    table.cell(alignmentTable, 0, 8, "Cont. Align", text_color=color.white)
    table.cell(alignmentTable, 1, 8, continuationBuySignal ? "Bullish" : continuationSellSignal ? "Bearish" : "None", bgcolor=continuationBuySignal ? color.lime : continuationSellSignal ? color.maroon : color.gray, text_color=color.white)
    table.cell(alignmentTable, 0, 9, "Entry Plot", text_color=color.white)
    table.cell(alignmentTable, 1, 9, showBuyEntry ? "BUY" : showSellEntry ? "SELL" : "None", bgcolor=showBuyEntry ? color.green : showSellEntry ? color.red : color.gray, text_color=color.white)
    table.cell(alignmentTable, 0, 10, "Exit Plot", text_color=color.white)
    exitText = exitLongSignal or exitShortSignal ? "Exit" : "None"
    exitColor = exitLongSignal or exitShortSignal ? color.orange : color.gray
    table.cell(alignmentTable, 1, 10, exitText, bgcolor=exitColor, text_color=color.white)

    // Overall Signal
    table.cell(alignmentTable, 0, 11, "POSITION", bgcolor=color.gray, text_color=color.white)
    table.cell(alignmentTable, 1, 11, currentSignalDirection == 1 ? "LONG" : currentSignalDirection == -1 ? "SHORT" : "FLAT",
               bgcolor=currentSignalDirection == 1 ? color.green : currentSignalDirection == -1 ? color.red : color.gray, text_color=color.white)

// --- PLOT SIGNALS ---
plotshape(showBuyEntry and not nz(showBuyEntry[1]) and barstate.isconfirmed, style=shape.labelup, location=location.belowbar,
          color=color.new(color.green, 10), size=size.normal, text="BUY",
          textcolor=color.white, offset=-1)

plotshape(showSellEntry and not nz(showSellEntry[1]) and barstate.isconfirmed, style=shape.labeldown, location=location.abovebar,
          color=color.new(color.red, 10), size=size.normal, text="SELL",
          textcolor=color.white, offset=-1)

plotshape(exitLongSignal and not nz(exitLongSignal[1]) and barstate.isconfirmed, style=shape.xcross, location=location.abovebar,
          color=color.new(color.orange, 0), size=size.small, title="Exit Long",
          offset=-1)

plotshape(exitShortSignal and not nz(exitShortSignal[1]) and barstate.isconfirmed, style=shape.xcross, location=location.belowbar,
          color=color.new(color.orange, 0), size=size.small, title="Exit Short",
          offset=-1)

// --- ALERTS (NO FORCED CLOSE ALERTS) ---
alertcondition(showBuyEntry and not nz(showBuyEntry[1]) and barstate.isconfirmed, "Scalp Buy Entry", "BUY ENTRY - Initial or Continuation Signal!")
alertcondition(showSellEntry and not nz(showSellEntry[1]) and barstate.isconfirmed, "Scalp Sell Entry", "SELL ENTRY - Initial or Continuation Signal!")
alertcondition(exitLongSignal and not nz(exitLongSignal[1]) and barstate.isconfirmed, "Exit Long Signal", "EXIT LONG - Signal-based exit!")
alertcondition(exitShortSignal and not nz(exitShortSignal[1]) and barstate.isconfirmed, "Exit Short Signal", "EXIT SHORT - Signal-based exit!")