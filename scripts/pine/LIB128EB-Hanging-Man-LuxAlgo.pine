//@version=6
indicator("Hanging Man"
  , shorttitle       = "Hanging Man"
  , overlay          = true
  , format           = format.price
  , max_lines_count  = 500
  , max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

//Default palette
color BEAR_COLOR    = #f23645
color BULL_COLOR    = #089981
color NEUTRAL_COLOR = #787b86
color LABEL_BG      = #00000000

//Pattern lifecycle states
int STATE_NONE      = 0
int STATE_PENDING   = 1
int STATE_CONFIRMED = 2

string GROUP_PATTERN = "Pattern Shape"
string GROUP_CONTEXT = "Context"
string GROUP_SIGNALS = "Confirmation & Invalidation"
string GROUP_STYLE   = "Style"

string COLOR_ANY  = "Any"
string COLOR_DOWN = "Down-Close Only"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

shadowMultInput = input.float(2., "Minimum Lower Shadow / Body Ratio"
  , minval  = 0.5
  , step    = 0.1
  , group   = GROUP_PATTERN
  , tooltip = "Minimum lower shadow length as a multiple of the real body. The classical description calls for a shadow at least about twice the body's height - proof the market traded heavily lower intraday before buyers rescued the close.")

bodyPctInput = input.float(30., "Maximum Body Size %"
  , minval  = 1
  , maxval  = 75
  , step    = 1
  , group   = GROUP_PATTERN
  , tooltip = "Maximum real body height as a percentage of the bar range. The hanging man carries a small body near the top of its range; lower the cap to demand a more compact body.")

upperPctInput = input.float(10., "Maximum Upper Shadow %"
  , minval  = 0
  , maxval  = 50
  , step    = 0.5
  , group   = GROUP_PATTERN
  , tooltip = "Maximum upper shadow as a percentage of the bar range. Keeps the body pinned near the session high: the hanging man shows little or no upper shadow.")

bodyColorInput = input.string(COLOR_ANY, "Body Color"
  , options = [COLOR_ANY, COLOR_DOWN]
  , group   = GROUP_PATTERN
  , tooltip = "Body colors accepted. Both qualify classically; a down-close is considered marginally more bearish because sellers held part of their intraday gains, but confirmation matters far more than color.")

trendLenInput = input.int(50, "Advance SMA Length"
  , minval  = 2
  , maxval  = 500
  , group   = GROUP_CONTEXT
  , tooltip = "Simple moving average length used to establish the preceding advance: the prior bar must close above this average. Without an uptrend to reverse the candle is just a lower-shadow bar - after a decline the identical shape is a hammer, not a hanging man.")

volumeFilterInput = input.bool(false, "Require Elevated Volume"
  , group   = GROUP_CONTEXT
  , tooltip = "Require elevated volume on the pattern bar. A hanging man on elevated volume suggests real distribution met the intraday break, strengthening the warning; a quiet one is easier to dismiss. Disable on symbols without volume data.")

volMultInput = input.float(1.5, "Minimum Volume"
  , minval  = 0
  , step    = 0.1
  , inline  = "vol"
  , group   = GROUP_CONTEXT
  , tooltip = "Multiple of average volume the pattern bar must exceed to count as elevated.")

volLenInput = input.int(20, "x SMA"
  , minval  = 1
  , inline  = "vol"
  , group   = GROUP_CONTEXT
  , tooltip = "Length of the volume simple moving average used as the elevated-volume reference.")

confirmBarsInput = input.int(3, "Confirmation Window (Bars)"
  , minval  = 1
  , maxval  = 50
  , group   = GROUP_SIGNALS
  , tooltip = "Bars allowed for a confirming close below the hanging man's real body, the classical rule before the signal is considered active - the strict treatment uses the very next session (1). A new high above the pattern high before confirmation restores the uptrend reading and voids the pattern.")

trackBarsInput = input.int(20, "Post-Confirmation Stop Tracking (Bars)"
  , minval  = 0
  , maxval  = 500
  , group   = GROUP_SIGNALS
  , tooltip = "Once confirmed, the pattern high keeps extending as the natural invalidation stop for this many bars - new highs above it restore the uptrend reading. Set to 0 to stop tracking at confirmation.")

showLabelsInput = input.bool(true, "Show Pattern Labels"
  , group   = GROUP_STYLE
  , tooltip = "Labels each hanging man above the candle that printed it.")

showLevelsInput = input.bool(true, "Trigger & Stop Levels"
  , group   = GROUP_STYLE
  , tooltip = "Draws the confirmation trigger at the pattern body bottom and the invalidation stop at the pattern high while the pattern is tracked.")

highlightInput = input.bool(false, "Highlight Pattern Candles"
  , group   = GROUP_STYLE
  , tooltip = "Colors the hanging man candle itself.")

showBasisInput = input.bool(false, "Show Trend Basis"
  , group   = GROUP_STYLE
  , tooltip = "Plots the moving average used as the preceding-advance filter.")

bearColorInput = input.color(BEAR_COLOR, "Bearish Pattern", inline = "colors", group = GROUP_STYLE)

invalidColorInput = input.color(BULL_COLOR, "Invalidation / Stop", inline = "colors", group = GROUP_STYLE)

basisColorInput = input.color(NEUTRAL_COLOR, "Trend Basis", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{

float barRange    = high - low
float body        = math.abs(close - open)
float bodyBottom  = math.min(close, open)
float upperShadow = high - math.max(close, open)
float lowerShadow = bodyBottom - low

float trendSma = ta.sma(close, trendLenInput)
float volSma   = ta.sma(volume, volLenInput)
float volRatio = not na(volSma) and volSma > 0 ? volume / volSma : na

//Shape: a small real body near the top of the range, a long lower shadow at least about twice the body,
//and little or no upper shadow. A strictly zero body is a dragonfly doji, not a hanging man
bool smallBody  = barRange > 0 and body > 0 and body <= barRange * bodyPctInput / 100
bool longLower  = lowerShadow >= body * shadowMultInput
bool smallUpper = upperShadow <= barRange * upperPctInput / 100

//Body color matters little; a down-close is considered marginally more bearish
bool bodyColorOk = bodyColorInput == COLOR_ANY or close < open

//Elevated activity supports the distribution reading of the intraday break
bool elevatedVol = not volumeFilterInput or not na(volSma) and volume > volSma * volMultInput

//Context is mandatory: the shape only reads as a hanging man after a preceding advance.
//The same candle at the bottom of a decline is a hammer and reads bullish instead
bool advance = not na(trendSma[1]) and close[1] > trendSma[1]

bool hangingMan = smallBody and longLower and smallUpper and bodyColorOk and advance and elevatedVol

//---------------------------------------------------------------------------------------------------------------------}
// Confirmation & Invalidation Tracking
//---------------------------------------------------------------------------------------------------------------------{

var int   patternState = STATE_NONE
var int   patternBar   = na
var int   confirmBar   = na
var float triggerPrice = na
var float stopPrice    = na
var line  triggerLine  = na
var line  stopLine     = na

bool confirmEvent = false
bool invalidEvent = false

//Extend the active trigger and stop levels into the current bar
if patternState != STATE_NONE
    if not na(triggerLine)
        line.set_x2(triggerLine, bar_index)
    if not na(stopLine)
        line.set_x2(stopLine, bar_index)

//Resolve a pending hanging man with this bar's action. The invalidation check runs first: a print above
//the pattern high restores the uptrend reading even when the same bar later breaks down
if patternState == STATE_PENDING and bar_index > patternBar
    if high > stopPrice
        invalidEvent := true
        patternState := STATE_NONE
    else if close < triggerPrice
        confirmEvent := true
        confirmBar   := bar_index
        patternState := trackBarsInput > 0 ? STATE_CONFIRMED : STATE_NONE
        triggerLine  := na
    else if bar_index - patternBar >= confirmBarsInput
        patternState := STATE_NONE

//Once positioned, the pattern high remains the invalidation reference: new highs above it restore the uptrend
else if patternState == STATE_CONFIRMED
    if high > stopPrice
        invalidEvent := true
        patternState := STATE_NONE
    else if bar_index - confirmBar >= trackBarsInput
        patternState := STATE_NONE

//Drop the line handles once tracking ends; the drawn levels stay in place as the historical record
if patternState == STATE_NONE
    triggerLine := na
    stopLine    := na

//A new hanging man starts (or replaces) the tracked pattern
if hangingMan
    patternState := STATE_PENDING
    patternBar   := bar_index
    triggerPrice := bodyBottom
    stopPrice    := high

    if showLevelsInput
        triggerLine := line.new(bar_index, bodyBottom, bar_index + 1, bodyBottom, color = bearColorInput, style = line.style_dashed)
        stopLine    := line.new(bar_index, high, bar_index + 1, high, color = invalidColorInput, style = line.style_dashed)
    else
        triggerLine := na
        stopLine    := na

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{

if hangingMan and showLabelsInput
    string bodyNote   = close < open ? "Down-close body, marginally more bearish." : "Up-close body."
    string volumeNote = na(volRatio) ? "" : " on " + str.tostring(volRatio, "#.##") + "x average volume"
    string patternTip = "Hanging man after an advance: the session broke sharply lower (shadow " +
       str.tostring(lowerShadow / body, "#.##") + "x body" + volumeNote + ") before buyers rescued the close - the first evidence of meaningful selling at these levels. " +
       bodyNote + " Awaiting a confirming close below " + str.tostring(bodyBottom, format.mintick) +
       " within " + str.tostring(confirmBarsInput) + " bar(s); a new high above " + str.tostring(high, format.mintick) + " restores the uptrend reading."
    label.new(bar_index, high, "Hanging Man", style = label.style_label_down, color = LABEL_BG, textcolor = bearColorInput, size = size.small, tooltip = patternTip)

plot(trendSma, "Trend Basis", showBasisInput ? basisColorInput : color(na), 1)

barcolor(highlightInput and hangingMan ? bearColorInput : color(na), title = "Hanging Man Candles")

plotshape(confirmEvent, "Confirmation", shape.triangledown, location.abovebar, color = bearColorInput, size = size.tiny)

plotshape(invalidEvent, "Invalidation", shape.xcross, location.abovebar, color = invalidColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(hangingMan, "Hanging Man Detected", "Hanging man on {{ticker}} ({{interval}}) - a deep intraday break was bought back after an advance, the first evidence of meaningful selling at these levels. Classical treatment demands a confirming close below the pattern body before acting")

alertcondition(confirmEvent, "Hanging Man Confirmed", "Hanging man confirmed on {{ticker}} ({{interval}}) - a following close below the pattern body. Bearish signal active; the pattern high is the natural stop reference")

alertcondition(invalidEvent, "Hanging Man Invalidated", "Hanging man invalidated on {{ticker}} ({{interval}}) - a new high above the pattern high restored the uptrend reading")

//---------------------------------------------------------------------------------------------------------------------}
