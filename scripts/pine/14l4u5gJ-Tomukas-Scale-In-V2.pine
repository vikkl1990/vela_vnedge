//@version=6
strategy("Tomukas Scale-In V2", overlay=true, pyramiding=5, process_orders_on_close=true)

// =====================
// TREND FILTER
// =====================
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

bullTrend = ema100 > ema200
bearTrend = ema100 < ema200

plot(ema100, "EMA100", color=color.yellow)
plot(ema200, "EMA200", color=color.orange, linewidth=2)

// =====================
// LIQUIDITY SWEEP
// =====================
lookback = input.int(20, "Sweep Lookback")

prevLow  = ta.lowest(low[1], lookback)
prevHigh = ta.highest(high[1], lookback)

longSweep =
     bullTrend and
     low < prevLow and
     close > prevLow and
     close > open

shortSweep =
     bearTrend and
     high > prevHigh and
     close < prevHigh and
     close < open

// =====================
// SCALE-IN ENGINE
// =====================
q1 = input.float(10, "Entry 1")
q2 = input.float(10, "Entry 2")
q3 = input.float(20, "Entry 3")
q4 = input.float(40, "Entry 4")
q5 = input.float(80, "Entry 5")

// FIRST ENTRY
if longSweep and strategy.position_size == 0
    strategy.entry("L1", strategy.long, qty=q1)

if shortSweep and strategy.position_size == 0
    strategy.entry("S1", strategy.short, qty=q1)

// LONG SCALES
if strategy.position_size > 0 and longSweep and strategy.opentrades == 1
    strategy.entry("L2", strategy.long, qty=q2)

if strategy.position_size > 0 and longSweep and strategy.opentrades == 2
    strategy.entry("L3", strategy.long, qty=q3)

if strategy.position_size > 0 and longSweep and strategy.opentrades == 3
    strategy.entry("L4", strategy.long, qty=q4)

if strategy.position_size > 0 and longSweep and strategy.opentrades == 4
    strategy.entry("L5", strategy.long, qty=q5)

// SHORT SCALES
if strategy.position_size < 0 and shortSweep and strategy.opentrades == 1
    strategy.entry("S2", strategy.short, qty=q2)

if strategy.position_size < 0 and shortSweep and strategy.opentrades == 2
    strategy.entry("S3", strategy.short, qty=q3)

if strategy.position_size < 0 and shortSweep and strategy.opentrades == 3
    strategy.entry("S4", strategy.short, qty=q4)

if strategy.position_size < 0 and shortSweep and strategy.opentrades == 4
    strategy.entry("S5", strategy.short, qty=q5)

// =====================
// TAKE PROFIT ONLY
// =====================
atrLen = input.int(14, "ATR Length")
tpATR  = input.float(1.5, "TP ATR Multiplier")

atr = ta.atr(atrLen)

longTP  = strategy.position_avg_price + atr * tpATR
shortTP = strategy.position_avg_price - atr * tpATR

if strategy.position_size > 0
    strategy.exit("TP LONG", limit=longTP)

if strategy.position_size < 0
    strategy.exit("TP SHORT", limit=shortTP)

// =====================
// VISUALS
// =====================
plotshape(longSweep and strategy.position_size == 0,
     title="BUY",
     location=location.belowbar,
     style=shape.triangleup,
     color=color.lime,
     size=size.small)

plotshape(shortSweep and strategy.position_size == 0,
     title="SELL",
     location=location.abovebar,
     style=shape.triangledown,
     color=color.red,
     size=size.small) 
     // Version 2.1 - Updated description
     

    
