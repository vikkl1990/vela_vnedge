bool showRisk = input.bool(false, "Show scenario zone / risk levels", group=G_VIEW)
bool showSingles = input.bool(false, "Show single SH / SL levels", group=G_VIEW)
int eqExtendBars = input.int(50, "EQ Line Extension (bars)", 5, 500, 5, group=G_VIEW)
color sweepColor = input.color(#FF9100, "Sweep", group=G_VIEW)
bool showWatermark = input.bool(true, "Watermark", group=G_VIEW)
color bullColor = input.color(#00E676, "Bull", group=G_VIEW, inline="col")
color bearColor = input.color(#FF5252, "Bear", group=G_VIEW, inline="col")
color fibColor = input.color(#42A5F5, "Fib", group=G_VIEW, inline="col2")
color zoneColor = input.color(#FFD600, "Setup zone", group=G_VIEW, inline="col2")
color liqColor = input.color(#B388FF, "Liquidity", group=G_VIEW, inline="col3")

bool jsonAlerts = input.bool(true, "Structured JSON payload", group=G_ALERT)
bool alertEntries = input.bool(true, "Confirmed signals", group=G_ALERT)
bool alertLifecycle = input.bool(true, "Scenario cancellation / outcome", group=G_ALERT)
bool alertApproach = input.bool(false, "Approach / touch (closed-bar observations)", group=G_ALERT)
bool alertStructure = input.bool(false, "Structure events", group=G_ALERT)
bool alertLiquidity = input.bool(false, "Liquidity sweep events", group=G_ALERT)

fib(float hi, float lo, float ratio, int direction) =>
    direction == 1 ? hi - (hi - lo) * ratio : lo + (hi - lo) * ratio

acceptSwing(bool enabled, float price, float opposite, float threshold, int side) =>
    not enabled or na(opposite) or (side == 1 ? price - opposite : opposite - price) >= threshold

zoneState(int side, float lo, float hi, float o, float h, float l, float c) =>
    side == 1 ? (c > hi ? 2 : h > hi and c < lo and o <= hi ? 1 : 0) : (c < lo ? 2 : l < lo and c > hi and o >= lo ? 1 : 0)

reclaim(float level, int direction, float o, float h, float l, float c, float tolerance) =>
    not na(level) and l <= level + tolerance and h >= level - tolerance and (direction == 1 ? c > level and c >= o : c < level and c <= o)

locationPass(string policy, bool zoneOk, float independentWeight, float minimum) =>
    bool fibOk = independentWeight >= minimum
    policy == "Zone AND Fib" ? zoneOk and fibOk : policy == "Zone OR Fib" ? zoneOk or fibOk : fibOk

validRisk(int direction, float entry, float stop, float target, float tick) =>
    float minimum = tick * (1 - 1e-8)
    not na(entry) and not na(stop) and not na(target) and tick > 0 and (direction == 1 ? entry - stop >= minimum and target - entry >= minimum : stop - entry >= minimum and entry - target >= minimum)

outcome(int direction, float stop, float target, float h, float l) =>
    bool hitStop = direction == 1 ? l <= stop : h >= stop
    bool hitTarget = direction == 1 ? h >= target : l <= target
    hitStop and hitTarget ? 7 : hitStop ? 4 : hitTarget ? 6 : 0

engulfBounds(bool strict, float o, float c, float po, float pc, int direction) =>
    direction == 1 ? c > o and pc < po and (strict ? o < pc and c > po : o <= pc and c >= po and (o < pc or c > po)) : c < o and pc > po and (strict ? o > pc and c < po : o >= pc and c <= po and (o > pc or c < po))

px(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

jnum(float value) =>
    na(value) ? "null" : str.tostring(value, format.mintick)

escapeJson(string value) =>
    str.replace_all(str.replace_all(str.replace_all(value, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")

rrText(float value) =>
    na(value) ? "—" : str.tostring(value, "0.00") + "R"

stateText(int state) =>
    switch state
        0 => "Waiting for zone"
        1 => "Approaching"
        2 => "Waiting for trigger"
        3 => "Signal confirmed"
        4 => "Invalidated"
        5 => "Expired"
        6 => "Target reached"
        7 => "Ambiguous bar"
        8 => "Grid replaced"
        => "—"

dirText(int direction) =>
    direction == 1 ? "LONG" : direction == -1 ? "SHORT" : "Neutral"

positionValue = switch panelPosition
    "Top Left" => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left" => position.bottom_left
    => position.top_right
textSize = fontSize == "Tiny" ? size.tiny : fontSize == "Normal" ? size.normal : size.small
bool dark = themeInput == "Dark" ? true : themeInput == "Light" ? false : color.r(chart.bg_color) < 128
color textColor = dark ? #E0E0E0 : #1A1A1A
color textMuted = dark ? #9E9E9E : #757575
color panelBg = dark ? color.new(#131722, 5) : color.new(#FFFFFF, 5)
color panelBorder = dark ? #2A2E39 : #D0D0D0
color panelAlt = dark ? #1C2030 : #F0F4F8
color headerBg = #2962FF
color watermarkColor = dark ? color.new(#FFFFFF, 80) : color.new(#000000, 80)
string structureStyle = structLineStyle == "Solid" ? line.style_solid : structLineStyle == "Dotted" ? line.style_dotted : line.style_dashed

type Swing
    float price = na
    int idx = na
    int stamp = na
    bool broken = false

type Liquidity
    int id
    int side
    float lo
    float hi
    int startTime
    int secondIdx
    int born
    string kind
    int state = 0

type FibLeg
    int id = na
    int direction = 0
    float hi = na
    float lo = na
    int startTime = na
    int endTime = na
    int endIdx = na
    int hiIdx = na
    int loIdx = na
    int hiTime = na
    int loTime = na
    int born = na
    string origin = ""
    bool live = false
    bool valid = false

type Scenario
    int id = na
    int direction = 0
    int born = na
    int stamp = na
    int state = 0
    float hi = na
    float lo = na
    float zoneLo = na
    float zoneHi = na
    float invalid = na
    float entry = na
    float stop = na
    float target = na
    float obstacle = na
    float rr = na
    float room = na
    int signalBar = na
    int signalTime = na
    string origin = ""
    string trigger = ""
    string reason = ""
    bool touched = false
    float independent = 0
    float referenceAtr = na

var array<label> historyLabels = array.new<label>()
var array<line> historyLines = array.new<line>()
var array<Liquidity> liquidity = array.new<Liquidity>()
var array<Scenario> history = array.new<Scenario>()
var array<string> events = array.new<string>()
var array<string> eventTexts = array.new<string>()

mark(int stamp, float value, string title, int side, color col, string tooltip) =>
    while array.size(historyLabels) >= 150
        label.delete(array.shift(historyLabels))
    array.push(historyLabels, label.new(stamp, value, title, xloc=xloc.bar_time, style=side == 1 ? label.style_label_down : label.style_label_up, color=color.new(col, 100), textcolor=col, size=title == "✗" or title == "▲" or title == "▼" or title == "BOS" or title == "CHoCH" or title == "INITIAL" ? size.small : size.tiny, tooltip=tooltip))

segment(int stamp, float value, color col, bool structural = false) =>
    while array.size(historyLines) >= 110
        line.delete(array.shift(historyLines))
    array.push(historyLines, line.new(stamp, value, time, value, xloc=xloc.bar_time, color=col, style=structural ? structureStyle : line.style_dashed, width=structural ? structLineWidth : 1))

addZone(int side, float price, int idx, int stamp, float tolerance) =>
    int mergeAt = -1
    if array.size(liquidity) > 0
        for i = 0 to array.size(liquidity) - 1
            Liquidity z = array.get(liquidity, i)
            if z.side == side and z.state == 0 and math.abs(price - (side == 1 ? z.hi : z.lo)) <= tolerance
                mergeAt := i
    float lo = price
    float hi = price
    int firstTime = stamp
    string kind = side == 1 ? "SH" : "SL"
    if mergeAt >= 0
        Liquidity old = array.get(liquidity, mergeAt)
        lo := math.min(old.lo, price)
        hi := math.max(old.hi, price)
        firstTime := old.startTime
        old.state := 3
        kind := side == 1 ? "EQH" : "EQL"
    if array.size(liquidity) >= 64
        int removable = -1
        for i = 0 to array.size(liquidity) - 1
            if array.get(liquidity, i).state != 0
                removable := i
                break
        array.remove(liquidity, removable >= 0 ? removable : 0)
    array.push(liquidity, Liquidity.new(stamp * 2 + (side == 1 ? 1 : 0), side, lo, hi, firstTime, idx, bar_index, kind))

nearestObstacle(int direction, float entry, float dayHigh, float dayLow, float sessHigh, float sessLow) =>
    float nearest = na
    if array.size(liquidity) > 0
        for z in liquidity
            float level = direction == 1 ? math.max(entry, z.lo) : math.min(entry, z.hi)
            if z.state == 0 and z.side == direction and (direction == 1 ? z.hi >= entry : z.lo <= entry)
                if na(nearest) or math.abs(level - entry) < math.abs(nearest - entry)
                    nearest := level
    array<float> contextLevels = array.from(dayHigh, dayLow, sessHigh, sessLow)
    for level in contextLevels
        if not na(level) and (direction == 1 ? level >= entry : level <= entry)
            if na(nearest) or math.abs(level - entry) < math.abs(nearest - entry)
                nearest := level
    nearest

fibWeight(float hi, float lo, int direction, float tolerance) =>
    float weight = 0
    if not na(hi) and not na(lo) and hi > lo
        if use236 and reclaim(fib(hi, lo, 0.236, direction), direction, open, high, low, close, tolerance)
            weight := 1
        if reclaim(fib(hi, lo, 0.382, direction), direction, open, high, low, close, tolerance)
            weight := math.max(weight, 1.5)
        if reclaim(fib(hi, lo, 0.500, direction), direction, open, high, low, close, tolerance)
            weight := math.max(weight, 2)
        if reclaim(fib(hi, lo, 0.618, direction), direction, open, high, low, close, tolerance)
            weight := math.max(weight, 2.5)
        if reclaim(fib(hi, lo, 0.786, direction), direction, open, high, low, close, tolerance)
            weight := math.max(weight, 1.5)
    weight

emitEvent(string kind, int direction, int identity, float level, Scenario snapshot) =>
    string eventId = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time) + "|" + kind + "|" + str.tostring(identity)
    string record = '{"event_id":"' + escapeJson(eventId) + '","type":"' + kind + '","direction":' + str.tostring(direction) + ',"entity_id":' + (na(identity) ? "null" : str.tostring(identity)) + ',"scenario_id":' + (na(snapshot) ? "null" : str.tostring(snapshot.id)) + ',"level":' + jnum(level)
    if not na(snapshot)
        record += ',"state":' + str.tostring(snapshot.state) + ',"trigger":"' + escapeJson(snapshot.trigger) + '","entry":' + jnum(snapshot.entry) + ',"invalidation":' + jnum(snapshot.invalid) + ',"stop":' + jnum(snapshot.stop) + ',"target":' + jnum(snapshot.target) + ',"obstacle":' + jnum(snapshot.obstacle) + ',"rr":' + (na(snapshot.rr) ? "null" : str.tostring(snapshot.rr, "0.000")) + ',"room_r":' + (na(snapshot.room) ? "null" : str.tostring(snapshot.room, "0.000")) + ',"fib_weight":' + str.tostring(snapshot.independent, "0.0") + ',"stop_model":"' + stopModel + '","target_model":"' + targetModel + '"'
    array.push(events, record + '}')
    string human = str.upper(kind) + " · " + dirText(direction) + " · " + px(level)
    if not na(snapshot)
        human += " | " + stateText(snapshot.state) + " | " + snapshot.trigger + " | E " + px(snapshot.entry) + " SL " + px(snapshot.stop) + " TP " + px(snapshot.target) + " | " + rrText(snapshot.rr)
    array.push(eventTexts, human)

htfStructure(int length) =>
    float ph = ta.pivothigh(high, length, length)
    float pl = ta.pivotlow(low, length, length)
    var float lastHigh = na
    var float lastLow = na
    var int bias = 0
    if not na(ph)
        lastHigh := ph
    if not na(pl)
        lastLow := pl
    if not na(lastHigh) and close > lastHigh
        bias := 1
        lastHigh := na
    else if not na(lastLow) and close < lastLow
        bias := -1
        lastLow := na
    [bias[1], time_close[1]]

float atr = ta.atr(14)
float pivotHigh = ta.pivothigh(high, swingLen, swingLen)
float pivotLow = ta.pivotlow(low, swingLen, swingLen)
float body = math.abs(close - open)
float bodyAvg = ta.ema(body, 14)
bool sizePattern = body > bodyAvg and body[1] < bodyAvg[1]
bool bullEngulf = sizePattern and engulfBounds(strictEngulf, open, close, open[1], close[1], 1)
bool bearEngulf = sizePattern and engulfBounds(strictEngulf, open, close, open[1], close[1], -1)
bool ready = bar_index >= math.max(3 * swingLen, 50) and not na(atr) and atr > 0 and chart.is_standard
bool htfValid = timeframe.in_seconds(htf) > timeframe.in_seconds()
[htfBias, htfCloseTime] = request.security(syminfo.tickerid, htf, htfStructure(swingLen), lookahead=barmerge.lookahead_on)
[prevDayH, prevDayL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
bool dayValid = timeframe.isintraday
bool inSession = timeframe.isintraday and not na(time(timeframe.period, sessionHours + ":" + sessionDays, sessionTz))
int sessionStartTime = time("1D", sessionHours + ":" + sessionDays, sessionTz)
int sessionEndTime = time_close("1D", sessionHours + ":" + sessionDays, sessionTz)
bool sessionBarAligned = inSession and time == time(timeframe.period, sessionHours + ":" + sessionDays, sessionTz) and time_close == time_close(timeframe.period, sessionHours + ":" + sessionDays, sessionTz)
var float currentSessionH = na
var float currentSessionL = na
var float previousSessionH = na
var float previousSessionL = na
var bool sessionCompleteStart = false
var int previousSessionStart = na
var int trackedSessionEnd = na
var int lastSessionBarClose = na

var Swing swingHigh = Swing.new()
var Swing swingLow = Swing.new()
var FibLeg leg = FibLeg.new()
var Scenario scenario = na
var Scenario lastSignal = na
var int bias = 0
var int lastSignalBar = na
var int lastCandidateLeg = na
var int lastFlip = na
var int totalConfirmed = 0
var int targetCount = 0
var int invalidCount = 0
var int ambiguousCount = 0
var int expiredCount = 0
var int firstObserved = na
var string blockReason = ""
var string lastEvent = "—"
var int lastEventBar = na
var float longWeight = 0
var float shortWeight = 0
var float longScore = 0
var float shortScore = 0
var float candleAtr = na
bool confirmedBuy = false
bool confirmedSell = false
bool sweepHigh = false
bool sweepLow = false
float sweepHighPrice = na
float sweepLowPrice = na
string breakKind = ""
int breakDirection = 0
bool structureConflict = false
array.clear(events)
array.clear(eventTexts)

if barstate.isconfirmed
    bool newSession = inSession and (not inSession[1] or na(previousSessionStart) or sessionStartTime != previousSessionStart)
    if newSession
        if not na(currentSessionH)
            bool complete = sessionCompleteStart and lastSessionBarClose == trackedSessionEnd
            previousSessionH := complete ? currentSessionH : na
            previousSessionL := complete ? currentSessionL : na
        currentSessionH := high
        currentSessionL := low
        sessionCompleteStart := time == sessionStartTime and sessionBarAligned
        trackedSessionEnd := sessionEndTime
    else if inSession
        currentSessionH := na(currentSessionH) ? high : math.max(currentSessionH, high)
        currentSessionL := na(currentSessionL) ? low : math.min(currentSessionL, low)
    if inSession
        sessionCompleteStart := sessionCompleteStart and sessionBarAligned
        lastSessionBarClose := time_close
        previousSessionStart := sessionStartTime
    if not inSession and inSession[1]
        bool complete = sessionCompleteStart and lastSessionBarClose == trackedSessionEnd
        previousSessionH := complete ? currentSessionH : na
        previousSessionL := complete ? currentSessionL : na
    candleAtr := not na(atr[1]) and atr[1] > 0 ? (high - low) / atr[1] : na

    float oldHigh = swingHigh.price
    float oldLow = swingLow.price
    float pivotAtr = atr[swingLen]
    bool newHigh = not na(pivotHigh) and acceptSwing(atrFilter, pivotHigh, oldLow, nz(pivotAtr, atr) * atrMult, 1)
    bool newLow = not na(pivotLow) and acceptSwing(atrFilter, pivotLow, oldHigh, nz(pivotAtr, atr) * atrMult, -1)
    if newHigh
        swingHigh := Swing.new(pivotHigh, bar_index - swingLen, time[swingLen])
        if ready
            addZone(1, pivotHigh, swingHigh.idx, swingHigh.stamp, math.max(syminfo.mintick, nz(pivotAtr, atr) * eqAtr))
            if viewMode == "Review" and showSwings and not na(oldHigh)
                string txt = math.abs(pivotHigh - oldHigh) <= syminfo.mintick / 2 ? "EQ" : pivotHigh > oldHigh ? "HH" : "LH"
                mark(swingHigh.stamp, pivotHigh, txt, 1, pivotHigh > oldHigh ? bullColor : bearColor, "Confirmed after " + str.tostring(swingLen) + " bars")
    if newLow
        swingLow := Swing.new(pivotLow, bar_index - swingLen, time[swingLen])
        if ready
            addZone(-1, pivotLow, swingLow.idx, swingLow.stamp, math.max(syminfo.mintick, nz(pivotAtr, atr) * eqAtr))
            if viewMode == "Review" and showSwings and not na(oldLow)
                string txt = math.abs(pivotLow - oldLow) <= syminfo.mintick / 2 ? "EQ" : pivotLow > oldLow ? "HL" : "LL"
                mark(swingLow.stamp, pivotLow, txt, -1, pivotLow > oldLow ? bullColor : bearColor, "Confirmed after " + str.tostring(swingLen) + " bars")

    if ready and array.size(liquidity) > 0
        for z in liquidity
            if z.state == 0
                int nextState = zoneState(z.side, z.lo, z.hi, open, high, low, close)
                if liqExpiry > 0 and bar_index - z.born > liqExpiry
                    z.state := 4
                else if nextState != 0
                    z.state := nextState
                    if viewMode == "Review" and showLiquidity and (showSingles or z.kind == "EQH" or z.kind == "EQL")
                        segment(z.startTime, z.side == 1 ? z.hi : z.lo, color.new(liqColor, 50))
                    if nextState == 1
                        sweepHigh := sweepHigh or z.side == 1
                        sweepLow := sweepLow or z.side == -1
                        if z.side == 1
                            sweepHighPrice := na(sweepHighPrice) ? z.hi : math.max(sweepHighPrice, z.hi)
                        else
                            sweepLowPrice := na(sweepLowPrice) ? z.lo : math.min(sweepLowPrice, z.lo)
                        if alertLiquidity
                            emitEvent(z.side == 1 ? "sweep_high" : "sweep_low", -z.side, z.id, z.side == 1 ? z.hi : z.lo, na)
    if sweepHigh or sweepLow
        lastEvent := sweepHigh and sweepLow ? "SWEEP BOTH" : sweepHigh ? "SWEEP HIGH" : "SWEEP LOW"
        lastEventBar := bar_index
    if showSweeps and sweepHigh
        mark(time, high, "✗", 1, sweepColor, "Sweep high · " + px(sweepHighPrice))
    if showSweeps and sweepLow
        mark(time, low, "✗", -1, sweepColor, "Sweep low · " + px(sweepLowPrice))

    bool upBreak = ready and not na(swingHigh.price) and not swingHigh.broken and close > swingHigh.price + atr * breakBuffer
    bool downBreak = ready and not na(swingLow.price) and not swingLow.broken and close < swingLow.price - atr * breakBuffer
    structureConflict := upBreak and downBreak
    if structureConflict
        blockReason := "Crossed structure range"
    else if upBreak or downBreak
        breakDirection := upBreak ? 1 : -1
        breakKind := bias == 0 ? "initial" : bias == breakDirection ? "bos" : "choch"
        if breakKind == "choch"
            lastFlip := bar_index
        bias := breakDirection
        Swing anchor = upBreak ? swingLow : swingHigh
        Swing broken = upBreak ? swingHigh : swingLow
        broken.broken := true
        float legHigh = upBreak ? high : anchor.price
        float legLow = upBreak ? anchor.price : low
        bool anchorsOk = not na(anchor.idx) and anchor.idx < bar_index and legHigh - legLow >= syminfo.mintick
        leg := FibLeg.new(id=time, direction=breakDirection, hi=legHigh, lo=legLow, startTime=anchor.stamp, endTime=time, endIdx=bar_index, born=bar_index, origin=breakKind, live=anchorMode != "Break candle", valid=anchorsOk, hiIdx=upBreak ? bar_index : anchor.idx, loIdx=upBreak ? anchor.idx : bar_index, hiTime=upBreak ? time : anchor.stamp, loTime=upBreak ? anchor.stamp : time)
        lastEvent := str.upper(breakKind) + (upBreak ? " ↑" : " ↓")
        lastEventBar := bar_index
        if showStructure and viewMode == "Review"
            segment(broken.stamp, broken.price, upBreak ? bullColor : bearColor, true)
            mark(int(math.avg(broken.stamp, time)), broken.price, breakKind == "choch" ? "CHoCH" : str.upper(breakKind), upBreak ? 1 : -1, upBreak ? bullColor : bearColor, "Close-confirmed structure")
        if alertStructure
            emitEvent(breakKind, breakDirection, time, broken.price, na)

    if anchorMode == "Adaptive (original)" and leg.direction != 0
        float priorHi = leg.hi
        float priorLo = leg.lo
        bool priorValid = leg.valid
        if breakDirection == 0 and leg.live
            if leg.direction == 1 and high > leg.hi
                leg.hi := high
                leg.hiIdx := bar_index
                leg.hiTime := time
            if leg.direction == -1 and low < leg.lo
                leg.lo := low
                leg.loIdx := bar_index
                leg.loTime := time
        if newHigh and leg.live and leg.direction == 1
            leg.hi := swingHigh.price
            leg.hiIdx := swingHigh.idx
            leg.hiTime := swingHigh.stamp
            leg.live := false
        if newLow and leg.live and leg.direction == -1
            leg.lo := swingLow.price
            leg.loIdx := swingLow.idx
            leg.loTime := swingLow.stamp
            leg.live := false
        if newHigh and not (leg.live and leg.direction == 1) and not na(leg.hi) and swingHigh.price != leg.hi
            leg.hi := swingHigh.price
            leg.hiIdx := swingHigh.idx
            leg.hiTime := swingHigh.stamp
        if newLow and not (leg.live and leg.direction == -1) and not na(leg.lo) and swingLow.price != leg.lo
            leg.lo := swingLow.price
            leg.loIdx := swingLow.idx
            leg.loTime := swingLow.stamp
        leg.startTime := leg.direction == 1 ? leg.loTime : leg.hiTime
        leg.endTime := leg.direction == 1 ? leg.hiTime : leg.loTime
        leg.endIdx := leg.direction == 1 ? leg.hiIdx : leg.loIdx
        leg.valid := not na(leg.hi) and not na(leg.lo) and leg.hi > leg.lo
        if leg.hi != priorHi or leg.lo != priorLo or leg.valid != priorValid
            leg.id := time
            leg.born := bar_index
    else if leg.valid
        if leg.direction == 1 ? close < leg.lo : close > leg.hi
            leg.valid := false
        else if leg.live
            if leg.direction == 1 and high >= leg.hi
                leg.hi := high
                leg.endIdx := bar_index
                leg.endTime := time
            if leg.direction == -1 and low <= leg.lo
                leg.lo := low
                leg.endIdx := bar_index
                leg.endTime := time
            bool lockHigh = leg.direction == 1 and newHigh and swingHigh.idx == leg.endIdx and swingHigh.price == leg.hi
            bool lockLow = leg.direction == -1 and newLow and swingLow.idx == leg.endIdx and swingLow.price == leg.lo
            if lockHigh or lockLow
                leg.live := false

    if not na(scenario) and scenario.state <= 3
        int resolved = 0
        if scenario.state == 3 and bar_index > scenario.signalBar
            resolved := outcome(scenario.direction, scenario.stop, scenario.target, high, low)
        else if scenario.state < 3 and (scenario.direction == 1 ? close < scenario.invalid : close > scenario.invalid)
            resolved := 4
        int ageBase = scenario.state == 3 ? scenario.signalBar : scenario.born
        if resolved == 0 and bar_index - ageBase >= scenarioExpiry
            resolved := 5
        if resolved == 0 and scenario.state < 3 and ((leg.valid and leg.id != scenario.id) or (anchorMode == "Adaptive (original)" and not leg.valid))
            resolved := 8
        if resolved != 0
            bool observed = scenario.state == 3
            scenario.state := resolved
            scenario.reason := stateText(resolved)
            if observed
                targetCount += resolved == 6 ? 1 : 0
                invalidCount += resolved == 4 ? 1 : 0
                ambiguousCount += resolved == 7 ? 1 : 0
                expiredCount += resolved == 5 ? 1 : 0
            array.unshift(history, scenario.copy())
            if array.size(history) > 8
                array.pop(history)
            if alertLifecycle
                emitEvent(resolved == 6 ? "target" : resolved == 7 ? "ambiguous" : resolved == 5 ? "expired" : resolved == 8 ? "replaced" : "invalidated", scenario.direction, scenario.id, close, scenario)

    bool freeSlot = na(scenario) or scenario.state > 3
    if ready and freeSlot and leg.valid and not leg.live and (na(lastCandidateLeg) or lastCandidateLeg != leg.id) and (leg.origin != "initial" or allowInitial)
        float za = fib(leg.hi, leg.lo, zoneRatioA, leg.direction)
        float zb = fib(leg.hi, leg.lo, zoneRatioB, leg.direction)
        scenario := Scenario.new(id=leg.id, direction=leg.direction, born=bar_index, stamp=time, hi=leg.hi, lo=leg.lo, zoneLo=math.min(za, zb), zoneHi=math.max(za, zb), invalid=leg.direction == 1 ? leg.lo : leg.hi, origin=leg.origin)
        lastCandidateLeg := leg.id

    longWeight := 0
    shortWeight := 0
    blockReason := not chart.is_standard ? "Standard candles required" : not ready ? "Warming up / ATR unavailable" : leg.live ? "Waiting for end pivot" : "No active candidate"
    if not na(scenario) and scenario.state < 3 and ready
        int direction = scenario.direction
        float tolerance = math.max(syminfo.mintick, atr * confAtr)
        float weight = fibWeight(scenario.hi, scenario.lo, direction, tolerance)
        scenario.independent := weight
        scenario.referenceAtr := atr
        longWeight := direction == 1 ? weight : 0
        shortWeight := direction == -1 ? weight : 0
        bool touch = low <= scenario.zoneHi and high >= scenario.zoneLo
        float distance = close < scenario.zoneLo ? scenario.zoneLo - close : close > scenario.zoneHi ? close - scenario.zoneHi : 0
        int oldState = scenario.state
        if bar_index > scenario.born
            scenario.touched := scenario.touched or touch
            scenario.state := scenario.touched ? 2 : distance <= atr * nearAtr ? 1 : 0
        float midpoint = math.avg(scenario.hi, scenario.lo)
        bool priceInRange = close >= scenario.lo and close <= scenario.hi
        bool zoneOk = priceInRange and (direction == 1 ? close < midpoint : close > midpoint)
        bool locationOk = locationPass(zonePolicy, zoneOk, weight, minFibWeight)
        bool trendOk = bias == direction and not structureConflict
        bool sweepTrigger = enableSweep and (direction == 1 ? sweepLow : sweepHigh)
        bool engulfTrigger = enableEngulf and (direction == 1 ? bullEngulf : bearEngulf)
        bool retestTrigger = enableRetest and scenario.origin == "choch" and weight >= minFibWeight and (direction == 1 ? close > open : close < open)
        bool anyTrigger = sweepTrigger or engulfTrigger or retestTrigger
        bool conflict = sweepHigh and sweepLow or (direction == 1 ? sweepHigh and bullEngulf : sweepLow and bearEngulf)
        bool cooled = na(lastSignalBar) or bar_index - lastSignalBar >= cooldown
        bool htfOk = not requireHtf or htfValid and htfBias == direction
        float entry = math.round_to_mintick(close)
        float stop = stopModel == "ATR" ? entry - direction * atr * stopAtr : direction == 1 ? math.min(scenario.invalid, low) - atr * stopBuffer : math.max(scenario.invalid, high) + atr * stopBuffer
        stop := direction == 1 ? math.floor(stop / syminfo.mintick) * syminfo.mintick : math.ceil(stop / syminfo.mintick) * syminfo.mintick
        float obstacle = nearestObstacle(direction, entry, useDay and dayValid ? prevDayH : na, useDay and dayValid ? prevDayL : na, useSession ? previousSessionH : na, useSession ? previousSessionL : na)
        float target = targetModel == "ATR" ? entry + direction * atr * targetAtr : targetModel == "Fib -.618" ? fib(scenario.hi, scenario.lo, -0.618, direction) : obstacle
        target := math.round_to_mintick(target)
        bool riskOk = validRisk(direction, entry, stop, target, syminfo.mintick)
        riskOk := riskOk and (entry <= 0 or stop > 0 and target > 0)
        float risk = math.abs(entry - stop)
        float room = risk > 0 and not na(obstacle) ? math.abs(obstacle - entry) / risk : na
        bool roomOk = not requireRoom or not na(room) and room >= minimumRoom
        scenario.entry := entry
        scenario.stop := stop
        scenario.target := target
        scenario.obstacle := obstacle
        scenario.rr := riskOk ? math.abs(target - entry) / risk : na
        scenario.room := room
        if alertApproach and scenario.state != oldState and (scenario.state == 1 or scenario.state == 2)
            emitEvent(scenario.state == 1 ? "approach" : "touch", direction, scenario.id, close, scenario)
        blockReason := bar_index <= scenario.born ? "New zone: wait next bar" : not scenario.touched ? "No zone retest" : not trendOk ? "Structure conflict" : conflict ? "Directional conflict" : not locationOk ? "Location confirmation missing" : not anyTrigger ? "Waiting for sweep / engulf / CHoCH retest" : not cooled ? "Cooldown: " + str.tostring(cooldown - (bar_index - lastSignalBar)) : not htfOk ? "HTF disagrees / unavailable" : not riskOk ? "Invalid risk / target" : not roomOk ? "Insufficient / unknown room" : "Confirmed"
        if bar_index > scenario.born and scenario.touched and trendOk and not conflict and locationOk and anyTrigger and cooled and htfOk and riskOk and roomOk
            scenario.state := 3
            scenario.signalBar := bar_index
            scenario.signalTime := time
            scenario.trigger := (sweepTrigger ? "sweep" : "") + (engulfTrigger ? (sweepTrigger ? "+engulf" : "engulf") : "") + (retestTrigger ? (sweepTrigger or engulfTrigger ? "+choch_retest" : "choch_retest") : "")
            lastSignalBar := bar_index
            lastSignal := scenario
            totalConfirmed += 1
            firstObserved := na(firstObserved) ? time : firstObserved
            confirmedBuy := direction == 1
            confirmedSell := direction == -1
            if alertEntries
                emitEvent(direction == 1 ? "buy" : "sell", direction, scenario.id, entry, scenario)
        scenario.reason := blockReason
    if structureConflict
        blockReason := "Crossed structure range"
    longScore := math.min(100, (longWeight + (bias == 1 ? 1 : 0) + (sweepBonus and sweepLow ? 2 : 0) + (bullEngulf ? 1 : 0)) / 6.5 * 100)
    shortScore := math.min(100, (shortWeight + (bias == -1 ? 1 : 0) + (sweepBonus and sweepHigh ? 2 : 0) + (bearEngulf ? 1 : 0)) / 6.5 * 100)
    if viewMode == "Review" and showEngulf and ready and (bullEngulf or bearEngulf)
        mark(time, bullEngulf ? low : high, bullEngulf ? "▲" : "▼", bullEngulf ? -1 : 1, bullEngulf ? bullColor : bearColor, "Pattern, not a standalone entry")

plotshape(showSignals and confirmedBuy, "BUY", shape.labelup, location.belowbar, bullColor, text="BUY", textcolor=color.white, size=size.small)
plotshape(showSignals and confirmedSell, "SELL", shape.labeldown, location.abovebar, bearColor, text="SELL", textcolor=color.white, size=size.small)
plot(confirmedBuy ? 1 : confirmedSell ? -1 : 0, "FSE signal", display=display.data_window)
plot(bias, "FSE bias", display=display.data_window)
plot(longScore, "Long evidence points", display=display.data_window)
plot(shortScore, "Short evidence points", display=display.data_window)
plot(not na(scenario) ? scenario.state : na, "FSE scenario state", display=display.data_window)

var array<line> gridLines = array.new<line>()
var array<label> gridLabels = array.new<label>()
var array<line> mapLines = array.new<line>()
var array<label> mapLabels = array.new<label>()
var array<line> riskLines = array.new<line>()
var array<label> riskLabels = array.new<label>()
var box gridBox = box.new(na, na, na, na, border_color=color.new(#FFD600, 70), bgcolor=color.new(#FFD600, 88), border_width=0)
var box targetBox = box.new(na, na, na, na, border_width=0)
var box setupBox = box.new(na, na, na, na, border_color=zoneColor, bgcolor=color.new(zoneColor, 92))
var line anchorLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.new(fibColor, 60), style=line.style_dotted)
var array<float> ratios = array.from(0.236, 0.382, 0.5, 0.618, 0.786, -0.5, -0.618)
var table panel = table.new(positionValue, 2, dashboardMode == "Classic" ? 12 : 18, bgcolor=panelBg, frame_color=panelBorder, frame_width=1, border_color=panelBorder, border_width=1)
var table recent = table.new(position.middle_left, 3, 10, bgcolor=panelBg, border_color=panelBorder, border_width=1)
var table watermark = table.new(position.bottom_center, 1, 1, bgcolor=color.new(color.black, 100))
if barstate.isfirst
    for i = 0 to 6
        array.push(gridLines, line.new(na, na, na, na, color=fibColor, style=line.style_dotted))
        array.push(gridLabels, label.new(na, na, "", style=label.style_label_left, color=color.new(fibColor, 100), textcolor=fibColor, size=size.tiny))
    for i = 0 to 5
        array.push(mapLines, line.new(na, na, na, na, color=liqColor, style=line.style_dashed))
        array.push(mapLabels, label.new(na, na, "", style=label.style_label_left, color=color.new(liqColor, 100), textcolor=liqColor, size=size.tiny))
    for i = 0 to 4
        array.push(riskLines, line.new(na, na, na, na, color=zoneColor))
        array.push(riskLabels, label.new(na, na, "", style=label.style_label_left, color=color.new(zoneColor, 100), textcolor=zoneColor, size=size.tiny))
    table.merge_cells(panel, 0, 0, 1, 0)

row(int index, string name, string value, color col) =>
    table.cell(panel, 0, index, name, text_color=textMuted, text_size=textSize, bgcolor=index % 2 == 0 ? panelAlt : panelBg)
    table.cell(panel, 1, index, value, text_color=col, text_size=textSize, bgcolor=index % 2 == 0 ? panelAlt : panelBg)

if barstate.islast
    FibLeg drawLeg = leg.copy()
    if anchorMode == "Adaptive (original)" and not barstate.isconfirmed and drawLeg.live
        if drawLeg.direction == 1 and high > drawLeg.hi
            drawLeg.hi := high
            drawLeg.endTime := time
        if drawLeg.direction == -1 and low < drawLeg.lo
            drawLeg.lo := low
            drawLeg.endTime := time
        drawLeg.valid := not na(drawLeg.hi) and not na(drawLeg.lo) and drawLeg.hi > drawLeg.lo
    int rightEdge = bar_index + extendBars
    array<bool> visible = array.from(show236, show382, show500, show618, show786, showT50, showT618)
    string nearestName = "—"
    float nearestDistance = na
    for i = 0 to 6
        float ratio = array.get(ratios, i)
        float level = drawLeg.valid ? fib(drawLeg.hi, drawLeg.lo, ratio, drawLeg.direction) : na
        line ln = array.get(gridLines, i)
        label lb = array.get(gridLabels, i)
        bool draw = showFib and drawLeg.valid and array.get(visible, i)
        line.set_xy1(ln, bar_index, draw ? level : na)
        line.set_xy2(ln, rightEdge, draw ? level : na)
        label.set_xy(lb, rightEdge, draw ? level : na)
        color targetColor = drawLeg.direction == 1 ? bullColor : bearColor
        color levelColor = i >= 5 ? targetColor : fibColor
        int fade = i == 0 or i == 5 ? 40 : i == 1 or i == 4 ? 30 : i == 2 ? 20 : i == 3 ? 10 : 0
        line.set_color(ln, color.new(levelColor, fade))
        line.set_style(ln, i == 3 ? line.style_solid : i == 2 or i == 6 ? line.style_dashed : line.style_dotted)
        line.set_width(ln, i == 2 or i == 3 or i == 6 ? 2 : 1)
        label.set_textcolor(lb, color.new(levelColor, i == 0 ? 20 : i == 1 or i == 4 ? 10 : i == 5 ? 40 : 0))
        label.set_size(lb, i == 3 or i == 6 ? size.small : size.tiny)
        string levelName = i == 6 ? (drawLeg.direction == 1 ? "Target ↑" : "Target ↓") : i == 5 ? (drawLeg.direction == 1 ? "-0.5 ↑" : "-0.5 ↓") : str.tostring(ratio, "0.000")
        label.set_text(lb, levelName)
        label.set_tooltip(lb, "Fib " + str.tostring(ratio) + ": " + px(level) + (i >= 5 ? " · grid projection, not signal target" : "") + (anchorMode == "Adaptive (original)" ? (drawLeg.live ? " · ADAPT LIVE" : " · ADAPT PIVOT") : drawLeg.live ? " · LIVE" : " · LOCK"))
        if draw and (na(nearestDistance) or math.abs(close - level) < nearestDistance)
            nearestDistance := math.abs(close - level)
            nearestName := str.tostring(ratio, "0.000")
    float gzA = drawLeg.valid ? fib(drawLeg.hi, drawLeg.lo, 0.5, drawLeg.direction) : na
    float gzB = drawLeg.valid ? fib(drawLeg.hi, drawLeg.lo, 0.786, drawLeg.direction) : na
    box.set_lefttop(gridBox, bar_index, showFib ? math.max(gzA, gzB) : na)
    box.set_rightbottom(gridBox, rightEdge, showFib ? math.min(gzA, gzB) : na)
    line.set_xy1(anchorLine, drawLeg.startTime, showFib and drawLeg.valid ? (drawLeg.direction == 1 ? drawLeg.lo : drawLeg.hi) : na)
    line.set_xy2(anchorLine, drawLeg.endTime, showFib and drawLeg.valid ? (drawLeg.direction == 1 ? drawLeg.hi : drawLeg.lo) : na)
    float t50 = drawLeg.valid ? fib(drawLeg.hi, drawLeg.lo, -0.5, drawLeg.direction) : na
    float t618 = drawLeg.valid ? fib(drawLeg.hi, drawLeg.lo, -0.618, drawLeg.direction) : na
    bool drawTarget = showFib and drawLeg.valid and (showT50 or showT618)
    box.set_lefttop(targetBox, bar_index, drawTarget ? math.max(t50, t618) : na)
    box.set_rightbottom(targetBox, rightEdge, drawTarget ? math.min(t50, t618) : na)
    box.set_border_color(targetBox, color.new(drawLeg.direction == 1 ? bullColor : bearColor, 70))
    box.set_bgcolor(targetBox, color.new(drawLeg.direction == 1 ? bullColor : bearColor, 88))
    bool activeScenario = showRisk and not na(scenario) and scenario.state <= 3
    box.set_lefttop(setupBox, bar_index, activeScenario ? scenario.zoneHi : na)
    box.set_rightbottom(setupBox, rightEdge, activeScenario ? scenario.zoneLo : na)
    array<float> riskPrices = array.from(activeScenario ? scenario.entry : na, activeScenario ? scenario.invalid : na, activeScenario ? scenario.stop : na, activeScenario ? scenario.target : na, activeScenario ? scenario.obstacle : na)
    array<string> riskNames = array.from("Model entry", "Structure invalidation", "Stop", "Target", "Obstacle")
    for i = 0 to 4
        float value = array.get(riskPrices, i)
        line ln = array.get(riskLines, i)
        label lb = array.get(riskLabels, i)
        line.set_xy1(ln, bar_index, value)
        line.set_xy2(ln, rightEdge + 5, value)
        label.set_xy(lb, rightEdge + 5, value)
        label.set_text(lb, array.get(riskNames, i) + " " + px(value))
        float delta = activeScenario and not na(value) and not na(scenario.entry) ? math.abs(value - scenario.entry) : na
        string riskTip = array.get(riskNames, i) + " · " + px(value)
        if not na(delta)
            riskTip += "\n" + "From entry: " + px(delta) + " · " + str.tostring(delta / syminfo.mintick, "0") + " ticks" + (scenario.referenceAtr > 0 ? " · " + str.tostring(delta / scenario.referenceAtr, "0.00") + " ATR" : "")
        label.set_tooltip(lb, riskTip)
    array<bool> selected = array.new<bool>(array.size(liquidity), false)
    for slot = 0 to 5
        int side = slot < 3 ? 1 : -1
        int candidate = -1
        float distance = na
        if showLiquidity and slot % 3 < zonesPerSide and array.size(liquidity) > 0
            for i = 0 to array.size(liquidity) - 1
                Liquidity z = array.get(liquidity, i)
                float price = side == 1 ? z.hi : z.lo
                if z.state == 0 and z.side == side and (showSingles or z.kind == "EQH" or z.kind == "EQL") and not array.get(selected, i)
                    float d = math.abs(close - price)
                    if na(distance) or d < distance
                        candidate := i
                        distance := d
        float level = na
        string title = ""
        if candidate >= 0
            Liquidity z = array.get(liquidity, candidate)
            array.set(selected, candidate, true)
            level := side == 1 ? z.hi : z.lo
            title := z.kind
        line ln = array.get(mapLines, slot)
        label lb = array.get(mapLabels, slot)
        line.set_xy1(ln, bar_index, level)
        line.set_xy2(ln, bar_index + eqExtendBars, level)
        label.set_xy(lb, bar_index, level)
        label.set_style(lb, side == 1 ? label.style_label_down : label.style_label_up)
        label.set_text(lb, title)
        label.set_tooltip(lb, "Active price zone; resting order size is unknown")

    table.clear(panel, 0, 0, 1, dashboardMode == "Classic" ? 11 : 17)
    table.merge_cells(panel, 0, 0, 1, 0)
    if showPanel and dashboardMode == "Detailed"
        table.cell(panel, 0, 0, "FSE " + VERSION + " · " + (barstate.isconfirmed ? "Closed" : "Last closed state"), text_color=color.white, text_size=size.small, bgcolor=headerBg, text_halign=text.align_center)
        string htfText = not useHtf ? "OFF" : not htfValid ? "select higher TF" : dirText(htfBias) + (htfBias != 0 and htfBias != bias ? " ≠" : "")
        row(1, "Structure / HTF", dirText(bias) + " / " + htfText, bias == 1 ? bullColor : bias == -1 ? bearColor : textColor)
        row(2, "Scenario", na(scenario) ? "—" : dirText(scenario.direction) + " · " + stateText(scenario.state), zoneColor)
        row(3, "Reason / waiting", not na(scenario) and scenario.state >= 3 ? scenario.reason : blockReason, textColor)
        row(4, "Zone · age", na(scenario) ? "—" : px(scenario.zoneLo) + "–" + px(scenario.zoneHi) + " · " + str.tostring(bar_index - scenario.born) + "b", zoneColor)
        string evidence = "L " + str.tostring(longScore, "0") + " / S " + str.tostring(shortScore, "0") + " · points, not %"
        row(5, "Evidence", evidence, textColor)
        row(6, "Independent Fib", "L " + str.tostring(longWeight, "0.0") + " / S " + str.tostring(shortWeight, "0.0") + " · min " + str.tostring(minFibWeight), fibColor)
        row(7, "Entry / stop / target", na(scenario) ? "—" : px(scenario.entry) + " / " + px(scenario.stop) + " / " + px(scenario.target), textColor)
        row(8, "Room / target R", na(scenario) ? "—" : rrText(scenario.room) + " / " + rrText(scenario.rr), not na(scenario) and not na(scenario.room) and scenario.room < minimumRoom ? bearColor : textColor)
        float mid = drawLeg.valid ? math.avg(drawLeg.hi, drawLeg.lo) : na
        string zoneText = na(mid) ? "—" : close > drawLeg.hi ? "Above range" : close < drawLeg.lo ? "Below range" : close > mid ? "Premium" : close < mid ? "Discount" : "Equilibrium"
        row(9, "Live price / Fib", zoneText + (anchorMode == "Adaptive (original)" ? (drawLeg.live ? " · ADAPT LIVE" : " · ADAPT PIVOT") : drawLeg.live ? " · LIVE" : " · LOCK"), fibColor)
        row(10, "Nearest visible Fib", nearestName + (not na(nearestDistance) and atr > 0 ? " · " + str.tostring(nearestDistance / atr, "0.00") + " ATR" : ""), fibColor)
        string regime = na(lastFlip) ? "Undetermined" : bar_index - lastFlip < swingLen * 2 ? "Transition" : "Directional structure"
        row(11, "Regime / bar range", regime + " · " + str.tostring(candleAtr, "0.0") + " ATR" + (candleAtr >= wideBarAtr ? " !" : ""), candleAtr >= wideBarAtr ? zoneColor : textColor)
        row(12, "Last confirmed signal", na(lastSignal) ? "—" : dirText(lastSignal.direction) + " · " + lastSignal.trigger + " · " + str.tostring(bar_index - lastSignal.signalBar) + "b · " + stateText(lastSignal.state), textColor)
        row(13, "Last event", lastEvent + (not na(lastEventBar) ? " · " + str.tostring(bar_index - lastEventBar) + "b" : ""), textColor)
        row(14, "HTF closed", useHtf and htfValid and not na(htfCloseTime) ? str.format_time(htfCloseTime, "dd.MM HH:mm", syminfo.timezone) : "—", textColor)
        row(15, "Session", not useSession ? "OFF" : not timeframe.isintraday ? "Intraday only" : (na(previousSessionH) ? "No complete session · " : inSession ? "Inside · " : "Outside · ") + sessionTz, textColor)
        row(16, "Observations · not trades", "N=" + str.tostring(totalConfirmed) + " T=" + str.tostring(targetCount) + " X=" + str.tostring(invalidCount) + " ?=" + str.tostring(ambiguousCount) + " E=" + str.tostring(expiredCount), textColor)
        row(17, "Observations since", na(firstObserved) ? "—" : str.format_time(firstObserved, "dd.MM.yyyy", syminfo.timezone), textColor)
    if showPanel and dashboardMode == "Classic"
        table.cell(panel, 0, 0, "FibStruct", text_color=color.white, bgcolor=headerBg, text_size=size.small, text_halign=text.align_center)
        row(1, "Trend", bias > 0 ? "Bullish" : bias < 0 ? "Bearish" : "Neutral", bias > 0 ? bullColor : bias < 0 ? bearColor : textMuted)
        row(2, "Fib Dir", not drawLeg.valid ? "—" : drawLeg.direction > 0 ? "Long ↑" : "Short ↓", not drawLeg.valid ? textMuted : drawLeg.direction > 0 ? bullColor : bearColor)
        row(3, "Signal", confirmedBuy ? "BUY" : confirmedSell ? "SELL" : "—", confirmedBuy ? bullColor : confirmedSell ? bearColor : textMuted)
        float evidenceScore = math.max(longScore, shortScore)
        string evidenceName = evidenceScore >= 60 ? "Strong" : evidenceScore >= 30 ? "Moderate" : evidenceScore > 0 ? "Weak" : "None"
        row(4, "Confluence", evidenceName + " (" + str.tostring(evidenceScore, "#") + ")", evidenceScore >= 60 ? bullColor : evidenceScore >= 30 ? zoneColor : evidenceScore > 0 ? color.new(zoneColor, 50) : textMuted)
        table.cell_set_tooltip(panel, 1, 4, "Evidence points, not probability. L " + str.tostring(longScore, "#") + " / S " + str.tostring(shortScore, "#"))
        bool premium = drawLeg.valid and close >= drawLeg.lo and close <= drawLeg.hi and close > math.avg(drawLeg.hi, drawLeg.lo)
        bool discount = drawLeg.valid and close >= drawLeg.lo and close <= drawLeg.hi and close < math.avg(drawLeg.hi, drawLeg.lo)
        row(5, "Zone", premium ? "Premium" : discount ? "Discount" : "—", premium ? bearColor : discount ? bullColor : textMuted)
        bool eqh = false
        bool eql = false
        for z in liquidity
            eqh := eqh or z.state == 0 and z.kind == "EQH"
            eql := eql or z.state == 0 and z.kind == "EQL"
        row(6, "Liquidity", eqh and eql ? "EQH+EQL" : eqh ? "EQH ↑" : eql ? "EQL ↓" : "—", eqh or eql ? liqColor : textMuted)
        row(7, "Fib .618", drawLeg.valid ? px(fib(drawLeg.hi, drawLeg.lo, 0.618, drawLeg.direction)) : "—", fibColor)
        row(8, "ATR(14)", px(atr), textColor)
        float distAtr = atr > 0 ? nearestDistance / atr : na
        row(9, "Near Fib", na(distAtr) ? "—" : nearestName + " (" + str.tostring(distAtr, "0.00") + " ATR)", na(distAtr) ? textMuted : distAtr <= confAtr ? zoneColor : fibColor)
        row(10, "TF", timeframe.period, textColor)
        row(11, "Version", "v" + VERSION, textMuted)
    table.clear(recent, 0, 0, 2, 9)
    if showHistory
        table.cell(recent, 0, 0, "Scenario", text_color=textColor)
        table.cell(recent, 1, 0, "Trigger", text_color=textColor)
        table.cell(recent, 2, 0, "Observation outcome", text_color=textColor)
        if array.size(history) > 0
            for i = 0 to array.size(history) - 1
                Scenario s = array.get(history, i)
                table.cell(recent, 0, i + 1, dirText(s.direction) + " " + str.format_time(s.stamp, "dd.MM HH:mm", syminfo.timezone), text_color=textColor, text_size=size.tiny)
                table.cell(recent, 1, i + 1, s.trigger == "" ? "No signal" : s.trigger, text_color=textColor, text_size=size.tiny)
                table.cell(recent, 2, i + 1, stateText(s.state), text_color=textColor, text_size=size.tiny)
    table.cell(watermark, 0, 0, showWatermark ? "WillyAlgoTrader" : "", text_color=watermarkColor, text_size=size.normal, text_halign=text.align_center, bgcolor=color.new(color.black, 100))

plot(showDay and dayValid ? prevDayH : na, "Previous day high", color.new(bearColor, 50), style=plot.style_linebr)
plot(showDay and dayValid ? prevDayL : na, "Previous day low", color.new(bullColor, 50), style=plot.style_linebr)
plot(showSession and timeframe.isintraday ? previousSessionH : na, "Previous session high", color.new(liqColor, 40), style=plot.style_linebr)
plot(showSession and timeframe.isintraday ? previousSessionL : na, "Previous session low", color.new(liqColor, 40), style=plot.style_linebr)

if barstate.isconfirmed and array.size(events) > 0
    string payload = '{"schema_version":2,"indicator_version":"' + VERSION + '","ticker":"' + escapeJson(syminfo.tickerid) + '","tf":"' + timeframe.period + '","bar_time":' + str.tostring(time) + ',"bar_close_time":' + (na(time_close) ? "null" : str.tostring(time_close)) + ',"price":' + jnum(close) + ',"events":[' + array.join(events, ",") + ']}'
    string message = jsonAlerts ? payload : "FSE " + VERSION + " | " + syminfo.tickerid + " | " + timeframe.period + " | " + str.format_time(time, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\n" + array.join(eventTexts, "\n")
    alert(message, alert.freq_once_per_bar_close)
