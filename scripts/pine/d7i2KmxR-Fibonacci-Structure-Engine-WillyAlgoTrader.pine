string stopModel = input.string("Structure", "Stop model", options=["Structure", "ATR"], group=G_RISK)
float stopAtr = input.float(1.5, "ATR stop multiplier", 0.1, 10, 0.1, group=G_RISK)
float stopBuffer = input.float(0.1, "Structural stop buffer, ATR", 0, 2, 0.05, group=G_RISK)
