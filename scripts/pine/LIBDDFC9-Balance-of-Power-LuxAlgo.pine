//@version=6
indicator("Balance of Power", "BOP", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // buyers in control - BOP above zero
BEAR_COLOR    = #f23645 // sellers in control - BOP below zero
NEUTRAL_COLOR = #787b86 // zero line, and a reading exactly at zero
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
smoothInput       = input.bool(false, "Smoothing", inline = "smooth", group = "Settings", tooltip = "Smooth the raw Balance of Power with a simple moving average instead of plotting the single-bar value")
smoothLengthInput = input.int(14, "Length", minval = 1, inline = "smooth", group = "Settings", tooltip = "Simple moving average length applied when smoothing is enabled")

bopColorInput  = input.color(NEUTRAL_COLOR, "BOP Color", group = "Style", tooltip = "Color of the Balance of Power line at exactly zero. Above zero the line takes the bullish color, below zero the bearish color")
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "sides", group = "Style", tooltip = "Line and fill color while the Balance of Power is above zero - buyers in control of the bar")
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "sides", group = "Style", tooltip = "Line and fill color while the Balance of Power is below zero - sellers in control of the bar")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
hlRange = high - low
rawBop  = hlRange == 0 ? 0. : (close - open) / hlRange
smaBop  = ta.sma(rawBop, smoothLengthInput)

bop = smoothInput ? smaBop : rawBop
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - above zero buyers won the bar, below zero sellers did
bopColor = bop > 0 ? bullColorInput : bop < 0 ? bearColorInput : bopColorInput

bopPlotId  = plot(bop, "BOP", bopColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

fill(bopPlotId, zeroPlotId, top_value = bop, bottom_value = 0, top_color = color.new(bopColor, bop >= 0 ? 60 : 100), bottom_color = color.new(bopColor, bop >= 0 ? 100 : 60), title = "BOP Gradient")

hline(0, "Zero Line", NEUTRAL_COLOR, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(ta.crossover(bop, 0), "Zero Cross Up", "Balance of Power crossed above zero")
alertcondition(ta.crossunder(bop, 0), "Zero Cross Down", "Balance of Power crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
