//@version=6
indicator("TRIX", "TRIX", overlay = false, precision = 4)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(18, "Length", minval = 1, group = "Settings", tooltip = "Length of each of the three EMA smoothing passes applied to the close price")
signalLengthInput = input.int(9, "Signal Length", minval = 1, group = "Settings", tooltip = "Length of the EMA applied to TRIX to form the signal line")

trixColorInput = input.color(#787b86, "TRIX Color", group = "Style", tooltip = "Color of the TRIX line")
signalColorInput = input.color(#ff9800, "Signal Color", group = "Style", tooltip = "Color of the signal line")
bullColorInput = input.color(#089981, "Bullish", inline = "state", group = "Style", tooltip = "Color of the TRIX line and its gradient fill while TRIX holds above zero")
bearColorInput = input.color(#f23645, "Bearish", inline = "state", group = "Style", tooltip = "Color of the TRIX line and its gradient fill while TRIX holds below zero")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
ema1 = ta.ema(close, lengthInput)
ema2 = ta.ema(ema1, lengthInput)
ema3 = ta.ema(ema2, lengthInput)

trix = ta.roc(ema3, 1)
signalLine = ta.ema(trix, signalLengthInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish above zero, bearish below, the neutral color exactly on zero
trixColor = trix > 0 ? bullColorInput : trix < 0 ? bearColorInput : trixColorInput

trixPlotId = plot(trix, "TRIX", trixColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)
plot(signalLine, "Signal", signalColorInput)

// Centered gradient - fully transparent at zero, stronger toward the reading
fill(trixPlotId, zeroPlotId, math.max(trix, 0), math.min(trix, 0), trix > 0 ? color.new(trixColor, 50) : color.new(trixColor, 100), trix > 0 ? color.new(trixColor, 100) : color.new(trixColor, 50), title = "TRIX Gradient")

hline(0, "Zero Line", #787b86, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
zeroCrossUp = ta.crossover(trix, 0)
zeroCrossDown = ta.crossunder(trix, 0)
signalCrossUp = ta.crossover(trix, signalLine)
signalCrossDown = ta.crossunder(trix, signalLine)

alertcondition(zeroCrossUp, "Bullish Zero Cross", "TRIX crossed above zero")
alertcondition(zeroCrossDown, "Bearish Zero Cross", "TRIX crossed below zero")
alertcondition(signalCrossUp, "Bullish Signal Cross", "TRIX crossed above its signal line")
alertcondition(signalCrossDown, "Bearish Signal Cross", "TRIX crossed below its signal line")
//----------------------------------------------------------------------------------------------------------------------}
