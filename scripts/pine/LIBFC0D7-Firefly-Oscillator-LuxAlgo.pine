//@version=6
indicator("Firefly Oscillator"
  , shorttitle       = "Firefly Oscillator"
  , overlay          = false
  , format           = format.price
  , precision        = 2
  , max_lines_count  = 500
  , max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

float MID_LEVEL   = 50.0
int   FULL_TRANSP = 100
int   HALF_TRANSP = 50
int   GLOW_TRANSP = 55

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

lengthInput = input.int(10, "Basis Length"
  , minval  = 2
  , group   = "Oscillator"
  , tooltip = "Lookback (m) used for both the EMA basis and the standard deviation of the weighted price when computing the z-score.")

smoothInput = input.int(3, "Smoothing Length"
  , minval  = 1
  , group   = "Oscillator"
  , tooltip = "EMA length (w) of the zero-lag style double smoothing pass applied to the z-score.")

obInput = input.float(80, "Overbought"
  , minval  = 50
  , maxval  = 150
  , group   = "Levels"
  , tooltip = "Level marking statistically stretched readings to the upside. Extreme bars can push the oscillator slightly above 100.")

osInput = input.float(20, "Oversold"
  , minval  = -50
  , maxval  = 50
  , group   = "Levels"
  , tooltip = "Level marking statistically stretched readings to the downside. Extreme bars can push the oscillator slightly below 0.")

showDivInput = input.bool(false, "Show Divergences"
  , group   = "Divergences"
  , tooltip = "Detect and draw regular bullish/bearish divergences between oscillator swing points and price extremes.")

divPivotInput = input.int(5, "Pivot Lookback"
  , minval  = 1
  , maxval  = 50
  , group   = "Divergences"
  , tooltip = "Number of bars required on each side to confirm an oscillator swing high/low used for divergence detection.")

divMaxInput = input.int(60, "Max Pivot Distance"
  , minval  = 5
  , maxval  = 200
  , group   = "Divergences"
  , tooltip = "Maximum number of bars allowed between two consecutive oscillator swing points for them to form a divergence.")

glowInput = input.bool(true, "Glow Effect"
  , group   = "Style"
  , tooltip = "Adds a glow around the oscillator line that intensifies as readings flare toward the extremes.")

bullColorInput = input.color(#089981, "Bullish Color", group = "Style")

bearColorInput = input.color(#f23645, "Bearish Color", group = "Style")

levelsColorInput = input.color(#787b86, "Levels Color", group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{

// Weighted price giving the close double weight
float weightedPrice = (high + low + 2 * close) / 4

// Basis and deviation of the weighted price over the same lookback
float basis = ta.ema(weightedPrice, lengthInput)
float dev   = ta.stdev(weightedPrice, lengthInput)

// Deviation of the weighted price from its basis, scaled by 100, guarded against a flat window
float zScore = dev > 0 ? 100 * (weightedPrice - basis) / dev : 0

// Zero-lag style double smoothing pass
float zEma     = ta.ema(zScore, smoothInput)
float zeroLagZ = 2 * zEma - ta.ema(zEma, smoothInput)

// Final reading rescaled so 50 is neutral, roughly 0 to 100
float firefly = (zeroLagZ + 100) / 2

// Midline and overbought/oversold events
bool bullMidCross    = ta.crossover(firefly, MID_LEVEL)
bool bearMidCross    = ta.crossunder(firefly, MID_LEVEL)
bool overboughtEntry = ta.crossover(firefly, obInput)
bool overboughtFade  = ta.crossunder(firefly, obInput)
bool oversoldEntry   = ta.crossunder(firefly, osInput)
bool oversoldFade    = ta.crossover(firefly, osInput)

//---------------------------------------------------------------------------------------------------------------------}
// Divergences
//---------------------------------------------------------------------------------------------------------------------{

float pivotHighOsc = ta.pivothigh(firefly, divPivotInput, divPivotInput)
float pivotLowOsc  = ta.pivotlow(firefly, divPivotInput, divPivotInput)

var float prevPhOsc   = na
var int   prevPhBar   = na
var float prevPhPrice = na
var float prevPlOsc   = na
var int   prevPlBar   = na
var float prevPlPrice = na

bool bearishDivergence = false
bool bullishDivergence = false

if not na(pivotHighOsc)
    int   pivotBar   = bar_index - divPivotInput
    float pivotPrice = high[divPivotInput]

    if not na(prevPhOsc) and pivotBar - prevPhBar <= divMaxInput
        bearishDivergence := pivotPrice > prevPhPrice and pivotHighOsc < prevPhOsc

    if bearishDivergence and showDivInput
        line.new(prevPhBar, prevPhOsc, pivotBar, pivotHighOsc, color = bearColorInput)
        label.new(pivotBar, pivotHighOsc, "Bearish"
          , style     = label.style_label_down
          , color     = #00000000
          , textcolor = bearColorInput
          , size      = size.tiny)

    prevPhOsc   := pivotHighOsc
    prevPhBar   := pivotBar
    prevPhPrice := pivotPrice

if not na(pivotLowOsc)
    int   pivotBar   = bar_index - divPivotInput
    float pivotPrice = low[divPivotInput]

    if not na(prevPlOsc) and pivotBar - prevPlBar <= divMaxInput
        bullishDivergence := pivotPrice < prevPlPrice and pivotLowOsc > prevPlOsc

    if bullishDivergence and showDivInput
        line.new(prevPlBar, prevPlOsc, pivotBar, pivotLowOsc, color = bullColorInput)
        label.new(pivotBar, pivotLowOsc, "Bullish"
          , style     = label.style_label_up
          , color     = #00000000
          , textcolor = bullColorInput
          , size      = size.tiny)

    prevPlOsc   := pivotLowOsc
    prevPlBar   := pivotBar
    prevPlPrice := pivotPrice

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

color oscColor = firefly > MID_LEVEL ? bullColorInput : bearColorInput

// Glow flaring with the distance from the midline
color glowColor = glowInput
  ? color.from_gradient(math.abs(firefly - MID_LEVEL), 0, MID_LEVEL, color.new(oscColor, FULL_TRANSP), color.new(oscColor, GLOW_TRANSP))
  : color(na)

plot(firefly, "Glow", glowColor, 4)

oscPlotId = plot(firefly, "Firefly", oscColor, 1)
midPlotId = plot(MID_LEVEL, "Midline Anchor", editable = false, display = display.none)

fill(oscPlotId, midPlotId
  , top_value    = math.max(firefly, MID_LEVEL)
  , bottom_value = math.min(firefly, MID_LEVEL)
  , top_color    = firefly > MID_LEVEL ? color.new(bullColorInput, HALF_TRANSP) : color.new(bearColorInput, FULL_TRANSP)
  , bottom_color = firefly > MID_LEVEL ? color.new(bullColorInput, FULL_TRANSP) : color.new(bearColorInput, HALF_TRANSP)
  , title        = "Gradient Fill")

hline(obInput, "Overbought Level", levelsColorInput, hline.style_dashed)
hline(MID_LEVEL, "Midline", levelsColorInput, hline.style_dotted)
hline(osInput, "Oversold Level", levelsColorInput, hline.style_dashed)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bullMidCross, "Bullish Midline Cross", "Firefly oscillator crossed above its 50 midline")
alertcondition(bearMidCross, "Bearish Midline Cross", "Firefly oscillator crossed below its 50 midline")
alertcondition(overboughtEntry, "Overbought", "Firefly oscillator entered its overbought zone")
alertcondition(overboughtFade, "Overbought Fade", "Firefly oscillator crossed back below its overbought level")
alertcondition(oversoldEntry, "Oversold", "Firefly oscillator entered its oversold zone")
alertcondition(oversoldFade, "Oversold Fade", "Firefly oscillator crossed back above its oversold level")
alertcondition(bullishDivergence, "Bullish Divergence", "Firefly oscillator regular bullish divergence detected")
alertcondition(bearishDivergence, "Bearish Divergence", "Firefly oscillator regular bearish divergence detected")

//---------------------------------------------------------------------------------------------------------------------}
