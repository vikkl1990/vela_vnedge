//@version=6
indicator("BandWidth", shorttitle = "BandWidth", overlay = false, format = format.price, precision = 4)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR     = #787b86 // non-directional volatility metric color - structure
SQUEEZE_COLOR     = #ff9800 // the one accent - compressed volatility, the condition to watch
BULGE_COLOR       = #f23645 // extreme width unlikely to be sustained - the caution side
FILL_VALUE_TRANSP = 50      // gradient transparency at the BandWidth value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput      = input.int(20, "Length", minval = 2, group = "Settings",
     tooltip = "Number of bars used for the Bollinger Bands basis (a simple moving average) and for the standard deviation. John Bollinger's default is 20.")

srcInput         = input.source(close, "Source", group = "Settings",
     tooltip = "Price series the bands are computed from.")

multInput        = input.float(2.0, "Multiplier", minval = 0.001, step = 0.25, group = "Settings",
     tooltip = "Standard deviation multiplier for the upper and lower bands. With the default of 2 the distance between the bands spans four standard deviations of price.")

lookbackInput    = input.int(125, "Reference Lookback", minval = 2, group = "Squeeze & Bulge",
     tooltip = "Window used to locate the lowest (Squeeze) and highest (Bulge) BandWidth references. Bollinger's Squeeze definition looks for the lowest BandWidth in roughly 125 sessions of daily data, about six months.")

showSqueezeInput = input.bool(true, "Show Squeeze Level", group = "Squeeze & Bulge",
     tooltip = "Plots the lowest BandWidth of the reference lookback. BandWidth falling to this level marks unusually compressed volatility - a condition, not a directional signal - that often precedes the birth of a directional move.")

showBulgeInput   = input.bool(true, "Show Bulge Level", group = "Squeeze & Bulge",
     tooltip = "Plots the highest BandWidth of the reference lookback. BandWidth reaching this level marks extreme width that is unlikely to be sustained, frequently appearing near trend endings.")

showMarkersInput = input.bool(false, "Extreme Markers", group = "Squeeze & Bulge",
     tooltip = "Displays a small circle on the metric when BandWidth tags its Squeeze or Bulge reference. Off by default to keep the pane clean - the Squeeze and Bulge alerts work regardless.")

bwColorInput     = input.color(NEUTRAL_COLOR, "BandWidth", group = "Style",
     tooltip = "Color of the BandWidth line and of its gradient fill. While BandWidth sits at its Squeeze reference the line and fill take the Squeeze color, at its Bulge reference the Bulge color.")

gradientInput    = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between zero and BandWidth with a vertical gradient, fully transparent at zero and strongest at the current value.")

squeezeColorInput = input.color(SQUEEZE_COLOR, "Squeeze Level", group = "Style",
     tooltip = "Color of the lowest-BandWidth reference line and of its optional markers.")

bulgeColorInput   = input.color(BULGE_COLOR, "Bulge Level", group = "Style",
     tooltip = "Color of the highest-BandWidth reference line and of its optional markers.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Bollinger Bands - 20-period SMA basis with bands a multiple of the standard deviation away
basis = ta.sma(srcInput, lengthInput)
dev   = multInput * ta.stdev(srcInput, lengthInput)

upperBand = basis + dev
lowerBand = basis - dev

// BandWidth - upper band minus lower band, divided by the middle band.
// Dividing by the middle band normalizes the span, making readings comparable across instruments and price levels
bandwidth = basis != 0 ? (upperBand - lowerBand) / basis : na

// Squeeze / Bulge references - the lowest and highest BandWidth of the reference lookback
squeezeLevel = ta.lowest(bandwidth, lookbackInput)
bulgeLevel   = ta.highest(bandwidth, lookbackInput)

squeezeTouch = not na(bandwidth) and bandwidth <= squeezeLevel
bulgeTouch   = not na(bandwidth) and bandwidth >= bulgeLevel

// Events - entering an extreme, and width turning up off its lookback low
newSqueeze = squeezeTouch and not squeezeTouch[1]
newBulge   = bulgeTouch and not bulgeTouch[1]
expansion  = squeezeTouch[1] and bandwidth > bandwidth[1]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// State coloring - the metric takes the Squeeze color at its lookback low and the Bulge color at its lookback high
bwColor = squeezeTouch ? squeezeColorInput : bulgeTouch ? bulgeColorInput : bwColorInput

bwPlotId   = plot(bandwidth, "BandWidth", color = bwColor, linewidth = 1)
zeroPlotId = plot(0, "Zero Line", color = color.new(NEUTRAL_COLOR, 90), linewidth = 1)

fill(bwPlotId, zeroPlotId, top_value = bandwidth, bottom_value = 0, top_color = gradientInput ? color.new(bwColor, FILL_VALUE_TRANSP) : na, bottom_color = gradientInput ? color.new(bwColor, FILL_ZERO_TRANSP) : na, title = "BandWidth Gradient Fill")

plot(showSqueezeInput ? squeezeLevel : na, "Squeeze Level", color = squeezeColorInput, linewidth = 1)
plot(showBulgeInput ? bulgeLevel : na, "Bulge Level", color = bulgeColorInput, linewidth = 1)

plot(showMarkersInput and squeezeTouch ? bandwidth : na, "Squeeze Marker", color = squeezeColorInput, linewidth = 2, style = plot.style_circles)
plot(showMarkersInput and bulgeTouch ? bandwidth : na, "Bulge Marker", color = bulgeColorInput, linewidth = 2, style = plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(newSqueeze, "Squeeze - Lookback Low", "BandWidth fell to its lowest level of the reference lookback on {{ticker}} - volatility unusually compressed ({{interval}})")
alertcondition(newBulge, "Bulge - Lookback High", "BandWidth rose to its highest level of the reference lookback on {{ticker}} - extreme width unlikely to be sustained ({{interval}})")
alertcondition(expansion, "Expansion From Squeeze Low", "BandWidth is turning up from its lookback low on {{ticker}} - bands expanding ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
