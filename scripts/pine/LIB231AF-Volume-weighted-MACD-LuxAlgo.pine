//@version=6
indicator("Volume-weighted MACD", shorttitle = "Volume-weighted MACD", overlay = false, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // signal line color
CLASSIC_COLOR     = #787b86 // price-only MACD reference color
FILL_VALUE_TRANSP = 50      // gradient transparency at the VW-MACD value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line
HIST_GROW_TRANSP  = 40      // histogram transparency while momentum expands
HIST_FADE_TRANSP  = 70      // histogram transparency once momentum contracts

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput          = input.source(close, "Source", group = "Settings",
     tooltip = "Price series fed into the volume-weighted moving averages. Each bar's value is multiplied by its volume before averaging, so heavily traded bars pull the lines hard while quiet drift barely moves them.")

fastLengthInput   = input.int(12, "Fast VWMA Length", minval = 1, group = "Settings",
     tooltip = "Length of the fast volume-weighted moving average. Implementations commonly keep MACD's familiar fast length of 12.")

slowLengthInput   = input.int(26, "Slow VWMA Length", minval = 1, group = "Settings",
     tooltip = "Length of the slow volume-weighted moving average. The VW-MACD line is the fast VWMA minus the slow VWMA, expressed in price units. Implementations commonly keep MACD's familiar slow length of 26.")

signalLengthInput = input.int(9, "Signal Smoothing", minval = 1, inline = "signal", group = "Settings",
     tooltip = "Length of the signal line that smooths the VW-MACD line. A 9-period EMA is the most common choice.")

signalTypeInput   = input.string("EMA", "", options = ["EMA", "SMA"], inline = "signal", group = "Settings",
     tooltip = "Moving average type used for the signal line.")

showClassicInput  = input.bool(true, "Classic MACD Comparison", group = "Settings",
     tooltip = "Overlays the price-only MACD line (EMA-based, same source and lengths). The volume-weighted line running stronger argues volume backs the trend, while a weaker line flags participation failing to keep pace with price.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Color of the VW-MACD line, gradient fill and histogram above the zero line.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Color of the VW-MACD line, gradient fill and histogram below the zero line.")

signalColorInput  = input.color(SIGNAL_COLOR, "Signal Line", group = "Style",
     tooltip = "Color of the signal line.")

classicColorInput = input.color(CLASSIC_COLOR, "Classic MACD", group = "Style",
     tooltip = "Color of the optional price-only MACD comparison line.")

showHistInput     = input.bool(true, "Show Histogram", group = "Style",
     tooltip = "Displays the histogram (VW-MACD minus signal line) as columns. Bright columns mark expanding momentum, faded columns mark a histogram already contracting back toward its signal line.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the zero line and the VW-MACD line with a vertical gradient, fully transparent at zero and strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Volume-weighted moving average per the concept definition: each bar's source value is multiplied by its volume and
// the sum is divided by the window's total volume. Guarded against zero/na volume - when the window reports no volume
// at all, every bar carries an equal weight, so the average falls back to a simple mean instead of dividing by zero
volumeWeightedAverage(src, length) =>
    vol         = nz(volume)
    weightedSum = math.sum(src * vol, length)
    totalVolume = math.sum(vol, length)
    totalVolume > 0 ? weightedSum / totalVolume : math.sum(src, length) / length

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
fastVwma = volumeWeightedAverage(srcInput, fastLengthInput)
slowVwma = volumeWeightedAverage(srcInput, slowLengthInput)

// VW-MACD line - fast VWMA minus slow VWMA, in price units, with participation deciding each bar's weight
vwMacd = fastVwma - slowVwma

// Signal line - both smoothings are computed on every bar, the input selects which one is used
emaSignal  = ta.ema(vwMacd, signalLengthInput)
smaSignal  = ta.sma(vwMacd, signalLengthInput)
signalLine = signalTypeInput == "EMA" ? emaSignal : smaSignal

// Histogram - VW-MACD minus its signal line
histogram = vwMacd - signalLine

// Price-only reference - the classic EMA-based MACD line on the same source and lengths
classicMacd = ta.ema(srcInput, fastLengthInput) - ta.ema(srcInput, slowLengthInput)

// MACD signal grammar - line/signal crossovers, zero-line crosses, histogram turns
bullCross     = ta.crossover(vwMacd, signalLine)
bearCross     = ta.crossunder(vwMacd, signalLine)
zeroCrossUp   = ta.crossover(vwMacd, 0)
zeroCrossDown = ta.crossunder(vwMacd, 0)
histTurnUp    = histogram > histogram[1] and histogram[1] <= histogram[2]
histTurnDown  = histogram < histogram[1] and histogram[1] >= histogram[2]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// Histogram shading encodes turns - bright while momentum expands, faded once it starts contracting
histExpanding   = histogram >= 0 ? histogram > histogram[1] : histogram < histogram[1]
histStrongColor = histogram >= 0 ? color.new(bullColorInput, HIST_GROW_TRANSP) : color.new(bearColorInput, HIST_GROW_TRANSP)
histSoftColor   = histogram >= 0 ? color.new(bullColorInput, HIST_FADE_TRANSP) : color.new(bearColorInput, HIST_FADE_TRANSP)
histColor       = histExpanding ? histStrongColor : histSoftColor

plot(showHistInput ? histogram : na, "Histogram", style = plot.style_columns, color = histColor)

zeroPlotId = plot(0, "Zero Line", color = color.new(chart.fg_color, 90), linewidth = 1)

plot(showClassicInput ? classicMacd : na, "Classic MACD (Price-only)", color = classicColorInput, linewidth = 1)

plot(signalLine, "Signal Line", color = signalColorInput, linewidth = 1)

macdPlotId = plot(vwMacd, "VW-MACD Line", color = vwMacd > 0 ? bullColorInput : bearColorInput, linewidth = 1)

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the VW-MACD value
fillTopColor    = vwMacd > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_ZERO_TRANSP)
fillBottomColor = vwMacd > 0 ? color.new(bullColorInput, FILL_ZERO_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(macdPlotId, zeroPlotId, top_value = math.max(vwMacd, 0), bottom_value = math.min(vwMacd, 0), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Zero-line Gradient Fill")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullCross, "Bullish Signal Cross", "Volume-weighted MACD crossed above its signal line on {{ticker}} - volume-weighted momentum turning up ({{interval}})")
alertcondition(bearCross, "Bearish Signal Cross", "Volume-weighted MACD crossed below its signal line on {{ticker}} - volume-weighted momentum turning down ({{interval}})")
alertcondition(zeroCrossUp, "Zero-line Cross Up", "Volume-weighted MACD crossed above zero on {{ticker}} - the fast VWMA is back above the slow VWMA ({{interval}})")
alertcondition(zeroCrossDown, "Zero-line Cross Down", "Volume-weighted MACD crossed below zero on {{ticker}} - the fast VWMA dropped under the slow VWMA ({{interval}})")
alertcondition(histTurnUp, "Histogram Turn Up", "Volume-weighted MACD histogram turned up on {{ticker}} - momentum shifting in favor of buyers ({{interval}})")
alertcondition(histTurnDown, "Histogram Turn Down", "Volume-weighted MACD histogram turned down on {{ticker}} - momentum shifting in favor of sellers ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
