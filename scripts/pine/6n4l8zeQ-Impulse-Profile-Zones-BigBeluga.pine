//@version=6
indicator("Impulse Profile Zones [BigBeluga]", overlay = true, max_labels_count = 500)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

filter = input.float(0.7, "Filter Large Candles", step = 0.01)
col_bull = input.color(color.aqua, "", inline = "1")
col_bear = input.color(color.orange, "", inline = "1")
size = input.bool(false, "Auto Size Profile")
// }


// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

top = close > open ? close : open
bot = close > open ? open : close
size_candle = top-bot

large_candle = size_candle / ta.percentile_linear_interpolation(size_candle, 200,100)


[c,v] = request.security_lower_tf("", str.tostring(math.ceil(timeframe.in_seconds(timeframe.period)/60/10)), [close, volume])

var volume_ = array.new<float>(10, 0)
var poc = line(na)
var poc_lbl = label(na)

var start = 2

trigger = large_candle > filter and bar_index-start[1] > 5

if trigger

    start := bar_index
    col1 = close > open ? col_bull : col_bear

    for i = 0 to volume_.size()-1
        volume_.set(i, 0)

    step = (high-low)/10

    if c.size() > 0

        for i = 0 to 10-1
            mid = low + step * i + step/2
            bot = low + step * i
            top = bot +  step
            for i = 0 to c.size()-1

                cls = c.get(i)
                cls1 = c.get(i < c.size()-1 ? i + 1 : i)
                vol = v.get(i)

                if cls > bot and cls < top
                    volume_.set(i,volume_.get(i) +  vol)

        for i = 0 to 10-1
            mid = low + step * i + step/2

            vol = volume_.get(i)

            vol_perc = vol / volume_.sum()

            if vol == volume_.max()
                poc := line.new(bar_index, mid, bar_index+50, mid, width = 2, color = col1) 
                poc_lbl := label.new(bar_index, mid, str.tostring(volume_.max(), format.volume), style = label.style_label_right, color = color(na), textcolor = col1)
            bin = vol_perc > 0.3 
                 ? "▇▇▇" : vol_perc > 0.1 
                 ? "▇▇--" : vol_perc < 0.01 
                 ? "|------" 
                 : "▇-----"



            color_bin = color.from_gradient(vol_perc, 0, 0.3, color.new(col1,50), col1)

            label.new(bar_index, mid, bin, style = label.style_label_center, color = color(na), textcolor = color_bin, size = size ? size.auto : size.tiny, textalign = text.align_center, force_overlay = true)
        

poc.set_x2(bar_index)

bgcolor(trigger ? color.new(chart.fg_color, 90) : color(na))
barcolor(trigger ? chart.bg_color : na)

// }