//@version=6
indicator("Elliott Guidelines", shorttitle = "Elliott Guidelines", overlay = true, max_lines_count = 50, max_labels_count = 50, max_boxes_count = 10)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
TARGET_COLOR  = #ff9800   // the one accent - the fifth-wave target zone
STRUCT_COLOR  = #787b86   // candidate structure and channels are structure - grey
NEUTRAL_COLOR = #787b86
HIDDEN_COLOR  = #00000000

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

EQ_RATIO  = 1.0
ALT_RATIO = 0.618

MAX_PIVOTS = 30
MAX_MINOR  = 250

ST_NA   = -1
ST_MISS = 0
ST_PASS = 1

SWING_GROUP  = 'Swing Detection'
ENGINE_GROUP = 'Guideline Engine'
PROJ_GROUP   = 'Projections & Display'
DASH_GROUP   = 'Dashboard'
STYLE_GROUP  = 'Style'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
pivotLengthInput = input.int(10, 'Pivot Length', minval = 2, maxval = 100, group = SWING_GROUP, tooltip = 'Bars to the left and right that must be lower (higher) for a swing high (low) to confirm. The six most recent swing points anchor the candidate five-wave count the guidelines are graded on — raise it to grade counts on major structure, lower it for minor counts.')

lesserLengthInput = input.int(3, 'Lesser-Degree Length', minval = 1, maxval = 20, group = SWING_GROUP, tooltip = 'Pivot length of the lesser-degree zigzag, one degree below the count. It locates the prior fourth wave inside wave 3 for the depth guideline and counts the subswings that compare the internal complexity of waves 2 and 4.')

directionInput = input.string('Auto', 'Count Selection', options = ['Auto', 'Bullish', 'Bearish'], group = ENGINE_GROUP, tooltip = 'Candidate count fed to the guideline engine. Auto grades the six most recent swing points as waves 0-5, so the tracked count re-anchors on every new swing. Bullish or Bearish locks onto the most recent candidate ending on a swing high or a swing low respectively, keeping the scorecard stable while the next leg develops.')

tolInput = input.float(0.1, 'Ratio Tolerance', minval = 0.01, maxval = 0.5, step = 0.01, group = ENGINE_GROUP, tooltip = 'Tolerance of the "near" checks. Equality passes when wave 5 is within this fraction of wave 1 (or 0.618 of it); channeling passes when wave 5 ends within this fraction of the channel width from the projected parallel.')

depthSplitInput = input.float(50, 'Sharp / Sideways Split %', minval = 10, maxval = 90, step = 0.1, group = ENGINE_GROUP, tooltip = 'Retracement depth separating a sharp, deep correction from a sideways, shallow one. Alternation passes when waves 2 and 4 fall on opposite sides of this split — one sharp and deep, the other sideways and shallow.')

momLengthInput = input.int(14, 'Momentum Length', minval = 2, group = ENGINE_GROUP, tooltip = 'RSI length used to grade wave personality: momentum should peak at the end of wave 3, with wave 5 advancing on fading momentum and often printing an oscillator divergence.')

showZigzagInput = input.bool(true, 'Candidate Wave Structure', group = PROJ_GROUP, tooltip = 'Connect the six swing points of the tracked candidate count. The last segment is dotted while its end point is still developing and can extend with price.')

showWaveLabelsInput = input.bool(true, 'Wave Numbers', group = PROJ_GROUP, tooltip = 'Label the candidate swing points 0 to 5, with 0 marking the origin of wave 1.')

showChannelInput = input.bool(true, 'Elliott Channel (W2-W4)', group = PROJ_GROUP, tooltip = 'Draw the channel through the ends of waves 2 and 4 and project the parallel from the end of wave 3 — the channeling guideline\'s estimate of where wave 5 may end.')

showProvInput = input.bool(false, 'Provisional Channel (W1-W3)', group = PROJ_GROUP, tooltip = 'While wave 5 is developing, also show the provisional channel through the ends of waves 1 and 3 with the parallel at wave 2 — the early channel used before the final wave-4 anchor is trusted. Channels are redrawn as pivots finalize.')

showEqualityInput = input.bool(true, 'Equality Targets', group = PROJ_GROUP, tooltip = 'When wave 3 is the extended wave, project wave 1\'s full length and 0.618 of it from the wave-4 extreme and shade the zone between them — the equality guideline\'s fifth-wave target zone.')

showDepthInput = input.bool(true, 'Prior Fourth-Wave Zone', group = PROJ_GROUP, tooltip = 'Shade the span of the fourth wave of one lesser degree found inside wave 3. The depth guideline expects wave 4 to terminate within this span.')

showDashInput = input.bool(true, 'Show Dashboard', group = DASH_GROUP, tooltip = 'Guideline scorecard for the tracked count: per-guideline conformance with the measured reading behind each grade, the wave-5 target projections, and the overall score used to rank the count.')

dashPosInput = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = DASH_GROUP, tooltip = 'Chart corner where the dashboard is anchored.')

dashSizeInput = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal'], group = DASH_GROUP, tooltip = 'Dashboard text size.')

passColorInput = input.color(BULL_COLOR, 'Pass', group = STYLE_GROUP, inline = 'pf', tooltip = 'Color for guidelines the tracked count conforms to and for bullish candidates.')
missColorInput = input.color(BEAR_COLOR, 'Miss', group = STYLE_GROUP, inline = 'pf', tooltip = 'Color for guidelines the tracked count misses and for bearish candidates. A missed guideline weakens the count but never invalidates it.')

structureColorInput = input.color(STRUCT_COLOR, 'Candidate Structure', group = STYLE_GROUP, tooltip = 'Color of the candidate wave structure and wave numbers.')

channelColorInput = input.color(STRUCT_COLOR, 'Channels', group = STYLE_GROUP, tooltip = 'Color of the Elliott channel and the provisional channel. Projected sections are dotted.')

targetColorInput = input.color(TARGET_COLOR, 'Equality Targets', group = STYLE_GROUP, tooltip = 'Color of the equality target levels and the shaded fifth-wave target zone.')

depthColorInput = input.color(NEUTRAL_COLOR, 'Prior Fourth-Wave Zone', group = STYLE_GROUP, tooltip = 'Color of the lesser-degree prior fourth-wave span drawn inside wave 3.')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// format a price with the symbol's tick precision
fmtPrice(float value) =>
    str.tostring(value, format.mintick)

// format a ratio with two decimals
fmtRatio(float value) =>
    str.tostring(value, '#.##')

// scorecard status text
stTxt(int st) =>
    st == ST_PASS ? 'PASS' : st == ST_MISS ? 'MISS' : '—'

// scorecard status color
stColor(int st) =>
    st == ST_PASS ? passColorInput : st == ST_MISS ? missColorInput : NEUTRAL_COLOR

//---------------------------------------------------------------------------------------------------------------------}
// Swing Structure
//---------------------------------------------------------------------------------------------------------------------{
// Alternating swing points, most recent last — each entry is the confirmed extreme of one leg,
// with the momentum reading captured at that extreme for the personality guideline
var array<float> pivotPriceArray = array.new<float>()
var array<int>   pivotBarArray   = array.new<int>()
var array<bool>  pivotHighArray  = array.new<bool>()
var array<float> pivotOscArray   = array.new<float>()

oscSeries = ta.rsi(close, momLengthInput)
max_bars_back(oscSeries, 200)

addPivot(float price, int barIdx, bool isHigh, float oscVal) =>
    array.push(pivotPriceArray, price)
    array.push(pivotBarArray, barIdx)
    array.push(pivotHighArray, isHigh)
    array.push(pivotOscArray, oscVal)
    if array.size(pivotPriceArray) > MAX_PIVOTS
        array.shift(pivotPriceArray)
        array.shift(pivotBarArray)
        array.shift(pivotHighArray)
        array.shift(pivotOscArray)

// Append when the swing alternates, extend the last swing when a more extreme same-side pivot prints
processPivot(float price, int barIdx, bool isHigh, float oscVal) =>
    bool changed = false
    int n = array.size(pivotPriceArray)
    if n == 0
        addPivot(price, barIdx, isHigh, oscVal)
        changed := true
    else
        bool  lastIsHigh = array.get(pivotHighArray, n - 1)
        float lastPrice  = array.get(pivotPriceArray, n - 1)
        if lastIsHigh == isHigh
            if (isHigh and price > lastPrice) or (not isHigh and price < lastPrice)
                array.set(pivotPriceArray, n - 1, price)
                array.set(pivotBarArray, n - 1, barIdx)
                array.set(pivotOscArray, n - 1, oscVal)
                changed := true
        else
            addPivot(price, barIdx, isHigh, oscVal)
            changed := true
    changed

pivotHigh = ta.pivothigh(pivotLengthInput, pivotLengthInput)
pivotLow  = ta.pivotlow(pivotLengthInput, pivotLengthInput)

confirmBar = bar_index - pivotLengthInput
oscAtPivot = oscSeries[pivotLengthInput]

bool pivotEvent = false

if not na(pivotHigh)
    if processPivot(pivotHigh, confirmBar, true, oscAtPivot)
        pivotEvent := true
if not na(pivotLow)
    if processPivot(pivotLow, confirmBar, false, oscAtPivot)
        pivotEvent := true

// Lesser-degree zigzag — one degree below the count, feeding the depth guideline and the
// subswing complexity comparison of the alternation guideline
var array<float> minorPriceArray = array.new<float>()
var array<int>   minorBarArray   = array.new<int>()
var array<bool>  minorHighArray  = array.new<bool>()

processMinor(float price, int barIdx, bool isHigh) =>
    int n = array.size(minorPriceArray)
    if n == 0
        array.push(minorPriceArray, price)
        array.push(minorBarArray, barIdx)
        array.push(minorHighArray, isHigh)
    else
        bool  lastIsHigh = array.get(minorHighArray, n - 1)
        float lastPrice  = array.get(minorPriceArray, n - 1)
        if lastIsHigh == isHigh
            if (isHigh and price > lastPrice) or (not isHigh and price < lastPrice)
                array.set(minorPriceArray, n - 1, price)
                array.set(minorBarArray, n - 1, barIdx)
        else
            array.push(minorPriceArray, price)
            array.push(minorBarArray, barIdx)
            array.push(minorHighArray, isHigh)
            if array.size(minorPriceArray) > MAX_MINOR
                array.shift(minorPriceArray)
                array.shift(minorBarArray)
                array.shift(minorHighArray)

// number of lesser-degree swing turns strictly inside a bar span
countInside(int spanStart, int spanEnd) =>
    int cnt = 0
    int sz = array.size(minorBarArray)
    if sz > 0
        for i = 0 to sz - 1
            int v = array.get(minorBarArray, i)
            if v > spanStart and v < spanEnd
                cnt += 1
    cnt

minorHigh = ta.pivothigh(lesserLengthInput, lesserLengthInput)
minorLow  = ta.pivotlow(lesserLengthInput, lesserLengthInput)

int minorSize = array.size(minorHighArray)

bool minorLastHi = false
if minorSize > 0
    minorLastHi := array.get(minorHighArray, minorSize - 1)

if minorLastHi
    if not na(minorLow)
        processMinor(minorLow, bar_index - lesserLengthInput, false)
    if not na(minorHigh)
        processMinor(minorHigh, bar_index - lesserLengthInput, true)
else
    if not na(minorHigh)
        processMinor(minorHigh, bar_index - lesserLengthInput, true)
    if not na(minorLow)
        processMinor(minorLow, bar_index - lesserLengthInput, false)

// Developing-leg extremes — the running end point of the leg after the last confirmed swing,
// with the momentum reading at the extreme so a developing wave 5 can be graded live
var float devHigh    = high
var float devLow     = low
var int   devHighBar = 0
var int   devLowBar  = 0
var float devHighOsc = na
var float devLowOsc  = na

if pivotEvent
    float legHigh    = high
    float legLow     = low
    int   legHighBar = bar_index
    int   legLowBar  = bar_index
    float legHighOsc = oscSeries
    float legLowOsc  = oscSeries
    for i = 1 to pivotLengthInput - 1
        if high[i] > legHigh
            legHigh    := high[i]
            legHighBar := bar_index - i
            legHighOsc := oscSeries[i]
        if low[i] < legLow
            legLow    := low[i]
            legLowBar := bar_index - i
            legLowOsc := oscSeries[i]
    devHigh    := legHigh
    devHighBar := legHighBar
    devHighOsc := legHighOsc
    devLow     := legLow
    devLowBar  := legLowBar
    devLowOsc  := legLowOsc
else
    if high > devHigh
        devHigh    := high
        devHighBar := bar_index
        devHighOsc := oscSeries
    if low < devLow
        devLow    := low
        devLowBar := bar_index
        devLowOsc := oscSeries

//---------------------------------------------------------------------------------------------------------------------}
// Candidate Count
//---------------------------------------------------------------------------------------------------------------------{
int pivotCount = array.size(pivotPriceArray)

bool lastPivotIsHigh = false
if pivotCount > 0
    lastPivotIsHigh := array.get(pivotHighArray, pivotCount - 1)

bool  provIsHigh = not lastPivotIsHigh
float provPrice  = provIsHigh ? devHigh : devLow
int   provBar    = provIsHigh ? devHighBar : devLowBar
float provOsc    = provIsHigh ? devHighOsc : devLowOsc

// Auto ends the count on the developing swing, Bullish/Bearish lock the end onto a high/low point
bool endAtProv     = directionInput == 'Auto' ? true : directionInput == 'Bullish' ? provIsHigh : not provIsHigh
bool haveCandidate = endAtProv ? pivotCount >= 5 : pivotCount >= 6

array<float> candPriceArray = array.new<float>()
array<int>   candBarArray   = array.new<int>()
array<float> candOscArray   = array.new<float>()

float c0 = na
float c1 = na
float c2 = na
float c3 = na
float c4 = na
float c5 = na

int b0 = -1
int b1 = -1
int b2 = -1
int b3 = -1
int b4 = -1
int b5 = -1

float o1 = na
float o3 = na
float o5 = na

bool c5Live   = haveCandidate and endAtProv
bool candBull = false

if haveCandidate
    int startIdx = endAtProv ? pivotCount - 5 : pivotCount - 6
    for i = startIdx to pivotCount - 1
        array.push(candPriceArray, array.get(pivotPriceArray, i))
        array.push(candBarArray, array.get(pivotBarArray, i))
        array.push(candOscArray, array.get(pivotOscArray, i))
    if endAtProv
        array.push(candPriceArray, provPrice)
        array.push(candBarArray, provBar)
        array.push(candOscArray, provOsc)
    c0 := array.get(candPriceArray, 0)
    c1 := array.get(candPriceArray, 1)
    c2 := array.get(candPriceArray, 2)
    c3 := array.get(candPriceArray, 3)
    c4 := array.get(candPriceArray, 4)
    c5 := array.get(candPriceArray, 5)
    b0 := array.get(candBarArray, 0)
    b1 := array.get(candBarArray, 1)
    b2 := array.get(candBarArray, 2)
    b3 := array.get(candBarArray, 3)
    b4 := array.get(candBarArray, 4)
    b5 := array.get(candBarArray, 5)
    o1 := array.get(candOscArray, 1)
    o3 := array.get(candOscArray, 3)
    o5 := array.get(candOscArray, 5)
    candBull := endAtProv ? provIsHigh : lastPivotIsHigh

//---------------------------------------------------------------------------------------------------------------------}
// Hard-Rule Gate
//---------------------------------------------------------------------------------------------------------------------{
// Guidelines are applied to a count that already satisfies the hard rules — rules eliminate
// counts, guidelines rank the survivors. Candidates failing the gate are not scored.
float dirSign = candBull ? 1.0 : -1.0

float w1 = na
float w2 = na
float w3 = na
float w4 = na
float w5 = na

bool ruleValid = false

if haveCandidate
    w1 := (c1 - c0) * dirSign
    w2 := (c1 - c2) * dirSign
    w3 := (c3 - c2) * dirSign
    w4 := (c3 - c4) * dirSign
    w5 := (c5 - c4) * dirSign
    bool structureOk = w1 > 0 and w2 > 0 and w3 > 0 and w4 > 0 and w5 > 0
    bool rule1Ok     = (c2 - c0) * dirSign > 0
    bool rule2Ok     = not (w3 < w1 and w3 < w5)
    bool rule3Ok     = (c4 - c1) * dirSign > 0
    ruleValid := structureOk and rule1Ok and rule2Ok and rule3Ok

//---------------------------------------------------------------------------------------------------------------------}
// Guideline Engine
//---------------------------------------------------------------------------------------------------------------------{
int statusAlt   = ST_NA
int statusEq    = ST_NA
int statusCh    = ST_NA
int statusDepth = ST_NA
int statusPers  = ST_NA

float r2Pct = na
float r4Pct = na
int   dur2  = 0
int   dur4  = 0
int   sub2  = 0
int   sub4  = 0

bool  eqApplicable = false
float ratio5       = na
float tFull        = na
float tAlt         = na
float zoneMin      = na
float zoneMax      = na

float chBaseNow  = na
float chParNow   = na
float chWidth    = na
float chDistPct  = na
float provBaseNow = na
float provParNow  = na

bool  depthFound  = false
float subLo       = na
float subHi       = na
int   subStartBar = -1

bool divergingNow = false

if ruleValid
    // 1 — Alternation: waves 2 and 4 tend to differ, one sharp and deep, the other sideways
    // and shallow, ideally differing in duration and internal structure too
    r2Pct := w2 / w1 * 100
    r4Pct := w4 / w3 * 100
    dur2  := b2 - b1
    dur4  := b4 - b3
    sub2  := countInside(b1, b2)
    sub4  := countInside(b3, b4)
    bool deep2 = r2Pct >= depthSplitInput
    bool deep4 = r4Pct >= depthSplitInput
    statusAlt := deep2 != deep4 ? ST_PASS : ST_MISS

    // 2 — Equality: when wave 3 extends, wave 5 tends toward wave 1's length or 0.618 of it,
    // projected from the wave-4 extreme
    eqApplicable := w3 >= w1 and w3 >= w5
    if eqApplicable
        tFull   := c4 + dirSign * w1 * EQ_RATIO
        tAlt    := c4 + dirSign * w1 * ALT_RATIO
        zoneMin := math.min(tFull, tAlt)
        zoneMax := math.max(tFull, tAlt)
        ratio5  := w5 / w1
        statusEq := math.abs(ratio5 - EQ_RATIO) <= tolInput or math.abs(ratio5 - ALT_RATIO) <= tolInput ? ST_PASS : ST_MISS

    // 3 — Channeling: base line through the ends of waves 2 and 4, parallel from the end of
    // wave 3 — wave 5 ending near that parallel fits the guideline
    float chSlope  = (c4 - c2) / (b4 - b2)
    float chOffset = c3 - (c2 + chSlope * (b3 - b2))
    float chParEnd = c2 + chSlope * (b5 - b2) + chOffset
    chBaseNow := c2 + chSlope * (bar_index - b2)
    chParNow  := chBaseNow + chOffset
    chWidth   := math.abs(chOffset)
    if chWidth > 0
        chDistPct := math.abs(c5 - chParEnd) / chWidth * 100
        statusCh  := chDistPct <= tolInput * 100 ? ST_PASS : ST_MISS

    // Provisional channel through the ends of waves 1 and 3, parallel at wave 2
    float provSlope  = (c3 - c1) / (b3 - b1)
    float provOffset = c2 - (c1 + provSlope * (b2 - b1))
    provBaseNow := c1 + provSlope * (bar_index - b1)
    provParNow  := provBaseNow + provOffset

    // 4 — Depth: fourth waves often terminate within the span of the fourth wave of one lesser
    // degree — the last lesser-degree correction inside wave 3
    int m = array.size(minorPriceArray)
    if m >= 2
        for j = 0 to m - 2
            int jStart = array.get(minorBarArray, j)
            int jEnd   = array.get(minorBarArray, j + 1)
            if jStart > b2 and jEnd < b3
                bool jHigh = array.get(minorHighArray, j)
                if candBull and jHigh and not array.get(minorHighArray, j + 1)
                    subHi       := array.get(minorPriceArray, j)
                    subLo       := array.get(minorPriceArray, j + 1)
                    subStartBar := jStart
                    depthFound  := true
                if not candBull and not jHigh and array.get(minorHighArray, j + 1)
                    subLo       := array.get(minorPriceArray, j)
                    subHi       := array.get(minorPriceArray, j + 1)
                    subStartBar := jStart
                    depthFound  := true
    if depthFound
        statusDepth := c4 >= subLo and c4 <= subHi ? ST_PASS : ST_MISS

    // 5 — Personality: momentum typically peaks in wave 3, while wave 5 advances on fading
    // momentum, often with oscillator divergence at a new price extreme
    if not na(o1) and not na(o3) and not na(o5)
        bool peak3 = candBull ? o3 > o1 and o3 > o5 : o3 < o1 and o3 < o5
        statusPers   := peak3 ? ST_PASS : ST_MISS
        divergingNow := (c5 - c3) * dirSign > 0 and (candBull ? o5 < o3 : o5 > o3)

// Scorecard tally — guidelines are graded evidence: each pass strengthens the count,
// each miss weakens it, and no miss invalidates it
int passCount       = 0
int applicableCount = 0

array<int> statusArray = array.from(statusAlt, statusEq, statusCh, statusDepth, statusPers)
for st in statusArray
    if st != ST_NA
        applicableCount += 1
        if st == ST_PASS
            passCount += 1

bool fullScoreNow = ruleValid and applicableCount > 0 and passCount == applicableCount
bool confluenceNow = false
if ruleValid and eqApplicable and not na(chParNow)
    confluenceNow := chParNow >= zoneMin and chParNow <= zoneMax

//---------------------------------------------------------------------------------------------------------------------}
// Events
//---------------------------------------------------------------------------------------------------------------------{
// Candidate identity — event latches re-arm whenever the tracked count re-anchors
int  candDirKey    = candBull ? 1 : 0
bool sameCandidate = haveCandidate and b0 == nz(b0[1], -9) and b4 == nz(b4[1], -9) and candDirKey == nz(candDirKey[1], -9)

bool eqTouchNow = false
if ruleValid and eqApplicable and c5Live
    eqTouchNow := candBull ? high >= zoneMin : low <= zoneMax

bool chTouchNow = false
if ruleValid and not na(chParNow) and c5Live
    chTouchNow := candBull ? high >= chParNow : low <= chParNow

bool divNow = ruleValid and c5Live and divergingNow

var bool eqHitLatch    = false
var bool chHitLatch    = false
var bool divLatch      = false
var bool conflLatch    = false
var bool scoreLatch    = false

if not sameCandidate
    eqHitLatch := false
    chHitLatch := false
    divLatch   := false
    conflLatch := false
    scoreLatch := false

bool eqTargetEvent   = eqTouchNow and not eqHitLatch
bool chTagEvent      = chTouchNow and not chHitLatch
bool divergenceEvent = divNow and not divLatch
bool confluenceEvent = confluenceNow and not conflLatch
bool fullScoreEvent  = fullScoreNow and not scoreLatch

eqHitLatch := eqHitLatch or eqTouchNow
chHitLatch := chHitLatch or chTouchNow
divLatch   := divLatch or divNow
conflLatch := conflLatch or confluenceNow
scoreLatch := scoreLatch or fullScoreNow

//---------------------------------------------------------------------------------------------------------------------}
// Candidate Structure
//---------------------------------------------------------------------------------------------------------------------{
var array<line>  zzLineArray    = array.new<line>()
var array<label> waveLabelArray = array.new<label>()

if showZigzagInput and haveCandidate
    if array.size(zzLineArray) == 0
        for i = 0 to 4
            array.push(zzLineArray, line.new(bar_index, close, bar_index, close, color = structureColorInput, width = 1))
    for i = 0 to 4
        line segLine = array.get(zzLineArray, i)
        line.set_xy1(segLine, array.get(candBarArray, i), array.get(candPriceArray, i))
        line.set_xy2(segLine, array.get(candBarArray, i + 1), array.get(candPriceArray, i + 1))
        line.set_style(segLine, i == 4 and c5Live ? line.style_dotted : line.style_solid)
        line.set_color(segLine, structureColorInput)

if showWaveLabelsInput and haveCandidate
    if array.size(waveLabelArray) == 0
        for i = 0 to 5
            array.push(waveLabelArray, label.new(bar_index, close, '', color = HIDDEN_COLOR, textcolor = structureColorInput, size = size.small))
    for i = 0 to 5
        bool pointIsHigh = candBull ? i % 2 == 1 : i % 2 == 0
        label waveLabel = array.get(waveLabelArray, i)
        label.set_xy(waveLabel, array.get(candBarArray, i), array.get(candPriceArray, i))
        label.set_text(waveLabel, str.tostring(i))
        label.set_style(waveLabel, pointIsHigh ? label.style_label_down : label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
// Projections
//---------------------------------------------------------------------------------------------------------------------{
// Elliott channel — base through waves 2 and 4 (solid), projection and wave-3 parallel dotted
var line chBaseSegId = na
var line chBaseExtId = na
var line chParId     = na

bool showChannelNow = showChannelInput and ruleValid

if showChannelNow
    if na(chBaseSegId)
        chBaseSegId := line.new(bar_index, close, bar_index, close, color = channelColorInput, width = 1)
        chBaseExtId := line.new(bar_index, close, bar_index, close, color = channelColorInput, style = line.style_dotted, width = 1)
        chParId     := line.new(bar_index, close, bar_index, close, color = channelColorInput, style = line.style_dotted, width = 1)
    line.set_xy1(chBaseSegId, b2, c2)
    line.set_xy2(chBaseSegId, b4, c4)
    line.set_color(chBaseSegId, channelColorInput)
    line.set_xy1(chBaseExtId, b4, c4)
    line.set_xy2(chBaseExtId, bar_index, chBaseNow)
    line.set_color(chBaseExtId, channelColorInput)
    line.set_xy1(chParId, b3, c3)
    line.set_xy2(chParId, bar_index, chParNow)
    line.set_color(chParId, channelColorInput)
else if not na(chBaseSegId)
    line.delete(chBaseSegId)
    line.delete(chBaseExtId)
    line.delete(chParId)
    chBaseSegId := na
    chBaseExtId := na
    chParId     := na

// Provisional channel — waves 1-3 base with the parallel at wave 2, only while wave 5 develops
var line provBaseId = na
var line provParId  = na

bool showProvNow = showProvInput and ruleValid and c5Live

if showProvNow
    if na(provBaseId)
        provBaseId := line.new(bar_index, close, bar_index, close, color = color.new(channelColorInput, 40), style = line.style_dotted, width = 1)
        provParId  := line.new(bar_index, close, bar_index, close, color = color.new(channelColorInput, 40), style = line.style_dotted, width = 1)
    line.set_xy1(provBaseId, b1, c1)
    line.set_xy2(provBaseId, bar_index, provBaseNow)
    line.set_color(provBaseId, color.new(channelColorInput, 40))
    line.set_xy1(provParId, b2, c2)
    line.set_xy2(provParId, bar_index, provParNow)
    line.set_color(provParId, color.new(channelColorInput, 40))
else if not na(provBaseId)
    line.delete(provBaseId)
    line.delete(provParId)
    provBaseId := na
    provParId  := na

// Equality target zone — wave 1 and 0.618 of it projected from the wave-4 extreme
var box   eqBoxId       = na
var label eqFullLabelId = na
var label eqAltLabelId  = na

bool showEqNow = showEqualityInput and ruleValid and eqApplicable

if showEqNow
    if na(eqBoxId)
        eqBoxId       := box.new(bar_index, close, bar_index, close, border_color = color.new(targetColorInput, 60), border_style = line.style_dashed, border_width = 1, bgcolor = color.new(targetColorInput, 88))
        eqFullLabelId := label.new(bar_index, close, '', color = HIDDEN_COLOR, style = label.style_label_left, textcolor = targetColorInput, size = size.tiny)
        eqAltLabelId  := label.new(bar_index, close, '', color = HIDDEN_COLOR, style = label.style_label_left, textcolor = targetColorInput, size = size.tiny)
    box.set_lefttop(eqBoxId, b4, zoneMax)
    box.set_rightbottom(eqBoxId, bar_index, zoneMin)
    box.set_border_color(eqBoxId, color.new(targetColorInput, 60))
    box.set_bgcolor(eqBoxId, color.new(targetColorInput, 88))
    label.set_xy(eqFullLabelId, bar_index, tFull)
    label.set_text(eqFullLabelId, 'W5 = W1 · ' + fmtPrice(tFull))
    label.set_textcolor(eqFullLabelId, targetColorInput)
    label.set_xy(eqAltLabelId, bar_index, tAlt)
    label.set_text(eqAltLabelId, 'W5 = 0.618 W1 · ' + fmtPrice(tAlt))
    label.set_textcolor(eqAltLabelId, targetColorInput)
else if not na(eqBoxId)
    box.delete(eqBoxId)
    label.delete(eqFullLabelId)
    label.delete(eqAltLabelId)
    eqBoxId       := na
    eqFullLabelId := na
    eqAltLabelId  := na

// Prior fourth wave of one lesser degree — the span inside wave 3 that wave 4 tends to end in
var box depthBoxId = na

bool showDepthNow = showDepthInput and ruleValid and depthFound

if showDepthNow
    if na(depthBoxId)
        depthBoxId := box.new(bar_index, close, bar_index, close, border_color = color.new(depthColorInput, 60), border_style = line.style_dashed, border_width = 1, bgcolor = color.new(depthColorInput, 88), text = 'prior 4th · lesser degree', text_size = size.tiny, text_color = color.new(depthColorInput, 25), text_halign = text.align_left)
    box.set_lefttop(depthBoxId, subStartBar, subHi)
    box.set_rightbottom(depthBoxId, b4, subLo)
    box.set_border_color(depthBoxId, color.new(depthColorInput, 60))
    box.set_bgcolor(depthBoxId, color.new(depthColorInput, 88))
    box.set_text_color(depthBoxId, color.new(depthColorInput, 25))
else if not na(depthBoxId)
    box.delete(depthBoxId)
    depthBoxId := na

plot(tFull, 'Equality Target (W5 = W1)', targetColorInput, 1, display = display.data_window, editable = false)
plot(tAlt, 'Equality Target (W5 = 0.618 W1)', targetColorInput, 1, display = display.data_window, editable = false)
plot(chParNow, 'Channel Parallel (W5 Line)', channelColorInput, 1, display = display.data_window, editable = false)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
dashPos = switch dashPosInput
    'Top Right'    => position.top_right
    'Top Left'     => position.top_left
    'Bottom Right' => position.bottom_right
    => position.bottom_left

dashTxtSize = switch dashSizeInput
    'Tiny'  => size.tiny
    'Small' => size.small
    => size.normal

var table dashTable = na

if showDashInput and barstate.islast
    if na(dashTable)
        dashTable := table.new(dashPos, 3, 9, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
        table.merge_cells(dashTable, 1, 0, 2, 0)
        table.merge_cells(dashTable, 1, 7, 2, 7)
        table.merge_cells(dashTable, 1, 8, 2, 8)

    labelColor = DASH_HEADER
    fadedColor = NEUTRAL_COLOR
    valueColor = DASH_TEXT

    dirTxt   = not haveCandidate ? 'Collecting swings' : (candBull ? 'Bullish 0-5' : 'Bearish 0-5') + (c5Live ? ' · W5 developing' : ' · W5 confirmed')
    dirColor = not haveCandidate ? fadedColor : candBull ? passColorInput : missColorInput

    altTxt = ruleValid ? 'W2 ' + str.tostring(r2Pct, '#.#') + '% ' + str.tostring(dur2) + 'b · W4 ' + str.tostring(r4Pct, '#.#') + '% ' + str.tostring(dur4) + 'b' : '—'
    eqTxt  = ruleValid ? (eqApplicable ? 'W5/W1 ' + fmtRatio(ratio5) + ' · targets 0.618, 1.0' : 'W3 not extended') : '—'
    chTxt  = ruleValid ? (not na(chDistPct) ? 'W5 off line by ' + str.tostring(chDistPct, '#.#') + '% of width' : 'flat channel') : '—'
    depTxt = ruleValid ? (depthFound ? fmtPrice(subLo) + ' - ' + fmtPrice(subHi) + (statusDepth == ST_PASS ? ' · W4 inside' : ' · W4 outside') : 'no lesser-degree 4th found') : '—'
    perTxt = ruleValid ? (statusPers == ST_NA ? 'momentum warming up' : 'RSI ' + str.tostring(o1, '#.#') + ' · ' + str.tostring(o3, '#.#') + ' · ' + str.tostring(o5, '#.#') + (divergingNow ? ' · divergence' : '')) : '—'

    targetsTxt = ruleValid ? (eqApplicable ? 'Eq ' + fmtPrice(zoneMin) + ' - ' + fmtPrice(zoneMax) + ' · ' : '') + (not na(chParNow) ? 'Ch ' + fmtPrice(chParNow) : '') + (confluenceNow ? ' · CONFLUENCE' : '') : '—'
    targetsColor = confluenceNow ? targetColorInput : ruleValid ? valueColor : fadedColor

    scoreTxt = not haveCandidate ? '—' : not ruleValid ? 'NOT RULE-VALID' : str.tostring(passCount) + '/' + str.tostring(applicableCount) + (fullScoreNow ? ' · STRONG COUNT' : passCount * 2 >= applicableCount ? ' · MODERATE' : ' · WEAK COUNT')
    scoreColor = not haveCandidate ? fadedColor : not ruleValid ? missColorInput : fullScoreNow ? passColorInput : passCount * 2 >= applicableCount ? valueColor : missColorInput

    table.cell(dashTable, 0, 0, 'Tracked Count', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, dirTxt, text_color = dirColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 1, 'Guideline', text_color = fadedColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, 'Status', text_color = fadedColor, text_size = dashTxtSize)
    table.cell(dashTable, 2, 1, 'Reading', text_color = fadedColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 2, 'Alternation · W2 vs W4', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left, tooltip = 'Waves 2 and 4 tend to differ in form: one sharp and deep, the other sideways and shallow, ideally differing in duration and internal structure too. Passes when the two retracement depths fall on opposite sides of the split. Lesser-degree subswings inside W2: ' + str.tostring(sub2) + ', inside W4: ' + str.tostring(sub4) + '.')
    table.cell(dashTable, 1, 2, stTxt(statusAlt), text_color = stColor(statusAlt), text_size = dashTxtSize)
    table.cell(dashTable, 2, 2, altTxt, text_color = ruleValid ? valueColor : fadedColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 3, 'Equality · W5 vs W1', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left, tooltip = 'When wave 3 extends, waves 1 and 5 tend toward equal length or a 0.618 relationship, projected from the wave-4 extreme. Passes when W5/W1 is within the ratio tolerance of 1.0 or 0.618. Not graded when wave 3 is not the extended wave.')
    table.cell(dashTable, 1, 3, stTxt(statusEq), text_color = stColor(statusEq), text_size = dashTxtSize)
    table.cell(dashTable, 2, 3, eqTxt, text_color = ruleValid ? valueColor : fadedColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 4, 'Channeling · W5 line', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left, tooltip = 'A channel through the ends of waves 2 and 4, with the parallel at the end of wave 3, projects where wave 5 may end. Passes when wave 5 ends within the tolerance share of the channel width from the parallel.')
    table.cell(dashTable, 1, 4, stTxt(statusCh), text_color = stColor(statusCh), text_size = dashTxtSize)
    table.cell(dashTable, 2, 4, chTxt, text_color = ruleValid ? valueColor : fadedColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 5, 'Depth · prior 4th', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left, tooltip = 'Fourth waves often terminate within the span of the fourth wave of one lesser degree, located inside wave 3 on the lesser-degree zigzag. Passes when the wave-4 extreme ended inside that span.')
    table.cell(dashTable, 1, 5, stTxt(statusDepth), text_color = stColor(statusDepth), text_size = dashTxtSize)
    table.cell(dashTable, 2, 5, depTxt, text_color = ruleValid ? valueColor : fadedColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 6, 'Personality · momentum', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left, tooltip = 'Each wave position has a typical character: wave 3 the strongest, broadest move, wave 5 narrower with fading momentum and often an oscillator divergence. Passes when RSI at the wave ends peaks at wave 3. Readings are RSI at the ends of waves 1, 3 and 5.')
    table.cell(dashTable, 1, 6, stTxt(statusPers), text_color = stColor(statusPers), text_size = dashTxtSize)
    table.cell(dashTable, 2, 6, perTxt, text_color = ruleValid ? valueColor : fadedColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 7, 'W5 Targets', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left, tooltip = 'Guideline-derived fifth-wave projections: the equality target zone measured from the wave-4 extreme, plus the channel parallel. Several projections pointing to one area form a confluence zone — a place to watch for terminal behavior, not a promise of reversal.')
    table.cell(dashTable, 1, 7, targetsTxt, text_color = targetsColor, text_size = dashTxtSize, text_halign = text.align_right)

    table.cell(dashTable, 0, 8, 'Guideline Score', text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 8, scoreTxt, text_color = scoreColor, text_size = dashTxtSize, text_halign = text.align_right, bgcolor = color.new(scoreColor, 85), tooltip = 'Rules eliminate counts; guidelines rank the survivors. A count missing alternation or a clean channel stays valid, it just ranks below one that shows them — use the score as accumulating evidence when arbitrating between competing rule-valid counts.')

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(eqTargetEvent, 'Equality Target Reached', 'Elliott Guidelines on {{ticker}} ({{interval}}): price reached the fifth-wave equality target zone (wave 1 x 0.618-1.0 projected from the wave-4 extreme) on the tracked rule-valid count. Watch for terminal behavior.')

alertcondition(chTagEvent, 'Channel Parallel Tagged', 'Elliott Guidelines on {{ticker}} ({{interval}}): price tagged the channel parallel projected from the end of wave 3 — the channeling guideline\'s estimate of where wave 5 may end.')

alertcondition(divergenceEvent, 'Fifth-Wave Momentum Divergence', 'Elliott Guidelines on {{ticker}} ({{interval}}): the developing wave 5 pushed past the wave-3 extreme on fading momentum — the classic fifth-wave personality cue that the motive phase may be maturing.')

alertcondition(confluenceEvent, 'Wave-5 Target Confluence', 'Elliott Guidelines on {{ticker}} ({{interval}}): the channel parallel and the equality target zone point to one area — a confluence zone to watch for terminal behavior, not a promise of reversal.')

alertcondition(fullScoreEvent, 'High Guideline Conformance', 'Elliott Guidelines on {{ticker}} ({{interval}}): the tracked rule-valid count now conforms to every applicable guideline — strong evidence for preferring this count over competing labelings.')

//---------------------------------------------------------------------------------------------------------------------}
