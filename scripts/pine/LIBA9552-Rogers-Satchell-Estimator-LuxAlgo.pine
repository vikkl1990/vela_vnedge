//@version=6
indicator("Rogers-Satchell Estimator", shorttitle = "Rogers-Satchell Estimator", overlay = false, format = format.percent, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
VOL_COLOR         = #787b86 // volatility line between the percentile thresholds
COMPRESSED_COLOR  = #089981 // quiet, compressed readings - the favorable setup
EXPANDED_COLOR    = #f23645 // expanded readings - the danger side
CC_COLOR          = color.new(#787b86, 40) // close-to-close comparison line - a structural reference
LEVEL_COLOR       = #787b86 // dotted percentile reference levels

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB
FILL_VALUE_TRANSP = 50      // gradient transparency at the volatility value
FILL_ZERO_TRANSP  = 100     // gradient transparency at zero

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Window Length", minval = 2, group = "Calculation",
     tooltip = "Number of bars the per-bar Rogers-Satchell variance is averaged over. Common choices run 10-30 for tactical work and longer for regime studies. Each bar contributes four log price relations, so the estimate stabilizes on shorter windows than close-to-close volatility needs; keep the window fixed when comparing instruments, since length changes level and responsiveness together.")

annualizeInput = input.bool(true, "Annualize", group = "Calculation",
     tooltip = "Scales the reading to annualized volatility - average per-bar variance times bars per year, square-rooted - so it can be compared across instruments and against options-market figures. Disable to read the raw per-bar volatility of the window instead.")

barsPerYearInput = input.int(252, "Bars Per Year", minval = 1, group = "Calculation",
     tooltip = "Annualization constant. Daily equity data conventionally uses 252; some futures and forex tools use 260 or 365. Intraday charts must count bars per year - bars per session times trading days. Annualization constants are a leading cause of cross-platform disagreements, so match this setting when reconciling readings.")

showCcInput = input.bool(true, "Close-to-Close Comparison", group = "Drift Diagnostic",
     tooltip = "Overlays zero-mean close-to-close volatility on the same window and annualization - the drift-sensitive baseline. One-way trend and overnight gaps enter its squared returns, while the Rogers-Satchell terms cancel drift and never see gaps, so a persistent gap between the two lines flags how much of measured volatility is directional progress rather than two-sided movement inside the bars. On a steady one-way tape the comparison runs high while Rogers-Satchell prices only the wiggle around the move.")

percentileLengthInput = input.int(100, "Percentile Lookback", minval = 10, group = "Percentile Thresholds",
     tooltip = "Bars used to rank the current reading against its own history. The percentile rank drives the expansion and compression alerts without an absolute cutoff, so screening stays comparable across instruments and annualization settings.")

highPercentileInput = input.float(80, "High Percentile", minval = 50, maxval = 100, step = 1, inline = "percentile", group = "Percentile Thresholds",
     tooltip = "Percentile rank above which volatility counts as expanded; crossing it fires the 'Volatility Expansion' alert.")

lowPercentileInput = input.float(20, "Low Percentile", minval = 0, maxval = 50, step = 1, inline = "percentile", group = "Percentile Thresholds",
     tooltip = "Percentile rank below which volatility counts as compressed - quiet two-sided movement that often precedes range expansion, and because drift cancels out of the estimator, a market can read compressed here even while it is still grinding one way. Crossing under it fires the 'Volatility Compression' alert.")

showLevelsInput = input.bool(false, "Show Percentile Levels", group = "Percentile Thresholds",
     tooltip = "Plots the volatility values sitting at the high and low percentiles of the lookback as dotted reference levels, making threshold crossings visible in the pane. Off by default to keep the pane clean; the alerts fire either way.")

showDashInput = input.bool(true, "Show Dashboard", group = "Dashboard",
     tooltip = "Displays the current Rogers-Satchell reading, zero-mean close-to-close volatility on the same settings, the spread between the two - the drift diagnostic in numbers - and the percentile rank of the reading.")

dashPosInput = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "dash", group = "Dashboard",
     tooltip = "Corner of the pane the dashboard is anchored to.")

dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], inline = "dash", group = "Dashboard",
     tooltip = "Dashboard text size.")

volColorInput = input.color(VOL_COLOR, "Rogers-Satchell Volatility", group = "Style",
     tooltip = "Color of the Rogers-Satchell volatility line and its gradient fill while the reading sits between the percentile thresholds. The estimate measures two-sided movement size only and carries no directional information - toward either threshold the color blends into the compressed or expanded color.")

compressedColorInput = input.color(COMPRESSED_COLOR, "Compressed", inline = "state", group = "Style",
     tooltip = "Color of the line and fill at and below the low percentile - quiet two-sided movement that often precedes range expansion.")

expandedColorInput = input.color(EXPANDED_COLOR, "Expanded", inline = "state", group = "Style",
     tooltip = "Color of the line and fill at and above the high percentile - expanded two-sided movement.")

ccColorInput = input.color(CC_COLOR, "Close-to-Close", group = "Style",
     tooltip = "Color of the close-to-close comparison line.")

levelColorInput = input.color(LEVEL_COLOR, "Percentile Levels", group = "Style",
     tooltip = "Color of the dotted high and low percentile reference levels.")

gradientInput = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between zero and the volatility line with a vertical gradient - fully transparent at zero, strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
getTablePosition(positionText) =>
    switch positionText
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

getTextSize(sizeText) =>
    switch sizeText
        "Tiny"  => size.tiny
        "Small" => size.small
        => size.normal

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Log price relations - each intrabar extreme paired against both endpoints of the bar. Guards keep
// degenerate bars (missing or non-positive prices) from contaminating the window
validBar = high > 0 and low > 0 and open > 0 and close > 0

logHighClose = validBar ? math.log(high / close) : na
logHighOpen  = validBar ? math.log(high / open)  : na
logLowClose  = validBar ? math.log(low / close)  : na
logLowOpen   = validBar ? math.log(low / open)   : na

// Per-bar Rogers-Satchell variance: ln(H/C) ln(H/O) + ln(L/C) ln(L/O). Pairing each extreme against
// both endpoints is what cancels drift - a bar that opens at its low and closes at its high
// contributes exactly zero, while two-sided excursion contributes a lot - so the estimate stays
// unbiased when the market trends. Each product pairs same-signed logs, so no bar goes negative
rsVariance = logHighClose * logHighOpen + logLowClose * logLowOpen

// Zero-mean close-to-close variance on the same window - the drift-sensitive baseline. One-way trend
// and overnight gaps enter the squared return but cancel out of (or never reach) the Rogers-Satchell
// terms, so the spread between the two isolates how much of measured volatility is drift or gaps
logReturn  = close > 0 and not na(close[1]) and close[1] > 0 ? math.log(close / close[1]) : na
ccVariance = logReturn * logReturn

// Window means -> volatility: average the per-bar variance across the window, multiply by bars per
// year, take the square root. Rogers-Satchell bars are non-negative by construction; the zero floor
// stays as cheap hygiene before the root
rsMeanVariance = ta.sma(rsVariance, lengthInput)
ccMeanVariance = ta.sma(ccVariance, lengthInput)

annualFactor = annualizeInput ? barsPerYearInput : 1
rsVol = na(rsMeanVariance) ? na : math.sqrt(math.max(rsMeanVariance, 0) * annualFactor) * 100
ccVol = na(ccMeanVariance) ? na : math.sqrt(math.max(ccMeanVariance, 0) * annualFactor) * 100

// Drift diagnostic in numbers - how far the drift-sensitive baseline sits above the drift-independent
// reading on the same window
volSpread = na(rsVol) or na(ccVol) ? na : ccVol - rsVol

// Percentile rank of the reading against its own history - compression screening and expansion
// flagging without an absolute cutoff. The interpolated percentile values double as plottable levels
volPercentile = ta.percentrank(rsVol, percentileLengthInput)
highLevel     = ta.percentile_linear_interpolation(rsVol, percentileLengthInput, highPercentileInput)
lowLevel      = ta.percentile_linear_interpolation(rsVol, percentileLengthInput, lowPercentileInput)

// Threshold events
expansionEvent   = ta.crossover(volPercentile, highPercentileInput)
compressionEvent = ta.crossunder(volPercentile, lowPercentileInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// State coloring across the percentile thresholds - compressed below the low percentile, neutral midway, expanded above the high percentile
midPercentile = (highPercentileInput + lowPercentileInput) / 2
volStateColor = na(volPercentile) ? volColorInput : volPercentile <= midPercentile ? color.from_gradient(volPercentile, lowPercentileInput, midPercentile, compressedColorInput, volColorInput) : color.from_gradient(volPercentile, midPercentile, highPercentileInput, volColorInput, expandedColorInput)

fillTopColor    = gradientInput ? color.new(volStateColor, FILL_VALUE_TRANSP) : na
fillBottomColor = gradientInput ? color.new(volStateColor, FILL_ZERO_TRANSP) : na

rsPlotId   = plot(rsVol, "Rogers-Satchell Volatility", color = volStateColor, linewidth = 2)
zeroPlotId = plot(0, "Zero Line", color = color.new(LEVEL_COLOR, 70), linewidth = 1)

fill(rsPlotId, zeroPlotId, top_value = math.max(nz(rsVol), 0), bottom_value = 0, top_color = fillTopColor, bottom_color = fillBottomColor, title = "Volatility Gradient Fill")

plot(showCcInput ? ccVol : na, "Close-to-Close Comparison", color = ccColorInput, linewidth = 1)

plot(showLevelsInput ? highLevel : na, "High Percentile Level", color = color.new(levelColorInput, 30), linewidth = 1, style = plot.style_circles)
plot(showLevelsInput ? lowLevel : na, "Low Percentile Level", color = color.new(levelColorInput, 30), linewidth = 1, style = plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashTable = na

if barstate.isfirst and showDashInput
    dashTable := table.new(getTablePosition(dashPosInput), 2, 4, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if barstate.islast and showDashInput and not na(dashTable)
    rsText     = na(rsVol) ? "-" : str.tostring(rsVol, "#.##") + "%"
    ccText     = na(ccVol) ? "-" : str.tostring(ccVol, "#.##") + "%"
    spreadText = na(volSpread) ? "-" : (volSpread > 0 ? "+" : "") + str.tostring(volSpread, "#.##") + "%"
    rankText   = na(volPercentile) ? "-" : str.tostring(volPercentile, "#")
    labelColor   = DASH_HEADER
    dashTextSize = getTextSize(dashSizeInput)
    table.cell(dashTable, 0, 0, "Rogers-Satchell", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, rsText, text_color = volStateColor, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 1, "Close-to-Close", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, ccText, text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, "Spread", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, spreadText, text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 3, "Percentile Rank", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, rankText, text_color = volStateColor, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(expansionEvent, "Volatility Expansion", "Rogers-Satchell on {{ticker}} - annualized volatility crossed above its high percentile threshold, two-sided intrabar movement is expanding ({{interval}})")
alertcondition(compressionEvent, "Volatility Compression", "Rogers-Satchell on {{ticker}} - annualized volatility fell below its low percentile threshold, a quiet stretch that often precedes range expansion ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
