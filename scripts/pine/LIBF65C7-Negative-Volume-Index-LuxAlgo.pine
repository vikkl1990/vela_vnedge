//@version=6
indicator("Negative Volume Index", shorttitle = "Negative Volume Index", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR          = #089981 // directional bullish color
BEAR_COLOR          = #f23645 // directional bearish color
NEUTRAL_COLOR       = #787b86 // non-directional color
SIGNAL_COLOR        = #787b86 // signal EMA color - the reference line is structure
FILL_VALUE_TRANSP   = 50      // gradient transparency at the NVI value
FILL_AVERAGE_TRANSP = 100     // gradient transparency at the signal EMA

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
baseInput = input.float(1000, "Base Level", minval = 0.01, group = "Settings",
     tooltip = "Arbitrary seed of the cumulative line, conventionally 1000. The absolute level carries no information — the line is read by its slope and by its position against the signal EMA — so the base only sets the scale of the numbers.")

showSignalInput = input.bool(true, "Signal EMA", inline = "signal", group = "Settings",
     tooltip = "Displays the conventional signal overlay — a long EMA of the line. Hiding it only removes the plotted average; the regime coloring, gradient fill and cross alerts continue to use it.")

signalLengthInput = input.int(255, "", minval = 1, inline = "signal", group = "Settings",
     tooltip = "Length of the signal EMA. The convention is one trading year — 255 sessions on daily charts — matching the regime-scale horizon the indicator was designed for: position against this average, not day-to-day wiggles, is the classic signal.")

colorModeInput = input.string("Position vs Average", "Line Coloring", options = ["Position vs Average", "Single Color"], group = "Style",
     tooltip = "'Position vs Average' colors the line by the classic regime read — bullish while NVI holds above its signal EMA, bearish while below, neutral when sitting exactly on it. 'Single Color' draws the whole line in the neutral color.")

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "colors", group = "Style",
     tooltip = "Color of the line and gradient fill while NVI is above its signal EMA — quiet-session behavior supporting a healthy primary trend.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = "Style",
     tooltip = "Color of the line and gradient fill while NVI is below its signal EMA — the quiet-day distribution regime.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral", group = "Style",
     tooltip = "Color of the whole line in Single Color mode, and of bars where NVI sits exactly on its average in Position vs Average mode.")

signalColorInput = input.color(SIGNAL_COLOR, "Signal EMA", group = "Style",
     tooltip = "Color of the signal EMA overlay.")

gradientInput = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the gap between the line and its signal EMA with a vertical gradient — fully transparent at the average, strongest at the line — so the side and depth of the current regime read at a glance.")

//---------------------------------------------------------------------------------------------------------------------}
// Negative Volume Index
//---------------------------------------------------------------------------------------------------------------------{
// The construction needs a genuine volume feed — without one, no session can ever register falling volume and the
// line would sit at its base forever
float cumulativeVolume = ta.cum(nz(volume))
if barstate.islast and cumulativeVolume == 0
    runtime.error("No volume is provided by the data vendor. The Negative Volume Index requires volume data.")

// Dysart's cumulative line (1930s), as standardized by Fosback (1976): the line updates ONLY on sessions whose volume
// is below the prior session's — the quiet days the crowd sits out and informed money is presumed to position on —
// compounding by the day's close-to-close percentage change on those sessions. Equal- or rising-volume sessions leave
// it unchanged. The first bar (no prior session), unreported volume and a zero prior close all contribute no change,
// keeping the line defined from the first bar instead of poisoning the running product with na
float previousVolume = volume[1]
float previousClose  = close[1]

bool volumeFell = not na(volume) and not na(previousVolume) and volume < previousVolume

float dayChange = not na(close) and not na(previousClose) and previousClose != 0 ? (close - previousClose) / previousClose : 0.0

var float nvi = baseInput
nvi := volumeFell ? nvi * (1 + dayChange) : nvi

// The conventional signal overlay — a one-year EMA of the line. The classic read is position, not wiggles: above the
// average quiet-day flows support a healthy primary trend, below it they lean toward quiet-day distribution
float signalEma = ta.ema(nvi, signalLengthInput)

bool aboveAverage = not na(signalEma) and nvi > signalEma
bool belowAverage = not na(signalEma) and nvi < signalEma

bool bullishCross = ta.crossover(nvi, signalEma)
bool bearishCross = ta.crossunder(nvi, signalEma)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color regimeColor = aboveAverage ? bullColorInput : belowAverage ? bearColorInput : neutralColorInput
color nviColor    = colorModeInput == "Position vs Average" ? regimeColor : neutralColorInput

signalPlotId = plot(signalEma, "Signal EMA", color = showSignalInput ? signalColorInput : na, linewidth = 1)
nviPlotId    = plot(nvi, "NVI", color = nviColor, linewidth = 2)

// Regime gradient — fully transparent at the average, strongest at the NVI value, colored by which side the line is on
color fillTopColor    = aboveAverage ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_AVERAGE_TRANSP)
color fillBottomColor = aboveAverage ? color.new(bullColorInput, FILL_AVERAGE_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(nviPlotId, signalPlotId, top_value = math.max(nvi, signalEma), bottom_value = math.min(nvi, signalEma), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Regime Gradient Fill")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullishCross, "Bullish Signal Cross", "Negative Volume Index crossed above its signal EMA on {{ticker}} ({{interval}}) — quiet-session price behavior is back above its one-year average, the healthy-primary-trend configuration in Fosback's reading. A regime-scale backdrop signal, strongest when other breadth or volume evidence agrees.")
alertcondition(bearishCross, "Bearish Signal Cross", "Negative Volume Index crossed below its signal EMA on {{ticker}} ({{interval}}) — the line slipped under its one-year average, the classic caution flag for quiet-day distribution. It gains weight when other breadth or volume evidence agrees.")

//---------------------------------------------------------------------------------------------------------------------}
