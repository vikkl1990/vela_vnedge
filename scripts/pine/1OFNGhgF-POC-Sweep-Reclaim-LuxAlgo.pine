//@version=6
indicator("POC Sweep Reclaim [LuxAlgo]", "LuxAlgo - POC Sweep Reclaim", overlay = true, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

color BULL_COLOR = #089981
color BEAR_COLOR = #f23645

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{

string tfInput       = input.timeframe("1", "Lower Timeframe for POC", tooltip = "The timeframe used to aggregate volume-at-close. Note: A lower timeframe provides a better proxy, though a true footprint engine would be more accurate.")
bool showPocInput    = input.bool(true, "Show POC", tooltip = "Display the calculated Point of Control (POC) for each bar.")
bool showSweepsInput  = input.bool(true, "Show Sweep Dots", tooltip = "Display dots at the POC level when a wick interaction without a body close occurs.")
bool showBsrInput     = input.bool(true, "Show BSR (Buyside Reclaim)", tooltip = "Highlight candles that reclaim a previously swept buyside POC.")
bool showSsrInput     = input.bool(true, "Show SSR (Sellside Reclaim)", tooltip = "Highlight candles that reclaim a previously swept sellside POC.")

//---------------------------------------------------------------------------------------------------------------------}
// Types & Functions
//---------------------------------------------------------------------------------------------------------------------{

// @function Calculates a proxy for the Point of Control (POC) using lower timeframe data.
// @returns The price level (sub-bar close) with the highest aggregated volume.
getPoc() =>
    float[] ltfClose  = request.security_lower_tf(syminfo.tickerid, tfInput, close)
    float[] ltfVolume = request.security_lower_tf(syminfo.tickerid, tfInput, volume)
    
    float poc = na
    if array.size(ltfClose) > 0
        float maxVol = -1.0
        map<float, float> volAtPrice = map.new<float, float>()
        
        for i = 0 to array.size(ltfClose) - 1
            float price = ltfClose.get(i)
            float vol   = ltfVolume.get(i)
            
            float currentVol = volAtPrice.get(price)
            float newVol = (na(currentVol) ? 0 : currentVol) + vol
            volAtPrice.put(price, newVol)
            
            if newVol > maxVol
                maxVol := newVol
                poc := price
    poc

//---------------------------------------------------------------------------------------------------------------------}
// Logic
//---------------------------------------------------------------------------------------------------------------------{

float currentPoc = getPoc()
float prevPoc    = currentPoc[1]

// 1. Sweep Logic (The Rejection)
// Price trades through the previous level (wick crosses) but is not accepted (body closes back).
bool buysideSweep = high > prevPoc and math.max(open, close) < prevPoc
bool sellsideSweep = low < prevPoc and math.min(open, close) > prevPoc

// 2. Reclaim Logic (The Acceptance)
// The next bar is accepted beyond the same level that was swept.
// We compare current close against currentPoc[2] because the sweep on bar[1] was relative to POC of bar[2].
float sweptLevel = currentPoc[2]
bool bstReclaim = showBsrInput and buysideSweep[1] and close > sweptLevel
bool sstReclaim = showSsrInput and sellsideSweep[1] and close < sweptLevel

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{

// Plot POC Dots
plot(showPocInput ? currentPoc : na, "POC", color.new(chart.fg_color, 70), 1, plot.style_circles)

// Plot Sweep Dots (Markers for the Rejection)
plot(showSweepsInput and buysideSweep ? prevPoc : na, "Buyside Sweep", color = BEAR_COLOR, linewidth = 1, style = plot.style_circles, join = false)
plot(showSweepsInput and sellsideSweep ? prevPoc : na, "Sellside Sweep", color = BULL_COLOR, linewidth = 1, style = plot.style_circles, join = false)

// Highlight Sweep Levels
if showSweepsInput
    if buysideSweep
        line.new(bar_index - 1, prevPoc, bar_index, prevPoc, color = BEAR_COLOR, width = 2)
    if sellsideSweep
        line.new(bar_index - 1, prevPoc, bar_index, prevPoc, color = BULL_COLOR, width = 2)

// Reclaim Visuals (Markers for the Acceptance)
barcolor(bstReclaim ? BULL_COLOR : sstReclaim ? BEAR_COLOR : na, title = "Reclaim Candle Highlight")

if bstReclaim
    label.new(bar_index, low, "BSR", color = #00000000, textcolor = BULL_COLOR, style = label.style_label_up, size = size.small)

if sstReclaim
    label.new(bar_index, high, "SSR", color = #00000000, textcolor = BEAR_COLOR, style = label.style_label_down, size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
