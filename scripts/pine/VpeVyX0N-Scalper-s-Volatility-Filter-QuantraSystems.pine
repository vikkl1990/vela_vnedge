// © QuantraSystems
// @version=5
indicator("Scalper's Volatility Filter [QuantraSystems]", overlay = false)

import QuantraAI/QuantraMAs/2 as DynamicMA
import QuantraSystems/DynamicFunctions/1 as DynamicFunc



//              ╔═══════════════════════════╗              //
//              ║    USER DEFINED INPUTS    ║              //
//              ╚═══════════════════════════╝              //



var GRP0 = "Normalization/Sensitivity Length",       var GRP3 = "Linear Regression Dispersion"
var GRP1 = "Modified Damiani Voltmeter",             var GRP4 = "Visualization"
var GRP2 = "Average Directional Index",              var COMP = "Compressed Signal Mode"
var SeTT = "A shorter period increases sensitivity", var HATT = "Calcutes an alternative volatility measurement based on the HA candle size"

NormSens     = input.int   (10,              "Speed",                           group = GRP0, tooltip = SeTT  )
     
vis_atr      = input.int   (13,              "Base ATR Length",                 group = GRP1                  )
sed_atr      = input.int   (40,              "Second ATR Length",               group = GRP1                  )
vis_std      = input.int   (20,              "Base StdDev",                     group = GRP1                  )
sed_std      = input.int   (100,             "Second StdDev",                   group = GRP1                  )
                      
adxlen       = input.int   (14,              "ADX Smoothing",                   group = GRP2                  )
dilen        = input.int   (14,              "DI Length",                       group = GRP2                  )
adxbase      = input.int   (25,              "ADX Baseline",                    group = GRP2                  )
                      
period       = input.int   (20,              "Regression Length",               group = GRP3                  )
TrSens       = input.int   (350,             "Regression Sensitivity",          group = GRP3                  )
Vol_lookback = input.int   (50,              "Historical Volatility Lookback",  group = GRP3, tooltip = HATT  )
  
BCol         = input.bool  (false,           "Bar Coloring",                    group = GRP4, inline  = "Cl"  )
Hollow       = input.bool  (true,            "Hollow Candles",                  group = GRP4, inline  = "Cl"  )
  
display      = input.string("Crosses",       "Display Type",                    group = GRP4,                   options = ["Crosses", "Histogram", "Heikin-Ashi", "HA-Width"         ])
ColMode      = input.string("Modern",        "Color Palette Choice",            group = GRP4, inline  = "Drop", options = ["Classic", "Modern",    "Robust", "Accented", "Monochrome"])
man          = input.bool  (false,           "Custom Palette",                  group = GRP4, inline  = "Drop")
manUpC       = input.color (#00ff00,       "Custom Rising Volatility",        group = GRP4                  ) 
manDnC       = input.color (#ff0000,       "Custom Falling Volatility",       group = GRP4                  )
   
compress     = input.bool  (false,           "Compressed Mode",                 group = COMP                  )
labels       = input.bool  (true,            "Labels",                          group = COMP                  )   
Volatil_B    = input.bool  (true,            "Signal Line",                     group = COMP                  )







//              ╔══════════════════════════╗              //
//              ║    COLOR DECLARATIONS    ║              //
//              ╚══════════════════════════╝              //


// Color assignment based on the selected palette
[UpC, DnC]       =  switch    ColMode
    "Classic"    => [#00E676, #880E4F]
    "Modern"     => [#5ffae0, #c22ed0]
    "Robust"     => [#ffbb00, #770737]
    "Accented"   => [#9618f7, #ff0078]
    "Monochrome" => [#dee2e6, #495057]


// Override with custom colors if manual palette is selected
[UpCol, DnCol]   =  switch     man
    false        => [UpC,      DnC   ]
    true         => [manUpC,   manDnC]






//         ╔═══════════════════════════════════════════════════╗          //
//         ║                 DYNAMIC FUNCTIONS                 ║          //
//         ║  COMPUTABLE FROM THE FIRST BAR OF THE TIMESERIES  ║          //
//         ╚═══════════════════════════════════════════════════╝          //



//  ╔════════════════════════════════╗  //            
//  ║            MODIFIED            ║  //                     ╔════════════════════════════════╗      
//  ║        DAMIANI VOLTMETER       ║  //                     ║ ORIGINAL FUNCTION BY: @xinolia ║    
//  ╚════════════════════════════════╝  //                     ╚════════════════════════════════╝


DV(src, vis_atr, vis_std, sed_atr, sed_std) =>
    vis_atrx  = math.min(vis_atr, bar_index+1),
    vis_stdx  = math.min(vis_std, bar_index+1),
    sed_atrx  = math.min(sed_atr, bar_index+1),
    sed_stdx  = math.min(sed_std, bar_index+1),
          vol = 0.0,
      lag_s_K = 0.5,
           s1 = nz(vol[1], 0),
           s3 = nz(vol[3], 0),
         vol := DynamicFunc.Atr(vis_atrx) / DynamicFunc.Atr(sed_atrx) + lag_s_K * (s1 - s3),
    anti_thre = DynamicFunc.dynamicStdev(src, vis_stdx) / DynamicFunc.dynamicStdev(src, sed_stdx),
           th = 1.4 - anti_thre,
          th := th - vol,
    
          -th * 100




//  ╔════════════════════════════════╗  // 
//  ║       LINEAR REGRESSION        ║  // 
//  ║          'DISPERSION'          ║  // 
//  ╚════════════════════════════════╝  // 

dispersion(period, TrSens) =>
    // Dynamic adjustment of the lookback period based on available data
    actualPeriod = math.min (period, bar_index  + 1),
      linRegLine = ta.linreg(close, actualPeriod, 0),
             tes = DynamicFunc.dynamicStdev(close - linRegLine, period)
    
    (tes - DynamicFunc.dynamicMedian(tes, TrSens)) / 2
    



//  ╔════════════════════════════════╗  // 
//  ║         LINEAR SCALING         ║  // 
//  ║            FUNCTION            ║  // 
//  ╚════════════════════════════════╝  // 

scale(x, a, b, c, d) =>
    //   Where 
    //       x = value
    //  [a, b] = old range
    //  [c, d] = new range
    c + (d - c)*(x - a) / (b - a)




//  ╔════════════════════════════════╗  // 
//  ║         NORMALIZATION          ║  // 
//  ║           FUNCTION             ║  // 
//  ╚════════════════════════════════╝  //

normalize(currentValue, targetMin, targetMax, window) =>
                    
    dynamicLen =    math.min(window,   1 + bar_index )                       
    minValue   =   ta.lowest(currentValue, dynamicLen)                      
    maxValue   =  ta.highest(currentValue, dynamicLen)                     
    minNew     =    math.min(currentValue, minValue  )                       
    maxNew     =    math.max(currentValue, maxValue  )                      
                                                                        
    output     = scale(currentValue, minNew, maxNew, targetMin, targetMax) 
    minValue  != maxValue ? nz(output) : nz(currentValue)






//              ╔════════════════════════╗              //
//              ║    CORE CALCULATIONS   ║              //
//              ╚════════════════════════╝              //



//  ╔════════════════════════════════╗  //
//  ║      CALCULATE RAW VALUES      ║  //
//  ╚════════════════════════════════╝  //
dvm = DV(close, vis_atr, vis_std, sed_atr, sed_std)
sig = (DynamicFunc.Adx(dilen, adxlen) - adxbase) * 3
dis = dispersion(period, TrSens)



//  ╔════════════════════════════════╗  //
//  ║ PREPROCESSING BY NORMALIZATION ║  //
//  ╚════════════════════════════════╝  //
dvm := normalize(dvm, -100, 100, NormSens*10)
sig := normalize(sig, -100, 100, NormSens*10)
dis := normalize(dis, -100, 100, NormSens*10)



//  ╔════════════════════════════════╗  //
//  ║     CUSTOM 'MEAN' FUNCTION     ║  //
//  ╚════════════════════════════════╝  //

// Ingore 'na' values when calculating the mean
mean(_dvm, _sig, _dis) =>
    float sum = 0
    int count = 0

    if not na(dvm)
        sum   += dvm
        count += 1
    if not na(sig)
        sum   += sig
        count += 1
    if not na(dis)
        sum   += dis
        count += 1
    count > 0 ? sum / count : 0


// Calculate the mean
av  = mean(dvm, sig, dis)



//  ╔════════════════════════════════╗  //  ╔════════════════════════════════╗  //
//  ║     HEIKIN-ASHI CALCULATION    ║  //  ║         ADDED 28/06/24         ║  //
//  ╚════════════════════════════════╝  //  ╚════════════════════════════════╝  //

// Define bar structure for Heikin Ashi method
type HA
    float o = na
    float h = na
    float l = na
    float c = na

// Function to calculate Heikin Ashi values
ha(o, h, l, c) =>
    var HA x = HA.new()
    x.c := (o + h + l + c) / 4
    x.o := na(x.o[1]) ? (o + c) / 2 : (nz(x.o[1]) + nz(x.c[1])) / 2
    x.h := math.max(h, math.max(x.o, x.c))
    x.l := math.min(l, math.min(x.o, x.c))
    x

// Calculate Heikin Ashi representation
ha = ha(
     na(av[1]) ? av : av[1], 
     math.max(av, av[1]), 
     math.min(av, av[1]), 
     av)



//  ╔════════════════════════════════╗  //
//  ║           HA WIDTH             ║  //
//  ╚════════════════════════════════╝  //

// Calculate a 'volatility' proxy (HA candle size)
volatility            = math.abs(ha.c - ha.o)
Hisotrical_Volatility = ta.sma(volatility, Vol_lookback)






//              ╔══════════════════════════════╗              //
//              ║        VISUALIZATION         ║              //
//              ╚══════════════════════════════╝              //



//  ╔════════════════════════════════╗  //
//  ║           COLORING             ║  //
//  ╚════════════════════════════════╝  //

// Determine color based on selected type
color col = switch display
    "Crosses"      => av > 0 ? av > av[1] ? UpCol : DnCol : av < 0 ? av < av[1] ? color.gray : color.new(color.gray, 50) : na
    "Histogram"    => av > 0 ? av > av[1] ? UpCol : DnCol : av < 0 ? av < av[1] ? color.gray : color.new(color.gray, 50) : na       
    "Heikin-Ashi"  => ha.c   > ha.o       ? UpCol : DnCol
    "HA-Width"     => volatility  < Hisotrical_Volatility ? color.gray : ha.c > ha.o ? UpCol : DnCol



//  ╔════════════════════════════════╗  //
//  ║            DISPLAY             ║  //
//  ╚════════════════════════════════╝  //

// Display Variant
disp = switch display
    "Crosses"   => plot.style_cross
    "Histogram" => plot.style_histogram


// Plot the Momentum as HA
plotcandle(display == "Heikin-Ashi"? ha.o : na, ha.h, ha.l, ha.c, "HA Volatility Momentum", 
 Hollow ? ha.c > ha.o ? na : ha.c < ha.o? na : col : col, col, bordercolor = col, display = display.none + display.pane + display.price_scale)

// Main Plots
pav = plot(av, "Average Volatility", col,  3, disp,                               display =   compress  ? display.none : display == "Crosses" or 
                                                                                  display == "Histogram"? display.all  : display.none)
p0  = plot(0,           "Zero Line", color.white, 1,                            display =   compress  ? display.none : display.all)

// Fill Effect
fill(p0, pav, av, 0, color.new (col, 70), color.new(chart.bg_color, 90), display = compress? display.none : display == "HA-Width"? display.none : display.all) 

// Heikin Ashi Volatility
plot(volatility,              "HA Volatility Width", volatility < Hisotrical_Volatility ? color.gray :
                                                     ha.c > ha.o ? UpCol : DnCol, style = plot.style_histogram,  display =   compress ? display.none :
                                                                                                                 display == "HA-Width"? display.all  : display.none)
plot(Hisotrical_Volatility,   "Average HA Volatility",  color.new(color.gray, 15), 3,                          display =   compress ? display.none :
                                                                                                                 display == "HA-Width"? display.all  : display.none)

// Bar Color
barcolor(BCol ? col : na)






//              ╔══════════════════════════════╗              //
//              ║     USER ALERT CONDITIONS    ║              //
//              ╚══════════════════════════════╝              //

// Define the volatility conditions
volatile = av > 0
muted    = av < 0

var symbol = "Scalper's Volatility Filter [Quantra] >>> {{exchange}}:{{ticker}}"

alertcondition(ta.change(volatile), "Volatility Shift", symbol + " - Volatility Shift!")






//              ╔══════════════════════════════╗              //
//              ║    COMPRESSED SIGNAL MODE    ║              //
//              ╚══════════════════════════════╝              //

// Signal Line
plot(0, "Signal", col, 5, display = compress and Volatil_B ? display.all : display.none)

// Plot Labels
label S = na
if compress and labels and Volatil_B
    S := label.new(bar_index+ 5, 0, "Volatility", style = label.style_label_left, color = chart.fg_color, textcolor = chart.bg_color)

// Clean up labels
a_labels = array.from(S[1])
if array.size(a_labels) > 0
    for i = 0 to array.size(a_labels) - 1
        label.delete(array.get(a_labels, i))

