//@version=6
indicator("FVG + Liquidity Sweep + CISD [PAC Method Exact]", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

// --- Settings ---
fvgTimeframe = input.timeframe("15", "HTF FVG Timeframe")
volMult       = input.float(0.5, "FVG Volatility Threshold", minval = 0.0, step = 0.1)
maxFvgLength = input.int(20, "Max FVG Extension (Bars)", minval = 1)
lookback     = input.int(20, "Liquidity Lookback", minval = 2)
bullColor    = #089981
bearColor    = #f23645
liqBuyColor  = #f23645 // PAC Style: Red for Buyside Sweep
liqSellColor = #2196f3 // PAC Style: Blue for Sellside Sweep
textColor    = chart.fg_color

// --- HTF FVG Management ---
type FvgData
    box   id
    float top
    float bot
    bool  isBull
    bool  mitigated
    int   startBar

var activeFvgs = array.new<FvgData>(0)

[h, l, h2, l2, htfAtr] = request.security(syminfo.tickerid, fvgTimeframe, [high, low, high[2], low[2], ta.atr(14)], lookahead = barmerge.lookahead_on)

if ta.change(time(fvgTimeframe)) != 0
    float gapSizeBear = l2 - h
    float gapSizeBull = l - h2
    if gapSizeBear > (htfAtr * volMult)
        box b = box.new(bar_index, l2, bar_index + 1, h, bgcolor = color.new(bearColor, 92), border_color = na)
        array.push(activeFvgs, FvgData.new(b, l2, h, false, false, bar_index))
    else if gapSizeBull > (htfAtr * volMult)
        box b = box.new(bar_index, l, bar_index + 1, h2, bgcolor = color.new(bullColor, 92), border_color = na)
        array.push(activeFvgs, FvgData.new(b, l, h2, true, false, bar_index))

FvgData currentFvg = na
if array.size(activeFvgs) > 0
    for i = array.size(activeFvgs) - 1 to 0
        FvgData fvg = array.get(activeFvgs, i)
        if not fvg.mitigated
            int targetRight = fvg.startBar + maxFvgLength
            box.set_right(fvg.id, math.min(bar_index, targetRight))
            if (fvg.isBull and close < fvg.bot) or (not fvg.isBull and close > fvg.top) or (bar_index >= targetRight)
                fvg.mitigated := true
            else
                currentFvg := fvg

bool inHtfFvg = not na(currentFvg) and high >= currentFvg.bot and low <= currentFvg.top

// --- Liquidity Logic ---
hi = ta.highest(high, lookback)
lo = ta.lowest(low, lookback)

bool buysideSweep = inHtfFvg and not currentFvg.isBull and high > hi[1] and close < hi[1]
bool sellsideSweep = inHtfFvg and currentFvg.isBull and low < lo[1] and close > lo[1]

var bool sweepActive = false
var float sweepTriggerPrice = na
var bool isBearishSetup = false

// PAC Internal Method: Box centered on bar index N, spanning n-1 to n+1
if buysideSweep
    sweepActive := true
    sweepTriggerPrice := low
    isBearishSetup := true
    box.new(bar_index - 1, high, bar_index + 1, hi[1], bgcolor = color.new(liqBuyColor, 80), border_color = na)

if sellsideSweep
    sweepActive := true
    sweepTriggerPrice := high
    isBearishSetup := false
    box.new(bar_index - 1, lo[1], bar_index + 1, low, bgcolor = color.new(liqSellColor, 80), border_color = na)

// --- CISD Logic ---
var bool cisdWaitingForFvg = false
if sweepActive
    if isBearishSetup and close < sweepTriggerPrice
        sweepActive := false
        cisdWaitingForFvg := true
        line.new(bar_index - 3, sweepTriggerPrice, bar_index, sweepTriggerPrice, style = line.style_dotted, color = textColor)
        label.new(bar_index - 1, sweepTriggerPrice, "CISD", color = #00000000, textcolor = textColor, style = label.style_label_down, size = size.tiny)
    else if not isBearishSetup and close > sweepTriggerPrice
        sweepActive := false
        cisdWaitingForFvg := true
        line.new(bar_index - 3, sweepTriggerPrice, bar_index, sweepTriggerPrice, style = line.style_dotted, color = textColor)
        label.new(bar_index - 1, sweepTriggerPrice, "CISD", color = #00000000, textcolor = textColor, style = label.style_label_up, size = size.tiny)

// --- Local FVG (Entry) ---
bool localBearFvg = low[2] > high[0] and close[1] < low[2]
bool localBullFvg = high[2] < low[0] and close[1] > high[2]

if cisdWaitingForFvg
    if isBearishSetup and localBearFvg
        box.new(bar_index - 2, low[2], bar_index, high[0], bgcolor = color.new(bearColor, 70), border_color = na)
        label.new(bar_index, high, text = "", color = bearColor, style = label.style_triangledown, yloc = yloc.abovebar, size = size.tiny)
        cisdWaitingForFvg := false 
    else if not isBearishSetup and localBullFvg
        box.new(bar_index - 2, high[2], bar_index, low[0], bgcolor = color.new(bullColor, 70), border_color = na)
        label.new(bar_index, low, text = "", color = bullColor, style = label.style_triangleup, yloc = yloc.belowbar, size = size.tiny)
        cisdWaitingForFvg := false 

if array.size(activeFvgs) > 50
    FvgData old = array.shift(activeFvgs)
    box.delete(old.id)
