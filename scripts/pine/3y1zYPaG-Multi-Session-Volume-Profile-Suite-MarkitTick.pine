indicator("Multi-Session Volume Profile Suite [MarkitTick]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// =============================================================================
// 1. NAMED CONSTANTS
// =============================================================================
float INITIAL_LOW_SENTINEL  = 1e12
int   MAX_SAFETY_ITERATIONS = 1000
int   MAX_LOOKBACK_CAP      = 50

// =============================================================================
// 2. INPUTS - Grouped by Functionality
// =============================================================================

string G_SETTINGS = "--- General Settings ---"
string G_THEME    = "--- Visual Theme ---"
string G_ALERTS   = "--- Alerts ---"
string G_SCOPE    = "--- Profile Scope ---"
string G_PIVOTS   = "--- Pivots (PDH/PMH/NYM) ---"
string G_CONF     = "--- Confluence (Box Overlap) ---"

string G_C_DAILY  = "--- Custom: Daily Settings ---"
string G_C_WEEK   = "--- Custom: Weekly Settings ---"
string G_C_MONTH  = "--- Custom: Monthly Settings ---"
string G_C_SESS   = "--- Custom: Session Settings ---"

string i_calcTF   = input.timeframe("", "Calculation Timeframe", group = G_SETTINGS, tooltip = "Leave empty to use Chart Timeframe.")
int    i_rowSize  = input.int(24, "Row Resolution", minval = 10, maxval = 500, group = G_SETTINGS)
float  i_vaPct    = input.float(70.0, "Value Area %", minval = 0.0, maxval = 100.0, group = G_SETTINGS)
bool   i_showText = input.bool(true, "Show Labels", group = G_SETTINGS)
bool   i_showShift= input.bool(true, "Show POC Shift", group = G_SETTINGS)
bool   i_extend   = input.bool(false, "Extend Profile Lines", group = G_SETTINGS)

string i_theme    = input.string("Custom", "Color Theme", options = ["Pro Dark", "Pro Light", "Midnight", "Custom"], group = G_THEME)

color  i_dcPoc    = input.color(#ffeb3b, "POC Color", group = G_C_DAILY)
color  i_dcVa     = input.color(#fbc02d, "VA Color", group = G_C_DAILY)
color  i_dcBg     = input.color(color.new(#ffeb3b, 85), "VA Background", group = G_C_DAILY)
string i_dsPoc    = input.string(line.style_solid, "POC Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_DAILY)
string i_dsVa     = input.string(line.style_dotted, "VA Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_DAILY)
int    i_dwPoc    = input.int(2, "POC Width", group = G_C_DAILY)
int    i_dwVa     = input.int(1, "VA Width", group = G_C_DAILY)

color  i_wcPoc    = input.color(#2962ff, "POC Color", group = G_C_WEEK)
color  i_wcVa     = input.color(#448aff, "VA Color", group = G_C_WEEK)
color  i_wcBg     = input.color(color.new(#2962ff, 85), "VA Background", group = G_C_WEEK)
string i_wsPoc    = input.string(line.style_solid, "POC Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_WEEK)
string i_wsVa     = input.string(line.style_dashed, "VA Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_WEEK)
int    i_wwPoc    = input.int(2, "POC Width", group = G_C_WEEK)
int    i_wwVa     = input.int(1, "VA Width", group = G_C_WEEK)

color  i_mcPoc    = input.color(#e040fb, "POC Color", group = G_C_MONTH)
color  i_mcVa     = input.color(#ea80fc, "VA Color", group = G_C_MONTH)
color  i_mcBg     = input.color(color.new(#e040fb, 85), "VA Background", group = G_C_MONTH)
string i_msPoc    = input.string(line.style_solid, "POC Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_MONTH)
string i_msVa     = input.string(line.style_dashed, "VA Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_MONTH)
int    i_mwPoc    = input.int(2, "POC Width", group = G_C_MONTH)
int    i_mwVa     = input.int(1, "VA Width", group = G_C_MONTH)

color  i_scPoc    = input.color(#00e5ff, "POC Color", group = G_C_SESS)
color  i_scVa     = input.color(#18ffff, "VA Color", group = G_C_SESS)
color  i_scBg     = input.color(color.new(#00e5ff, 85), "VA Background", group = G_C_SESS)
string i_ssPoc    = input.string(line.style_solid, "POC Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_SESS)
string i_ssVa     = input.string(line.style_dotted, "VA Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = G_C_SESS)
int    i_swPoc    = input.int(2, "POC Width", group = G_C_SESS)
int    i_swVa     = input.int(1, "VA Width", group = G_C_SESS)
bool   i_sessBlk  = input.bool(true, "Show Session Block Label", group = G_C_SESS)

bool   i_showD    = input.bool(true, "Daily Profile", group = G_SCOPE)
int    i_lookD    = input.int(0, "Daily Lookback (Days)", minval = 0, maxval = MAX_LOOKBACK_CAP, group = G_SCOPE, tooltip = "Max 50 to prevent object limit errors.")

bool   i_showW    = input.bool(true, "Weekly Profile", group = G_SCOPE)
int    i_lookW    = input.int(0, "Weekly Lookback (Weeks)", minval = 0, maxval = MAX_LOOKBACK_CAP, group = G_SCOPE, tooltip = "Max 50 to prevent object limit errors.")

bool   i_showM    = input.bool(true, "Monthly Profile", group = G_SCOPE)
int    i_lookM    = input.int(0, "Monthly Lookback (Months)", minval = 0, maxval = MAX_LOOKBACK_CAP, group = G_SCOPE, tooltip = "Max 50 to prevent object limit errors.")

bool   i_showS1   = input.bool(false, "Show Session 1", group = G_SCOPE)
string i_sessStr1 = input.session("0300-1100", "Session 1 Time", group = G_SCOPE)
bool   i_showS2   = input.bool(false, "Show Session 2", group = G_SCOPE)
string i_sessStr2 = input.session("0930-1600", "Session 2 Time", group = G_SCOPE)
bool   i_showS3   = input.bool(false, "Show Session 3", group = G_SCOPE)
string i_sessStr3 = input.session("1800-0200", "Session 3 Time", group = G_SCOPE)
int    i_lookS    = input.int(0, "Session Lookback (Days)", minval = 0, maxval = MAX_LOOKBACK_CAP, group = G_SCOPE, tooltip = "Max 50 to prevent object limit errors.")

int    i_weekStart= input.int(2, "Start of Week (1=Sun, 2=Mon)", options = [1, 2, 3, 4, 5, 6, 7], group = G_SCOPE)

bool   i_showPiv  = input.bool(false, "Show Pivots (High/Low)", group = G_PIVOTS)
bool   i_extendPiv= input.bool(true, "Extend Pivot Lines", group = G_PIVOTS)
bool   i_showNYM  = input.bool(false, "Show NY Midnight", group = G_PIVOTS)
color  i_cPivD    = input.color(color.orange, "Daily Pivot Color", group = G_PIVOTS)
color  i_cPivW    = input.color(color.green, "Weekly Pivot Color", group = G_PIVOTS)
color  i_cPivM    = input.color(color.red, "Monthly Pivot Color", group = G_PIVOTS)
color  i_cNYM     = input.color(color.white, "NY Midnight Color", group = G_PIVOTS)

bool   i_useAlerts= input.bool(true, "Enable Crossing Alerts", group = G_ALERTS)
int    i_alertDist= input.int(5, "Approach Distance (Ticks)", minval = 1, group = G_ALERTS)

bool   i_showConf = input.bool(true, "Show POC Overlap Labels", group = G_CONF)
color  i_confColor= input.color(color.new(color.yellow, 0), "Confluence Label Color", group = G_CONF)
bool   i_debugMode= input.bool(true, "Show Overlap Debug Info", group = G_CONF)

// =============================================================================
// 3. SYNTHETIC CHART GUARD (Anti-Repainting)
// =============================================================================
if syminfo.type == "heikinashi" or syminfo.type == "renko" or syminfo.type == "kagi" or syminfo.type == "pb" or syminfo.type == "linebreak"
    runtime.error("This indicator is designed for standard OHLC candles only to prevent repainting. Please switch away from Heikin Ashi/Renko/etc.")

// =============================================================================
// 4. UDT DEFINITIONS & METHODS
// =============================================================================

type VPRender
    int   t
    line  lPoc
    line  lVah
    line  lVal
    label lbPoc
    box   bVa
    label lbBlk

type VolumeProfile
    array<float>    rawVol
    array<float>    rawLow
    array<float>    rawHigh
    array<float>    binVols
    array<VPRender> renders

    float sessionHigh
    float sessionLow
    float totalVolume
    float maxSlotVol

    float pocPrice
    float pocHigh
    float pocLow
    float vahPrice
    float valPrice
    float prevPocPrice

    int   pocIdx
    int   startIndex
    int   endIndex

    color  cPoc
    color  cVa
    color  cBg
    string stPoc
    string stVa
    int    wdPoc
    int    wdVa

    label  lblPoc
    bool   inSession

    line   live_lPoc
    line   live_lVah
    line   live_lVal
    box    live_bVa
    label  live_lblPoc
    label  live_lblBlk


method init(VolumeProfile this, int rows, color cPoc, color cVa, color cBg, string stPoc, string stVa, int wdPoc, int wdVa) =>
    this.rawVol       := array.new<float>()
    this.rawLow       := array.new<float>()
    this.rawHigh      := array.new<float>()
    this.binVols      := array.new<float>(rows, 0.0)
    this.renders      := array.new<VPRender>()
    this.sessionHigh  := high
    this.sessionLow   := low
    this.totalVolume  := 0.0
    this.prevPocPrice := na
    this.pocPrice     := na
    this.cPoc         := cPoc
    this.cVa          := cVa
    this.cBg          := cBg
    this.stPoc        := stPoc
    this.stVa         := stVa
    this.wdPoc        := wdPoc
    this.wdVa         := wdVa
    this.inSession    := false
    this.live_lPoc    := na
    this.live_lVah    := na
    this.live_lVal    := na
    this.live_bVa     := na
    this.live_lblPoc  := na
    this.live_lblBlk  := na


method reset(VolumeProfile this, int newStartIndex) =>
    this.prevPocPrice := this.pocPrice
    this.rawVol.clear()
    this.rawLow.clear()
    this.rawHigh.clear()
    this.binVols.fill(0.0)
    this.totalVolume := 0.0
    this.maxSlotVol  := 0.0
    this.sessionHigh := high
    this.sessionLow  := low
    this.startIndex  := newStartIndex
    if barstate.isrealtime
        line.delete(this.live_lPoc)
        line.delete(this.live_lVah)
        line.delete(this.live_lVal)
        box.delete(this.live_bVa)
        label.delete(this.live_lblPoc)
        label.delete(this.live_lblBlk)
    this.live_lPoc   := na
    this.live_lVah   := na
    this.live_lVal   := na
    this.live_bVa    := na
    this.live_lblPoc := na
    this.live_lblBlk := na


method addData(VolumeProfile this, float vol, float lo, float hi) =>
    if vol > 0
        this.rawVol.push(vol)
        this.rawLow.push(lo)
        this.rawHigh.push(hi)
        this.sessionHigh := math.max(this.sessionHigh, hi)
        this.sessionLow  := math.min(this.sessionLow, lo)


method calculate(VolumeProfile this, int rows, float vaPct) =>
    int dataSize = this.rawVol.size()

    if dataSize > 0
        float sHigh     = this.sessionHigh
        float sLow      = this.sessionLow
        float rangeSize = sHigh - sLow

        if rangeSize > 0
            float slotSize = rangeSize / rows
            float invRange = rows / rangeSize
            int   maxIdx   = rows - 1
            float halfSlot = slotSize * 0.5

            this.binVols.fill(0.0)

            for i = 0 to dataSize - 1
                float dVol = this.rawVol.get(i)
                float dLo  = this.rawLow.get(i)
                float dHi  = this.rawHigh.get(i)
                float dRng = dHi - dLo

                int idxStart = int(math.min(maxIdx, math.max(0, math.floor((dLo - sLow) * invRange))))
                int idxEnd   = int(math.min(maxIdx, math.floor((dHi - sLow) * invRange)))

                if idxStart <= idxEnd
                    if dRng <= 0
                        float currentVal = this.binVols.get(idxStart)
                        this.binVols.set(idxStart, currentVal + dVol)
                    else
                        float volPerPrice = dVol / dRng
                        for j = idxStart to idxEnd
                            float binTop    = sLow + (slotSize * (j + 1))
                            float binBottom = sLow + (slotSize * j)
                            float overlap   = math.min(dHi, binTop) - math.max(dLo, binBottom)
                            if overlap > 0
                                float currentVal = this.binVols.get(j)
                                this.binVols.set(j, currentVal + (volPerPrice * overlap))

            float maxV = 0.0
            int   pIdx = 0
            float tot  = 0.0

            for k = 0 to rows - 1
                float slotVol = this.binVols.get(k)
                tot += slotVol
                if slotVol > maxV
                    maxV := slotVol
                    pIdx := k

            this.totalVolume := tot
            this.maxSlotVol  := maxV
            this.pocIdx      := pIdx
            this.pocPrice    := sLow + (pIdx * slotSize) + halfSlot
            this.pocHigh     := sLow + (slotSize * (pIdx + 1))
            this.pocLow      := sLow + (slotSize * pIdx)

            float targetVaVol  = tot * (vaPct / 100.0)
            float currentVaVol = maxV
            int   vaTopIdx     = pIdx
            int   vaBotIdx     = pIdx
            int   safetyCount  = 0

            while currentVaVol < targetVaVol
                safetyCount += 1
                if safetyCount > MAX_SAFETY_ITERATIONS
                    break
                if vaTopIdx >= maxIdx and vaBotIdx <= 0
                    break

                float volAbove = vaTopIdx < maxIdx ? this.binVols.get(vaTopIdx + 1) : 0.0
                float volBelow = vaBotIdx > 0 ? this.binVols.get(vaBotIdx - 1) : 0.0

                if volAbove >= volBelow
                    if vaTopIdx < maxIdx
                        vaTopIdx     += 1
                        currentVaVol += volAbove
                    else if vaBotIdx > 0
                        vaBotIdx     -= 1
                        currentVaVol += volBelow
                else
                    if vaBotIdx > 0
                        vaBotIdx     -= 1
                        currentVaVol += volBelow
                    else if vaTopIdx < maxIdx
                        vaTopIdx     += 1
                        currentVaVol += volAbove

            this.vahPrice := sLow + ((vaTopIdx + 1) * slotSize)
            this.valPrice := sLow + (vaBotIdx * slotSize)
        else
            this.pocPrice    := sLow
            this.pocHigh     := sLow
            this.pocLow      := sLow
            this.vahPrice    := sLow
            this.valPrice    := sLow
            this.totalVolume := 0.0
            for i = 0 to dataSize - 1
                this.totalVolume += this.rawVol.get(i)


method draw(VolumeProfile this, string typeStr, bool isLive, bool showShift, bool extendLines, bool showBlock) =>
    if isLive
        line.delete(this.live_lPoc)
        line.delete(this.live_lVah)
        line.delete(this.live_lVal)
        box.delete(this.live_bVa)
        label.delete(this.live_lblPoc)
        label.delete(this.live_lblBlk)

    int    endIdx   = this.endIndex
    int    startIdx = this.startIndex
    string extStr   = extendLines ? extend.right : extend.none

    line  lP  = na
    line  lVh = na
    line  lVl = na
    box   bV  = na
    label lbP = na
    label lbB = na

    if not na(this.pocPrice)
        lP := line.new(startIdx, this.pocPrice, endIdx, this.pocPrice, color = this.cPoc, width = this.wdPoc, style = this.stPoc, extend = extStr)
        if not na(this.vahPrice) and not na(this.valPrice)
            lVh := line.new(startIdx, this.vahPrice, endIdx, this.vahPrice, color = this.cVa, width = this.wdVa, style = this.stVa, extend = extStr)
            lVl := line.new(startIdx, this.valPrice, endIdx, this.valPrice, color = this.cVa, width = this.wdVa, style = this.stVa, extend = extStr)
            if not extendLines
                bV := box.new(startIdx, this.vahPrice, endIdx, this.valPrice, border_width = 0, bgcolor = this.cBg)

        if i_showText and barstate.islast
            string labelTxt = typeStr + "-POC: " + str.tostring(this.pocPrice, format.mintick)
            if showShift and not na(this.prevPocPrice)
                float  diff  = this.pocPrice - this.prevPocPrice
                string arrow = diff > 0 ? "▲" : (diff < 0 ? "▼" : "=")
                labelTxt    := labelTxt + "\n(" + arrow + " " + str.tostring(math.abs(diff), format.mintick) + ")"

            lbP := label.new(endIdx + 5, this.pocPrice, labelTxt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = this.cPoc, size = size.small)
            this.lblPoc := lbP

    if showBlock
        lbB := label.new(x = int(math.avg(startIdx, endIdx)), y = high + syminfo.mintick * 10, text = "⬛", yloc = yloc.abovebar, color = color.new(color.white, 100), textcolor = this.cPoc, size = size.small)

    if not isLive
        this.renders.push(VPRender.new(time[bar_index - startIdx], lP, lVh, lVl, lbP, bV, lbB))
    else
        this.live_lPoc   := lP
        this.live_lVah   := lVh
        this.live_lVal   := lVl
        this.live_bVa    := bV
        this.live_lblPoc := lbP
        this.live_lblBlk := lbB
        na


method clean(VolumeProfile this, int maxCount) =>
    while this.renders.size() > maxCount
        VPRender r = this.renders.shift()
        line.delete(r.lPoc)
        line.delete(r.lVah)
        line.delete(r.lVal)
        box.delete(r.bVa)
        label.delete(r.lbPoc)
        label.delete(r.lbBlk)


method update(VolumeProfile this, bool isActive, bool isNewPeriod, bool newData, float vol, float lo, float hi, int rowSz, float iVa, bool showSh, bool ext, bool blk, int lookCnt, string txtTag) =>
    if isActive
        if isNewPeriod
            this.endIndex := bar_index - 1
            if this.rawVol.size() > 0
                this.calculate(rowSz, iVa)
                this.draw(txtTag, false, showSh, ext, blk)
            this.reset(bar_index)
            this.clean(lookCnt)

        if newData
            this.addData(vol, lo, hi)

        if barstate.islast
            this.endIndex := bar_index
            this.calculate(rowSz, iVa)
            this.draw(txtTag, true, showSh, ext, blk)

// =============================================================================
// 5. THEME INITIALIZATION
// =============================================================================

var color t_dPoc = i_theme == "Custom" ? i_dcPoc : i_theme == "Pro Dark" ? #ffeb3b : i_theme == "Pro Light" ? #f57f17 : color.white
var color t_dVa  = i_theme == "Custom" ? i_dcVa  : i_theme == "Pro Dark" ? #fbc02d : i_theme == "Pro Light" ? #f9a825 : color.silver
var color t_dBg  = i_theme == "Custom" ? i_dcBg  : i_theme == "Pro Dark" ? color.new(#ffeb3b, 85) : i_theme == "Pro Light" ? color.new(#f57f17, 80) : color.new(color.gray, 92)

var color t_wPoc = i_theme == "Custom" ? i_wcPoc : i_theme == "Pro Dark" ? #2962ff : i_theme == "Pro Light" ? #0d47a1 : color.white
var color t_wVa  = i_theme == "Custom" ? i_wcVa  : i_theme == "Pro Dark" ? #448aff : i_theme == "Pro Light" ? #1565c0 : color.silver
var color t_wBg  = i_theme == "Custom" ? i_wcBg  : i_theme == "Pro Dark" ? color.new(#2962ff, 85) : i_theme == "Pro Light" ? color.new(#0d47a1, 80) : color.new(color.gray, 92)

var color t_mPoc = i_theme == "Custom" ? i_mcPoc : i_theme == "Pro Dark" ? #e040fb : i_theme == "Pro Light" ? #aa00ff : color.white
var color t_mVa  = i_theme == "Custom" ? i_mcVa  : i_theme == "Pro Dark" ? #ea80fc : i_theme == "Pro Light" ? #d500f9 : color.silver
var color t_mBg  = i_theme == "Custom" ? i_mcBg  : i_theme == "Pro Dark" ? color.new(#e040fb, 85) : i_theme == "Pro Light" ? color.new(#aa00ff, 80) : color.new(color.gray, 92)

var color t_sPoc = i_theme == "Custom" ? i_scPoc : i_theme == "Pro Dark" ? #00e5ff : i_theme == "Pro Light" ? #006064 : color.white
var color t_sVa  = i_theme == "Custom" ? i_scVa  : i_theme == "Pro Dark" ? #18ffff : i_theme == "Pro Light" ? #0097a7 : color.silver
var color t_sBg  = i_theme == "Custom" ? i_scBg  : i_theme == "Pro Dark" ? color.new(#00e5ff, 85) : i_theme == "Pro Light" ? color.new(#006064, 80) : color.new(color.gray, 92)

var string s_dPoc = i_theme == "Custom" ? i_dsPoc : line.style_solid
var string s_dVa  = i_theme == "Custom" ? i_dsVa  : line.style_dotted
var int    w_dPoc = i_theme == "Custom" ? i_dwPoc : 2
var int    w_dVa  = i_theme == "Custom" ? i_dwVa  : 1

var string s_wPoc = i_theme == "Custom" ? i_wsPoc : line.style_solid
var string s_wVa  = i_theme == "Custom" ? i_wsVa  : line.style_dashed
var int    w_wPoc = i_theme == "Custom" ? i_wwPoc : 2
var int    w_wVa  = i_theme == "Custom" ? i_wwVa  : 1

var string s_mPoc = i_theme == "Custom" ? i_msPoc : line.style_solid
var string s_mVa  = i_theme == "Custom" ? i_msVa  : line.style_dashed
var int    w_mPoc = i_theme == "Custom" ? i_mwPoc : 2
var int    w_mVa  = i_theme == "Custom" ? i_mwVa  : 1

var string s_sPoc = i_theme == "Custom" ? i_ssPoc : line.style_solid
var string s_sVa  = i_theme == "Custom" ? i_ssVa  : line.style_dotted
var int    w_sPoc = i_theme == "Custom" ? i_swPoc : 2
var int    w_sVa  = i_theme == "Custom" ? i_swVa  : 1

// =============================================================================
// 6. INSTANCE SETUP
// =============================================================================

var VolumeProfile dailyVP   = VolumeProfile.new()
var VolumeProfile weeklyVP  = VolumeProfile.new()
var VolumeProfile monthlyVP = VolumeProfile.new()
var VolumeProfile sess1VP   = VolumeProfile.new()
var VolumeProfile sess2VP   = VolumeProfile.new()
var VolumeProfile sess3VP   = VolumeProfile.new()

if bar_index == 0
    dailyVP.init(i_rowSize, t_dPoc, t_dVa, t_dBg, s_dPoc, s_dVa, w_dPoc, w_dVa)
    weeklyVP.init(i_rowSize, t_wPoc, t_wVa, t_wBg, s_wPoc, s_wVa, w_wPoc, w_wVa)
    monthlyVP.init(i_rowSize, t_mPoc, t_mVa, t_mBg, s_mPoc, s_mVa, w_mPoc, w_mVa)
    sess1VP.init(i_rowSize, t_sPoc, t_sVa, t_sBg, s_sPoc, s_sVa, w_sPoc, w_sVa)
    sess2VP.init(i_rowSize, t_sPoc, t_sVa, t_sBg, s_sPoc, s_sVa, w_sPoc, w_sVa)
    sess3VP.init(i_rowSize, t_sPoc, t_sVa, t_sBg, s_sPoc, s_sVa, w_sPoc, w_sVa)
    dailyVP.startIndex   := 0
    weeklyVP.startIndex  := 0
    monthlyVP.startIndex := 0
    sess1VP.startIndex   := 0
    sess2VP.startIndex   := 0
    sess3VP.startIndex   := 0

// =============================================================================
// 7. DATA FEED & PROCESSING
// =============================================================================

bool isNewDay   = ta.change(time("D")) != 0
bool isNewMonth = ta.change(time("M")) != 0
int  dayNum     = dayofweek
bool isStartDay = dayNum == i_weekStart
bool isNewWeek  = isNewDay and isStartDay

bool s1_In  = not na(time(timeframe.period, i_sessStr1))
bool s1_New = s1_In and not s1_In[1]

bool s2_In  = not na(time(timeframe.period, i_sessStr2))
bool s2_New = s2_In and not s2_In[1]

bool s3_In  = not na(time(timeframe.period, i_sessStr3))
bool s3_New = s3_In and not s3_In[1]

bool  useChartTF    = (i_calcTF == "")
float d_vol         = na
float d_low         = na
float d_high        = na
bool  newDataTrigger= false

if useChartTF
    d_vol := volume
    d_low := low
    d_high:= high
    newDataTrigger := true
else
    [secVol, secLo, secHi, secTime] = request.security(syminfo.tickerid, i_calcTF, [volume, low, high, time], lookahead = barmerge.lookahead_off)
    newDataTrigger := ta.change(secTime) != 0
    d_vol := secVol[1]
    d_low := secLo[1]
    d_high:= secHi[1]

dailyVP.update(i_showD, isNewDay, newDataTrigger, d_vol, d_low, d_high, i_rowSize, i_vaPct, i_showShift, i_extend, false, i_lookD, "D")

weeklyVP.update(i_showW, isNewWeek, newDataTrigger, d_vol, d_low, d_high, i_rowSize, i_vaPct, i_showShift, i_extend, false, i_lookW, "W")

monthlyVP.update(i_showM, isNewMonth, newDataTrigger, d_vol, d_low, d_high, i_rowSize, i_vaPct, i_showShift, i_extend, false, i_lookM, "M")

if i_showS1
    sess1VP.update(true, s1_New, s1_In and newDataTrigger, d_vol, d_low, d_high, i_rowSize, i_vaPct, i_showShift, i_extend, i_sessBlk, i_lookS, "S1")
if i_showS2
    sess2VP.update(true, s2_New, s2_In and newDataTrigger, d_vol, d_low, d_high, i_rowSize, i_vaPct, i_showShift, i_extend, i_sessBlk, i_lookS, "S2")
if i_showS3
    sess3VP.update(true, s3_New, s3_In and newDataTrigger, d_vol, d_low, d_high, i_rowSize, i_vaPct, i_showShift, i_extend, i_sessBlk, i_lookS, "S3")

// =============================================================================
// 8. PIVOT DASHBOARD (PDH/PDL/PWH/PWL/PMH/PML/NYM)
// =============================================================================

var float curD_H  = 0.0
var int   curD_Ht = 0
var float curD_L  = INITIAL_LOW_SENTINEL
var int   curD_Lt = 0
var float curW_H  = 0.0
var int   curW_Ht = 0
var float curW_L  = INITIAL_LOW_SENTINEL
var int   curW_Lt = 0
var float curM_H  = 0.0
var int   curM_Ht = 0
var float curM_L  = INITIAL_LOW_SENTINEL
var int   curM_Lt = 0

if isNewDay
    curD_H := high
    curD_Ht := time
    curD_L := low
    curD_Lt := time
else
    if high > curD_H
        curD_H := high
        curD_Ht := time
    if low < curD_L
        curD_L := low
        curD_Lt := time

if isNewWeek
    curW_H := high
    curW_Ht := time
    curW_L := low
    curW_Lt := time
else
    if high > curW_H
        curW_H := high
        curW_Ht := time
    if low < curW_L
        curW_L := low
        curW_Lt := time

if isNewMonth
    curM_H := high
    curM_Ht := time
    curM_L := low
    curM_Lt := time
else
    if high > curM_H
        curM_H := high
        curM_Ht := time
    if low < curM_L
        curM_L := low
        curM_Lt := time

var array<float> a_pdh_p = array.new<float>()
var array<int>   a_pdh_t = array.new<int>()
var array<float> a_pdl_p = array.new<float>()
var array<int>   a_pdl_t = array.new<int>()
var array<float> a_pwh_p = array.new<float>()
var array<int>   a_pwh_t = array.new<int>()
var array<float> a_pwl_p = array.new<float>()
var array<int>   a_pwl_t = array.new<int>()
var array<float> a_pmh_p = array.new<float>()
var array<int>   a_pmh_t = array.new<int>()
var array<float> a_pml_p = array.new<float>()
var array<int>   a_pml_t = array.new<int>()
var array<float> a_nym_p = array.new<float>()
var array<int>   a_nym_t = array.new<int>()
var array<line>  a_lines = array.new<line>()
var array<label> a_labels= array.new<label>()


method pushPivot(array<float> pArr, array<int> tArr, float p, int t, int maxLen) =>
    pArr.unshift(p)
    tArr.unshift(t)
    if pArr.size() > maxLen
        pArr.pop()
        tArr.pop()


method drawHistSimple(array<float> prices, array<int> times, color baseCol, string txt, int limit, string styleStr, bool extendP) =>
    string ext = extendP ? extend.right : extend.none
    int sz = prices.size()
    if sz > 0
        int loopLim = math.min(sz, limit)
        for i = 0 to loopLim - 1
            float transp = 0.0 + (i * (80.0 / math.max(1, limit)))
            color renderCol = color.new(baseCol, transp)
            line l = line.new(times.get(i), prices.get(i), time, prices.get(i), xloc = xloc.bar_time, color = renderCol, style = styleStr, width = 1, extend = ext)
            label lb = label.new(time, prices.get(i), txt + "-" + str.tostring(i + 1), xloc = xloc.bar_time, style = label.style_none, textcolor = renderCol, size = size.small)
            a_lines.push(l)
            a_labels.push(lb)

if i_showPiv
    if isNewDay
        a_pdh_p.pushPivot(a_pdh_t, curD_H[1], curD_Ht[1], i_lookD)
        a_pdl_p.pushPivot(a_pdl_t, curD_L[1], curD_Lt[1], i_lookD)

    if isNewWeek
        a_pwh_p.pushPivot(a_pwh_t, curW_H[1], curW_Ht[1], i_lookW)
        a_pwl_p.pushPivot(a_pwl_t, curW_L[1], curW_Lt[1], i_lookW)

    if isNewMonth
        a_pmh_p.pushPivot(a_pmh_t, curM_H[1], curM_Ht[1], i_lookM)
        a_pml_p.pushPivot(a_pml_t, curM_L[1], curM_Lt[1], i_lookM)

bool nyNewDay = ta.change(time("D", "America/New_York")) != 0
if i_showNYM and nyNewDay
    a_nym_p.pushPivot(a_nym_t, open, time, i_lookD)

if barstate.islast
    while a_lines.size() > 0
        line.delete(a_lines.pop())
    while a_labels.size() > 0
        label.delete(a_labels.pop())

    string sSol  = line.style_solid
    string sDash = line.style_dashed
    string sDot  = line.style_dotted

    if i_showPiv
        if i_showD
            a_pdh_p.drawHistSimple(a_pdh_t, i_cPivD, "PDH", i_lookD, sSol, i_extendPiv)
            a_pdl_p.drawHistSimple(a_pdl_t, i_cPivD, "PDL", i_lookD, sSol, i_extendPiv)

        if i_showW
            a_pwh_p.drawHistSimple(a_pwh_t, i_cPivW, "PWH", i_lookW, sDash, i_extendPiv)
            a_pwl_p.drawHistSimple(a_pwl_t, i_cPivW, "PWL", i_lookW, sDash, i_extendPiv)

        if i_showM
            a_pmh_p.drawHistSimple(a_pmh_t, i_cPivM, "PMH", i_lookM, sDot, i_extendPiv)
            a_pml_p.drawHistSimple(a_pml_t, i_cPivM, "PML", i_lookM, sDot, i_extendPiv)

    if i_showNYM and i_showD
        a_nym_p.drawHistSimple(a_nym_t, i_cNYM, "NYM", i_lookD, sDash, i_extendPiv)

// =============================================================================
// 9. CONFLUENCE DETECTION & ALERTS
// =============================================================================

var table tb = i_debugMode ? table.new(position.bottom_right, 2, 4, bgcolor = color.new(color.black, 50), border_color = color.white, border_width = 1) : na

if barstate.islast and i_showConf
    float pD = i_showD ? dailyVP.pocPrice : na
    float pW = i_showW ? weeklyVP.pocPrice : na
    float pM = i_showM ? monthlyVP.pocPrice : na

    float sD = (not na(pD) and not na(dailyVP.prevPocPrice)) ? pD - dailyVP.prevPocPrice : 0.0
    float sW = (not na(pW) and not na(weeklyVP.prevPocPrice)) ? pW - weeklyVP.prevPocPrice : 0.0
    float sM = (not na(pM) and not na(monthlyVP.prevPocPrice)) ? pM - monthlyVP.prevPocPrice : 0.0

    float dh = i_showD ? dailyVP.pocHigh : na
    float dl = i_showD ? dailyVP.pocLow : na
    float wh = i_showW ? weeklyVP.pocHigh : na
    float wl = i_showW ? weeklyVP.pocLow : na
    float mh = i_showM ? monthlyVP.pocHigh : na
    float ml = i_showM ? monthlyVP.pocLow : na

    bool o_DW = (not na(dh) and not na(wh)) and (math.max(dl, wl) <= math.min(dh, wh))
    bool o_WM = (not na(wh) and not na(mh)) and (math.max(wl, ml) <= math.min(wh, mh))
    bool o_DM = (not na(dh) and not na(mh)) and (math.max(dl, ml) <= math.min(dh, mh))

    if i_debugMode and not na(tb)
        table.cell(tb, 0, 0, "Pair", text_color = color.white, bgcolor = color.gray)
        table.cell(tb, 1, 0, "Overlapping?", text_color = color.white, bgcolor = color.gray)
        table.cell(tb, 0, 1, "D-W", text_color = color.white)
        table.cell(tb, 1, 1, o_DW ? "YES ✅" : "NO ❌", text_color = o_DW ? color.green : color.red)
        table.cell(tb, 0, 2, "W-M", text_color = color.white)
        table.cell(tb, 1, 2, o_WM ? "YES ✅" : "NO ❌", text_color = o_WM ? color.green : color.red)
        table.cell(tb, 0, 3, "D-M", text_color = color.white)
        table.cell(tb, 1, 3, o_DM ? "YES ✅" : "NO ❌", text_color = o_DM ? color.green : color.red)

    string cTxt = ""
    float  cLoc = na
    float  avgP = na
    float  avgS = na

    bool o_Trip = (not na(dh) and not na(wh) and not na(mh)) and (math.max(dl, math.max(wl, ml)) <= math.min(dh, math.min(wh, mh)))

    if o_Trip
        label.delete(dailyVP.lblPoc)
        label.delete(weeklyVP.lblPoc)
        label.delete(monthlyVP.lblPoc)
        avgP := (pD + pW + pM) / 3
        avgS := (sD + sW + sM) / 3
        cTxt := "✯ TRIPLE CONFLUENCE ✯\n(D + W + M)"
        cLoc := avgP
    else if o_DW
        label.delete(dailyVP.lblPoc)
        label.delete(weeklyVP.lblPoc)
        avgP := (pD + pW) / 2
        avgS := (sD + sW) / 2
        cTxt := "POC CONFLUENCE\n(Daily + Weekly)"
        cLoc := avgP
    else if o_WM
        label.delete(weeklyVP.lblPoc)
        label.delete(monthlyVP.lblPoc)
        avgP := (pW + pM) / 2
        avgS := (sW + sM) / 2
        cTxt := "POC CONFLUENCE\n(Weekly + Monthly)"
        cLoc := avgP
    else if o_DM
        label.delete(dailyVP.lblPoc)
        label.delete(monthlyVP.lblPoc)
        avgP := (pD + pM) / 2
        avgS := (sD + sM) / 2
        cTxt := "POC CONFLUENCE\n(Daily + Monthly)"
        cLoc := avgP

    if cTxt != ""
        cTxt := cTxt + "\nAvg POC: " + str.tostring(avgP, format.mintick)
        string arrow = avgS > 0 ? "▲" : (avgS < 0 ? "▼" : "=")
        cTxt := cTxt + "\n(Avg Shift: " + arrow + " " + str.tostring(math.abs(avgS), format.mintick) + ")"

        var label lConf = na
        label.delete(lConf)
        lConf := label.new(bar_index + 10, cLoc, cTxt, style = label.style_label_left, color = color.new(i_confColor, 20), textcolor = color.black, size = size.normal, force_overlay = true)

// =============================================================================
// 10. ALERTS
// =============================================================================

if i_useAlerts and not na(close)
    float distSq = syminfo.mintick * i_alertDist

    if i_showD and not na(dailyVP.pocPrice)
        bool inZoneNow = math.abs(close - dailyVP.pocPrice) <= distSq
        bool inZonePrev = math.abs(close[1] - dailyVP.pocPrice) <= distSq
        if inZoneNow and not inZonePrev
            alert("Price approaching Daily POC: " + str.tostring(dailyVP.pocPrice, format.mintick), alert.freq_once_per_bar_close)

    if i_showW and not na(weeklyVP.pocPrice)
        bool inZoneNow = math.abs(close - weeklyVP.pocPrice) <= distSq
        bool inZonePrev = math.abs(close[1] - weeklyVP.pocPrice) <= distSq
        if inZoneNow and not inZonePrev
            alert("Price approaching Weekly POC: " + str.tostring(weeklyVP.pocPrice, format.mintick), alert.freq_once_per_bar_close)
