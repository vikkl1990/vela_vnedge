//@version=6
indicator("Spinning Top", shorttitle = "Spinning Top", overlay = true, format = format.price, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86 // spinning tops with no trend context - noise, not a side
TREND_COLOR   = #787b86 // the context SMA - structure

CTX_ANY     = "Any"
CTX_ADVANCE = "After Advance"
CTX_DECLINE = "After Decline"

GRP_DETECTION = "Detection"
GRP_CONTEXT   = "Trend Context"
GRP_RESOLVE   = "Resolution"
GRP_STYLE     = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
maxBodyInput     = input.float(33.0, "Maximum Body Size %",   minval = 1,   maxval = 100, step = 1,   group = GRP_DETECTION, tooltip = "Largest real body allowed, as a percentage of the candle's high-low range. A spinning top's body must stay small; when both shadows are longer than the body it can never exceed one third of the range.")
minBodyInput     = input.float(5.0,  "Minimum Body Size %",   minval = 0,   maxval = 50,  step = 0.5, group = GRP_DETECTION, tooltip = "Smallest real body allowed, as a percentage of the candle's high-low range. Candles with a body at or below this threshold are treated as doji - a separate concept - and are not marked. The doji boundary is arbitrary and varies between scanners.")
shadowRatioInput = input.float(1.0,  "Shadow / Body Ratio",   minval = 0.1, maxval = 10,  step = 0.1, group = GRP_DETECTION, tooltip = "Each shadow must be longer than the real body multiplied by this ratio. The default of 1 applies the textbook rule that the upper and lower shadows are each longer than the body.")
centerBandInput  = input.float(33.0, "Body Centering Band %", minval = 5,   maxval = 100, step = 1,   group = GRP_DETECTION, tooltip = "The midpoint of the real body must lie inside this central share of the candle's range, keeping the body near the middle. The default of 33 confines the body midpoint to the middle third of the range.")

contextInput     = input.string(CTX_ANY, "Context Filter", options = [CTX_ANY, CTX_ADVANCE, CTX_DECLINE], group = GRP_CONTEXT, tooltip = "Which spinning tops to mark. 'After Advance' keeps only candles printing above the trend SMA (momentum stalling in an up move), 'After Decline' only candles printing below it (selling stalling in a down move). Inside an established range a spinning top is ordinary noise.")
trendLengthInput = input.int(20, "Trend SMA Length", minval = 2, group = GRP_CONTEXT, tooltip = "Length of the simple moving average used to define the prevailing trend at the pattern bar: a close above it counts as an advance, a close below it as a decline.")
showTrendInput   = input.bool(false, "Show Trend SMA", group = GRP_CONTEXT, tooltip = "Display the trend SMA used by the context filter.")

resolveWindowInput = input.int(1, "Resolution Window (bars)", minval = 1, maxval = 20, group = GRP_RESOLVE, tooltip = "How many following candles may resolve the standoff with a close beyond the spinning top's range. The default of 1 waits on the very next candle, the way the pattern is normally read.")
showResolveInput   = input.bool(true, "Resolution Markers", group = GRP_RESOLVE, tooltip = "Mark the candle that resolves a spinning top: a triangle up when it closes above the pattern high, a triangle down when it closes below the pattern low.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral",   group = GRP_STYLE, tooltip = "Color of spinning tops printing inside a range, with no trend context.")
bullColorInput    = input.color(BULL_COLOR,    "Bullish",   group = GRP_STYLE, tooltip = "Color of spinning tops printing after a decline (potential stabilization) and of bullish resolution markers.")
bearColorInput    = input.color(BEAR_COLOR,    "Bearish",   group = GRP_STYLE, tooltip = "Color of spinning tops printing after an advance (potential exhaustion) and of bearish resolution markers.")
trendColorInput   = input.color(TREND_COLOR,   "Trend SMA", group = GRP_STYLE, tooltip = "Color of the trend SMA plot.")
labelSizeInput    = input.string("Tiny", "Label Size", options = ["Tiny", "Small", "Normal"], group = GRP_STYLE, tooltip = "Size of the ST label drawn above each spinning top.")
colorBarsInput    = input.bool(false, "Color Pattern Candles", group = GRP_STYLE, tooltip = "Paint spinning top candles with their context color so indecision bars stand out at a glance.")

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{
candleRange = high - low
bodySize    = math.abs(close - open)
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low
bodyMid     = (open + close) / 2
rangeMid    = (high + low) / 2

smallBody    = bodySize <= candleRange * maxBodyInput / 100
visibleBody  = bodySize >  candleRange * minBodyInput / 100
longShadows  = upperShadow > bodySize * shadowRatioInput and lowerShadow > bodySize * shadowRatioInput
centeredBody = math.abs(bodyMid - rangeMid) <= candleRange * centerBandInput / 200

spinningTop = candleRange > 0 and smallBody and visibleBody and longShadows and centeredBody

//---------------------------------------------------------------------------------------------------------------------}
// Trend Context
//---------------------------------------------------------------------------------------------------------------------{
trendMa = ta.sma(close, trendLengthInput)

upContext   = not na(trendMa) and close > trendMa
downContext = not na(trendMa) and close < trendMa

contextOk = contextInput == CTX_ANY or contextInput == CTX_ADVANCE and upContext or contextInput == CTX_DECLINE and downContext
signal    = spinningTop and contextOk

ctxColor = upContext ? bearColorInput : downContext ? bullColorInput : neutralColorInput
ctxText  = upContext ? "after an advance" : downContext ? "after a decline" : "in range"

//---------------------------------------------------------------------------------------------------------------------}
// Standoff Resolution
//---------------------------------------------------------------------------------------------------------------------{
var float standoffHigh = na
var float standoffLow  = na
var int   standoffLeft = 0

bullResolve = false
bearResolve = false

if standoffLeft > 0
    if close > standoffHigh
        bullResolve  := true
        standoffLeft := 0
    else if close < standoffLow
        bearResolve  := true
        standoffLeft := 0
    else
        standoffLeft -= 1

if signal
    standoffHigh := high
    standoffLow  := low
    standoffLeft := resolveWindowInput

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
labelSize = switch labelSizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    => size.normal

if signal
    bodyPct    = bodySize / candleRange * 100
    upperRatio = upperShadow / bodySize
    lowerRatio = lowerShadow / bodySize
    label.new(bar_index, high, "ST"
      , style     = label.style_label_down
      , color     = #00000000
      , textcolor = ctxColor
      , size      = labelSize
      , tooltip   = str.format("Spinning Top {0}\nBody: {1,number,#.#}% of range\nUpper shadow: {2,number,#.##}x body\nLower shadow: {3,number,#.##}x body", ctxText, bodyPct, upperRatio, lowerRatio))

plot(trendMa, "Trend SMA", showTrendInput ? trendColorInput : color(na), 1)

plotshape(showResolveInput and bullResolve, "Bullish Resolution", shape.triangleup,   location.belowbar, bullColorInput, size = size.tiny)
plotshape(showResolveInput and bearResolve, "Bearish Resolution", shape.triangledown, location.abovebar, bearColorInput, size = size.tiny)

barcolor(colorBarsInput and signal ? ctxColor : na, title = "Spinning Top Candles")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(signal, "Spinning Top", "Spinning Top - indecision candle, both sides pushed and neither held. Wait for the next candle to resolve direction.")
alertcondition(signal and upContext, "Spinning Top After Advance", "Spinning Top after an advance - momentum stalled. Watch the next candle for exhaustion or continuation.")
alertcondition(signal and downContext, "Spinning Top After Decline", "Spinning Top after a decline - selling pressure stalled. Watch the next candle for stabilization or continuation.")
alertcondition(bullResolve, "Bullish Resolution", "Close above the spinning top high - the standoff resolved upward.")
alertcondition(bearResolve, "Bearish Resolution", "Close below the spinning top low - the standoff resolved downward.")

//---------------------------------------------------------------------------------------------------------------------}
