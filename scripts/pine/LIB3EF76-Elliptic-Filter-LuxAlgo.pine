//@version=6
indicator("Elliptic Filter", "Elliptic Filter", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
// The filter is specified by its four design targets (passband ripple, stopband attenuation, cutoff period, order)
// and realized as cascaded second-order sections y = b0*x + b1*x[1] + b2*x[2] - a1*y[1] - a2*y[2]. The section
// coefficients come from the standard elliptic (Cauer) design procedure: Jacobi elliptic functions evaluated through
// descending Landen transformations place the equiripple poles and zeros, and the bilinear transform with frequency
// pre-warping maps them to the sampled (bar) domain.
const int   MAX_SECTIONS = 4     // enough biquad slots for orders up to 8; unused slots hold pass-through sections
const int   LANDEN_STEPS = 10    // Landen moduli decrease super-quadratically; ten steps exhaust double precision
const int   COEF_COUNT   = 21    // 4 sections x 5 coefficients + the derived stopband edge period

const color BULL_COLOR    = #089981
const color BEAR_COLOR    = #f23645
const color NEUTRAL_COLOR = #787b86

const color DASH_BG     = #161616
const color DASH_FRAME  = #2E2E2E
const color DASH_HEADER = #808080
const color DASH_TEXT   = #DBDBDB

const string MODE_DIRECTIONAL = "Directional"
const string MODE_SINGLE      = "Single"

const string GRP_FILTER = "Filter"
const string GRP_DASH   = "Dashboard"
const string GRP_STYLE  = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source", group = GRP_FILTER, tooltip = "Series the elliptic filter smooths. Close is the usual choice; any other series can be band-limited the same way.")

cutoffInput = input.int(20, "Cutoff Period", minval = 4, group = GRP_FILTER, tooltip = "Passband edge, in bars. Swings slower than this period are kept, attenuated by no more than the passband ripple; the dashboard shows the derived stopband edge where full rejection is already reached.")

orderInput = input.int(4, "Order", minval = 2, maxval = 8, group = GRP_FILTER, tooltip = "Number of filter poles. Higher orders are implemented as cascaded second-order (biquad) sections for numerical stability; odd orders add one first-order section. Raising the order narrows the transition band but deepens the ringing after impulsive bars.")

rippleInput = input.float(0.5, "Passband Ripple (dB)", minval = 0.01, maxval = 3, step = 0.05, group = GRP_FILTER, tooltip = "Bounded wobble allowed in the amplitude of the wavelengths the filter keeps. More ripple buys a sharper cutoff at the same order, but the smoothed line then slightly exaggerates some swing amplitudes and shrinks others, even in clean data.")

attenInput = input.float(40, "Stopband Attenuation (dB)", minval = 10, maxval = 120, step = 1, group = GRP_FILTER, tooltip = "Floor to which rejected wavelengths are held. Stopband ripple means the rejected noise stays below this fixed depth rather than being driven ever deeper - the concession that makes the elliptic transition the fastest possible for a given order.")

showDashboardInput = input.bool(true, "Show Dashboard", group = GRP_DASH, tooltip = "Displays the realized design: order and section split, the passband edge with its ripple, and the derived stopband edge - the longest wavelength already attenuated by the full stopband depth. The gap between the two edges is the transition band that the elliptic design minimizes.")

dashLocationInput = input.string("Top Right", "Location", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = GRP_DASH, tooltip = "Dashboard position on the chart.")

dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = GRP_DASH, tooltip = "Dashboard text size.")

colorModeInput = input.string(MODE_DIRECTIONAL, "Line Coloring", options = [MODE_DIRECTIONAL, MODE_SINGLE], group = GRP_STYLE, tooltip = "'Directional' colors the filter line by its slope, highlighting turning points. 'Single' uses one fixed color.")

lineWidthInput = input.int(2, "Line Width", minval = 1, maxval = 5, group = GRP_STYLE, tooltip = "Width of the filter line.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "colors", group = GRP_STYLE)
bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = GRP_STYLE)
singleColorInput = input.color(NEUTRAL_COLOR, "Single", inline = "colors", group = GRP_STYLE)

showMarkersInput = input.bool(false, "Crossing Markers", group = GRP_STYLE, tooltip = "Shows small triangles when the source crosses the filter line. Off by default: the sharp cutoff comes with pronounced ringing after gaps and impulse bars, printing wiggles that crossing rules will trade. The matching alerts remain available.")

//---------------------------------------------------------------------------------------------------------------------}
// Elliptic Design Functions
//---------------------------------------------------------------------------------------------------------------------{
// Descending Landen sequence [k1..kM] of a modulus. The exact complement is passed in so the first step never
// evaluates sqrt(1 - k^2) on a modulus that rounds to 1 in double precision.
landenSeq(float modK, float modComp) =>
    array<float> seq = array.new_float(0)
    float k = modK
    for stepIdx = 0 to LANDEN_STEPS - 1
        float kc = stepIdx == 0 ? modComp : math.sqrt(math.max(0.0, 1.0 - k * k))
        k := math.pow(k / (1.0 + kc), 2)
        array.push(seq, k)
    seq

// sn(u*K(k), k) for real normalized u, ascending the Landen sequence from modulus ~0 back to k
sneReal(float u, array<float> seq) =>
    float w = math.sin(u * math.pi / 2)
    int m = array.size(seq)
    for j = 0 to m - 1
        float v = array.get(seq, m - 1 - j)
        w := (1.0 + v) * w / (1.0 + v * w * w)
    w

// cd(u*K(k), k) for real normalized u - same recursion seeded with a cosine
cdeReal(float u, array<float> seq) =>
    float w = math.cos(u * math.pi / 2)
    int m = array.size(seq)
    for j = 0 to m - 1
        float v = array.get(seq, m - 1 - j)
        w := (1.0 + v) * w / (1.0 + v * w * w)
    w

// sn evaluated on the imaginary axis: maps w = j*y, so the recursion stays real with a sign flip
sneImagY(float yIn, array<float> seq) =>
    float y = yIn
    int m = array.size(seq)
    for j = 0 to m - 1
        float v = array.get(seq, m - 1 - j)
        y := (1.0 + v) * y / (1.0 - v * y * y)
    y

// Inverse sn of a purely imaginary argument j*y at modulus k, descending the Landen sequence; returns the
// normalized (in units of K) imaginary part, i.e. asinh at the vanishing modulus
asneImag(float yIn, float modK, array<float> seq) =>
    float y = yIn
    float prev = modK
    for j = 0 to array.size(seq) - 1
        float v = array.get(seq, j)
        y := 2.0 * y / ((1.0 + v) * (1.0 + math.sqrt(1.0 + prev * prev * y * y)))
        prev := v
    2.0 / math.pi * math.log(y + math.sqrt(y * y + 1.0))

// cd((u - j*v0)*K(k), k) for the complex pole grid, carried as explicit real and imaginary parts
cdeComplex(float u, float v0, array<float> seq) =>
    float a = u * math.pi / 2
    float b = v0 * math.pi / 2
    float coshB = (math.exp(b) + math.exp(-b)) / 2
    float sinhB = (math.exp(b) - math.exp(-b)) / 2
    float wr = math.cos(a) * coshB
    float wi = math.sin(a) * sinhB
    int m = array.size(seq)
    for j = 0 to m - 1
        float v = array.get(seq, m - 1 - j)
        float w2r = wr * wr - wi * wi
        float w2i = 2.0 * wr * wi
        float dr = 1.0 + v * w2r
        float di = v * w2i
        float nr = (1.0 + v) * wr
        float ni = (1.0 + v) * wi
        float dd = dr * dr + di * di
        float wrNext = (nr * dr + ni * di) / dd
        wi := (ni * dr - nr * di) / dd
        wr := wrNext
    [wr, wi]

// Full digital elliptic low-pass design. Returns a flat coefficient array: five entries (b0, b1, b2, a1, a2) per
// section slot, unused slots left as pass-through, and the derived stopband edge period in the final entry.
// Every section is normalized to unity gain at zero frequency so the cascade tracks the price level exactly.
designElliptic(int order, float rippleDb, float attenDb, int period) =>
    array<float> coef = array.new_float(COEF_COUNT, 0.0)
    for s = 0 to MAX_SECTIONS - 1
        array.set(coef, s * 5, 1.0)

    // ripple magnitudes and the ripple selectivity k1 = ep/es
    float ep = math.sqrt(math.pow(10.0, rippleDb / 10.0) - 1.0)
    float es = math.sqrt(math.pow(10.0, attenDb / 10.0) - 1.0)
    float k1 = ep / es
    float k1c = math.sqrt(1.0 - k1 * k1)
    array<float> seqK1 = landenSeq(k1, k1c)
    array<float> seqK1c = landenSeq(k1c, k1)

    int  biquadCount = math.floor(order / 2.0)
    bool oddOrder = order % 2 == 1

    // degree equation: transition modulus k (= passband edge / stopband edge) exactly meeting order and ripples
    float prodSn = 1.0
    for i = 1 to biquadCount
        prodSn := prodSn * sneReal((2.0 * i - 1.0) / order, seqK1c)
    float kComp = math.pow(k1c, order) * math.pow(prodSn, 4.0)
    float kEll = math.sqrt(1.0 - kComp * kComp)
    array<float> seqK = landenSeq(kEll, kComp)

    // v0 places the pole grid: sn(j*v0*N*K1, k1) = j/ep
    float v0 = asneImag(1.0 / ep, k1, seqK1) / order

    // bilinear pre-warp so the sampled passband edge lands exactly on the requested cutoff period
    float warp = math.tan(math.pi / period)

    int sectionIdx = 0
    if oddOrder
        // real analog pole pa0 = j*sn(j*v0*K, k); analog zero at infinity maps to the Nyquist wavelength
        float sinhV0 = (math.exp(v0 * math.pi / 2) - math.exp(-v0 * math.pi / 2)) / 2
        float pole0 = warp * -sneImagY(sinhV0, seqK)
        float zPole0 = (1.0 + pole0) / (1.0 - pole0)
        float gain0 = (1.0 - zPole0) / 2.0
        array.set(coef, 0, gain0)
        array.set(coef, 1, gain0)
        array.set(coef, 2, 0.0)
        array.set(coef, 3, -zPole0)
        array.set(coef, 4, 0.0)
        sectionIdx := 1

    for i = 1 to biquadCount
        float ui = (2.0 * i - 1.0) / order
        // transmission zero pair +/- j*warp / (k * cd(ui*K, k)) -> unit-circle zeros with cosine cz
        float omegaZero = warp / (kEll * cdeReal(ui, seqK))
        float cz = (1.0 - omegaZero * omegaZero) / (1.0 + omegaZero * omegaZero)
        // pole pair pa = j*cd((ui - j*v0)*K, k), scaled by the pre-warp and mapped by the bilinear transform
        [cdr, cdi] = cdeComplex(ui, v0, seqK)
        float pr = -warp * cdi
        float pim = warp * cdr
        float den = (1.0 - pr) * (1.0 - pr) + pim * pim
        float zr = (1.0 - pr * pr - pim * pim) / den
        float zi = 2.0 * pim / den
        float a1 = -2.0 * zr
        float a2 = zr * zr + zi * zi
        float gain = (1.0 + a1 + a2) / (2.0 - 2.0 * cz)
        int base = (sectionIdx + i - 1) * 5
        array.set(coef, base, gain)
        array.set(coef, base + 1, -2.0 * cz * gain)
        array.set(coef, base + 2, gain)
        array.set(coef, base + 3, a1)
        array.set(coef, base + 4, a2)

    // derived stopband edge period: wavelengths at or below it are attenuated by the full stopband depth
    float wsEdge = 2.0 * math.atan(warp / kEll)
    array.set(coef, 20, 2.0 * math.pi / wsEdge)
    coef

// One cascaded section: recursion with per-call-site history, seeded with the current input so the cascade starts
// as a pass-through (each section has unity zero-frequency gain, so seeding at the price level is transient-free)
sosSection(float xIn, array<float> coef, int section) =>
    int base = section * 5
    float x1 = nz(xIn[1], xIn)
    float x2 = nz(xIn[2], xIn)
    float result = na
    float y1 = nz(result[1], xIn)
    float y2 = nz(result[2], xIn)
    result := array.get(coef, base) * xIn + array.get(coef, base + 1) * x1 + array.get(coef, base + 2) * x2 - array.get(coef, base + 3) * y1 - array.get(coef, base + 4) * y2
    result

// Maps the dashboard location option to a table position constant
tablePosition(string positionText) =>
    switch positionText
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

// Maps the dashboard size option to a text size constant
tableSize(string sizeText) =>
    switch sizeText
        "Tiny"  => size.tiny
        "Small" => size.small
        => size.normal

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// The four design targets fully specify the filter; the coefficients are generated once
var array<float> coefArray = designElliptic(orderInput, rippleInput, attenInput, cutoffInput)

float stage0 = sosSection(srcInput, coefArray, 0)
float stage1 = sosSection(stage0, coefArray, 1)
float stage2 = sosSection(stage1, coefArray, 2)
float elliptic = sosSection(stage2, coefArray, 3)

float stopPeriod = array.get(coefArray, 20)
int   biquadTotal = math.floor(orderInput / 2.0)
bool  hasFirstOrder = orderInput % 2 == 1

float prev1 = nz(elliptic[1], elliptic)
float prev2 = nz(elliptic[2], elliptic)

bool turnedUp   = elliptic > prev1 and prev1 <= prev2
bool turnedDown = elliptic < prev1 and prev1 >= prev2

var bool isRising = true
isRising := elliptic > prev1 ? true : elliptic < prev1 ? false : isRising

bool priceCrossUp   = ta.crossover(srcInput, elliptic)
bool priceCrossDown = ta.crossunder(srcInput, elliptic)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color lineColor = colorModeInput == MODE_DIRECTIONAL ? (isRising ? bullColorInput : bearColorInput) : singleColorInput

plot(elliptic, "Elliptic Filter", lineColor, lineWidthInput)

plotshape(showMarkersInput and priceCrossUp, "Bullish Crossing", shape.triangleup, location.belowbar, bullColorInput, size = size.tiny)
plotshape(showMarkersInput and priceCrossDown, "Bearish Crossing", shape.triangledown, location.abovebar, bearColorInput, size = size.tiny)

var table infoTable = table.new(tablePosition(dashLocationInput), 2, 4, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if showDashboardInput and barstate.islast
    string textSize   = tableSize(dashSizeInput)
    color  labelColor = DASH_HEADER
    string orderText  = str.tostring(orderInput) + " · " + str.tostring(biquadTotal) + (biquadTotal > 1 ? " biquads" : " biquad") + (hasFirstOrder ? " + 1 pole" : "")
    table.cell(infoTable, 0, 0, "Elliptic filter", text_color = DASH_TEXT, text_size = textSize, text_halign = text.align_left)
    table.cell(infoTable, 1, 0, "", text_size = textSize)
    table.cell(infoTable, 0, 1, "Order", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(infoTable, 1, 1, orderText, text_color = DASH_TEXT, text_size = textSize, text_halign = text.align_right)
    table.cell(infoTable, 0, 2, "Passband", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(infoTable, 1, 2, "≥ " + str.tostring(cutoffInput) + " bars · " + str.tostring(rippleInput, "#.##") + " dB", text_color = DASH_TEXT, text_size = textSize, text_halign = text.align_right)
    table.cell(infoTable, 0, 3, "Stopband", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(infoTable, 1, 3, "≤ " + str.tostring(stopPeriod, "#.#") + " bars · -" + str.tostring(attenInput, "#") + " dB", text_color = DASH_TEXT, text_size = textSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(turnedUp, "Elliptic Filter Turned Up", "Elliptic filter turned up on {{ticker}} ({{interval}})")
alertcondition(turnedDown, "Elliptic Filter Turned Down", "Elliptic filter turned down on {{ticker}} ({{interval}})")
alertcondition(priceCrossUp, "Price Crossed Over Filter", "Price crossed over the elliptic filter on {{ticker}} ({{interval}})")
alertcondition(priceCrossDown, "Price Crossed Under Filter", "Price crossed under the elliptic filter on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
