//@version=5
indicator("Weekly Stacked Daily Changes [LuxAlgo]", "LuxAlgo - Weekly Stacked Daily Changes", max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

if timeframe.in_seconds() > timeframe.in_seconds('D')
    runtime.error('Your chart timeframe is higher than allowed. Please select a chart timeframe of 1D or less.')

//---------------------------------------------------------------------------------------------------------------------}
//Settings
//---------------------------------------------------------------------------------------------------------------------{
width = input.int(20, minval = 2)
offset = input.int(10, minval = 0)
spacing = input.float(0.5, step = 0.01, minval = 0)

bias = input(false, 'Bottom Stack Bias') 

//Styling
bullColor = input(#089981, 'Bullish Change', group = 'Style')
bearColor = input(#f23645, 'Bearish Change', group = 'Style')

showMonth = input(true, 'Show Months', group = 'Style')
showMonthDelimiter = input(true, 'Show Months Delimiter', group = 'Style')

//---------------------------------------------------------------------------------------------------------------------}
//UDTs
//---------------------------------------------------------------------------------------------------------------------{
type vector
    array<float> v

type vector_int
    array<int> v

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
data()=>
    var prices = array.new<vector>(0)
    var months = array.new<vector_int>(0)

    dow = switch syminfo.type
        'forex' => dayofweek-1
        => dayofweek == 1 ? 6 : dayofweek-2

    if dow < dow[1]
        prices.unshift(vector.new(array.new<float>(7, 0)))
        months.unshift(vector_int.new(array.new<int>(7, na)))

    if prices.size() > 0
        prices.get(0).v.set(dow, close - open)
        months.get(0).v.set(dow, month-1)

    [barstate.islast ? prices : na, barstate.islast ? months : na]

//---------------------------------------------------------------------------------------------------------------------}
//Data
//---------------------------------------------------------------------------------------------------------------------{
var days = array.from('MO', 'TU', 'WE', 'TH', 'FR', 'SA', 'SU')
var months = array.from('JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC')

//Get 
[prices, array_months] = request.security(syminfo.tickerid, 'D', data(), lookahead = barmerge.lookahead_on, calc_bars_count = 500)

n = bar_index

atr = ta.atr(200) * spacing

//---------------------------------------------------------------------------------------------------------------------}
//Display boxes
//---------------------------------------------------------------------------------------------------------------------{
//Graphical object management
for element in box.all
    element.delete()
for element in line.all
    element.delete()
for element in label.all
    element.delete()

if barstate.islast
    x1 = n
    prev_month = month-1

    //Interate over each weeks
    for i = 0 to math.min(70, prices.size()-1)
        get_week = prices.get(i).v
        get_month_array = array_months.get(i).v

        sum = bias ? get_week.sum() : 0
        prev_month := get_month_array.get(0)

        //Month label
        if showMonth
            label.new(x1 - int(width / 2), sum, months.get(get_month_array.get(0))
              , style = label.style_label_up
              , color = color(na)
              , textcolor = chart.fg_color
              , size = size.tiny)

        //Iterate over days in week and display stacked areas
        for j = 0 to get_week.size()-1
            get_day = get_week.get(j)
            get_month = get_month_array.get(j)
            
            absd = math.abs(get_day)

            //Display stacked area
            box.new(x1 - width, sum + absd, x1, sum, na
              , bgcolor = get_day > 0 ? bullColor : bearColor, text = days.get(j)
              , text_color = color.white)

            //New month delimiter
            if get_month != prev_month and not na(get_month) and showMonthDelimiter
                lvl = sum + absd + atr / 2
                line.new(x1 - width - int(offset / 2), lvl, x1 + int(offset / 2), lvl, color = chart.fg_color)

            sum += absd + atr
            if not na(get_month)
                prev_month := get_month

        x1 -= width + offset

//0 line
plot(0, color = chart.fg_color, show_last = 71 * width + 70 * offset)

//---------------------------------------------------------------------------------------------------------------------}