//@version=6
// LOD Reversal Scanner
// Logic: bar N makes a new low of day. The first later bar (same day) that CLOSES above
// bar N's close -> signal. Fires once per LOD candle; a fresh LOD re-arms it.
// Always evaluates on the "Signal timeframe" (default 15m) no matter what the chart /
// screener interval is. Chart or screener interval must be <= signal timeframe.
indicator("LOD Reversal Scanner", shorttitle="LOD Rev", overlay=true)

// ---------- Inputs ----------
sigTf      = input.timeframe("15", "Signal timeframe")
minAvgVol  = input.float(1000000, "Min avg daily volume", minval=0, step=100000)
avgVolLen  = input.int(20, "Avg volume lookback (days)", minval=1)
rthOnly    = input.bool(true, "Regular session only")
showLod    = input.bool(true, "Mark new-LOD bars")

// ---------- Volume filter (completed daily bars only) ----------
avgDailyVol = request.security(syminfo.tickerid, "D", ta.sma(volume, avgVolLen)[1], lookahead=barmerge.lookahead_on)
volOk = avgDailyVol >= minAvgVol

// ---------- LOD logic, computed on the signal timeframe ----------
f_lod() =>
    var float dayLow   = na
    var float refClose = na      // close of the most recent new-LOD candle
    var bool  armed    = false   // waiting for a close above refClose
    newDay    = ta.change(time("D")) != 0
    inSession = not rthOnly or session.ismarket
    if newDay
        dayLow   := na
        refClose := na
        armed    := false
    isNewLow = inSession and not na(dayLow) and low < dayLow
    if inSession
        dayLow := na(dayLow) ? low : math.min(dayLow, low)
    sig = false
    if isNewLow
        // new LOD candle: (re)set the reference and arm
        refClose := close
        armed    := true
    else if inSession and armed and close > refClose
        // any later candle closing above the LOD candle's close fires once
        sig   := true
        armed := false
    [isNewLow, sig]

[isNewLow, rawSig] = request.security(syminfo.tickerid, sigTf, f_lod())

signal = rawSig and volOk

// ---------- Visuals ----------
plotshape(showLod and isNewLow, "New LOD", shape.circle, location.belowbar, color.new(color.red, 40), size=size.tiny)
plotshape(signal, "LOD Reversal", shape.triangleup, location.belowbar, color.lime, size=size.small, text="REV")
bgcolor(signal ? color.new(color.lime, 85) : na)

// Screener columns
plot(signal ? 1 : 0, "Signal", display=display.data_window)
plot(avgDailyVol, "Avg Daily Vol", display=display.data_window)

// ---------- Alerts ----------
alertcondition(signal, "LOD Reversal", "{{ticker}} closed above its low-of-day candle")