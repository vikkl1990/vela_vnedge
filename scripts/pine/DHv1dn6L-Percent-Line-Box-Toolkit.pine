//@version=6
indicator(title = "Percent Line/Box Toolkit", overlay = true, max_lines_count = 10, max_labels_count = 20, max_boxes_count = 10)

const int con_lineCount = 6
const int con_boxCount  = 4

// These strings are logic as well as labels: they appear in the option lists
// below AND in the comparisons inside f_lineStyleFromText and
// f_labelSizeFromText. Changing one place without the other silently falls
// through to the default branch.
const string con_styleSolid  = "Solid"
const string con_styleDotted = "Dotted"
const string con_styleDashed = "Dashed"

const string con_sizeTiny   = "Tiny"
const string con_sizeSmall  = "Small"
const string con_sizeNormal = "Normal"
const string con_sizeLarge  = "Large"
const string con_sizeHuge   = "Huge"

const string con_verticalTooltip  = "Vertical offset from the current close, in percent."
const string con_offsetTooltip    = "Horizontal offset. Positive values move the drawing to the left, negative values into the empty space on the right."
const string con_lengthTooltip    = "Width of the drawing, measured in bars."
const string con_timeframeTooltip = "Offset and length are measured in bars of this timeframe, so the drawing keeps its size when you switch chart timeframes."
const string con_labelTooltip     = "Text shown at the right edge of the drawing, and the size it is drawn in. Leave the text field empty to hide the label."
const string con_boxUpperTooltip  = "Upper edge of the box, as a percentage of the current close."
const string con_boxLowerTooltip  = "Lower edge of the box, as a percentage of the current close. The order does not matter: the higher of the two values is always drawn as the top edge."


// Converts a percentage into a price, relative to the given base price.
f_priceFromPercent(float basePrice, float percentValue) =>
    basePrice + basePrice * (percentValue / 100.0)

// Returns the duration of one bar of the reference timeframe in seconds; with no timeframe selected, the chart's own is used.
f_barSeconds(string referenceTimeframe) =>
    int referenceSeconds = timeframe.in_seconds(referenceTimeframe)
    int chartSeconds     = timeframe.in_seconds(timeframe.period)
    nz(na(referenceSeconds) ? chartSeconds : referenceSeconds, 60)

// Derives the left and right time coordinate of a drawing from offset and length, measured in bars of the reference timeframe.
f_segmentCoordinates(int offsetBars, int lengthBars, string referenceTimeframe) =>
    float secondsPerBar = math.max(1, f_barSeconds(referenceTimeframe))
    float offsetMs      = offsetBars * secondsPerBar * 1000.0
    float lengthMs      = (lengthBars - 1) * secondsPerBar * 1000.0
    float rightTime     = time - offsetMs
    float leftTime      = rightTime - lengthMs
    [leftTime, rightTime]

// Translates the selected option string into the matching line style constant.
f_lineStyleFromText(string styleText) =>
    styleText == con_styleDotted ? line.style_dotted : styleText == con_styleDashed ? line.style_dashed : line.style_solid

// Translates the selected option string into the matching size constant.
f_labelSizeFromText(string sizeText) =>
    sizeText == con_sizeSmall ? size.small : sizeText == con_sizeNormal ? size.normal : sizeText == con_sizeLarge ? size.large : sizeText == con_sizeHuge ? size.huge : size.tiny

// Creates the label once and only updates it afterwards; an empty text deletes it again.
f_updateLabel(label labelId, bool showLabel, string labelText, string labelSizeText, int xPosition, float yPosition, color textColor) =>
    label resultId = labelId

    if showLabel and str.length(labelText) > 0
        string labelSize = f_labelSizeFromText(labelSizeText)

        if na(labelId)
            resultId := label.new(xPosition, yPosition, labelText,
                 xloc      = xloc.bar_time,
                 style     = label.style_label_down,
                 color     = na,
                 textcolor = textColor,
                 size      = labelSize)
        else
            label.set_xy(labelId, xPosition, yPosition)
            label.set_text(labelId, labelText)
            label.set_textcolor(labelId, textColor)
            label.set_size(labelId, labelSize)
            resultId := labelId
    else
        if not na(labelId)
            label.delete(labelId)
        resultId := na

    resultId

// Draws one line together with its label, repositions both on every call, and deletes them once the line is switched off.
f_percentLine(line lineId, label labelId, bool showLine, float percentValue, string referenceTimeframe, int offsetBars, int lengthBars, color lineColor, int lineWidth, string lineStyleText, bool showLabel, string labelText, string labelSizeText, float basePrice) =>
    line  resultLine  = lineId
    label resultLabel = labelId

    if showLine
        float priceLevel = f_priceFromPercent(basePrice, percentValue)
        [leftTime, rightTime] = f_segmentCoordinates(offsetBars, lengthBars, referenceTimeframe)
        string lineStyle = f_lineStyleFromText(lineStyleText)

        if na(lineId)
            resultLine := line.new(int(leftTime), priceLevel, int(rightTime), priceLevel,
                 xloc   = xloc.bar_time,
                 extend = extend.none,
                 color  = lineColor, width = lineWidth, style = lineStyle)
        else
            line.set_xy1(lineId, int(leftTime), priceLevel)
            line.set_xy2(lineId, int(rightTime), priceLevel)
            line.set_color(lineId, lineColor)
            line.set_style(lineId, lineStyle)
            line.set_width(lineId, lineWidth)
            resultLine := lineId

        resultLabel := f_updateLabel(labelId, showLabel, labelText, labelSizeText, int(rightTime), priceLevel, lineColor)
    else
        if not na(lineId)
            line.delete(lineId)
        if not na(labelId)
            label.delete(labelId)
        resultLine  := na
        resultLabel := na

    [resultLine, resultLabel]

// Same as f_percentLine for a box; the two percentage values are sorted first so the higher one always forms the top edge.
f_percentBox(box boxId, label labelId, bool showBox, float topPercent, float bottomPercent, string referenceTimeframe, int offsetBars, int lengthBars, color borderColor, int borderWidth, color fillColor, bool showLabel, string labelText, string labelSizeText, float basePrice) =>
    box   resultBox   = boxId
    label resultLabel = labelId

    if showBox
        float firstLevel  = f_priceFromPercent(basePrice, topPercent)
        float secondLevel = f_priceFromPercent(basePrice, bottomPercent)
        float topLevel    = math.max(firstLevel, secondLevel)
        float bottomLevel = math.min(firstLevel, secondLevel)

        [leftTime, rightTime] = f_segmentCoordinates(offsetBars, lengthBars, referenceTimeframe)

        if na(boxId)
            resultBox := box.new(int(leftTime), topLevel, int(rightTime), bottomLevel,
                 xloc         = xloc.bar_time,
                 border_color = borderColor,
                 border_width = borderWidth,
                 bgcolor      = fillColor)
        else
            box.set_lefttop(boxId, int(leftTime), topLevel)
            box.set_rightbottom(boxId, int(rightTime), bottomLevel)
            box.set_border_color(boxId, borderColor)
            box.set_border_width(boxId, borderWidth)
            box.set_bgcolor(boxId, fillColor)
            resultBox := boxId

        resultLabel := f_updateLabel(labelId, showLabel, labelText, labelSizeText, int(rightTime), topLevel, borderColor)
    else
        if not na(boxId)
            box.delete(boxId)
        if not na(labelId)
            label.delete(labelId)
        resultBox   := na
        resultLabel := na

    [resultBox, resultLabel]

// Settings per line, six identically structured blocks (Line 1 to Line 6).
bool   inp_showLine1      = input.bool(defval = true, title = "", inline = "line01_", group = "Line 1")
string inp_lineLabel1     = input.string(defval = "+6%", title = "", inline = "line01_", group = "Line 1", active = inp_showLine1)
string inp_lineLabelSize1 = input.string(defval = con_sizeSmall, title = "", options = [con_sizeTiny, con_sizeSmall, con_sizeNormal, con_sizeLarge, con_sizeHuge], inline = "line01_", group = "Line 1", tooltip = con_labelTooltip, active = inp_showLine1)
float  inp_lineVertical1  = input.float(defval = 6.0, title = "Level (%)", minval = -100, maxval = 1000, step = 0.1, tooltip = con_verticalTooltip, group = "Line 1", active = inp_showLine1)
int    inp_lineOffset1    = input.int(defval = 50, title = "Offset (Bars)", minval = -500, maxval = 5000, step = 1, tooltip = con_offsetTooltip, group = "Line 1", active = inp_showLine1)
int    inp_lineLength1    = input.int(defval = 50, title = "Length (Bars)", minval = 2, maxval = 5000, step = 1, tooltip = con_lengthTooltip, group = "Line 1", active = inp_showLine1)
string inp_lineTimeframe1 = input.timeframe(defval = "", title = "Reference Timeframe", tooltip = con_timeframeTooltip, group = "Line 1", active = inp_showLine1)
string inp_lineStyle1     = input.string(defval = con_styleSolid, title = "", options = [con_styleSolid, con_styleDotted, con_styleDashed], inline = "line01", group = "Line 1", active = inp_showLine1)
int    inp_lineWidth1     = input.int(defval = 1, title = "", minval = 1, maxval = 10, step = 1, inline = "line01", group = "Line 1", active = inp_showLine1)
color  inp_lineColor1     = input.color(defval = color.new(color.gray, 0), title = "", inline = "line01", group = "Line 1", active = inp_showLine1)

