string inp_boxLabel4       = input.string(defval = "", title = "", inline = "box04_", group = "Box 4", active = inp_showBox4)
string inp_boxLabelSize4   = input.string(defval = con_sizeNormal, title = "", options = [con_sizeTiny, con_sizeSmall, con_sizeNormal, con_sizeLarge, con_sizeHuge], inline = "box04_", group = "Box 4", tooltip = con_labelTooltip, active = inp_showBox4)
float  inp_boxTop4         = input.float(defval = 1.0, title = "Upper (%)", minval = -100, maxval = 1000, step = 0.1, tooltip = con_boxUpperTooltip, group = "Box 4", active = inp_showBox4)
float  inp_boxBottom4      = input.float(defval = -1.0, title = "Lower (%)", minval = -100, maxval = 1000, step = 0.1, tooltip = con_boxLowerTooltip, group = "Box 4", active = inp_showBox4)
int    inp_boxOffset4      = input.int(defval = 20, title = "Offset (Bars)", minval = -500, maxval = 5000, step = 1, tooltip = con_offsetTooltip, group = "Box 4", active = inp_showBox4)
int    inp_boxLength4      = input.int(defval = 80, title = "Length (Bars)", minval = 2, maxval = 5000, step = 1, tooltip = con_lengthTooltip, group = "Box 4", active = inp_showBox4)
string inp_boxTimeframe4   = input.timeframe(defval = "", title = "Reference Timeframe", tooltip = con_timeframeTooltip, group = "Box 4", active = inp_showBox4)
int    inp_boxWidth4       = input.int(defval = 1, title = "", minval = 0, maxval = 10, step = 1, inline = "box04", group = "Box 4", active = inp_showBox4)
color  inp_boxBorderColor4 = input.color(defval = color.new(#818181, 50), title = "", inline = "box04", group = "Box 4", active = inp_showBox4)
color  inp_boxFillColor4   = input.color(defval = color.new(#818181, 90), title = "", inline = "box04", group = "Box 4", active = inp_showBox4)

// The individual inputs are mirrored into arrays so the drawing loop can address them by index.
var bool[]   cal_lineShow      = array.from(inp_showLine1,      inp_showLine2,      inp_showLine3,      inp_showLine4,      inp_showLine5,      inp_showLine6)
var float[]  cal_lineVertical  = array.from(inp_lineVertical1,  inp_lineVertical2,  inp_lineVertical3,  inp_lineVertical4,  inp_lineVertical5,  inp_lineVertical6)
var string[] cal_lineTimeframe = array.from(inp_lineTimeframe1, inp_lineTimeframe2, inp_lineTimeframe3, inp_lineTimeframe4, inp_lineTimeframe5, inp_lineTimeframe6)
var int[]    cal_lineOffset    = array.from(inp_lineOffset1,    inp_lineOffset2,    inp_lineOffset3,    inp_lineOffset4,    inp_lineOffset5,    inp_lineOffset6)
var int[]    cal_lineLength    = array.from(inp_lineLength1,    inp_lineLength2,    inp_lineLength3,    inp_lineLength4,    inp_lineLength5,    inp_lineLength6)
var color[]  cal_lineColor     = array.from(inp_lineColor1,     inp_lineColor2,     inp_lineColor3,     inp_lineColor4,     inp_lineColor5,     inp_lineColor6)
var int[]    cal_lineWidth     = array.from(inp_lineWidth1,     inp_lineWidth2,     inp_lineWidth3,     inp_lineWidth4,     inp_lineWidth5,     inp_lineWidth6)
var string[] cal_lineStyle     = array.from(inp_lineStyle1,     inp_lineStyle2,     inp_lineStyle3,     inp_lineStyle4,     inp_lineStyle5,     inp_lineStyle6)
var string[] cal_lineLabel     = array.from(inp_lineLabel1,     inp_lineLabel2,     inp_lineLabel3,     inp_lineLabel4,     inp_lineLabel5,     inp_lineLabel6)
var string[] cal_lineLabelSize = array.from(inp_lineLabelSize1, inp_lineLabelSize2, inp_lineLabelSize3, inp_lineLabelSize4, inp_lineLabelSize5, inp_lineLabelSize6)

var bool[]   cal_boxShow        = array.from(inp_showBox1,        inp_showBox2,        inp_showBox3,        inp_showBox4)
var float[]  cal_boxTop         = array.from(inp_boxTop1,         inp_boxTop2,         inp_boxTop3,         inp_boxTop4)
var float[]  cal_boxBottom      = array.from(inp_boxBottom1,      inp_boxBottom2,      inp_boxBottom3,      inp_boxBottom4)
var int[]    cal_boxOffset      = array.from(inp_boxOffset1,      inp_boxOffset2,      inp_boxOffset3,      inp_boxOffset4)
var int[]    cal_boxLength      = array.from(inp_boxLength1,      inp_boxLength2,      inp_boxLength3,      inp_boxLength4)
var string[] cal_boxTimeframe   = array.from(inp_boxTimeframe1,   inp_boxTimeframe2,   inp_boxTimeframe3,   inp_boxTimeframe4)
var int[]    cal_boxBorderWidth = array.from(inp_boxWidth1,       inp_boxWidth2,       inp_boxWidth3,       inp_boxWidth4)
var color[]  cal_boxBorderColor = array.from(inp_boxBorderColor1, inp_boxBorderColor2, inp_boxBorderColor3, inp_boxBorderColor4)
var color[]  cal_boxFillColor   = array.from(inp_boxFillColor1,   inp_boxFillColor2,   inp_boxFillColor3,   inp_boxFillColor4)
var string[] cal_boxLabel       = array.from(inp_boxLabel1,       inp_boxLabel2,       inp_boxLabel3,       inp_boxLabel4)
var string[] cal_boxLabelSize   = array.from(inp_boxLabelSize1,   inp_boxLabelSize2,   inp_boxLabelSize3,   inp_boxLabelSize4)

// The drawing objects live in var arrays: created once, then repositioned rather than recreated.
var line[]  outp_lines      = array.new_line(con_lineCount, na)
var label[] outp_lineLabels = array.new_label(con_lineCount, na)

var box[]   outp_boxes      = array.new_box(con_boxCount, na)
var label[] outp_boxLabels  = array.new_label(con_boxCount, na)

// Everything is drawn on the last bar only, since all drawings are anchored to the current close.
if barstate.islast
    for i = 0 to con_lineCount - 1
        [outp_lineId, outp_labelId] = f_percentLine(
             array.get(outp_lines,        i),
             array.get(outp_lineLabels,   i),
             array.get(cal_lineShow,      i),
             array.get(cal_lineVertical,  i),
             array.get(cal_lineTimeframe, i),
             array.get(cal_lineOffset,    i),
             array.get(cal_lineLength,    i),
             array.get(cal_lineColor,     i),
             array.get(cal_lineWidth,     i),
             array.get(cal_lineStyle,     i),
             true,
             array.get(cal_lineLabel,     i),
             array.get(cal_lineLabelSize, i),
             close)

        array.set(outp_lines,      i, outp_lineId)
        array.set(outp_lineLabels, i, outp_labelId)

    for j = 0 to con_boxCount - 1
        [outp_boxId, outp_boxLabelId] = f_percentBox(
             array.get(outp_boxes,         j),
             array.get(outp_boxLabels,     j),
             array.get(cal_boxShow,        j),
             array.get(cal_boxTop,         j),
             array.get(cal_boxBottom,      j),
             array.get(cal_boxTimeframe,   j),
             array.get(cal_boxOffset,      j),
             array.get(cal_boxLength,      j),
             array.get(cal_boxBorderColor, j),
             array.get(cal_boxBorderWidth, j),
             array.get(cal_boxFillColor,   j),
             true,
             array.get(cal_boxLabel,       j),
             array.get(cal_boxLabelSize,   j),
             close)

        array.set(outp_boxes,     j, outp_boxId)
        array.set(outp_boxLabels, j, outp_boxLabelId)
