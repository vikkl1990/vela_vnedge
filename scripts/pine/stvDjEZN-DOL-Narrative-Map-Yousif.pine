//@version=6
indicator(
     "DOL Narrative Map [Yousif]",
     shorttitle = "DOL Map",
     overlay = true,
     max_lines_count = 50,
     max_labels_count = 50,
     max_boxes_count = 20
)

//====================================================================
// INPUTS
//====================================================================

groupHTF = "Higher Time Frame"
htfTf       = input.timeframe("60", "HTF", group = groupHTF)
htfLookback = input.int(20, "HTF Liquidity Lookback", minval = 5, group = groupHTF)

groupLTF = "Lower Time Frame"
pivotLen      = input.int(3, "Protected Point Strength", minval = 1, maxval = 10, group = groupLTF)
rangeLookback = input.int(10, "Range Failure Lookback", minval = 3, group = groupLTF)
dispMult      = input.float(1.3, "Displacement ATR Multiplier", minval = 0.5, step = 0.1, group = groupLTF)

groupVisual = "Visuals"
showHTFLiquidity = input.bool(true, "Show HTF Liquidity", group = groupVisual)
showFVG          = input.bool(true, "Show Latest HTF FVGs", group = groupVisual)
showProtected    = input.bool(true, "Show Protected Point", group = groupVisual)
showLTFDOL       = input.bool(true, "Show Current DOL", group = groupVisual)


//====================================================================
// COLORS — deliberately restrained
//====================================================================

bullColor = color.new(color.teal, 0)
bearColor = color.new(color.maroon, 0)

neutralColor = color.new(color.gray, 20)

bullSoft = color.new(color.teal, 88)
bearSoft = color.new(color.maroon, 88)

textColor = color.white


//====================================================================
// CONFIRMED HIGHER-TIME-FRAME DATA
//
// [1] + lookahead_on = use the latest COMPLETED HTF candle.
//====================================================================

htfHigh = request.security(
     syminfo.tickerid,
     htfTf,
     ta.highest(high, htfLookback)[1],
     lookahead = barmerge.lookahead_on
)

htfLow = request.security(
     syminfo.tickerid,
     htfTf,
     ta.lowest(low, htfLookback)[1],
     lookahead = barmerge.lookahead_on
)

htfClose = request.security(
     syminfo.tickerid,
     htfTf,
     close[1],
     lookahead = barmerge.lookahead_on
)

htfPreviousHigh = request.security(
     syminfo.tickerid,
     htfTf,
     high[2],
     lookahead = barmerge.lookahead_on
)

htfPreviousLow = request.security(
     syminfo.tickerid,
     htfTf,
     low[2],
     lookahead = barmerge.lookahead_on
)

htfMidpoint = (htfHigh + htfLow) / 2


//====================================================================
// HTF NARRATIVE
//
// +1 = Bullish
// -1 = Bearish
//
// Confirmed HTF expansion through a prior HTF high/low establishes
// narrative. If neither occurs, existing narrative remains intact.
//====================================================================

var int narrative = 0

bullHTFBreak = htfClose > htfPreviousHigh
bearHTFBreak = htfClose < htfPreviousLow

if bullHTFBreak
    narrative := 1

else if bearHTFBreak
    narrative := -1

// Give the script an initial directional state if structure hasn't
// produced a break yet.
if narrative == 0
    narrative := close >= htfMidpoint ? 1 : -1


//====================================================================
// LOWER-TIME-FRAME LIQUIDITY / PROTECTED POINTS
//====================================================================

pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivotLow  = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(pivotHigh)
    lastSwingHigh := pivotHigh

if not na(pivotLow)
    lastSwingLow := pivotLow


// In bullish delivery, the important opposing structural point is
// the latest swing LOW.
//
// In bearish delivery, it's the latest swing HIGH.

float protectedPoint = narrative == 1 ? lastSwingLow : lastSwingHigh


//====================================================================
// DISPLACEMENT + RANGE FAILURE
//====================================================================

atr = ta.atr(14)
bodySize = math.abs(close - open)

previousRangeHigh = ta.highest(high[1], rangeLookback)
previousRangeLow  = ta.lowest(low[1], rangeLookback)

bullDisplacement =
     close > open and
     bodySize >= atr * dispMult and
     close > previousRangeHigh

bearDisplacement =
     close < open and
     bodySize >= atr * dispMult and
     close < previousRangeLow


//====================================================================
// DOL INVALIDATION / SWITCH
//====================================================================

bullProtectedBroken =
     narrative == 1 and
     not na(lastSwingLow) and
     close < lastSwingLow

bearProtectedBroken =
     narrative == -1 and
     not na(lastSwingHigh) and
     close > lastSwingHigh


bullRangeFailure =
     narrative == -1 and
     bullDisplacement

bearRangeFailure =
     narrative == 1 and
     bearDisplacement


switchBull =
     bearProtectedBroken or
     bullRangeFailure

switchBear =
     bullProtectedBroken or
     bearRangeFailure


if switchBull
    narrative := 1

if switchBear
    narrative := -1


// Recalculate protected point after potential narrative change.

protectedPoint := narrative == 1 ? lastSwingLow : lastSwingHigh


//====================================================================
// CURRENT DRAW ON LIQUIDITY
//
// First preference:
//      an available LTF liquidity pool in HTF direction.
//
// If price already traded through it:
//      fall back to the larger HTF draw.
//====================================================================

float currentDOL = na
bool dolIsHTF = false

if narrative == 1

    if not na(lastSwingHigh) and lastSwingHigh > close
        currentDOL := lastSwingHigh
        dolIsHTF := false

    else
        currentDOL := htfHigh
        dolIsHTF := true


else

    if not na(lastSwingLow) and lastSwingLow < close
        currentDOL := lastSwingLow
        dolIsHTF := false

    else
        currentDOL := htfLow
        dolIsHTF := true


//====================================================================
// LIQUIDITY RESISTANCE CLASSIFICATION
//
// LRLR = liquidity aligned with current delivery.
//
// HRLR = liquidity opposing current delivery / protected by structure.
//====================================================================

float lowResistanceLiquidity =
     narrative == 1 ? htfHigh : htfLow

float highResistanceLiquidity =
     narrative == 1 ? htfLow : htfHigh


//====================================================================
// HTF FAIR VALUE GAPS
//
// Latest confirmed HTF bullish / bearish FVG.
//====================================================================

newHTFBar = ta.change(time(htfTf)) != 0


bullFVGPresent = request.security(
     syminfo.tickerid,
     htfTf,
     low[1] > high[3],
     lookahead = barmerge.lookahead_on
)

bullFVGTop = request.security(
     syminfo.tickerid,
     htfTf,
     low[1],
     lookahead = barmerge.lookahead_on
)

bullFVGBottom = request.security(
     syminfo.tickerid,
     htfTf,
     high[3],
     lookahead = barmerge.lookahead_on
)


bearFVGPresent = request.security(
     syminfo.tickerid,
     htfTf,
     high[1] < low[3],
     lookahead = barmerge.lookahead_on
)

bearFVGTop = request.security(
     syminfo.tickerid,
     htfTf,
     low[3],
     lookahead = barmerge.lookahead_on
)

bearFVGBottom = request.security(
     syminfo.tickerid,
     htfTf,
     high[1],
     lookahead = barmerge.lookahead_on
)


//====================================================================
// FVG BOXES
//
// Only keep the most recent bullish and bearish HTF gap.
//====================================================================

var box bullFVGBox = na
var box bearFVGBox = na

if showFVG and newHTFBar and bullFVGPresent

    if not na(bullFVGBox)
        box.delete(bullFVGBox)

    bullFVGBox := box.new(
         left = bar_index,
         top = bullFVGTop,
         right = bar_index + 1,
         bottom = bullFVGBottom,
         border_color = color.new(bullColor, 35),
         border_width = 1,
         bgcolor = bullSoft,
         text = "HTF BULL GAP",
         text_color = color.new(textColor, 15),
         text_size = size.tiny,
         text_halign = text.align_right,
         extend = extend.right
    )


if showFVG and newHTFBar and bearFVGPresent

    if not na(bearFVGBox)
        box.delete(bearFVGBox)

    bearFVGBox := box.new(
         left = bar_index,
         top = bearFVGTop,
         right = bar_index + 1,
         bottom = bearFVGBottom,
         border_color = color.new(bearColor, 35),
         border_width = 1,
         bgcolor = bearSoft,
         text = "HTF BEAR GAP",
         text_color = color.new(textColor, 15),
         text_size = size.tiny,
         text_halign = text.align_right,
         extend = extend.right
    )


//====================================================================
// OBJECTS
//====================================================================

var line dolLine = na
var label dolLabel = na

var line protectedLine = na
var label protectedLabel = na

var line lrlrLine = na
var label lrlrLabel = na

var line hrlrLine = na
var label hrlrLabel = na


//====================================================================
// CURRENT DOL
//====================================================================

if barstate.islast

    if not na(dolLine)
        line.delete(dolLine)

    if not na(dolLabel)
        label.delete(dolLabel)

    if showLTFDOL and not na(currentDOL)

        dolLine := line.new(
             bar_index - 20,
             currentDOL,
             bar_index + 10,
             currentDOL,
             extend = extend.right,
             color = narrative == 1 ? bullColor : bearColor,
             width = 2
        )

        string dolText =
             dolIsHTF ?
             (narrative == 1 ? "HTF DOL ↑" : "HTF DOL ↓") :
             (narrative == 1 ? "LTF DOL ↑" : "LTF DOL ↓")

        dolLabel := label.new(
             bar_index + 3,
             currentDOL,
             dolText,
             style = label.style_none,
             textcolor = narrative == 1 ? bullColor : bearColor,
             size = size.small
        )


//====================================================================
// PROTECTED POINT
//====================================================================

if barstate.islast

    if not na(protectedLine)
        line.delete(protectedLine)

    if not na(protectedLabel)
        label.delete(protectedLabel)

    if showProtected and not na(protectedPoint)

        protectedLine := line.new(
             bar_index - 15,
             protectedPoint,
             bar_index + 10,
             protectedPoint,
             extend = extend.right,
             color = neutralColor,
             width = 1,
             style = line.style_dashed
        )

        protectedLabel := label.new(
             bar_index + 3,
             protectedPoint,
             narrative == 1 ? "PROTECTED LOW" : "PROTECTED HIGH",
             style = label.style_none,
             textcolor = neutralColor,
             size = size.tiny
        )


//====================================================================
// HTF LIQUIDITY CLASSIFICATION
//====================================================================

if barstate.islast

    if not na(lrlrLine)
        line.delete(lrlrLine)

    if not na(lrlrLabel)
        label.delete(lrlrLabel)

    if not na(hrlrLine)
        line.delete(hrlrLine)

    if not na(hrlrLabel)
        label.delete(hrlrLabel)


    if showHTFLiquidity

        //--------------------------------
        // LOW RESISTANCE LIQUIDITY
        //--------------------------------

        lrlrLine := line.new(
             bar_index - 30,
             lowResistanceLiquidity,
             bar_index + 10,
             lowResistanceLiquidity,
             extend = extend.right,
             color = color.new(neutralColor, 25),
             width = 1
        )

        lrlrLabel := label.new(
             bar_index + 3,
             lowResistanceLiquidity,
             narrative == 1 ? "LRLR • BSL" : "LRLR • SSL",
             style = label.style_none,
             textcolor = neutralColor,
             size = size.tiny
        )


        //--------------------------------
        // HIGH RESISTANCE LIQUIDITY
        //--------------------------------

        hrlrLine := line.new(
             bar_index - 30,
             highResistanceLiquidity,
             bar_index + 10,
             highResistanceLiquidity,
             extend = extend.right,
             color = color.new(neutralColor, 55),
             width = 1,
             style = line.style_dotted
        )

        hrlrLabel := label.new(
             bar_index + 3,
             highResistanceLiquidity,
             narrative == 1 ? "HRLR • SSL" : "HRLR • BSL",
             style = label.style_none,
             textcolor = color.new(neutralColor, 30),
             size = size.tiny
        )
