//@version=6
indicator("MACD-V", shorttitle = "MACD-V", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // signal line color
LEVELS_COLOR      = #787b86 // lifecycle zone borders and zero line color
FILL_VALUE_TRANSP = 50      // gradient transparency at the MACD-V value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line
HIST_GROW_TRANSP  = 40      // histogram transparency while the gap to the signal line widens
HIST_FADE_TRANSP  = 70      // histogram transparency once the gap narrows

// Lifecycle zones of the normalized scale - Spiroglou's reading of where a momentum move sits in its life
ZONE_OVEREXTENDED_UP   =  2 // beyond the upper overextension border
ZONE_TRENDING_UP       =  1 // between the upper neutral and overextension borders
ZONE_NEUTRAL           =  0 // inside the neutral zone
ZONE_TRENDING_DOWN     = -1 // between the lower neutral and overextension borders
ZONE_OVEREXTENDED_DOWN = -2 // beyond the lower overextension border

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput          = input.source(close, "Source", group = "Settings",
     tooltip = "Price series fed into the fast and slow exponential averages. Closing prices are the standard choice.")

fastLengthInput   = input.int(12, "Fast Length", minval = 1, group = "Settings",
     tooltip = "Length of the fast exponential average of the MACD engine. The default of 12 is inherited from Gerald Appel's original MACD.")

slowLengthInput   = input.int(26, "Slow Length", minval = 1, group = "Settings",
     tooltip = "Length of the slow exponential average. The classic MACD line subtracts this average from the fast one. The default of 26 is inherited from MACD.")

atrLengthInput    = input.int(26, "ATR Length", minval = 1, group = "Settings",
     tooltip = "Length of the Average True Range the EMA spread is divided by. This division is Spiroglou's normalization - momentum is restated as a percentage of the instrument's typical true range, so readings mean the same thing on any symbol, timeframe or era, which is what makes fixed levels possible. The published default is 26, matching the slow average.")

signalLengthInput = input.int(9, "Signal Length", minval = 1, group = "Settings",
     tooltip = "Length of the exponential average of MACD-V forming the signal line. The default of 9 is inherited from MACD.")

overextUpInput    = input.float(150, "Overextension +", minval = 0, step = 5, group = "Lifecycle Zones",
     tooltip = "Upper overextension border. Beyond it a move is stretched relative to its own volatility - exhaustion risk rather than an automatic fade, and strong trends can hold beyond it for a while. Spiroglou framed the published convention of +150 around the default lengths, so heavy retuning weakens the case for the standard bands.")

neutralUpInput    = input.float(50, "Neutral Zone +", minval = 0, step = 5, group = "Lifecycle Zones",
     tooltip = "Upper border of the neutral zone. Between the neutral borders momentum is weak and signal-line crosses are the most noise-prone. The published convention is +50.")

neutralDownInput  = input.float(-50, "Neutral Zone -", maxval = 0, step = 5, group = "Lifecycle Zones",
     tooltip = "Lower border of the neutral zone, mirroring the upper border below zero. The published convention is -50.")

overextDownInput  = input.float(-150, "Overextension -", maxval = 0, step = 5, group = "Lifecycle Zones",
     tooltip = "Lower overextension border, mirroring the upper border below zero. The published convention is -150.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Color of the MACD-V line, gradient fill and histogram above the zero line.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Color of the MACD-V line, gradient fill and histogram below the zero line.")

signalColorInput  = input.color(SIGNAL_COLOR, "Signal Line", group = "Style",
     tooltip = "Color of the signal line, the exponential average of MACD-V.")

levelsColorInput  = input.color(LEVELS_COLOR, "Levels Color", group = "Style",
     tooltip = "Color of the dashed lifecycle zone borders and of the dotted zero line.")

showHistInput     = input.bool(true, "Show Histogram", group = "Style",
     tooltip = "Displays the histogram (MACD-V minus signal line) as columns. Bright columns mark a gap that is still widening, faded columns mark a gap already narrowing back toward the signal line.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the zero line and the MACD-V line with a vertical gradient, fully transparent at zero and strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Classic MACD engine - the fast and slow exponential averages of price and their spread, in price units
fastEma = ta.ema(srcInput, fastLengthInput)
slowEma = ta.ema(srcInput, slowLengthInput)

// Volatility normalization - the spread is divided by the Average True Range and scaled to percent, restating
// momentum as a percentage of the instrument's typical true range. A given reading then means the same thing on
// any symbol, timeframe or era, so the fixed lifecycle levels apply everywhere without re-calibration. When
// volatility expands faster than the spread, readings compress - MACD-V measures momentum relative to prevailing
// volatility rather than absolute speed. A dead-flat window would divide by zero, so it maps to na instead
atrValue = ta.atr(atrLengthInput)
macdV    = atrValue > 0 ? 100 * (fastEma - slowEma) / atrValue : na

// Signal line and histogram - carried over unchanged from the parent MACD
signalLine = ta.ema(macdV, signalLengthInput)
histogram  = macdV - signalLine

// Lifecycle zone of the current reading - neutral inside the +/-50-style borders, trending between the neutral
// and overextension borders, overextended beyond the +/-150-style borders
zone = switch
    na(macdV)                 => int(na)
    macdV > overextUpInput    => ZONE_OVEREXTENDED_UP
    macdV > neutralUpInput    => ZONE_TRENDING_UP
    macdV >= neutralDownInput => ZONE_NEUTRAL
    macdV >= overextDownInput => ZONE_TRENDING_DOWN
    =>                           ZONE_OVEREXTENDED_DOWN

zoneChange = not na(zone) and not na(zone[1]) and zone != zone[1]

// MACD-inherited signal grammar, weighted by zone - signal-line crosses inside the neutral zone are the
// noise-prone ones, so the weighted events only fire once the cross lands clear of the neutral borders
bullCross = ta.crossover(macdV, signalLine)
bearCross = ta.crossunder(macdV, signalLine)

outsideNeutral    = macdV > neutralUpInput or macdV < neutralDownInput
bullCrossWeighted = bullCross and outsideNeutral
bearCrossWeighted = bearCross and outsideNeutral

zeroCrossUp   = ta.crossover(macdV, 0)
zeroCrossDown = ta.crossunder(macdV, 0)

// Overextension traversal - entering the stretch zones and unwinding back out of them
overextUpEntry   = ta.crossover(macdV, overextUpInput)
overextUpExit    = ta.crossunder(macdV, overextUpInput)
overextDownEntry = ta.crossunder(macdV, overextDownInput)
overextDownExit  = ta.crossover(macdV, overextDownInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// Histogram shading encodes gap direction - bright while MACD-V pulls away from its signal line, faded once
// the gap narrows back toward it
histExpanding   = histogram >= 0 ? histogram > histogram[1] : histogram < histogram[1]
histStrongColor = histogram >= 0 ? color.new(bullColorInput, HIST_GROW_TRANSP) : color.new(bearColorInput, HIST_GROW_TRANSP)
histSoftColor   = histogram >= 0 ? color.new(bullColorInput, HIST_FADE_TRANSP) : color.new(bearColorInput, HIST_FADE_TRANSP)
histColor       = histExpanding ? histStrongColor : histSoftColor

plot(showHistInput ? histogram : na, "Histogram", style = plot.style_columns, color = histColor)

plot(signalLine, "Signal Line", color = signalColorInput, linewidth = 1)

macdPlotId = plot(macdV, "MACD-V", color = macdV > 0 ? bullColorInput : bearColorInput, linewidth = 1)

zeroPlotId = plot(0, "Zero Anchor", editable = false, display = display.none)

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the MACD-V value
fillTopColor    = macdV > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_ZERO_TRANSP)
fillBottomColor = macdV > 0 ? color.new(bullColorInput, FILL_ZERO_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(macdPlotId, zeroPlotId, top_value = math.max(macdV, 0), bottom_value = math.min(macdV, 0), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Zero-line Gradient Fill")

// Dashed lifecycle zone borders and dotted zero line - the fixed map the ATR normalization makes meaningful
hline(overextUpInput, "Overextension +", levelsColorInput, hline.style_dashed)
hline(neutralUpInput, "Neutral Zone +", levelsColorInput, hline.style_dashed)
hline(0, "Zero Line", color.new(levelsColorInput, 50), hline.style_dotted)
hline(neutralDownInput, "Neutral Zone -", levelsColorInput, hline.style_dashed)
hline(overextDownInput, "Overextension -", levelsColorInput, hline.style_dashed)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullCross, "Bullish Signal Cross", "MACD-V crossed above its signal line on {{ticker}} - weight the cross by the lifecycle zone it fired in ({{interval}})")
alertcondition(bearCross, "Bearish Signal Cross", "MACD-V crossed below its signal line on {{ticker}} - weight the cross by the lifecycle zone it fired in ({{interval}})")
alertcondition(bullCrossWeighted, "Bullish Signal Cross Outside Neutral Zone", "MACD-V crossed above its signal line outside the neutral zone on {{ticker}} - a higher-conviction cross clear of the noise band ({{interval}})")
alertcondition(bearCrossWeighted, "Bearish Signal Cross Outside Neutral Zone", "MACD-V crossed below its signal line outside the neutral zone on {{ticker}} - a higher-conviction cross clear of the noise band ({{interval}})")
alertcondition(zeroCrossUp, "Bullish Zero Cross", "MACD-V crossed above zero on {{ticker}} - the fast EMA is back above the slow one ({{interval}})")
alertcondition(zeroCrossDown, "Bearish Zero Cross", "MACD-V crossed below zero on {{ticker}} - the fast EMA dropped under the slow one ({{interval}})")
alertcondition(overextUpEntry, "Upside Overextension Entry", "MACD-V rose above its upper overextension border on {{ticker}} - stretched relative to its own volatility, exhaustion risk rather than an automatic fade ({{interval}})")
alertcondition(overextUpExit, "Upside Overextension Exit", "MACD-V fell back below its upper overextension border on {{ticker}} - the upside stretch is unwinding ({{interval}})")
alertcondition(overextDownEntry, "Downside Overextension Entry", "MACD-V fell below its lower overextension border on {{ticker}} - stretched relative to its own volatility, exhaustion risk rather than an automatic fade ({{interval}})")
alertcondition(overextDownExit, "Downside Overextension Exit", "MACD-V rose back above its lower overextension border on {{ticker}} - the downside stretch is unwinding ({{interval}})")
alertcondition(zoneChange, "Lifecycle Zone Change", "MACD-V moved into a new lifecycle zone on {{ticker}} - reweight momentum signals accordingly ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
