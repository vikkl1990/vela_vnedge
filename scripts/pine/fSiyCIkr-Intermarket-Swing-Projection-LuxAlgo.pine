//@version=6
indicator('Intermarket Swing Projection [LuxAlgo]','LuxAlgo - Intermarket Swing Projection', overlay = true, max_lines_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
GREEN               = #089981
RED                 = #F23645
SILVER              = color.silver

DOTTED              = 'Dotted'
DASHED              = 'Dashed'
SOLID               = 'Solid'

COLOR_AVERAGE       = 'Average'
COLOR_PIVOTS        = 'Pivots'

STYLE_GROUP         = 'Style'

EM_SPACE            = ' '

colorModeSpacing    = EM_SPACE+EM_SPACE
colorModeTag        = 'Color Mode'+colorModeSpacing

customAssetInput    = input.symbol(     'TVC:SPX',      'Ticker')
customAssetTFInput  = input.timeframe(  '',             'Timeframe')
showLastInput       = input.int(        10,             'Show Last',    minval = 2, maxval = 500)
swingLengthInput    = input.int(        20,             'Pivot Length', minval = 2)
multiplierInput     = input.float(      1.0,            'Spread',       step = 0.25)
backpaintInput      = input.bool(       true,           'Backpaint')

showZigzagInput     = input.bool(       true,           'Show ZigZag',  group = STYLE_GROUP, inline = 'zigzag')
zigzagStyleInput    = input.string(     SOLID,          '',             group = STYLE_GROUP, inline = 'zigzag', options = [DOTTED,DASHED,SOLID])

showLevelsInput     = input.bool(       true,           'Show Levels',  group = STYLE_GROUP, inline = 'levels')
levelsStyleInput    = input.string(     SOLID,          '',             group = STYLE_GROUP, inline = 'levels', options = [DOTTED,DASHED,SOLID])
colorModeInput      = input.string(     COLOR_PIVOTS,   colorModeTag,   group = STYLE_GROUP, options = [COLOR_AVERAGE,COLOR_PIVOTS])
bullishColorInput   = input.color(      GREEN,          'Bullish',      group = STYLE_GROUP)
bearishColorInput   = input.color(      RED,            'Bearish',      group = STYLE_GROUP)
zigzagColorInput    = input.color(      SILVER,         'ZigZag',       group = STYLE_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
pivotDetection(length, showLast)=>    
    var bool lastPivotWasHigh   = true
    var array<int> times        = array.new<int>()
    var array<float> prices     = array.new<float>()
    int currentTime             = time[backpaintInput ? length : 0]
    float ph                    = ta.pivothigh(length, length)
    float pl                    = ta.pivotlow(length, length)

    if not na(ph) and not lastPivotWasHigh
        lastPivotWasHigh := true        
        times.unshift(currentTime)
        prices.unshift(ph)

        if times.size() > showLast            
            times.pop()
            prices.pop()
                        
    if not na(pl) and lastPivotWasHigh
        lastPivotWasHigh := false
        times.unshift(currentTime)
        prices.unshift(pl)

        if times.size() > showLast
            times.pop()        
            prices.pop()

    [prices,times]

style(string style) =>
    switch style
        DOTTED  => line.style_dotted
        DASHED  => line.style_dashed
        SOLID   => line.style_solid

plotDrawings(array<float> prices,array<float> assetPrices, array<int> assetTimes) =>
    var polyline zigzag                     = na
    var array<line> lines                   = array.new<line>()
    array<chart.point> standarizedPoints    = array.new<chart.point>()
    standarizedPrices                       = assetPrices.standardize()
    float average                           = prices.avg()
    float deviation                         = prices.stdev()
    float levelsDeviation                   = prices.stdev() * multiplierInput

    for eachLine in lines
        eachLine.delete()

    for [index,score] in standarizedPrices
        int currentTime = assetTimes.get(index)

        if showZigzagInput
            float currentPrice = average + score * deviation            
            standarizedPoints.push(chart.point.new(currentTime,na,currentPrice))

        if showLevelsInput
            float levelPrice    = average + score * levelsDeviation
            color pivotColor    = score > standarizedPrices.get(index == 0 ? 1 : index - 1) ? bearishColorInput : bullishColorInput
            color customColor   = colorModeInput == COLOR_AVERAGE ? (score <= 0 ? bullishColorInput : bearishColorInput) : pivotColor
            lines.push(line.new(chart.point.new(currentTime,na,levelPrice), chart.point.new(last_bar_time,na,levelPrice), xloc.bar_time, color = customColor, style = style(levelsStyleInput)))

    zigzag.delete()
    zigzag := polyline.new(standarizedPoints,xloc = xloc.bar_time,line_color = zigzagColorInput, line_style = style(zigzagStyleInput))

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
[prices,_]                  = pivotDetection(swingLengthInput, showLastInput)
[assetPrices,assetTimes]    = request.security(customAssetInput, customAssetTFInput, pivotDetection(swingLengthInput, showLastInput))

if barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed)
    if showZigzagInput or showLevelsInput
        plotDrawings(prices,assetPrices,assetTimes)

//---------------------------------------------------------------------------------------------------------------------}