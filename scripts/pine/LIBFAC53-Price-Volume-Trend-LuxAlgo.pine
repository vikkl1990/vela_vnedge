//@version=6
indicator("Price Volume Trend", "PVT", overlay = false, format = format.volume)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SETTINGS_GROUP = "Settings"
STYLE_GROUP    = "Style"

BULL_COLOR    = #089981 // PVT rising - volume-weighted pressure to the upside
BEAR_COLOR    = #f23645 // PVT falling
NEUTRAL_COLOR = #787b86 // flat PVT
ACCENT_COLOR  = #ff9800 // the signal line - the one accent

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
showSignalInput   = input.bool(false, "Signal Line", group = SETTINGS_GROUP, tooltip = "Display a moving average of PVT acting as a signal line")
signalTypeInput   = input.string("SMA", "Signal Type", options = ["SMA", "EMA"], group = SETTINGS_GROUP, tooltip = "Moving average type used for the signal line")
signalLengthInput = input.int(21, "Signal Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Number of bars used to compute the signal line")

pvtColorInput    = input.color(NEUTRAL_COLOR, "PVT Color", group = STYLE_GROUP, tooltip = "Color of the PVT line while it is flat")
bullColorInput   = input.color(BULL_COLOR, "Rising", inline = "slope", group = STYLE_GROUP, tooltip = "Color of the PVT line while it rises bar to bar")
bearColorInput   = input.color(BEAR_COLOR, "Falling", inline = "slope", group = STYLE_GROUP, tooltip = "Color of the PVT line while it falls bar to bar")
signalColorInput = input.color(ACCENT_COLOR, "Signal Color", group = STYLE_GROUP, tooltip = "Color of the signal line")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
pvt = ta.pvt

signalSma = ta.sma(pvt, signalLengthInput)
signalEma = ta.ema(pvt, signalLengthInput)

signal = switch signalTypeInput
    "SMA" => signalSma
    "EMA" => signalEma

crossUp   = ta.crossover(pvt, signal)
crossDown = ta.crossunder(pvt, signal)

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
pvtColor = pvt > nz(pvt[1], pvt) ? bullColorInput : pvt < nz(pvt[1], pvt) ? bearColorInput : pvtColorInput

plot(pvt, "PVT", pvtColor, 2)
plot(showSignalInput ? signal : na, "Signal", signalColorInput)

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Bullish Cross", "PVT crossed above the signal line")
alertcondition(crossDown, "Bearish Cross", "PVT crossed below the signal line")
//----------------------------------------------------------------------------------------------------------------------}
