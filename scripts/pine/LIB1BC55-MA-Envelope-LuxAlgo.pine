//@version=6
indicator("MA Envelope", "MA Env", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SETTINGS_GROUP = "Settings"
STYLE_GROUP    = "Style"

BULL_COLOR    = #089981 // lower band (support) and the basis while price holds above it
BEAR_COLOR    = #f23645 // upper band (resistance) and the basis while price sits below it
NEUTRAL_COLOR = #787b86

BAND_TRANSP = 30 // band line transparency
FILL_TRANSP = 90 // envelope interior transparency
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
maTypeInput  = input.string("SMA", "MA Type", options = ["SMA", "EMA", "WMA", "RMA (SMMA)", "HMA", "VWMA"], group = SETTINGS_GROUP, tooltip = "Moving average type used as the envelope basis.")
lengthInput  = input.int(20, "Length", minval = 2, group = SETTINGS_GROUP, tooltip = "Number of bars in the basis moving average.")
srcInput     = input.source(close, "Source", group = SETTINGS_GROUP, tooltip = "Price series the basis moving average is calculated on.")
percentInput = input.float(2.5, "Percent", minval = 0, step = 0.1, group = SETTINGS_GROUP, tooltip = "Envelope offset as a percentage of the basis. Upper = basis * (1 + percent / 100), lower = basis * (1 - percent / 100).")

bullColorInput  = input.color(BULL_COLOR, "Bullish", inline = "colors", group = STYLE_GROUP, tooltip = "Color of the lower band and of the basis while price holds above it.")
bearColorInput  = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = STYLE_GROUP, tooltip = "Color of the upper band and of the basis while price sits below it.")
basisColorInput = input.color(NEUTRAL_COLOR, "Basis", group = STYLE_GROUP, tooltip = "Color of the basis moving average line while price sits exactly on it.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
smaValue  = ta.sma(srcInput, lengthInput)
emaValue  = ta.ema(srcInput, lengthInput)
wmaValue  = ta.wma(srcInput, lengthInput)
rmaValue  = ta.rma(srcInput, lengthInput)
hmaValue  = ta.hma(srcInput, lengthInput)
vwmaValue = ta.vwma(srcInput, lengthInput)

basis = switch maTypeInput
    "SMA"        => smaValue
    "EMA"        => emaValue
    "WMA"        => wmaValue
    "RMA (SMMA)" => rmaValue
    "HMA"        => hmaValue
    "VWMA"       => vwmaValue

offsetFraction = percentInput / 100
upperBand = basis * (1 + offsetFraction)
lowerBand = basis * (1 - offsetFraction)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
basisColor = close > basis ? bullColorInput : close < basis ? bearColorInput : basisColorInput

plot(basis, "Basis", basisColor)

upperPlotId = plot(upperBand, "Upper", color.new(bearColorInput, BAND_TRANSP))
lowerPlotId = plot(lowerBand, "Lower", color.new(bullColorInput, BAND_TRANSP))

fill(upperPlotId, lowerPlotId, top_value = upperBand, bottom_value = lowerBand, top_color = color.new(bearColorInput, FILL_TRANSP), bottom_color = color.new(bullColorInput, FILL_TRANSP), title = "Envelope Fill")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
upperCrossover  = ta.crossover(close, upperBand)
lowerCrossunder = ta.crossunder(close, lowerBand)

alertcondition(upperCrossover, "Upper Band Crossover", "Price crossed above the upper envelope band")
alertcondition(lowerCrossunder, "Lower Band Crossunder", "Price crossed below the lower envelope band")
//----------------------------------------------------------------------------------------------------------------------}
