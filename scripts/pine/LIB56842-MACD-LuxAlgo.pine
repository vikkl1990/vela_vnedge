//@version=6
indicator("MACD", "MACD", overlay = false, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR = #089981
BEAR_COLOR = #f23645
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
fastLengthInput   = input.int(12, "Fast Length", minval = 1, group = "Settings", tooltip = "Length of the fast EMA.")
slowLengthInput   = input.int(26, "Slow Length", minval = 1, group = "Settings", tooltip = "Length of the slow EMA.")
signalLengthInput = input.int(9, "Signal Smoothing", minval = 1, group = "Settings", tooltip = "Length of the EMA applied to the MACD line to obtain the signal line.")
srcInput          = input.source(close, "Source", group = "Settings", tooltip = "Price series used to compute the fast and slow EMAs.")

macdColorInput      = input.color(#5b9cf6, "MACD Line", group = "Style", tooltip = "Color of the MACD line.")
signalColorInput    = input.color(#ff9800, "Signal Line", group = "Style", tooltip = "Color of the signal line.")
growAboveColorInput = input.color(BULL_COLOR, "Grow Above", inline = "Above", group = "Style", tooltip = "Histogram color when above zero and rising.")
fallAboveColorInput = input.color(color.new(BULL_COLOR, 50), "Fall Above", inline = "Above", group = "Style", tooltip = "Histogram color when above zero and falling.")
growBelowColorInput = input.color(color.new(BEAR_COLOR, 50), "Grow Below", inline = "Below", group = "Style", tooltip = "Histogram color when below zero and rising.")
fallBelowColorInput = input.color(BEAR_COLOR, "Fall Below", inline = "Below", group = "Style", tooltip = "Histogram color when below zero and falling.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
fastEma = ta.ema(srcInput, fastLengthInput)
slowEma = ta.ema(srcInput, slowLengthInput)

macdLine   = fastEma - slowEma
signalLine = ta.ema(macdLine, signalLengthInput)
histogram  = macdLine - signalLine
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
histRising = histogram > nz(histogram[1], histogram)
histColor  = histogram >= 0 ? (histRising ? growAboveColorInput : fallAboveColorInput) : (histRising ? growBelowColorInput : fallBelowColorInput)

hline(0, "Zero Line", color = #787b86, linestyle = hline.style_dashed)

plot(histogram, "Histogram", histColor, style = plot.style_columns)
plot(macdLine, "MACD", macdColorInput)
plot(signalLine, "Signal", signalColorInput)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
signalCrossUp   = ta.crossover(macdLine, signalLine)
signalCrossDown = ta.crossunder(macdLine, signalLine)
zeroCrossUp     = ta.crossover(macdLine, 0)
zeroCrossDown   = ta.crossunder(macdLine, 0)

alertcondition(signalCrossUp, "Bullish Cross", "MACD crossed above the signal line")
alertcondition(signalCrossDown, "Bearish Cross", "MACD crossed below the signal line")
alertcondition(zeroCrossUp, "Bullish Zero Cross", "MACD crossed above zero")
alertcondition(zeroCrossDown, "Bearish Zero Cross", "MACD crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
