//@version=6
indicator("DSS Bressert", "DSS Bressert", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

float  MID_LEVEL = 50
string EMA_MODE  = "EMA"
string SMA_MODE  = "SMA"
string LAG_MODE  = "Lagged Copy"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

stochLengthInput  = input.int(13, "Stochastic Length", minval = 2, group = "Settings", tooltip = "Lookback of the highest high / lowest low range used by the first stochastic pass. Common values sit around 10 to 21.")
secondLengthInput = input.int(13, "Second Pass Length", minval = 2, group = "Settings", tooltip = "Lookback used to re-normalize the smoothed series in the second stochastic pass. The classic formulation uses the same lookback for both passes.")
smoothLengthInput = input.int(8, "Smoothing Length", minval = 1, group = "Settings", tooltip = "Period of the moving average applied after each stochastic pass. Common values sit around 3 to 9.")
smoothTypeInput   = input.string(EMA_MODE, "Smoothing Type", options = [EMA_MODE, SMA_MODE], group = "Settings", tooltip = "Moving average family used for both smoothing steps. EMA is the classic DSS Bressert choice; some implementations smooth with SMAs.")
srcInput          = input.source(close, "Source", group = "Settings", tooltip = "Price series located within the bar high/low range by the first stochastic pass.")

showSignalInput   = input.bool(true, "Show Signal Line", group = "Signal Line", tooltip = "Plots a companion line whose crossovers with the DSS read like a slow stochastic built on the double-smoothed base.")
signalTypeInput   = input.string(EMA_MODE, "Signal Type", options = [EMA_MODE, LAG_MODE], group = "Signal Line", tooltip = "Signal construction: an EMA of the DSS, or a lagged copy of the DSS itself.")
signalLengthInput = input.int(3, "Signal Length", minval = 1, maxval = 50, group = "Signal Line", tooltip = "EMA period of the signal line, or the number of bars of lag when using a lagged copy.")

obInput = input.float(80, "Overbought", minval = 50, maxval = 100, step = 1, group = "Overbought / Oversold", tooltip = "Level beyond which the oscillator is considered overbought; a downward turn from above it is a bearish hook.")
osInput = input.float(20, "Oversold", minval = 0, maxval = 50, step = 1, group = "Overbought / Oversold", tooltip = "Level below which the oscillator is considered oversold; an upward turn from below it is a bullish hook.")

bullColorInput   = input.color(#089981, "Bullish", inline = "direction", group = "Style")
bearColorInput   = input.color(#f23645, "Bearish", inline = "direction", group = "Style")
signalColorInput = input.color(#787b86, "Signal", group = "Style")
showFillInput    = input.bool(true, "Gradient Fill", group = "Style", tooltip = "Vertical gradient between the 50 midline and the DSS, bullish above the midline and bearish below it.")
showHooksInput   = input.bool(false, "Hook Markers", group = "Style", tooltip = "Marks hook turning points beyond the overbought/oversold levels directly on the oscillator.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// Position of `src` within the `hi`/`lo` range over `len` bars, scaled to 0-100.
// Holds its previous value (seeded at the midline) while the range is flat or not yet defined.
stochNorm(series float src, series float hi, series float lo, simple int len) =>
    lowestVal  = ta.lowest(lo, len)
    highestVal = ta.highest(hi, len)
    span       = highestVal - lowestVal
    float norm = na
    norm := not na(span) and span != 0 and not na(src) ? 100 * (src - lowestVal) / span : nz(norm[1], MID_LEVEL)
    norm

// Moving average selected by `mode`, both averages running on every bar to keep their internal state consistent.
smoothMa(series float src, simple int len, simple string mode) =>
    emaValue = ta.ema(src, len)
    smaValue = ta.sma(src, len)
    mode == EMA_MODE ? emaValue : smaValue

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{

// First pass: raw stochastic of price, then smoothing
rawStoch      = stochNorm(srcInput, high, low, stochLengthInput)
smoothedStoch = smoothMa(rawStoch, smoothLengthInput, smoothTypeInput)

// Second pass: stochastic normalization of the smoothed series, then smoothing
dssRaw = stochNorm(smoothedStoch, smoothedStoch, smoothedStoch, secondLengthInput)
dss    = smoothMa(dssRaw, smoothLengthInput, smoothTypeInput)

// Signal line: EMA of the DSS, or a lagged copy of it
emaSignal    = ta.ema(dss, signalLengthInput)
laggedSignal = dss[signalLengthInput]
signalLine   = signalTypeInput == EMA_MODE ? emaSignal : laggedSignal

// Hooks: the DSS turns back while beyond the overbought/oversold levels
turnedUp   = dss > dss[1] and dss[1] <= dss[2]
turnedDown = dss < dss[1] and dss[1] >= dss[2]
bullHook   = not na(dss[2]) and dss[1] < osInput and turnedUp
bearHook   = not na(dss[2]) and dss[1] > obInput and turnedDown

// Signal crossings and level entries
bullCross = ta.crossover(dss, signalLine)
bearCross = ta.crossunder(dss, signalLine)
enteredOb = ta.crossover(dss, obInput)
enteredOs = ta.crossunder(dss, osInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{

dssColor = dss > MID_LEVEL ? bullColorInput : bearColorInput

hline(obInput, "Overbought Level", color.new(chart.fg_color, 50), hline.style_dashed)
hline(osInput, "Oversold Level", color.new(chart.fg_color, 50), hline.style_dashed)
hline(MID_LEVEL, "Midline", color.new(chart.fg_color, 80), hline.style_dotted)

dssPlotId = plot(dss, "DSS", dssColor, 1)
plot(showSignalInput ? signalLine : na, "Signal Line", signalColorInput, 1)
midPlotId = plot(MID_LEVEL, "Midline Anchor", color = na, editable = false, display = display.none)

// Vertical gradient from the midline to the DSS, fully transparent at the midline
fillTopColor    = dss > MID_LEVEL ? color.new(bullColorInput, 50)  : color.new(bearColorInput, 100)
fillBottomColor = dss > MID_LEVEL ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)

fill(dssPlotId, midPlotId, top_value = math.max(nz(dss, MID_LEVEL), MID_LEVEL), bottom_value = math.min(nz(dss, MID_LEVEL), MID_LEVEL), top_color = showFillInput ? fillTopColor : na, bottom_color = showFillInput ? fillBottomColor : na, title = "Gradient Fill")

plotshape(showHooksInput and bullHook ? dss[1] : na, "Bullish Hook", shape.circle, location.absolute, bullColorInput, offset = -1, size = size.tiny)
plotshape(showHooksInput and bearHook ? dss[1] : na, "Bearish Hook", shape.circle, location.absolute, bearColorInput, offset = -1, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bullHook, title = "Bullish Hook (Oversold)", message = "DSS Bressert turned back up from below the oversold level")
alertcondition(bearHook, title = "Bearish Hook (Overbought)", message = "DSS Bressert turned back down from above the overbought level")
alertcondition(bullCross, title = "Bullish Signal Cross", message = "DSS Bressert crossed above its signal line")
alertcondition(bearCross, title = "Bearish Signal Cross", message = "DSS Bressert crossed below its signal line")
alertcondition(enteredOb, title = "Entered Overbought", message = "DSS Bressert crossed above the overbought level")
alertcondition(enteredOs, title = "Entered Oversold", message = "DSS Bressert crossed below the oversold level")

//---------------------------------------------------------------------------------------------------------------------}
