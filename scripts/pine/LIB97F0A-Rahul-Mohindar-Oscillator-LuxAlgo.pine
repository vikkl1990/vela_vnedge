//@version=6
indicator("Rahul Mohindar Oscillator"
  , shorttitle = "Rahul Mohindar Oscillator"
  , overlay    = false
  , format     = format.price
  , precision  = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
int SMA_PASSES = 10

color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color ST2_COLOR  = #ff9800 // SwingTrd 2, the faster line
color ST3_COLOR  = #ab47bc // SwingTrd 3, the slower line - a second hue so the pair reads apart
color ZERO_COLOR = color.new(#787b86, 50)

string SETTINGS_GROUP = "Settings"
string SIGNALS_GROUP  = "Signals"
string STYLE_GROUP    = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source"
  , tooltip = "Price series fed into the chained averages and the range normalization. The original construction uses the close."
  , group   = SETTINGS_GROUP)

smaLengthInput = input.int(2, "Chained SMA Length", minval = 1
  , tooltip = "Length of each of the ten successive simple moving average passes, each pass smoothing the output of the one before. The original construction uses 2."
  , group   = SETTINGS_GROUP)

rangeLengthInput = input.int(10, "Range Lookback", minval = 1
  , tooltip = "Number of bars over which the highest and lowest source values are taken to normalize the displacement from the chained average."
  , group   = SETTINGS_GROUP)

swingEmaLengthInput = input.int(30, "SwingTrd EMA Length", minval = 1
  , tooltip = "Exponential smoothing length applied at both SwingTrd stages: SwingTrd 2 = EMA(SwingTrd 1) and SwingTrd 3 = EMA(SwingTrd 2)."
  , group   = SETTINGS_GROUP)

rmoEmaLengthInput = input.int(81, "RMO EMA Length", minval = 1
  , tooltip = "Exponential smoothing length applied to SwingTrd 1 to produce the RMO bias line."
  , group   = SETTINGS_GROUP)

showSignalsInput = input.bool(true, "Signal Markers"
  , tooltip = "Marks SwingTrd 2/3 crossovers that agree with the RMO's side of zero — the packaged system's buy and sell signals."
  , group   = SIGNALS_GROUP)

chartArrowsInput = input.bool(false, "Arrows on Price Chart"
  , tooltip = "Additionally paints the buy and sell arrows on the main price chart, mirroring the original platform implementation."
  , group   = SIGNALS_GROUP)

showSwingInput = input.bool(true, "Show SwingTrd Lines", group = STYLE_GROUP)

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "bias", group = STYLE_GROUP)
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "bias", group = STYLE_GROUP)

st2ColorInput = input.color(ST2_COLOR, "SwingTrd 2", inline = "swing", group = STYLE_GROUP)
st3ColorInput = input.color(ST3_COLOR, "SwingTrd 3", inline = "swing", group = STYLE_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Chain of ten successive simple moving averages, each pass smoothing the previous pass's output
smaPass1  = ta.sma(srcInput, smaLengthInput)
smaPass2  = ta.sma(smaPass1, smaLengthInput)
smaPass3  = ta.sma(smaPass2, smaLengthInput)
smaPass4  = ta.sma(smaPass3, smaLengthInput)
smaPass5  = ta.sma(smaPass4, smaLengthInput)
smaPass6  = ta.sma(smaPass5, smaLengthInput)
smaPass7  = ta.sma(smaPass6, smaLengthInput)
smaPass8  = ta.sma(smaPass7, smaLengthInput)
smaPass9  = ta.sma(smaPass8, smaLengthInput)
smaPass10 = ta.sma(smaPass9, smaLengthInput)

baseAverage = (smaPass1 + smaPass2 + smaPass3 + smaPass4 + smaPass5 + smaPass6 + smaPass7 + smaPass8 + smaPass9 + smaPass10) / SMA_PASSES

// Displacement from the chained average, normalized by the recent source range
swingRange = ta.highest(srcInput, rangeLengthInput) - ta.lowest(srcInput, rangeLengthInput)

float swingTrd1 = na(baseAverage) ? na : swingRange == 0 ? 0 : 100 * (srcInput - baseAverage) / swingRange

// Exponential smoothing stages
swingTrd2 = ta.ema(swingTrd1, swingEmaLengthInput)
swingTrd3 = ta.ema(swingTrd2, swingEmaLengthInput)
rmo       = ta.ema(swingTrd1, rmoEmaLengthInput)

// Packaged system events
crossUp    = ta.crossover(swingTrd2, swingTrd3)
crossDown  = ta.crossunder(swingTrd2, swingTrd3)
buySignal  = crossUp   and rmo > 0
sellSignal = crossDown and rmo < 0
bullRegime = ta.crossover(rmo, 0)
bearRegime = ta.crossunder(rmo, 0)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
rmoPlotId  = plot(rmo, "RMO", rmo > 0 ? bullColorInput : bearColorInput, 2)
zeroPlotId = plot(0, "Zero Line", ZERO_COLOR)

fill(rmoPlotId, zeroPlotId
  , top_value    = math.max(rmo, 0)
  , bottom_value = math.min(rmo, 0)
  , top_color    = rmo > 0 ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)
  , bottom_color = rmo > 0 ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)
  , title        = "RMO Gradient Fill")

plot(swingTrd2, "SwingTrd 2", showSwingInput ? st2ColorInput : na)
plot(swingTrd3, "SwingTrd 3", showSwingInput ? st3ColorInput : na)

plotshape(showSignalsInput and buySignal ? swingTrd3 : na, "Buy Signal", shape.triangleup, location.absolute, bullColorInput, size = size.tiny)
plotshape(showSignalsInput and sellSignal ? swingTrd3 : na, "Sell Signal", shape.triangledown, location.absolute, bearColorInput, size = size.tiny)

plotshape(chartArrowsInput and buySignal, "Buy Arrow (Price Chart)", shape.triangleup, location.belowbar, bullColorInput, size = size.tiny, force_overlay = true)
plotshape(chartArrowsInput and sellSignal, "Sell Arrow (Price Chart)", shape.triangledown, location.abovebar, bearColorInput, size = size.tiny, force_overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(buySignal, "Buy Signal", "RMO buy: SwingTrd 2 crossed above SwingTrd 3 with the RMO above zero")
alertcondition(sellSignal, "Sell Signal", "RMO sell: SwingTrd 2 crossed below SwingTrd 3 with the RMO below zero")
alertcondition(bullRegime, "Bullish Regime", "RMO crossed above zero — bullish regime, long setups permitted")
alertcondition(bearRegime, "Bearish Regime", "RMO crossed below zero — bearish regime, short setups permitted")

//---------------------------------------------------------------------------------------------------------------------}
