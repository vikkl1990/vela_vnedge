// ==============================================================================================
// 🟢 REGION: Helpers
// ==============================================================================================

// 🔹 Math / Normalized Momentum Scale (NMS)
f_dir(float _x) =>
    _x > 0.0 ? 1.0 : _x < 0.0 ? -1.0 : 0.0

f_lerp(float _x, float _x0, float _x1, float _y0, float _y1) =>
    _x1 == _x0 ? _y1 : _y0 + ((_x - _x0) / (_x1 - _x0)) * (_y1 - _y0)

f_cap100(float _x) =>
    math.min(math.max(_x, 0.0), 100.0)

f_wideSemanticMag(float _x) =>
    float _m = math.abs(_x)
    float _y =
         _m <= 0.70 ? f_lerp(_m, 0.00, 0.70, 0.0, 34.0) :
         _m <= 1.25 ? f_lerp(_m, 0.70, 1.25, 34.0, 55.0) :
         _m <= 2.50 ? f_lerp(_m, 1.25, 2.50, 55.0, 65.0) :
         _m <= 4.00 ? f_lerp(_m, 2.50, 4.00, 65.0, 75.0) :
         _m <= 7.00 ? f_lerp(_m, 4.00, 7.00, 75.0, 89.0) :
         _m <= 12.0 ? f_lerp(_m, 7.00, 12.0, 89.0, 95.0) :
         _m <= 20.0 ? f_lerp(_m, 12.0, 20.0, 95.0, 100.0) :
                      100.0
    f_cap100(_y)

f_wideSemantic(float _x) =>
    f_dir(_x) * f_wideSemanticMag(_x)

// 🔹 Canonical Auto-Next-HTF ladder
f_getNextTf() =>
    float _mult = timeframe.multiplier
    string _nextTf = "1D"

    if timeframe.isseconds
        if timeframe.period == "1S"
            _nextTf := "5S"
        else if timeframe.period == "5S"
            _nextTf := "10S"
        else if timeframe.period == "10S"
            _nextTf := "15S"
        else if timeframe.period == "15S"
            _nextTf := "30S"
        else if timeframe.period == "30S"
            _nextTf := "45S"
        else
            _nextTf := "1"
    else if timeframe.isminutes
        if _mult <= 1
            _nextTf := "3"
        else if _mult <= 2
            _nextTf := "4"
        else if _mult <= 3
            _nextTf := "5"
        else if _mult <= 5
            _nextTf := "10"
        else if _mult <= 10
            _nextTf := "15"
        else if _mult <= 15
            _nextTf := "30"
        else if _mult <= 30
            _nextTf := "60"
        else if _mult <= 60
            _nextTf := "120"
        else if _mult <= 120
            _nextTf := "240"
        else if _mult <= 240
            _nextTf := "480"
        else
            _nextTf := "D"
    else if timeframe.isdaily
        _nextTf := "1W"
    else if timeframe.isweekly
        _nextTf := "2W"
    else if timeframe.ismonthly
        _nextTf := "2M"

    _nextTf

f_prettyTfValue(string _tf) =>
    float _numericTf = str.tonumber(_tf)
    if not na(_numericTf)
        int _minutes = int(_numericTf)
        _minutes >= 60 and _minutes % 60 == 0 ?
         str.tostring(int(_minutes / 60)) + "h" :
         str.tostring(_minutes) + "m"
    else
        _tf == "D" or _tf == "1D" ? "1D" :
         _tf == "W" or _tf == "1W" ? "1W" :
         _tf == "2W" ? "2W" :
         _tf == "M" or _tf == "1M" ? "1M" :
         _tf == "2M" ? "2M" :
         str.lower(_tf)

// 🔹 Native higher-timeframe MACD Histogram → ATR14 → NMS
f_macdHistWideSemanticNative(
     int _fastLen,
     int _slowLen,
     int _signalLen) =>
    float _fast = ta.ema(close, _fastLen)
    float _slow = ta.ema(close, _slowLen)
    float _macd = _fast - _slow
    float _signal = ta.ema(_macd, _signalLen)
    float _hist = _macd - _signal
    float _atr = ta.atr(ATR_LEN)
    float _histAtr = not na(_atr) and _atr > 0.0 ? _hist / _atr : na
    not na(_histAtr) ? f_wideSemantic(_histAtr) : na

// 🔹 Formatting
f_padding(int _n) =>
    str.repeat(" ", math.max(_n, 0))

f_plain1Trim(float _v) =>
    if na(_v)
        "n/a"
    else
        float _oneDecimal = math.round(_v * 10.0) / 10.0
        float _whole = math.round(_oneDecimal)
        math.abs(_oneDecimal - _whole) < 0.0001 ?
         str.tostring(int(_whole)) :
         str.tostring(_oneDecimal, "#.0")

f_barsAgoText(int _bars) =>
    na(_bars) ? "n/a" : str.tostring(_bars) + "ba"

// 🔹 Dynamic right-label lane allocator
f_buildRightLabelPads(
     array<bool> _visible,
     array<int> _extraAfter,
     bool _grouped,
     int _basePad,
     int _step) =>
    int _count = array.size(_visible)
    array<int> _pads = array.new_int(_count, _basePad)
    int _cursor = _basePad

    if _count > 0 and not _grouped
        for _index = 0 to _count - 1
            array.set(_pads, _index, _cursor)

            if array.get(_visible, _index)
                int _extra =
                     _index < array.size(_extraAfter) ?
                     array.get(_extraAfter, _index) :
                     0

                _cursor += _step + _extra

    _pads

// 🔹 Label lifecycle
f_syncRightValueLabel(
     label _label,
     bool _show,
     int _x,
     float _y,
     string _text,
     color _textColor) =>
    label _out = _label
    color _invisible = color.new(color.black, 100)
    bool _valid = _show and not na(_x) and not na(_y)

    if _valid
        if na(_out)
            _out := label.new(
                 _x, _y, _text,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_left,
                 color=_invisible,
                 textcolor=_textColor,
                 textalign=text.align_center,
                 size=size.normal)
        else
            label.set_xy(_out, _x, _y)
            label.set_text(_out, _text)
            label.set_color(_out, _invisible)
            label.set_textcolor(_out, _textColor)
            label.set_style(_out, label.style_label_left)
            label.set_textalign(_out, text.align_center)
            label.set_size(_out, size.normal)
    else if not na(_out)
        label.delete(_out)
        _out := na

    _out

// 🔹 Focused guide palette
f_guideStateColor(float _level, float _osc) =>
    na(_osc) ?
     (_level > 0.0 ? COL_GUIDE_POS_PENDING :
      _level < 0.0 ? COL_GUIDE_NEG_BELOW :
      COL_GUIDE_ZERO) :
     _level >= 100.0 - DIRECTION_EPS and _osc >= 100.0 - DIRECTION_EPS ?
     COL_POS_EXTREME :
     _level <= -100.0 + DIRECTION_EPS and _osc <= -100.0 + DIRECTION_EPS ?
     COL_NEG_EXTREME :
     _level < 0.0 ?
     (_osc <= _level ? COL_GUIDE_NEG_BELOW : COL_GUIDE_NEG_PASSED) :
     _level > 0.0 ?
     (_osc > _level ? COL_GUIDE_POS_PASSED : COL_GUIDE_POS_PENDING) :
     COL_GUIDE_ZERO

f_guideCaptureRadius(array<float> _levels, int _index) =>
    int _count = array.size(_levels)
    float _level = array.get(_levels, _index)
    float _leftGap =
         _index > 0 ?
         math.abs(_level - array.get(_levels, _index - 1)) :
         na
    float _rightGap =
         _index < _count - 1 ?
         math.abs(array.get(_levels, _index + 1) - _level) :
         na

    float _nearestGap =
         na(_leftGap) ?
         _rightGap :
         na(_rightGap) ?
         _leftGap :
         math.min(_leftGap, _rightGap)

    math.max(GUIDE_PROXIMITY_FLOOR, _nearestGap * GUIDE_PROXIMITY_FRACTION)

f_guideLabelText(float _level) =>
    str.tostring(int(math.round(_level)))

// 🔹 Guide line lifecycle
f_syncGuideLine(
     line _line,
     bool _show,
     int _left,
     int _right,
     float _level,
     color _color) =>
    line _out = _line
    bool _valid = _show and not na(_level) and _right >= _left

    if _valid
        color _finalColor = color.new(_color, in_guideLineTransp)
        string _style = math.abs(_level) < 0.000001 ? line.style_dashed : line.style_dotted

        if na(_out)
            _out := line.new(
                 _left, _level,
                 _right, _level,
                 xloc=xloc.bar_index,
                 extend=extend.none,
                 color=_finalColor,
                 style=_style,
                 width=in_guideLineWidth)
        else
            line.set_xy1(_out, _left, _level)
            line.set_xy2(_out, _right, _level)
            line.set_color(_out, _finalColor)
            line.set_style(_out, _style)
            line.set_width(_out, in_guideLineWidth)
    else if not na(_out)
        line.delete(_out)
        _out := na

    _out

f_syncGuideLabel(
     label _label,
     bool _show,
     int _x,
     float _level,
     color _color,
     int _pad) =>
    string _text = f_padding(_pad) + f_guideLabelText(_level)
    f_syncRightValueLabel(_label, _show, _x, _level, _text, _color)

// ==============================================================================================
// 🔴 END REGION: Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Continuous Momentum Kernels
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Shared ATR14
// ──────────────────────────────────────────────

// 🔹 Volatility denominator executes continuously
float atr14 = ta.atr(ATR_LEN)

// ──────────────────────────────────────────────
// 🟦 Subregion: Standard Price MACD 12/26/9
// ──────────────────────────────────────────────

// 🔹 Native raw MACD family
float macdFast = ta.ema(close, in_macdFastLen)
float macdSlow = ta.ema(close, in_macdSlowLen)
float macdRaw = macdFast - macdSlow
float macdSignalRaw = ta.ema(macdRaw, in_macdSignalLen)
float macdHistRaw = macdRaw - macdSignalRaw

// 🔹 ATR14 → NMS adapter
float macdAtr = not na(atr14) and atr14 > 0.0 ? macdRaw / atr14 : na
float macdSignalAtr = not na(atr14) and atr14 > 0.0 ? macdSignalRaw / atr14 : na
float macdHistAtr = not na(atr14) and atr14 > 0.0 ? macdHistRaw / atr14 : na

float macdLine = not na(macdAtr) ? f_wideSemantic(macdAtr) : na
float macdSignalLine = not na(macdSignalAtr) ? f_wideSemantic(macdSignalAtr) : na
float macdHist = not na(macdHistAtr) ? f_wideSemantic(macdHistAtr) : na

// 🔹 Pair order + inclusive crossover age
bool macdAboveSignal = not na(macdRaw) and not na(macdSignalRaw) and macdRaw > macdSignalRaw
bool macdSignalAbove = not na(macdRaw) and not na(macdSignalRaw) and macdSignalRaw > macdRaw
bool macdCross = ta.cross(macdRaw, macdSignalRaw)

int macdBarsSinceCrossRaw = ta.barssince(macdCross)
int macdBarsSinceCross =
     na(macdBarsSinceCrossRaw) ?
     na :
     macdBarsSinceCrossRaw + 1

color macdPairColor =
     macdAboveSignal ? in_macdBullColor :
     macdSignalAbove ? in_macdBearColor :
     in_macdNeutralColor

color macdHistColor =
     macdHistRaw > 0.0 ? in_macdBullColor :
     macdHistRaw < 0.0 ? in_macdBearColor :
     in_macdNeutralColor

// ──────────────────────────────────────────────
// 🟦 Subregion: LazyBear-Style Impulse 34/9
// ──────────────────────────────────────────────

// 🔹 Native raw Impulse family
float impulseSmmaHigh = ta.rma(high, in_impulseMaLen)
float impulseSmmaLow = ta.rma(low, in_impulseMaLen)

float impulseZlemaEma1 = ta.ema(hlc3, in_impulseMaLen)
float impulseZlemaEma2 = ta.ema(impulseZlemaEma1, in_impulseMaLen)
float impulseMidline = impulseZlemaEma1 + (impulseZlemaEma1 - impulseZlemaEma2)

float impulseRaw =
     impulseMidline > impulseSmmaHigh ?
     impulseMidline - impulseSmmaHigh :
     impulseMidline < impulseSmmaLow ?
     impulseMidline - impulseSmmaLow :
     0.0

float impulseSignalRaw = ta.sma(impulseRaw, in_impulseSignalLen)
float impulseHistRaw = impulseRaw - impulseSignalRaw

// 🔹 ATR14 → same NMS adapter
float impulseAtr = not na(atr14) and atr14 > 0.0 ? impulseRaw / atr14 : na
float impulseSignalAtr = not na(atr14) and atr14 > 0.0 ? impulseSignalRaw / atr14 : na
float impulseHistAtr = not na(atr14) and atr14 > 0.0 ? impulseHistRaw / atr14 : na

float impulseLine = not na(impulseAtr) ? f_wideSemantic(impulseAtr) : na
float impulseSignalLine = not na(impulseSignalAtr) ? f_wideSemantic(impulseSignalAtr) : na
float impulseHist = not na(impulseHistAtr) ? f_wideSemantic(impulseHistAtr) : na

// 🔹 Pair order + inclusive crossover age
bool impulseAboveSignal = not na(impulseRaw) and not na(impulseSignalRaw) and impulseRaw > impulseSignalRaw
bool impulseSignalAbove = not na(impulseRaw) and not na(impulseSignalRaw) and impulseSignalRaw > impulseRaw
bool impulseCross = ta.cross(impulseRaw, impulseSignalRaw)

int impulseBarsSinceCrossRaw = ta.barssince(impulseCross)
int impulseBarsSinceCross =
     na(impulseBarsSinceCrossRaw) ?
     na :
     impulseBarsSinceCrossRaw + 1

color impulsePairColor =
     impulseAboveSignal ? in_impulseBullColor :
     impulseSignalAbove ? in_impulseBearColor :
     in_impulseNeutralColor

color impulseHistColor =
     impulseHistRaw > 0.0 ? in_impulseBullColor :
     impulseHistRaw < 0.0 ? in_impulseBearColor :
     in_impulseNeutralColor

// ==============================================================================================
// 🔴 END REGION: Continuous Momentum Kernels
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Developing HTF MACD Histogram
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Native Auto-Next-HTF Transport
// ──────────────────────────────────────────────

// 🔹 Developing only: native HTF calculation, gaps_off, lookahead_off, no confirmed [1] offset
string macdHistHtfTf = f_getNextTf()

float macdHistHtfDeveloping =
     request.security(
         syminfo.tickerid,
         macdHistHtfTf,
         f_macdHistWideSemanticNative(
             in_macdFastLen,
             in_macdSlowLen,
             in_macdSignalLen),
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_off)

color macdHistHtfColor =
     macdHistHtfDeveloping > 0.0 ? in_macdBullColor :
     macdHistHtfDeveloping < 0.0 ? in_macdBearColor :
     in_macdNeutralColor

// ==============================================================================================
// 🔴 END REGION: Developing HTF MACD Histogram
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Price Pane Overlay Mapping
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Histogram-Owned Price Color
// ──────────────────────────────────────────────

// 🔹 One source selector drives both force-overlay candles and the hardcoded follow line
bool useImpulsePriceOverlay = in_priceOverlaySource == PRICE_SOURCE_IMPULSE_HIST

color pricePaneBaseColor =
     useImpulsePriceOverlay ?
     impulseHistColor :
     macdHistColor

color pricePaneCandleBodyColor = color.new(pricePaneBaseColor, in_priceCandleBodyTransp)
color pricePaneCandleWickColor = color.new(pricePaneBaseColor, in_priceCandleWickTransp)
color pricePaneCandleBorderColor = color.new(pricePaneBaseColor, in_priceCandleBorderTransp)

// ==============================================================================================
// 🔴 END REGION: Price Pane Overlay Mapping
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Plot Presentation
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Impulse Histogram — Deep Backdrop
// ──────────────────────────────────────────────

// 🔹 Original LazyBear sh = md - sb, independently mapped to Normalized Momentum Scale
plot(
     showImpulseHist ? impulseHist : na,
     title="Impulse Hist — NMS",
     color=color.new(impulseHistColor, in_impulseHistTransp),
     linewidth=in_impulseHistWidth,
     style=in_impulseHistStyle == STYLE_COLUMNS ? plot.style_columns :
           in_impulseHistStyle == STYLE_HISTOGRAM ? plot.style_histogram :
           plot.style_line,
     histbase=0.0,
     show_last=in_impulseLastN)

// ──────────────────────────────────────────────
// 🟦 Subregion: Impulse / Signal — Backdrop
// ──────────────────────────────────────────────

// 🔹 Transparent anchors keep fill geometry independent from visible plot style
plotImpulseFillAnchor =
     plot(
         showImpulseFill ? impulseLine : na,
         title="Impulse Fill Anchor",
         color=color.new(impulsePairColor, 100),
         linewidth=1,
         style=plot.style_line,
         show_last=in_impulseLastN)

plotImpulseSignalFillAnchor =
     plot(
         showImpulseFill ? impulseSignalLine : na,
         title="Impulse Signal Fill Anchor",
         color=color.new(impulsePairColor, 100),
         linewidth=1,
         style=plot.style_line,
         show_last=in_impulseLastN)

fill(
     plotImpulseFillAnchor,
     plotImpulseSignalFillAnchor,
     color=showImpulseFill ? color.new(impulsePairColor, in_impulseFillTransp) : na,
     title="Impulse / Signal Fill",
     show_last=in_impulseLastN,
     fillgaps=false)

// 🔹 Visible Impulse pair
plot(
     showImpulsePair ? impulseLine : na,
     title="ImpulseMACD — NMS",
     color=color.new(impulsePairColor, in_impulseTransp),
     linewidth=in_impulseWidth,
     style=in_impulseMacdStyle == STYLE_COLUMNS ? plot.style_columns :
           in_impulseMacdStyle == STYLE_HISTOGRAM ? plot.style_histogram :
           plot.style_line,
     histbase=0.0,
     show_last=in_impulseLastN)

plot(
     showImpulsePair ? impulseSignalLine : na,
     title="Impulse Signal — NMS",
     color=color.new(impulsePairColor, in_impulseTransp),
     linewidth=in_impulseWidth,
     style=in_impulseSignalStyle == STYLE_COLUMNS ? plot.style_columns :
           in_impulseSignalStyle == STYLE_HISTOGRAM ? plot.style_histogram :
           plot.style_line,
     histbase=0.0,
     show_last=in_impulseLastN)

// ──────────────────────────────────────────────
// 🟦 Subregion: Actual MACD Histogram — Foreground Histogram
// ──────────────────────────────────────────────

// 🔹 True raw MACD - Signal histogram sits in front of the Impulse backdrop
plot(
     showMacdHist ? macdHist : na,
     title="MACD Histogram — NMS",
     color=color.new(macdHistColor, in_histTransp),
     linewidth=in_histWidth,
     style=in_histStyle == STYLE_COLUMNS ? plot.style_columns :
           in_histStyle == STYLE_HISTOGRAM ? plot.style_histogram :
           plot.style_line,
     histbase=0.0,
     show_last=in_histLastN)

// ──────────────────────────────────────────────
// 🟦 Subregion: Developing HTF MACD Histogram
// ──────────────────────────────────────────────

// 🔹 Developing HTF context overlays the chart-TF histogram
plot(
     showHtfMacdHist ? macdHistHtfDeveloping : na,
     title="Developing HTF MACD Histogram — NMS",
     color=color.new(macdHistHtfColor, in_htfHistTransp),
     linewidth=in_htfHistWidth,
     style=in_htfHistStyle == STYLE_COLUMNS ? plot.style_columns :
           in_htfHistStyle == STYLE_HISTOGRAM ? plot.style_histogram :
           plot.style_line,
     histbase=0.0,
     show_last=in_htfHistLastN)

// ──────────────────────────────────────────────
// 🟦 Subregion: MACD / Signal — Foreground
// ──────────────────────────────────────────────

// 🔹 Transparent anchors keep fill geometry independent from visible plot style
plotMacdFillAnchor =
     plot(
         showMacdFill ? macdLine : na,
         title="MACD Fill Anchor",
         color=color.new(macdPairColor, 100),
         linewidth=1,
         style=plot.style_line,
         show_last=in_macdLastN)

plotMacdSignalFillAnchor =
     plot(
         showMacdFill ? macdSignalLine : na,
         title="MACD Signal Fill Anchor",
         color=color.new(macdPairColor, 100),
         linewidth=1,
         style=plot.style_line,
         show_last=in_macdLastN)

fill(
     plotMacdFillAnchor,
     plotMacdSignalFillAnchor,
     color=showMacdFill ? color.new(macdPairColor, in_macdFillTransp) : na,
     title="MACD / Signal Fill",
     show_last=in_macdLastN,
     fillgaps=false)

// 🔹 Visible MACD pair
plot(
     showMacdPair ? macdLine : na,
     title="MACD — NMS",
     color=color.new(macdPairColor, in_macdTransp),
     linewidth=in_macdWidth,
     style=in_macdStyle == STYLE_COLUMNS ? plot.style_columns :
           in_macdStyle == STYLE_HISTOGRAM ? plot.style_histogram :
           plot.style_line,
     histbase=0.0,
     show_last=in_macdLastN)

plot(
     showMacdPair ? macdSignalLine : na,
     title="MACD Signal — NMS",
     color=color.new(macdPairColor, in_macdTransp),
     linewidth=in_macdWidth,
     style=in_macdStyle == STYLE_COLUMNS ? plot.style_columns :
           in_macdStyle == STYLE_HISTOGRAM ? plot.style_histogram :
           plot.style_line,
     histbase=0.0,
     show_last=in_macdLastN)

// ==============================================================================================
// 🔴 END REGION: Plot Presentation
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Price Pane Overlay
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Force-Overlay Price Candles
// ──────────────────────────────────────────────

// 🔹 Actual chart OHLC; selected MACD/Impulse histogram supplies color only
plotcandle(
     open=showPricePaneCandles ? open : na,
     high=showPricePaneCandles ? high : na,
     low=showPricePaneCandles ? low : na,
     close=showPricePaneCandles ? close : na,
     title="NMS Price Pane Candles",
     color=showPricePaneCandles ? pricePaneCandleBodyColor : na,
     wickcolor=showPricePaneCandles ? pricePaneCandleWickColor : na,
     bordercolor=showPricePaneCandles ? pricePaneCandleBorderColor : na,
     force_overlay=true,
     editable=false)

// ──────────────────────────────────────────────
// 🟦 Subregion: Hardcoded Bar-to-Bar Follow Line
// ──────────────────────────────────────────────

// 🔹 Actual chart Close; fixed Last N = 2 and follows the same selected histogram color source
plot(
     close,
     title="NMS Price Bar-to-Bar Follow Line",
     color=color.new(pricePaneBaseColor, PRICE_FOLLOW_TRANSP),
     linewidth=PRICE_FOLLOW_WIDTH,
     style=plot.style_linebr,
     show_last=PRICE_FOLLOW_LAST_N,
     force_overlay=true,
     editable=false)

// ==============================================================================================
// 🔴 END REGION: Price Pane Overlay
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Unified Right-Side Label Padding
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Visible-Label Lane Allocation
// ──────────────────────────────────────────────

// 🔹 Individual = one lane per visible label with +2 EM after ImpulseMACD and -1 EM on Impulse Signal; Grouped = one shared lane
int guideRightPad = in_rightLabelBasePad
int macdHistRightPad = in_rightLabelBasePad
int macdRightPad = in_rightLabelBasePad
int macdSignalRightPad = in_rightLabelBasePad
int htfMacdHistRightPad = in_rightLabelBasePad
int impulseHistRightPad = in_rightLabelBasePad
int impulseRightPad = in_rightLabelBasePad
int impulseSignalRightPad = in_rightLabelBasePad

if barstate.islast
    array<bool> _rightLabelVisible =
         array.from(
             showGuideLabels,
             showMacdHistRightLabel and not na(macdHist),
             showMacdRightLabels and not na(macdLine),
             showMacdRightLabels and not na(macdSignalLine),
             showHtfMacdHistRightLabel and not na(macdHistHtfDeveloping),
             showImpulseHistRightLabel and not na(impulseHist),
             showImpulseRightLabels and not na(impulseLine),
             showImpulseRightLabels and not na(impulseSignalLine))

    array<int> _rightLabelExtraAfter =
         array.from(
             0,
             0,
             0,
             0,
             0,
             0,
             2,
             0)

    array<int> _rightLabelPads =
         f_buildRightLabelPads(
             _rightLabelVisible,
             _rightLabelExtraAfter,
             useGroupedRightLabelPadding,
             in_rightLabelBasePad,
             in_rightLabelPadStep)

    guideRightPad := array.get(_rightLabelPads, 0)
    macdHistRightPad := array.get(_rightLabelPads, 1)
    macdRightPad := array.get(_rightLabelPads, 2)
    macdSignalRightPad := array.get(_rightLabelPads, 3)
    htfMacdHistRightPad := array.get(_rightLabelPads, 4)
    impulseHistRightPad := array.get(_rightLabelPads, 5)
    impulseRightPad := array.get(_rightLabelPads, 6)
    impulseSignalRightPad :=
         useGroupedRightLabelPadding ?
         array.get(_rightLabelPads, 7) :
         math.max(array.get(_rightLabelPads, 7) - 1, 0)

// ==============================================================================================
// 🔴 END REGION: Unified Right-Side Label Padding
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Focused Semantic Guide Ladder
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Focused Visible-Geometry Guide Selection
// ──────────────────────────────────────────────

// 🔹 Fixed semantic ladder
var array<float> guideLevels =
     array.from(
         -100.0, -89.0, -75.0, -55.0, -34.0, -13.0,
         0.0,
         13.0, 34.0, 55.0, 75.0, 89.0, 100.0)

var array<line> guideLines = array.new_line()
var array<label> guideLabels = array.new_label()

if barstate.islast and guideEngineActive
    int _count = array.size(guideLevels)

    // 🔹 Build focus geometry only from families that are actually visible on the pane
    array<float> _visibleGuideValues = array.new_float()

    bool _macdPairGeometryVisible = showMacdPair or showMacdFill
    bool _impulsePairGeometryVisible = showImpulsePair or showImpulseFill

    if _macdPairGeometryVisible
        if not na(macdLine)
            array.push(_visibleGuideValues, macdLine)

        if not na(macdSignalLine)
            array.push(_visibleGuideValues, macdSignalLine)

    if showMacdHist and not na(macdHist)
        array.push(_visibleGuideValues, macdHist)

    if showHtfMacdHist and not na(macdHistHtfDeveloping)
        array.push(_visibleGuideValues, macdHistHtfDeveloping)

    if _impulsePairGeometryVisible
        if not na(impulseLine)
            array.push(_visibleGuideValues, impulseLine)

        if not na(impulseSignalLine)
            array.push(_visibleGuideValues, impulseSignalLine)

    if showImpulseHist and not na(impulseHist)
        array.push(_visibleGuideValues, impulseHist)

    float _visibleMax = na
    float _visibleMin = na
    int _visibleCount = array.size(_visibleGuideValues)

    if _visibleCount > 0
        for _valueIndex = 0 to _visibleCount - 1
            float _value = array.get(_visibleGuideValues, _valueIndex)
            _visibleMax := na(_visibleMax) ? _value : math.max(_visibleMax, _value)
            _visibleMin := na(_visibleMin) ? _value : math.min(_visibleMin, _value)

    int _rightIndex = bar_index
    int _leftIndex = math.max(bar_index - in_guideLineLastN + 1, 0)

    if showGuideLines
        while array.size(guideLines) < _count
            array.push(guideLines, na)

    if showGuideLabels
        while array.size(guideLabels) < _count
            array.push(guideLabels, na)

    // 🔹 Zero always shows; every other rung must be close to at least one visible plotted value
    for _index = 0 to _count - 1
        float _level = array.get(guideLevels, _index)
        bool _isZero = math.abs(_level) < 0.000001
        float _captureRadius = f_guideCaptureRadius(guideLevels, _index)

        bool _nearVisibleGeometry = false

        if not _isZero and _visibleCount > 0
            for _valueIndex = 0 to _visibleCount - 1
                float _value = array.get(_visibleGuideValues, _valueIndex)

                if math.abs(_value - _level) <= _captureRadius
                    _nearVisibleGeometry := true
                    break

        bool _ceilingEligible =
             _level >= 100.0 - DIRECTION_EPS ?
             not na(_visibleMax) and _visibleMax > 95.0 :
             _level <= -100.0 + DIRECTION_EPS ?
             not na(_visibleMin) and _visibleMin < -95.0 :
             true

        bool _showLevel =
             _isZero or
             (_nearVisibleGeometry and _ceilingEligible)

        color _guideColor = f_guideStateColor(_level, macdLine)

        if showGuideLines
            line _line = array.get(guideLines, _index)
            _line :=
                 f_syncGuideLine(
                     _line,
                     _showLevel,
                     _leftIndex,
                     _rightIndex,
                     _level,
                     _guideColor)
            array.set(guideLines, _index, _line)

        if showGuideLabels
            label _label = array.get(guideLabels, _index)
            _label :=
                 f_syncGuideLabel(
                     _label,
                     _showLevel,
                     _rightIndex,
                     _level,
                     _guideColor,
                     guideRightPad)
            array.set(guideLabels, _index, _label)

else if barstate.islast and not guideEngineActive
    int _lineCount = array.size(guideLines)
    if _lineCount > 0
        for _i = 0 to _lineCount - 1
            line _line = array.get(guideLines, _i)
            if not na(_line)
                line.delete(_line)
                array.set(guideLines, _i, na)

    int _labelCount = array.size(guideLabels)
    if _labelCount > 0
        for _i = 0 to _labelCount - 1
            label _label = array.get(guideLabels, _i)
            if not na(_label)
                label.delete(_label)
                array.set(guideLabels, _i, na)

// ==============================================================================================
// 🔴 END REGION: Focused Semantic Guide Ladder
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: MACD / Impulse / Histogram Right-Side Labels
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Last-Bar Pair Telemetry
// ──────────────────────────────────────────────

// 🔹 Pair members share lanes and remain on true semantic coordinates
var label macdRightLabel = na
var label macdSignalRightLabel = na
var label macdHistRightLabel = na
var label htfMacdHistRightLabel = na
var label impulseRightLabel = na
var label impulseSignalRightLabel = na
var label impulseHistRightLabel = na

if barstate.islast
    string _macdSpacer = f_padding(macdRightPad)
    string _macdSignalSpacer = f_padding(macdSignalRightPad)
    string _histSpacer = f_padding(macdHistRightPad)
    string _htfHistSpacer = f_padding(htfMacdHistRightPad)
    string _impulseSpacer = f_padding(impulseRightPad)
    string _impulseSignalSpacer = f_padding(impulseSignalRightPad)
    string _impulseHistSpacer = f_padding(impulseHistRightPad)

    string _macdText =
         _macdSpacer + "MACD" + "\n" +
         _macdSpacer + f_plain1Trim(macdLine) +
         (macdAboveSignal ? "\n" + _macdSpacer + f_barsAgoText(macdBarsSinceCross) : "")

    string _macdSignalText =
         _macdSignalSpacer + "MACD" + "\n" +
         _macdSignalSpacer + "Signal" + "\n" +
         _macdSignalSpacer + f_plain1Trim(macdSignalLine) +
         (macdSignalAbove ? "\n" + _macdSignalSpacer + f_barsAgoText(macdBarsSinceCross) : "")

    string _histText =
         _histSpacer + "MACD" + "\n" +
         _histSpacer + "Hist" + "\n" +
         _histSpacer + f_plain1Trim(macdHist)

    string _htfHistText =
         _htfHistSpacer + f_prettyTfValue(macdHistHtfTf) + "\n" +
         _htfHistSpacer + "MACD" + "\n" +
         _htfHistSpacer + "Hist" + "\n" +
         _htfHistSpacer + f_plain1Trim(macdHistHtfDeveloping)

    string _impulseText =
         _impulseSpacer + "Impulse" + "\n" +
         _impulseSpacer + "MACD" + "\n" +
         _impulseSpacer + f_plain1Trim(impulseLine) +
         (impulseAboveSignal ? "\n" + _impulseSpacer + f_barsAgoText(impulseBarsSinceCross) : "")

    string _impulseSignalText =
         _impulseSignalSpacer + "Impulse" + "\n" +
         _impulseSignalSpacer + "Signal" + "\n" +
         _impulseSignalSpacer + f_plain1Trim(impulseSignalLine) +
         (impulseSignalAbove ? "\n" + _impulseSignalSpacer + f_barsAgoText(impulseBarsSinceCross) : "")

    string _impulseHistText =
         _impulseHistSpacer + "Impulse" + "\n" +
         _impulseHistSpacer + "Hist" + "\n" +
         _impulseHistSpacer + f_plain1Trim(impulseHist)

    macdRightLabel :=
         f_syncRightValueLabel(
             macdRightLabel,
             showMacdRightLabels,
             bar_index,
             macdLine,
             _macdText,
             macdPairColor)

    macdSignalRightLabel :=
         f_syncRightValueLabel(
             macdSignalRightLabel,
             showMacdRightLabels,
             bar_index,
             macdSignalLine,
             _macdSignalText,
             macdPairColor)

    macdHistRightLabel :=
         f_syncRightValueLabel(
             macdHistRightLabel,
             showMacdHistRightLabel,
             bar_index,
             macdHist,
             _histText,
             macdHistColor)

    htfMacdHistRightLabel :=
         f_syncRightValueLabel(
             htfMacdHistRightLabel,
             showHtfMacdHistRightLabel,
             bar_index,
             macdHistHtfDeveloping,
             _htfHistText,
             macdHistHtfColor)

    impulseRightLabel :=
         f_syncRightValueLabel(
             impulseRightLabel,
             showImpulseRightLabels,
             bar_index,
             impulseLine,
             _impulseText,
             impulsePairColor)

    impulseSignalRightLabel :=
         f_syncRightValueLabel(
             impulseSignalRightLabel,
             showImpulseRightLabels,
             bar_index,
             impulseSignalLine,
             _impulseSignalText,
             impulsePairColor)

    impulseHistRightLabel :=
         f_syncRightValueLabel(
             impulseHistRightLabel,
             showImpulseHistRightLabel,
             bar_index,
             impulseHist,
             _impulseHistText,
             impulseHistColor)

// ==============================================================================================
// 🔴 END REGION: MACD / Impulse / Histogram Right-Side Labels
// ==============================================================================================
