// ──────────────────────────────────────────────

// 🔹 Histogram-owned overlay source
string in_priceOverlaySource = input.string(PRICE_SOURCE_MACD_HIST, "Price Pane Color Source", options=[PRICE_SOURCE_MACD_HIST, PRICE_SOURCE_IMPULSE_HIST], group=G_PRICE_OVERLAY, tooltip=TT_PRICE_OVERLAY)

// 🔹 Force-overlay actual OHLC candles
string in_priceCandlesMode = input.string(SHOW, "Price Pane Candles", options=[SHOW, HIDE], group=G_PRICE_OVERLAY, tooltip=TT_PRICE_OVERLAY)
bool showPricePaneCandles = in_priceCandlesMode == SHOW

int in_priceCandleBodyTransp = input.int(75, "  ↳ Body Transparency", minval=0, maxval=100, group=G_PRICE_OVERLAY, active=showPricePaneCandles, tooltip=TT_PRICE_CANDLE_TRANSP)
int in_priceCandleWickTransp = input.int(0, "  ↳ Wick Transparency", minval=0, maxval=100, group=G_PRICE_OVERLAY, active=showPricePaneCandles, tooltip=TT_PRICE_CANDLE_TRANSP)
int in_priceCandleBorderTransp = input.int(0, "  ↳ Border Transparency", minval=0, maxval=100, group=G_PRICE_OVERLAY, active=showPricePaneCandles, tooltip=TT_PRICE_CANDLE_TRANSP)

