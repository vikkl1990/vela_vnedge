//@version=6
indicator("Relative Vigor Index", "RVGI", overlay = false, format = format.price, precision = 4)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(10, "Length", minval = 1, group = "Settings", tooltip = "Number of bars summed for the smoothed numerator (close - open) and denominator (high - low).")

rvgiColorInput   = input.color(#089981, "RVGI", group = "Style", tooltip = "Color of the RVGI line.")
signalColorInput = input.color(#f23645, "Signal", group = "Style", tooltip = "Color of the signal line.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
numerator   = math.sum(ta.swma(close - open), lengthInput)
denominator = math.sum(ta.swma(high - low), lengthInput)

rvgi   = denominator == 0 ? 0. : numerator / denominator
signal = ta.swma(rvgi) // fixed 4-bar symmetrically weighted signal line
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(rvgi, "RVGI", rvgiColorInput)
plot(signal, "Signal", signalColorInput)

hline(0, "Zero", color.new(#787b86, 50), hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossUp   = ta.crossover(rvgi, signal)
crossDown = ta.crossunder(rvgi, signal)

alertcondition(crossUp, "Bullish Cross", "RVGI crossed above its signal line")
alertcondition(crossDown, "Bearish Cross", "RVGI crossed below its signal line")
//----------------------------------------------------------------------------------------------------------------------}
