//@version=6
indicator("Chaikin Volatility", "CHV", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
ACCENT_COLOR  = #ff9800 // range expansion - readings above zero, the "look here" state
NEUTRAL_COLOR = #787b86 // range contraction - readings at or below zero, and the zero line

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
emaLengthInput = input.int(10, "EMA Length", minval = 1, group = "Settings", tooltip = "Length of the exponential moving average applied to the bar high-low range")
rocLengthInput = input.int(10, "ROC Length", minval = 1, group = "Settings", tooltip = "Number of bars used for the rate of change of the smoothed high-low range")

chvColorInput       = input.color(NEUTRAL_COLOR, "CHV Color", group = "Style", tooltip = "Color of the Chaikin Volatility line")
expansionColorInput = input.color(ACCENT_COLOR, "Expansion", group = "Style", tooltip = "Line and fill color while the reading is above zero - the smoothed range is wider than it was ROC Length bars ago")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
smoothedRange = ta.ema(high - low, emaLengthInput)
priorRange = smoothedRange[rocLengthInput]

chv = priorRange == 0 ? float(na) : 100 * (smoothedRange - priorRange) / priorRange

crossUp = ta.crossover(chv, 0)
crossDown = ta.crossunder(chv, 0)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - expanding range lights up, contracting range stays structural grey
chvColor = chv > 0 ? expansionColorInput : chvColorInput

chvPlotId  = plot(chv, "Chaikin Volatility", chvColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward the zero line, following the line color
fill(chvPlotId, zeroPlotId, math.max(chv, 0), math.min(chv, 0), chv > 0 ? color.new(chvColor, FILL_LINE_TRANSP) : color.new(chvColor, FILL_ZERO_TRANSP), chv > 0 ? color.new(chvColor, FILL_ZERO_TRANSP) : color.new(chvColor, FILL_LINE_TRANSP), title = "CHV Gradient")

hline(0, "Zero Line", color = NEUTRAL_COLOR, linestyle = hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Zero Cross Up", "Chaikin Volatility crossed above zero")
alertcondition(crossDown, "Zero Cross Down", "Chaikin Volatility crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
