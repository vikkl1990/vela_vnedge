//@version=6
indicator("GMMA / MA Ribbon", "GMMA", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
shortColorInput = input.color(#089981, "Short-Term EMAs", group = "Style", tooltip = "Color of the six short-term EMAs (lengths 3, 5, 8, 10, 12, 15), the group tracking short-term trader activity.")
longColorInput = input.color(#f23645, "Long-Term EMAs", group = "Style", tooltip = "Color of the six long-term EMAs (lengths 30, 35, 40, 45, 50, 60), the group tracking long-term investor activity.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
// Short-term group (trader activity)
shortEma1 = ta.ema(close, 3)
shortEma2 = ta.ema(close, 5)
shortEma3 = ta.ema(close, 8)
shortEma4 = ta.ema(close, 10)
shortEma5 = ta.ema(close, 12)
shortEma6 = ta.ema(close, 15)

// Long-term group (investor activity)
longEma1 = ta.ema(close, 30)
longEma2 = ta.ema(close, 35)
longEma3 = ta.ema(close, 40)
longEma4 = ta.ema(close, 45)
longEma5 = ta.ema(close, 50)
longEma6 = ta.ema(close, 60)

shortAverage = (shortEma1 + shortEma2 + shortEma3 + shortEma4 + shortEma5 + shortEma6) / 6
longAverage = (longEma1 + longEma2 + longEma3 + longEma4 + longEma5 + longEma6) / 6

bullishCross = ta.crossover(shortAverage, longAverage)
bearishCross = ta.crossunder(shortAverage, longAverage)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(shortEma1, "Short EMA 3", shortColorInput, 1)
plot(shortEma2, "Short EMA 5", shortColorInput, 1)
plot(shortEma3, "Short EMA 8", shortColorInput, 1)
plot(shortEma4, "Short EMA 10", shortColorInput, 1)
plot(shortEma5, "Short EMA 12", shortColorInput, 1)
plot(shortEma6, "Short EMA 15", shortColorInput, 1)

plot(longEma1, "Long EMA 30", longColorInput, 1)
plot(longEma2, "Long EMA 35", longColorInput, 1)
plot(longEma3, "Long EMA 40", longColorInput, 1)
plot(longEma4, "Long EMA 45", longColorInput, 1)
plot(longEma5, "Long EMA 50", longColorInput, 1)
plot(longEma6, "Long EMA 60", longColorInput, 1)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(bullishCross, "Bullish Ribbon Cross", "GMMA short-term average crossed above the long-term average")
alertcondition(bearishCross, "Bearish Ribbon Cross", "GMMA short-term average crossed below the long-term average")
//----------------------------------------------------------------------------------------------------------------------}
