//@version=6
indicator("Long/Short Ratio [BigBeluga]", overlay = false, max_boxes_count = 500)

// --- Color & Style Inputs ---
color bullColor    = input.color(color.teal, "Buy Color")
color bearColor    = input.color(color.maroon, "Sell Color")
bool show_dash     = input.bool(true, "Show Main Chart Dashboard", group = "UI Settings")

// --- Ratio & Smoothing Inputs ---
int change_len     = input.int(50, "Change Length", minval = 1, group = "Calculations")
int smooth_len     = input.int(15, "Smoothing Length", minval = 1, group = "Calculations")
float smoothOffset = input.float(-60.0, "Smooth Line Offset", group = "Calculations")
bool show_smooth   = input.bool(true, "Display Change Line", group = "Calculations")
bool show_mid2     = show_smooth//input.bool(true, "Display Change Mid-Line", group = "Calculations")

// --- Extreme Thresholds ---
bool show_ext      = input.bool(true, "Show Extreme Signals", group = "Extremes")
int buy_ext_val    = input.int(80, "Buy Extreme %", minval = 1, maxval = 100, group = "Extremes")
int sell_ext_val   = input.int(80, "Sell Extreme %", minval = 1, maxval = 100, group = "Extremes")

// --- Core Logic ---
float buyers       = 0
float sellers      = 0
float buy_per      = 0
float sell_per     = 0

int chart_sec = timeframe.in_seconds()
string lower_tf =
     chart_sec >= 86400  ? "60" :   
     chart_sec >= 14400  ? "15" :   
     chart_sec >= 3600   ? "5"  :   
     chart_sec >= 900    ? "1"  : "1"

// Warning 
if timeframe.in_seconds("")/60 < 5 
    label.delete(label.new(bar_index+3, hl2, "Use Higher Timeframes from\n5 min", style = label.style_label_center, color = color.orange, force_overlay = true)[1])

array<float> delta_sign = request.security_lower_tf('', lower_tf, (close > open ? volume : close < open ? -volume :0))

if delta_sign.size() > 0 
    for i = 0 to delta_sign.size() - 1
        value   = delta_sign.get(i)
        buyers  += value > 0 ? value : 0
        sellers += value < 0 ? -value : 0

    tot = buyers + sellers
    buy_per  := (buyers / tot) * 100
    sell_per := (sellers / tot) * 100

// --- Plotting Ratio (Bottom Pane) ---
plot(buy_per+sell_per, "Short Base", style = plot.style_columns, color = color.new(bearColor, 50))
plot(50, "Ratio Mid Line", style = plot.style_line, color = color.new(chart.fg_color, 50))
plot(buy_per, "Long Base", style = plot.style_columns, color = bullColor)
plot(buy_per, "Stepline", color = color.new(chart.fg_color, 20), style = plot.style_stepline, linewidth = 2)

// --- Change Line & Change Mid-Line ---
float smoothRatio = ta.hma(ta.change(buy_per, change_len), smooth_len) + smoothOffset
float midLine2    = ta.sma(smoothRatio, 500) // Replaces the heavy array.avg loop

plot(show_smooth ? smoothRatio : na, "Change Line", color = smoothRatio > smoothRatio[1] ? bullColor : bearColor, linewidth = 3)
plot(show_mid2 ? midLine2 : na, "Change Mid Line", color = chart.fg_color, style = plot.style_cross)

// --- Extreme Signals (Main Chart Overlay) ---
plotshape(show_ext and buy_per >= buy_ext_val,  "Extreme Buy",  shape.triangleup,   location.bottom, bullColor, size = size.tiny, force_overlay = true)
plotshape(show_ext and sell_per >= sell_ext_val, "Extreme Sell", shape.triangledown, location.top,    bearColor, size = size.tiny, force_overlay = true)

// --- Original Label Logic (Do Not Change) ---
if barstate.isconfirmed
    label.new(bar_index, buy_per, str.tostring(sell_per, format.percent), size = size.auto, style = label.style_label_down, color = color.new(color.black, 100))
    label.new(bar_index, buy_per, str.tostring(buy_per, format.percent), size = size.auto, style = label.style_label_up, color = color.new(color.black, 100))

if barstate.islast
    lbl1 = label.new(bar_index, buy_per, "          "+ str.tostring(sell_per, format.percent) + "    Sell", size = size.normal, style = label.style_label_down, color = color.new(color.black, 100))
    lbl2 = label.new(bar_index, buy_per, "          "+ str.tostring(buy_per, format.percent) + "    Buy", size = size.normal, style = label.style_label_up, color = color.new(color.black, 100))
    label.delete(lbl1[1]), label.delete(lbl2[1])

// --- Dashboard (Main Chart) ---
var table dash = table.new(position.top_right, 2, 2, border_width = 1, force_overlay = true)
if show_dash and barstate.islast
    table.cell(dash, 0, 0, "BUY %",  bgcolor = bullColor, text_color = color.white)
    table.cell(dash, 1, 0, str.tostring(buy_per, "0.0") + "%",  text_color = bullColor)
    table.cell(dash, 0, 1, "SELL %", bgcolor = bearColor, text_color = color.white)
    table.cell(dash, 1, 1, str.tostring(sell_per, "0.0") + "%", text_color = bearColor)