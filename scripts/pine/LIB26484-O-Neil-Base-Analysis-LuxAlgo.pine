//@version=6
indicator("O'Neil Base Analysis", "O'Neil Base Analysis", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color CLR_GHOST = #00000000

color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86
color ACCENT_COLOR  = #ff9800

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

string G_DETECT = 'Base Detection'
string G_BREAK  = 'Breakout & Risk'
string G_COUNT  = 'Base Counting'
string G_GRADE  = 'Base Quality'
string G_DASH   = 'Dashboard'
string G_STYLE  = 'Style'

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
minUptrendInput  = input.float(30, 'Prior Uptrend Minimum %', minval = 0, step = 5, group = G_DETECT, tooltip = 'Bases are continuation structures, not bottoms. The base\'s left-side high must stand at least this far above the lowest low of the uptrend lookback window — O\'Neil\'s prerequisite advance of roughly 30%.')
uptrendLenInput  = input.int(40, 'Uptrend Lookback (bars)', minval = 5, group = G_DETECT, tooltip = 'Window used to measure the prior advance. Around 40 bars on the weekly charts the methodology is designed for.')
minLenInput      = input.int(5, 'Minimum Base Length (bars)', minval = 2, group = G_DETECT, tooltip = 'A consolidation must last at least this many bars below its left-side high to qualify as a base. O\'Neil\'s shortest standard bases run about 5 weeks — apply the tool on weekly charts for the classic reading.')
maxDepthInput    = input.float(33, 'Maximum Base Depth %', minval = 5, maxval = 90, group = G_DETECT, tooltip = 'High-to-low depth cap. A consolidation correcting deeper than this is treated as a correction rather than a sound base (roughly a third is the usual limit distilled from past leaders).')
pivotMarginInput = input.float(0.1, 'Pivot Margin Above Resistance %', minval = 0, step = 0.05, group = G_DETECT, tooltip = 'The pivot buy point sits a small margin above the base\'s resistance high, expressed here in percent of that high.')

volLenInput      = input.int(10, 'Volume Average Length', minval = 1, group = G_BREAK, tooltip = 'Average-volume benchmark for breakout confirmation. 10 weekly bars is equivalent to the conventional 50-day average; use 50 on daily charts.')
volSurgeInput    = input.float(40, 'Breakout Volume Surge %', minval = 0, step = 5, group = G_BREAK, tooltip = 'A breakout through the pivot only counts as confirmed when volume runs at least this percentage above average — O\'Neil required around 40% or more.')
buyZoneInput     = input.float(5, 'Buy Zone Above Pivot %', minval = 0.5, step = 0.5, group = G_BREAK, tooltip = 'The narrow zone above the pivot bounding acceptable entries. Price extending beyond it means the entry is considered chased.')
failPctInput     = input.float(7, 'Base-Failure Stop %', minval = 1, maxval = 15, step = 0.5, group = G_BREAK, tooltip = 'A breakout that reverses and falls this far below the buy point is a base failure and an automatic sale — O\'Neil\'s fixed 7 to 8 percent loss rule.')
advTargetInput   = input.float(20, 'Breakout Resolution Gain %', minval = 5, step = 5, group = G_BREAK, tooltip = 'Once price gains this much from the buy point the breakout is treated as resolved and the failure watch ends; O\'Neil\'s follow-on selling rules take over beyond this tool\'s scope.')

stageStepInput   = input.float(20, 'Stage Increment Threshold %', minval = 5, step = 5, group = G_COUNT, tooltip = 'A new base\'s pivot must form at least this far above the prior base\'s pivot to advance the base count; otherwise it is a base-on-base carrying the same stage.')
lateStageInput   = input.int(3, 'Late-Stage Threshold', minval = 2, group = G_COUNT, tooltip = 'Bases at or beyond this count are flagged late-stage — historically the third base and beyond fail more often because the story is widely known.')

tightPctInput    = input.float(4, 'Tight Closes: Max Average Change %', minval = 0.5, step = 0.5, group = G_GRADE, tooltip = 'Average absolute bar-to-bar close change inside the base at or below this level grades as tight action, a mark of accumulation. Wide, loose action marks distribution.')
dryLenInput      = input.int(5, 'Volume Dry-Up Window (bars)', minval = 1, group = G_GRADE, tooltip = 'Recent-volume window compared against the volume average benchmark: base volume running below average marks the dry-up expected in the quiet portions of a sound base.')

showDashInput    = input.bool(true, 'Show Dashboard', group = G_DASH, tooltip = 'Summary panel with the current state, base count, pivot buy point, buy zone, failure stop and quality checks.')
dashPosInput     = input.string('Top right', 'Position', options = ['Top right', 'Top left', 'Bottom right', 'Bottom left'], group = G_DASH, tooltip = 'Dashboard location on the chart.')
dashSizeInput    = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal'], group = G_DASH, tooltip = 'Dashboard text size.')

showBoxesInput   = input.bool(true, 'Base Boxes', group = G_STYLE)
showPivotInput   = input.bool(true, 'Pivot & Stop Lines', group = G_STYLE)
showZoneInput    = input.bool(true, 'Buy Zone', group = G_STYLE)
showLabelsInput  = input.bool(true, 'Stage Labels', group = G_STYLE)
showSignalsInput = input.bool(true, 'Signal Markers', group = G_STYLE)
bullColorInput   = input.color(BULL_COLOR, 'Bullish', inline = 'c1', group = G_STYLE)
bearColorInput   = input.color(BEAR_COLOR, 'Bearish', inline = 'c1', group = G_STYLE)
lateColorInput   = input.color(ACCENT_COLOR, 'Late-Stage', inline = 'c2', group = G_STYLE)
neutralColorInput = input.color(NEUTRAL_COLOR, 'Neutral', inline = 'c2', group = G_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
ordinal(int n) =>
    n == 1 ? '1st' : n == 2 ? '2nd' : n == 3 ? '3rd' : str.tostring(n) + 'th'

lenUnit() =>
    timeframe.isweekly ? 'w' : timeframe.isdaily ? 'd' : ' bars'

fmtPrice(float value) =>
    str.tostring(value, format.mintick)

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// factors
float pivotFactor = 1 + pivotMarginInput / 100
float upFactor    = 1 + minUptrendInput / 100
float surgeFactor = 1 + volSurgeInput / 100
float stageFactor = 1 + stageStepInput / 100
float zoneFactor  = 1 + buyZoneInput / 100
float failFactor  = 1 - failPctInput / 100
float advFactor   = 1 + advTargetInput / 100

// series (every bar)
float volSmaLong  = ta.sma(nz(volume), volLenInput)
float volSmaShort = ta.sma(nz(volume), dryLenInput)
float lowestLook  = ta.lowest(low, uptrendLenInput)

// candidate base state
var float baseHigh     = na
var int   baseStartBar = na
var float baseLow      = na
var bool  baseMature   = false
var bool  uptrendOk    = false

// quality accumulators (base body since anchor)
var float sumChg   = 0.0
var int   nChg     = 0
var float upVolSum = 0.0
var int   upVolN   = 0
var float dnVolSum = 0.0
var int   dnVolN   = 0

// base counting state
var int   stageCount  = 0
var float lastPivot   = na
var float lastBaseLow = na
var int   basesTotal  = 0

// live breakout watch state
var bool  watchLive      = false
var bool  watchConfirmed = false
var float buyPoint       = na
var float zoneTop        = na
var float stopLevel      = na
var float watchBaseTop   = na
var int   breakoutBarIdx = na
var bool  extendedFlag   = false
var bool  warnFlag       = false

// drawing handles
var line  livePivotLine  = na
var label livePivotLabel = na
var box   zoneBox        = na
var line  stopLine       = na

// per-bar events
bool doAnchorReset  = false
bool matureEvent    = false
bool lateEvent      = false
bool breakoutEvent  = false
bool breakConfEvent = false
bool breakWeakEvent = false
bool failureEvent   = false
bool extendedEvent  = false
bool warnEvent      = false
bool resetEvent     = false

// quality checks over the base body so far (excludes the current bar; [1] on volume
// averages keeps a breakout surge out of the dry-up reading)
float tightVal = nChg > 0 ? sumChg / nChg * 100 : na
bool  tightOk  = not na(tightVal) and tightVal <= tightPctInput
bool  dryOk    = not na(volSmaShort[1]) and not na(volSmaLong[1]) and volSmaShort[1] < volSmaLong[1]
bool  supOk    = upVolN > 0 and dnVolN > 0 and upVolSum / upVolN > dnVolSum / dnVolN
int   qScore   = (tightOk ? 1 : 0) + (dryOk ? 1 : 0) + (supOk ? 1 : 0)

// provisional stage of the base currently tracked
bool stepUp   = not na(lastPivot) and not na(baseHigh) and baseHigh * pivotFactor >= lastPivot * stageFactor
int provStage = stageCount == 0 ? 1 : stepUp ? stageCount + 1 : stageCount

// state machine
if na(baseHigh)
    doAnchorReset := true
else
    float pivotPre = baseHigh * pivotFactor

    if not baseMature
        if high > baseHigh
            // price recovered the anchor high before a base formed: advance continues
            doAnchorReset := true
        else
            baseLow := math.min(baseLow, low)

            float depthNow = (baseHigh - baseLow) / baseHigh * 100
            if bar_index - baseStartBar >= minLenInput and uptrendOk and depthNow <= maxDepthInput
                baseMature  := true
                matureEvent := true

                if provStage >= lateStageInput
                    lateEvent := true
    else
        baseLow := math.min(baseLow, low)

        if close > pivotPre
            breakoutEvent := true
        else
            if high > baseHigh
                // shakeout poke above resistance without a closing breakout: refine the pivot upward
                baseHigh := high

            if (baseHigh - baseLow) / baseHigh * 100 > maxDepthInput
                // consolidation turned into a correction: not a base anymore
                doAnchorReset := true

// breakout processing
if breakoutEvent
    float thisPivot    = baseHigh * pivotFactor
    bool  volConfirmed = not na(volSmaLong) and nz(volume) >= volSmaLong * surgeFactor
    int   newStage     = provStage
    color stageColor   = newStage >= lateStageInput ? lateColorInput : bullColorInput
    int   lenBars      = bar_index - baseStartBar
    float depthPct     = (baseHigh - baseLow) / baseHigh * 100
    int   labelX       = baseStartBar + (bar_index - baseStartBar) / 2

    breakConfEvent := volConfirmed
    breakWeakEvent := not volConfirmed

    if showBoxesInput
        box.new(baseStartBar, baseHigh, bar_index, baseLow, border_color = color.new(stageColor, 50), bgcolor = color.new(stageColor, 92), border_width = 1)

    if showPivotInput
        line.new(baseStartBar, thisPivot, bar_index, thisPivot, color = stageColor, width = 1)
        stopLine := line.new(bar_index, thisPivot * failFactor, bar_index, thisPivot * failFactor, color = bearColorInput, style = line.style_dashed)

    if showLabelsInput
        string stageTxt = ordinal(newStage) + ' base · ' + str.tostring(lenBars) + lenUnit() + ' · ' + str.tostring(depthPct, '#.#') + '% deep · Q ' + str.tostring(qScore) + '/3' + (newStage >= lateStageInput ? ' · LATE-STAGE' : '')
        label.new(labelX, baseHigh, stageTxt, style = label.style_label_down, color = CLR_GHOST, textcolor = stageColor, size = size.small)

    if showSignalsInput
        label.new(bar_index, low, volConfirmed ? 'Pivot buy' : 'Weak-volume breakout', style = label.style_label_up, color = volConfirmed ? bullColorInput : neutralColorInput, textcolor = chart.bg_color, size = size.small)

    if showZoneInput
        zoneBox := box.new(bar_index, thisPivot * zoneFactor, bar_index, thisPivot, border_color = color.new(bullColorInput, 60), bgcolor = color.new(bullColorInput, 88), text = 'buy zone', text_size = size.tiny, text_color = color.new(bullColorInput, 30), text_halign = text.align_right, text_valign = text.align_top)

    // commit the base into the count
    stageCount     := newStage
    lastPivot      := thisPivot
    lastBaseLow    := baseLow
    basesTotal     += 1
    watchLive      := true
    watchConfirmed := volConfirmed
    buyPoint       := thisPivot
    zoneTop        := thisPivot * zoneFactor
    stopLevel      := thisPivot * failFactor
    watchBaseTop   := baseHigh
    breakoutBarIdx := bar_index
    extendedFlag   := false
    warnFlag       := false
    doAnchorReset  := true

// quality accumulation (base body bars only — skipped on anchor resets and breakouts)
if not doAnchorReset
    if not na(close[1]) and close[1] > 0
        sumChg += math.abs(close / close[1] - 1)
        nChg   += 1

        if close > close[1]
            upVolSum += nz(volume)
            upVolN   += 1
        else if close < close[1]
            dnVolSum += nz(volume)
            dnVolN   += 1

// anchor reset (new leg high, invalidated candidate, first bar, or post-breakout)
if doAnchorReset
    baseHigh     := high
    baseStartBar := bar_index
    baseLow      := low
    baseMature   := false
    uptrendOk    := not na(lowestLook) and high >= lowestLook * upFactor
    sumChg       := 0.0
    nChg         := 0
    upVolSum     := 0.0
    upVolN       := 0
    dnVolSum     := 0.0
    dnVolN       := 0

    if not na(livePivotLine)
        line.delete(livePivotLine)
        livePivotLine := na

    if not na(livePivotLabel)
        label.delete(livePivotLabel)
        livePivotLabel := na

// live breakout watch: failure rule, buy zone bound, heavy-volume re-entry warning
if watchLive and bar_index > breakoutBarIdx
    if not na(zoneBox)
        box.set_right(zoneBox, bar_index)

    if not na(stopLine)
        line.set_x2(stopLine, bar_index)

    if low <= stopLevel
        failureEvent := true
        watchLive    := false

        if showSignalsInput
            label.new(bar_index, high, 'Base failure', style = label.style_label_down, color = bearColorInput, textcolor = chart.bg_color, size = size.small)

        if not na(zoneBox)
            box.set_border_color(zoneBox, color.new(bearColorInput, 60))
            box.set_bgcolor(zoneBox, color.new(bearColorInput, 90))
    else if high >= buyPoint * advFactor
        // breakout resolved successfully, failure watch ends
        watchLive := false
    else
        if not extendedFlag and close > zoneTop
            extendedEvent := true
            extendedFlag  := true

            if showSignalsInput
                label.new(bar_index, high, 'Extended', style = label.style_label_down, color = CLR_GHOST, textcolor = lateColorInput, size = size.tiny)

        bool heavyVol = not na(volSmaLong) and nz(volume) >= volSmaLong * surgeFactor
        if not warnFlag and close < watchBaseTop and heavyVol
            warnEvent := true
            warnFlag  := true

            if showSignalsInput
                label.new(bar_index, high, 'Back inside base', style = label.style_label_down, color = CLR_GHOST, textcolor = bearColorInput, size = size.tiny)

// base count reset: a decline below the prior base's low resets the count
if stageCount > 0 and not na(lastBaseLow) and low < lastBaseLow
    resetEvent  := true
    stageCount  := 0
    lastPivot   := na
    lastBaseLow := na

    if showSignalsInput
        label.new(bar_index, low, 'Count reset', style = label.style_label_up, color = CLR_GHOST, textcolor = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// live pivot line & label while a mature base awaits its breakout
if baseMature and showPivotInput
    float pivotNow = baseHigh * pivotFactor

    if na(livePivotLine)
        livePivotLine := line.new(baseStartBar, pivotNow, bar_index, pivotNow, color = neutralColorInput, style = line.style_dotted)
    else
        line.set_x2(livePivotLine, bar_index)
        line.set_y1(livePivotLine, pivotNow)
        line.set_y2(livePivotLine, pivotNow)

    if showLabelsInput
        string liveTxt = 'Pivot ' + fmtPrice(pivotNow) + ' · ' + ordinal(provStage) + ' base'

        if na(livePivotLabel)
            livePivotLabel := label.new(bar_index, pivotNow, liveTxt, style = label.style_label_left, color = CLR_GHOST, textcolor = neutralColorInput, size = size.small)
        else
            label.set_x(livePivotLabel, bar_index)
            label.set_y(livePivotLabel, pivotNow)
            label.set_text(livePivotLabel, liveTxt)

// data-window plots
plot(baseMature or watchLive ? (watchLive ? buyPoint : baseHigh * pivotFactor) : na, 'Pivot buy point', color = na, display = display.data_window)
plot(baseMature or watchLive ? (watchLive ? zoneTop : baseHigh * pivotFactor * zoneFactor) : na, 'Buy zone top', color = na, display = display.data_window)
plot(baseMature or watchLive ? (watchLive ? stopLevel : baseHigh * pivotFactor * failFactor) : na, 'Failure stop', color = na, display = display.data_window)

// dashboard
var table dashTable = na

if showDashInput and barstate.islast
    string dashPos = switch dashPosInput
        'Top right'    => position.top_right
        'Top left'     => position.top_left
        'Bottom right' => position.bottom_right
        => position.bottom_left

    string dashSize = switch dashSizeInput
        'Tiny'  => size.tiny
        'Small' => size.small
        => size.normal

    if na(dashTable)
        dashTable := table.new(dashPos, 2, 9, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
        table.merge_cells(dashTable, 0, 0, 1, 0)

    int   lenBarsNow  = bar_index - baseStartBar
    float depthNowPct = (baseHigh - baseLow) / baseHigh * 100
    float pivotNowV   = watchLive ? buyPoint : baseHigh * pivotFactor
    bool  levelsOn    = baseMature or watchLive

    string stateTxt = watchLive ? (watchConfirmed ? 'Breakout live' : 'Weak breakout live') : baseMature ? 'Mature base — awaiting pivot' : lenBarsNow > 0 ? 'Consolidating (' + str.tostring(lenBarsNow) + lenUnit() + ')' : 'Scanning'
    string stageTxt = stageCount == 0 ? '—' : ordinal(stageCount) + (stageCount >= lateStageInput ? ' (late)' : '')
    string qualTxt  = lenBarsNow > 1 or watchLive ? 'Tight ' + (tightOk ? '✔' : '✖') + '  Dry-up ' + (dryOk ? '✔' : '✖') + '  Support ' + (supOk ? '✔' : '✖') : '—'

    color stateColor = watchLive ? (watchConfirmed ? bullColorInput : neutralColorInput) : baseMature ? bullColorInput : DASH_TEXT

    table.cell(dashTable, 0, 0, 'O\'Neil Base Analysis', text_color = DASH_TEXT, text_size = dashSize)
    table.cell(dashTable, 0, 1, 'State', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, stateTxt, text_color = stateColor, text_size = dashSize)
    table.cell(dashTable, 0, 2, 'Base count', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, stageTxt, text_color = stageCount >= lateStageInput ? lateColorInput : DASH_TEXT, text_size = dashSize)
    table.cell(dashTable, 0, 3, 'Pivot buy point', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, levelsOn ? fmtPrice(pivotNowV) : '—', text_color = levelsOn ? bullColorInput : DASH_TEXT, text_size = dashSize)
    table.cell(dashTable, 0, 4, 'Buy zone top', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 4, levelsOn ? fmtPrice(pivotNowV * zoneFactor) : '—', text_color = DASH_TEXT, text_size = dashSize)
    table.cell(dashTable, 0, 5, 'Failure stop', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 5, levelsOn ? fmtPrice(pivotNowV * failFactor) : '—', text_color = levelsOn ? bearColorInput : DASH_TEXT, text_size = dashSize)
    table.cell(dashTable, 0, 6, 'Length / depth', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 6, lenBarsNow > 0 ? str.tostring(lenBarsNow) + lenUnit() + ' / ' + str.tostring(depthNowPct, '#.#') + '%' : '—', text_color = DASH_TEXT, text_size = dashSize)
    table.cell(dashTable, 0, 7, 'Quality', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 7, qualTxt, text_color = DASH_TEXT, text_size = dashSize)
    table.cell(dashTable, 0, 8, 'Bases counted', text_color = DASH_HEADER, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 8, str.tostring(basesTotal), text_color = DASH_TEXT, text_size = dashSize)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(matureEvent, 'New Base Validated', 'O\'Neil base analysis: a new base is validated on {{ticker}} — prior-uptrend, minimum-length and depth checks passed; pivot buy point set.')
alertcondition(lateEvent, 'Late-Stage Base', 'O\'Neil base analysis: the base forming on {{ticker}} is late-stage — later-stage bases historically fail more often.')
alertcondition(breakConfEvent, 'Confirmed Pivot Breakout', 'O\'Neil base analysis: {{ticker}} cleared its pivot buy point on volume well above average — confirmed breakout within the buy zone.')
alertcondition(breakWeakEvent, 'Weak-Volume Breakout', 'O\'Neil base analysis: {{ticker}} cleared its pivot buy point WITHOUT the required volume surge — breakout not confirmed.')
alertcondition(extendedEvent, 'Extended Beyond Buy Zone', 'O\'Neil base analysis: {{ticker}} closed beyond the buy zone above the pivot — new entries are considered chased.')
alertcondition(warnEvent, 'Back Inside Base On Heavy Volume', 'O\'Neil base analysis: {{ticker}} closed back inside its base on heavy volume — early base-failure warning.')
alertcondition(failureEvent, 'Base Failure', 'O\'Neil base analysis: {{ticker}} fell 7-8% below its buy point — base failure, automatic sale under O\'Neil\'s loss rule.')
alertcondition(resetEvent, 'Base Count Reset', 'O\'Neil base analysis: {{ticker}} declined below the prior base\'s low — the base count is reset.')

//---------------------------------------------------------------------------------------------------------------------}
