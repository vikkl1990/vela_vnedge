if longSignal or shortSignal
    dirTxt = longSignal ? "LONG" : "SHORT"
    alert("SMC " + dirTxt + " SETUP\nSymbol: " + syminfo.ticker + "\nTimeframe: " + timeframe.period + "\nEntry: " + fmt(trade.entry) + "\nStop: " + fmt(trade.stop) + "\nTP1: " + fmt(trade.tp1) + "\nTP2: " + fmt(trade.tp2) + "\nTP3: " + fmt(trade.tp3) + "\nScore: " + str.tostring(trade.score) + "/16", alert.freq_once_per_bar_close)

var array<box> vobBoxes = array.new<box>()
var array<line> vobLines = array.new<line>()
var array<label> vobLabels = array.new<label>()

vobDraw(Zone z, float denominator, bool side) =>
    int left = side ? bar_index + vobGap : math.max(z.leftBar, bar_index - 9999)
    int right = side ? left + vobWidth : bar_index + vobRight
    int metricX = side ? right + 2 : bar_index + 2

    int span = side ? vobWidth : math.max(1, bar_index - left)
    float mid = math.avg(z.top, z.bottom)
    color col = z.direction == DIR_LONG ? vobBull : vobBear
    if z.isBreaker
        col := z.direction == DIR_LONG ? vobBear : vobBull
    array.push(vobBoxes, box.new(left, z.top, right, z.bottom, border_color = z.isBreaker ? color.new(col, 30) : na, border_style = line.style_dashed, bgcolor = color.new(col, z.isBreaker ? 98 : vobFill)))
    if obMidline
        array.push(vobLines, line.new(left, mid, right, mid, color = col, style = line.style_dashed))
    if vobActivity and not z.isBreaker and not na(z.totalVolume) and z.totalVolume > 0
        float ratio = math.max(0.0, math.min(1.0, z.buyVolume / z.totalVolume))
        int buyWidth = int(math.round(span * ratio))
        int sellWidth = int(math.round(span * (1.0 - ratio)))
        if buyWidth > 0
            array.push(vobBoxes, box.new(left, z.top, left + buyWidth, mid, border_color = na, bgcolor = color.new(vobBull, vobBarFill)))
        if sellWidth > 0
            array.push(vobBoxes, box.new(left, mid, left + sellWidth, z.bottom, border_color = na, bgcolor = color.new(vobBear, vobBarFill)))
    if obMetrics or z.isBreaker
        string txt = z.isBreaker ? "Breaker" : na(z.totalVolume) ? "Volume unavailable" : z.totalVolume == 0 ? "Zero interval volume" : str.tostring(z.totalVolume, format.volume) + (denominator > 0 ? " (" + str.tostring(100.0 * z.totalVolume / denominator, "#") + "%)" : " (N/A)")
        if vobStatsText and not z.isBreaker
            txt += "  Z=" + (na(z.volumeZ) ? "N/A" : str.tostring(z.volumeZ, "#.##"))
        string tip = "Broken-pivot interval: " + str.tostring(z.brokenIntervalVolume, format.volume) + "\nVolume start: " + (na(z.volumeStartTime) ? "N/A" : str.format_time(z.volumeStartTime, "yyyy-MM-dd HH:mm", syminfo.timezone)) + "\nVolume end: " + (na(z.volumeEndTime) ? "N/A" : str.format_time(z.volumeEndTime, "yyyy-MM-dd HH:mm", syminfo.timezone)) + "\nEngine: " + vobEngine + "\nOrigin: " + str.format_time(z.originTime, "yyyy-MM-dd HH:mm", syminfo.timezone) + "\nV1: " + str.tostring(z.originVolume, format.volume) + " | V3: " + str.tostring(z.local3Volume, format.volume) + "\nVN: " + str.tostring(z.localNVolume, format.volume) + " | Origin-to-confirm: " + str.tostring(z.throughConfirmationVolume, format.volume) + "\nSupply = bearish OB; demand = bullish OB.\nConfirmed on bar " + str.tostring(z.createdBar) + ". Origin drawn retrospectively.\nVolume interval: " + vobVolumeMode + "\nBuy/sell: " + vobSplit + " OHLCV estimate, not bid/ask data.\nBuy: " + str.tostring(z.buyVolume, format.volume) + "\nSell: " + str.tostring(z.sellVolume, format.volume) + "\nPercentage denominator: visible, non-breaker blocks after overlap and statistical filtering.\nZ-score is descriptive, not a success probability."
        array.push(vobLabels, label.new(metricX, mid, txt, style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = fsize(vobTextSize), tooltip = tip))

if barstate.islast

    while array.size(vobBoxes) > 0
        box.delete(array.pop(vobBoxes))
    while array.size(vobLines) > 0
        line.delete(array.pop(vobLines))
    while array.size(vobLabels) > 0
        label.delete(array.pop(vobLabels))
    array<Zone> candidates = array.new<Zone>()
    array<Zone> visible = array.new<Zone>()
    int swingAdded = 0
    if array.size(orderBlocks) > 0
        for i = array.size(orderBlocks) - 1 to 0
            z = array.get(orderBlocks, i)
            if z.active and (vobEngine != "Legacy structure breaks" or swingAdded < obKeep)
                array.push(candidates, z)
                swingAdded += 1
    int internalAdded = 0
    if array.size(internalOrderBlocks) > 0
        for i = array.size(internalOrderBlocks) - 1 to 0
            z = array.get(internalOrderBlocks, i)
            if z.active and internalAdded < internalObKeep
                array.push(candidates, z)
                internalAdded += 1

    while array.size(candidates) > 0 and array.size(visible) < vobLast
        int newest = 0
        if array.size(candidates) > 1
            for i = 1 to array.size(candidates) - 1
                a = array.get(candidates, i)
                b = array.get(candidates, newest)
                if a.createdBar > b.createdBar or (a.createdBar == b.createdBar and a.leftBar > b.leftBar)
                    newest := i
        z = array.remove(candidates, newest)
        bool suppress = vobStats and not z.isBreaker and (na(z.volumeZ) or z.volumeZ < vobMinZ)
        for e in visible
            bool same = z.leftBar == e.leftBar and z.direction == e.direction and z.top == e.top and z.bottom == e.bottom
            bool overlap = math.min(z.top, e.top) > math.max(z.bottom, e.bottom)
            if same or (obHideOverlap and overlap)
                suppress := true
        if not suppress
            array.push(visible, z)
    float total = 0.0
    for z in visible
        if not z.isBreaker
            total += nz(z.totalVolume)
    for z in visible
        if vobLayout != "Side chart"
            vobDraw(z, total, false)
        if vobLayout != "Reference overlay"
            vobDraw(z, total, true)

