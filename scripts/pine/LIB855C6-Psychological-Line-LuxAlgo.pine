//@version=6
indicator("Psychological Line", "Psychological Line", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MID_LEVEL         = 50.0
FILL_VALUE_TRANSP = 50  // gradient transparency at the oscillator end of the fill
FILL_MID_TRANSP   = 100 // gradient transparency at the balance-line end of the fill
ZONE_TRANSP       = 92  // transparency of the soft overbought / oversold zone shading

BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86
ACCENT_COLOR  = #ff9800 // the one accent - the optional smoothed overlay

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(12, "Length", minval = 1, group = "Settings"
  , tooltip = "Number of bars in the counting window. 12 is the classical default and 13 a common fast alternative; windows near 25 give a slower sentiment read that flags only sustained one-sidedness. On the default the line moves in discrete steps of one twelfth — that coarseness is the design, not a rendering error.")

sourceInput = input.source(close, "Source", group = "Settings"
  , tooltip = "Series whose bar-to-bar direction is counted. The classical Psychological Line counts closes above the prior close. Only the sign of each change is used, never its size, so a single outlier bar moves the line by at most one step.")

//---------------------------------------------------------------------------------------------------------------------}
// Thresholds
//---------------------------------------------------------------------------------------------------------------------{
obInput = input.float(75, "Overbought", minval = 50, maxval = 100, step = 1, group = "Thresholds"
  , tooltip = "Percentage of up bars above which the recent tape is considered one-sidedly optimistic. 75% is the convention on the 12-bar setting — nine of the last twelve bars rose. Strong trends can pin extreme readings, so the classical read acts on the step back through the threshold, not the touch.")

osInput = input.float(25, "Oversold", minval = 0, maxval = 50, step = 1, group = "Thresholds"
  , tooltip = "Percentage of up bars below which the recent tape is considered one-sidedly pessimistic. 25% is the conventional mirror of the overbought level, and the actionable event is the recovery back up through it rather than the touch.")

//---------------------------------------------------------------------------------------------------------------------}
// Smoothing
//---------------------------------------------------------------------------------------------------------------------{
showSmoothInput = input.bool(false, "Smoothed PSY", group = "Smoothing"
  , tooltip = "Overlays a short moving average of the Psychological Line. Smoothing tames the discrete one-step moves at the cost of responsiveness — fewer whipsaws, later turns.")

smoothTypeInput = input.string("SMA", "Type", options = ["SMA", "EMA", "RMA", "WMA"], inline = "smoothing", group = "Smoothing")

smoothLengthInput = input.int(6, "Length", minval = 1, inline = "smoothing", group = "Smoothing"
  , tooltip = "Moving average formula and window applied to the raw line when the smoothed overlay is enabled.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style"
  , tooltip = "Color of the line and gradient fill above the 50% balance line, where up closes hold the majority.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style"
  , tooltip = "Color of the line and gradient fill below the 50% balance line, where down closes hold the majority.")

smoothColorInput = input.color(ACCENT_COLOR, "Smoothing", group = "Style"
  , tooltip = "Color of the smoothed PSY overlay.")

gradientFillInput = input.bool(true, "Gradient Fill", group = "Style"
  , tooltip = "Vertical gradient between the oscillator and the 50% balance line, fully transparent at the balance line and more opaque at the oscillator value.")

markersInput = input.bool(false, "Threshold Exit Markers", group = "Style"
  , tooltip = "Circles on the line at the threshold exits — the step back below the overbought level and the recovery back above the oversold level. Off by default to keep the pane clean; the matching alerts fire regardless.")

levelsColorInput = input.color(NEUTRAL_COLOR, "Levels Color", group = "Style"
  , tooltip = "Color of the dashed overbought/oversold levels and of the dotted 50% balance line.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//An up bar is a bar whose source finished above its previous value; the first bar counts as flat
upBar = sourceInput > nz(sourceInput[1], sourceInput)

//PSY: up bars in the window as a percentage of the window — the market's recent win rate.
//Every bar votes once whatever its size, so the value moves in steps of 100 / length.
psy = math.sum(upBar ? 1.0 : 0.0, lengthInput) / lengthInput * 100

//Optional smoothing — every average is computed unconditionally, the input only selects one
smaValue = ta.sma(psy, smoothLengthInput)
emaValue = ta.ema(psy, smoothLengthInput)
rmaValue = ta.rma(psy, smoothLengthInput)
wmaValue = ta.wma(psy, smoothLengthInput)

psySmooth = switch smoothTypeInput
    "EMA" => emaValue
    "RMA" => rmaValue
    "WMA" => wmaValue
    => smaValue

//Threshold and balance-line events — the turns the classical read acts on
overboughtEntry = ta.crossover(psy, obInput)
overboughtExit  = ta.crossunder(psy, obInput)
oversoldEntry   = ta.crossunder(psy, osInput)
oversoldExit    = ta.crossover(psy, osInput)
balanceCrossUp  = ta.crossover(psy, MID_LEVEL)
balanceCrossDn  = ta.crossunder(psy, MID_LEVEL)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
oscColor = psy > MID_LEVEL ? bullColorInput : bearColorInput

fillTopColor    = psy > MID_LEVEL ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_MID_TRANSP)
fillBottomColor = psy > MID_LEVEL ? color.new(bullColorInput, FILL_MID_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

psyPlotId = plot(psy, "PSY", oscColor, 2)
midPlotId = plot(MID_LEVEL, "Balance Anchor", editable = false, display = display.none)

fill(psyPlotId, midPlotId
  , math.max(psy, MID_LEVEL)
  , math.min(psy, MID_LEVEL)
  , gradientFillInput ? fillTopColor : na
  , gradientFillInput ? fillBottomColor : na)

plot(showSmoothInput ? psySmooth : na, "Smoothed PSY", smoothColorInput, 1)

hline(obInput, "Overbought", levelsColorInput, hline.style_dashed)
hline(osInput, "Oversold", levelsColorInput, hline.style_dashed)
hline(MID_LEVEL, "Balance Line", color.new(levelsColorInput, 50), hline.style_dotted)

//Soft zone shading anchored on hidden plots - one-sided optimism leans bearish, one-sided pessimism leans bullish
obZoneId       = plot(obInput, "Overbought Zone Anchor", color(na), editable = false, display = display.none)
osZoneId       = plot(osInput, "Oversold Zone Anchor", color(na), editable = false, display = display.none)
topAnchorId    = plot(100, "Top Anchor", color(na), editable = false, display = display.none)
bottomAnchorId = plot(0, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(bearColorInput, ZONE_TRANSP), title = "Overbought Zone")
fill(osZoneId, bottomAnchorId, color.new(bullColorInput, ZONE_TRANSP), title = "Oversold Zone")

plotshape(markersInput and overboughtExit ? psy : na, "Overbought Exit Marker", shape.circle, location.absolute, color = bearColorInput, size = size.tiny)
plotshape(markersInput and oversoldExit ? psy : na, "Oversold Recovery Marker", shape.circle, location.absolute, color = bullColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(overboughtEntry, "Overbought Entry", "Psychological Line crossed above its overbought level on {{ticker}} ({{interval}}), up closes dominating the window")
alertcondition(overboughtExit, "Overbought Exit", "Psychological Line stepped back below its overbought level on {{ticker}} ({{interval}}), one-sided optimism cooling")
alertcondition(oversoldEntry, "Oversold Entry", "Psychological Line crossed below its oversold level on {{ticker}} ({{interval}}), down closes dominating the window")
alertcondition(oversoldExit, "Oversold Recovery", "Psychological Line recovered above its oversold level on {{ticker}} ({{interval}}), one-sided pessimism cooling")
alertcondition(balanceCrossUp, "Bullish Balance Line Cross", "Psychological Line crossed above the 50% balance line on {{ticker}} ({{interval}}), up closes now the majority")
alertcondition(balanceCrossDn, "Bearish Balance Line Cross", "Psychological Line crossed below the 50% balance line on {{ticker}} ({{interval}}), down closes now the majority")

//---------------------------------------------------------------------------------------------------------------------}
