//@version=5
indicator("Hullinger Percentile Oscillator[AlgoAlpha]", "AlgoAlpha - Hullinger Percentile", false, explicit_plot_zorder = true)
import TradingView/ta/7
length = input.int(40, title = "Main Length", minval=1, group = "Hullinger Settings")
src = input(hlc3, title="Source", group = "Hullinger Settings")
mult = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group = "Hullinger Settings", tooltip = "The multiplier for the inner bands width")
mult1 = input.float(1.5, minval=0.001, maxval=50, title="Extended Bands Multiplier", group = "Hullinger Settings", tooltip = "The multiplier for the outer bands width")
mod = input.string("Swing", "Oscillator Mode", ["Swing", "Contrarian"], "The display mode, Swing mode is used for catching swing trends and Contrarian mode is for catching reversals", group = "Oscillator Settings")
lag = input.int(2, title = "Swing Detection Lag", minval=1, group = "Oscillator Settings")

lbL = input(title="Divergence Pivot Detection Length", defval=20, group = "Oscillator Settings", tooltip = "The larger this number, the less sensitive the divergence detecion is. A smaller number will detect smaller and/or shorter term divergences", display = display.data_window)
lbR = input(title="Divergence Pivot Confirmation Length", defval=1, group = "Oscillator Settings", tooltip = "This number is how many bars the indicator will wait for confirmation to plot the divergences. The higher the number, the longer the delay of the signal, but the lesser the number of false signals. Set this to 0 if you do not want any delay at all", display = display.data_window)

green = input.color(#00ffbb, "Bullish Color", group = "Appearance")
red = input.color(#ff1100, "Bearish Color", group = "Appearance")
plotBullish = input(title="Plot Bullish Divergences", defval=true, group = "Appearance")
plotBear = input(title="Plot Bearish Divergences", defval=true, group = "Appearance")

//Modified Stdev
isZero(val, eps) => math.abs(val) <= eps

SUM(fst, snd) =>
    EPS = 1e-10
    res = fst + snd
    if isZero(res, EPS)
        res := 0
    else
        if not isZero(res, 1e-4)
            res := res
        else
            15

pine_stdev(src, length) =>
    avg = ta.hma(src, length)
    sumOfSquareDeviations = 0.0
    for i = 0 to length - 1
        sum = SUM(src[i], -avg)
        sumOfSquareDeviations := sumOfSquareDeviations + sum * sum

    stdev = math.sqrt(sumOfSquareDeviations / length)

basis = ta.sma(src, length)
dev = mult * pine_stdev(src, length)
upper = basis + dev
lower = basis - dev
upper1 = basis + dev*mult1
lower1 = basis - dev*mult1

upper_outer = 100 * (upper1 - lower)/(upper - lower)
positionBetweenBands = 100 * (src - lower)/(upper - lower)
lower_outer = 100 * (lower1 - lower)/(upper - lower)

smoothed = ta.hma(ta.linreg(positionBetweenBands, 7, 0),33)

oscil(type) =>
    switch type
        "Swing" => smoothed
        "Contrarian" => positionBetweenBands


upper_withins = array.new_float()
lower_withins = array.new_float()

for i = 1 to 3
    v = (upper_outer-100)/4 * i + 100
    upper_withins.unshift(v)
    v1 = -(0-lower_outer)/4 * i
    lower_withins.unshift(v1)

uu = plot(upper_outer, "Outer Upper Band", display = display.none)
ll = plot(lower_outer, "Outer Lower Band", display = display.none)
ul = plot(100, "Inner Upper Band", display = display.none)
lu = plot(0, "Inner Lower Band", display = display.none)

plot(upper_withins.first(), "Upper Withins", display = display.all, linewidth = 3, color = color.from_gradient(positionBetweenBands, 50, 100, color.new(red, 88), color.new(red, 70)))
plot(upper_withins.get(1), "Upper Withins", display = display.all, linewidth = 3, color = color.from_gradient(positionBetweenBands, 50, 100, color.new(red, 91), color.new(red, 70)))
plot(upper_withins.get(2), "Upper Withins", display = display.all, linewidth = 3, color = color.from_gradient(positionBetweenBands, 50, 100, color.new(red, 94), color.new(red, 70)))
plot(lower_withins.first(), "Lower Withins", display = display.all, linewidth = 3, color = color.from_gradient(positionBetweenBands, 0, 50, color.new(green, 70), color.new(green, 88)))
plot(lower_withins.get(1), "Lower Withins", display = display.all, linewidth = 3, color = color.from_gradient(positionBetweenBands, 0, 50, color.new(green, 70), color.new(green, 91)))
plot(lower_withins.get(2), "Lower Withins", display = display.all, linewidth = 3, color = color.from_gradient(positionBetweenBands, 0, 50, color.new(green, 70), color.new(green, 94)))

fill(uu, ul, upper_outer, 100, color.new(red, 85), color.new(red, 97))
fill(ll, lu, 0, lower_outer, color.new(green, 97), color.new(green, 85))

osc_col = mod == "Swing" ? (smoothed > smoothed[lag] ? green : red) : chart.fg_color
osc = plot(oscil(mod), color = osc_col)
osc_lag = plot(oscil(mod)[lag],display =  display.none)

fill(osc, osc_lag, color.new(osc_col, 70), "Oscillator Fill")

plotchar(ta.cross(oscil(mod), oscil(mod)[lag]) and mod == "Swing" ? oscil(mod)[lag] : na, "Oscillator Swing Signals", "●", location.absolute, osc_col, size = size.tiny)

plotchar(ta.crossunder(oscil(mod), 100) and mod == "Contrarian" ? math.max(oscil(mod)[1], upper_outer) + (upper_outer-lower_outer) * 0.2 : na, "Weak Bearish Reversal",  "▽", location.absolute, red, size = size.tiny)
plotchar(ta.crossover(oscil(mod), 0) and mod == "Contrarian" ? math.min(oscil(mod)[1], lower_outer) - (upper_outer-lower_outer) * 0.2 : na, "Weak Bullish Reversal",  "△", location.absolute, green, size = size.tiny)

plotchar(ta.crossunder(oscil(mod), upper_outer) and mod == "Contrarian" ? math.max(oscil(mod)[1], upper_outer) + (upper_outer-lower_outer) * 0.3 : na, "Strong Bearish Reversal",  "▼", location.absolute, red, size = size.tiny)
plotchar(ta.crossover(oscil(mod), lower_outer) and mod == "Contrarian" ? math.min(oscil(mod)[1], lower_outer) - (upper_outer-lower_outer) * 0.3 : na, "Strong Bullish Reversal",  "▲", location.absolute, green, size = size.tiny)


bullColor = green
bearColor = red
hiddenBullColor = color.new(green, 80)
hiddenBearColor = color.new(red, 80)
textColor = color.white
noneColor = color.new(color.white, 100)
plFound = na(ta.pivotlow(oscil(mod), lbL, lbR)) ? false : true
phFound = na(ta.pivothigh(oscil(mod), lbL, lbR)) ? false : true
_inRange(cond) =>
	bars = ta.barssince(cond == true)
	-80 <= bars and bars <= 80
// Regular Bullish
oscHL = oscil(mod)[lbR] > ta.valuewhen(plFound, oscil(mod)[lbR], 1) and _inRange(plFound[1])
priceLL = low[lbR] < ta.valuewhen(plFound, low[lbR], 1)
bullCond = plotBullish and priceLL and oscHL and plFound
plot(plFound  ? oscil(mod)[lbR] : na, offset=-lbR, title="Regular Bullish", linewidth=2, color=(bullCond ? bullColor : noneColor))
// Regular Bearish
oscLH = oscil(mod)[lbR] < ta.valuewhen(phFound, oscil(mod)[lbR], 1) and _inRange(phFound[1])
priceHH = high[lbR] > ta.valuewhen(phFound, high[lbR], 1)
bearCond = plotBear and priceHH and oscLH and phFound
plot(phFound  ? oscil(mod)[lbR] : na, offset=-lbR, title="Regular Bearish", linewidth=2, color=(bearCond ? bearColor : noneColor))

//Alerts
alertcondition(ta.crossunder(oscil(mod), upper_outer) and mod == "Contrarian", "Strong Bearish Reversal")
alertcondition(ta.crossover(oscil(mod), lower_outer) and mod == "Contrarian", "Strong Bullish Reversal")

alertcondition(ta.crossunder(oscil(mod), 100) and mod == "Contrarian", "Weak Bearish Reversal")
alertcondition(ta.crossover(oscil(mod), 0) and mod == "Contrarian", "Weak Bullish Reversal")

alertcondition(ta.crossunder(smoothed, smoothed[lag]), "Bearish Swing")
alertcondition(ta.crossover(smoothed, smoothed[lag]), "Bullish Swing")
