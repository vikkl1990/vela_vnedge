//@version=6
indicator("Williams %R", "%R", overlay = false, format = format.price, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // oversold side - readings at or below the oversold level
BEAR_COLOR    = #f23645 // overbought side - readings at or above the overbought level
NEUTRAL_COLOR = #787b86 // readings between the levels, and the levels themselves
LEVEL_COLOR   = NEUTRAL_COLOR

ZONE_TRANSP = 92 // transparency of the soft overbought / oversold zone shading

SCALE_TOP    = 0
SCALE_BOTTOM = -100

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 1, group = "Settings", tooltip = "Lookback length of the highest high / lowest low range. 14 is the classic setting.")
srcInput = input.source(close, "Source", group = "Settings", tooltip = "Series located within the lookback range. Close is the classic choice.")
obLevelInput = input.float(-20, "Overbought Level", minval = -100, maxval = 0, step = 1, group = "Settings", tooltip = "Readings above this level are treated as overbought. Classic value is -20.")
osLevelInput = input.float(-80, "Oversold Level", minval = -100, maxval = 0, step = 1, group = "Settings", tooltip = "Readings below this level are treated as oversold. Classic value is -80.")

percentRColorInput = input.color(NEUTRAL_COLOR, "%R Line", group = "Style", tooltip = "Color of the %R line while it sits between the overbought and oversold levels. Toward either level the color blends into the overbought or oversold color.")
overboughtColorInput = input.color(BEAR_COLOR, "Overbought", inline = "zones", group = "Style", tooltip = "Color of the line and zone shading at and above the overbought level.")
oversoldColorInput = input.color(BULL_COLOR, "Oversold", inline = "zones", group = "Style", tooltip = "Color of the line and zone shading at and below the oversold level.")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
highestHigh = ta.highest(high, lengthInput)
lowestLow = ta.lowest(low, lengthInput)
rangeWidth = highestHigh - lowestLow

// A flat lookback range (highest high == lowest low) leaves %R undefined -> na, matching ta.wpr()
percentR = rangeWidth > 0 ? -100 * (highestHigh - srcInput) / rangeWidth : float(na)

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring across the levels - oversold color below the oversold level, neutral midway, overbought color above the overbought level
midLevel = (obLevelInput + osLevelInput) / 2
percentRColor = na(percentR) ? percentRColorInput : percentR <= midLevel ? color.from_gradient(percentR, osLevelInput, midLevel, oversoldColorInput, percentRColorInput) : color.from_gradient(percentR, midLevel, obLevelInput, percentRColorInput, overboughtColorInput)

plot(percentR, "%R", percentRColor, style = plot.style_linebr)

hline(obLevelInput, "Overbought Level", LEVEL_COLOR, hline.style_dashed)
hline(osLevelInput, "Oversold Level", LEVEL_COLOR, hline.style_dashed)

// Soft zone shading anchored on hidden plots - overbought zone above the overbought level, oversold zone below the oversold level
obZoneId     = plot(obLevelInput, "Overbought Zone Anchor", color(na), editable = false, display = display.none)
osZoneId     = plot(osLevelInput, "Oversold Zone Anchor", color(na), editable = false, display = display.none)
topAnchorId  = plot(SCALE_TOP, "Top Anchor", color(na), editable = false, display = display.none)
botAnchorId  = plot(SCALE_BOTTOM, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(overboughtColorInput, ZONE_TRANSP), "Overbought Zone")
fill(osZoneId, botAnchorId, color.new(oversoldColorInput, ZONE_TRANSP), "Oversold Zone")

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
obEnter = ta.crossover(percentR, obLevelInput)
obExit = ta.crossunder(percentR, obLevelInput)
osEnter = ta.crossunder(percentR, osLevelInput)
osExit = ta.crossover(percentR, osLevelInput)

alertcondition(obEnter, "Overbought Enter", "Williams %R crossed above -20 (entered overbought)")
alertcondition(obExit, "Overbought Exit", "Williams %R crossed below -20 (exited overbought)")
alertcondition(osEnter, "Oversold Enter", "Williams %R crossed below -80 (entered oversold)")
alertcondition(osExit, "Oversold Exit", "Williams %R crossed above -80 (exited oversold)")
//----------------------------------------------------------------------------------------------------------------------}
