//@version=6
indicator("Chaikin Money Flow", "CMF", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
GROUP_SETTINGS = "Settings"
GROUP_STYLE    = "Style"

BULL_COLOR    = #089981 // money flowing in - readings above zero
BEAR_COLOR    = #f23645 // money flowing out - readings below zero
NEUTRAL_COLOR = #787b86 // exact zero / warm-up readings and the zero line

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 1, group = GROUP_SETTINGS
  , tooltip = "Lookback length over which money flow volume and volume are summed")

cmfColorInput = input.color(NEUTRAL_COLOR, "CMF Line", group = GROUP_STYLE
  , tooltip = "Color of the Chaikin Money Flow line")

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "state", group = GROUP_STYLE
  , tooltip = "Line and fill color while the CMF reads above zero (net money flowing in)")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "state", group = GROUP_STYLE
  , tooltip = "Line and fill color while the CMF reads below zero (net money flowing out)")

zeroColorInput = input.color(NEUTRAL_COLOR, "Zero Line", group = GROUP_STYLE
  , tooltip = "Color of the zero reference line")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
hlRange      = high - low
mfMultiplier = hlRange == 0 ? 0 : ((close - low) - (high - close)) / hlRange
mfVolume     = mfMultiplier * volume

cmf = math.sum(mfVolume, lengthInput) / math.sum(volume, lengthInput)

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
//State coloring - bullish above zero, bearish below, neutral at zero
cmfColor = cmf > 0 ? bullColorInput : cmf < 0 ? bearColorInput : cmfColorInput

cmfPlotId  = plot(cmf, "CMF", cmfColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

//Vertical gradient fill toward the zero line, following the line color
fill(cmfPlotId, zeroPlotId, math.max(cmf, 0), math.min(cmf, 0), cmf > 0 ? color.new(cmfColor, FILL_LINE_TRANSP) : color.new(cmfColor, FILL_ZERO_TRANSP), cmf > 0 ? color.new(cmfColor, FILL_ZERO_TRANSP) : color.new(cmfColor, FILL_LINE_TRANSP), title = "CMF Gradient")

hline(0, "Zero Line", zeroColorInput, hline.style_dashed)

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossUp   = ta.crossover(cmf, 0)
crossDown = ta.crossunder(cmf, 0)

alertcondition(crossUp, "Zero Cross Up", "CMF crossed above zero")
alertcondition(crossDown, "Zero Cross Down", "CMF crossed below zero")

//----------------------------------------------------------------------------------------------------------------------}
