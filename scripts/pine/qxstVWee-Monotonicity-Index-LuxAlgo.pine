//@version=6
indicator("Monotonicity Index [LuxAlgo]", "LuxAlgo - Monotonicity Index", overlay = false)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

color GREEN = #089981
color RED   = #f23645

// --- Modes ---
string MODE_COMPLEXITY = "Complexity"
string MODE_EFFICIENCY = "Efficiency"

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{

float   srcInput        = input.source(close, "Source")
int     lengthInput     = input.int(20, "Period", minval = 2, tooltip = "The lookback window for the Isotonic Regression fit.")
string  modeInput       = input.string(MODE_EFFICIENCY, "Index Mode", options = [MODE_COMPLEXITY, MODE_EFFICIENCY], tooltip = "Complexity: Measures the number of segments in the fit (High = Choppy).\nEfficiency: Measures the ratio of trend movement to total volatility (High = Trendy).")
int     indexSmoothInput= input.int(5, "Index Smoothing", minval = 1, tooltip = "Smoothing period for the Isotonic Index.")

// --- Visuals ---
color   indexColorInput = input.color(#2196f3, "Index Color")

// Types & Methods
//---------------------------------------------------------------------------------------------------------------------{

// @variable [mse, pools, vals, weights] Tuple containing the results of an isotonic fit.
type PavaResult
    float   mse
    int     pools
    float[] vals
    int[]   weights

// @function Performs the Pool Adjacent Violators Algorithm (PAVA) for isotonic regression.
method pava(float[] data, bool nonDecreasing) =>
    int n = data.size()
    float[] poolVals    = array.new_float(0)
    int[]   poolWeights = array.new_int(0)
    
    for i = 0 to n - 1
        float currentVal    = data.get(i)
        float currentPool   = currentVal
        int   currentWeight = 1
        
        while poolVals.size() > 0
            float prevPool   = poolVals.last()
            bool  violation  = nonDecreasing ? prevPool > currentPool : prevPool < currentPool
            
            if violation
                int   prevWeight = poolWeights.pop()
                float lastPool   = poolVals.pop()
                currentPool   := (lastPool * prevWeight + currentPool * currentWeight) / (prevWeight + currentWeight)
                currentWeight += prevWeight
            else
                break
        
        poolVals.push(currentPool)
        poolWeights.push(currentWeight)
    
    float totalError = 0.0
    int   idx        = 0
    for j = 0 to poolVals.size() - 1
        float pVal    = poolVals.get(j)
        int   pWeight = poolWeights.get(j)
        for k = 1 to pWeight
            totalError += math.pow(data.get(idx) - pVal, 2)
            idx += 1
            
    PavaResult.new(totalError / n, poolVals.size(), poolVals, poolWeights)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{

var float rawIndex     = 0.0


if bar_index >= lengthInput
    float[] data = array.new_float(0)
    for i = 0 to lengthInput - 1
        data.push(srcInput[lengthInput - 1 - i])

    PavaResult incFit = data.pava(true)
    PavaResult decFit = data.pava(false)

    PavaResult bestFit = incFit.mse < decFit.mse ? incFit : decFit

    if modeInput == MODE_EFFICIENCY
        // Calculate Total Price Variation (Path Length)
        float pricePath = 0.0
        for i = 1 to data.size() - 1
            pricePath += math.abs(data.get(i) - data.get(i - 1))

        // Calculate Total Isotonic Variation
        float fitPath = math.abs(bestFit.vals.last() - bestFit.vals.get(0))

        // Efficiency Index: (Fit Movement / Price Movement) * 100
        rawIndex := pricePath > 0 ? (fitPath / pricePath) * 100.0 : 0.0
    else
        // Complexity Index: (Segments / Max Segments) * 100
        rawIndex := ((bestFit.pools - 1.0) / (lengthInput - 1.0)) * 100.0





// Smoothed Index
float isotonicIndex = ta.sma(rawIndex, indexSmoothInput)

// Cumulative Mean (Center Value)
float cumMean = ta.cum(isotonicIndex) / (bar_index + 1)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{

// --- Main Index Plot ---
idxPlot  = plot(isotonicIndex, "Monotonicity Index", color = indexColorInput, linewidth = 2)

// Dynamic Center Value & Upper Bound
upperBound = cumMean * 2
meanPlot   = plot(cumMean,    "Cumulative Mean", color = color.new(chart.fg_color, 50), style = plot.style_line)
upperPlot  = plot(upperBound, "Upper Bound",      color = color.new(chart.fg_color, 75), style = plot.style_line, linestyle = plot.linestyle_dashed)


// Enhanced Vertical Gradient Fill
// Highlight logic: when index > mean, we use more opaque colors (smaller transparency values)
isAbove     = isotonicIndex > cumMean
topTransp   = isAbove ? 30 : 70
bottomTransp = isAbove ? 80 : 100

fill(idxPlot, meanPlot, 
     top_color    = color.new(indexColorInput, topTransp), 
     bottom_color = color.new(indexColorInput, bottomTransp), 
     title        = "Index Gradient")

//---------------------------------------------------------------------------------------------------------------------}
