//@version=6

// ============================================================================
indicator("Strong H4 Gold Reach Matrix", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 2000)

// ─────────────────────────────── Engine ───────────────────────────────
gE       = "═══ Reach Engine ═══"
lookback = input.int(400, "History Window (bars)", minval = 60, maxval = 1500, group = gE, tooltip = "Bars used to estimate the excursion distribution and empirical survival. 300-500 is a good H4 range.")
thetaLen = input.int(250, "Volatility-Scale Length (θ)", minval = 30, maxval = 1000, group = gE, tooltip = "Rolling window for the per-bar reach scale θ (mean ATR-excursion). Longer = smoother, slower to adapt.")
atrLen   = input.int(14,  "ATR Length", minval = 2, maxval = 200, group = gE)
empWeight= input.float(0.55, "Empirical vs Model Blend", minval = 0.0, maxval = 1.0, step = 0.05, group = gE, tooltip = "1.0 = pure empirical survival from THIS chart. 0.0 = pure smooth exponential model. 0.55 blends chart-truth with a smooth tail.")
anchorIn = input.string("Last close (locked)", "Anchor Projection To", options = ["Last close (locked)", "Live price (intrabar)"], group = gE, tooltip = "Locked = levels freeze at each H4 close (non-repaint). Live = recompute from current price every tick.")
tfGuard  = input.bool(true, "Warn If Not On H4", group = gE)

// ─────────────────────────────── Level Ladder ───────────────────────────────
gL  = "═══ Probability Ladder (4×4) ═══"
p1  = input.float(0.60, "Band 1 · nearest  (target %)", minval = 0.30, maxval = 0.97, step = 0.01, group = gL, tooltip = "Target touch probability that sets the DISTANCE of the nearest level. Lower = further out. Shown % is the calibrated actual after blend, tilt, snap and spacing. (A very high target sits almost on the anchor, so it is kept modest to keep levels apart.)")
p2  = input.float(0.40, "Band 2            (target %)", minval = 0.20, maxval = 0.95, step = 0.01, group = gL)
p3  = input.float(0.24, "Band 3            (target %)", minval = 0.12, maxval = 0.90, step = 0.01, group = gL)
p4  = input.float(0.13, "Band 4 · farthest (target %)", minval = 0.05, maxval = 0.85, step = 0.01, group = gL)
minLevGap = input.float(0.22, "Minimum Level Spacing (× ATR)", minval = 0.0, maxval = 2.0, step = 0.02, group = gL, tooltip = "Hard floor on the gap between consecutive levels (and from the anchor). Stops levels gluing together near the anchor or after snapping. Probabilities recompute from the final spaced distances.")
probFloor = input.float(2.0, "Clamp Prob Min (%)", minval = 0.0, maxval = 20.0, step = 0.5, group = gL)
probCeil  = input.float(97.0,"Clamp Prob Max (%)", minval = 60.0, maxval = 99.5, step = 0.5, group = gL)

// ─────────────────────────────── Directional Tilt ───────────────────────────────
gT     = "═══ Directional Tilt (secondary) ═══"
useTilt= input.bool(true, "Apply Directional Tilt", group = gT, tooltip = "Mild continuation tilt from trend + momentum + velocity. Shifts up vs down odds. OFF = pure symmetric reach model.")
gamma  = input.float(0.7, "Tilt Strength (γ)", minval = 0.0, maxval = 2.0, step = 0.05, group = gT, tooltip = "Logit shift at full bias. 0 = none. ~0.7 keeps the tilt honest and small; higher leans harder on momentum.")
wTrend = input.float(0.40, "Weight · Trend (EMA20/50)", minval = 0.0, maxval = 1.0, step = 0.05, group = gT)
wMom   = input.float(0.40, "Weight · Momentum (RSI)", minval = 0.0, maxval = 1.0, step = 0.05, group = gT)
wVel   = input.float(0.20, "Weight · Velocity", minval = 0.0, maxval = 1.0, step = 0.05, group = gT)
velLen = input.int(3, "Velocity Lookback (bars)", minval = 1, maxval = 20, group = gT)
emaFast= input.int(20, "Trend EMA Fast", minval = 2, maxval = 200, group = gT)
emaSlow= input.int(50, "Trend EMA Slow", minval = 5, maxval = 400, group = gT)
rsiLen = input.int(14, "RSI Length", minval = 2, maxval = 100, group = gT)

// ─────────────────────────────── Structural Snap ───────────────────────────────
gSn    = "═══ Structural Snap ═══"
useSnap= input.bool(true, "Snap Levels To Liquidity / Round", group = gSn, tooltip = "Seat each level on the nearest recent swing high/low or round number if it lies within the tolerance. Levels sit ON liquidity; probabilities recompute from the snapped distance.")
snapTol= input.float(0.18, "Snap Tolerance (× ATR)", minval = 0.02, maxval = 1.5, step = 0.02, group = gSn)
pivL   = input.int(8, "Swing Pivot Left", minval = 1, maxval = 50, group = gSn)
pivR   = input.int(4, "Swing Pivot Right", minval = 1, maxval = 50, group = gSn)
roundStep = input.float(5.0, "Round-Number Step (price)", minval = 0.0, step = 0.5, group = gSn, tooltip = "e.g. 5 or 10 for gold, 0 to disable round-number snapping.")

// ─────────────────────────────── Projection Visuals ───────────────────────────────
gV      = "═══ Projection Visuals ═══"
projBars= input.int(10, "Projection Length (bars)", minval = 2, maxval = 120, group = gV)
gapBars = input.int(2,  "Gap From Last Bar", minval = 0, maxval = 30, group = gV)
glowN   = input.int(3,  "Beam Glow Layers", minval = 1, maxval = 6, group = gV)
beamAtr = input.float(0.10, "Beam Thickness (× ATR)", minval = 0.02, maxval = 1.0, step = 0.01, group = gV)
showBox = input.bool(false, "Shade Expected-Range Box", group = gV)
showSkel= input.bool(true, "Draw Projected Candle Skeleton", group = gV)
showMeanL = input.bool(true, "Show Expected High/Low Lines", group = gV)
showRef = input.bool(true, "Show Anchor Reference Line", group = gV)
showLbl = input.bool(true, "Show Probability Labels", group = gV)
labSizeIn = input.string("Normal", "Label Size", options = ["Tiny","Small","Normal","Large"], group = gV)

// ─────────────────────────────── Dashboard ───────────────────────────────
gD      = "═══ Dashboard ═══"
showDash= input.bool(true, "Show Dashboard", group = gD)
dashPos = input.string("Top Right", "Position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group = gD)
dashSz  = input.string("Normal", "Text Size", options = ["Tiny","Small","Normal","Large"], group = gD)

// ─────────────────────────────── Style ───────────────────────────────
gC      = "═══ Style (black-gold) ═══"
upLo    = input.color(#155e50, "Up · low prob",  group = gC, inline = "u")
upHi    = input.color(#5CFFB0, "Up · high prob", group = gC, inline = "u")
dnLo    = input.color(#6a1440, "Dn · low prob",  group = gC, inline = "d")
dnHi    = input.color(#ff3b6b, "Dn · high prob", group = gC, inline = "d")
goldCol = input.color(#FFD24A, "Accent / Gold", group = gC)
dashBg  = input.color(#0A0E17, "Dashboard BG", group = gC)
dashTx  = input.color(#EAF2FF, "Dashboard Text", group = gC)

// ─────────────────────────────── Neural Network ───────────────────────────────
gN       = "═══ Neural Network (10·14·12·6·3) ═══"
useNN    = input.bool(true,  "Use Network To Drive Projection", group = gN, tooltip = "A real MLP trained on XAUUSD H4 predicts next-bar RANGE, up/down split and direction. Its range output sharpens the projection scale θ; the split/direction feed the tilt. Turn OFF for the pure statistical model.")
wNN      = input.float(0.50, "Network Weight On θ (range)", minval = 0.0, maxval = 1.0, step = 0.05, group = gN, tooltip = "Blend of the network's range forecast vs the rolling statistical θ. 0.5 = half each. The network's honest edge is volatility/range (corr ≈ 0.45 out-of-sample, regime-dependent), so a balanced blend is safest.")
wNNdir   = input.float(0.25, "Network Weight In Tilt (direction)", minval = 0.0, maxval = 1.0, step = 0.05, group = gN, tooltip = "How much the network's direction output feeds the (secondary) tilt. Kept small — next-bar direction is ≈ a coin flip.")
showNet  = input.bool(true,  "Show Neural Network Map", group = gN)
netTheme = input.string("Neon", "Network Theme", options = ["Neon","Solar","Ice"], group = gN)
netSide  = input.string("Left", "Map Placement", options = ["Left","Right"], group = gN, tooltip = "Left = over history, positioned by 'Bars Back' below. Right = out past the projection.")
netBack  = input.int(52, "Bars Back (Left placement)", minval = 8, maxval = 500, group = gN, tooltip = "How many bars left of the current bar the network's LEFT edge sits. Slide this to drop the whole module inside your box. Only used when Placement = Left.")
netOff   = input.int(6,  "Right Offset (bars)", minval = 0, maxval = 200, group = gN, tooltip = "Gap past the projection when Placement = Right.")
netGap   = input.int(9,  "Column Spacing (bars)", minval = 2, maxval = 40, group = gN)
netH     = input.float(2.4, "Map Height (% of price)", minval = 0.5, maxval = 20.0, step = 0.1, group = gN, tooltip = "Keep small so the whole net fits on screen. ~2-3% suits a normal H4 zoom.")
netWire  = input.string("Full", "Connectors", options = ["Full","Strong only"], group = gN, tooltip = "Full = every node wired to every node in the next layer (thin, brightness by live weight×activation). Strong only = just the top N per layer.")
netEdges = input.int(7, "Strong: Connectors Per Layer", minval = 1, maxval = 40, group = gN, tooltip = "Used only when Connectors = Strong only.")
netEdgeK = input.float(3.2, "Connection Brightness ×", minval = 1.0, maxval = 25.0, step = 0.2, group = gN)
netPanel = input.bool(false, "Background Panel", group = gN)
netNodeV = input.bool(false, "Show Node Activations", group = gN)
netFeat  = input.bool(false, "Show Feature Tags", group = gN)
netGlow  = input.bool(true, "Node Glow Halo", group = gN)

// ─────────────────────────────── Alerts ───────────────────────────────
gA      = "═══ Alerts ═══"
alProx  = input.float(0.08, "Level Proximity (% of price)", minval = 0.0, step = 0.01, group = gA)
alHiOnly= input.bool(true, "Only Alert High-Prob (Band 1/2)", group = gA)

// ═══════════════════════════════ Helpers ═══════════════════════════════
clamp01(x) => math.min(math.max(x, 0.0), 1.0)
f_lsz(s)   => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal
f_stars(p) => p >= 0.70 ? "★★★★★" : p >= 0.55 ? "★★★★" : p >= 0.40 ? "★★★" : p >= 0.25 ? "★★" : "★"
f_tier(p)  => p >= 0.70 ? "PRIME" : p >= 0.55 ? "LIKELY" : p >= 0.40 ? "COIN" : p >= 0.25 ? "REACH" : "TAIL"

f_logit(p)    => math.log(math.max(p, 1e-6) / math.max(1.0 - p, 1e-6))
f_invlogit(x) => 1.0 / (1.0 + math.exp(-x))

f_upheat(float p) => color.from_gradient(clamp01(p), 0.0, 1.0, upLo, upHi)
f_dnheat(float p) => color.from_gradient(clamp01(p), 0.0, 1.0, dnLo, dnHi)
f_op(float p)     => int(math.round(70 - clamp01(p) * 48))   // transparency: high prob ~22, low prob ~70

f_dpos(s) => s == "Top Left" ? position.top_left : s == "Bottom Right" ? position.bottom_right : s == "Bottom Left" ? position.bottom_left : s == "Middle Right" ? position.middle_right : position.top_right

// ═══════════════════════════════ Neural Network (trained on XAUUSD H4) ═══════════════════════════════
// draw buffers declared here so the network helpers can push into them
var array<line>  vLines = array.new<line>()
var array<label> vLabs  = array.new<label>()
var array<box>   vBoxes = array.new<box>()

// MLP 10·14·12·6·3, tanh hidden / linear out. Outputs: [next-bar RANGE fraction,
// UP-share, direction]. Weights row-major (i*nout+j). Trained offline; forward pass
// runs live below. Honest edge: RANGE/volatility (corr ≈ 0.45 OOS, regime-dependent);
// UP-share ≈ symmetric and direction ≈ coin-flip (kept as small secondary tilt).
