//@version=6
indicator("Daily Bias Trade Manager [MarkitTick]", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

// -----------------------------------------------------------------------------
// 1. Constants & Configuration
// -----------------------------------------------------------------------------

// --- Constants ---
int MS_PER_DAY = 86400000  

// --- Group: General ---
string G_GENERAL       = "General Settings"
bool   inShowLong      = input.bool(true, "Show Long Position Boxes", group = G_GENERAL)
bool   inShowShort     = input.bool(true, "Show Short Position Boxes", group = G_GENERAL)
bool   inShowSweepZones= input.bool(true, "Show Liquidity Sweep Zones", group = G_GENERAL)
bool   inShowDaily     = input.bool(true, "Show Daily Liquidity (PDH/PDL)", group = G_GENERAL)

// --- Group: Display Limits ---
string G_LIMITS        = "Display Limits"
int    inMaxSignals    = input.int(1, "Max Signals Displayed", minval = 1, maxval = 500, tooltip = "Limits the number of Buy/Sell labels.", group = G_LIMITS)
int    inMaxZones      = input.int(1, "Max Sweep Zones", minval = 1, maxval = 500, group = G_LIMITS)
int    inMaxPositions  = input.int(1, "Max Position Boxes", minval = 1, maxval = 100, tooltip = "Limits active/historical trade boxes.", group = G_LIMITS)
int    inMaxFvgs       = input.int(1, "Max FVG Clouds", minval = 1, maxval = 100, group = G_LIMITS)

// --- Group: Session Filter ---
string G_SESSION       = "Session Filter"
bool   inUseSession    = input.bool(false, "Filter by Session Time", group = G_SESSION)
string inSessionSpec   = input.session("0930-1600", "Session Hours", group = G_SESSION)

// --- Group: Trend Filter ---
string G_TREND         = "Trend Filter"
bool   inUseTrendFilter= input.bool(false, "Enable Trend Filter (EMA)", group = G_TREND)
int    inTrendLen      = input.int(200, "Trend EMA Length", minval = 1, group = G_TREND)

// --- Group: Volume Validation ---
string G_VOLUME        = "Volume & Delta Validation"
bool   inUseVolFilter  = input.bool(false, "Enable Volume Validation (RVOL)", group = G_VOLUME)
int    inVolLen        = input.int(20, "Volume SMA Length", minval = 1, group = G_VOLUME)
float  inRvolThresh    = input.float(1.5, "RVOL Threshold (Climax)", minval = 1.0, step = 0.1, group = G_VOLUME)

// --- Group: Detection Logic ---
string G_DETECT        = "Detection Logic"
int    inSwingLen      = input.int(5, "Swing Detection Length", minval = 2, maxval = 20, group = G_DETECT)
int    inRsiLen        = input.int(14, "RSI Length", minval = 2, group = G_DETECT)
int    inRsiThreshold  = input.int(50, "RSI Momentum Threshold", minval = 20, maxval = 80, group = G_DETECT)
bool   inUseRsiFilter  = input.bool(false, "Enable RSI Momentum Filter", group = G_DETECT)
int    inCisdBars      = input.int(10, "CISD Detection Window (Bars)", minval = 1, maxval = 20, group = G_DETECT)
bool   inUseFvgEntry   = input.bool(false, "Use FVG Entry Model (Limit)", group = G_DETECT)
bool   inUseMss        = input.bool(true, "Require MSS Displacement", tooltip = "Requires the CISD breakout to have a large body OR create a gap.", group = G_DETECT)
float  inMssFactor     = input.float(1.5, "MSS Body Multiplier", minval = 1.0, step = 0.1, group = G_DETECT)

// --- Group: Targets ---
string G_TARGETS       = "Target Settings"
float  inRR1           = input.float(1.0, "Target 1 (R:R)", minval = 0.5, step = 0.5, group = G_TARGETS)
float  inRR2           = input.float(2.0, "Target 2 (R:R)", minval = 1.0, step = 0.5, group = G_TARGETS)
float  inRR3           = input.float(3.0, "Target 3 (R:R)", minval = 1.5, step = 0.5, group = G_TARGETS)
bool   inShowTP1       = input.bool(true, "Show Target 1", group = G_TARGETS)
bool   inShowTP2       = input.bool(false, "Show Target 2", group = G_TARGETS)
bool   inShowTP3       = input.bool(false, "Show Target 3", group = G_TARGETS)
bool   inShowSL        = input.bool(true, "Show Stop Loss", group = G_TARGETS)

// --- Group: Dynamic Trade Management ---
string G_DYNAMIC       = "Dynamic Trade Management"
bool   inUseDynamic    = input.bool(false, "Use Dynamic Targets", group = G_DYNAMIC)
bool   inUseTrail      = input.bool(false, "Use ATR Trailing Stop", group = G_DYNAMIC)
float  inTrailMult     = input.float(1.5, "Trailing Stop ATR Multiplier", minval = 0.1, step = 0.1, group = G_DYNAMIC)

// --- Group: Visuals ---
string G_VISUALS       = "Visual Settings"
bool   inShowFvg       = input.bool(true, "Show FVG Clouds (Equilibrium)", group = G_VISUALS)
color  colBuySweep     = input.color(color.new(#26a69a, 70), "Buy-Side Sweep Zone", group = G_VISUALS)
color  colSellSweep    = input.color(color.new(#ef5350, 70), "Sell-Side Sweep Zone", group = G_VISUALS)
color  colFvg          = input.color(color.new(color.yellow, 85), "FVG Cloud Color", group = G_VISUALS)
color  colBuySignal    = input.color(color.new(#00e676, 0), "Buy Signal Color", group = G_VISUALS)
color  colSellSignal   = input.color(color.new(#ff1744, 0), "Sell Signal Color", group = G_VISUALS)
color  colPDH          = input.color(color.new(#ff9800, 20), "PDH Line Color", group = G_VISUALS)
color  colPDL          = input.color(color.new(#2196f3, 20), "PDL Line Color", group = G_VISUALS)
color  colTP           = input.color(color.new(#00bcd4, 0), "Target Color", group = G_VISUALS)
color  colSL           = input.color(color.new(#e91e63, 0), "Stop Loss Color", group = G_VISUALS)

// --- Group: Alerts ---
string G_ALERTS        = "Alert Settings"

// --- Group: MTF Dashboard ---
string G_DASH          = "MTF Dashboard"
bool   inShowDash      = input.bool(true, "Show MTF Panel", group = G_DASH)
string inHtf1          = input.timeframe("15", "Timeframe 1", group = G_DASH)
string inHtf2          = input.timeframe("60", "Timeframe 2 (Golden)", group = G_DASH)
string inHtf3          = input.timeframe("240", "Timeframe 3", group = G_DASH)
string inDashSize      = input.string("Small", "Panel Size", options=["Tiny", "Small", "Normal", "Large"], group = G_DASH)
string inDashPos       = input.string("Top Right", "Panel Position", options=["Top Right", "Bottom Right", "Bottom Left", "Top Left"], group = G_DASH)

// -----------------------------------------------------------------------------
// 2. Type Definitions
// -----------------------------------------------------------------------------

type LiquidityZone
    int   leftIndex
    int   leftTime
    float top
    float bottom
    bool  isBuySide
    box   displayBox

type PositionBox
    bool  active
    bool  isLong
    float entry
    float sl
    float tp1
    float tp2
    float tp3
    bool  tp1Hit
    box   displayBox
    line  lnEntry
    line  lnSL
    line  lnTP1
    line  lnTP2
    line  lnTP3
    label lbEntry
    label lbSL
    label lbTP1
    label lbTP2
    label lbTP3
    label lbSignal 

type SignalData
    int   barIndex
    bool  isBuy
    float price
    label signalLabel

type MarketState
    float pdh
    float pdl
    float lastSwingHigh
    int   lastSwingHighIdx
    float lastSwingLow
    int   lastSwingLowIdx
    bool  buySideSweepActive
    bool  sellSideSweepActive
    int   sweepBar
    float sweepPrice
    bool  fvgDrawn

// -----------------------------------------------------------------------------
// 3. Global Variables
// -----------------------------------------------------------------------------

var array<LiquidityZone> sweepZones    = array.new<LiquidityZone>()
var array<PositionBox>   positionBoxes = array.new<PositionBox>()
var array<SignalData>    signalHistory = array.new<SignalData>()
var array<box>           fvgBoxes      = array.new<box>()

var MarketState mktState = MarketState.new(na, na, na, na, na, na, false, false, na, na, false)

var table mtfTable = na

var line  lnPDH = na, var line lnPDL = na
var label lbPDH = na, var label lbPDL = na

var int lastBuyBar  = na
var int lastSellBar = na

var float cachedC1 = na, var float cachedH1 = na, var float cachedL1 = na
var float cachedPrevH1 = na, var float cachedPrevL1 = na, var float cachedEma1 = na
var float cachedC2 = na, var float cachedH2 = na, var float cachedL2 = na
var float cachedPrevH2 = na, var float cachedPrevL2 = na, var float cachedEma2 = na
var float cachedC3 = na, var float cachedH3 = na, var float cachedL3 = na
var float cachedPrevH3 = na, var float cachedPrevL3 = na, var float cachedEma3 = na

var int   t_pdhTime = na
var int   t_pdlTime = na
var float t_curHigh = na
var float t_curLow  = na
var int   t_curHighTime = na
var int   t_curLowTime  = na

// -----------------------------------------------------------------------------
// 4. Helper Functions
// -----------------------------------------------------------------------------

is_in_session() =>
    not inUseSession or not na(time(timeframe.period, inSessionSpec))

get_trend_color(float price, float ema) =>
    price > ema ? color.new(color.green, 20) : color.new(color.red, 20)

get_trend_text(float price, float ema) =>
    price > ema ? "BULL" : "BEAR"

get_liq_status(float curH, float curL, float prevH, float prevL) =>
    if curH > prevH
        ["Taking Buy Liq", color.new(color.green, 20)]
    else if curL < prevL
        ["Taking Sell Liq", color.new(color.red, 20)]
    else
        ["Inside Range", color.new(color.gray, 20)]

create_fvg_box(float top, float bottom) =>
    if inShowFvg
        if array.size(fvgBoxes) >= inMaxFvgs
            box.delete(array.shift(fvgBoxes))
            
        box b = box.new(bar_index - 2, top, bar_index + 10, bottom, border_color = na, bgcolor = colFvg)
        array.push(fvgBoxes, b)

create_sweep_zone(bool isBuySide, float zoneTop, float zoneBot, int leftIdx) =>
    if inShowSweepZones
        if array.size(sweepZones) >= inMaxZones
            LiquidityZone oldZone = array.shift(sweepZones)
            box.delete(oldZone.displayBox)

        color zoneColor = isBuySide ? colBuySweep : colSellSweep
        string zoneText = isBuySide ? "Buy-Side Sweep" : "Sell-Side Sweep"
        
        box zoneBox = box.new(leftIdx, zoneTop, bar_index + 20, zoneBot, 
            border_color = na, bgcolor = zoneColor, 
            text = zoneText, text_color = color.white, 
            text_size = size.small, text_halign = text.align_center, text_valign = text.align_center)
        
        LiquidityZone zone = LiquidityZone.new(leftIdx, time[bar_index - leftIdx], zoneTop, zoneBot, isBuySide, zoneBox)
        array.push(sweepZones, zone)

cleanup_old_position_box(PositionBox pos) =>
    box.delete(pos.displayBox)
    line.delete(pos.lnEntry)
    line.delete(pos.lnSL)
    line.delete(pos.lnTP1)
    line.delete(pos.lnTP2)
    line.delete(pos.lnTP3)
    label.delete(pos.lbEntry)
    label.delete(pos.lbSL)
    label.delete(pos.lbTP1)
    label.delete(pos.lbTP2)
    label.delete(pos.lbTP3)
    label.delete(pos.lbSignal)

create_position_box(bool isLong, float entryPrice, float slPrice, float tp1Price, float tp2Price, float tp3Price, label sigLbl) =>
    bool shouldShow = (isLong and inShowLong) or (not isLong and inShowShort)
    
    if shouldShow
        if array.size(positionBoxes) >= inMaxPositions
            cleanup_old_position_box(array.shift(positionBoxes))

        if array.size(positionBoxes) > 0
            for i = array.size(positionBoxes) - 1 to 0
                PositionBox pos = array.get(positionBoxes, i)
                if pos.isLong == isLong
                    cleanup_old_position_box(pos)
                    array.remove(positionBoxes, i)
        
        line lnE = line.new(bar_index, entryPrice, bar_index + 1, entryPrice, color = color.gray, style = line.style_solid, width = 2, extend = extend.right)
        label lbE = label.new(bar_index, entryPrice, "Entry: " + str.tostring(entryPrice, format.mintick), style = label.style_label_right, color = color.new(color.white, 80), textcolor = color.white, size = size.small)
        
        line lnS = na, label lbS = na
        if inShowSL
            lnS := line.new(bar_index, slPrice, bar_index + 1, slPrice, color = colSL, style = line.style_solid, width = 1, extend = extend.right)
            lbS := label.new(bar_index, slPrice, "SL: " + str.tostring(slPrice, format.mintick), style = label.style_label_right, color = colSL, textcolor = color.white, size = size.small)
        
        line lnT1 = na, label lbT1 = na
        if inShowTP1
            lnT1 := line.new(bar_index, tp1Price, bar_index + 1, tp1Price, color = colTP, style = line.style_dashed, width = 1, extend = extend.right)
            lbT1 := label.new(bar_index, tp1Price, "TP1: " + str.tostring(tp1Price, format.mintick), style = label.style_label_right, color = colTP, textcolor = color.white, size = size.small)
        
        line lnT2 = na, label lbT2 = na
        if inShowTP2
            lnT2 := line.new(bar_index, tp2Price, bar_index + 1, tp2Price, color = colTP, style = line.style_dashed, width = 1, extend = extend.right)
            lbT2 := label.new(bar_index, tp2Price, "TP2: " + str.tostring(tp2Price, format.mintick), style = label.style_label_right, color = colTP, textcolor = color.white, size = size.small)
        
        line lnT3 = na, label lbT3 = na
        if inShowTP3
            lnT3 := line.new(bar_index, tp3Price, bar_index + 1, tp3Price, color = colTP, style = line.style_dashed, width = 1, extend = extend.right)
            lbT3 := label.new(bar_index, tp3Price, "TP3: " + str.tostring(tp3Price, format.mintick), style = label.style_label_right, color = colTP, textcolor = color.white, size = size.small)
        
        PositionBox newPos = PositionBox.new(true, isLong, entryPrice, slPrice, tp1Price, tp2Price, tp3Price, false, na, lnE, lnS, lnT1, lnT2, lnT3, lbE, lbS, lbT1, lbT2, lbT3, sigLbl)
        array.push(positionBoxes, newPos)

create_signal_label(bool isBuy, float price, float atrVal) =>
    color sigColor  = isBuy ? colBuySignal : colSellSignal
    string sigText  = isBuy ? "BUY" : "SELL"
    string sigStyle = isBuy ? label.style_label_up : label.style_label_down
    float labelY    = isBuy ? low - (atrVal * 0.5) : high + (atrVal * 0.5)
    
    label.new(bar_index, labelY, sigText, style = sigStyle, color = sigColor, textcolor = color.white, size = size.normal)

// -----------------------------------------------------------------------------
// 5. Main Calculations
// -----------------------------------------------------------------------------

[dailyHigh, dailyLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

if not na(dailyHigh)
    mktState.pdh := dailyHigh
if not na(dailyLow)
    mktState.pdl := dailyLow

bool isNewDay = timeframe.change("D")
if isNewDay
    t_pdhTime := t_curHighTime
    t_pdlTime := t_curLowTime
    t_curHigh := high
    t_curLow  := low
    t_curHighTime := time
    t_curLowTime  := time
else
    if high > t_curHigh or na(t_curHigh)
        t_curHigh := high
        t_curHighTime := time
    if low < t_curLow or na(t_curLow)
        t_curLow := low
        t_curLowTime := time

float currentAtr = ta.atr(14)
float trendEma   = ta.ema(close, inTrendLen)
float bodySize   = math.abs(close - open)
float avgBody    = ta.sma(bodySize, 20)
float avgVol     = inUseVolFilter ? ta.sma(volume, inVolLen) : na
float rsiValue   = ta.rsi(close, inRsiLen)

bool isBigBody   = bodySize > (avgBody * inMssFactor)
bool rsiBullish  = rsiValue > inRsiThreshold and rsiValue > rsiValue[1]
bool rsiBearish  = rsiValue < inRsiThreshold and rsiValue < rsiValue[1]
bool pdhValid    = not na(mktState.pdh)
bool pdlValid    = not na(mktState.pdl)

if barstate.islast and inShowDaily
    line.delete(lnPDH), line.delete(lnPDL)
    label.delete(lbPDH), label.delete(lbPDL)
    
    if pdhValid
        int startX = na(t_pdhTime) ? time - MS_PER_DAY : t_pdhTime
        lnPDH := line.new(startX, mktState.pdh, time + (10 * timeframe.multiplier * 60000), mktState.pdh, xloc = xloc.bar_time, color = colPDH, width = 1, extend = extend.right)
        lbPDH := label.new(startX, mktState.pdh, "PDH", xloc = xloc.bar_time, style = label.style_label_right, color = color.new(colPDH, 50), textcolor = color.white, size = size.small)
    
    if pdlValid
        int startX = na(t_pdlTime) ? time - MS_PER_DAY : t_pdlTime
        lnPDL := line.new(startX, mktState.pdl, time + (10 * timeframe.multiplier * 60000), mktState.pdl, xloc = xloc.bar_time, color = colPDL, width = 1, extend = extend.right)
        lbPDL := label.new(startX, mktState.pdl, "PDL", xloc = xloc.bar_time, style = label.style_label_right, color = color.new(colPDL, 50), textcolor = color.white, size = size.small)

float pivotHigh = ta.pivothigh(high, inSwingLen, inSwingLen)
float pivotLow  = ta.pivotlow(low, inSwingLen, inSwingLen)

if not na(pivotHigh)
    mktState.lastSwingHigh    := pivotHigh
    mktState.lastSwingHighIdx := bar_index - inSwingLen

if not na(pivotLow)
    mktState.lastSwingLow     := pivotLow
    mktState.lastSwingLowIdx  := bar_index - inSwingLen

bool buySideSweep  = pdhValid and high > mktState.pdh and close < mktState.pdh
bool sellSideSweep = pdlValid and low < mktState.pdl and close > mktState.pdl

if buySideSweep
    mktState.buySideSweepActive := true
    mktState.sweepBar           := bar_index
    mktState.sweepPrice         := high
    mktState.fvgDrawn           := false
    create_sweep_zone(true, high, mktState.pdh, bar_index - 1)

if sellSideSweep
    mktState.sellSideSweepActive := true
    mktState.sweepBar            := bar_index
    mktState.sweepPrice          := low
    mktState.fvgDrawn            := false
    create_sweep_zone(false, mktState.pdl, low, bar_index - 1)

bool swingHighValid = not na(mktState.lastSwingHigh)
bool swingLowValid  = not na(mktState.lastSwingLow)

bool bullishCisd = swingHighValid and close > mktState.lastSwingHigh and close[1] <= mktState.lastSwingHigh
bool bearishCisd = swingLowValid and close < mktState.lastSwingLow and close[1] >= mktState.lastSwingLow

bool cisd_within_window_buy = false
bool cisd_within_window_sell = false

bool sweepBarValid = not na(mktState.sweepBar)

if mktState.buySideSweepActive and sweepBarValid
    int barsSinceSweep = bar_index - mktState.sweepBar
    if barsSinceSweep <= inCisdBars
        bool hasBearishFvg = high < low[2]
        if not mktState.fvgDrawn and hasBearishFvg
            create_fvg_box(low[2], high)
            mktState.fvgDrawn := true

        if bearishCisd and (not inUseMss or isBigBody or hasBearishFvg)
            cisd_within_window_sell := true

if mktState.sellSideSweepActive and sweepBarValid
    int barsSinceSweep = bar_index - mktState.sweepBar
    if barsSinceSweep <= inCisdBars
        bool hasBullishFvg = low > high[2]
        if not mktState.fvgDrawn and hasBullishFvg
            create_fvg_box(high[2], low)
            mktState.fvgDrawn := true
            
        if bullishCisd and (not inUseMss or isBigBody or hasBullishFvg)
            cisd_within_window_buy := true

bool buyConfluence  = cisd_within_window_buy and (not inUseRsiFilter or rsiBullish) and is_in_session()
bool sellConfluence = cisd_within_window_sell and (not inUseRsiFilter or rsiBearish) and is_in_session()

if inUseVolFilter and sweepBarValid and not na(avgVol)
    int barsSince = bar_index - mktState.sweepBar
    if barsSince >= 0 and barsSince < bar_index
        float sweepVol = volume[barsSince]
        float sweepAvgVol = avgVol[barsSince]
        if not na(sweepVol) and not na(sweepAvgVol) and sweepAvgVol > 0
            float volRatio = sweepVol / sweepAvgVol
            if volRatio < inRvolThresh
                buyConfluence := false
                sellConfluence := false

if inUseTrendFilter
    if buyConfluence and close < trendEma
        buyConfluence := false
    if sellConfluence and close > trendEma
        sellConfluence := false

bool validBuySignal  = buyConfluence and (na(lastBuyBar) or bar_index > lastBuyBar + 5)
bool validSellSignal = sellConfluence and (na(lastSellBar) or bar_index > lastSellBar + 5)

// -----------------------------------------------------------------------------
// 6. Signal Execution
// -----------------------------------------------------------------------------

if validBuySignal and barstate.isconfirmed
    float entryPrice = close
    bool fvgMet = true
    
    if inUseFvgEntry
        if low > high[2]
            entryPrice := high[2]
        else
            fvgMet := false
    
    if fvgMet
        float slPrice  = mktState.sweepPrice
        float risk     = math.abs(entryPrice - slPrice)
        
        if risk > 0
            float tp1Price = entryPrice + (risk * inRR1)
            float tp2Price = entryPrice + (risk * inRR2)
            float tp3Price = entryPrice + (risk * inRR3)

            if inUseDynamic
                if swingHighValid and mktState.lastSwingHigh > entryPrice
                    tp1Price := mktState.lastSwingHigh
                if pdhValid and mktState.pdh > entryPrice
                    tp2Price := mktState.pdh

            string jsonAlert = '{"ticker":"' + syminfo.ticker + '","action":"BUY","entry":' + str.tostring(entryPrice, format.mintick) + ',"sl":' + str.tostring(slPrice, format.mintick) + ',"tp1":' + str.tostring(tp1Price, format.mintick) + ',"tp2":' + str.tostring(tp2Price, format.mintick) + ',"tp3":' + str.tostring(tp3Price, format.mintick) + '}'
            alert(jsonAlert, alert.freq_once_per_bar_close)

            label sigLbl = create_signal_label(true, entryPrice, currentAtr)
            create_position_box(true, entryPrice, slPrice, tp1Price, tp2Price, tp3Price, sigLbl)
            
            array.push(signalHistory, SignalData.new(bar_index, true, entryPrice, sigLbl))
            if array.size(signalHistory) > inMaxSignals
                label.delete(array.shift(signalHistory).signalLabel)
            
            lastBuyBar := bar_index
            mktState.sellSideSweepActive := false

if validSellSignal and barstate.isconfirmed
    float entryPrice = close
    bool fvgMet = true
    
    if inUseFvgEntry
        if high < low[2]
            entryPrice := low[2]
        else
            fvgMet := false

    if fvgMet
        float slPrice  = mktState.sweepPrice
        float risk     = math.abs(slPrice - entryPrice)
        
        if risk > 0
            float tp1Price = entryPrice - (risk * inRR1)
            float tp2Price = entryPrice - (risk * inRR2)
            float tp3Price = entryPrice - (risk * inRR3)

            if inUseDynamic
                if swingLowValid and mktState.lastSwingLow < entryPrice
                    tp1Price := mktState.lastSwingLow
                if pdlValid and mktState.pdl < entryPrice
                    tp2Price := mktState.pdl

            string jsonAlert = '{"ticker":"' + syminfo.ticker + '","action":"SELL","entry":' + str.tostring(entryPrice, format.mintick) + ',"sl":' + str.tostring(slPrice, format.mintick) + ',"tp1":' + str.tostring(tp1Price, format.mintick) + ',"tp2":' + str.tostring(tp2Price, format.mintick) + ',"tp3":' + str.tostring(tp3Price, format.mintick) + '}'
            alert(jsonAlert, alert.freq_once_per_bar_close)

            label sigLbl = create_signal_label(false, entryPrice, currentAtr)
            create_position_box(false, entryPrice, slPrice, tp1Price, tp2Price, tp3Price, sigLbl)

            array.push(signalHistory, SignalData.new(bar_index, false, entryPrice, sigLbl))
            if array.size(signalHistory) > inMaxSignals
                label.delete(array.shift(signalHistory).signalLabel)

            lastSellBar := bar_index
            mktState.buySideSweepActive := false

if sweepBarValid
    int timeSinceSweep = bar_index - mktState.sweepBar
    int resetThreshold = inCisdBars * 2
    
    if timeSinceSweep > resetThreshold
        mktState.buySideSweepActive := false
        mktState.sellSideSweepActive := false

// -----------------------------------------------------------------------------
// 7. Active Trade Management
// -----------------------------------------------------------------------------

int posSize = array.size(positionBoxes)
if posSize > 0
    for i = posSize - 1 to 0
        PositionBox pos = array.get(positionBoxes, i)
        
        bool shouldDelete = false
        bool shouldClose = false

        if pos.isLong
            if close < pos.sl
                shouldDelete := true
            else if high >= pos.tp3 or low <= pos.sl
                shouldClose := true
        else
            if close > pos.sl
                shouldDelete := true
            else if low <= pos.tp3 or high >= pos.sl
                shouldClose := true
        
        if shouldDelete
            cleanup_old_position_box(pos)
            array.remove(positionBoxes, i)
        else if pos.active
            bool slChanged = false
            
            if inUseTrail
                if pos.isLong
                    if high >= pos.tp1
                        pos.tp1Hit := true
                    
                    if pos.tp1Hit
                        float newSL = high - (currentAtr * inTrailMult)
                        if newSL > pos.sl
                            pos.sl := newSL
                            slChanged := true
                else
                    if low <= pos.tp1
                        pos.tp1Hit := true
                    
                    if pos.tp1Hit
                        float newSL = low + (currentAtr * inTrailMult)
                        if newSL < pos.sl
                            pos.sl := newSL
                            slChanged := true
            
            if slChanged
                line.set_y1(pos.lnSL, pos.sl)
                line.set_y2(pos.lnSL, pos.sl)
                label.set_text(pos.lbSL, "Trail SL: " + str.tostring(pos.sl, format.mintick))
                label.set_y(pos.lbSL, pos.sl)

            if shouldClose
                line.set_extend(pos.lnEntry, extend.none)
                line.set_extend(pos.lnSL, extend.none)
                line.set_extend(pos.lnTP1, extend.none)
                line.set_extend(pos.lnTP2, extend.none)
                line.set_extend(pos.lnTP3, extend.none)
                
                line.set_x2(pos.lnEntry, bar_index)
                line.set_x2(pos.lnSL, bar_index)
                line.set_x2(pos.lnTP1, bar_index)
                line.set_x2(pos.lnTP2, bar_index)
                line.set_x2(pos.lnTP3, bar_index)
                
                pos.active := false
                array.set(positionBoxes, i, pos)
            else if slChanged
                array.set(positionBoxes, i, pos)

// -----------------------------------------------------------------------------
// 8. Alerts & Display
// -----------------------------------------------------------------------------

alertcondition(validBuySignal and barstate.isconfirmed, "Liquidity Sweep BUY", "🟢 BUY SIGNAL: {{ticker}} @ {{close}}")
alertcondition(validSellSignal and barstate.isconfirmed, "Liquidity Sweep SELL", "🔴 SELL SIGNAL: {{ticker}} @ {{close}}")

plot(mktState.pdh, "PDH Data", color = color.new(colPDH, 100), display = display.data_window)
plot(mktState.pdl, "PDL Data", color = color.new(colPDL, 100), display = display.data_window)
plot(rsiValue, "RSI", color = color.new(color.purple, 100), display = display.data_window)

// -----------------------------------------------------------------------------
// 9. HTF Dashboard 
// -----------------------------------------------------------------------------

float htfEma1 = request.security(syminfo.tickerid, inHtf1, ta.ema(close, inTrendLen), lookahead = barmerge.lookahead_on)
float htfEma2 = request.security(syminfo.tickerid, inHtf2, ta.ema(close, inTrendLen), lookahead = barmerge.lookahead_on)
float htfEma3 = request.security(syminfo.tickerid, inHtf3, ta.ema(close, inTrendLen), lookahead = barmerge.lookahead_on)

if inShowDash
    bool shouldUpdateHTF = barstate.islast or 
                           timeframe.change(inHtf1) or 
                           timeframe.change(inHtf2) or 
                           timeframe.change(inHtf3)
    
    if shouldUpdateHTF
        [c1, h1, l1, prevH1, prevL1] = request.security(syminfo.tickerid, inHtf1, [close, high, low, high[1], low[1]], lookahead = barmerge.lookahead_on)
        [c2, h2, l2, prevH2, prevL2] = request.security(syminfo.tickerid, inHtf2, [close, high, low, high[1], low[1]], lookahead = barmerge.lookahead_on)
        [c3, h3, l3, prevH3, prevL3] = request.security(syminfo.tickerid, inHtf3, [close, high, low, high[1], low[1]], lookahead = barmerge.lookahead_on)
        
        cachedC1 := c1, cachedH1 := h1, cachedL1 := l1, cachedPrevH1 := prevH1, cachedPrevL1 := prevL1, cachedEma1 := htfEma1
        cachedC2 := c2, cachedH2 := h2, cachedL2 := l2, cachedPrevH2 := prevH2, cachedPrevL2 := prevL2, cachedEma2 := htfEma2
        cachedC3 := c3, cachedH3 := h3, cachedL3 := l3, cachedPrevH3 := prevH3, cachedPrevL3 := prevL3, cachedEma3 := htfEma3

    if barstate.islast
        [liqStat1, liqCol1] = get_liq_status(cachedH1, cachedL1, cachedPrevH1, cachedPrevL1)
        [liqStat2, liqCol2] = get_liq_status(cachedH2, cachedL2, cachedPrevH2, cachedPrevL2)
        [liqStat3, liqCol3] = get_liq_status(cachedH3, cachedL3, cachedPrevH3, cachedPrevL3)

        string tblPos = switch inDashPos
            "Bottom Right" => position.bottom_right
            "Top Left"     => position.top_left
            "Bottom Left"  => position.bottom_left
            => position.top_right

        string tblSize = switch inDashSize
            "Tiny"   => size.tiny
            "Normal" => size.normal
            "Large"  => size.large
            => size.small

        if na(mtfTable)
            mtfTable := table.new(tblPos, 4, 4, bgcolor = color.new(color.black, 50), border_color = color.white, border_width = 1, frame_color = color.white, frame_width = 1)

        table.cell(mtfTable, 0, 0, "Timeframe", text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = tblSize)
        table.cell(mtfTable, 1, 0, "Trend (EMA)", text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = tblSize)
        table.cell(mtfTable, 2, 0, "Liquidity", text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = tblSize)

        table.cell(mtfTable, 0, 1, inHtf1, text_color = color.white, text_size = tblSize)
        table.cell(mtfTable, 1, 1, get_trend_text(cachedC1, cachedEma1), text_color = color.white, bgcolor = get_trend_color(cachedC1, cachedEma1), text_size = tblSize)
        table.cell(mtfTable, 2, 1, liqStat1, text_color = color.white, bgcolor = liqCol1, text_size = tblSize)

        table.cell(mtfTable, 0, 2, inHtf2 + " 🌟", text_color = color.yellow, text_size = tblSize)
        table.cell(mtfTable, 1, 2, get_trend_text(cachedC2, cachedEma2), text_color = color.white, bgcolor = get_trend_color(cachedC2, cachedEma2), text_size = tblSize)
        table.cell(mtfTable, 2, 2, liqStat2, text_color = color.white, bgcolor = liqCol2, text_size = tblSize)

        table.cell(mtfTable, 0, 3, inHtf3, text_color = color.white, text_size = tblSize)
        table.cell(mtfTable, 1, 3, get_trend_text(cachedC3, cachedEma3), text_color = color.white, bgcolor = get_trend_color(cachedC3, cachedEma3), text_size = tblSize)
        table.cell(mtfTable, 2, 3, liqStat3, text_color = color.white, bgcolor = liqCol3, text_size = tblSize)
