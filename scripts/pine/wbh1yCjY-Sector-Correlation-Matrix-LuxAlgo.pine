//@version=6
indicator("Sector Correlation Matrix [LuxAlgo]", "LuxAlgo - Sector Correlation Matrix", overlay = false)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR        = #089981
color BEAR_COLOR        = #f23645
color NEUTRAL_COLOR     = #808080
color DATA              = #DBDBDB
color HEADERS           = #808080
color BACKGROUND        = #161616
color BORDERS           = #2E2E2E

string TOP_RIGHT        = 'Top Right'
string BOTTOM_RIGHT     = 'Bottom Right'
string BOTTOM_LEFT      = 'Bottom Left'

string TINY             = 'Tiny'
string SMALL            = 'Small'
string NORMAL           = 'Normal'
string LARGE            = 'Large'
string HUGE             = 'Huge'

string DASHBOARD_GROUP  = 'Dashboard'
string LOGIC_GROUP      = 'Logic Settings'

// Tooltips
string benchTooltip     = 'The ticker symbol to compare the current asset against (e.g., SPY, QQQ, BTCUSDT).'
string corrTooltip      = 'The lookback period used to calculate the Pearson Correlation Coefficient.'
string dashboardTooltip = 'Enable or disable the dashboard.'
string posTooltip       = 'Select the dashboard location.'
string sizeTooltip      = 'Select the dashboard size.'

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
// Logic Inputs
benchInput              = input.symbol('AMEX:SPY', 'Benchmark Asset', group = LOGIC_GROUP, tooltip = benchTooltip)
corrLenInput            = input.int(50,            'Correlation Length', group = LOGIC_GROUP, tooltip = corrTooltip, minval = 2)

// Dashboard Inputs
dashboardInput          = input.bool(true,      'Show Dashboard',   group = DASHBOARD_GROUP, tooltip = dashboardTooltip)
dashboardPositionInput  = input.string(TOP_RIGHT, 'Position',       group = DASHBOARD_GROUP, tooltip = posTooltip,  options = [TOP_RIGHT, BOTTOM_RIGHT, BOTTOM_LEFT])
dashboardSizeInput      = input.string(SMALL,     'Size',           group = DASHBOARD_GROUP, tooltip = sizeTooltip, options = [TINY, SMALL, NORMAL, LARGE, HUGE])

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Fetch Benchmark Data
benchClose = request.security(benchInput, timeframe.period, close)

// Calculate Correlation
correlationValue = ta.correlation(close, benchClose, corrLenInput)

// Determine State and Color
string corrState = na
color  stateColor = na

if correlationValue > 0.7
    corrState  := "Strong Positive"
    stateColor := BULL_COLOR
else if correlationValue > 0.3
    corrState  := "Moderate Positive"
    stateColor := color.new(BULL_COLOR, 40)
else if correlationValue < -0.7
    corrState  := "Strong Negative"
    stateColor := BEAR_COLOR
else if correlationValue < -0.3
    corrState  := "Moderate Negative"
    stateColor := color.new(BEAR_COLOR, 40)
else
    corrState  := "Decoupled / Neutral"
    stateColor := NEUTRAL_COLOR

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard Logic
//---------------------------------------------------------------------------------------------------------------------{
var parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT       => position.top_right
    BOTTOM_RIGHT    => position.bottom_right
    BOTTOM_LEFT     => position.bottom_left

var parsedDashboardSize = switch dashboardSizeInput
    TINY            => size.tiny
    SMALL           => size.small
    NORMAL          => size.normal
    LARGE           => size.large
    HUGE            => size.huge

// Helper Functions
cell(table t_able, int column, int row, string data, color = #FFFFFF, align = text.align_right, color background = na, float height = 0) => 
    t_able.cell(column, row, data, text_color = color, text_size = parsedDashboardSize, text_halign = align, bgcolor = background, height = height)

divider(table t_able, int row, int lastColumn) =>    
    string rowDivider = '━━━━━━━━━━━━━━━━━━━━━━'
    t_able.merge_cells(0, row, lastColumn, row)
    cell(t_able, 0, row, rowDivider, align = text.align_center, height = 0.5, color = BORDERS)

// Initialize and Fill Table
if barstate.islast and dashboardInput
    var table corrTable = table.new(parsedDashboardPosition, 2, 7, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1, force_overlay = false)
    
    // Header
    corrTable.merge_cells(0, 0, 1, 0)
    cell(corrTable, 0, 0, 'Correlation Matrix', color = DATA, align = text.align_center)
    
    divider(corrTable, 1, 1)
    
    // Rows
    cell(corrTable, 0, 2, 'Benchmark',  color = HEADERS, align = text.align_left)
    cell(corrTable, 1, 2, benchInput,   color = DATA)
    
    divider(corrTable, 3, 1)
    
    cell(corrTable, 0, 4, 'Coefficient',color = HEADERS, align = text.align_left)
    cell(corrTable, 1, 4, str.format("{0,number,#.##}", correlationValue), color = stateColor)
    
    divider(corrTable, 5, 1)
    
    cell(corrTable, 0, 6, 'State',      color = HEADERS, align = text.align_left)
    cell(corrTable, 1, 6, corrState,    color = stateColor)

// Visual Plots (in separate pane)
hline(0.7, "Upper Threshold", color = color.new(HEADERS, 50), linestyle = hline.style_dashed)
hline(-0.7, "Lower Threshold", color = color.new(HEADERS, 50), linestyle = hline.style_dashed)
hline(0, "Zero Line", color = BORDERS)

plot(correlationValue, "Correlation", color = stateColor, linewidth = 2)

plot1 = plot(1, display = display.none, editable = false)
plot07 = plot(0.7, display = display.none, editable = false)
plotm07 = plot(-0.7, display = display.none, editable = false)
plotm1 = plot(-1, display = display.none, editable = false)

// Fills for visual intensity
fill(plot1, plot07, color.new(BULL_COLOR, 90), "Positive Zone")
fill(plotm1, plotm07, color.new(BEAR_COLOR, 90), "Negative Zone")

//---------------------------------------------------------------------------------------------------------------------}