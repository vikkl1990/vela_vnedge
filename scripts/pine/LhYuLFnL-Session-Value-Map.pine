//@version=6
// Session Value Map. Builds a volume-value map anchored to each session, not a rolling window:
// the developing value area of the live session, the prior session's POC / VAH / VAL carried forward as
// reference, and naked (untested) POCs that price has not returned to yet - plus prior-day levels and the
// opening range. Works on any futures or index chart. Education and analysis only - not financial advice.
// The confirmed liquidity-sweep signal + auto-tuning lives in WOW Algo Premium (invite-only).
indicator("Session Value Map", "Session Value Map", overlay=true, max_bars_back=5000, max_lines_count=100, max_labels_count=60)

// ---- inputs ----
grpS = "> Session"
tz     = input.string("America/New_York", "Timezone", options=["America/New_York","America/Chicago","America/Los_Angeles","Europe/London","UTC"], group=grpS)
rthStr = input.session("0930-1600", "Regular session", group=grpS)
onStr  = input.session("1800-0930", "Overnight session", group=grpS)
orMin  = input.int(30, "Opening range (minutes)", minval=1, maxval=240, group=grpS)

grpV = "> Session value"
showDev   = input.bool(true, "Developing value (live session)", grpV)
showPrior = input.bool(true, "Prior-session POC / VAH / VAL", grpV)
showNaked = input.bool(true, "Naked (untested) POCs", grpV)
maxNaked  = input.int(8, "Max naked POCs kept", minval=1, maxval=20, group=grpV)
vaPct     = input.float(70, "Value Area %", minval=50, maxval=90, group=grpV)
bins      = input.int(40, "Price bins", minval=10, maxval=80, group=grpV)

grpL = "> Reference levels"
showPD = input.bool(true,  "Prior day High / Low / Close", grpL)
showOR = input.bool(true,  "Opening range High / Low", grpL)
showLbl= input.bool(true,  "Show labels", grpL)
showCTA= input.bool(true,  "Show upgrade note", grpL)

grpC = "> Style"
cPoc = input.color(color.new(#d29922, 0),  "POC", grpC)
cVa  = input.color(color.new(#58a6ff, 0),  "Value area edges", grpC)
cShd = input.color(color.new(#58a6ff, 92), "Value area shade", grpC)
cNak = input.color(color.new(#f0b429, 30), "Naked POC", grpC)
cPD  = input.color(color.new(#8b949e, 10), "Prior day", grpC)
cOR  = input.color(color.new(#3fb950, 0),  "Opening range", grpC)

// ---- volume profile over a bar window [off .. off+cnt-1] ----
f_profWindow(int off, int cnt, int nb, float vp) =>
    float hi = high[off]
    float lo = low[off]
    if cnt > 1
        for i = off to off + cnt - 1
            hi := math.max(hi, high[i])
            lo := math.min(lo, low[i])
    float rng = hi - lo
    float poc = na, float vah = na, float val = na
    if rng > 0 and not na(rng)
        float bw = rng / nb
        b = array.new_float(nb, 0.0)
        for i = off to off + cnt - 1
            float bH = high[i], float bL = low[i], float bV = nz(volume[i], 1.0)
            if not na(bH) and not na(bL) and bH > bL
                loi = math.max(0, int(math.floor((bL - lo) / bw)))
                hii = math.min(nb - 1, int(math.floor((bH - lo) / bw)))
                sp = hii - loi + 1
                if sp > 0
                    for k = loi to hii
                        array.set(b, k, array.get(b, k) + bV / sp)
            else if not na(bH)
                idx = math.max(0, math.min(nb - 1, int(math.floor((bH - lo) / bw))))
                array.set(b, idx, array.get(b, idx) + bV)
        pi = 0, pv = 0.0, tot = 0.0
        for i = 0 to nb - 1
            v = array.get(b, i)
            tot := tot + v
            if v > pv
                pv := v, pi := i
        cum = pv, up = pi, dn = pi
        tgt = tot * vp / 100.0
        while cum < tgt and (up < nb - 1 or dn > 0)
            un  = up < nb - 1 ? array.get(b, up + 1) : -1.0
            dnn = dn > 0 ? array.get(b, dn - 1) : -1.0
            if un >= dnn and un >= 0
                up := up + 1, cum := cum + un
            else if dnn >= 0
                dn := dn - 1, cum := cum + dnn
            else
                break
        poc := lo + (pi + 0.5) * bw
        vah := lo + (up + 1.0) * bw
        val := lo + dn * bw
    [poc, vah, val]

// ---- session detection ----
inRth = not na(time(timeframe.period, rthStr, tz))
inON  = not na(time(timeframe.period, onStr, tz))
sess  = inRth ? 1 : inON ? 2 : 0
priorType = nz(sess[1], 0)
justEnded = priorType != 0 and sess != priorType
newRth = inRth and not inRth[1]

var int curStart = na

// ---- prior-session value (snapshot when a session ends) ----
var float rthPoc = na, var float rthVah = na, var float rthVal = na
var float onPoc  = na, var float onVah  = na, var float onVal  = na
var float[] nakedP = array.new<float>()
var int[]   nakedB = array.new<int>()

if justEnded and not na(curStart)
    int len = math.min(bar_index - curStart, 480)
    if len >= 2
        [p, vh, vl] = f_profWindow(1, len, bins, vaPct)
        if not na(p)
            if priorType == 1
                rthPoc := p, rthVah := vh, rthVal := vl
            else
                onPoc := p, onVah := vh, onVal := vl
            if showNaked
                array.push(nakedP, p)
                array.push(nakedB, bar_index)
                if array.size(nakedP) > maxNaked
                    array.shift(nakedP)
                    array.shift(nakedB)

if sess != 0 and (na(curStart) or sess != priorType)
    curStart := bar_index

// ---- developing value (live session) ----
float devPoc = na, float devVah = na, float devVal = na
if showDev and sess != 0 and not na(curStart)
    int cnt = math.min(bar_index - curStart + 1, 480)
    if cnt >= 2
        [p, vh, vl] = f_profWindow(0, cnt, bins, vaPct)
        devPoc := p, devVah := vh, devVal := vl

// ---- mark naked POCs tested (price traded through them) ----
if showNaked and array.size(nakedP) > 0
    for i = 0 to array.size(nakedP) - 1
        float p = array.get(nakedP, i)
        if not na(p) and low <= p and high >= p
            array.set(nakedP, i, na)

// ---- prior-day H/L/C ----
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// ---- opening range ----
var float orH = na, var float orL = na, var int orStart = na
if newRth
    orH := high, orL := low, orStart := time
else if inRth and not na(orStart) and (time - orStart) < orMin * 60 * 1000
    orH := math.max(orH, high), orL := math.min(orL, low)

// ---- plots: developing + prior-session value ----
dP = plot(showDev ? devVah : na, "Dev VAH", color=cVa, linewidth=1, style=plot.style_linebr)
dV = plot(showDev ? devVal : na, "Dev VAL", color=cVa, linewidth=1, style=plot.style_linebr)
fill(dP, dV, color=showDev ? cShd : na)
plot(showDev ? devPoc : na, "Dev POC", color=cPoc, linewidth=2, style=plot.style_linebr)

plot(showPrior ? rthVah : na, "RTH VAH", color=color.new(cVa, 45), linewidth=1, style=plot.style_linebr)
plot(showPrior ? rthVal : na, "RTH VAL", color=color.new(cVa, 45), linewidth=1, style=plot.style_linebr)
plot(showPrior ? rthPoc : na, "RTH POC", color=color.new(cPoc, 30), linewidth=1, style=plot.style_linebr)
plot(showPrior ? onVah : na, "ON VAH", color=color.new(cVa, 65), linewidth=1, style=plot.style_linebr)
plot(showPrior ? onVal : na, "ON VAL", color=color.new(cVa, 65), linewidth=1, style=plot.style_linebr)
plot(showPrior ? onPoc : na, "ON POC", color=color.new(cPoc, 55), linewidth=1, style=plot.style_linebr)

plot(showPD ? pdh : na, "PDH", color=cPD, linewidth=1, style=plot.style_linebr)
plot(showPD ? pdl : na, "PDL", color=cPD, linewidth=1, style=plot.style_linebr)
plot(showPD ? pdc : na, "PDC", color=color.new(cPD, 40), linewidth=1, style=plot.style_linebr)
plot(showOR and inRth ? orH : na, "ORH", color=cOR, linewidth=1, style=plot.style_linebr)
plot(showOR and inRth ? orL : na, "ORL", color=cOR, linewidth=1, style=plot.style_linebr)

// ---- naked POC lines + labels (redraw on last bar) ----
var line[] nakedLines = array.new<line>()
var label[] lbls = array.new<label>()
var label ctaLbl = na
if barstate.islast
    if array.size(nakedLines) > 0
        for i = 0 to array.size(nakedLines) - 1
            line.delete(array.get(nakedLines, i))
        array.clear(nakedLines)
    if array.size(lbls) > 0
        for i = 0 to array.size(lbls) - 1
            label.delete(array.get(lbls, i))
        array.clear(lbls)
    if showNaked and array.size(nakedP) > 0
        for i = 0 to array.size(nakedP) - 1
            float p = array.get(nakedP, i)
            int bx = array.get(nakedB, i)
            if not na(p)
                array.push(nakedLines, line.new(bx, p, bar_index + 6, p, color=cNak, style=line.style_dotted, width=1))
                if showLbl
                    array.push(lbls, label.new(bar_index + 6, p, "naked POC", style=label.style_label_left, color=color.new(#0d1421, 25), textcolor=cNak, size=size.tiny))
    if showLbl
        if showDev and not na(devPoc)
            array.push(lbls, label.new(bar_index + 6, devPoc, "POC (dev)", style=label.style_label_left, color=color.new(#0d1421, 20), textcolor=cPoc, size=size.small))
        if showPrior and not na(rthPoc)
            array.push(lbls, label.new(bar_index + 6, rthPoc, "prior RTH POC", style=label.style_label_left, color=color.new(#0d1421, 20), textcolor=color.new(cPoc, 20), size=size.tiny))
    if not na(ctaLbl)
        label.delete(ctaLbl)
    if showCTA and not na(pdc)
        ctaLbl := label.new(bar_index + 6, pdc,
             "Session Value Map (free)\nConfirmed sweep signal + auto-tuning in WOW Algo Premium (invite-only)",
             style=label.style_label_left, color=color.new(#0d1421, 10), textcolor=color.new(color.white, 0), size=size.small)
