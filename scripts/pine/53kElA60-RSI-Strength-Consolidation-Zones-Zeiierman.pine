//@version=6
indicator('RSI Strength & Consolidation Zones (Zeiierman)', max_boxes_count = 500, max_labels_count = 500, precision = 1)
//~~}

//~~ Tooltips for Inputs {
var string t1 = "Defines how many bars the RSI uses to measure relative strength. Shorter values make it more reactive; longer values smooth out noise."
var string t2 = "Overbought level. When RSI crosses above this, it triggers a reset of the regression channel. Common levels: 70–90."
var string t3 = "Oversold level. When RSI crosses below this, it triggers a reset of the regression channel. Common levels: 10–30."
var string t4 = "Toggles the central regression line. This is the core trendline recalculated on every RSI reset."
var string t5 = "Toggles upper and lower standard deviation bands from the regression line, useful for spotting volatility zones."
var string t6 = "Maximum lookback for calculating regression after a reset. Actual length is limited by how many bars since last RSI trigger."
var string t7 = "Controls the width of the channel bands. Higher values make bands wider, capturing more price swings."
var string t8 = "Minimum number of bars required to start calculating a regression channel after an RSI reset. Helps filter out noise from immediate re-crosses."
var string t9 = "Displays triangle markers at RSI overbought (top) and oversold (bottom) resets."
var string t10 = "Marker colors for RSI resets — red for overbought, green for oversold."
var string t11 = "Shows dot markers when price rejects the upper or lower channel (e.g., wicks through, then closes back inside)."
var string t12 = "Marker colors for price rejection at upper or lower regression channel bands — red for upper, green for lower."
var string t13 = "Colors used for the upper and lower regression bands. Adjust transparency to blend or highlight."
var string t14 = "Adjusts thickness of the regression and channel lines."
var string t15 = "ADX smoothing length used to smooth out directional index (DI) values and derive the ADX line."
var string t16 = "Controls how aggressively the Kalman filter reacts to RSI and DMI changes. Higher values = faster reaction."
var string t17 = "Color of the enhanced RSI line that blends Kalman-filtered manual and built-in RSI."
var string t18 = "Color for filled area when trend is bullish and ADX confirms strength."
var string t19 = "Color for filled area when trend is bearish and ADX confirms weakness."
var string t20 = "Background fill color between RSI overbought and oversold bands."
var string t21 = "Box color to highlight low-volatility RSI consolidation zones."
var string t22 = "Color of breakout marker when price breaks above the consolidation zone."
var string t23 = "Color of breakout marker when price breaks below the consolidation zone."
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

//~~ Inputs {
rsiLength    = input.int(14, title = 'RSI Length', minval = 1, group = "RSI & DMI", tooltip=t1)
dmiLength    = input.int(14, title = 'DMI Length', minval = 1, group = "RSI & DMI", tooltip=t1)
adxSmoothing = input.int(14, title = 'ADX Smoothing', minval = 1, group = "RSI & DMI", tooltip=t15)
filterStrength = input.float(0.1, title='Trend Confirmation', minval=0.01, maxval=1, step=0.01, group="Trend Factor", tooltip=t16)

RSI_Col    = input.color(#32d3ff, title="Enhanced RSI", group="Style", tooltip=t17)
StrengthUp = input.color(#00e676, title="Bullish Strength", group="Style", tooltip=t18)
StrengthDn = input.color(color.red, title="Bearish Strength", group="Style", tooltip=t19)
fillColor  = input.color(#32d3ff, title="BG Color", group="Style", tooltip=t20)

BoxCol          = input.color(color.new(color.blue, 85), title="Consolidation Color", group="Style", tooltip=t21)
breakoutUpColor = input.color(#5eff32, title='Breakout Up Color', tooltip=t22)
breakoutDownColor = input.color(color.rgb(255, 50, 50), title='Breakout Down Color', tooltip=t23)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Functions {
// ~~ Highest and Lowest {
Highest(src, len) =>
    _len = math.max(1, len)
    hi = src
    for i = 1 to math.min(_len - 1, bar_index) by 1
        if src[i] > hi
            hi := src[i]
            hi
    hi

Lowest(src, len) =>
    _len = math.max(1, len)
    lo = src
    for i = 1 to math.min(_len - 1, bar_index) by 1
        if src[i] < lo
            lo := src[i]
            lo
    lo
    //~~~}

// ~~ RSI {
RSI(src, length) =>
    gains = 0.0
    losses = 0.0
    for i = 1 to length by 1
        change = src[i - 1] - src[i]
        gains := gains + (change > 0 ? change : 0)
        losses := losses + (change < 0 ? -change : 0)
        losses
    avgGain = gains / length
    avgLoss = losses / length
    rs = avgLoss == 0 ? 100 : avgGain / avgLoss
    rsi = 100 - 100 / (1 + rs)
    rsi
    //~~~}

// ~~ DMI {
DMI(length) =>
    sumTR = 0.0
    sumPlusDM = 0.0
    sumMinusDM = 0.0
    for i = 1 to length by 1
        highCur = high[i - 1]
        lowCur = low[i - 1]
        prevClose = close[i]

        trueHigh = Highest(highCur, 1)
        trueLow = Lowest(lowCur, 1)

        tr = math.max(Highest(highCur - lowCur, 1), math.abs(highCur - prevClose), math.abs(lowCur - prevClose))
        sumTR := sumTR + tr

        upMove = high[i - 1] - high[i]
        downMove = low[i] - low[i - 1]

        plusDM = upMove > downMove and upMove > 0 ? upMove : 0
        minusDM = downMove > upMove and downMove > 0 ? downMove : 0

        sumPlusDM := sumPlusDM + plusDM
        sumMinusDM := sumMinusDM + minusDM
        sumMinusDM

    plusDI = 100 * (sumPlusDM / sumTR)
    minusDI = 100 * (sumMinusDM / sumTR)
    dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adx = dx
    [plusDI, minusDI, adx]
    //~~~}

// ~~ Core DMI {
CoreDmi(len, adxLen) =>
    tr1 = high - low
    tr2 = math.abs(high - close[1])
    tr3 = math.abs(low - close[1])
    tr = math.max(tr1, tr2, tr3)
    upMove = high - high[1]
    downMove = low[1] - low
    plusDM = upMove > downMove and upMove > 0 ? upMove : 0.0
    minusDM = downMove > upMove and downMove > 0 ? downMove : 0.0
    smoothedTR = ta.rma(tr, len)
    smoothedPlusDM = ta.rma(plusDM, len)
    smoothedMinusDM = ta.rma(minusDM, len)
    plusDI = smoothedTR == 0 ? 0.0 : 100 * smoothedPlusDM / smoothedTR
    minusDI = smoothedTR == 0 ? 0.0 : 100 * smoothedMinusDM / smoothedTR
    diSum = plusDI + minusDI
    dx = diSum == 0 ? 0.0 : 100 * math.abs(plusDI - minusDI) / diSum
    adx = ta.rma(dx, adxLen)
    [plusDI, minusDI, adx]
    //~~~}

// ~~ Kalman Filter {
kf(src)=>
    var float kfRSI = na
    kfRSI    := na(kfRSI) ? src : kfRSI + filterStrength * (src - kfRSI)
    //~~~}    
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Calculate RSI {
rsi_        = kf(RSI(close, rsiLength))
rsi_inbuilt = kf(ta.rsi(close, rsiLength))
rsi = math.avg(rsi_inbuilt, rsi_)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Calculate DMI/ADX {
[p_d, m_d, a_d] = DMI(dmiLength)
[p_c, m_c, a_c] = CoreDmi(dmiLength, adxSmoothing)
a = kf(math.avg(a_d, a_c))
p = kf(math.avg(p_d, p_c))
m = kf(math.avg(m_d, m_c))
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~  Calculating the fill strength based on ADX {
str = a > 20 ? (a - 20) / 3 : 0
str := na(str) ? 0.0 : str
rsi_Strength = rsi - str
if rsi > 50
    rsi_Strength := rsi + str
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~  Plot RSI {
RSIPlot = plot(rsi, 'Enhanced RSI', color = RSI_Col)
UpperBand = plot(70, 'Upper Band', color = fillColor)
midline = hline(50, 'Middle Band', color = color.new(fillColor, 50))
LowerBand = plot(30, 'Lower Band', color = fillColor)
midLinePlot = plot(50, color = na, editable = false, display = display.none)
RSIStrength = plot(rsi_Strength, 'RSI + Strength', display = display.none)
i_rsi = plot(ta.wma(rsi_inbuilt, 5), display = display.none)
c_rsi = plot(ta.wma(rsi_, 5), display = display.none)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Fill {
fill(RSIStrength, RSIPlot, title = 'RSI Strength Fill', color = p > m ? StrengthUp : StrengthDn)
fill(UpperBand, LowerBand, color = color.new(fillColor, 90), title = 'RSI Background Fill')
fill(i_rsi, c_rsi, color = color.new(color.white, 80))
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~  Consolidtion Boxes {
var bool conditionMet = na(a_c) ? false : a_c <= 20
var bool inZone = false
var float zoneHigh = na
var float zoneLow = na
var int zoneStartBar = na
var box activeBox = na
var float lastBoxHigh = na
var float lastBoxLow = na
var int lastBoxEndBar = na
var bool breakoutSignalFired = false

conditionMet := na(a_c) ? false : a_c <= 20
if conditionMet
    if not inZone
        inZone := true
        zoneHigh := high
        zoneLow := low
        zoneStartBar := bar_index
        activeBox := box.new(zoneStartBar, zoneHigh, bar_index, zoneLow, border_color = BoxCol, border_width = 1, bgcolor = BoxCol, extend = extend.none, force_overlay = true)
        breakoutSignalFired := false
        lastBoxHigh := na
        lastBoxLow := na
        lastBoxEndBar := na
        lastBoxEndBar
    else
        zoneHigh := math.max(zoneHigh, high)
        zoneLow := math.min(zoneLow, low)
        box.set_top(activeBox, zoneHigh)
        box.set_bottom(activeBox, zoneLow)
        box.set_right(activeBox, bar_index)

else
    if inZone
        inZone := false
        box.set_right(activeBox, bar_index[1])
        lastBoxHigh := zoneHigh
        lastBoxLow := zoneLow
        lastBoxEndBar := bar_index[1]
        zoneHigh := na
        zoneLow := na
        zoneStartBar := na
        zoneStartBar

    if not na(lastBoxHigh) and not breakoutSignalFired and bar_index > lastBoxEndBar
        if ta.crossover(close, lastBoxHigh)
            breakoutSignalFired := true
            label.new(bar_index, lastBoxHigh, text = '▲', style = label.style_label_up, color = color.new(color.white, 100), textcolor = breakoutUpColor, size = size.small, force_overlay = true)
        if ta.crossunder(close, lastBoxLow)
            breakoutSignalFired := true
            label.new(bar_index, lastBoxLow, text = '▼', style = label.style_label_down, color = color.new(color.white, 100), textcolor = breakoutDownColor, size = size.small, force_overlay = true)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}