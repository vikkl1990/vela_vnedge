//@version=6
indicator("Rising/falling Three Methods"
  , shorttitle       = "Rising/falling Three Methods"
  , overlay          = true
  , max_boxes_count  = 500
  , max_lines_count  = 500
  , max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR = #089981
BEAR_COLOR = #f23645

RANGE_BASIS = "High-Low Range"
BODY_BASIS  = "Real Body"

TREND_SMA  = "SMA"
TREND_EMA  = "EMA"
TREND_NONE = "None"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
minMiddleInput = input.int(2, "Minimum Middle Candles", minval = 1, maxval = 5, group = "Pattern"
  , tooltip = "Fewest pause candles allowed between the first candle and the resolution candle. The classical form uses exactly three, practical scans accept two to five.")

maxMiddleInput = input.int(5, "Maximum Middle Candles", minval = 1, maxval = 8, group = "Pattern"
  , tooltip = "Most pause candles allowed between the first candle and the resolution candle.")

containBasisInput = input.string(RANGE_BASIS, "Containment Basis", options = [RANGE_BASIS, BODY_BASIS], group = "Pattern"
  , tooltip = "High-Low Range: middle candles must hold within the first candle's high-low range (standard definition). Real Body: middle candle bodies must additionally stay within the first candle's real body (strict reading, rarer and cleaner).")

toleranceInput = input.float(0.0, "Containment Tolerance %", minval = 0, maxval = 50, step = 1, group = "Pattern"
  , tooltip = "Allowance for minor range violations by the middle candles, as a percentage of the first candle's range. A middle candle close through the far end of the first candle's range always voids the pattern.")

bodyAvgLengthInput = input.int(14, "Body Average Length", minval = 2, group = "Candle Bodies"
  , tooltip = "Lookback used to average real body size. The first and resolution candles must be long relative to this average.")

longBodyInput = input.float(1.2, "Long Body Factor", minval = 0.1, step = 0.1, group = "Candle Bodies"
  , tooltip = "The first and resolution candles must have a real body at least this multiple of the average body, marking them as among the larger recent candles.")

smallBodyInput = input.float(0.5, "Small Body Factor", minval = 0.05, maxval = 1, step = 0.05, group = "Candle Bodies"
  , tooltip = "Each middle candle must have a real body no larger than this fraction of the first candle's body. Small resting bodies fit the pause logic, large opposing bodies argue for a real fight instead.")

trendBasisInput = input.string(TREND_SMA, "Trend Filter", options = [TREND_SMA, TREND_EMA, TREND_NONE], group = "Filters"
  , tooltip = "Trend context required at the first candle: price above the moving average for a rising pattern, below it for a falling pattern. None relies on the impulse candle direction alone.")

trendLengthInput = input.int(50, "Trend Length", minval = 2, group = "Filters"
  , tooltip = "Length of the moving average used for trend context.")

volumeCheckInput = input.bool(false, "Volume Confirmation", group = "Filters"
  , tooltip = "Requires volume to contract during the pause (middle candle average below the first candle) and expand on the resolution candle, mirroring the flag-trading convention. The classical definition is price-only, so this is off by default. Ignored when the symbol has no volume data.")

showZoneInput = input.bool(true, "Containment Zone", group = "Style")

showLabelInput = input.bool(true, "Pattern Labels", group = "Style")

showStopInput = input.bool(true, "Invalidation Level", inline = "inv", group = "Style")
extendInput   = input.int(10, "Extension", minval = 0, maxval = 100, inline = "inv", group = "Style"
  , tooltip = "Number of bars the invalidation level (far end of the containment range) extends beyond the resolution candle.")

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "col", group = "Style")
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "col", group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Base Calculations
//---------------------------------------------------------------------------------------------------------------------{
bodySize   = math.abs(close - open)
bodyTop    = math.max(close, open)
bodyBottom = math.min(close, open)
bodyAvg    = ta.sma(bodySize, bodyAvgLengthInput)

smaTrend = ta.sma(close, trendLengthInput)
emaTrend = ta.ema(close, trendLengthInput)
trendMa  = trendBasisInput == TREND_EMA ? emaTrend : smaTrend

useTrend     = trendBasisInput != TREND_NONE
useBodyBasis = containBasisInput == BODY_BASIS

minMiddle = math.min(minMiddleInput, maxMiddleInput)
maxMiddle = math.max(minMiddleInput, maxMiddleInput)

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{
// @function        Scans for a completed three methods pattern whose resolution candle is the current bar
// @param isBull    true detects the rising pattern, false detects the falling pattern
// @returns         Middle candle count of the tightest match, -1 when no pattern completes on this bar
detectPattern(bool isBull) =>
    int foundMiddle = -1

    //Resolution candle: long real body in the trend direction
    bool resolutionOk = not na(bodyAvg) and (isBull ? close > open : close < open) and bodySize > longBodyInput * bodyAvg

    if resolutionOk
        for middleCount = minMiddle to maxMiddle
            int firstOffset = middleCount + 1

            float firstOpen  = open[firstOffset]
            float firstClose = close[firstOffset]
            float firstHigh  = high[firstOffset]
            float firstLow   = low[firstOffset]
            float firstBody  = bodySize[firstOffset]

            if na(firstClose) or na(bodyAvg[firstOffset])
                continue

            //First candle: long real body in the trend direction, among the larger recent candles
            bool firstOk = (isBull ? firstClose > firstOpen : firstClose < firstOpen) and firstBody > longBodyInput * bodyAvg[firstOffset]

            //Trend context measured at the first candle
            bool trendOk = not useTrend or not na(trendMa[firstOffset]) and (isBull ? firstClose > trendMa[firstOffset] : firstClose < trendMa[firstOffset])

            //Resolution candle closes beyond the first candle close
            bool resolvesBeyond = isBull ? close > firstClose : close < firstClose

            //The pause drifts against the trend, ending beyond the first candle close
            bool driftOk = isBull ? close[1] < firstClose : close[1] > firstClose

            if not (firstOk and trendOk and resolvesBeyond and driftOk)
                continue

            float tolAmount  = (firstHigh - firstLow) * toleranceInput / 100
            float rangeCapHi = firstHigh + tolAmount
            float rangeCapLo = firstLow  - tolAmount
            float bodyCapHi  = bodyTop[firstOffset]    + tolAmount
            float bodyCapLo  = bodyBottom[firstOffset] - tolAmount

            bool  middlesOk   = true
            float pauseVolume = 0.0

            for offset = 1 to middleCount
                //Containment within the first candle range, with the tolerance allowance
                bool contained = high[offset] <= rangeCapHi and low[offset] >= rangeCapLo

                if useBodyBasis
                    contained := contained and bodyTop[offset] <= bodyCapHi and bodyBottom[offset] >= bodyCapLo

                //Small resting bodies relative to the first candle
                bool smallOk = bodySize[offset] <= smallBodyInput * firstBody

                //A close through the far end of the first candle range voids containment
                bool noVoidClose = isBull ? close[offset] >= firstLow : close[offset] <= firstHigh

                middlesOk   := middlesOk and contained and smallOk and noVoidClose
                pauseVolume += nz(volume[offset])

            //Optional volume convention: contraction in the pause, expansion on resolution
            bool volumeOk = true

            if volumeCheckInput and not na(volume) and not na(volume[firstOffset])
                float pauseAverage = pauseVolume / middleCount
                volumeOk := pauseAverage < volume[firstOffset] and volume > pauseAverage

            if middlesOk and volumeOk
                foundMiddle := middleCount
                break

    foundMiddle

int risingMiddle  = detectPattern(true)
int fallingMiddle = detectPattern(false)

bool risingDetected  = risingMiddle  != -1 and barstate.isconfirmed
bool fallingDetected = fallingMiddle != -1 and barstate.isconfirmed

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
if risingDetected
    int   firstOffset = risingMiddle + 1
    float zoneTop     = high[firstOffset]
    float zoneBottom  = low[firstOffset]

    if showZoneInput
        box.new(bar_index - firstOffset, zoneTop, bar_index, zoneBottom
          , border_color = bullColorInput
          , border_style = line.style_dashed
          , border_width = 1
          , bgcolor      = color.new(bullColorInput, 88))

    if showStopInput and extendInput > 0
        line.new(bar_index, zoneBottom, bar_index + extendInput, zoneBottom
          , color = bullColorInput
          , style = line.style_dashed)

    if showLabelInput
        label.new(bar_index, math.min(low, zoneBottom), "R3M"
          , style     = label.style_label_up
          , color     = bullColorInput
          , textcolor = chart.bg_color
          , size      = size.small
          , tooltip   = "Rising Three Methods - " + str.tostring(risingMiddle) + " middle candles, invalidation at " + str.tostring(zoneBottom, format.mintick))

if fallingDetected
    int   firstOffset = fallingMiddle + 1
    float zoneTop     = high[firstOffset]
    float zoneBottom  = low[firstOffset]

    if showZoneInput
        box.new(bar_index - firstOffset, zoneTop, bar_index, zoneBottom
          , border_color = bearColorInput
          , border_style = line.style_dashed
          , border_width = 1
          , bgcolor      = color.new(bearColorInput, 88))

    if showStopInput and extendInput > 0
        line.new(bar_index, zoneTop, bar_index + extendInput, zoneTop
          , color = bearColorInput
          , style = line.style_dashed)

    if showLabelInput
        label.new(bar_index, math.max(high, zoneTop), "F3M"
          , style     = label.style_label_down
          , color     = bearColorInput
          , textcolor = chart.bg_color
          , size      = size.small
          , tooltip   = "Falling Three Methods - " + str.tostring(fallingMiddle) + " middle candles, invalidation at " + str.tostring(zoneTop, format.mintick))

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(risingDetected, "Rising Three Methods", "Rising three methods completed on {{ticker}} ({{interval}}) - bullish continuation confirmed")

alertcondition(fallingDetected, "Falling Three Methods", "Falling three methods completed on {{ticker}} ({{interval}}) - bearish continuation confirmed")

alertcondition(risingDetected or fallingDetected, "Any Three Methods", "Three methods continuation pattern completed on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
