//@version=6
// ══════════════════════════════════════════════════════════
// ABCD HARMONIC PROJECTION [WillyAlgoTrader]
// ══════════════════════════════════════════════════════════
// Author:  Willy | WillyAlgoTrader
// Version: 1.4.1

indicator(
    title              = "ABCD Harmonic Projection [WillyAlgoTrader]",
    shorttitle         = "ABCD Harmonic",
    overlay            = true,
    max_lines_count    = 500,
    max_labels_count   = 500,
    max_boxes_count    = 500,
    max_bars_back      = 5000)

// ══════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════
GRP_MAIN    = "⚙️ Main Settings"
GRP_PATTERN = "📐 Pattern Settings"
GRP_VISUAL  = "🎨 Visual Settings"
GRP_DASH    = "📊 Dashboard"
GRP_ALERT   = "🔔 Alerts"
GRP_COLORS  = "🎨 Colors"
GRP_ADV     = "🔧 Advanced"

INDICATOR_VERSION = "v1.4.1"

// Fibonacci reference levels (single source of truth)
var array<float> FIB_LEVELS = array.from(0.382, 0.500, 0.618, 0.786, 0.886, 1.000, 1.272, 1.618)

// Fib extension levels for visual projection from C (AB*ratio)
var array<float> FIB_EXT_LEVELS = array.from(0.786, 1.0, 1.272, 1.618)
var array<string> FIB_EXT_NAMES = array.from("0.786", "1.0", "1.272", "1.618")

// Fib retracement levels within C→D (partial TP targets)
var array<float> FIB_RET_LEVELS = array.from(0.382, 0.5, 0.618)

// ══════════════════════════════════════
// INPUTS
// ══════════════════════════════════════

// ── Main Settings ───────────────────
zigzagLengthInput = input.int(8, "ZigZag Length", minval = 3, maxval = 100, step = 1, group = GRP_MAIN, tooltip = "Lookback period for ZigZag pivot detection.\n• Higher = fewer pivots, larger patterns\n• Lower = more pivots, smaller patterns\n• Recommended: 8–21")
sourceHighInput = input.source(high, "Pivot High Source", group = GRP_MAIN, tooltip = "Price source for swing highs")
sourceLowInput = input.source(low, "Pivot Low Source", group = GRP_MAIN, tooltip = "Price source for swing lows")

// ── Pattern Settings ────────────────
maxPatternsInput = input.int(3, "Max Patterns Displayed", minval = 1, maxval = 10, step = 1, group = GRP_PATTERN, tooltip = "Maximum number of ABCD patterns shown on chart.\n• Lower = cleaner chart\n• Higher = more historical context\n• Recommended: 2–5")
activeOnlyInput  = input.bool(true, "Show Active Only", group = GRP_PATTERN, tooltip = "When enabled, only the current active pattern is displayed.\nCompleted patterns (TP hit or SL hit) are hidden.\n• ON = clean chart, only live trade visible\n• OFF = full history of patterns shown")
minAbcRatioInput = input.float(0.382, "Min BC/AB Ratio", minval = 0.2, maxval = 1.0, step = 0.01, group = GRP_PATTERN, tooltip = "Minimum Fibonacci retracement of BC relative to AB.\n• Classic ABCD: 0.382–0.886\n• Stricter = fewer but higher-quality patterns\n• Recommended: 0.382")
maxAbcRatioInput = input.float(0.886, "Max BC/AB Ratio", minval = 0.382, maxval = 1.0, step = 0.01, group = GRP_PATTERN, tooltip = "Maximum Fibonacci retracement of BC relative to AB.\n• Classic ABCD: 0.382–0.886\n• Recommended: 0.886")
minCdAbRatioInput = input.float(0.786, "Min CD/AB Ratio", minval = 0.5, maxval = 2.0, step = 0.01, group = GRP_PATTERN, tooltip = "Minimum CD leg length relative to AB.\n• Classic ABCD: 1.0 (equal legs)\n• Extended: 1.272–1.618\n• Recommended: 0.786")
maxCdAbRatioInput = input.float(1.618, "Max CD/AB Ratio", minval = 0.5, maxval = 3.0, step = 0.01, group = GRP_PATTERN, tooltip = "Maximum CD leg length relative to AB.\n• Classic: 1.0, Extended: up to 1.618\n• Recommended: 1.618")
minScoreInput = input.int(40, "Min Pattern Score", minval = 0, maxval = 100, step = 5, group = GRP_PATTERN, tooltip = "Minimum quality score (0–100) to display pattern.\n• Higher = only best patterns\n• Lower = more patterns shown\n• Recommended: 40–60")
atrFilterInput = input.bool(true, "ATR Minimum Swing Filter", group = GRP_PATTERN, tooltip = "Filter out patterns where AB leg is smaller than 1x ATR.\nHelps avoid noise patterns on low-volatility bars")
atrLengthInput = input.int(14, "ATR Length", minval = 5, maxval = 50, step = 1, group = GRP_PATTERN, tooltip = "ATR period for swing size filter.\n• Recommended: 14")

// ── Visual Settings ─────────────────
showSignalsInput    = input.bool(true, "Show Buy/Sell Signals", group = GRP_VISUAL, tooltip = "Display confirmed entry signals at pattern completion")
showProjectionInput = input.bool(true, "Show D Projection", group = GRP_VISUAL, tooltip = "Display projected D-point with arrow line")
showFibLevelsInput  = input.bool(true, "Show Fib Levels (C→D)", group = GRP_VISUAL, tooltip = "Display Fibonacci retracement levels between C and projected D")
showTpSlInput       = input.bool(true, "Show TP/SL Zones", group = GRP_VISUAL, tooltip = "Display take-profit and stop-loss zones as boxes")
showLabelsInput     = input.bool(true, "Show A/B/C/D Labels", group = GRP_VISUAL, tooltip = "Display pivot point labels on the pattern")
showScoreInput      = input.bool(true, "Show Pattern Score", group = GRP_VISUAL, tooltip = "Display quality score next to each pattern")
showWatermarkInput  = input.bool(true, "Show Watermark", group = GRP_VISUAL, tooltip = "Display 'WillyAlgoTrader - by Willy' watermark on chart")

// ── Theme ───────────────────────────
themeInput = input.string("Auto", "Theme", options = ["Auto", "Dark", "Light"], group = GRP_VISUAL, tooltip = "Chart color theme.\n• Auto: detects from chart background\n• Dark: optimized for dark backgrounds\n• Light: optimized for light/white backgrounds")

// ── Dashboard ───────────────────────
showDashInput = input.bool(true, "Show Dashboard", group = GRP_DASH, tooltip = "Display statistics and current pattern info panel")
dashPosStr = input.string("Top Right", "Dashboard Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = GRP_DASH, tooltip = "Position of the dashboard panel on chart")

// ── Colors ──────────────────────────
bullColorInput = input.color(#00E676, "Bullish Pattern", inline = "colors1", group = GRP_COLORS, tooltip = "Color for bullish ABCD patterns (D projected above C)")
bearColorInput = input.color(#FF5252, "Bearish Pattern", inline = "colors1", group = GRP_COLORS, tooltip = "Color for bearish ABCD patterns (D projected below C)")
fibColorInput  = input.color(#42A5F5, "Fib Levels", group = GRP_COLORS, tooltip = "Color for Fibonacci level lines and labels")
projColorInput = input.color(#FFEB3B, "Projection Line", group = GRP_COLORS, tooltip = "Color for the projected D-point line")

// ── Alerts ──────────────────────────
webhookInput = input.bool(false, "Webhook JSON Format", group = GRP_ALERT, tooltip = "Send alerts in JSON format for webhook integrations.\nWhen disabled, sends human-readable text alerts")

// ── Advanced ────────────────────────
maxBarsProjectInput = input.int(200, "Max Bars for D Projection", minval = 50, maxval = 500, step = 50, group = GRP_ADV, tooltip = "Maximum bars into the future for D-point projection.\n• Limits overly distant projections\n• Recommended: 100–300")

// ══════════════════════════════════════
// THEME DETECTION & COLORS
// ══════════════════════════════════════
isDark = switch themeInput
    "Dark"  => true
    "Light" => false
    => color.r(chart.bg_color) < 128

TEXT_COLOR    = isDark ? #E0E0E0 : #1A1A1A
TEXT_MUTED    = isDark ? color.new(#9E9E9E, 0) : color.new(#757575, 0)
TABLE_BG      = isDark ? color.new(#131722, 5) : color.new(#FFFFFF, 5)
HEADER_BG     = color.new(#2962FF, 0)
HEADER_TEXT   = #FFFFFF
LABEL_TEXT    = #000000
WM_COLOR      = isDark ? color.new(#FFFFFF, 80) : color.new(#000000, 80)

// ── Theme-adaptive projection color ──
// On light backgrounds yellow is nearly invisible, so we use black instead
PROJ_COLOR = isDark ? projColorInput : #000000

// ══════════════════════════════════════
// FUNCTIONS
// ══════════════════════════════════════

safeDiv(float num, float den, float fallback = 0.0) =>
    den != 0 and not na(num) and not na(den) ? num / den : fallback

priceDist(float p1, float p2) =>
    math.abs(nz(p1) - nz(p2))

nearestFibDist(float ratio) =>
    float bestDist = 999.0
    for i = 0 to array.size(FIB_LEVELS) - 1
        float d = math.abs(ratio - array.get(FIB_LEVELS, i))
        if d < bestDist
            bestDist := d
    bestDist

// Pattern quality score (0–100)
scorePattern(float bcAbRatio, int abBars, int cdBarsEst) =>
    // 1. BC/AB proximity to nearest Fibonacci level (max 45 points)
    float distBc = nearestFibDist(bcAbRatio)
    float fibScore = math.max(0.0, 45.0 - distBc * 250.0)

    // 2. Time symmetry: estimated CD bars vs AB bars (max 25 points)
    float timeRatio = safeDiv(float(math.min(abBars, cdBarsEst)), float(math.max(abBars, cdBarsEst)), 0.0)
    float timeScore = timeRatio * 25.0

    // 3. Price symmetry: BC should not be too small vs AB (max 20 points)
    float bcAbNorm = math.min(bcAbRatio / 0.618, 1.0)
    float priceScore = bcAbNorm * 20.0

    // 4. Minimum leg size bonus (max 10 points)
    float legScore = abBars >= 8 ? 10.0 : abBars >= 5 ? 7.0 : abBars >= 3 ? 3.0 : 0.0

    math.round(math.min(100.0, fibScore + timeScore + priceScore + legScore))

// ══════════════════════════════════════
// DASHBOARD POSITION
// ══════════════════════════════════════
dashPos = switch dashPosStr
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    => position.top_right

// ══════════════════════════════════════
// ZIGZAG ENGINE
// ══════════════════════════════════════

int zzLen = zigzagLengthInput
float ph = ta.pivothigh(sourceHighInput, zzLen, zzLen)
float pl = ta.pivotlow(sourceLowInput, zzLen, zzLen)

var int   zzDir    = 0
var float zzLastH  = na
var float zzLastL  = na

var array<float> pivotPrices = array.new<float>()
var array<int>   pivotBars   = array.new<int>()
var array<int>   pivotDirs   = array.new<int>()

bool newPivotHigh = false
bool newPivotLow  = false
int  pivotOffset  = zzLen

if not na(ph)
    int phBar = bar_index - pivotOffset
    if zzDir == 1
        if ph > nz(zzLastH, 0.0)
            zzLastH := ph
            if array.size(pivotPrices) > 0
                array.set(pivotPrices, array.size(pivotPrices) - 1, ph)
                array.set(pivotBars, array.size(pivotBars) - 1, phBar)
    else
        zzDir   := 1
        zzLastH := ph
        array.push(pivotPrices, ph)
        array.push(pivotBars, phBar)
        array.push(pivotDirs, 1)
        newPivotHigh := true

if not na(pl)
    int plBar = bar_index - pivotOffset
    if zzDir == -1
        if pl < nz(zzLastL, 999999999.0)
            zzLastL := pl
            if array.size(pivotPrices) > 0
                array.set(pivotPrices, array.size(pivotPrices) - 1, pl)
                array.set(pivotBars, array.size(pivotBars) - 1, plBar)
    else
        zzDir   := -1
        zzLastL := pl
        array.push(pivotPrices, pl)
        array.push(pivotBars, plBar)
        array.push(pivotDirs, -1)
        newPivotLow := true

bool newPivot = newPivotHigh or newPivotLow

if array.size(pivotPrices) > 200
    array.shift(pivotPrices)
    array.shift(pivotBars)
    array.shift(pivotDirs)

// ══════════════════════════════════════
// CALCULATIONS
// ══════════════════════════════════════

int WARMUP_BARS = math.max(zigzagLengthInput * 4, 50)
bool isWarmedUp = bar_index >= WARMUP_BARS

float atrValue = nz(ta.atr(atrLengthInput), 0.0)

// ══════════════════════════════════════
// PATTERN STORAGE (parallel arrays)
// ══════════════════════════════════════

var array<float> patApriceArr = array.new<float>()
var array<int>   patAbarArr   = array.new<int>()
var array<float> patBpriceArr = array.new<float>()
var array<int>   patBbarArr   = array.new<int>()
var array<float> patCpriceArr = array.new<float>()
var array<int>   patCbarArr   = array.new<int>()
var array<float> patDpriceArr = array.new<float>()
var array<int>   patDbarArr   = array.new<int>()
var array<int>   patDirArr    = array.new<int>()
var array<int>   patScoreArr  = array.new<int>()
var array<int>   patStatusArr = array.new<int>()   // 0=active, 1=TP hit, -1=SL hit
var array<float> patEntryArr  = array.new<float>()
var array<float> patSlArr     = array.new<float>()
var array<float> patTpArr     = array.new<float>()
var array<int>   patTouchBarArr = array.new<int>()

// Drawing storage
var array<line>  drawnLines  = array.new<line>()
var array<label> drawnLabels = array.new<label>()
var array<box>   drawnBoxes  = array.new<box>()

// Statistics
var int   bullWins    = 0
var int   bullLosses  = 0
var int   bearWins    = 0
var int   bearLosses  = 0
var float bullTotalRR = 0.0
var float bearTotalRR = 0.0

// Signal flags (reset each bar)
bool confirmedBullish = false
bool confirmedBearish = false
int  signalScore      = 0

// ══════════════════════════════════════
// CHECK IF ANY ACTIVE PATTERN EXISTS
// ══════════════════════════════════════
// Since hasActivePattern blocks new patterns, at most 1 can
// be active at a time → we only need to check the last element.

bool hasActivePattern = false
if array.size(patStatusArr) > 0
    hasActivePattern := array.get(patStatusArr, array.size(patStatusArr) - 1) == 0

// ══════════════════════════════════════
// ABCD PATTERN DETECTION
// ══════════════════════════════════════

if newPivot and isWarmedUp and barstate.isconfirmed and array.size(pivotPrices) >= 4 and not hasActivePattern
    int sz = array.size(pivotPrices)

    float priceA = array.get(pivotPrices, sz - 3)
    int   barA   = array.get(pivotBars, sz - 3)
    float priceB = array.get(pivotPrices, sz - 2)
    int   barB   = array.get(pivotBars, sz - 2)
    float priceC = array.get(pivotPrices, sz - 1)
    int   barC   = array.get(pivotBars, sz - 1)

    float abLen  = priceDist(priceA, priceB)
    float bcLen  = priceDist(priceB, priceC)
    int   abBars = math.abs(barB - barA)

    float bcAbRatio = safeDiv(bcLen, abLen, 0.0)

    bool validBcRatio = bcAbRatio >= minAbcRatioInput and bcAbRatio <= maxAbcRatioInput
    bool validAtr     = atrFilterInput ? (abLen >= atrValue and atrValue > 0) : true
    bool validDepth   = abBars >= 3

    if validBcRatio and validAtr and validDepth
        // dir=1: bullish (A=low, B=high, C=low, D=projected high)
        // dir=-1: bearish (A=high, B=low, C=high, D=projected low)
        int patternDir = priceB > priceA ? 1 : -1

        float targetCdAbRatio = (minCdAbRatioInput + maxCdAbRatioInput) / 2.0
        float projDprice = priceC + patternDir * abLen * targetCdAbRatio

        int projDbars = barC + abBars
        projDbars := math.min(projDbars, bar_index + maxBarsProjectInput)
        int cdBarsEst = math.abs(projDbars - barC)

        int patScore = scorePattern(bcAbRatio, abBars, cdBarsEst)

        if patScore >= minScoreInput
            float entryPrice = close
            float slPrice    = priceC
            float tpPrice    = projDprice

            array.push(patApriceArr, priceA)
            array.push(patAbarArr, barA)
            array.push(patBpriceArr, priceB)
            array.push(patBbarArr, barB)
            array.push(patCpriceArr, priceC)
            array.push(patCbarArr, barC)
            array.push(patDpriceArr, projDprice)
            array.push(patDbarArr, projDbars)
            array.push(patDirArr, patternDir)
            array.push(patScoreArr, patScore)
            array.push(patStatusArr, 0)
            array.push(patEntryArr, entryPrice)
            array.push(patSlArr, slPrice)
            array.push(patTpArr, tpPrice)
            array.push(patTouchBarArr, 0)

            if patternDir == 1
                confirmedBullish := true
            else
                confirmedBearish := true
            signalScore := patScore

            // Trim old patterns to limit memory
            if array.size(patApriceArr) > maxPatternsInput * 3
                array.shift(patApriceArr)
                array.shift(patAbarArr)
                array.shift(patBpriceArr)
                array.shift(patBbarArr)
                array.shift(patCpriceArr)
                array.shift(patCbarArr)
                array.shift(patDpriceArr)
                array.shift(patDbarArr)
                array.shift(patDirArr)
                array.shift(patScoreArr)
                array.shift(patStatusArr)
                array.shift(patEntryArr)
                array.shift(patSlArr)
                array.shift(patTpArr)
                array.shift(patTouchBarArr)

// ══════════════════════════════════════
// EVALUATE ACTIVE PATTERNS (TP/SL)
// ══════════════════════════════════════

if array.size(patStatusArr) > 0 and isWarmedUp
    for i = 0 to array.size(patStatusArr) - 1
        if array.get(patStatusArr, i) != 0
            continue

        int   pDir   = array.get(patDirArr, i)
        float pTp    = array.get(patTpArr, i)
        float pSl    = array.get(patSlArr, i)
        float pEntry = array.get(patEntryArr, i)
        float pD     = array.get(patDpriceArr, i)
        float pC     = array.get(patCpriceArr, i)

        // TP zone band (same as drawn box)
        float cdRange  = math.abs(pD - pC)
        float tpMargin = cdRange * 0.1

        // Check if price entered TP zone on this bar (for fib line endpoint)
        float tpZoneHi = math.max(pD, pD + tpMargin)
        float tpZoneLo = math.min(pD, pD - tpMargin)
        bool inTpZone = high >= tpZoneLo and low <= tpZoneHi
        if inTpZone and array.get(patTouchBarArr, i) == 0
            array.set(patTouchBarArr, i, bar_index)

        // TP hit: price reaches projected D
        bool hitTp = pDir == 1 ? high >= pTp : low <= pTp
        // SL hit: price returns past C against direction
        bool hitSl = pDir == 1 ? low <= pSl  : high >= pSl

        if hitTp and hitSl
            // Simultaneous — resolve as loss (conservative)
            array.set(patStatusArr, i, -1)
            if pDir == 1
                bullLosses += 1
            else
                bearLosses += 1
        else if hitTp
            array.set(patStatusArr, i, 1)
            float rr = safeDiv(priceDist(pEntry, pTp), priceDist(pEntry, pSl), 0.0)
            if pDir == 1
                bullWins    += 1
                bullTotalRR += rr
            else
                bearWins    += 1
                bearTotalRR += rr
        else if hitSl
            array.set(patStatusArr, i, -1)
            if pDir == 1
                bullLosses += 1
            else
                bearLosses += 1

// ══════════════════════════════════════
// SIGNAL PLOTS (confirmed, non-repainting)
// ══════════════════════════════════════

plotshape(showSignalsInput and confirmedBullish ? low : na, "Bullish ABCD", style = shape.labelup, location = location.belowbar, color = bullColorInput, textcolor = color.white, text = "Long", size = size.small)

plotshape(showSignalsInput and confirmedBearish ? high : na, "Bearish ABCD", style = shape.labeldown, location = location.abovebar, color = bearColorInput, textcolor = color.white, text = "Short", size = size.small)

// ══════════════════════════════════════
// DRAW PATTERNS (barstate.islast only)
// ══════════════════════════════════════

if barstate.islast
    // Clean up all previous drawings
    for ln in drawnLines
        line.delete(ln)
    array.clear(drawnLines)
    for lb in drawnLabels
        label.delete(lb)
    array.clear(drawnLabels)
    for bx in drawnBoxes
        box.delete(bx)
    array.clear(drawnBoxes)

    int totalPats = array.size(patApriceArr)
    int drawCount = math.min(maxPatternsInput, totalPats)
    int startIdx  = totalPats - drawCount

    if drawCount > 0
        for i = startIdx to totalPats - 1
            int   sts = array.get(patStatusArr, i)

            // ── Active-only filter: skip completed patterns ──
            if activeOnlyInput and sts != 0
                continue

            float pA  = array.get(patApriceArr, i)
            int   bA  = array.get(patAbarArr, i)
            float pB  = array.get(patBpriceArr, i)
            int   bB  = array.get(patBbarArr, i)
            float pC  = array.get(patCpriceArr, i)
            int   bC  = array.get(patCbarArr, i)
            float pD  = array.get(patDpriceArr, i)
            int   bD  = array.get(patDbarArr, i)
            int   dir = array.get(patDirArr, i)
            int   scr = array.get(patScoreArr, i)
            int   tch = array.get(patTouchBarArr, i)

            color patCol = dir == 1 ? bullColorInput : bearColorInput
            color legCol = sts == 0 ? patCol : color.new(patCol, 60)

            // ── Pattern legs ──
            array.push(drawnLines, line.new(bA, pA, bB, pB, color = legCol, width = 2))
            array.push(drawnLines, line.new(bB, pB, bC, pC, color = legCol, width = 2))

            if showProjectionInput
                color projCol = sts == 0 ? PROJ_COLOR : color.new(PROJ_COLOR, 60)
                array.push(drawnLines, line.new(bC, pC, bD, pD, color = projCol, width = 2, style = line.style_dotted))

            // ── Pivot labels A/B/C/D ──
            if showLabelsInput
                color lblBg = color.new(patCol, 60)
                if dir == 1
                    array.push(drawnLabels, label.new(bA, pA, "A", color = lblBg, textcolor = LABEL_TEXT, style = label.style_label_up, size = size.small))
                    array.push(drawnLabels, label.new(bB, pB, "B", color = lblBg, textcolor = LABEL_TEXT, style = label.style_label_down, size = size.small))
                    array.push(drawnLabels, label.new(bC, pC, "C", color = lblBg, textcolor = LABEL_TEXT, style = label.style_label_up, size = size.small))
                    array.push(drawnLabels, label.new(bD, pD, "D", color = color.new(PROJ_COLOR, 40), textcolor = #FFFFFF, style = label.style_label_down, size = size.small))
                else
                    array.push(drawnLabels, label.new(bA, pA, "A", color = lblBg, textcolor = LABEL_TEXT, style = label.style_label_down, size = size.small))
                    array.push(drawnLabels, label.new(bB, pB, "B", color = lblBg, textcolor = LABEL_TEXT, style = label.style_label_up, size = size.small))
                    array.push(drawnLabels, label.new(bC, pC, "C", color = lblBg, textcolor = LABEL_TEXT, style = label.style_label_down, size = size.small))
                    array.push(drawnLabels, label.new(bD, pD, "D", color = color.new(PROJ_COLOR, 40), textcolor = #FFFFFF, style = label.style_label_up, size = size.small))

            // ── Score label ──
            if showScoreInput
                int   sMid = int((bB + bC) / 2)
                float pMid = (pB + pC) / 2.0
                string sStr = str.tostring(scr) + "%"
                array.push(drawnLabels, label.new(sMid, pMid, sStr, color = color.new(patCol, 90), textcolor = TEXT_COLOR, style = label.style_none, size = size.small))

            // ── Common right edge for zones/fibs ──
            int zoneRight = bar_index
            if tch > 0
                zoneRight := tch
            else if sts != 0
                zoneRight := bD
            zoneRight := math.max(zoneRight, bC + 10)

            // ── TP/SL boxes ──
            if showTpSlInput
                float cdRange = math.abs(pD - pC)
                float tpMargin = cdRange * 0.1

                // TARGET ZONE: band around projected D
                // Bull (D above C): band just below D → [D-margin, D]
                // Bear (D below C): band just above D → [D, D+margin]
                float tpBoxTop = dir == 1 ? pD : pD + tpMargin
                float tpBoxBot = dir == 1 ? pD - tpMargin : pD

                color tpBorderCol = sts == 0 ? color.new(bullColorInput, 50) : color.new(bullColorInput, 70)
                color tpBgCol     = sts == 0 ? color.new(bullColorInput, 88) : color.new(bullColorInput, 93)
                color tpTxtCol    = #000000
                array.push(drawnBoxes, box.new(bC, tpBoxTop, zoneRight, tpBoxBot, border_color = tpBorderCol, bgcolor = tpBgCol, border_width = 1, border_style = line.style_dashed, text = "TARGET ZONE", text_color = tpTxtCol, text_size = size.normal, text_halign = text.align_center, text_valign = text.align_center))

                // STOP ZONE: band around C (SL level)
                // Bull (C is a low): band below C → [C-margin, C]
                // Bear (C is a high): band above C → [C, C+margin]
                float slMargin = cdRange * 0.1
                float slBoxTop = dir == 1 ? pC : pC + slMargin
                float slBoxBot = dir == 1 ? pC - slMargin : pC

                color slBorderCol = sts == 0 ? color.new(bearColorInput, 50) : color.new(bearColorInput, 70)
                color slBgCol     = sts == 0 ? color.new(bearColorInput, 90) : color.new(bearColorInput, 95)
                color slTxtCol    = #000000
                array.push(drawnBoxes, box.new(bC, slBoxTop, zoneRight, slBoxBot, border_color = slBorderCol, bgcolor = slBgCol, border_width = 1, border_style = line.style_dashed, text = "STOP ZONE", text_color = slTxtCol, text_size = size.normal, text_halign = text.align_center, text_valign = text.align_center))

            // ── Fibonacci Levels ──
            if showFibLevelsInput
                int fibRight = zoneRight
                int fibLabelX = fibRight + 3

                color fCol    = sts == 0 ? color.new(fibColorInput, 40) : color.new(fibColorInput, 70)
                color fTxtCol = sts == 0 ? fibColorInput : color.new(fibColorInput, 50)

                // BC/AB retracement label
                float bcAbMeasured = safeDiv(priceDist(pB, pC), priceDist(pA, pB), 0.0)
                string bcRatioStr = str.tostring(bcAbMeasured, "#.###")
                int bcMidBar = int((bB + bC) / 2)
                float bcMidPrice = (pB + pC) / 2.0
                array.push(drawnLabels, label.new(bcMidBar, bcMidPrice, "BC/AB: " + bcRatioStr, color = color.new(fibColorInput, 90), textcolor = fTxtCol, style = label.style_none, size = size.small, tooltip = "BC retracement of AB leg"))

                // AB extension levels projected from C toward D
                for fi = 0 to array.size(FIB_EXT_LEVELS) - 1
                    float extRatio = array.get(FIB_EXT_LEVELS, fi)
                    float extPrice = pC + dir * priceDist(pA, pB) * extRatio
                    string extName = array.get(FIB_EXT_NAMES, fi)
                    string extLabel = extName + " (" + str.tostring(extPrice, format.mintick) + ")"

                    bool inRange = dir == 1 ? (extPrice > pC and extPrice < pC + priceDist(pA, pB) * 2.0) : (extPrice < pC and extPrice > pC - priceDist(pA, pB) * 2.0)
                    if inRange
                        color lvlCol = extRatio == 1.0 ? color.new(fibColorInput, 20) : fCol
                        int lvlWidth = extRatio == 1.0 ? 2 : 1
                        array.push(drawnLines, line.new(bC, extPrice, fibRight, extPrice, color = lvlCol, style = line.style_dashed, width = lvlWidth))
                        array.push(drawnLabels, label.new(fibLabelX, extPrice, extLabel, color = color.new(fibColorInput, 95), textcolor = fTxtCol, style = label.style_none, size = size.small))

                // CD retracement levels (partial TP targets) — only for active patterns
                if sts == 0
                    for fi = 0 to array.size(FIB_RET_LEVELS) - 1
                        float retRatio = array.get(FIB_RET_LEVELS, fi)
                        float retPrice = pC + retRatio * (pD - pC)
                        string retStr = str.tostring(retRatio, "#.###") + " (" + str.tostring(retPrice, format.mintick) + ")"
                        array.push(drawnLines, line.new(bC, retPrice, fibRight, retPrice, color = color.new(fibColorInput, 65), style = line.style_dotted, width = 1))
                        array.push(drawnLabels, label.new(fibLabelX, retPrice, retStr, color = color.new(fibColorInput, 95), textcolor = color.new(fibColorInput, 60), style = label.style_none, size = size.small))

// ══════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════

var table dashTable = table.new(dashPos, 2, 9, color.new(#131722, 5), color.new(#2A2E39, 0), 1, color.new(#2A2E39, 0), 1)

if barstate.islast
    if showDashInput
        table.cell(dashTable, 0, 0, "ABCD Harmonic [NT]", text_color = HEADER_TEXT, bgcolor = HEADER_BG, text_size = size.small, text_halign = text.align_center)
        table.merge_cells(dashTable, 0, 0, 1, 0)

        int totalPats = array.size(patApriceArr)
        int activePats = 0
        if totalPats > 0
            for i = 0 to totalPats - 1
                if array.get(patStatusArr, i) == 0
                    activePats += 1
        table.cell(dashTable, 0, 1, "Patterns", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 1, str.tostring(activePats) + " / " + str.tostring(totalPats), text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_BG)

        // Last signal info
        string lastSigStr = "—"
        color  lastSigCol = TEXT_COLOR
        if totalPats > 0
            int lastDir = array.get(patDirArr, totalPats - 1)
            int lastScr = array.get(patScoreArr, totalPats - 1)
            int lastSts = array.get(patStatusArr, totalPats - 1)
            string stsStr = lastSts == 0 ? "Active" : lastSts == 1 ? "TP ✓" : "SL ✗"
            lastSigStr := (lastDir == 1 ? "Long" : "Short") + " " + stsStr + " (" + str.tostring(lastScr) + "%)"
            lastSigCol := lastDir == 1 ? bullColorInput : bearColorInput
        table.cell(dashTable, 0, 2, "Last Signal", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 2, lastSigStr, text_color = lastSigCol, text_size = size.small, bgcolor = TABLE_BG)

        int bullTotal = bullWins + bullLosses
        string bullWr = bullTotal > 0 ? str.tostring(safeDiv(float(bullWins), float(bullTotal), 0.0) * 100, "#.0") + "%" : "—"
        table.cell(dashTable, 0, 3, "Bull W/L", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 3, str.tostring(bullWins) + "/" + str.tostring(bullLosses) + " (" + bullWr + ")", text_color = bullColorInput, text_size = size.small, bgcolor = TABLE_BG)

        int bearTotal = bearWins + bearLosses
        string bearWr = bearTotal > 0 ? str.tostring(safeDiv(float(bearWins), float(bearTotal), 0.0) * 100, "#.0") + "%" : "—"
        table.cell(dashTable, 0, 4, "Bear W/L", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 4, str.tostring(bearWins) + "/" + str.tostring(bearLosses) + " (" + bearWr + ")", text_color = bearColorInput, text_size = size.small, bgcolor = TABLE_BG)

        string bullRr = bullWins > 0 ? str.tostring(safeDiv(bullTotalRR, float(bullWins), 0.0), "#.##") : "—"
        string bearRr = bearWins > 0 ? str.tostring(safeDiv(bearTotalRR, float(bearWins), 0.0), "#.##") : "—"
        table.cell(dashTable, 0, 5, "Avg R:R", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 5, "B:" + bullRr + " / S:" + bearRr, text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_BG)

        string atrStr = atrValue > 0 ? str.tostring(atrValue, format.mintick) : "—"
        table.cell(dashTable, 0, 6, "ATR(" + str.tostring(atrLengthInput) + ")", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 6, atrStr, text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_BG)

        table.cell(dashTable, 0, 7, "Timeframe", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 7, timeframe.period, text_color = TEXT_COLOR, text_size = size.small, bgcolor = TABLE_BG)

        table.cell(dashTable, 0, 8, "Version", text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
        table.cell(dashTable, 1, 8, INDICATOR_VERSION, text_color = TEXT_MUTED, text_size = size.small, bgcolor = TABLE_BG)
    else
        for r = 0 to 8
            table.cell(dashTable, 0, r, "", bgcolor = color.new(color.black, 100))
            table.cell(dashTable, 1, r, "", bgcolor = color.new(color.black, 100))

// ══════════════════════════════════════
// WATERMARK
// ══════════════════════════════════════

var table wmTable = table.new(position = position.bottom_center, columns = 1, rows = 1, bgcolor = color.new(color.black, 100), border_color = color.new(color.black, 100), border_width = 0, frame_color = color.new(color.black, 100), frame_width = 0)

if barstate.islast
    if showWatermarkInput
        table.cell(wmTable, 0, 0, "WillyAlgoTrader", text_color = WM_COLOR, text_size = size.normal, text_halign = text.align_center, bgcolor = color.new(color.black, 100))
    else
        table.cell(wmTable, 0, 0, "", bgcolor = color.new(color.black, 100))

// ══════════════════════════════════════
// ALERTS
// ══════════════════════════════════════

string alertTicker = syminfo.tickerid
string alertTf     = timeframe.period
string alertPrice  = str.tostring(close, format.mintick)
string alertScore  = str.tostring(signalScore)

if confirmedBullish
    int lastIdx = array.size(patEntryArr) - 1
    string entryStr = str.tostring(array.get(patEntryArr, lastIdx), format.mintick)
    string tpStr    = str.tostring(array.get(patTpArr, lastIdx), format.mintick)
    string slStr    = str.tostring(array.get(patSlArr, lastIdx), format.mintick)
    string jMsg = '{"action":"buy","ticker":"' + alertTicker + '","price":' + alertPrice + ',"entry":' + entryStr + ',"tp":' + tpStr + ',"sl":' + slStr + ',"tf":"' + alertTf + '","score":' + alertScore + ',"pattern":"ABCD"}'
    string tMsg = "🟢 LONG ABCD | " + alertTicker + " | TF: " + alertTf + " | Entry: " + entryStr + " | TP: " + tpStr + " | SL: " + slStr + " | Score: " + alertScore
    alert(webhookInput ? jMsg : tMsg, alert.freq_once_per_bar_close)

if confirmedBearish
    int lastIdx = array.size(patEntryArr) - 1
    string entryStr = str.tostring(array.get(patEntryArr, lastIdx), format.mintick)
    string tpStr    = str.tostring(array.get(patTpArr, lastIdx), format.mintick)
    string slStr    = str.tostring(array.get(patSlArr, lastIdx), format.mintick)
    string jMsg = '{"action":"sell","ticker":"' + alertTicker + '","price":' + alertPrice + ',"entry":' + entryStr + ',"tp":' + tpStr + ',"sl":' + slStr + ',"tf":"' + alertTf + '","score":' + alertScore + ',"pattern":"ABCD"}'
    string tMsg = "🔴 SHORT ABCD | " + alertTicker + " | TF: " + alertTf + " | Entry: " + entryStr + " | TP: " + tpStr + " | SL: " + slStr + " | Score: " + alertScore
    alert(webhookInput ? jMsg : tMsg, alert.freq_once_per_bar_close)
