//@version=6
indicator("Klinger Oscillator", "KVO", overlay = false, format = format.volume)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // oscillator above zero
BEAR_COLOR    = #f23645 // oscillator below zero
NEUTRAL_COLOR = #787b86 // zero line
ACCENT_COLOR  = #ff9800 // signal line - the one accent

FILL_LINE_TRANSP = 60  // gradient transparency at the oscillator
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero line
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
fastLengthInput   = input.int(34, "Fast Length",   minval = 1, group = "Settings", tooltip = "Length of the fast EMA applied to the volume force.")
slowLengthInput   = input.int(55, "Slow Length",   minval = 1, group = "Settings", tooltip = "Length of the slow EMA applied to the volume force.")
signalLengthInput = input.int(13, "Signal Length", minval = 1, group = "Settings", tooltip = "Length of the EMA applied to the oscillator to obtain the signal line.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "kvo", group = "Style", tooltip = "Color of the Klinger oscillator while above zero.")
bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "kvo", group = "Style", tooltip = "Color of the Klinger oscillator while below zero.")
signalColorInput = input.color(ACCENT_COLOR, "Signal", group = "Style", tooltip = "Color of the signal line.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
hlcSum = high + low + close
trend  = hlcSum > hlcSum[1] ? 1 : -1
dm     = high - low

var float cm = na
cm := trend == trend[1] ? nz(cm[1]) + dm : nz(dm[1]) + dm

volumeForce = cm != 0 ? volume * math.abs(2 * (dm / cm) - 1) * trend * 100 : 0.0

kvo        = ta.ema(volumeForce, fastLengthInput) - ta.ema(volumeForce, slowLengthInput)
signalLine = ta.ema(kvo, signalLengthInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
kvoColor = kvo >= 0 ? bullColorInput : bearColorInput

kvoPlotId  = plot(kvo,        "KVO",    kvoColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)
plot(signalLine, "Signal", signalColorInput)

fill(kvoPlotId, zeroPlotId, top_value = kvo >= 0 ? kvo : 0, bottom_value = kvo >= 0 ? 0 : kvo, top_color = color.new(kvoColor, kvo >= 0 ? FILL_LINE_TRANSP : FILL_ZERO_TRANSP), bottom_color = color.new(kvoColor, kvo >= 0 ? FILL_ZERO_TRANSP : FILL_LINE_TRANSP), title = "KVO Gradient")

hline(0, "Zero Line", color.new(NEUTRAL_COLOR, 50), hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
bullSignalCross = ta.crossover(kvo, signalLine)
bearSignalCross = ta.crossunder(kvo, signalLine)
bullZeroCross   = ta.crossover(kvo, 0)
bearZeroCross   = ta.crossunder(kvo, 0)

alertcondition(bullSignalCross, "Bullish Signal Cross", "KVO crossed above its signal line")
alertcondition(bearSignalCross, "Bearish Signal Cross", "KVO crossed below its signal line")
alertcondition(bullZeroCross,   "Bullish Zero Cross",   "KVO crossed above zero")
alertcondition(bearZeroCross,   "Bearish Zero Cross",   "KVO crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
