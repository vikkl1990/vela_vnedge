//@version=6
// Updating Chart
indicator('Gann Session Box - Auto Expanding High/Low/50%', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 50)

// ================= Inputs =================
sessionHour = input.int(18, 'Session start hour (24h, 18 = 6 PM)', minval = 0, maxval = 23, group = 'Session')
sessionMinute = input.int(0, 'Session start minute', minval = 0, maxval = 59, group = 'Session')
sessTZ = input.string('America/New_York', 'Session timezone', options = ['America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles', 'UTC'], group = 'Session')
rangeSrc = input.string('Line chart (close)', 'Range source', options = ['Line chart (close)', 'Candle wicks (high/low)'], group = 'Session')
keepHistory = input.bool(true, 'Keep previous session boxes', group = 'Session')

boxBorder = input.color(color.new(color.gray, 20), 'Box border', group = 'Style')
boxFill = input.color(color.new(color.blue, 90), 'Box fill', group = 'Style')
hiColor = input.color(color.lime, 'High line', group = 'Style')
loColor = input.color(color.red, 'Low line', group = 'Style')
midColor = input.color(color.aqua, '50% line', group = 'Style')
divMode = input.string('Quarters (25/50/75)', 'Internal divisions', options = ['None', 'Quarters (25/50/75)', 'Gann eighths'], group = 'Style')
divColor = input.color(color.new(color.gray, 45), 'Division lines', group = 'Style')
showLines = input.bool(true, 'Draw flat H/L/mid rays', group = 'Style')
showLabels = input.bool(true, 'Price labels', group = 'Style')

// ================= Session anchor =================
// All accumulation happens at top level. Only the date id crosses a timeframe boundary,
// and here it doesn't cross one at all: it is computed directly from the chart's own
// timestamps, so there is no request.security state to lose.
useClose = rangeSrc == 'Line chart (close)'
srcHi = useClose ? close : high
srcLo = useClose ? close : low

shiftMs = (sessionHour * 60 + sessionMinute) * 60 * 1000
st = time - shiftMs
dayId = year(st, sessTZ) * 10000 + month(st, sessTZ) * 100 + dayofmonth(st, sessTZ)

var int lastDayId = na
newSession = not na(lastDayId) and dayId != lastDayId
firstBar = na(lastDayId)
lastDayId := dayId

// ================= Running high / low =================
var float sessHigh = na
var float sessLow = na

if newSession or firstBar
    sessHigh := srcHi
    sessLow := srcLo
    sessLow
else
    sessHigh := math.max(sessHigh, srcHi)
    sessLow := math.min(sessLow, srcLo)
    sessLow

midPrice = (sessHigh + sessLow) / 2.0
haveData = not na(sessHigh) and not na(sessLow)

// ================= Division helper =================
nDivs = divMode == 'Quarters (25/50/75)' ? 2 : divMode == 'Gann eighths' ? 6 : 0

divFrac(i) =>
    float f = na
    if divMode == 'Quarters (25/50/75)'
        f := i == 0 ? 0.25 : 0.75
        f
    else if divMode == 'Gann eighths'
        int k = i < 3 ? i + 1 : i + 2 // skip 4/8, the 50% line covers it
        f := k / 8.0
        f
    f

// ================= Drawing objects =================
var box sessBox = na
var line midLine = na
var line hiLine = na
var line loLine = na
var array<line> divLines = array.new_line()

startDraw = (newSession or firstBar) and haveData

if startDraw
    if not keepHistory
        box.delete(sessBox)
        line.delete(midLine)
        line.delete(hiLine)
        line.delete(loLine)
        if array.size(divLines) > 0
            for ln in divLines
                line.delete(ln)
    array.clear(divLines)

    sessBox := box.new(bar_index, sessHigh, bar_index, sessLow, xloc = xloc.bar_index, border_color = boxBorder, border_width = 1, bgcolor = boxFill)
    midLine := line.new(bar_index, midPrice, bar_index, midPrice, xloc = xloc.bar_index, color = midColor, width = 2)

    if showLines
        hiLine := line.new(bar_index, sessHigh, bar_index, sessHigh, xloc = xloc.bar_index, color = hiColor, width = 1)
        loLine := line.new(bar_index, sessLow, bar_index, sessLow, xloc = xloc.bar_index, color = loColor, width = 1)
        loLine

    if nDivs > 0
        for i = 0 to nDivs - 1 by 1
            y = sessLow + (sessHigh - sessLow) * divFrac(i)
            array.push(divLines, line.new(bar_index, y, bar_index, y, xloc = xloc.bar_index, color = divColor, style = line.style_dotted, width = 1))

// ---- resize every bar ----
if not na(sessBox) and haveData
    box.set_top(sessBox, sessHigh)
    box.set_bottom(sessBox, sessLow)
    box.set_right(sessBox, bar_index)

    line.set_y1(midLine, midPrice)
    line.set_y2(midLine, midPrice)
    line.set_x2(midLine, bar_index)

    if showLines and not na(hiLine)
        line.set_y1(hiLine, sessHigh)
        line.set_y2(hiLine, sessHigh)
        line.set_x2(hiLine, bar_index)
        line.set_y1(loLine, sessLow)
        line.set_y2(loLine, sessLow)
        line.set_x2(loLine, bar_index)

    if array.size(divLines) > 0
        for i = 0 to array.size(divLines) - 1 by 1
            ln = array.get(divLines, i)
            y = sessLow + (sessHigh - sessLow) * divFrac(i)
            line.set_y1(ln, y)
            line.set_y2(ln, y)
            line.set_x2(ln, bar_index)

// ================= Labels =================
var label hiLbl = na
var label loLbl = na
var label mdLbl = na

if barstate.islast and showLabels and haveData
    label.delete(hiLbl)
    label.delete(loLbl)
    label.delete(mdLbl)
    hiLbl := label.new(bar_index, sessHigh, 'H ' + str.tostring(sessHigh, format.mintick), style = label.style_label_left, color = color.new(hiColor, 20), textcolor = color.black, size = size.small)
    loLbl := label.new(bar_index, sessLow, 'L ' + str.tostring(sessLow, format.mintick), style = label.style_label_left, color = color.new(loColor, 20), textcolor = color.white, size = size.small)
    mdLbl := label.new(bar_index, midPrice, '50% ' + str.tostring(midPrice, format.mintick), style = label.style_label_left, color = color.new(midColor, 20), textcolor = color.black, size = size.small)
    mdLbl
