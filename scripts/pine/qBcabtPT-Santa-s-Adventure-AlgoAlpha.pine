middle = math.avg(open, close)

v1 = close-volatility*6
v2 = math.min(close-volatility*20, ta.lowest(close-volatility*10, 200))
v3 = close-volatility*4

bodyMiddle = plot(barstate.isfirst ? na : (open + close) / 2, "Body Middle",display = display.none)
p1 = plot(v1, display = display.none)
p2 = plot(v2, display = display.none)
p3 = plot(v3, display = display.none)

fill(bodyMiddle, p3, middle, v3, color.white, color.white)
fill(p3, p1, v3, v1, color.gray, color.gray)
fill(p1, p2, v1, v2, #3d3d3d, #3d3d3d)

var snow = array.new_label()

while snow.size() > 0
    snow.shift().delete()

for i = 1 to snow_density
    lower_limit = baseY
    upper_limit = high + volatility * snow_roof
    left_limit = bar_index - snow_hor_range
    right_limit = bar_index + snow_hor_range
    snow.unshift(label.new(x = int(math.random(left_limit, right_limit)), y = math.random(lower_limit, upper_limit), text = "❄", textcolor = color.white, style = label.style_none))