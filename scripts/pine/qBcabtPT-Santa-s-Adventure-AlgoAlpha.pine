// Function to find the bounding box of coordinates
find_bounds(coords_array) =>
    float min_x = array.get(coords_array, 0).x
    float max_x = min_x
    float min_y = array.get(coords_array, 0).y  
    float max_y = min_y
    
    for i = 1 to array.size(coords_array) - 1
        coord = array.get(coords_array, i)
        min_x := math.min(min_x, coord.x)
        max_x := math.max(max_x, coord.x)
        min_y := math.min(min_y, coord.y)
        max_y := math.max(max_y, coord.y)
    
    [min_x, max_x, min_y, max_y]

// Function to rotate a coordinate around a reference point (x0, y0) by a given angle in degrees
rotate_coordinate(coord, x0, y0, theta_deg, scale_factor) =>
    // Convert the angle from degrees to radians
    float theta = math.toradians(theta_deg)
    // Calculate the difference in x and y from the reference point
    float dx = (coord.x - x0) * scale_factor
    float dy = coord.y - y0
    // Calculate the new x and y positions using cosine and sine of the rotation angle
    float x_rot = x0 + (dx * math.cos(theta) - dy * math.sin(theta)) / scale_factor
    float y_rot = y0 + dx * math.sin(theta) + dy * math.cos(theta)
    // Return the new rotated coordinate
    coordinates.new(int(x_rot), y_rot)

// Function to rotate all coordinates in an array around a reference point (x0, y0) by a given angle in degrees
rotate_coords_array(coords_array, x0, y0, theta_deg) =>
    // Find the bounding box
    [min_x, max_x, min_y, max_y] = find_bounds(coords_array)
    
    // Calculate the aspect ratio (width/height)
    float width = max_x - min_x
    float height = max_y - min_y
    float scale_factor = height / width
    
    // Iterate over each coordinate in the array
    for i = 0 to array.size(coords_array) - 1
        // Get the current coordinate
        coord = array.get(coords_array, i)
        // Rotate the coordinate with scaling
        coord_rot = rotate_coordinate(coord, x0, y0, theta_deg, scale_factor)
        // Update the array with the rotated coordinate
        array.set(coords_array, i, coord_rot)

// Calculate rotation angle based on price gradient over last 40 bars
float current_close = ta.hma(close, 40)
float prev_close = ta.hma(close, 40)[40]

// Find the bounding box to get width and height
[min_x, max_x, min_y, max_y] = find_bounds(coords)
float width = max_x - min_x
float height = max_y - min_y

// Calculate the scale-adjusted dx and dy
float dx = 40  // Fixed time difference
float dy = (current_close - prev_close) * (width / height)  // Adjust dy by the aspect ratio

// Calculate angle
float angle = math.atan(dy/dx) * 180/math.pi
// Make angle negative for uptrend, positive for downtrend
angle := current_close > prev_close ? angle : angle

// Check if it's the last bar state and perform the rotation
if barstate.islast
    // Rotate the coordinates array around the midpoint (mid, baseY)
    rotate_coords_array(coords, mid, baseY, angle) // Now includes automatic scaling

