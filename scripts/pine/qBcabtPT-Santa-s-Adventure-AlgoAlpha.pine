indicator("Santa's Adventure! [AlgoAlpha]", shorttitle="AlgoAlpha - Santa's Adventure", overlay=true, max_labels_count=500, max_polylines_count=100, max_bars_back=5000)

////inputs
snow_hor_range = input.int(484, "Snow Distance")
snow_roof = input.int(40, "Snow Upper Limit")
snow_density = input.int(333, "Snow Density")


sleigh_red = input.color(#ff2929, title="Sleigh Red") 
sleigh_handle_col = input.color(#cc7e00, title="Sleigh Handle")
ski_color = input.color(color.white, title="Ski Color")
sleigh_white_outline = input.color(color.white, title="Sleigh White Outline")
present1_color = input.color(color.green, title="Present 1 Color")
present2_color = input.color(#FFA500, title="Present 2 Color")
present3_color = input.color(#ffd700, title="Present 3 Color")
present4_color = input.color(#FF69B4, title="Present 4 Color")
present5_color = input.color(#9370DB, title="Present 5 Color")
ribbon_color = input.color(color.red, title="Ribbon Color")
santa_outfit_red = input.color(color.red, title="Santa Outfit Red")
santa_outfit_white = input.color(color.white, title="Santa Outfit White")
santa_outfit_outline = input.color(#000000, title="Santa Outfit Outline")
santa_beard = input.color(#cccccc, title="Santa Beard")
santa_gloves = input.color(#000000, title="Santa Gloves")
santa_belt = input.color(color.black, title="Santa Belt")
rudolf_leash_color = input.color(color.white, title="Rudolf Leash Color")
rudolf_outline_color = input.color(#000000, title="Rudolf Outline Color")
rudolf_color = input.color(#664e33, title="Rudolf Color")
rudolf_nose = input.color(color.red, title="Rudolf Nose")
rudolf_antler = input.color(color.white, title="Rudolf Antler")

// Settings
widthhh    = 33
Scalee    = 7

// Variables
dist            = high - low
volatility      = ta.sma(dist, 100)
distmed         = ta.median(dist, 500)

type coordinates
    int x
    float y

// Plot location and scaling
int   mid   = bar_index
float rangO = distmed * Scalee
float baseY = high + volatility * 2

coords = array.new<coordinates>()

// Arrays to hold chart points
sleigh         = array.new<chart.point>()
sleigh_legs    = array.new<chart.point>()
sleigh_handle  = array.new<chart.point>()
ribbon         = array.new<chart.point>()
squaresBack2   = array.new<chart.point>()

// Existing present ribbons
present_ribbonH = array.new<chart.point>()
present_ribbonV = array.new<chart.point>()

// Additional presents (2 & 3) + their ribbons
squaresPresent2      = array.new<chart.point>()
present2_ribbonH     = array.new<chart.point>()
present2_ribbonV     = array.new<chart.point>()

squaresPresent3      = array.new<chart.point>()
