//@version=6
indicator("TTM Squeeze", shorttitle = "TTM Squeeze", overlay = false, format = format.price)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // momentum histogram, positive side
BEAR_COLOR        = #f23645 // momentum histogram, negative side
SQUEEZE_ON_COLOR  = #ff9800 // zero-line dots while the Bollinger Bands sit inside the Keltner Channels
SQUEEZE_OFF_COLOR = #787b86 // zero-line dots while the Bollinger Bands sit outside the Keltner Channels
FADE_TRANSP       = 60      // transparency of histogram bars fading back toward zero
BG_TRANSP         = 90      // transparency of the optional squeeze-period background

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 2
  , group   = "Settings"
  , tooltip = "Shared lookback, in bars, for the Bollinger Bands, the Keltner Channels, and the momentum regression. John Carter's original setting is 20.")

srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Price series used for the shared moving average basis, the standard deviation, and the momentum displacement. Carter's original construction uses the close.")

bbMultInput = input.float(2.0, "Bollinger Bands Multiplier", minval = 0.1, step = 0.1
  , group   = "Settings"
  , tooltip = "Standard deviation multiplier for the Bollinger Bands. Default 2 standard deviations above and below the basis.")

kcMultInput = input.float(1.5, "Keltner Channels Multiplier", minval = 0.1, step = 0.1
  , group   = "Settings"
  , tooltip = "ATR multiplier for the Keltner Channels. Default 1.5 x ATR above and below the basis. A smaller multiplier narrows the channels and demands a tighter compression before the squeeze turns on.")

bullColorInput = input.color(BULL_COLOR, "Momentum Up", inline = "momentum"
  , group   = "Style"
  , tooltip = "Histogram color while momentum is positive. Bars building away from zero print solid, bars fading back toward zero print dimmed.")

bearColorInput = input.color(BEAR_COLOR, "Down", inline = "momentum"
  , group   = "Style"
  , tooltip = "Histogram color while momentum is negative. Bars building away from zero print solid, bars fading back toward zero print dimmed.")

sqzOnColorInput = input.color(SQUEEZE_ON_COLOR, "Squeeze On", inline = "state"
  , group   = "Style"
  , tooltip = "Zero-line dot color while the squeeze is on, i.e. while both Bollinger Bands sit fully inside the Keltner Channels.")

sqzOffColorInput = input.color(SQUEEZE_OFF_COLOR, "Off", inline = "state"
  , group   = "Style"
  , tooltip = "Zero-line dot color while the squeeze is off, i.e. while the Bollinger Bands trade outside the Keltner Channels.")

markFiresInput = input.bool(true, "Mark Squeeze Fires"
  , group   = "Style"
  , tooltip = "Draws a cross on the zero line on the fire bar - the first bar where the bands re-emerge outside the channels - colored by the side of the momentum histogram, the traditional directional lean of the release.")

highlightInput = input.bool(false, "Highlight Squeeze Periods"
  , group   = "Style"
  , tooltip = "Shades the pane background while the squeeze is on, making compressed regimes easy to spot when using the squeeze as a stand-down filter for other systems.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Both band systems are centered on the same simple moving average basis, per Carter's construction
basis    = ta.sma(srcInput, lengthInput)
dev      = bbMultInput * ta.stdev(srcInput, lengthInput)
atrValue = ta.atr(lengthInput)

bbUpper = basis + dev
bbLower = basis - dev
kcUpper = basis + kcMultInput * atrValue
kcLower = basis - kcMultInput * atrValue

bandsReady = not na(bbUpper) and not na(kcUpper)

// Squeeze state - on while both Bollinger Bands sit strictly inside the Keltner Channels, off otherwise.
// The squeeze fires on the first bar of the flip from on to off
squeezeOn    = bandsReady and bbUpper < kcUpper and bbLower > kcLower
squeezeStart = squeezeOn and not squeezeOn[1]
squeezeFire  = not squeezeOn and squeezeOn[1]

// Momentum - least-squares regression of the source's displacement from an anchor midway between
// the recent range midpoint and the moving average
rangeMid = math.avg(ta.highest(high, lengthInput), ta.lowest(low, lengthInput))
anchor   = math.avg(rangeMid, basis)
momentum = ta.linreg(srcInput - anchor, lengthInput, 0)

momPrev   = nz(momentum[1], momentum)
momPrev2  = nz(momentum[2], momPrev)
momRising = momentum > momPrev

// First bar where a momentum build turns back toward zero - the classic scale-out / stand-aside cue
positiveFade = momentum > 0 and momentum < momPrev and momPrev >= momPrev2
negativeFade = momentum < 0 and momentum > momPrev and momPrev <= momPrev2

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
bullMomColor = momRising ? bullColorInput : color.new(bullColorInput, FADE_TRANSP)
bearMomColor = momRising ? color.new(bearColorInput, FADE_TRANSP) : bearColorInput
momColor     = momentum >= 0 ? bullMomColor : bearMomColor
fireColor    = na(momentum) ? sqzOffColorInput : momentum >= 0 ? bullColorInput : bearColorInput

plot(momentum, "Momentum", color = momColor, linewidth = 1, style = plot.style_columns)
plot(bandsReady ? 0 : na, "Squeeze State", color = squeezeOn ? sqzOnColorInput : sqzOffColorInput, linewidth = 2, style = plot.style_circles)
plot(markFiresInput and squeezeFire ? 0 : na, "Squeeze Fire", color = fireColor, linewidth = 3, style = plot.style_cross)

bgcolor(highlightInput and squeezeOn ? color.new(sqzOnColorInput, BG_TRANSP) : na, title = "Squeeze Period Background")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(squeezeStart, "Squeeze On", "TTM Squeeze on {{ticker}}: Bollinger Bands compressed inside the Keltner Channels - squeeze is on ({{interval}})")
alertcondition(squeezeFire, "Squeeze Fire", "TTM Squeeze fired on {{ticker}}: Bollinger Bands released outside the Keltner Channels ({{interval}})")
alertcondition(squeezeFire and momentum > 0, "Bullish Squeeze Fire", "TTM Squeeze fired on {{ticker}} with positive momentum - upside lean ({{interval}})")
alertcondition(squeezeFire and momentum < 0, "Bearish Squeeze Fire", "TTM Squeeze fired on {{ticker}} with negative momentum - downside lean ({{interval}})")
alertcondition(positiveFade, "Positive Momentum Fade", "TTM Squeeze on {{ticker}}: positive momentum began fading toward zero - common exit or stand-aside cue ({{interval}})")
alertcondition(negativeFade, "Negative Momentum Fade", "TTM Squeeze on {{ticker}}: negative momentum began fading toward zero - common exit or stand-aside cue ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
