//@version=6
indicator("Gravestone Doji", "Gravestone Doji", overlay = true, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
PATTERN_TXT = 'Gravestone'
BEAR_TIP    = 'Gravestone doji: buyers carried the session higher, supply met them, and the close returned to the open. Failed push to higher prices - wait for a confirming close below the body.'
PROBE_TIP   = 'Gravestone doji after a decline: probing, indecisive attempt at recovery.'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
bodyPctInput        = input.float(5., 'Maximum Body Size %', minval = 0, maxval = 25, step = 0.5, group = 'Pattern', tooltip = 'Maximum real body height as a percentage of the bar range. Open and close must sit this close together for the bar to qualify as a doji.')
lowerPctInput       = input.float(10., 'Maximum Lower Shadow %', minval = 0, maxval = 50, step = 0.5, group = 'Pattern', tooltip = 'Maximum lower shadow as a percentage of the bar range. Keeps open, close and low together at the bottom of the bar, preserving the inverted-T shape.')
shadowBodyMultInput = input.float(2., 'Minimum Shadow / Body Ratio', minval = 0, step = 0.5, group = 'Pattern', tooltip = 'Minimum upper shadow length as a multiple of the real body height. At least two to three times the body is the common requirement.')
shadowAtrMultInput  = input.float(1., 'Minimum Shadow Length', minval = 0, step = 0.25, inline = 'atr', group = 'Pattern', tooltip = 'ATR multiple the upper shadow must reach.')
atrLenInput         = input.int(14, 'x ATR', minval = 1, inline = 'atr', group = 'Pattern', tooltip = 'Minimum upper shadow length as a multiple of the Average True Range, so the shadow is long relative to recent bars rather than only relative to a tiny body.')

requireAdvanceInput = input.bool(true, 'Require Prior Advance', group = 'Context', tooltip = 'Only flag gravestones closing above the trend average, i.e. printing after an advance into higher prices. In the middle of a range the shape is mostly noise.')
trendLenInput       = input.int(50, 'Trend SMA Length', minval = 2, group = 'Context', tooltip = 'Simple moving average length used to classify the prior trend as an advance or a decline.')
declineProbeInput   = input.bool(false, 'Flag Gravestones After A Decline', group = 'Context', tooltip = 'Additionally flag gravestones printing below the trend average. Some treatments read them as a probing, indecisive attempt at recovery rather than a topping alert.')
volumeFilterInput   = input.bool(false, 'Require Elevated Volume', group = 'Context', tooltip = 'Require elevated volume on the pattern bar; an active session supports the supply-response reading of the upper shadow. Disable on symbols without volume data.')
volMultInput        = input.float(1.5, 'Minimum Volume', minval = 0, step = 0.1, inline = 'vol', group = 'Context', tooltip = 'Multiple of average volume the pattern bar must exceed.')
volLenInput         = input.int(20, 'x SMA', minval = 1, inline = 'vol', group = 'Context', tooltip = 'Volume must exceed this multiple of its simple moving average for the session to count as elevated.')

confirmBarsInput    = input.int(3, 'Confirmation Window (Bars)', minval = 1, maxval = 50, group = 'Confirmation', tooltip = 'Number of bars allowed for a close below the gravestone body to confirm the topping reading. A close back above the shadow high before confirmation invalidates the pattern.')

showLevelsInput = input.bool(true, 'Trigger & Stop Levels', group = 'Style', tooltip = 'Draw the confirmation trigger at the gravestone body bottom and the natural stop at the shadow high while the pattern awaits confirmation.')
bearColorInput  = input.color(#f23645, 'Bearish Gravestone', group = 'Style')
probeColorInput = input.color(#089981, 'Recovery Probe / Invalidation', group = 'Style')

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{
barRange    = high - low
body        = math.abs(close - open)
bodyBottom  = math.min(close, open)
upperShadow = high - math.max(close, open)
lowerShadow = bodyBottom - low

atrValue = ta.atr(atrLenInput)
trendSma = ta.sma(close, trendLenInput)
volSma   = ta.sma(volume, volLenInput)

// Inverted-T shape: negligible body at the bottom of the range, little or no lower shadow, long upper shadow
dojiBody    = barRange > 0 and body <= barRange * bodyPctInput / 100
smallLower  = barRange > 0 and lowerShadow <= barRange * lowerPctInput / 100
longShadow  = upperShadow > 0 and upperShadow >= body * shadowBodyMultInput and not na(atrValue) and upperShadow >= atrValue * shadowAtrMultInput
elevatedVol = not volumeFilterInput or not na(volSma) and volume > volSma * volMultInput

isGravestone = dojiBody and smallLower and longShadow and elevatedVol

// Context: after an advance the shape reads as refused higher prices, after a decline as an indecisive recovery probe
advance = not na(trendSma) and close > trendSma
decline = not na(trendSma) and close < trendSma

probeSignal = isGravestone and declineProbeInput and decline
bearSignal  = isGravestone and not probeSignal and (not requireAdvanceInput or advance)

//---------------------------------------------------------------------------------------------------------------------}
// Confirmation Tracking
//---------------------------------------------------------------------------------------------------------------------{
var float pendingTrigger = na
var float pendingStop    = na
var int   pendingBar     = na
var line  triggerLine    = na
var line  stopLine       = na

confirmEvent = false
invalidEvent = false

// Resolve any pending gravestone with this bar's close
if not na(pendingBar) and bar_index > pendingBar
    if close < pendingTrigger
        confirmEvent := true
    else if close > pendingStop
        invalidEvent := true

    if not na(triggerLine)
        line.set_x2(triggerLine, bar_index)
        line.set_x2(stopLine, bar_index)

    if confirmEvent or invalidEvent or bar_index - pendingBar >= confirmBarsInput
        pendingTrigger := na
        pendingStop    := na
        pendingBar     := na
        triggerLine    := na
        stopLine       := na

// A new bearish gravestone starts (or replaces) the pending pattern
if bearSignal
    pendingTrigger := bodyBottom
    pendingStop    := high
    pendingBar     := bar_index

    if showLevelsInput
        triggerLine := line.new(bar_index, bodyBottom, bar_index + 1, bodyBottom, color = bearColorInput, style = line.style_dashed)
        stopLine    := line.new(bar_index, high, bar_index + 1, high, color = probeColorInput, style = line.style_dashed)
    else
        triggerLine := na
        stopLine    := na

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
if bearSignal
    label.new(bar_index, high, PATTERN_TXT, style = label.style_label_down, color = #00000000, textcolor = bearColorInput, size = size.small, tooltip = BEAR_TIP)

if probeSignal
    label.new(bar_index, low, PATTERN_TXT, style = label.style_label_up, color = #00000000, textcolor = probeColorInput, size = size.small, tooltip = PROBE_TIP)

plotshape(confirmEvent, 'Confirmation', shape.triangledown, location.abovebar, color = bearColorInput, size = size.tiny)
plotshape(invalidEvent, 'Invalidation', shape.xcross, location.abovebar, color = probeColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bearSignal, 'Gravestone Doji Detected', 'Gravestone doji detected - the full excursion to higher prices was refused. Watch for a confirming close below the body.')
alertcondition(probeSignal, 'Gravestone Doji After Decline', 'Gravestone doji after a decline - probing, indecisive attempt at recovery.')
alertcondition(confirmEvent, 'Gravestone Doji Confirmed', 'Confirming close below the gravestone body - bearish reversal reading confirmed.')
alertcondition(invalidEvent, 'Gravestone Doji Invalidated', 'Close back above the gravestone shadow high - refused prices have been accepted, pattern invalidated.')

//---------------------------------------------------------------------------------------------------------------------}
