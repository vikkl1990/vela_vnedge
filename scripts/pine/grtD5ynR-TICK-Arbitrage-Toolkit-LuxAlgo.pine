//@version=6
indicator("TICK Arbitrage Toolkit [LuxAlgo]", "LuxAlgo - TICK Arbitrage Toolkit", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color GREEN_LUX = #089981
color RED_LUX   = #f23645
color GREY_LUX  = #d1d4dc

color DATA              = #DBDBDB
color HEADERS           = #808080
color BACKGROUND        = #161616
color BORDERS           = #2E2E2E

string TOP_RIGHT        = 'Top Right'
string BOTTOM_RIGHT     = 'Bottom Right'
string BOTTOM_LEFT      = 'Bottom Left'

string TINY             = 'Tiny'
string SMALL            = 'Small'
string NORMAL           = 'Normal'
string LARGE            = 'Large'
string HUGE             = 'Huge'

string DASHBOARD_GROUP  = 'Dashboard'

string TICK_NYSE = "TICK"
string TICK_NASD = "TICKQ"

string MODE_REV  = "Reversal"
string MODE_STD  = "Standard"

// Tooltips
string dashboardTooltip         = 'Enable or disable the dashboard.'
string dashboardPositionTooltip = 'Select the dashboard location.'
string dashboardSizeTooltip     = 'Select the dashboard size.'

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
string tickSourceInput      = input.string(TICK_NYSE, "TICK Source", options = [TICK_NYSE, TICK_NASD], group = "Settings", tooltip = "Select the TICK index to use for arbitrage analysis. NYSE:TICK is best for S&P 500, NASDAQ:TICKQ is best for Nasdaq 100.")
string refreshFreqInput     = input.string("Chart",   "Refresh Frequency", options = ["Chart", "1", "5S", "15S", "30S", "1S"], group = "Settings", tooltip = "Select how often the data refreshes. Using a lower timeframe (e.g., 1S or 5S) allows the toolkit to react to internals within the current chart bar.\nNote: Sub-minute frequencies require a compatible TradingView plan.")
bool   useExtremeInput      = input.bool(true, "Include High/Low Extremes", group = "Settings", tooltip = "When enabled, the script uses the bar's extreme High or Low (whichever is furthest from zero) instead of the Close. This captures intrabar spikes.")
bool   printExtremesInput   = input.bool(true, "Print NHOD/NLOD Value",     group = "Settings", tooltip = "When enabled, the actual TICK/TICKQ value is printed on the chart when a new session high or low is established.")

int    ext1Input            = input.int(800,  "Extension 1", minval = 1, group = "Settings", tooltip = "First extreme level. Triggers 1 dot, and NHOD/NLOD checks.")
int    ext2Input            = input.int(1000, "Extension 2", minval = 1, group = "Settings", tooltip = "Second extreme level. Triggers 2 dots.")
int    ext3Input            = input.int(1200, "Extension 3", minval = 1, group = "Settings", tooltip = "Third extreme level. Triggers 3 dots and full opacity.")

color  posColorInput        = input.color(RED_LUX,    "Positive TICK Color", inline = "Colors", group = "Style")
color  negColorInput        = input.color(GREEN_LUX,  "Negative TICK Color", inline = "Colors", group = "Style")
color  neutralColorInput    = input.color(GREY_LUX,   "Neutral Color (0)",   inline = "Colors", group = "Style")
string dotStyleInput        = input.string("Circles", "Marker Style", options = ["Circles", "Triangles", "None"], group = "Style", tooltip = "Select the symbol used for extreme level dots. Triangles point Down for positive TICK and Up for negative TICK.")

// Dashboard Inputs
bool   dashboardInput         = input.bool(true,        'Dashboard', group = DASHBOARD_GROUP, tooltip = dashboardTooltip)
string dashboardPositionInput = input.string(TOP_RIGHT, 'Position',  group = DASHBOARD_GROUP, tooltip = dashboardPositionTooltip, options = [TOP_RIGHT, BOTTOM_RIGHT, BOTTOM_LEFT])
string dashboardSizeInput     = input.string(SMALL,     'Size',      group = DASHBOARD_GROUP, tooltip = dashboardSizeTooltip,     options = [TINY, SMALL, NORMAL, LARGE, HUGE])

//---------------------------------------------------------------------------------------------------------------------}
// Calculations & Methods
//---------------------------------------------------------------------------------------------------------------------{
var string parsedFreq = refreshFreqInput == "Chart" ? timeframe.period : refreshFreqInput

var parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT       => position.top_right
    BOTTOM_RIGHT    => position.bottom_right
    BOTTOM_LEFT     => position.bottom_left

var parsedDashboardSize = switch dashboardSizeInput
    TINY            => size.tiny
    SMALL           => size.small
    NORMAL          => size.normal
    LARGE           => size.large
    HUGE            => size.huge

// Helper functions for Dashboard
cell(table t_able, int column, int row, string data, color color = #FFFFFF, string align = text.align_right, color background = na, float height = 0) => 
    t_able.cell(column, row, data, text_color = color, text_size = parsedDashboardSize, text_halign = align, bgcolor = background, height = height)

divider(table t_able, int row, int lastColumn) =>    
    string rowDivider = '━━━━━━━━━━━━━━━━━━━━━━'
    t_able.merge_cells(0, row, lastColumn, row)
    cell(t_able, 0, row, rowDivider, align = text.align_center, height = 0.5, color = BORDERS)

// Fetch TICK data
[tH, tL, tC] = request.security(tickSourceInput, parsedFreq, [high, low, close])

// Determine the value to use based on settings
float tickValue = useExtremeInput ? (math.abs(tH) > math.abs(tL) ? tH : tL) : tC
float absTick   = math.abs(tickValue)

// Bars Since 0 Cross
var int barsSinceZero = 0
bool touchesZero = tH >= 0 and tL <= 0
barsSinceZero := touchesZero ? 0 : barsSinceZero + 1

// Track Session High/Low
var float sessionHigh = 0.0
var float sessionLow  = 0.0
bool isNewDay = nz(ta.change(time("D"))) != 0

if isNewDay
    sessionHigh := tickValue
    sessionLow  := tickValue
else
    sessionHigh := math.max(sessionHigh, tickValue)
    sessionLow  := math.min(sessionLow, tickValue)

// New Extreme Detection (for Labels/Alerts)
float highChange = ta.change(sessionHigh)
float lowChange  = ta.change(sessionLow)
bool isNewHigh   = tickValue == sessionHigh and tickValue > ext1Input  and not isNewDay and highChange != 0
bool isNewLow    = tickValue == sessionLow  and tickValue < -ext1Input and not isNewDay and lowChange != 0

// Directional Coloring logic for Dashboard
color momentumColor = if tickValue > 0
    posColorInput
else if tickValue < 0
    negColorInput
else
    DATA

// Calculate Opacity (Percentage 0-100)
float opacity = if absTick == 0
    15.0
else if absTick <= ext1Input
    15.0 + (absTick / ext1Input) * (90.0 - 15.0)
else if absTick <= ext2Input
    90.0 + ((absTick - ext1Input) / math.max(1, ext2Input - ext1Input)) * (95.0 - 90.0)
else if absTick <= ext3Input
    95.0 + ((absTick - ext2Input) / math.max(1, ext3Input - ext2Input)) * (100.0 - 95.0)
else
    100.0

// Convert opacity to transparency (0 = opaque, 100 = transparent)
float transparency = 100.0 - opacity

// Determine Target Color
color targetBaseColor = tickValue > 0 ? posColorInput : (tickValue < 0 ? negColorInput : neutralColorInput)

// Create Gradient
color finalColor = if absTick == 0
    color.new(neutralColorInput, transparency)
else if absTick <= ext1Input
    color.new(color.from_gradient(absTick, 0, ext1Input, neutralColorInput, targetBaseColor), transparency)
else
    color.new(targetBaseColor, transparency)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Override candle colors
barcolor(finalColor, title = "TICK Gradient Color")

// Marker Character logic
string dotChar = dotStyleInput == "Circles" ? "●" : (tickValue > 0 ? "▼" : "▲")
string dotText = if dotStyleInput == "None" or absTick < ext1Input
    ""
else
    absTick >= ext3Input ? dotChar + "\n" + dotChar + "\n" + dotChar : absTick >= ext2Input ? dotChar + "\n" + dotChar : dotChar

// Combine Markers and Session Text into one label to guarantee NO overlap
if dotText != "" or isNewHigh or isNewLow
    string finalLabelText = ""
    string valStr = str.tostring(tickValue, "#")
    
    if tickValue > 0
        finalLabelText := (isNewHigh and printExtremesInput ? valStr + "\n\n\n" : "") + dotText
    else
        finalLabelText := dotText + (isNewLow and printExtremesInput ? "\n\n\n" + valStr : "")
    
    if finalLabelText != ""
        label.new(bar_index, tickValue > 0 ? high : low, finalLabelText, 
          color     = #00000000, 
          style     = tickValue > 0 ? label.style_label_down : label.style_label_up, 
          textcolor = tickValue > 0 ? posColorInput : negColorInput, 
          size      = size.tiny)

// Dashboard Implementation
var table t_able = table.new(parsedDashboardPosition, 2, 9, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1, force_overlay = true)

if dashboardInput and barstate.islast
    t_able.merge_cells(0, 0, 1, 0)
    cell(t_able, 0, 0, tickSourceInput + ' Arbitrage Dashboard', color = DATA, align = text.align_center)        
    
    divider(t_able, 1, 1)
    
    cell(t_able, 0, 2, tickSourceInput + ' Value', color = HEADERS, align = text.align_left)            
    cell(t_able, 1, 2, str.tostring(tickValue, "#"), color = momentumColor)
    
    divider(t_able, 3, 1)
    
    cell(t_able, 0, 4, 'Bars Since 0 Cross', color = HEADERS, align = text.align_left)            
    cell(t_able, 1, 4, str.tostring(barsSinceZero), color = momentumColor)

    divider(t_able, 5, 1)

    cell(t_able, 0, 6, 'Session High', color = HEADERS, align = text.align_left)            
    cell(t_able, 1, 6, str.tostring(sessionHigh, "#"), color = sessionHigh > ext1Input ? posColorInput : DATA)

    divider(t_able, 7, 1)

    cell(t_able, 0, 8, 'Session Low', color = HEADERS, align = text.align_left)            
    cell(t_able, 1, 8, str.tostring(sessionLow, "#"), color = sessionLow < -ext1Input ? negColorInput : DATA)

// Data Window
plot(tickValue, "TICK Value", color.new(chart.fg_color, 100), display = display.data_window)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
if absTick >= ext1Input
    alert("TICK Extreme Alert! Value: " + str.tostring(tickValue, "#"), alert.freq_once_per_bar)

if isNewHigh or isNewLow
    alert("New Session " + (isNewHigh ? "High" : "Low") + " reached: " + str.tostring(tickValue, "#"), alert.freq_once_per_bar)

//---------------------------------------------------------------------------------------------------------------------}
