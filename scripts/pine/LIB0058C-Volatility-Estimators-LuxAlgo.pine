//@version=6
indicator("Volatility Estimators", "Vol Est", overlay = false, format = format.percent, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
LOG2 = math.log(2)

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
methodInput = input.string('Close-to-Close', 'Method', group = 'Settings'
  , options = ['Close-to-Close', 'Zero-Trend', 'Parkinson', 'Garman-Klass', 'Rogers-Satchell']
  , tooltip = 'Volatility estimator used for the plotted value.')

lengthInput = input.int(10, 'Length', minval = 2, group = 'Settings', tooltip = 'Number of bars in the estimation window.')

annualizeInput = input.bool(true, 'Annualize', inline = 'annualize', group = 'Settings'
  , tooltip = 'Scale the per-bar estimate by the square root of the periods per year.')

periodsPerYearInput = input.int(252, '', minval = 1, inline = 'annualize', group = 'Settings'
  , tooltip = 'Periods per year used for annualization, 252 trading days for daily bars.')

volColorInput = input.color(#787b86, 'Volatility', group = 'Style', tooltip = 'Volatility line color.')

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
logReturn = math.log(close / close[1])
logHighLow = math.log(high / low)
logCloseOpen = math.log(close / open)

closeToClose = ta.stdev(logReturn, lengthInput, false)

zeroTrend = math.sqrt(math.sum(logReturn * logReturn, lengthInput) / (lengthInput - 1))

parkinson = math.sqrt(math.sum(math.pow(logHighLow, 2), lengthInput) / (4 * LOG2 * lengthInput))

gkTerm = 0.5 * math.pow(logHighLow, 2) - (2 * LOG2 - 1) * math.pow(logCloseOpen, 2)
garmanKlass = math.sqrt(math.sum(gkTerm, lengthInput) / lengthInput)

rsTerm = math.log(high / close) * math.log(high / open) + math.log(low / close) * math.log(low / open)
rogersSatchell = math.sqrt(math.sum(rsTerm, lengthInput) / lengthInput)

annualizationFactor = annualizeInput ? math.sqrt(periodsPerYearInput) : 1.0

volatility = switch methodInput
    'Close-to-Close'  => closeToClose
    'Zero-Trend'      => zeroTrend
    'Parkinson'       => parkinson
    'Garman-Klass'    => garmanKlass
    'Rogers-Satchell' => rogersSatchell

volatilityPct = 100 * volatility * annualizationFactor

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
volPlotId  = plot(volatilityPct, 'Volatility', volColorInput)
zeroPlotId = plot(0, 'Zero Anchor', color(na), editable = false, display = display.none)

// Gradient fill toward zero following the line color
fill(volPlotId, zeroPlotId, top_value = volatilityPct, bottom_value = 0, top_color = color.new(volColorInput, 50), bottom_color = color.new(volColorInput, 100), title = 'Volatility Gradient')

//----------------------------------------------------------------------------------------------------------------------}
