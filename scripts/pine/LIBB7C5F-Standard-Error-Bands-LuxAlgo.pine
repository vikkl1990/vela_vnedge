//@version=6
indicator("Standard Error Bands", "SEB", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // lower band - support side of the regression channel
BEAR_COLOR    = #f23645 // upper band - resistance side of the regression channel
NEUTRAL_COLOR = #787b86 // regression midline - structure
FILL_TRANSP   = 90      // transparency of the band fills
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(21, "Length", minval = 3, group = "Settings",
  tooltip = "Number of bars used to fit the linear regression and compute its standard error")

multInput = input.float(2.0, "SE Multiplier", minval = 0, step = 0.1, group = "Settings",
  tooltip = "Multiple of the regression standard error used to offset the bands from the regression line")

smoothInput = input.int(3, "Smoothing", minval = 1, group = "Settings",
  tooltip = "Simple moving average length applied to the regression line and both bands before plotting")

srcInput = input.source(close, "Source", group = "Settings",
  tooltip = "Price series the regression is fitted to")

midColorInput = input.color(NEUTRAL_COLOR, "Regression Line", group = "Style",
  tooltip = "Color of the smoothed linear regression midline")

upperColorInput = input.color(BEAR_COLOR, "Upper Band", inline = "bands", group = "Style",
  tooltip = "Color of the upper standard error band and its fill - the resistance side of the channel")

lowerColorInput = input.color(BULL_COLOR, "Lower Band", inline = "bands", group = "Style",
  tooltip = "Color of the lower standard error band and its fill - the support side of the channel")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
mid = ta.linreg(srcInput, lengthInput, 0)

// stdev * sqrt((1 - r^2) * n / (n - 2)) is algebraically the regression standard error sqrt(SSE / (n - 2))
r = nz(ta.correlation(bar_index, srcInput, lengthInput))
se = ta.stdev(srcInput, lengthInput) * math.sqrt(math.max(1 - r * r, 0) * lengthInput / (lengthInput - 2))

upperBand = ta.sma(mid + multInput * se, smoothInput)
lowerBand = ta.sma(mid - multInput * se, smoothInput)
basis = ta.sma(mid, smoothInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
upperPlotId = plot(upperBand, "Upper Band", upperColorInput)
basisPlotId = plot(basis, "Basis", midColorInput)
lowerPlotId = plot(lowerBand, "Lower Band", lowerColorInput)

fill(upperPlotId, basisPlotId, color.new(upperColorInput, FILL_TRANSP), "Upper Band Fill")
fill(basisPlotId, lowerPlotId, color.new(lowerColorInput, FILL_TRANSP), "Lower Band Fill")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(ta.crossover(close, upperBand), "Cross Above Upper Band", "Close crossed above the upper standard error band")
alertcondition(ta.crossunder(close, lowerBand), "Cross Below Lower Band", "Close crossed below the lower standard error band")
//----------------------------------------------------------------------------------------------------------------------}
