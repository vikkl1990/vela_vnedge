//@version=6
indicator("Pivot Points Standard", "Pivots", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
TRADITIONAL = "Traditional"
FIBONACCI   = "Fibonacci"
CAMARILLA   = "Camarilla"
WOODIE      = "Woodie"

ANCHOR_AUTO    = "Auto"
ANCHOR_DAILY   = "Daily"
ANCHOR_WEEKLY  = "Weekly"
ANCHOR_MONTHLY = "Monthly"
ANCHOR_YEARLY  = "Yearly"

TF_DAILY   = "1D"
TF_WEEKLY  = "1W"
TF_MONTHLY = "1M"
TF_YEARLY  = "12M"

GROUP_SETTINGS = "Settings"
GROUP_STYLE    = "Style"
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
kindInput = input.string(TRADITIONAL, "Type", options = [TRADITIONAL, FIBONACCI, CAMARILLA, WOODIE], group = GROUP_SETTINGS, tooltip = "Formula used to calculate the levels. Traditional is the classic floor-trader method, Fibonacci projects 38.2/61.8/100% of the prior range around the pivot, Camarilla scales the prior range around the prior close, Woodie gives extra weight to the current period open.")

anchorTfInput = input.string(ANCHOR_AUTO, "Pivots Timeframe", options = [ANCHOR_AUTO, ANCHOR_DAILY, ANCHOR_WEEKLY, ANCHOR_MONTHLY, ANCHOR_YEARLY], group = GROUP_SETTINGS, tooltip = "Period the pivots are anchored to. 'Auto' follows the chart timeframe: daily pivots on intraday charts up to 15 minutes, weekly on other intraday charts, monthly on daily charts, and yearly on weekly and monthly charts.")

pivotColorInput      = input.color(#ff9800, "Pivot", group = GROUP_STYLE, tooltip = "Color of the central pivot (P) level.")
resistanceColorInput = input.color(#f23645, "Resistances", group = GROUP_STYLE, tooltip = "Color of the resistance (R) levels.")
supportColorInput    = input.color(#089981, "Supports", group = GROUP_STYLE, tooltip = "Color of the support (S) levels.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
autoTf = switch
    timeframe.isintraday and timeframe.in_seconds() <= 15 * 60 => TF_DAILY
    timeframe.isintraday => TF_WEEKLY
    timeframe.isdaily => TF_MONTHLY
    => TF_YEARLY

anchorTf = switch anchorTfInput
    ANCHOR_DAILY   => TF_DAILY
    ANCHOR_WEEKLY  => TF_WEEKLY
    ANCHOR_MONTHLY => TF_MONTHLY
    ANCHOR_YEARLY  => TF_YEARLY
    => autoTf

// Confirmed prior anchor-period values (lookahead_on with [1] offset - the non-repainting HTF pattern)
[prevHigh, prevLow, prevClose, prevOpen] = request.security(syminfo.tickerid, anchorTf, [high[1], low[1], close[1], open[1]], lookahead = barmerge.lookahead_on)

// Current anchor-period open, fixed on the period's first bar (used by Woodie) - non-repainting
currOpen = request.security(syminfo.tickerid, anchorTf, open, lookahead = barmerge.lookahead_on)

prevRange = prevHigh - prevLow

tradPivot = (prevHigh + prevLow + prevClose) / 3
tradR1    = 2 * tradPivot - prevLow
tradS1    = 2 * tradPivot - prevHigh
tradR2    = tradPivot + prevRange
tradS2    = tradPivot - prevRange
tradR3    = prevHigh + 2 * (tradPivot - prevLow)
tradS3    = prevLow - 2 * (prevHigh - tradPivot)

fibR1 = tradPivot + 0.382 * prevRange
fibS1 = tradPivot - 0.382 * prevRange
fibR2 = tradPivot + 0.618 * prevRange
fibS2 = tradPivot - 0.618 * prevRange
fibR3 = tradPivot + prevRange
fibS3 = tradPivot - prevRange

camRange = 1.1 * prevRange
camR1    = prevClose + camRange / 12
camS1    = prevClose - camRange / 12
camR2    = prevClose + camRange / 6
camS2    = prevClose - camRange / 6
camR3    = prevClose + camRange / 4
camS3    = prevClose - camRange / 4
camR4    = prevClose + camRange / 2
camS4    = prevClose - camRange / 2

woodPivot = (prevHigh + prevLow + 2 * currOpen) / 4
woodR1    = 2 * woodPivot - prevLow
woodS1    = 2 * woodPivot - prevHigh
woodR2    = woodPivot + prevRange
woodS2    = woodPivot - prevRange

pivotLevel = kindInput == WOODIE ? woodPivot : tradPivot

r1Level = switch kindInput
    FIBONACCI => fibR1
    CAMARILLA => camR1
    WOODIE    => woodR1
    => tradR1

s1Level = switch kindInput
    FIBONACCI => fibS1
    CAMARILLA => camS1
    WOODIE    => woodS1
    => tradS1

r2Level = switch kindInput
    FIBONACCI => fibR2
    CAMARILLA => camR2
    WOODIE    => woodR2
    => tradR2

s2Level = switch kindInput
    FIBONACCI => fibS2
    CAMARILLA => camS2
    WOODIE    => woodS2
    => tradS2

r3Level = switch kindInput
    FIBONACCI => fibR3
    CAMARILLA => camR3
    WOODIE    => float(na)
    => tradR3

s3Level = switch kindInput
    FIBONACCI => fibS3
    CAMARILLA => camS3
    WOODIE    => float(na)
    => tradS3

r4Level = kindInput == CAMARILLA ? camR4 : float(na)
s4Level = kindInput == CAMARILLA ? camS4 : float(na)

// Levels are na exactly on the anchor period's first bar so the linebr plots break into per-period segments
anchorChange = timeframe.change(anchorTf)

pivotSegment = anchorChange ? float(na) : pivotLevel
r1Segment    = anchorChange ? float(na) : r1Level
s1Segment    = anchorChange ? float(na) : s1Level
r2Segment    = anchorChange ? float(na) : r2Level
s2Segment    = anchorChange ? float(na) : s2Level
r3Segment    = anchorChange ? float(na) : r3Level
s3Segment    = anchorChange ? float(na) : s3Level
r4Segment    = anchorChange ? float(na) : r4Level
s4Segment    = anchorChange ? float(na) : s4Level
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(pivotSegment, "P", pivotColorInput, style = plot.style_linebr)
plot(r1Segment, "R1", resistanceColorInput, style = plot.style_linebr)
plot(s1Segment, "S1", supportColorInput, style = plot.style_linebr)
plot(r2Segment, "R2", resistanceColorInput, style = plot.style_linebr)
plot(s2Segment, "S2", supportColorInput, style = plot.style_linebr)
plot(r3Segment, "R3", resistanceColorInput, style = plot.style_linebr)
plot(s3Segment, "S3", supportColorInput, style = plot.style_linebr)
plot(r4Segment, "R4", resistanceColorInput, style = plot.style_linebr)
plot(s4Segment, "S4", supportColorInput, style = plot.style_linebr)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossPivot = ta.cross(close, pivotLevel)
crossR1    = ta.cross(close, r1Level)
crossS1    = ta.cross(close, s1Level)

alertcondition(crossPivot, "Price Crossed Pivot", "Price crossed the pivot (P) level")
alertcondition(crossR1, "Price Crossed R1", "Price crossed the R1 resistance level")
alertcondition(crossS1, "Price Crossed S1", "Price crossed the S1 support level")
//----------------------------------------------------------------------------------------------------------------------}
