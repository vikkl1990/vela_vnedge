//@version=6
indicator("Pretty Good Oscillator", "Pretty Good Oscillator", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR = #089981
BEAR_COLOR = #f23645
LEVEL_COLOR = #787b86

FILL_VALUE_TRANSP = 50
FILL_CENTER_TRANSP = 100

EMA_OPTION = "EMA"
SMA_OPTION = "SMA"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(89, "Length", minval = 1, group = "Settings", tooltip = "Lookback period used for both the simple moving average baseline and the smoothed true range denominator. Johnson's long-term version used 89, shorter settings such as 14 or 21 are common and make the line faster and noisier.")

sourceInput = input.source(close, "Source", group = "Settings", tooltip = "Price series measured against its own simple moving average baseline. The original definition uses the close.")

trSmoothingInput = input.string(EMA_OPTION, "True Range Smoothing", options = [EMA_OPTION, SMA_OPTION], group = "Settings", tooltip = "Average type applied to the true range in the denominator. Johnson's original construction uses an exponential average, some implementations use a simple average instead, with modestly different readings.")

upperThresholdInput = input.float(3, "Upper Threshold", minval = 0, step = 0.25, group = "Settings", tooltip = "Bullish breakout threshold in smoothed true range units. Johnson's original long-term system went long when the oscillator pushed above +3. Shorter-period versions often use tighter levels.")

lowerThresholdInput = input.float(-3, "Lower Threshold", maxval = 0, step = 0.25, group = "Settings", tooltip = "Bearish breakout threshold in smoothed true range units. Johnson's original long-term system went short when the oscillator pushed below -3. Shorter-period versions often use tighter levels.")

//Style
bullColorInput = input.color(BULL_COLOR, "Bullish Color", group = "Style")

bearColorInput = input.color(BEAR_COLOR, "Bearish Color", group = "Style")

levelColorInput = input.color(LEVEL_COLOR, "Levels Color", group = "Style")

gradientFillInput = input.bool(true, "Gradient Fill", group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//True range of the bar, falling back to the high-low range on the first bar to avoid na contamination
trueRange = ta.tr(true)

//Simple moving average baseline of the source
baseline = ta.sma(sourceInput, lengthInput)

//Both denominator candidates are computed on every bar so the ta.* calls never sit inside a branch
emaTrueRange = ta.ema(trueRange, lengthInput)
smaTrueRange = ta.sma(trueRange, lengthInput)

smoothedTrueRange = trSmoothingInput == EMA_OPTION ? emaTrueRange : smaTrueRange

//Displacement of the source from its baseline, expressed in smoothed true range units
pgo = smoothedTrueRange > 0 ? (sourceInput - baseline) / smoothedTrueRange : na

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
oscColor = pgo > 0 ? bullColorInput : bearColorInput

oscPlotId = plot(pgo, "PGO", oscColor, 1)
zeroPlotId = plot(0, "Zero Anchor", editable = false, display = display.none)

//Vertical gradient fill from the zero center line to the oscillator value, fully transparent at the center
topFillColor = gradientFillInput ? (pgo > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_CENTER_TRANSP)) : na
bottomFillColor = gradientFillInput ? (pgo > 0 ? color.new(bullColorInput, FILL_CENTER_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)) : na

fill(oscPlotId, zeroPlotId, top_value = math.max(pgo, 0), bottom_value = math.min(pgo, 0), top_color = topFillColor, bottom_color = bottomFillColor, title = "Gradient Fill")

//Breakout thresholds and zero reference line
hline(upperThresholdInput, "Upper Threshold", levelColorInput, hline.style_dashed)
hline(lowerThresholdInput, "Lower Threshold", levelColorInput, hline.style_dashed)
hline(0, "Zero Line", levelColorInput, hline.style_dotted)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(ta.crossover(pgo, upperThresholdInput), "Bullish Breakout", "Pretty Good Oscillator crossed above its upper threshold")
alertcondition(ta.crossunder(pgo, lowerThresholdInput), "Bearish Breakout", "Pretty Good Oscillator crossed below its lower threshold")
alertcondition(ta.crossover(pgo, 0), "Bullish Zero Cross", "Pretty Good Oscillator returned above the zero line")
alertcondition(ta.crossunder(pgo, 0), "Bearish Zero Cross", "Pretty Good Oscillator returned below the zero line")

//---------------------------------------------------------------------------------------------------------------------}
