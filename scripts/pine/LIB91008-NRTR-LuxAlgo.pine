//@version=6
indicator("NRTR", shorttitle = "NRTR", overlay = true)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
PERCENT_MODE = "Percentage"
ATR_MODE     = "ATR Multiple"

TREND_UP   =  1
TREND_DOWN = -1

BULL_COLOR = #089981
BEAR_COLOR = #f23645

FILL_PRICE_TRANSP = 50  // gradient transparency at the price end of the fill
FILL_STOP_TRANSP  = 100 // gradient transparency at the trailing-line end of the fill

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput        = input.source(close, "Source", group = "Settings",
     tooltip = "Price series used to track the trend extreme and to detect reversal crosses. Kopyrkin's original construction runs on closing prices.")

offsetModeInput = input.string(PERCENT_MODE, "Offset Mode", options = [PERCENT_MODE, ATR_MODE], group = "Settings",
     tooltip = "How the deviation from the trend extreme is sized. 'Percentage' is the original 2001 construction — a fixed percentage of the extreme price, giving the trend the same room at every stage. 'ATR Multiple' is the later dynamic variant that sizes the same construction with the Average True Range, adapting the offset to volatility.")

percentInput    = input.float(2.0, "Percentage Deviation (%)", minval = 0.01, step = 0.1, group = "Settings",
     tooltip = "Fixed deviation of the trailing line from the trend extreme, as a percentage of that extreme — below the highest price in an up state, above the lowest price in a down state. Used when Offset Mode is 'Percentage'.")

atrLengthInput  = input.int(14, "ATR Length", minval = 1, group = "Settings",
     tooltip = "Averaging window of the ATR that sizes the offset. Wilder's conventional 14 by default. Used when Offset Mode is 'ATR Multiple'.")

atrMultInput    = input.float(3.0, "ATR Multiplier", minval = 0.1, step = 0.1, group = "Settings",
     tooltip = "Number of ATRs separating the trailing line from the trend extreme. Used when Offset Mode is 'ATR Multiple'.")

showMarkersInput = input.bool(true, "Reversal Markers", group = "Style",
     tooltip = "Marks each stop-and-reverse event with a small dot on the flipped line — the bar where price crossed the trailing level and the state reversed to the other side of the market.")

showFillInput    = input.bool(true, "Gradient Trail Fill", group = "Style",
     tooltip = "Fills the span between price and the trailing line with a vertical gradient in the state color — fully transparent at the line, strongest near price — visualizing the constant room the trend is given before a reversal.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style",
     tooltip = "Color of the line, fill and markers while the state is up (line trailing below price).")

bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style",
     tooltip = "Color of the line, fill and markers while the state is down (line trailing above price).")

lineWidthInput   = input.int(1, "Line Width", minval = 1, maxval = 5, group = "Style",
     tooltip = "Width of the NRTR trailing line.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Deviation from a given trend-extreme anchor — a fixed percentage of the anchor in the original construction,
// or an ATR multiple in the dynamic variant
offsetFor(float anchor, float atrRef) =>
    offsetModeInput == PERCENT_MODE ? anchor * percentInput / 100 : atrRef * atrMultInput

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
atrValue = ta.atr(atrLengthInput)

var int   trendState   = TREND_UP
var float trailExtreme = na
var float trailStop    = na

bool flipBullish = false
bool flipBearish = false

// The state machine starts once the source (and, in ATR mode, the ATR) returns a usable value
bool offsetReady = not na(srcInput) and (offsetModeInput == PERCENT_MODE or not na(atrValue))

if offsetReady
    if na(trailStop)
        // Seed — open the first state in the direction of the last price change
        trendState   := srcInput >= nz(srcInput[1], srcInput) ? TREND_UP : TREND_DOWN
        trailExtreme := srcInput
        trailStop    := trendState == TREND_UP ? srcInput - offsetFor(srcInput, atrValue) : srcInput + offsetFor(srcInput, atrValue)
    else if trendState == TREND_UP
        if srcInput < trailStop
            // Cross below the level in force — reverse to a down state anchored at the crossing price
            trendState   := TREND_DOWN
            trailExtreme := srcInput
            trailStop    := srcInput + offsetFor(srcInput, atrValue)
            flipBearish  := true
        else
            // Ratchet — track the highest price of the up state, hold the deviation below it, never loosen
            trailExtreme := math.max(trailExtreme, srcInput)
            trailStop    := math.max(trailStop, trailExtreme - offsetFor(trailExtreme, atrValue))
    else
        if srcInput > trailStop
            // Cross above the level in force — reverse to an up state anchored at the crossing price
            trendState   := TREND_UP
            trailExtreme := srcInput
            trailStop    := srcInput - offsetFor(srcInput, atrValue)
            flipBullish  := true
        else
            // Ratchet — track the lowest price of the down state, hold the deviation above it, never loosen
            trailExtreme := math.min(trailExtreme, srcInput)
            trailStop    := math.min(trailStop, trailExtreme + offsetFor(trailExtreme, atrValue))

bool flipped = flipBullish or flipBearish

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color stateColor = trendState == TREND_UP ? bullColorInput : bearColorInput

// Vertical gradient between the trailing line and price — fully transparent at the line, strongest near price
color fillTopColor    = showFillInput ? (trendState == TREND_UP ? color.new(bullColorInput, FILL_PRICE_TRANSP) : color.new(bearColorInput, FILL_STOP_TRANSP)) : na
color fillBottomColor = showFillInput ? (trendState == TREND_UP ? color.new(bullColorInput, FILL_STOP_TRANSP) : color.new(bearColorInput, FILL_PRICE_TRANSP)) : na

trailPlotId = plot(trailStop, "NRTR", color = flipped ? na : stateColor, linewidth = lineWidthInput, style = plot.style_linebr)
pricePlotId = plot(srcInput, "Price Anchor", color = na, editable = false, display = display.none)

fill(trailPlotId, pricePlotId, top_value = math.max(trailStop, srcInput), bottom_value = math.min(trailStop, srcInput), top_color = fillTopColor, bottom_color = fillBottomColor, title = "Trail Gradient Fill")

plotshape(showMarkersInput and flipBullish ? trailStop : na, "Bullish Reversal", shape.circle, location.absolute, color = bullColorInput, size = size.tiny)
plotshape(showMarkersInput and flipBearish ? trailStop : na, "Bearish Reversal", shape.circle, location.absolute, color = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(flipBullish, "Bullish Reversal", "NRTR flipped bullish on {{ticker}} ({{interval}}) — price crossed above the trailing line, which now trails below price")
alertcondition(flipBearish, "Bearish Reversal", "NRTR flipped bearish on {{ticker}} ({{interval}}) — price crossed below the trailing line, which now trails above price")
alertcondition(flipped, "Any Reversal", "NRTR reversed on {{ticker}} ({{interval}}) — the trailing line flipped to the opposite side of price")

//---------------------------------------------------------------------------------------------------------------------}
