//@version=6
// ESG-TH Indicator (STANDALONE TEST BUILD — generated, do not hand-edit)
// Open source (MPL-2.0). Shows SET ESG Ratings grade, 3-year history, industry peers, index flags for Thai stocks.
// Data via ESGDataTH library (generated from SET public announcements; Phase 1 = SET50).
// v0.6 (2026-09-12) — year labels derived from the data (annual refresh is data-only).
// v0.5 (2026-09-12) — title "ESG-TH SET50" (Phase 1 universe in the name); tooltips on every input.
// v0.4 (2026-09-12) — English UI; years shown as CE (EN) or Buddhist Era (TH) following the language input.
// v0.3 (2026-09-12) — + CG score (IOD CGR 2025), S&P Sustainability Yearbook 2026, SBTi climate target rows.
// v0.2 (2026-09-11) — history/peers/index/validity rows, placeholder rows hidden while na.
// v0.1 (2026-09-11) — grade table + tint.
indicator("ESG-TH SET50 [Itto-Ryu]", overlay = true)

// ---- inlined ESGDataTH (standalone test build) ----

type ESGData
    string ticker
    string grade      // SET ESG Ratings 2025: AAA/AA/A/BBB/NR
    string g2024      // grade of rating year - 1 (field name kept for compatibility; NR = not rated)
    string g2023      // grade of rating year - 2
    float  ftse
    float  e
    float  s
    float  g
    bool   inIndex    // SETESG index
    bool   inSET50
    bool   inSET100
    bool   inTESG     // Thai ESG fund universe (= rated)
    string industry   // SET industry group
    int    indRated   // rated companies in this industry group
    int    indSame    // ... of which share this grade
    int    cgr        // Thai IOD CGR 2025: 5 = Excellent, 4 = Very Good, 3 = Good, 0 = not announced
    bool   cgrFlag    // IOD "*": CG-related news lowered the published range
    string yearbook   // S&P Global Sustainability Yearbook 2026: Top 1% / Top 5% / Top 10% / Member / ""
    string sbti       // SBTi dashboard status text ("" = not on dashboard)
    string summaryTH
    string summaryEN
    int    year

// @function Announce date of the embedded SET ESG Ratings round (ISO date).
announceDate() => "2025-12-12"
// @function Month the embedded grades stay valid until.
validUntil() => "Dec 2026"
// @function What replaces SET ESG Ratings after validUntil().
nextRound() => "FTSE Russell ESG Scores"

// @function Look up ESG data for a SET ticker. Unknown ticker → grade "NR", year 0.
// @param ticker syminfo.ticker (without exchange prefix)
// @returns ESGData
get(string ticker) =>
    switch ticker
        "ADVANC" => ESGData.new("ADVANC", "AAA", "AA", "AAA", float(na), float(na), float(na), float(na), true, true, true, true, "Technology", 19, 7, 5, false, "", "", "เครือข่ายมือถือ/บรอดแบนด์ใหญ่สุดในไทย (AIS)", "Largest mobile & broadband operator (AIS)", 2025)
        "AOT" => ESGData.new("AOT", "AA", "A", "A", float(na), float(na), float(na), float(na), true, true, true, true, "Services", 52, 17, 5, false, "Top 1%", "", "บริหารท่าอากาศยานหลัก 6 แห่ง (สุวรรณภูมิ ฯลฯ)\nโฟกัส: Airport Carbon Accreditation, ชุมชน", "Operates 6 major airports incl. Suvarnabhumi\nFocus: Airport Carbon Accreditation, communities", 2025)
        "AWC" => ESGData.new("AWC", "AAA", "AA", "A", float(na), float(na), float(na), float(na), true, true, true, true, "Property & Construction", 42, 20, 5, false, "Top 1%", "", "อสังหาฯ โรงแรม-ค้าปลีก-ออฟฟิศ ในเครือ TCC", "Hotels, retail & office property (TCC Group)", 2025)
        "BANPU" => ESGData.new("BANPU", "AAA", "AAA", "AAA", float(na), float(na), float(na), float(na), true, true, true, true, "Resources", 27, 17, 5, false, "", "", "พลังงานครบวงจร ถ่านหิน ก๊าซ ไฟฟ้า พลังงานสะอาด", "Energy: coal, gas, power, renewables", 2025)
        "BBL" => ESGData.new("BBL", "AAA", "AAA", "AA", float(na), float(na), float(na), float(na), true, true, true, true, "Financials", 33, 13, 5, false, "Member", "", "ธนาคารสินทรัพย์ใหญ่สุดของไทย เครือข่ายอาเซียน", "Thailand's largest bank by assets, ASEAN network", 2025)
        "BCP" => ESGData.new("BCP", "NR", "NR", "NR", float(na), float(na), float(na), float(na), false, true, true, false, "", 0, 0, 4, false, "Top 10%", "", "โรงกลั่นและปั๊มบางจาก ต่อยอดพลังงานสะอาด SAF", "Bangchak refinery & fuel retail, SAF focus", 2025)
        "BDMS" => ESGData.new("BDMS", "AAA", "A", "AA", float(na), float(na), float(na), float(na), true, true, true, true, "Services", 52, 20, 5, false, "Top 1%", "", "เครือโรงพยาบาลเอกชนใหญ่สุดในไทย", "Thailand's largest private hospital group", 2025)
        "BEM" => ESGData.new("BEM", "AAA", "AAA", "AA", float(na), float(na), float(na), float(na), true, true, true, true, "Services", 52, 20, 5, false, "", "", "ทางด่วนและรถไฟฟ้า MRT สายสีน้ำเงิน/ม่วง", "Expressways & MRT Blue / Purple lines", 2025)
        "BH" => ESGData.new("BH", "A", "NR", "NR", float(na), float(na), float(na), float(na), true, true, true, true, "Services", 52, 11, 5, false, "", "", "โรงพยาบาลบำรุงราษฎร์ ผู้ป่วยต่างชาติสัดส่วนสูง", "Bumrungrad Hospital, many international patients", 2025)
        "BJC" => ESGData.new("BJC", "AAA", "AA", "AA", float(na), float(na), float(na), float(na), true, true, true, true, "Services", 52, 20, 5, false, "Top 1%", "", "ค้าปลีก Big C บรรจุภัณฑ์ และสินค้าอุปโภคบริโภค", "Big C retail, packaging & consumer goods", 2025)
        "CCET" => ESGData.new("CCET", "NR", "NR", "NR", float(na), float(na), float(na), float(na), false, true, true, false, "", 0, 0, 0, false, "", "", "ผู้ผลิตอิเล็กทรอนิกส์รับจ้าง (EMS) กลุ่ม Kinpo", "Electronics manufacturing services (Kinpo Group)", 2025)
