// ---- end ESGDataTH ----

g1 = "1) Display"
showTable = input.bool(true, "Show table", group = g1, tooltip = "Draw the ESG table on the last bar. Turn off to keep only the background tint.")
showTint  = input.bool(true, "Background tint by grade", group = g1, tooltip = "AAA green / AA teal / A blue / BBB amber / NR grey")
lang      = input.string("EN", "Language", options = ["EN", "TH"], group = g1, tooltip = "EN: English summary, years in CE (2023→2024→2025)\nTH: Thai summary, years in Buddhist Era (2566→2567→2568)")
pos       = input.string("top_right", "Table position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = g1, tooltip = "Corner of the chart where the table is drawn.")
txtSize   = input.string("small", "Text size", options = ["tiny", "small", "normal"], group = g1, tooltip = "Table font size. Use tiny on small screens or when the summary wraps.")

// ---- data (looked up once) ------------------------------------------------
isSET = str.startswith(syminfo.prefix, "SET")
var ESGData d = get(syminfo.ticker)
hasData = isSET and d.year > 0
rated   = hasData and d.grade != "NR"

gradeRank(string g) =>
    switch g
        "AAA" => 4
        "AA"  => 3
        "A"   => 2
        "BBB" => 1
        => 0

gradeColor(string g) =>
    switch g
        "AAA" => color.new(#26a69a, 0)
        "AA"  => color.new(#00bcd4, 0)
        "A"   => color.new(#2962ff, 0)
        "BBB" => color.new(#ffb300, 0)
        => color.new(#787b86, 0)

gradeText = not isSET ? "No data" : hasData ? d.grade : "NR"
gc = gradeColor(hasData ? d.grade : "NR")

bgcolor(showTint and isSET ? color.new(gc, 85) : na, title = "Grade tint")

// ---- derived text ---------------------------------------------------------
// History: 2023 → 2024 → 2025 (BE 2566 → 2567 → 2568) with trend vs last year
isTH = lang == "TH"
yr(int y) => str.tostring(isTH ? y + 543 : y)
ry = hasData ? d.year : 2025
histLabel = "History " + yr(ry - 2) + "→" + yr(ry - 1) + "→" + yr(ry)
trendTag = gradeRank(d.grade) > gradeRank(d.g2024) ? " ▲ up" : gradeRank(d.grade) < gradeRank(d.g2024) ? " ▼ down" : " = same"
histText = d.g2023 + " → " + d.g2024 + " → " + d.grade + trendTag

// Industry peers: how many rated in this group share the grade
peerText = d.indRated == 0 ? "—" : rated ? d.grade + " " + str.tostring(d.indSame) + " of " + str.tostring(d.indRated) + " rated" : str.tostring(d.indRated) + " rated in group"

yn(bool b) => b ? "✓" : "✗"
idxText = "SETESG " + yn(d.inIndex) + " · SET50 " + yn(d.inSET50) + " · SET100 " + yn(d.inSET100) + " · TESG " + yn(d.inTESG)

// Next index review: SETESG semi-annual (announced mid-Jun / mid-Dec)
nextReview = month(timenow) <= 6 ? "Jun " + str.tostring(year(timenow)) : "Dec " + str.tostring(year(timenow))
validText  = validUntil() + " · next: " + nextRound()

fmt(float v) => na(v) ? "—" : str.tostring(v, "#.#")

// CG score: IOD stars + level, ⚠ when IOD flagged CG-related news
cgrText = d.cgr == 5 ? "★★★★★ Excellent" : d.cgr == 4 ? "★★★★ Very Good" : d.cgr == 3 ? "★★★ Good" : "not announced"
cgrText := cgrText + (d.cgrFlag ? " ⚠ CG news" : "")

// ---- table ----------------------------------------------------------------
tblPos() =>
    switch pos
        "top_left"     => position.top_left
        "bottom_right" => position.bottom_right
        "bottom_left"  => position.bottom_left
        => position.top_right

tSize() =>
    switch txtSize
        "tiny"   => size.tiny
        "normal" => size.normal
        => size.small

var table t = table.new(tblPos(), 2, 13, bgcolor = color.new(#131722, 15), border_color = color.new(#2a2e39, 0), border_width = 1)
sz  = tSize()
txt = color.white
dim = color.new(#b2b5be, 0)

row(int r, string k, string v, color vc, string va) =>
    table.cell(t, 0, r, k, text_color = dim, text_size = sz, text_halign = text.align_left, text_valign = text.align_top)
    table.cell(t, 1, r, v, text_color = vc, text_size = sz, text_halign = va)

if barstate.islast and showTable
    hdr = color.new(gc, 60)
    int r = 0
    table.cell(t, 0, r, "ESG " + syminfo.ticker + (hasData ? " (" + yr(d.year) + ")" : ""), text_color = txt, bgcolor = hdr, text_size = sz, text_halign = text.align_left)
    table.cell(t, 1, r, gradeText, text_color = txt, bgcolor = hdr, text_size = sz, text_halign = text.align_center)
    r += 1
    if hasData
        row(r, histLabel, histText, txt, text.align_left)
        r += 1
        row(r, d.industry != "" ? "Peers · " + d.industry : "Peers", peerText, txt, text.align_left)
        r += 1
        row(r, "Index", idxText, txt, text.align_left)
        r += 1
        if not na(d.ftse)
            row(r, "FTSE ESG", fmt(d.ftse), txt, text.align_center)
            r += 1
        if not na(d.e) or not na(d.s) or not na(d.g)
            row(r, "E / S / G", fmt(d.e) + " / " + fmt(d.s) + " / " + fmt(d.g), txt, text.align_center)
            r += 1
        row(r, "CG score (IOD 2025)", cgrText, d.cgrFlag ? color.new(#ffb300, 0) : txt, text.align_left)
        r += 1
        row(r, "S&P Yearbook 2026", d.yearbook != "" ? d.yearbook : "not selected", txt, text.align_left)
        r += 1
        row(r, "SBTi climate target", d.sbti != "" ? d.sbti : "none on dashboard", txt, text.align_left)
        r += 1
        row(r, "Valid until", validText, txt, text.align_left)
        r += 1
        row(r, "Index review", nextReview + " (semi-annual)", txt, text.align_left)
        r += 1
        summ = isTH ? d.summaryTH : d.summaryEN
        if summ != ""
            row(r, "Summary", summ, txt, text.align_left)
            r += 1
    row(r, "Source", isSET ? "SET ESG Ratings " + yr(ry) + " · " + announceDate() : "non-SET symbol", dim, text.align_left)
