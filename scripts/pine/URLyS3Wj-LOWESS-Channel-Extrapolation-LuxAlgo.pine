//@version=6
indicator("LOWESS Channel & Extrapolation [LuxAlgo]", "LuxAlgo - LOWESS Channel & Extrapolation", overlay = true, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
int   lengthInput      = input.int(500, "Length", minval = 5, group = "Settings", tooltip = "Number of observations to fit the LOWESS curve over.")
float spanInput        = input.float(0.2, "Span", minval = 0.1, maxval = 1.0, group = "Settings", tooltip = "The fraction of data points used for each local regression.")
float multInput        = input.float(2.0, "Channel Multiplier", minval = 0.1, group = "Settings", tooltip = "Multiplier for the standard deviation of residuals to define channel width.")
int   extraBarsInput   = input.int(50, "Extrapolation Bars", minval = 0, group = "Settings", tooltip = "Number of bars to extrapolate into the future.")

color fitColorInput    = input.color(#5b9cf6, "Fit Color", group = "Visuals")
color channelColorInput = input.color(color.new(color.gray, 50), "Channel Color", group = "Visuals")
int   lineWidthInput   = input.int(2, "Line Width", minval = 1, group = "Visuals")


//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{
// @type Stores the result of a local linear regression
type RegressionResult
    float yHat
    float slope
    float intercept

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// @function Calculates the tricube weight
tricube(float u) =>
    math.pow(1 - math.pow(u, 3), 3)

// @function Performs local weighted linear regression for a focal point 'k'
lowessRegression(int length, float span, int k) =>
    int r = math.round(span * length)
    int left  = k
    int right = k
    
    for count = 1 to r - 1
        if left > 0 and right < length - 1
            if math.abs((left - 1) - k) < math.abs((right + 1) - k)
                left -= 1
            else
                right += 1
        else if left > 0
            left -= 1
        else if right < length - 1
            right += 1
    
    float h_k = math.max(math.abs(left - k), math.abs(right - k))
    
    float sumW = 0.0, sumWX = 0.0, sumWY = 0.0, sumWXX = 0.0, sumWXY = 0.0
    
    for j = left to right
        float dist = math.abs(j - k)
        float u    = h_k > 0 ? dist / h_k : 0.0
        float w    = tricube(math.min(u, 0.9999))
        
        float xVal = float(j)
        float yVal = close[j]
        
        sumW   += w
        sumWX  += w * xVal
        sumWY  += w * yVal
        sumWXX += w * xVal * xVal
        sumWXY += w * xVal * yVal
        
    float denominator = sumW * sumWXX - math.pow(sumWX, 2)
    float b = 0.0
    float a = 0.0
    
    if denominator != 0
        b := (sumW * sumWXY - sumWX * sumWY) / denominator
        a := (sumWY - b * sumWX) / sumW
    else
        a := sumW > 0 ? sumWY / sumW : close[k]
        b := 0.0
        
    RegressionResult.new(a + b * k, b, a)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Ensure sufficient lookback for the 'close' series
max_bars_back(close, 500)

var polyline midLine     = na
var polyline topLine     = na
var polyline btmLine     = na
var polyline fillLine    = na

if barstate.islast
    array<float> fits      = array.new<float>()
    array<float> residuals = array.new<float>()
    
    // 1. Calculate LOWESS fit across the window
    for i = lengthInput - 1 to 0
        RegressionResult res = lowessRegression(lengthInput, spanInput, i)
        fits.push(res.yHat)
        residuals.push(close[i] - res.yHat)
    
    // 2. Calculate Standard Deviation of residuals for the channel
    float stdevRes = residuals.stdev()
    float channelWidth = stdevRes * multInput
    
    // 3. Prepare Points (History + Extrapolation)
    array<chart.point> midPts = array.new<chart.point>()
    array<chart.point> topPts = array.new<chart.point>()
    array<chart.point> btmPts = array.new<chart.point>()
    
    // Add historical fitted points
    for i = 0 to lengthInput - 1
        int barIdx = bar_index[lengthInput - 1 - i]
        float val  = fits.get(i)
        midPts.push(chart.point.from_index(barIdx, val))
        topPts.push(chart.point.from_index(barIdx, val + channelWidth))
        btmPts.push(chart.point.from_index(barIdx, val - channelWidth))
    
    // 4. Extrapolation logic
    RegressionResult lastRes = lowessRegression(lengthInput, spanInput, 0)
    if extraBarsInput > 0
        for i = 1 to extraBarsInput
            int futureBarIdx = bar_index + i
            float futureVal = lastRes.intercept + lastRes.slope * (-i)
            midPts.push(chart.point.from_index(futureBarIdx, futureVal))
            topPts.push(chart.point.from_index(futureBarIdx, futureVal + channelWidth))
            btmPts.push(chart.point.from_index(futureBarIdx, futureVal - channelWidth))

    //---------------------------------------------------------------------------------------------------------------------}
    // Visualization
    //---------------------------------------------------------------------------------------------------------------------{
    midLine.delete()
    topLine.delete()
    btmLine.delete()
    fillLine.delete()
    
    // Create fill polyline
    array<chart.point> fillPts = topPts.copy()
    array<chart.point> btmPtsRev = btmPts.copy()
    btmPtsRev.reverse()
    fillPts.concat(btmPtsRev)

    fillLine := polyline.new(fillPts, curved = false, closed = true, line_color = na, fill_color = color.new(channelColorInput, 80))
    midLine  := polyline.new(midPts, curved = false, line_color = fitColorInput, line_width = lineWidthInput)
    topLine  := polyline.new(topPts, curved = false, line_color = channelColorInput, line_width = 1, line_style = line.style_dashed)
    btmLine  := polyline.new(btmPts, curved = false, line_color = channelColorInput, line_width = 1, line_style = line.style_dashed)

//---------------------------------------------------------------------------------------------------------------------}
