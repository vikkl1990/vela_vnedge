 input.bool(false, "", inline = "19")
 )

s00 = input.symbol("TSLA", "", group="Tickers", inline = "00")
s01 = input.symbol("NVDA", "", inline = "01")
s02 = input.symbol("META", "", inline = "02")
s03 = input.symbol("GOOGL", "",inline = "03")
s04 = input.symbol("AMZN", "", inline = "04")
s05 = input.symbol("AVGO", "", inline = "05")
s06 = input.symbol("JPM", "",  inline = "06")
s07 = input.symbol("V", "",    inline = "07")
