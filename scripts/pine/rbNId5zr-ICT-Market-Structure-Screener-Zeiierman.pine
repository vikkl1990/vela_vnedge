// ~~ UDTs {
type SMC
    array<float>Ups
    array<float>Dns
    bool alt
    string tick
    Up = high
    Dn = low
    pos = 0
    iUp = 0
    iDn = 0
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Variables {
b = bar_index
alrt = array.new<string>()
symbols = array.from(s00,s01,s02,s03,s04,s05,s06,s07,
 s08,s09,s10,s11,s12,s13,s14,s15,s16,s17,s18,s19)
var smcData = array.new<SMC>()
var cs = SMC.new(array.new<float>(),array.new<float>())
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Functions {
//~~Labels{
CreateLabel(x,y,txt,col,z)=>
    label.new(x,y,txt,textcolor=col,style=z?label.style_label_down:label.style_label_up,color=color(na))
//~~}
//~~Lines{
CreateLine(x1,x2,y,col)=>
    line.new(x1,x2,b,y,color=col)
//~~}
//~~Structure{
method SmartMoneyStructure(SMC x,rh,rl,plot)=>
    if x.Up>rh
        centerBull = math.round(math.avg(x.iUp,b))
        if x.pos<=0
            if plot and bull
                CreateLabel(centerBull,rh,"CHoCH",bull2,true)
                CreateLine(x.iUp,rh,rh,bull2)
            if x.alt
                alrt.push(x.tick+": Bullish CHoCH")
            x.pos := 1
        else if x.pos==1 and rh==x.Ups.get(math.min(x.Ups.size()-1,s1?resp:prd))
            if plot and bull
                CreateLabel(centerBull,rh,"SMS",bull2,true)
                CreateLine(x.iUp,rh,rh,bull2)
            if x.alt
                alrt.push(x.tick+": Bullish SMS")
            x.pos := 2
        else if x.pos>1 and rh==x.Ups.get(math.min(x.Ups.size()-1,s1?resp:prd))
            if plot and bull
                CreateLabel(centerBull,rh,"BMS",bull2,true)
                CreateLine(x.iUp,rh,rh,bull2)
            if x.alt
                alrt.push(x.tick+": Bullish BMS")
            x.pos += 1
        x.iUp := b
    else if x.Up<rh
        x.iUp := b-prd
    if x.Dn<rl
        centerBear = math.round(math.avg(x.iDn,b))
        if x.pos>=0
            if plot and bear
                CreateLabel(centerBear,rl,"CHoCH",bear2,false)
                CreateLine(x.iDn,rl,rl,bear2)
            if x.alt
                alrt.push(x.tick+": Bearish CHoCH")
            x.pos := -1
        else if x.pos==-1 and rl==x.Dns.get(math.min(x.Dns.size()-1,s1?resp:prd))
            if plot and bear
                CreateLabel(centerBear,rl,"SMS",bear2,false)
                CreateLine(x.iDn,rl,rl,bear2)
            if x.alt
                alrt.push(x.tick+": Bearish SMS")
            x.pos := -2
        else if x.pos<-1 and rl==x.Dns.get(math.min(x.Dns.size()-1,s1?resp:prd))
            if plot and bear
                CreateLabel(centerBear,rl,"BMS",bear2,false)
                CreateLine(x.iDn,rl,rl,bear2)
            if x.alt
                alrt.push(x.tick+": Bearish BMS")
            x.pos += -1
        x.iDn := b
    else if x.Dn>rl
        x.iDn := b-prd
//~~}
//~~Screen{
method SMCScreen(SMC data,h,l,pvtHi,pvtLo,plot)=>
    data.Ups.unshift(data.Up)
    data.Dns.unshift(data.Dn)
    prevUp = data.Up
    prevDn = data.Dn
    data.Up := math.max(prevUp,h)
    data.Dn := math.min(prevDn,l)
    if not na(pvtHi)
        data.Up := pvtHi
    if not na(pvtLo)
        data.Dn := pvtLo
    data.SmartMoneyStructure(prevUp,prevDn,plot)
    true
//~~}
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Declare {
if smcData.size()<=0
    for [i,s] in show
        t = str.split(symbols.get(i),":")
        smcData.push(SMC.new(array.new<float>(),array.new<float>(),s,t.get(1)))
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Requests {
[c00,h00,l00,ph00,pl00] = request.security(s00,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c01,h01,l01,ph01,pl01] = request.security(s01,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c02,h02,l02,ph02,pl02] = request.security(s02,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c03,h03,l03,ph03,pl03] = request.security(s03,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c04,h04,l04,ph04,pl04] = request.security(s04,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c05,h05,l05,ph05,pl05] = request.security(s05,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c06,h06,l06,ph06,pl06] = request.security(s06,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c07,h07,l07,ph07,pl07] = request.security(s07,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c08,h08,l08,ph08,pl08] = request.security(s08,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c09,h09,l09,ph09,pl09] = request.security(s09,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c10,h10,l10,ph10,pl10] = request.security(s10,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c11,h11,l11,ph11,pl11] = request.security(s11,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c12,h12,l12,ph12,pl12] = request.security(s12,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c13,h13,l13,ph13,pl13] = request.security(s13,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c14,h14,l14,ph14,pl14] = request.security(s14,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c15,h15,l15,ph15,pl15] = request.security(s15,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c16,h16,l16,ph16,pl16] = request.security(s16,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c17,h17,l17,ph17,pl17] = request.security(s17,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c18,h18,l18,ph18,pl18] = request.security(s18,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)
[c19,h19,l19,ph19,pl19] = request.security(s19,timeframe.period,[close,high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd)],ignore_invalid_symbol=true)

//Run Screener
smcData.get(0).SMCScreen(h00,l00,ph00,pl00,false)
smcData.get(1).SMCScreen(h01,l01,ph01,pl01,false)
smcData.get(2).SMCScreen(h02,l02,ph02,pl02,false)
smcData.get(3).SMCScreen(h03,l03,ph03,pl03,false)
smcData.get(4).SMCScreen(h04,l04,ph04,pl04,false)
smcData.get(5).SMCScreen(h05,l05,ph05,pl05,false)
smcData.get(6).SMCScreen(h06,l06,ph06,pl06,false)
smcData.get(7).SMCScreen(h07,l07,ph07,pl07,false)
smcData.get(8).SMCScreen(h08,l08,ph08,pl08,false)
smcData.get(9).SMCScreen(h09,l09,ph09,pl09,false)
smcData.get(10).SMCScreen(h10,l10,ph10,pl10,false)
smcData.get(11).SMCScreen(h11,l11,ph11,pl11,false)
smcData.get(12).SMCScreen(h12,l12,ph12,pl12,false)
smcData.get(13).SMCScreen(h13,l13,ph13,pl13,false)
smcData.get(14).SMCScreen(h14,l14,ph14,pl14,false)
smcData.get(15).SMCScreen(h15,l15,ph15,pl15,false)
