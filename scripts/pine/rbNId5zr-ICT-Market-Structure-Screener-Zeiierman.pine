smcData.get(17).SMCScreen(h17,l17,ph17,pl17,false)
smcData.get(18).SMCScreen(h18,l18,ph18,pl18,false)
smcData.get(19).SMCScreen(h19,l19,ph19,pl19,false)
prices = array.from(c00,c01,c02,c03,c04,c05,c06,c07,
     c08,c09,c10,c11,c12,c13,c14,c15,c16,c17,c18,c19)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Table {
if barstate.islast
    //~~Header{
    var tbl = table.new(pos,8,symbols.size()+2, frame_color = color.white, frame_width = 1, border_color = color.white, border_width = 1)
    header = array.from("Ticker","Price","Trend","Signal","Range","Premium","Mid","Discount")
    for [i,h] in headers
        if h
            tbl.cell(i,0,header.get(i),text_color=color.white,bgcolor=headCol, text_size = size)
    //~~}
    //~~Plot & Alert{
    //Rows
    for [i,val] in smcData
        if show.get(i)
            t = str.split(symbols.get(i),":")

            Up = val.Up
            Dn = val.Dn
            PremiumTop   = Up-(Up-Dn)*.1
            PremiumBot   = Up-(Up-Dn)*.25
            DiscountTop  = Dn+(Up-Dn)*.25
            DiscountBot  = Dn+(Up-Dn)*.1
            MidTop       = Up-(Up-Dn)*.45
            MidBot       = Dn+(Up-Dn)*.45

            sig = val.pos==1 or val.pos==-1?"CHoCH":
             val.pos==2 or val.pos==-2?"SMS":"BMS"

            values = array.from(t.get(1),str.format("{0,number,currency}",prices.get(i)),val.pos>0?"Bullish":"Bearish",
             sig,str.format("{0,number,currency}",Up)+"-"+str.format("{0,number,currency}",Dn),
             str.format("{0,number,currency}",PremiumTop)+"-"+str.format("{0,number,currency}",PremiumBot),
             str.format("{0,number,currency}",MidTop)+"-"+str.format("{0,number,currency}",MidBot),
             str.format("{0,number,currency}",DiscountTop)+"-"+str.format("{0,number,currency}",DiscountBot))

            //Columns
            for [j,h] in headers
                if h
                    tbl.cell(j,i+1,values.get(j),text_color=color.white,bgcolor=val.pos>0?tblBullCol:tblBearCol,text_size = size)

            //~~Alerts{
            priceInPremium  = prices.get(i)<=PremiumTop and prices.get(i)>=PremiumBot
            priceInMid      = prices.get(i)<=MidTop and prices.get(i)>=MidBot
            priceInDiscount = prices.get(i)<=DiscountTop and prices.get(i)>=DiscountBot
            if priceInPremium or priceInMid or priceInDiscount
                str = priceInPremium?"Premium":priceInMid?"Mid":"Discount"
                alrt.push(t.get(1)+" in "+str+" area!")
            //~~}
        //~~}
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Main {
cs.SMCScreen(high,low,ta.pivothigh(high,prd,prd),ta.pivotlow(low,prd,prd),true)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Premium & Discount {
Up = cs.Up
Dn = cs.Dn
PremiumTop   = Up-(Up-Dn)*.1
PremiumBot   = Up-(Up-Dn)*.25
DiscountTop  = Dn+(Up-Dn)*.25
DiscountBot  = Dn+(Up-Dn)*.1
MidTop       = Up-(Up-Dn)*.45
MidBot       = Dn+(Up-Dn)*.45
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Plots {
//Active Range
var top = line.new(chart.point.from_index(na,na),chart.point.from_index(na,na),color=bear2,width=2)
var bot = line.new(chart.point.from_index(na,na),chart.point.from_index(na,na),color=bull2,width=2)
var pre = box.new(chart.point.from_index(na,na),chart.point.from_index(na,na),bgcolor=prem,border_color=na)
var mid = box.new(chart.point.from_index(na,na),chart.point.from_index(na,na),bgcolor=midcol,border_color=na)
var dis = box.new(chart.point.from_index(na,na),chart.point.from_index(na,na),bgcolor=disc,border_color=na)

if curr=="Active Range"
    right = bar_index+20
    leftUp = cs.iUp
    leftDn = cs.iDn
    top.set_first_point(chart.point.from_index(leftUp,Up))
    top.set_second_point(chart.point.from_index(right,Up))
    bot.set_first_point(chart.point.from_index(leftDn,Dn))
    bot.set_second_point(chart.point.from_index(right,Dn))
    left = math.max(leftUp,leftDn)
    if showPD
        pre.set_lefttop(left,PremiumTop)
        pre.set_rightbottom(right,PremiumBot)
        mid.set_lefttop(left,MidTop)
        mid.set_rightbottom(right,MidBot)
        dis.set_lefttop(left,DiscountTop)
        dis.set_rightbottom(right,DiscountBot)

//Previous Range
r1 = plot(curr=="Previous Range"?Up:na,"Range High",bear2)
r2 = plot(curr=="Previous Range"?Dn:na,"Range Low",bull2)
p1 = plot(showPD and curr=="Previous Range"?PremiumTop:na,"Premium",na)
p2 = plot(showPD and curr=="Previous Range"?PremiumBot:na,"Premium",na)
d1 = plot(showPD and curr=="Previous Range"?DiscountTop:na,"Discount",na)
d2 = plot(showPD and curr=="Previous Range"?DiscountBot:na,"Discount",na)
m1 = plot(showPD and curr=="Previous Range"?MidTop:na,"Mid",na)
m2 = plot(showPD and curr=="Previous Range"?MidBot:na,"Mid",na)

fill(p1,p2,color=prem)
fill(d1,d2,color=disc)
fill(m1,m2,color=midcol)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Alert {
if alrt.size()>0
    alert(alrt.join("\n"),alert.freq_once_per_bar_close)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}