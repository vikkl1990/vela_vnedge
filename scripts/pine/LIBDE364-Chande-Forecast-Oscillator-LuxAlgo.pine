//@version=6
indicator("Chande Forecast Oscillator", shorttitle = "Chande Forecast Oscillator", overlay = false, format = format.percent, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // trigger line color
ZERO_LINE_TRANSP  = 90      // zero line transparency
FILL_VALUE_TRANSP = 50      // gradient transparency at the oscillator value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput          = input.source(close, "Source", group = "Settings",
     tooltip = "Price series the linear regression is fit to and the deviation is measured from. Closing prices are the standard choice from Chande's original %F formulation.")

lengthInput       = input.int(14, "Regression Length", minval = 2, group = "Settings",
     tooltip = "Number of bars in the least-squares regression window. Each bar the line is refit to the last N values and its endpoint is taken as the forecast for the current bar. Short windows hug price and cross zero often, suiting fast tactical reads; long windows track the larger trend and flag fewer, slower deviations. 14 is the common charting default - expect the oscillator's behavior to change materially when you change it.")

signalLengthInput = input.int(3, "Signal Smoothing", minval = 1, inline = "signal", group = "Settings",
     tooltip = "Length of the short moving average of the oscillator used as a trigger line. The oscillator crossing its trigger typically fires before the zero cross does, at the cost of more noise. Around three periods is the usual choice.")

signalTypeInput   = input.string("SMA", "", options = ["SMA", "EMA"], inline = "signal", group = "Settings",
     tooltip = "Moving average type used for the trigger line.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Color of the oscillator line and gradient fill above the zero line, where the close runs ahead of its regression forecast.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Color of the oscillator line and gradient fill below the zero line, where the close runs behind its regression forecast.")

signalColorInput  = input.color(SIGNAL_COLOR, "Signal Line", group = "Style",
     tooltip = "Color of the trigger line.")

showSignalInput   = input.bool(true, "Show Signal Line", group = "Style",
     tooltip = "Displays the short moving average of the oscillator as a trigger line for earlier crossing signals. Alerts on trigger crossings stay active even when the line is hidden.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the zero line and the oscillator with a vertical gradient, fully transparent at zero and strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Regression forecast - a least-squares line is fit to the last N source values and evaluated at the current bar,
// the endpoint of the fit (the least-squares moving average). This is the point the fitted trend says price should
// sit at right now, using every bar in the window rather than a single reference bar N bars back
forecastValue = ta.linreg(srcInput, lengthInput, 0)

// Chande Forecast Oscillator (%F) - the gap between price and its forecast, stated as a percentage of price so
// readings are comparable across instruments. Positive = price running ahead of its own fitted trend, negative =
// behind it; near zero in a steady trend where price simply meets its own forecast. Guarded against a zero
// denominator on exotic series. Note the scale has no fixed bounds - stretch is judged against the instrument's
// own recent envelope, not universal levels
cfoValue = srcInput != 0 ? 100 * (srcInput - forecastValue) / srcInput : na

// Trigger line - a short moving average of the oscillator itself. Both smoothings are computed on every bar, the
// input selects which one is used
smaSignal  = ta.sma(cfoValue, signalLengthInput)
emaSignal  = ta.ema(cfoValue, signalLengthInput)
signalLine = signalTypeInput == "EMA" ? emaSignal : smaSignal

// Signal grammar from the concept - the zero cross marks the close crossing its regression fit (short-term strength
// or weakness against the fitted trend), while the trigger-line cross fires earlier at the cost of more noise
zeroCrossUp   = ta.crossover(cfoValue, 0)
zeroCrossDown = ta.crossunder(cfoValue, 0)
bullTrigger   = ta.crossover(cfoValue, signalLine)
bearTrigger   = ta.crossunder(cfoValue, signalLine)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
zeroPlotId = plot(0, "Zero Line", color = color.new(chart.fg_color, ZERO_LINE_TRANSP), linewidth = 1)

plot(showSignalInput ? signalLine : na, "Signal Line", color = signalColorInput, linewidth = 1)

cfoPlotId = plot(cfoValue, "CFO Line", color = cfoValue > 0 ? bullColorInput : bearColorInput, linewidth = 1)

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the oscillator value
fillTopColor    = cfoValue > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_ZERO_TRANSP)
fillBottomColor = cfoValue > 0 ? color.new(bullColorInput, FILL_ZERO_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(cfoPlotId, zeroPlotId, top_value = math.max(cfoValue, 0), bottom_value = math.min(cfoValue, 0), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Zero-line Gradient Fill")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(zeroCrossUp, "Zero-line Cross Up", "CFO crossed above zero on {{ticker}} - the close moved above its regression forecast, short-term strength against the fitted trend ({{interval}})")
alertcondition(zeroCrossDown, "Zero-line Cross Down", "CFO crossed below zero on {{ticker}} - the close dropped below its regression forecast, short-term weakness against the fitted trend ({{interval}})")
alertcondition(bullTrigger, "Bullish Signal Cross", "CFO crossed above its trigger line on {{ticker}} - early upside cue that typically fires before the zero cross ({{interval}})")
alertcondition(bearTrigger, "Bearish Signal Cross", "CFO crossed below its trigger line on {{ticker}} - early downside cue that typically fires before the zero cross ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
