//@version=6
indicator("Vortex Indicator", "VI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 1, group = "Settings", tooltip = "Number of bars used to sum the vortex movements (VM+ and VM-) and the true range.")

viPlusColorInput   = input.color(#089981, "VI+", group = "Style", tooltip = "Color of the positive vortex line (VI+).")
viMinusColorInput  = input.color(#f23645, "VI-", group = "Style", tooltip = "Color of the negative vortex line (VI-).")
baselineColorInput = input.color(#787b86, "Baseline", group = "Style", tooltip = "Color of the dotted baseline drawn at 1.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
vmPlusSum  = math.sum(math.abs(high - low[1]), lengthInput)
vmMinusSum = math.sum(math.abs(low - high[1]), lengthInput)
trSum      = math.sum(ta.tr(true), lengthInput)

viPlus  = vmPlusSum / trSum
viMinus = vmMinusSum / trSum
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(viPlus, "VI+", viPlusColorInput)
plot(viMinus, "VI-", viMinusColorInput)

hline(1, "Baseline", color = baselineColorInput, linestyle = hline.style_dotted)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
bullishCross = ta.crossover(viPlus, viMinus)
bearishCross = ta.crossunder(viPlus, viMinus)

alertcondition(bullishCross, "Bullish Cross", "VI+ crossed above VI-")
alertcondition(bearishCross, "Bearish Cross", "VI+ crossed below VI-")
//----------------------------------------------------------------------------------------------------------------------}
