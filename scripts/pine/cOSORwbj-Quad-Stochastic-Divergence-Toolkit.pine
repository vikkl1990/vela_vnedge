//@version=6
indicator("Quad Stochastic Divergence Toolkit", overlay=false, max_lines_count=500, max_labels_count=500)

getLineStyle(s) =>
    s == "solid" ? line.style_solid :
     s == "dashed" ? line.style_dashed :
     s == "dotted" ? line.style_dotted : line.style_solid

spacing = syminfo.mintick * 5

f_update_label(label lab, bool enabled, bool show, int xOffset, float y, string txt, color col, color txtCol) =>
    label _lab = lab
    if enabled and show and barstate.islast
        if na(_lab)
            _lab := label.new(bar_index + xOffset, y, txt, xloc=xloc.bar_index, style=label.style_label_center, textcolor=txtCol, color=color.new(col, 0), size=size.small)
        else
            label.set_x(_lab, bar_index + xOffset)
            label.set_y(_lab, y)
            label.set_text(_lab, txt)
            label.set_color(_lab, color.new(col, 0))
            label.set_textcolor(_lab, txtCol)
        _lab
    else
        if not na(_lab)
            label.delete(_lab)
        na

f_stoch(len, smK, smD) =>
    k = ta.sma(ta.stoch(close, high, low, len), smK)
    ta.sma(k, smD)

// Stochastic 1
enable1    = input.bool(true, "Enable Stoch 1", group="Stoch 1")
len1       = input.int(9, "Length", minval=1, group="Stoch 1")
smK1       = input.int(1, "K Smoothing", minval=1, group="Stoch 1")
smD1       = input.int(3, "D Smoothing", minval=1, group="Stoch 1")
off1       = input.float(170, "Vertical Offset", group="Stoch 1")
col1       = input.color(color.rgb(197, 121, 22), "Stoch Line Color", group="Stoch 1")
showLabel1 = input.bool(true, "Show Value Label", group="Stoch 1")
labelOffset1 = input.int(3, "Value Label Bars Right", minval=0, maxval=100, group="Stoch 1")
labelTextColor1 = input.color(color.black, "Value Label Text Color", group="Stoch 1")

d1_raw = f_stoch(len1, smK1, smD1)
d1 = d1_raw + off1

plot(enable1 ? d1 : na, title="Stoch 1", color=col1, linewidth=1)

var label stoch1Label = na
stoch1Label := f_update_label(stoch1Label, enable1, showLabel1, labelOffset1, d1, str.tostring(d1_raw, "#"), col1, labelTextColor1)

h20_1 = hline(off1 + 20, "Stoch1 20", color=color.new(color.white, 70), linestyle=hline.style_solid)
h80_1 = hline(off1 + 80, "Stoch1 80", color=color.new(color.white, 70), linestyle=hline.style_solid)
h50_1 = hline(off1 + 50, "Stoch1 50", color=color.new(color.white, 80), linestyle=hline.style_dashed)
fill(h20_1, h80_1, color=color.new(#2196F3, 95))

// Divergence A
div1A_bull_on = input.bool(true, "Enable Bullish / Long", group="Stoch 1 - Div A")
div1A_bear_on = input.bool(true, "Enable Bearish / Short", group="Stoch 1 - Div A")
longLeft1A   = input.int(3, "Long Left A", minval=1, group="Stoch 1 - Div A")
longRight1A  = input.int(3, "Long Right A", minval=1, group="Stoch 1 - Div A")
shortLeft1A  = input.int(3, "Short Left A", minval=1, group="Stoch 1 - Div A")
shortRight1A = input.int(3, "Short Right A", minval=1, group="Stoch 1 - Div A")
bullP1A = input.color(color.lime, "Price Line A (Bullish)", group="Stoch 1 - Div A")
bullS1A = input.color(color.lime, "Stoch Line A (Bullish)", group="Stoch 1 - Div A")
bearP1A = input.color(color.red, "Price Line A (Bearish)", group="Stoch 1 - Div A")
bearS1A = input.color(color.red, "Stoch Line A (Bearish)", group="Stoch 1 - Div A")
width1A = input.int(1, "Width A", minval=1, maxval=5, group="Stoch 1 - Div A")
style1A = input.string("solid", "Style A", options=["solid", "dashed", "dotted"], group="Stoch 1 - Div A")

// Divergence B
div1B_bull_on = input.bool(true, "Enable Bullish / Long", group="Stoch 1 - Div B")
div1B_bear_on = input.bool(true, "Enable Bearish / Short", group="Stoch 1 - Div B")
longLeft1B   = input.int(6, "Long Left B", minval=1, group="Stoch 1 - Div B")
longRight1B  = input.int(6, "Long Right B", minval=1, group="Stoch 1 - Div B")
shortLeft1B  = input.int(6, "Short Left B", minval=1, group="Stoch 1 - Div B")
shortRight1B = input.int(6, "Short Right B", minval=1, group="Stoch 1 - Div B")
bullP1B = input.color(color.green, "Price Line B (Bullish)", group="Stoch 1 - Div B")
bullS1B = input.color(color.green, "Stoch Line B (Bullish)", group="Stoch 1 - Div B")
bearP1B = input.color(color.maroon, "Price Line B (Bearish)", group="Stoch 1 - Div B")
bearS1B = input.color(color.maroon, "Stoch Line B (Bearish)", group="Stoch 1 - Div B")
width1B = input.int(1, "Width B", minval=1, maxval=5, group="Stoch 1 - Div B")
style1B = input.string("dashed", "Style B", options=["solid", "dashed", "dotted"], group="Stoch 1 - Div B")

// Bullish pivot state
var float lp1A = na
var float ls1A = na
var int lbp1A = na
var int lsp1A = na
var float lp1B = na
var float ls1B = na
var int lbp1B = na
var int lsp1B = na

// Bearish pivot state
var float hp1A = na
var float hs1A = na
var int hbp1A = na
var int hsp1A = na
var float hp1B = na
var float hs1B = na
var int hbp1B = na
var int hsp1B = na

var int lastBullDiv1ABar = na
var int lastBearDiv1ABar = na

if enable1
    // A bullish: price lower low, stochastic higher low
    price1A_bull = ta.pivotlow(low, longLeft1A, longRight1A)
    stoch1A_bull = ta.pivotlow(d1_raw, longLeft1A, longRight1A)

    if div1A_bull_on and not na(price1A_bull) and not na(stoch1A_bull)
        bidx = bar_index - longRight1A
        pr = low[longRight1A]
        st = d1_raw[longRight1A] + off1

        if not na(lp1A) and not na(ls1A) and pr < lp1A and st > ls1A
            line.new(bidx, pr, lbp1A, lp1A, xloc=xloc.bar_index, color=bullP1A, width=width1A, style=getLineStyle(style1A), force_overlay=true)
            line.new(bidx, st, lsp1A, ls1A, xloc=xloc.bar_index, color=bullS1A, width=width1A, style=getLineStyle(style1A))
            lastBullDiv1ABar := bidx

        lp1A := pr
        lbp1A := bidx
        ls1A := st
        lsp1A := bidx

    // A bearish: price higher high, stochastic lower high
    price1A_bear = ta.pivothigh(high, shortLeft1A, shortRight1A)
    stoch1A_bear = ta.pivothigh(d1_raw, shortLeft1A, shortRight1A)

    if div1A_bear_on and not na(price1A_bear) and not na(stoch1A_bear)
        bidx = bar_index - shortRight1A
        pr = high[shortRight1A]
        st = d1_raw[shortRight1A] + off1

        if not na(hp1A) and not na(hs1A) and pr > hp1A and st < hs1A
            line.new(bidx, pr, hbp1A, hp1A, xloc=xloc.bar_index, color=bearP1A, width=width1A, style=getLineStyle(style1A), force_overlay=true)
            line.new(bidx, st, hsp1A, hs1A, xloc=xloc.bar_index, color=bearS1A, width=width1A, style=getLineStyle(style1A))
            lastBearDiv1ABar := bidx

        hp1A := pr
        hbp1A := bidx
        hs1A := st
        hsp1A := bidx

    // B bullish
    price1B_bull = ta.pivotlow(low, longLeft1B, longRight1B)
    stoch1B_bull = ta.pivotlow(d1_raw, longLeft1B, longRight1B)

    if div1B_bull_on and not na(price1B_bull) and not na(stoch1B_bull)
        bidx = bar_index - longRight1B
        isOverlapBull = lastBullDiv1ABar == bidx
        prRaw = low[longRight1B]
        prDraw = prRaw - (isOverlapBull ? spacing : 0)
        st = d1_raw[longRight1B] + off1

        if not na(lp1B) and not na(ls1B) and prRaw < lp1B and st > ls1B
            line.new(bidx, prDraw, lbp1B, lp1B, xloc=xloc.bar_index, color=bullP1B, width=width1B, style=getLineStyle(style1B), force_overlay=true)
            line.new(bidx, st, lsp1B, ls1B, xloc=xloc.bar_index, color=bullS1B, width=width1B, style=getLineStyle(style1B))

        lp1B := prRaw
        lbp1B := bidx
        ls1B := st
        lsp1B := bidx

    // B bearish
    price1B_bear = ta.pivothigh(high, shortLeft1B, shortRight1B)
    stoch1B_bear = ta.pivothigh(d1_raw, shortLeft1B, shortRight1B)

    if div1B_bear_on and not na(price1B_bear) and not na(stoch1B_bear)
        bidx = bar_index - shortRight1B
        isOverlapBear = lastBearDiv1ABar == bidx
        prRaw = high[shortRight1B]
        prDraw = prRaw + (isOverlapBear ? spacing : 0)
        st = d1_raw[shortRight1B] + off1

        if not na(hp1B) and not na(hs1B) and prRaw > hp1B and st < hs1B
            line.new(bidx, prDraw, hbp1B, hp1B, xloc=xloc.bar_index, color=bearP1B, width=width1B, style=getLineStyle(style1B), force_overlay=true)
            line.new(bidx, st, hsp1B, hs1B, xloc=xloc.bar_index, color=bearS1B, width=width1B, style=getLineStyle(style1B))

        hp1B := prRaw
        hbp1B := bidx
        hs1B := st
        hsp1B := bidx

// Stochastic 2
enable2    = input.bool(true, "Enable Stoch 2", group="Stoch 2")
len2       = input.int(14, "Length", minval=1, group="Stoch 2")
smK2       = input.int(1, "K Smoothing", minval=1, group="Stoch 2")
smD2       = input.int(3, "D Smoothing", minval=1, group="Stoch 2")
off2       = input.float(41, "Vertical Offset", group="Stoch 2")
col2       = input.color(color.rgb(58, 185, 189), "Stoch Line Color", group="Stoch 2")
showLabel2 = input.bool(true, "Show Value Label", group="Stoch 2")
labelOffset2 = input.int(3, "Value Label Bars Right", minval=0, maxval=100, group="Stoch 2")
labelTextColor2 = input.color(color.black, "Value Label Text Color", group="Stoch 2")

d2_raw = f_stoch(len2, smK2, smD2)
