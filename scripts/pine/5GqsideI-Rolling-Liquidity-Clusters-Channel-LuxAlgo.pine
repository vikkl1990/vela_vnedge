//@version=6
indicator("Rolling Liquidity Clusters Channel [LuxAlgo]", "LuxAlgo - Rolling Liquidity Clusters Channel", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput     = input.int(20, "Window Size", minval = 2, group = "Settings", tooltip = "Number of bars to look back for calculating the levels.")

// Inverted colors: Upper is now Red (resistance), Lower is now Green (support)
upperColorInput = input.color(color.new(#f23645, 0), "Upper Level", inline = "Upper", group = "Visuals")
lowerColorInput = input.color(color.new(#089981, 0), "Lower Level", inline = "Lower", group = "Visuals")
midColorInput   = input.color(color.new(#ff5d00, 0), "Mid Level", inline = "Mid", group = "Visuals")

//---------------------------------------------------------------------------------------------------------------------}
// Logic
//---------------------------------------------------------------------------------------------------------------------{
// Define body boundaries for each candle
bodyHigh = math.max(open, close)
bodyLow  = math.min(open, close)

// Identify the highest body high and lowest body low within the rolling window.
maxBodyHigh = ta.highest(bodyHigh, lengthInput)
minBodyLow  = ta.lowest(bodyLow, lengthInput)

float upperLevel = na
float lowerLevel = na

for i = 0 to lengthInput - 1
    float h = high[i]
    float l = low[i]
    
    // Find the minimum high that is above all bodies in the window
    if h >= maxBodyHigh
        if na(upperLevel) or h < upperLevel
            upperLevel := h
            
    // Find the maximum low that is below all bodies in the window
    if l <= minBodyLow
        if na(lowerLevel) or l > lowerLevel
            lowerLevel := l

// Calculate the average (Mid Level) of the channel
float midLevel = (upperLevel + lowerLevel) / 2

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Plotting levels
pUpper = plot(upperLevel, "Upper Level", color = upperColorInput, style = plot.style_linebr, linewidth = 2)
pMid   = plot(midLevel, "Mid Level", color = midColorInput, style = plot.style_linebr, linewidth = 1)
pLower = plot(lowerLevel, "Lower Level", color = lowerColorInput, style = plot.style_linebr, linewidth = 2)

// Vertical Gradient Fills
// Upper half (Red Gradient): Fades from 90% transparency at the level to 100% at the mid level
fill(pUpper, pMid, upperLevel, midLevel, color.new(upperColorInput, 90), color.new(upperColorInput, 100), "Upper Gradient Fill")

// Lower half (Green Gradient): Fades from 100% transparency at the mid level to 90% at the lower level
fill(pMid, pLower, midLevel, lowerLevel, color.new(lowerColorInput, 100), color.new(lowerColorInput, 90), "Lower Gradient Fill")

//---------------------------------------------------------------------------------------------------------------------}
