//@version=6
indicator("Change-Point Detection (CUSUM) [LuxAlgo]", "LuxAlgo - Change-Point Detection", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645


string SETTINGS_GROUP  = 'Algorithm Settings'


//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
// Algorithm Inputs
lengthInput    = input.int(50, "Lookback Period", minval = 10, group = SETTINGS_GROUP, tooltip = "Period used to calculate the rolling statistics of log-returns.")
thresholdInput = input.float(4.0, "Threshold (h)", minval = 0.1, step = 0.1, group = SETTINGS_GROUP, tooltip = "Sensitivity of the detection. Higher values require more accumulation to trigger a change.")
slackInput     = input.float(0.5, "Slack (k)", minval = 0.0, step = 0.1, group = SETTINGS_GROUP, tooltip = "The 'allowable' deviation. Smaller values make the algorithm more sensitive.")


//---------------------------------------------------------------------------------------------------------------------}

// Core Logic: CUSUM Algorithm
//---------------------------------------------------------------------------------------------------------------------{
float src = close

// 1. Calculate Log Returns and Standardize
float logReturns  = math.log(src / nz(src[1], src))
float rollingMean = ta.sma(logReturns, lengthInput)
float rollingStd  = ta.stdev(logReturns, lengthInput)
float zScore      = (logReturns - rollingMean) / (rollingStd == 0 ? 1.0 : rollingStd)

// 2. CUSUM Accumulators
var float sPos = 0.0
var float sNeg = 0.0
var int trend  = 0 // 1 for Bull, -1 for Bear

if not na(zScore)
    sPos := math.max(0, sPos + zScore - slackInput)
    sNeg := math.min(0, sNeg + zScore + slackInput)

// 3. Detection Logic
bool changeUp = sPos > thresholdInput
bool changeDn = sNeg < -thresholdInput
bool isChange = changeUp or changeDn

// 4. Regime State Management
var float regimePrice    = na
var int   regimeStartBar = bar_index

if isChange or (bar_index == lengthInput)
    trend          := changeUp ? 1 : (changeDn ? -1 : trend)
    regimePrice    := src
    regimeStartBar := bar_index
    // Reset accumulators on change
    sPos := 0.0
    sNeg := 0.0

int barsInRegime = bar_index - regimeStartBar

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Trend-based regime line with cuts on change
color trendColor = trend == 1 ? BULL_COLOR : (trend == -1 ? BEAR_COLOR : color.gray)
bool isLevelChange = regimePrice != regimePrice[1]
// Regime Plot
pRegime = plot(regimePrice, "Regime Price", color = isLevelChange ? na : trendColor, style = plot.style_linebr, linewidth = 2)

// CUSUM Accumulation Visualization (Both sides)
float priceVol      = ta.stdev(src, lengthInput)
float cusumLevelPos = regimePrice + sPos * priceVol
float cusumLevelNeg = regimePrice + sNeg * priceVol

pCusumPos = plot(cusumLevelPos, "Bullish Pressure", color = isLevelChange ? na : color.new(BULL_COLOR, 80), style = plot.style_linebr)
pCusumNeg = plot(cusumLevelNeg, "Bearish Pressure", color = isLevelChange ? na : color.new(BEAR_COLOR, 80), style = plot.style_linebr)

// Fills for both potential directions
fill(pRegime, pCusumPos, color.new(BULL_COLOR, 90), "Bullish CUSUM Fill")
fill(pRegime, pCusumNeg, color.new(BEAR_COLOR, 90), "Bearish CUSUM Fill")

// Change Point Markers
plotshape(changeUp, "Change Up", shape.triangleup,   location.belowbar, BULL_COLOR, size = size.tiny)
plotshape(changeDn, "Change Down", shape.triangledown, location.abovebar, BEAR_COLOR, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}

