//@version=6
indicator('Supertrend Zones + RSI Dots', 'ST Zones + Dots', format = format.price, precision = 2, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------------------
// HOW THIS WORKS
// The script runs in its own pane (the RSI). Zone background, Supertrend line,
// dots, the India VIX Supertrend strip and the HH/HL/LH/LL market structure
// (labels + support/resistance lines) are drawn on the main chart using
// force_overlay = true.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// CONSTANTS
// ---------------------------------------------------------------------------
RSI_RAW = 'RSI'
RSI_SMA = 'RSI SMA'

ST_GROUP  = 'Supertrend Zones'
VIX_GROUP = 'India VIX Supertrend'
DOT_GROUP = 'RSI Dots'
RSI_GROUP = 'RSI Settings'
SMOOTH_GROUP = 'Smoothing'
MS_GROUP = 'Market Structure (HH/HL/LH/LL)'

// ---------------------------------------------------------------------------
// INPUTS - SUPERTREND ZONES
// ---------------------------------------------------------------------------
stLength   = input.int(10, 'Supertrend ATR Length', group = ST_GROUP, minval = 1)
stFactor   = input.float(3.0, 'Supertrend Factor', group = ST_GROUP, minval = 0.1, step = 0.1)
buyColor   = input.color(color.new(color.green, 85), 'Buying Zone Color', group = ST_GROUP)
sellColor  = input.color(color.new(color.red, 85), 'Selling Zone Color', group = ST_GROUP)
showLabels = input.bool(false, 'Show Zone Start Markers', group = ST_GROUP)
showLine   = input.bool(false, 'Show Supertrend Line', group = ST_GROUP)

// ---------------------------------------------------------------------------
// INPUTS - INDIA VIX SUPERTREND STRIP
// ---------------------------------------------------------------------------
showVix     = input.bool(true, 'Show India VIX Supertrend Strip', group = VIX_GROUP, tooltip = 'Thin strip at the bottom of the main chart.\nGreen = VIX Supertrend positive (uptrend)\nRed = VIX Supertrend negative (downtrend)\nSwap the two colors below to reverse the meaning.')
vixSymbol   = input.string('NSE:INDIAVIX', 'VIX Symbol', group = VIX_GROUP, tooltip = 'Symbol the Supertrend is calculated on, e.g. NSE:INDIAVIX', display = display.none)
vixLength   = input.int(10, 'VIX Supertrend ATR Length', group = VIX_GROUP, minval = 1, display = display.none)
vixFactor   = input.float(3.0, 'VIX Supertrend Factor', group = VIX_GROUP, minval = 0.1, step = 0.1, display = display.none)
vixPosColor = input.color(color.green, 'Positive Color (VIX Supertrend up)', group = VIX_GROUP)
vixNegColor = input.color(color.red, 'Negative Color (VIX Supertrend down)', group = VIX_GROUP)

// ---------------------------------------------------------------------------
// INPUTS - MARKET STRUCTURE (HH / HL / LH / LL + support / resistance)
// ---------------------------------------------------------------------------
lb               = input.int(5,  "Left Bars",  minval = 1, group = MS_GROUP, display = display.none, tooltip = "Bars to the LEFT of a pivot. Higher values produce fewer but stronger pivots.")
rb               = input.int(5,  "Right Bars", minval = 1, group = MS_GROUP, display = display.none, tooltip = "Bars to the RIGHT of a pivot (confirmation window).")

showStruct       = input.bool(true, "Show HH/HL/LH/LL Labels", group = MS_GROUP)
showSR           = input.bool(true, "Show Support/Resistance", group = MS_GROUP, tooltip = "Draw segmented support/resistance lines that end on change and extend to the right.")
srLineStyleStr   = input.string("Dotted", "S/R Line Style", options = ["Solid", "Dashed", "Dotted"], group = MS_GROUP, display = display.none, tooltip = "Line style for segmented support/resistance lines.")
srLineWidth      = input.int(3, "S/R Line Width", minval = 1, maxval = 5, group = MS_GROUP, display = display.none, tooltip = "Line width for segmented support/resistance lines.")
supColor         = input.color(color.blue, "Support Color", group = MS_GROUP, tooltip = "Color for support segments.")
resColor         = input.color(color.red,  "Resistance Color", group = MS_GROUP, tooltip = "Color for resistance segments.")

labelSizeStr     = input.string("Tiny", "Label Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = MS_GROUP, display = display.none, tooltip = "Size of HH/HL/LH/LL labels.")
labelSize        = labelSizeStr == "Tiny" ? size.tiny : labelSizeStr == "Small" ? size.small : labelSizeStr == "Normal" ? size.normal : labelSizeStr == "Large" ? size.large : size.huge

// Per-label colors
hlBg = input.color(color.purple, "HL Background", inline = "hlc", group = MS_GROUP, tooltip = "Background color for Higher Low labels.")
hlTx = input.color(color.black,  "HL Text",       inline = "hlc", group = MS_GROUP, tooltip = "Text color for Higher Low labels.")
hhBg = input.color(color.yellow, "HH Background", inline = "hhc", group = MS_GROUP, tooltip = "Background color for Higher High labels.")
hhTx = input.color(color.black,  "HH Text",       inline = "hhc", group = MS_GROUP, tooltip = "Text color for Higher High labels.")
llBg = input.color(color.red,    "LL Background", inline = "llc", group = MS_GROUP, tooltip = "Background color for Lower Low labels.")
llTx = input.color(color.black,  "LL Text",       inline = "llc", group = MS_GROUP, tooltip = "Text color for Lower Low labels.")
lhBg = input.color(color.orange, "LH Background", inline = "lhc", group = MS_GROUP, tooltip = "Background color for Lower High labels.")
lhTx = input.color(color.black,  "LH Text",       inline = "lhc", group = MS_GROUP, tooltip = "Text color for Lower High labels.")

// Options that affect only specific parts
keepInsidePivots  = input.bool(true,  "Keep inside counter-trend pivots", group = MS_GROUP, tooltip = "Affects ONLY S/R backbone (not labels).")
countEqualAsBreak = input.bool(false, "Count equal as break (<= for LL, >= for HH)", group = MS_GROUP, tooltip = "If ON, equal lows count as LL and equal highs count as HH.")
showDebug         = input.bool(false, "Show debug labels (values & deltas)", group = MS_GROUP, tooltip = "Prints current vs. previous pivot values on the pivot bar.")

// ---------------------------------------------------------------------------
// INPUTS - RSI DOTS (also drives the RSI pane)
// ---------------------------------------------------------------------------
showDots     = input.bool(true, 'Show Mid-Level Dots', group = DOT_GROUP)
signalInput  = input.string(RSI_RAW, 'Dot Signal Based On', group = DOT_GROUP, options = [RSI_RAW, RSI_SMA], tooltip = 'RSI = raw RSI value\nRSI SMA = smoothed RSI (uses the Smoothing type below, SMA by default)')
rsiLength    = input.int(10, 'RSI Length', group = DOT_GROUP, minval = 1)
smaLength    = input.int(14, 'RSI SMA Length', group = DOT_GROUP, minval = 1, tooltip = 'Length of the smoothing line plotted on the RSI and used for the RSI SMA dot signal')
rsiSource    = input.source(close, 'RSI Source', group = DOT_GROUP)
midLevel     = input.float(50, 'Dot Level (mid line)', group = DOT_GROUP, minval = 0, maxval = 100)
buyDotColor  = input.color(color.green, 'Buy Zone Dot Color', group = DOT_GROUP)
sellDotColor = input.color(color.red, 'Sell Zone Dot Color', group = DOT_GROUP)

// ---------------------------------------------------------------------------
// INPUTS - RSI PANE
// ---------------------------------------------------------------------------
calculateDivergence = input.bool(false, title = 'Calculate Divergence', group = RSI_GROUP, display = display.none, tooltip = 'Calculating divergences is needed in order for divergence alerts to fire.')

TT_BB = "Only applies when 'SMA + Bollinger Bands' is selected. Determines the distance between the SMA and the bands."
maTypeInput = input.string('SMA', 'Type', options = ['None', 'SMA', 'SMA + Bollinger Bands', 'EMA', 'SMMA (RMA)', 'WMA', 'VWMA'], group = SMOOTH_GROUP, display = display.none)
var isBB = maTypeInput == 'SMA + Bollinger Bands'
bbMultInput = input.float(2.0, 'BB StdDev', minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = SMOOTH_GROUP, display = display.none, active = isBB)
var enableMA = maTypeInput != 'None'

// ---------------------------------------------------------------------------
// RSI CALCULATION
// ---------------------------------------------------------------------------
change = ta.change(rsiSource)
up = ta.rma(math.max(change, 0), rsiLength)
down = ta.rma(-math.min(change, 0), rsiLength)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - 100 / (1 + up / down)

ma(source, length, MAtype) =>
    switch MAtype
        'SMA' => ta.sma(source, length)
        'SMA + Bollinger Bands' => ta.sma(source, length)
        'EMA' => ta.ema(source, length)
        'SMMA (RMA)' => ta.rma(source, length)
        'WMA' => ta.wma(source, length)
        'VWMA' => ta.vwma(source, length)

// Smoothed RSI (plotted as the yellow line, and used for the "RSI SMA" dot signal)
smoothingMA = enableMA ? ma(rsi, smaLength, maTypeInput) : na
smoothingStDev = isBB ? ta.stdev(rsi, smaLength) * bbMultInput : na
rsiSma = enableMA ? smoothingMA : ta.sma(rsi, smaLength)

// ---------------------------------------------------------------------------
// SUPERTREND ZONES
// ---------------------------------------------------------------------------
[stValue, stDirection] = ta.supertrend(stFactor, stLength)

// direction < 0 = uptrend (buy zone), direction > 0 = downtrend (sell zone)
inBuyZone  = stDirection < 0
inSellZone = stDirection > 0

buyStart  = inBuyZone and not inBuyZone[1]
sellStart = inSellZone and not inSellZone[1]

// ---------------------------------------------------------------------------
// INDIA VIX SUPERTREND
// ---------------------------------------------------------------------------
// The Supertrend is calculated on the VIX symbol itself (not on the chart symbol)
// and brought onto the chart with request.security on the same timeframe.
// direction < 0 = VIX Supertrend positive (uptrend), direction > 0 = negative (downtrend)
vixTrend() =>
    [_, direction] = ta.supertrend(vixFactor, vixLength)
    direction

vixDirection = request.security(vixSymbol, timeframe.period, vixTrend())
vixPositive  = vixDirection < 0

// ---------------------------------------------------------------------------
// DOT LOGIC
// ---------------------------------------------------------------------------
signalValue = signalInput == RSI_SMA ? rsiSma : rsi

// buy zone -> cross UP mid level (green, below candle); sell zone -> cross DOWN mid level (red, above candle)
crossUpMid   = ta.crossover(signalValue, midLevel)
crossDownMid = ta.crossunder(signalValue, midLevel)

buyDot  = inBuyZone and crossUpMid
sellDot = inSellZone and crossDownMid

// ---------------------------------------------------------------------------
// PLOTS - MAIN CHART (force_overlay)
// ---------------------------------------------------------------------------
bgcolor(inBuyZone ? buyColor : inSellZone ? sellColor : na, title = 'Zone Background', force_overlay = true)

plot(showLine ? stValue : na, 'Supertrend', color = inBuyZone ? color.green : color.red, linewidth = 1, force_overlay = true)

plotshape(showLabels and buyStart, 'Buy Zone Start', shape.triangleup, location.belowbar, color.green, size = size.tiny, text = 'BUY', textcolor = color.green, force_overlay = true)
plotshape(showLabels and sellStart, 'Sell Zone Start', shape.triangledown, location.abovebar, color.red, size = size.tiny, text = 'SELL', textcolor = color.red, force_overlay = true)

plotshape(showDots and buyDot, 'Green Dot (buy zone)', shape.circle, location.belowbar, buyDotColor, size = size.tiny, force_overlay = true)
plotshape(showDots and sellDot, 'Red Dot (sell zone)', shape.circle, location.abovebar, sellDotColor, size = size.tiny, force_overlay = true)

// India VIX Supertrend strip: one square per bar pinned to the bottom of the main chart.
// On dense charts (e.g. 1-minute) the squares overlap, so it reads as one continuous bar.
// Change size.small to size.tiny / size.normal / size.large for a thinner or thicker strip.
plotshape(showVix and not na(vixDirection), 'India VIX Supertrend Strip', shape.square, location.bottom, vixPositive ? vixPosColor : vixNegColor, size = size.small, force_overlay = true)

// ---------------------------------------------------------------------------
// PLOTS - RSI PANE
// ---------------------------------------------------------------------------
rsiPlot = plot(rsi, 'RSI', color = #7E57C2)
rsiUpperBand = hline(70, 'RSI Upper Band', color = #787B86)
midline = hline(50, 'RSI Middle Band', color = color.new(#787B86, 50))
rsiLowerBand = hline(30, 'RSI Lower Band', color = #787B86)
fill(rsiUpperBand, rsiLowerBand, color = color.rgb(126, 87, 194, 90), title = 'RSI Background Fill')
midLinePlot = plot(50, color = na, editable = false, display = display.none)
fill(rsiPlot, midLinePlot, 100, 70, top_color = color.new(color.green, 0), bottom_color = color.new(color.green, 100), title = 'Overbought Gradient Fill')
fill(rsiPlot, midLinePlot, 30, 0, top_color = color.new(color.red, 100), bottom_color = color.new(color.red, 0), title = 'Oversold Gradient Fill')

plot(smoothingMA, 'RSI-based MA', color = color.yellow, display = enableMA ? display.all : display.none, editable = enableMA)
bbUpperBand = plot(smoothingMA + smoothingStDev, title = 'Upper Bollinger Band', color = color.green, display = isBB ? display.all : display.none, editable = isBB)
bbLowerBand = plot(smoothingMA - smoothingStDev, title = 'Lower Bollinger Band', color = color.green, display = isBB ? display.all : display.none, editable = isBB)
fill(bbUpperBand, bbLowerBand, color = isBB ? color.new(color.green, 90) : na, title = 'Bollinger Bands Background Fill', display = isBB ? display.all : display.none, editable = isBB)

// ---------------------------------------------------------------------------
// DIVERGENCE
// ---------------------------------------------------------------------------
lookbackRight = 5
lookbackLeft = 5
rangeUpper = 60
rangeLower = 5
bearColor = color.red
bullColor = color.green
textColor = color.white
noneColor = color.new(color.white, 100)

_inRange(bool cond) =>
    bars = ta.barssince(cond)
    rangeLower <= bars and bars <= rangeUpper

plFound = false
phFound = false

bullCond = false
bearCond = false

rsiLBR = rsi[lookbackRight]

// evaluated on every bar (not inside the if / and) so ta.barssince stays consistent
inRangePl = _inRange(plFound[1])
inRangePh = _inRange(phFound[1])

if calculateDivergence
    // Regular Bullish: RSI higher low, price lower low
    plFound := not na(ta.pivotlow(rsi, lookbackLeft, lookbackRight))
    rsiHL = rsiLBR > ta.valuewhen(plFound, rsiLBR, 1) and inRangePl
    lowLBR = low[lookbackRight]
    priceLL = lowLBR < ta.valuewhen(plFound, lowLBR, 1)
    bullCond := priceLL and rsiHL and plFound

    // Regular Bearish: RSI lower high, price higher high
    phFound := not na(ta.pivothigh(rsi, lookbackLeft, lookbackRight))
    rsiLH = rsiLBR < ta.valuewhen(phFound, rsiLBR, 1) and inRangePh
    highLBR = high[lookbackRight]
    priceHH = highLBR > ta.valuewhen(phFound, highLBR, 1)
    bearCond := priceHH and rsiLH and phFound

plot(plFound ? rsiLBR : na, offset = -lookbackRight, title = 'Regular Bullish', linewidth = 2, color = bullCond ? bullColor : noneColor, display = display.pane, editable = calculateDivergence)

plotshape(bullCond ? rsiLBR : na, offset = -lookbackRight, title = 'Regular Bullish Label', text = ' Bull ', style = shape.labelup, location = location.absolute, color = bullColor, textcolor = textColor, display = display.pane, editable = calculateDivergence)

plot(phFound ? rsiLBR : na, offset = -lookbackRight, title = 'Regular Bearish', linewidth = 2, color = bearCond ? bearColor : noneColor, display = display.pane, editable = calculateDivergence)

plotshape(bearCond ? rsiLBR : na, offset = -lookbackRight, title = 'Regular Bearish Label', text = ' Bear ', style = shape.labeldown, location = location.absolute, color = bearColor, textcolor = textColor, display = display.pane, editable = calculateDivergence)

// ---------------------------------------------------------------------------
// ALERTS
// ---------------------------------------------------------------------------
alertcondition(buyStart, 'Buying Zone Started', 'Supertrend buying zone started')
alertcondition(sellStart, 'Selling Zone Started', 'Supertrend selling zone started')
alertcondition(buyDot, 'Green Dot', 'Buy zone: RSI crossed up mid level')
alertcondition(sellDot, 'Red Dot', 'Sell zone: RSI crossed down mid level')
alertcondition(bullCond, title = 'Regular Bullish Divergence', message = 'Found a new Regular Bullish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar.')
alertcondition(bearCond, title = 'Regular Bearish Divergence', message = 'Found a new Regular Bearish Divergence, `Pivot Lookback Right` number of bars to the left of the current bar.')

// ---------------------------------------------------------------------------
// MARKET STRUCTURE (HH / HL / LH / LL labels + dynamic support / resistance)
// Adapted from "Higher High Lower Low" by Phanchai. Labels and lines are drawn
// on the main chart using force_overlay = true.
// ---------------------------------------------------------------------------

// Map style
srLineStyle = srLineStyleStr == "Solid" ? line.style_solid : srLineStyleStr == "Dashed" ? line.style_dashed : line.style_dotted

// === Confirmed pivots (appear on THIS bar after rb bars) ===
ph = ta.pivothigh(lb, rb)    // series float (pivot high price) or na
pl = ta.pivotlow(lb, rb)     // series float (pivot low price)  or na

// === STRICT labels: compare in TICKS to avoid float/rounding issues ===
toTicks(x) =>
    // convert price to integer number of ticks
    int(math.round(nz(x) / syminfo.mintick))

prevPl = ta.valuewhen(not na(pl), pl, 1)
prevPh = ta.valuewhen(not na(ph), ph, 1)

curLowT   = toTicks(pl)
prevLowT  = toTicks(prevPl)
curHighT  = toTicks(ph)
prevHighT = toTicks(prevPh)

isLL = not na(pl) and not na(prevPl) and (countEqualAsBreak ? curLowT <= prevLowT : curLowT < prevLowT)
isHL = not na(pl) and (na(prevPl) or not isLL)

isHH = not na(ph) and not na(prevPh) and (countEqualAsBreak ? curHighT >= prevHighT : curHighT > prevHighT)
isLH = not na(ph) and (na(prevPh) or not isHH)

// === Labels (placed at the pivot bar: x = bar_index - rb) ===
if showStruct and isHL
    label.new(bar_index - rb, pl, xloc = xloc.bar_index, yloc = yloc.belowbar, text = "HL", tooltip = "Higher Low — Price: " + str.tostring(pl, format.mintick), style = label.style_label_up, color = hlBg, textcolor = hlTx, size = labelSize, force_overlay = true)
if showStruct and isHH
    label.new(bar_index - rb, ph, xloc = xloc.bar_index, yloc = yloc.abovebar, text = "HH", tooltip = "Higher High — Price: " + str.tostring(ph, format.mintick), style = label.style_label_down, color = hhBg, textcolor = hhTx, size = labelSize, force_overlay = true)
if showStruct and isLL
    label.new(bar_index - rb, pl, xloc = xloc.bar_index, yloc = yloc.belowbar, text = "LL", tooltip = "Lower Low — Price: " + str.tostring(pl, format.mintick), style = label.style_label_up, color = llBg, textcolor = llTx, size = labelSize, force_overlay = true)
if showStruct and isLH
    label.new(bar_index - rb, ph, xloc = xloc.bar_index, yloc = yloc.abovebar, text = "LH", tooltip = "Lower High — Price: " + str.tostring(ph, format.mintick), style = label.style_label_down, color = lhBg, textcolor = lhTx, size = labelSize, force_overlay = true)

// === Debug (optional) ===
if showDebug and not na(pl)
    label.new(bar_index - rb, pl, xloc = xloc.bar_index, yloc = yloc.belowbar, text = "LOW\ncur: " + str.tostring(pl) + "\nprev: " + str.tostring(prevPl) + "\ncurT: " + str.tostring(curLowT) + "  prevT: " + str.tostring(prevLowT), style = label.style_label_left, color = color.new(color.gray, 85), textcolor = color.black, size = size.tiny, force_overlay = true)
if showDebug and not na(ph)
    label.new(bar_index - rb, ph, xloc = xloc.bar_index, yloc = yloc.abovebar, text = "HIGH\ncur: " + str.tostring(ph) + "\nprev: " + str.tostring(prevPh) + "\ncurT: " + str.tostring(curHighT) + "  prevT: " + str.tostring(prevHighT), style = label.style_label_left, color = color.new(color.gray, 85), textcolor = color.black, size = size.tiny, force_overlay = true)

// === Backbone for S/R (independent of label logic) ===
hlFlag = not na(ph) ? 1 : (not na(pl) ? -1 : na)
zz = not na(ph) ? ph : (not na(pl) ? pl : na)

// Optional cleanup (backbone only)
zz := (not keepInsidePivots and not na(pl) and hlFlag == -1 and ta.valuewhen(hlFlag != 0, hlFlag, 1) == -1 and pl > ta.valuewhen(not na(zz), zz, 1)) ? na : zz
zz := (not keepInsidePivots and not na(ph) and hlFlag == 1 and ta.valuewhen(hlFlag != 0, hlFlag, 1) == 1 and ph < ta.valuewhen(not na(zz), zz, 1)) ? na : zz

// Keep hlFlag consistent
hlFlag := hlFlag == -1 and ta.valuewhen(hlFlag != 0, hlFlag, 1) == 1 and zz > ta.valuewhen(not na(zz), zz, 1) ? na : hlFlag
hlFlag := hlFlag == 1 and ta.valuewhen(hlFlag != 0, hlFlag, 1) == -1 and zz < ta.valuewhen(not na(zz), zz, 1) ? na : hlFlag
zz := na(hlFlag) ? na : zz

// Previous backbone pivots (for S/R only)
findprevious() =>
    ehl = hlFlag == 1 ? -1 : 1
    loc1 = 0.0, loc2 = 0.0, loc3 = 0.0, loc4 = 0.0, xx = 0
    for x = 1 to 1000
        if hlFlag[x] == ehl and not na(zz[x])
            loc1 := zz[x], xx := x + 1, break
    ehl := hlFlag
    for x = xx to 1000
        if hlFlag[x] == ehl and not na(zz[x])
            loc2 := zz[x], xx := x + 1, break
    ehl := hlFlag == 1 ? -1 : 1
    for x = xx to 1000
        if hlFlag[x] == ehl and not na(zz[x])
            loc3 := zz[x], xx := x + 1, break
    ehl := hlFlag
    for x = xx to 1000
        if hlFlag[x] == ehl and not na(zz[x])
            loc4 := zz[x], break
    [loc1, loc2, loc3, loc4]

float a = na
float b = na
float c = na
float d = na
float e = na
if not na(hlFlag)
    [l1, l2, l3, l4] = findprevious()
    a := zz
    b := l1
    c := l2
    d := l3
    e := l4

// Raw structure (for S/R)
isHH_raw = not na(zz) and (a > b and a > c and c > b and c > d)
isLL_raw = not na(zz) and (a < b and a < c and c < b and c < d)
isHL_raw = not na(zz) and ((a >= c and (b > c and b > d and d > c and d > e)) or (a < b and a > c and b < d))
isLH_raw = not na(zz) and ((a <= c and (b < c and b < d and d < c and d < e)) or (a > b and a < c and b > d))

// === Dynamic S/R drawing ===
float res = na
float sup = na
res := isLH_raw ? zz : res[1]
sup := isHL_raw ? zz : sup[1]
int trend = na
trend := close > res ? 1 : (close < sup ? -1 : nz(trend[1]))
res := ((trend == 1 and isHH_raw) or (trend == -1 and isLH_raw)) ? zz : res
sup := ((trend == 1 and isHL_raw) or (trend == -1 and isLL_raw)) ? zz : sup
rechange = res != res[1]
suchange = sup != sup[1]

// draw lines
var line resLine = na
var line supLine = na
if showSR
    if rechange and not na(res)
        if not na(resLine)
            line.set_x2(resLine, bar_index), line.set_extend(resLine, extend.none)
        resLine := line.new(bar_index - rb, res, bar_index, res, xloc = xloc.bar_index, extend = extend.right, style = srLineStyle, width = srLineWidth, color = resColor, force_overlay = true)
    if suchange and not na(sup)
        if not na(supLine)
            line.set_x2(supLine, bar_index), line.set_extend(supLine, extend.none)
        supLine := line.new(bar_index - rb, sup, bar_index, sup, xloc = xloc.bar_index, extend = extend.right, style = srLineStyle, width = srLineWidth, color = supColor, force_overlay = true)

// === Alerts (built from STRICT labels) ===
var string lastLabelType = ""  // "HH","HL","LL","LH"
firstLLafterBull = isLL and (lastLabelType == "HL" or lastLabelType == "HH")
firstHHafterBear = isHH and (lastLabelType == "LL" or lastLabelType == "LH")
anyLabelFormed   = isHL or isHH or isLL or isLH
lowSideFormed    = isLL or isHL
highSideFormed   = isLH or isHH

alertcondition(anyLabelFormed,   title = "Any structure label (HH/HL/LH/LL)", message = "Structure pivot detected (HH/HL/LH/LL) on {{ticker}} {{interval}}.")
alertcondition(firstLLafterBull, title = "First LL after HL/HH",              message = "First Lower Low after HL or HH on {{ticker}} {{interval}}.")
alertcondition(firstHHafterBear, title = "First HH after LL/LH",              message = "First Higher High after LL or LH on {{ticker}} {{interval}}.")
alertcondition(lowSideFormed,    title = "LL or HL formed",                   message = "LL or HL formed on {{ticker}} {{interval}}.")
alertcondition(highSideFormed,   title = "LH or HH formed",                   message = "LH or HH formed on {{ticker}} {{interval}}.")
alertcondition(isHL,             title = "HL formed",                         message = "Higher Low (HL) formed on {{ticker}} {{interval}}.")
alertcondition(isHH,             title = "HH formed",                         message = "Higher High (HH) formed on {{ticker}} {{interval}}.")
alertcondition(isLL,             title = "LL formed",                         message = "Lower Low (LL) formed on {{ticker}} {{interval}}.")
alertcondition(isLH,             title = "LH formed",                         message = "Lower High (LH) formed on {{ticker}} {{interval}}.")

// remember last label type
if isHH
    lastLabelType := "HH"
else if isLH
    lastLabelType := "LH"
else if isHL
    lastLabelType := "HL"
else if isLL
    lastLabelType := "LL"
