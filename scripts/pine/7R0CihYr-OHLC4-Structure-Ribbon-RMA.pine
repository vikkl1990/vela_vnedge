string in_tableMode = input.string(SHOW, "Context Table", options=[SHOW, HIDE], group=G_TABLE, tooltip=TT_TABLE)
bool showContextTable = in_tableMode == SHOW
string in_tableSizeStr = input.string("Large", "  ↳ Table Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=G_TABLE, active=showContextTable)
string in_tablePositionStr = input.string("Top Right", "  ↳ Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=G_TABLE, active=showContextTable)
int in_tableCellWidth = input.int(10, "  ↳ Cell Width", minval=0, maxval=100, group=G_TABLE, active=showContextTable)

// ──────────────────────────────────────────────
// 🟦 Subregion: OHLC Crossover Labels
// ──────────────────────────────────────────────

// 🔹 Master gate + fast / structural / long OHLC pairs; placement is intentionally fixed
string in_crossMode = input.string(SHOW, "Crossover Labels", options=[SHOW, HIDE], group=G_CROSS, tooltip=TT_CROSS)
bool showCrossLabels = in_crossMode == SHOW

string in_ohlc58CrossMode = input.string(SHOW, "5/8 OHLC Cross", options=[SHOW, HIDE], group=G_CROSS, active=showCrossLabels)
bool showOhlc58Cross = showCrossLabels and in_ohlc58CrossMode == SHOW
int in_ohlc58CrossLastN = input.int(144, "  ↳ 5/8 Last N Bars", minval=1, maxval=500, group=G_CROSS, active=showOhlc58Cross)

string in_ohlc820CrossMode = input.string(SHOW, "8/20 OHLC Cross", options=[SHOW, HIDE], group=G_CROSS, active=showCrossLabels)
bool showOhlc820Cross = showCrossLabels and in_ohlc820CrossMode == SHOW
int in_ohlc820CrossLastN = input.int(144, "  ↳ 8/20 Last N Bars", minval=1, maxval=500, group=G_CROSS, active=showOhlc820Cross)

string in_ohlc1334CrossMode = input.string(SHOW, "13/34 OHLC Cross", options=[SHOW, HIDE], group=G_CROSS, active=showCrossLabels)
bool showOhlc1334Cross = showCrossLabels and in_ohlc1334CrossMode == SHOW
int in_ohlc1334CrossLastN = input.int(144, "  ↳ 13/34 Last N Bars", minval=1, maxval=500, group=G_CROSS, active=showOhlc1334Cross)

string in_ohlc2050CrossMode = input.string(SHOW, "20/50 OHLC Cross", options=[SHOW, HIDE], group=G_CROSS, active=showCrossLabels)
bool showOhlc2050Cross = showCrossLabels and in_ohlc2050CrossMode == SHOW
int in_ohlc2050CrossLastN = input.int(144, "  ↳ 20/50 Last N Bars", minval=1, maxval=500, group=G_CROSS, active=showOhlc2050Cross)

string in_ohlc75110CrossMode = input.string(SHOW, "75/110 OHLC Cross", options=[SHOW, HIDE], group=G_CROSS, active=showCrossLabels)
bool showOhlc75110Cross = showCrossLabels and in_ohlc75110CrossMode == SHOW
int in_ohlc75110CrossLastN = input.int(144, "  ↳ 75/110 Last N Bars", minval=1, maxval=500, group=G_CROSS, active=showOhlc75110Cross)

string in_crossLabelSize = input.string("Normal", "Cross Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=G_CROSS, active=showCrossLabels)

