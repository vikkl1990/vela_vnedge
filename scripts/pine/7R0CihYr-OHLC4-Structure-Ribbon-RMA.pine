// ==============================================================================================
// 🟢 REGION: Inputs
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Ribbon Display
// ──────────────────────────────────────────────

// 🔹 Main 5/8/13/20/34/50 OHLC ribbon presentation
string in_ribbonMode = input.string(SHOW, "Ribbon", options=[SHOW, HIDE], group=G_VIS, tooltip=TT_RIBBON)
bool showRibbon = in_ribbonMode == SHOW
int in_ribbonLastN = input.int(233, "  ↳ Ribbon Last N Bars", minval=1, maxval=5000, group=G_VIS, active=showRibbon)
string in_ribbonColorEngine = input.string("Gradient", "  ↳ Ribbon Color Engine", options=["Gradient", "Global Regime"], group=G_VIS, active=showRibbon, tooltip=TT_RIBBON_COLOR)
bool useRibbonGradient = in_ribbonColorEngine == "Gradient"
int in_ribbonBrightness = input.int(5, "    ↳ Gradient Brightness +", minval=0, maxval=20, group=G_VIS, active=showRibbon and useRibbonGradient)
color in_ribbonChartBg = input.color(#0e0e0e, "    ↳ Chart Background Match", group=G_VIS, active=showRibbon and useRibbonGradient)
string in_lineMode = input.string("Hide Lines", "  ↳ OHLC Boundary Lines", options=["Inner Crossover Only", "Inner Line", "Outer Line", "Both", "Hide Lines"], group=G_VIS, active=showRibbon)
int in_lineTransp = input.int(0, "    ↳ Line Transparency", minval=0, maxval=100, group=G_VIS, active=showRibbon and in_lineMode != "Hide Lines")
int in_lineWidth = input.int(3, "    ↳ Line Width", minval=1, maxval=5, group=G_VIS, active=showRibbon and in_lineMode != "Hide Lines")
color in_fastLineColor = input.color(#2b38ff, "    ↳ OHLC5 Line", group=G_VIS, active=showRibbon and in_lineMode != "Hide Lines")
color in_slowLineColor = input.color(#d7d7d7, "    ↳ OHLC50 Line", group=G_VIS, active=showRibbon and in_lineMode != "Hide Lines")

// ──────────────────────────────────────────────
// 🟦 Subregion: PlotCandles
// ──────────────────────────────────────────────

// 🔹 Regime-colored candle overlay with independent body / wick / border transparency
string in_candleMode = input.string(SHOW, "PlotCandles", options=[SHOW, HIDE], group=G_CANDLES, tooltip=TT_PLOT_CANDLES)
bool showCandles = in_candleMode == SHOW
int in_candleLastN = input.int(233, "  ↳ Candle Last N Bars", minval=1, maxval=5000, group=G_CANDLES, active=showCandles)
int in_candleBodyTransp = input.int(70, "  ↳ Body Transparency", minval=0, maxval=100, group=G_CANDLES, active=showCandles)
int in_candleWickTransp = input.int(0, "  ↳ Wick Transparency", minval=0, maxval=100, group=G_CANDLES, active=showCandles)
int in_candleBorderTransp = input.int(0, "  ↳ Border Transparency", minval=0, maxval=100, group=G_CANDLES, active=showCandles)

// ──────────────────────────────────────────────
// 🟦 Subregion: Canonical Regime Colors
// ──────────────────────────────────────────────

// 🔹 Same active global-regime palette used by the EMA Ribbon
color in_colBullTrend = input.color(#ffb000, "Bull Rise", group=G_COLORS)
color in_colBearTrend = input.color(#f51673, "Bear Fall", group=G_COLORS)
color in_colBullResistance = input.color(color.rgb(135, 135, 135), "Bull Resistance / Compression", group=G_COLORS)
color in_colBearSupport = input.color(color.rgb(44, 161, 190), "Bear Support / Compression", group=G_COLORS)
color in_colExtremeTop = input.color(#ff8400, "Top Extreme", group=G_COLORS)
color in_colExtremeBot = input.color(color.rgb(157, 78, 221), "Bottom Extreme", group=G_COLORS)
color in_colExceptionalTop = input.color(color.rgb(255, 94, 0), "Top Exceptional", group=G_COLORS)
color in_colExceptionalBot = input.color(color.rgb(89, 40, 169), "Bottom Exceptional", group=G_COLORS)

// ──────────────────────────────────────────────
// 🟦 Subregion: Global Right-Side Label Formatting
// ──────────────────────────────────────────────

// 🔹 MF defaults: SHOW / Individual / 6 first / 4 between
string in_rightLabelMode = input.string(SHOW, "Right Side Labels", options=[SHOW, HIDE], group=G_LABELS, tooltip=TT_RIGHT_LABELS)
bool showRightLabels = in_rightLabelMode == SHOW
string in_rightLabelPaddingMode = input.string(LABEL_PADDING_INDIVIDUAL, "Label Padding Mode", options=[LABEL_PADDING_GROUPED, LABEL_PADDING_INDIVIDUAL], group=G_LABELS, active=showRightLabels, tooltip=TT_RIGHT_LABEL_PADDING)
int in_rightLabelBasePad = input.int(6, "First Label Padding", minval=0, maxval=200, group=G_LABELS, active=showRightLabels)
int in_rightLabelPadStep = input.int(4, "Padding Between Labels", minval=1, maxval=40, group=G_LABELS, active=showRightLabels)
bool useGroupedRightLabelPadding = in_rightLabelPaddingMode == LABEL_PADDING_GROUPED

// 🔹 MF dollar / percent row defaults
string in_rightLabelChangeLayout = input.string(CHANGE_LAYOUT_ROWS, "Dollar / % Layout", options=[CHANGE_LAYOUT_ROWS, CHANGE_LAYOUT_INLINE], group=G_LABELS, active=showRightLabels, tooltip=TT_RIGHT_LABEL_LAYOUT)
string in_rightLabelDollarSignMode = input.string(SHOW, "Dollar Sign in Right Labels", options=[SHOW, HIDE], group=G_LABELS, active=showRightLabels)
bool showRightLabelDollarSign = in_rightLabelDollarSignMode == SHOW
string in_rightLabelSize = input.string("Normal", "Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=G_LABELS, active=showRightLabels)
int in_shortLabelBrightness = input.int(60, "Short Label Brightness +", minval=0, maxval=60, step=1, group=G_LABELS, active=showRightLabels and useRibbonGradient)

// 🔹 Individual OHLC label visibility — all eight enabled for the first visual pass
bool in_showOhlc5Label = input.bool(true, "  ↳ OHLC5", group=G_LABELS, active=showRightLabels)
bool in_showOhlc8Label = input.bool(true, "  ↳ OHLC8", group=G_LABELS, active=showRightLabels)
bool in_showOhlc13Label = input.bool(true, "  ↳ OHLC13", group=G_LABELS, active=showRightLabels)
bool in_showOhlc20Label = input.bool(true, "  ↳ OHLC20", group=G_LABELS, active=showRightLabels)
bool in_showOhlc34Label = input.bool(true, "  ↳ OHLC34", group=G_LABELS, active=showRightLabels)
bool in_showOhlc50Label = input.bool(true, "  ↳ OHLC50", group=G_LABELS, active=showRightLabels)
bool in_showOhlc75Label = input.bool(true, "  ↳ OHLC75", group=G_LABELS, active=showRightLabels)
bool in_showOhlc110Label = input.bool(true, "  ↳ OHLC110", group=G_LABELS, active=showRightLabels)

// 🔹 Short-label color is owned directly by the active Global Regime; no duplicate label palette

// ──────────────────────────────────────────────
// 🟦 Subregion: Long Structural OHLC Plots
// ──────────────────────────────────────────────

// 🔹 Separate 75/110 structural pair; intentionally excluded from the six-average ribbon regime engine
string in_longStructMode = input.string(SHOW, "Long Structural OHLC", options=[SHOW, HIDE], group=G_LONG, tooltip=TT_LONG_STRUCT)
bool showLongStruct = in_longStructMode == SHOW
string in_longStructPlotMode = input.string(SHOW, "  ↳ 75/110 Plots", options=[SHOW, HIDE], group=G_LONG, active=showLongStruct)
bool showLongStructPlots = showLongStruct and in_longStructPlotMode == SHOW
