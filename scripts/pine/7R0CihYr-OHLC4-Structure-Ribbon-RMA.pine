int in_longStructPlotWidth = input.int(1, "    ↳ Plot Width", minval=1, maxval=5, group=G_LONG, active=showAnyLongStructPlot)
int in_longStructPlotTransp = input.int(25, "    ↳ Plot Transparency", minval=0, maxval=100, group=G_LONG, active=showAnyLongStructPlot)

