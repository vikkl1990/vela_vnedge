bool in_showOhlc110Plot = input.bool(true, "    ↳ OHLC110", group=G_LONG, active=showLongStructPlots)
bool showAnyLongStructPlot = showLongStructPlots and (in_showOhlc75Plot or in_showOhlc110Plot)
