//@version=6
indicator("RSI Prediction by Range Segmentation [LuxAlgo]", "LuxAlgo - RSI Prediction", overlay = false, max_lines_count = 500, max_polylines_count = 100)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
string COLOR_GROUP = "Colors"
string LEVEL_GROUP = "Levels"

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
int   limitInput     = input.int(200, "Historical Limit", minval = 10, group = "General Settings", tooltip = "Number of historical segments to store per range.")
int   lengthInput    = input.int(100, "Forecast Length", minval = 1, group = "General Settings", tooltip = "The length of the RSI prediction.")
int   rangesInput    = input.int(10, "Range Segments", minval = 2, group = "General Settings", tooltip = "Number of divisions for the RSI range (0-100).")
int   rsiLengthInput = input.int(14, "RSI Length", minval = 1, group = "General Settings")

float obLevelInput   = input.float(70.0, "Overbought Level", minval = 50, maxval = 100, group = LEVEL_GROUP)
float osLevelInput   = input.float(30.0, "Oversold Level",   minval = 0,  maxval = 50,  group = LEVEL_GROUP)

color bullColorInput  = input.color(BULL_COLOR, "Bullish Color", group = COLOR_GROUP)
color bearColorInput  = input.color(BEAR_COLOR, "Bearish Color", group = COLOR_GROUP)
color levelColorInput = input.color(color.new(color.gray, 50), "Level Color",   group = COLOR_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// Types, Methods & Functions
//---------------------------------------------------------------------------------------------------------------------{
// @function Clamps an integer between a lower and upper bound
clamp(int val, int lower, int upper) => 
    math.max(lower, math.min(upper, val))

// @type Segment Holds a series of historical RSI values
type Segment
    float[] values

// @type RangeData Holds a collection of historical segments for a specific RSI range
type RangeData
    array<Segment> history

// @function Adds a new segment to the history and maintains the limit
method addSegment(RangeData self, Segment segment) =>
    self.history.unshift(segment)
    if self.history.size() > limitInput
        self.history.pop()

// @function Calculates points for the forecast based on historical averages
method forecast(RangeData self, float currentRsi) =>
    array<chart.point> points = array.new<chart.point>()
    points.push(chart.point.from_index(bar_index, currentRsi))
    
    float lastAvg = currentRsi
    if self.history.size() > 0
        for i = 1 to lengthInput - 1
            float sum = 0.0
            int count = 0
            
            for segment in self.history
                if segment.values.size() > i
                    sum += segment.values.get(i)
                    count += 1
            
            if count > 0
                float avg = sum / count
                points.push(chart.point.from_index(bar_index + i, avg))
                lastAvg := avg
    [points, lastAvg]

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
float rsiValue = ta.rsi(close, rsiLengthInput)
float step     = 100.0 / rangesInput

// Storage for historical RSI segments for each range
var rangeHistory = array.new<RangeData>(rangesInput)

// Initialize the array of RangeData objects on the first bar
if barstate.isfirst
    for i = 0 to rangesInput - 1
        rangeHistory.set(i, RangeData.new(array.new<Segment>(0)))

// Capture historical segments once the pattern length is available
float anchorRsi = rsiValue[lengthInput - 1]
if not na(anchorRsi)
    int segmentIdx = clamp(int(anchorRsi / step), 0, rangesInput - 1)
    
    float[] rsiPattern = array.new<float>(0)
    for i = 0 to lengthInput - 1
        rsiPattern.unshift(rsiValue[i])
    
    // Store the pattern in the corresponding range
    RangeData currentRange = rangeHistory.get(segmentIdx)
    currentRange.addSegment(Segment.new(rsiPattern))

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// RSI Prediction (Last Bar Only)
var polyline forecastPoly = na
if barstate.islast and not na(rsiValue)
    polyline.delete(forecastPoly)
    int currentIdx = clamp(int(rsiValue / step), 0, rangesInput - 1)
    RangeData matchingRange = rangeHistory.get(currentIdx)
    [pts, lastAvg] = matchingRange.forecast(rsiValue)
    
    if pts.size() > 1
        color fColor = lastAvg > rsiValue ? bullColorInput : bearColorInput
        forecastPoly := polyline.new(pts, line_color = fColor, line_width = 2)

// Dynamic Horizontal Levels
// Using plot.style_linebr with na values would create gaps, 
// so we plot the level directly and control style via the Style tab if needed, 
// or use the color input for transparency.
pOB = plot(obLevelInput, "Overbought Level", color = levelColorInput, linestyle = plot.linestyle_dashed)
pOS = plot(osLevelInput, "Oversold Level",   color = levelColorInput, linestyle = plot.linestyle_dashed)
p50 = plot(50,           "Center Level",     color = color.new(levelColorInput, 50), style = plot.style_line)

// Plot RSI with dynamic coloring
color rsiColor = rsiValue > 50 ? bullColorInput : bearColorInput
rsiPlot = plot(rsiValue, "RSI", color = rsiColor, linewidth = 2)

// Conditional Vertical Gradient Fills
bool isOB = rsiValue > obLevelInput
bool isOS = rsiValue < osLevelInput

fill(rsiPlot, pOB, rsiValue, obLevelInput, isOB ? bullColorInput : na, isOB ? color.new(bullColorInput, 100) : na, title = "Overbought Gradient")
fill(rsiPlot, pOS, osLevelInput, rsiValue, isOS ? color.new(bearColorInput, 100) : na, isOS ? bearColorInput : na, title = "Oversold Gradient")

plot(clamp(int(rsiValue / step), 0, rangesInput - 1) * step, "Segment Base", color = color.new(rsiColor, 50), style = plot.style_stepline)

//---------------------------------------------------------------------------------------------------------------------}
