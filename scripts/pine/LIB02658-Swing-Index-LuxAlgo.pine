//@version=6
indicator("Swing Index", "Swing Index", overlay = false, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
TMODE_AUTO  = "Auto (Highest Excursion)"
TMODE_FIXED = "Fixed Value"

BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86
LEVELS_COLOR  = #787b86

GROUP_SETTINGS = "Settings"
GROUP_STYLE    = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
tModeInput = input.string(TMODE_AUTO, "Limit Move (T)", options = [TMODE_AUTO, TMODE_FIXED], group = GROUP_SETTINGS, tooltip = "How the limit move scaling factor T is set. Wilder used the exchange's maximum permitted daily move, so a bar using its full limit registered near the +/-100 extremes. Modern markets without limit moves need a chosen constant: Auto sets T to the highest excursion from the prior close found over the Auto Scaling Lookback, so the largest recent swing reads near the extremes.")

tFixedInput = input.float(1.0, "Fixed Limit Move Value", minval = 0.0000001, group = GROUP_SETTINGS, tooltip = "Limit move value T in price units, used when the mode is set to Fixed Value. Enter the exchange limit move where one exists, or any scaling constant otherwise. Absolute readings are only comparable across platforms when they use the same T.")

autoLengthInput = input.int(252, "Auto Scaling Lookback", minval = 1, group = GROUP_SETTINGS, tooltip = "Number of bars inspected by the Auto mode to find the highest excursion from the prior close, which is then used as the limit move value T.")

strongPosInput = input.float(50, "Strong Swing Levels", minval = 0, step = 5, inline = "levels", group = GROUP_SETTINGS, tooltip = "Level above which a single-bar reading counts as a strong positive swing.")
strongNegInput = input.float(-50, " ", maxval = 0, step = 5, inline = "levels", group = GROUP_SETTINGS, tooltip = "Levels beyond which a single-bar reading counts as a strong swing, used by the strong swing and breakout validation alerts. Because T is a convention on markets without limit moves, tune these to the instrument: the sign and relative magnitude of readings carry the information, not the absolute scale.")

breakoutLengthInput = input.int(20, "Breakout Lookback", minval = 2, group = GROUP_SETTINGS, tooltip = "Lookback used to detect new price highs and lows for the breakout validation alerts. In Wilder's use, a new price extreme accompanied by a strong same-direction Swing Index reading argues the breakout is genuine rather than a spike.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "colors", group = GROUP_STYLE)
bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = GROUP_STYLE)
levelsColorInput = input.color(LEVELS_COLOR, "Levels", inline = "colors", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Wilder's per-bar Swing Index of the current bar against the previous one, scaled by the limit move value `scaleT`
swingIndex(float scaleT) =>
    float cy = close[1]
    float oy = open[1]
    float si = na
    if not na(cy) and not na(oy)
        float highExcursion = math.abs(high - cy)
        float lowExcursion  = math.abs(low - cy)
        float barRange      = math.abs(high - low)
        float openCloseTerm = 0.25 * math.abs(cy - oy)
        float kValue        = math.max(highExcursion, lowExcursion)
        float rValue        = na
        if highExcursion >= lowExcursion and highExcursion >= barRange
            rValue := highExcursion - 0.5 * lowExcursion + openCloseTerm
        else if lowExcursion >= highExcursion and lowExcursion >= barRange
            rValue := lowExcursion - 0.5 * highExcursion + openCloseTerm
        else
            rValue := barRange + openCloseTerm
        float numeratorValue = (close - cy) + 0.5 * (close - open) + 0.25 * (cy - oy)
        si := rValue == 0 or na(scaleT) or scaleT == 0 ? 0 : 50 * numeratorValue / rValue * (kValue / scaleT)
    si

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Excursion of the current bar from the prior close - Wilder's K, also the basis of the Auto limit move estimate
float excursion       = na(close[1]) ? na : math.max(math.abs(high - close[1]), math.abs(low - close[1]))
float excursionFilled = nz(excursion)

// Running maximum as a fallback so early bars remain scaled before the Auto window fills
var float runningMaxExcursion = 0.0
runningMaxExcursion := math.max(runningMaxExcursion, excursionFilled)

float autoHighestExcursion = ta.highest(excursionFilled, autoLengthInput)
float autoScaleT           = na(autoHighestExcursion) or autoHighestExcursion == 0 ? runningMaxExcursion : autoHighestExcursion

float limitMoveValue = tModeInput == TMODE_FIXED ? tFixedInput : autoScaleT

float swingIndexValue = swingIndex(limitMoveValue)

// Events
bool crossAboveZero   = ta.crossover(swingIndexValue, 0)
bool crossBelowZero   = ta.crossunder(swingIndexValue, 0)
bool crossAboveStrong = ta.crossover(swingIndexValue, strongPosInput)
bool crossBelowStrong = ta.crossunder(swingIndexValue, strongNegInput)

float priorHighestHigh = ta.highest(high, breakoutLengthInput)[1]
float priorLowestLow   = ta.lowest(low, breakoutLengthInput)[1]

bool validatedNewHigh = not na(priorHighestHigh) and high > priorHighestHigh and not na(swingIndexValue) and swingIndexValue >= strongPosInput
bool validatedNewLow  = not na(priorLowestLow) and low < priorLowestLow and not na(swingIndexValue) and swingIndexValue <= strongNegInput

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
color siColor = swingIndexValue > 0 ? bullColorInput : bearColorInput

siPlotId   = plot(swingIndexValue, "Swing Index", siColor, 1)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

// Centered oscillator gradient: fully transparent at zero, stronger toward the reading
color topFillColor    = swingIndexValue > 0 ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)
color bottomFillColor = swingIndexValue > 0 ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)
fill(zeroPlotId, siPlotId, math.max(swingIndexValue, 0), math.min(swingIndexValue, 0), topFillColor, bottomFillColor, "Swing Index Gradient")

hline(0, "Zero Line", levelsColorInput, hline.style_dotted)
hline(strongPosInput, "Strong Positive Level", levelsColorInput, hline.style_dashed)
hline(strongNegInput, "Strong Negative Level", levelsColorInput, hline.style_dashed)

// Effective limit move (T) exposed in the data window, since absolute readings depend on it
plot(limitMoveValue, "Limit Move (T)", NEUTRAL_COLOR, 1, display = display.data_window, editable = false)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossAboveZero, "Swing Index Cross Above Zero", "Swing Index crossed above zero - the net two-bar change turned positive")
alertcondition(crossBelowZero, "Swing Index Cross Below Zero", "Swing Index crossed below zero - the net two-bar change turned negative")
alertcondition(crossAboveStrong, "Strong Positive Swing", "Swing Index crossed above the strong positive level")
alertcondition(crossBelowStrong, "Strong Negative Swing", "Swing Index crossed below the strong negative level")
alertcondition(validatedNewHigh, "Validated New High", "New price high accompanied by a strong positive Swing Index reading")
alertcondition(validatedNewLow, "Validated New Low", "New price low accompanied by a strong negative Swing Index reading")

//---------------------------------------------------------------------------------------------------------------------}
