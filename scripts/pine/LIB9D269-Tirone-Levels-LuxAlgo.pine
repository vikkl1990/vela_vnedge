//@version=6
indicator("Tirone Levels", "Tirone Levels", overlay = true, format = format.price)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
string METHOD_MIDPOINT = "Midpoint"
string METHOD_MEAN     = "Mean"
string METHOD_BOTH     = "Both"

string WINDOW_ROLLING  = "Rolling"
string WINDOW_ANCHORED = "Anchored"

color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86

int ZONE_EDGE_TRANSP = 80
int ZONE_FADE_TRANSP = 100
int EXTREME_TRANSP   = 40

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
string methodInput       = input.string(METHOD_MIDPOINT, "Method", options = [METHOD_MIDPOINT, METHOD_MEAN, METHOD_BOTH], group = "Levels", tooltip = "Level construction. 'Midpoint' splits the window's high-to-low range into thirds around its midpoint (3 lines). 'Mean' builds a 5-line ladder around the adjusted mean (H + L + C) / 3, often called mean levels. 'Both' overlays the two sets.")
bool   showMeanLineInput = input.bool(true, "Show Adjusted Mean", group = "Levels", tooltip = "Additionally plots the adjusted mean (H + L + C) / 3, the anchor of the mean-method ladder, as a middle line.")

string windowInput     = input.string(WINDOW_ROLLING, "Window", options = [WINDOW_ROLLING, WINDOW_ANCHORED], group = "Window", tooltip = "'Rolling' measures the highest high and lowest low over the last N bars, so the ladder redraws as new extremes print. 'Anchored' measures them from a fixed time onward, tying the levels to a structural range.")
int    lengthInput     = input.int(20, "Rolling Length", minval = 2, group = "Window", tooltip = "Number of bars in the rolling lookback window used to locate the highest high and lowest low. Ignored when 'Window' is set to Anchored.")
int    anchorTimeInput = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Anchor Time", group = "Window", tooltip = "Start time of the measured window when 'Window' is set to Anchored. The levels use the extremes printed from this point onward. Ignored when 'Window' is set to Rolling.")

color bearColorInput    = input.color(BEAR_COLOR, "Resistance Lines", group = "Style")
color neutralColorInput = input.color(NEUTRAL_COLOR, "Center / Mean Lines", group = "Style")
color bullColorInput    = input.color(BULL_COLOR, "Support Lines", group = "Style")
bool  showHistoryInput  = input.bool(true, "Historical Levels", group = "Style", tooltip = "Plots the bar-by-bar history of each level, showing how the ladder redrew as new extremes printed.")
bool  showZonesInput    = input.bool(true, "Gradient Zones", group = "Style", tooltip = "Shades soft gradient zones between the outer lines of each ladder and its interior.")
bool  showLabelsInput   = input.bool(true, "Level Labels", group = "Style")
int   extendInput       = input.int(10, "Rightward Extension", minval = 0, maxval = 500, group = "Style", tooltip = "Number of bars the current levels and their name labels extend to the right of the latest bar.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
var array<line>  levelLineArray  = array.new<line>()
var array<label> levelLabelArray = array.new<label>()

// Deletes the previously drawn ladder so the current one can be redrawn
clearLevels() =>
    if levelLineArray.size() > 0
        for levelLine in levelLineArray
            levelLine.delete()
        levelLineArray.clear()
    if levelLabelArray.size() > 0
        for levelLabel in levelLabelArray
            levelLabel.delete()
        levelLabelArray.clear()

// Draws one level of the current ladder flat across the measured window, extended to the right, with an optional name label
renderLevel(int startIndex, float levelPrice, color levelColor, string levelStyle, string levelName) =>
    if not na(levelPrice) and not na(startIndex)
        levelLineArray.push(line.new(startIndex, levelPrice, bar_index + extendInput, levelPrice, xloc.bar_index, extend.none, levelColor, levelStyle, 1))
        if showLabelsInput
            levelLabelArray.push(label.new(bar_index + extendInput, levelPrice, levelName, xloc.bar_index, yloc.price, #00000000, label.style_label_left, levelColor, size.small))

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
bool showMidpointMethod = methodInput != METHOD_MEAN
bool showMeanMethod     = methodInput != METHOD_MIDPOINT
bool useAnchor          = windowInput == WINDOW_ANCHORED

// Window extremes
float rollingHigh = ta.highest(high, lengthInput)
float rollingLow  = ta.lowest(low, lengthInput)

var float anchoredHigh  = na
var float anchoredLow   = na
var int   anchoredStart = na

if time >= anchorTimeInput
    anchoredHigh := math.max(nz(anchoredHigh, high), high)
    anchoredLow  := math.min(nz(anchoredLow, low), low)
    if na(anchoredStart)
        anchoredStart := bar_index

float windowHigh = useAnchor ? anchoredHigh : rollingHigh
float windowLow  = useAnchor ? anchoredLow  : rollingLow
float rangeSpan  = windowHigh - windowLow

// Midpoint method - the traveled range carved into thirds plus its midpoint
float topThirdLevel    = windowHigh - rangeSpan / 3
float centerLevel      = windowLow + rangeSpan / 2
float bottomThirdLevel = windowLow + rangeSpan / 3

// Mean method (mean levels) - five-line ladder around the adjusted mean
float adjustedMean     = (windowHigh + windowLow + close) / 3
float extremeHighLevel = adjustedMean + rangeSpan
float regularHighLevel = 2 * adjustedMean - windowLow
float regularLowLevel  = 2 * adjustedMean - windowHigh
float extremeLowLevel  = adjustedMean - rangeSpan

// Display series gated by the selected method
float topThirdPlot     = showMidpointMethod ? topThirdLevel : na
float centerPlot       = showMidpointMethod ? centerLevel : na
float bottomThirdPlot  = showMidpointMethod ? bottomThirdLevel : na
float extremeHighPlot  = showMeanMethod ? extremeHighLevel : na
float regularHighPlot  = showMeanMethod ? regularHighLevel : na
float adjustedMeanPlot = showMeanMethod and showMeanLineInput ? adjustedMean : na
float regularLowPlot   = showMeanMethod ? regularLowLevel : na
float extremeLowPlot   = showMeanMethod ? extremeLowLevel : na

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color historyBearColor    = showHistoryInput ? bearColorInput : na
color historyBullColor    = showHistoryInput ? bullColorInput : na
color historyNeutralColor = showHistoryInput ? neutralColorInput : na
color historyBearSoft     = showHistoryInput ? color.new(bearColorInput, EXTREME_TRANSP) : na
color historyBullSoft     = showHistoryInput ? color.new(bullColorInput, EXTREME_TRANSP) : na

extremeHighPlotId  = plot(extremeHighPlot, "Extreme High", historyBearSoft, 1)
regularHighPlotId  = plot(regularHighPlot, "Regular High", historyBearColor, 1)
topThirdPlotId     = plot(topThirdPlot, "Top Third", historyBearColor, 1)
centerPlotId       = plot(centerPlot, "Center", historyNeutralColor, 1)
adjustedMeanPlotId = plot(adjustedMeanPlot, "Adjusted Mean", historyNeutralColor, 1)
bottomThirdPlotId  = plot(bottomThirdPlot, "Bottom Third", historyBullColor, 1)
regularLowPlotId   = plot(regularLowPlot, "Regular Low", historyBullColor, 1)
extremeLowPlotId   = plot(extremeLowPlot, "Extreme Low", historyBullSoft, 1)

color zoneBearEdge = showZonesInput ? color.new(bearColorInput, ZONE_EDGE_TRANSP) : na
color zoneBearFade = showZonesInput ? color.new(bearColorInput, ZONE_FADE_TRANSP) : na
color zoneBullEdge = showZonesInput ? color.new(bullColorInput, ZONE_EDGE_TRANSP) : na
color zoneBullFade = showZonesInput ? color.new(bullColorInput, ZONE_FADE_TRANSP) : na

fill(topThirdPlotId, centerPlotId, top_value = topThirdPlot, bottom_value = centerPlot, top_color = zoneBearEdge, bottom_color = zoneBearFade, title = "Upper Third Zone")
fill(centerPlotId, bottomThirdPlotId, top_value = centerPlot, bottom_value = bottomThirdPlot, top_color = zoneBullFade, bottom_color = zoneBullEdge, title = "Lower Third Zone")
fill(extremeHighPlotId, regularHighPlotId, top_value = extremeHighPlot, bottom_value = regularHighPlot, top_color = zoneBearEdge, bottom_color = zoneBearFade, title = "Upper Failure Zone")
fill(regularLowPlotId, extremeLowPlotId, top_value = regularLowPlot, bottom_value = extremeLowPlot, top_color = zoneBullFade, bottom_color = zoneBullEdge, title = "Lower Failure Zone")

// Current ladder drawn flat across the measured window
if barstate.islast
    clearLevels()
    int windowStartIndex = useAnchor ? anchoredStart : math.max(bar_index - lengthInput + 1, 0)

    if showMidpointMethod
        renderLevel(windowStartIndex, topThirdLevel, bearColorInput, line.style_solid, "Top Third")
        renderLevel(windowStartIndex, centerLevel, neutralColorInput, line.style_solid, "Center")
        renderLevel(windowStartIndex, bottomThirdLevel, bullColorInput, line.style_solid, "Bottom Third")

    if showMeanMethod
        renderLevel(windowStartIndex, extremeHighLevel, bearColorInput, line.style_dashed, "Extreme High")
        renderLevel(windowStartIndex, regularHighLevel, bearColorInput, line.style_solid, "Regular High")
        if showMeanLineInput
            renderLevel(windowStartIndex, adjustedMean, neutralColorInput, line.style_solid, "Adjusted Mean")
        renderLevel(windowStartIndex, regularLowLevel, bullColorInput, line.style_solid, "Regular Low")
        renderLevel(windowStartIndex, extremeLowLevel, bullColorInput, line.style_dashed, "Extreme Low")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
// Crosses are evaluated against the ladder as it stood on the prior bar: the window includes the latest bar, so price
// can never close beyond the live mean-method outer lines by construction
bool centerCrossUp    = ta.crossover(close, centerLevel[1])
bool centerCrossDown  = ta.crossunder(close, centerLevel[1])
bool upperThirdEntry  = ta.crossover(close, topThirdLevel[1])
bool lowerThirdEntry  = ta.crossunder(close, bottomThirdLevel[1])
bool rangeFailureUp   = ta.crossover(close, extremeHighLevel[1])
bool rangeFailureDown = ta.crossunder(close, extremeLowLevel[1])

alertcondition(showMidpointMethod and centerCrossUp, "Center Cross Up", "Price crossed above the Tirone center line, the mean-reversion target of the measured range")
alertcondition(showMidpointMethod and centerCrossDown, "Center Cross Down", "Price crossed below the Tirone center line, the mean-reversion target of the measured range")
alertcondition(showMidpointMethod and upperThirdEntry, "Upper Third Entered", "Price crossed above the Tirone top third line into the upper fade zone of the measured range")
alertcondition(showMidpointMethod and lowerThirdEntry, "Lower Third Entered", "Price crossed below the Tirone bottom third line into the lower fade zone of the measured range")
alertcondition(showMeanMethod and rangeFailureUp, "Extreme High Breakout", "Close crossed above the Tirone extreme high (mean method), the recent range is failing to contain price")
alertcondition(showMeanMethod and rangeFailureDown, "Extreme Low Breakdown", "Close crossed below the Tirone extreme low (mean method), the recent range is failing to contain price")

//---------------------------------------------------------------------------------------------------------------------}
