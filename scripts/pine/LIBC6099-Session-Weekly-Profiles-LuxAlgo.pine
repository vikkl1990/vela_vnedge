//@version=6
indicator("Session & Weekly Profiles", shorttitle = "Session & Weekly Profiles", overlay = true, format = format.price, max_lines_count = 500, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
string GROUP_SESSIONS = "Sessions"
string GROUP_BIAS     = "Daily Bias"
string GROUP_DISPLAY  = "Display"
string GROUP_DASH     = "Dashboard"
string GROUP_STYLE    = "Style"

string W_ASIA   = "Asia"
string W_LONDON = "London KZ"
string W_NY     = "New York KZ"
string W_LC     = "London Close"
string W_OFF    = "Off-hours"

string PHASE_ACC = "Accumulation"
string PHASE_MAN = "Manipulation"
string PHASE_DIS = "Distribution"

string BIAS_AUTO = "Auto (Weekly Open)"
string BIAS_BULL = "Manual - Bullish"
string BIAS_BEAR = "Manual - Bearish"

string POS_TR = "Top Right"
string POS_TL = "Top Left"
string POS_BR = "Bottom Right"
string POS_BL = "Bottom Left"
string POS_MR = "Middle Right"

string SIZE_TINY   = "Tiny"
string SIZE_SMALL  = "Small"
string SIZE_NORMAL = "Normal"

color COLOR_NONE = #00000000

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

tzInput = input.string("America/New_York", "Profile Timezone"
  , options = ["America/New_York", "UTC", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Shanghai", "Asia/Kolkata", "Australia/Sydney", "America/Chicago", "America/Los_Angeles"]
  , group   = GROUP_SESSIONS
  , tooltip = "Timezone the session windows are defined in. New York time is the usual reference for ICT session profiles. Session boundaries vary by instrument and platform and shift with daylight saving, so verify the windows match your market.")

asiaSessionInput = input.session("2000-0000", "Asia Session"
  , group   = GROUP_SESSIONS
  , tooltip = "Overnight accumulation window, commonly 20:00 to 00:00 New York time. The high and low set during this window form the Asian range, the reference that London manipulation is measured against.")

londonSessionInput = input.session("0200-0500", "London Killzone"
  , group   = GROUP_SESSIONS
  , tooltip = "London killzone, commonly 02:00 to 05:00 New York time. In the classic templates this window runs the stops beyond one side of the Asian range (the Judas swing) and sets the extreme of the day.")

nySessionInput = input.session("0700-1000", "New York Killzone"
  , group   = GROUP_SESSIONS
  , tooltip = "New York killzone, commonly 07:00 to 10:00 New York time. In trend templates this window expands away from the London extreme; in reversal profiles it undoes London's move instead.")

lcSessionInput = input.session("1000-1200", "London Close"
  , group   = GROUP_SESSIONS
  , tooltip = "London close window, commonly 10:00 to 12:00 New York time. A late window where participation is still deep enough to turn price, watched for end-of-morning reversals.")

biasInput = input.string(BIAS_AUTO, "Bias Source"
  , options = [BIAS_AUTO, BIAS_BULL, BIAS_BEAR]
  , group   = GROUP_BIAS
  , tooltip = "Directional lean the templates are read against. Auto uses the weekly open as the premium/discount reference inside the week - price above it leans bullish, below it bearish. Manual fixes the bias to your own higher-timeframe read (structure, draw on liquidity).")

showShadingInput = input.bool(true, "Session Shading"
  , group   = GROUP_DISPLAY
  , tooltip = "Shade the chart background during the Asia, London killzone, New York killzone and London close windows, putting the session clock on the chart.")

showAsianRangeInput = input.bool(true, "Asian Range High/Low"
  , group   = GROUP_DISPLAY
  , tooltip = "Draw the Asian range high and low and extend them through the rest of the day. These are the levels the London manipulation leg is expected to run before the day expands.")

showSessionLevelsInput = input.bool(true, "Completed Session O/H/L Marks"
  , group   = GROUP_DISPLAY
  , tooltip = "When a session window completes, mark its open (dotted) and its high and low (solid) across the bars of that window.")

showSessionLabelsInput = input.bool(true, "Session Phase Labels"
  , group   = GROUP_DISPLAY
  , tooltip = "Tag the first bar of each window with the session name and its role in the template: Asia accumulation, London manipulation, New York distribution.")

showDayHlInput = input.bool(true, "Running Daily High/Low"
  , group   = GROUP_DISPLAY
  , tooltip = "Plot the running high and low of the current day (midnight to midnight in the profile timezone), so you can see which window actually printed the day's extreme.")

showWeeklyOpenInput = input.bool(true, "Weekly Open Line"
  , group   = GROUP_DISPLAY
  , tooltip = "Plot the weekly open, the premium/discount reference inside the week and the anchor of the weekly templates.")

showJudasInput = input.bool(true, "Judas Sweep Labels"
  , group   = GROUP_DISPLAY
  , tooltip = "Label the bar where a London sweep of the Asian range closes back inside the range - the confirmed manipulation leg (Judas swing) the bullish and bearish day templates begin with.")

showDayClassInput = input.bool(true, "Day Template Labels"
  , group   = GROUP_DISPLAY
  , tooltip = "When a day completes, label it with the template it best matched: Classic Bullish/Bearish, a New York or London close reversal, or No Template. A day that fits no profile is itself information - stand-aside conditions rather than a broken rule.")

showWeekClassInput = input.bool(true, "Week Template Labels"
  , group   = GROUP_DISPLAY
  , tooltip = "When a week completes, label it with the weekly template it best matched: early low or high (the classic Tuesday low/high), a Wednesday midweek reversal, a Thursday reversal, or No Template.")

showDashInput = input.bool(true, "Show Dashboard"
  , group   = GROUP_DASH
  , tooltip = "Show a status panel with the bias, the active window, the Asian range and sweep state, where the day's extremes formed, and the live day and week template reads.")

dashPositionInput = input.string(POS_TR, "Position"
  , options = [POS_TR, POS_TL, POS_BR, POS_BL, POS_MR]
  , group   = GROUP_DASH
  , tooltip = "Corner of the chart the dashboard is anchored to.")

dashSizeInput = input.string(SIZE_SMALL, "Text Size"
  , options = [SIZE_TINY, SIZE_SMALL, SIZE_NORMAL]
  , group   = GROUP_DASH
  , tooltip = "Text size of the dashboard.")

asiaColorInput = input.color(#ffd700, "Asia"
  , inline  = "sessColors1"
  , group   = GROUP_STYLE
  , tooltip = "Color of the Asia session shading, its range lines and its completed-window marks.")

londonColorInput = input.color(#ff9800, "London KZ"
  , inline  = "sessColors1"
  , group   = GROUP_STYLE
  , tooltip = "Color of the London killzone shading and its completed-window marks.")

nyColorInput = input.color(#ab47bc, "New York KZ"
  , inline  = "sessColors2"
  , group   = GROUP_STYLE
  , tooltip = "Color of the New York killzone shading and its completed-window marks.")

lcColorInput = input.color(#787b86, "London Close"
  , inline  = "sessColors2"
  , group   = GROUP_STYLE
  , tooltip = "Color of the London close shading and its completed-window marks.")

shadeTranspInput = input.int(92, "Shading Transparency"
  , minval  = 50
  , maxval  = 99
  , group   = GROUP_STYLE
  , tooltip = "Transparency of the session background shading. Higher values are more subtle.")

bullColorInput = input.color(#089981, "Bullish"
  , inline  = "bias"
  , group   = GROUP_STYLE
  , tooltip = "Color of bullish template events: Judas sweeps of the Asian low, bullish expansions, reversals and template labels.")

bearColorInput = input.color(#f23645, "Bearish"
  , inline  = "bias"
  , group   = GROUP_STYLE
  , tooltip = "Color of bearish template events: Judas sweeps of the Asian high, bearish expansions, reversals and template labels.")

neutralColorInput = input.color(#787b86, "Neutral"
  , inline  = "neutral"
  , group   = GROUP_STYLE
  , tooltip = "Color of non-directional elements such as No Template labels.")

dayHlColorInput = input.color(color.new(#787b86, 40), "Daily High/Low"
  , inline  = "neutral"
  , group   = GROUP_STYLE
  , tooltip = "Color of the running daily high and low plots.")

weeklyOpenColorInput = input.color(#b2b5be, "Weekly Open"
  , group   = GROUP_STYLE
  , tooltip = "Color of the weekly open line.")

string dashTextSize = switch dashSizeInput
    SIZE_TINY   => size.tiny
    SIZE_NORMAL => size.normal
    =>             size.small

string dashPos = switch dashPositionInput
    POS_TL => position.top_left
    POS_BR => position.bottom_right
    POS_BL => position.bottom_left
    POS_MR => position.middle_right
    =>        position.top_right

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// true when the current bar sits inside the given session window, in the profile timezone
inWindow(string sess) =>
    timeframe.isintraday and not na(time(timeframe.period, sess, tzInput))

// short weekday name from a Pine day-of-week index (1 = Sunday .. 7 = Saturday)
dowName(int d) =>
    switch d
        1 => "Sun"
        2 => "Mon"
        3 => "Tue"
        4 => "Wed"
        5 => "Thu"
        6 => "Fri"
        7 => "Sat"
        => "-"

// tracks one session window: open/high/low while it is active, a phase label on its first bar, and
// open/high/low marks drawn across the window once it completes
trackWindow(bool active, string windowName, string phaseName, color css) =>
    var float wOpen     = na
    var float wHi       = na
    var float wLo       = na
    var int   wStartBar = na
    bool prevActive = na(active[1]) ? false : active[1]
    bool wStart     = active and not prevActive
    bool wEnd       = not active and prevActive
    if wStart
        wOpen     := open
        wHi       := high
        wLo       := low
        wStartBar := bar_index
        if showSessionLabelsInput
            string labelText = windowName + (phaseName == "" ? "" : " · " + phaseName)
            label.new(bar_index, na, labelText, yloc = yloc.belowbar, style = label.style_none, textcolor = color.new(css, 15), size = size.tiny)
    else if active
        wHi := math.max(wHi, high)
        wLo := math.min(wLo, low)
    if wEnd and showSessionLevelsInput and not na(wStartBar)
        int endBar = bar_index - 1
        line.new(wStartBar, wHi,   endBar, wHi,   color = color.new(css, 25), width = 1)
        line.new(wStartBar, wLo,   endBar, wLo,   color = color.new(css, 25), width = 1)
        line.new(wStartBar, wOpen, endBar, wOpen, color = color.new(css, 25), style = line.style_dotted)
    [wStart, wEnd, wHi, wLo]

// writes one key/value row of the dashboard
dashRow(table t, int rowIdx, string keyText, string valText, color valCss) =>
    table.cell(t, 0, rowIdx, keyText, text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(t, 1, rowIdx, valText, text_color = valCss, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Sessions & Calendar
//---------------------------------------------------------------------------------------------------------------------{
bool inAsia   = inWindow(asiaSessionInput)
bool inLondon = inWindow(londonSessionInput)
bool inNy     = inWindow(nySessionInput)
bool inLc     = inWindow(lcSessionInput)

string curWin = inLondon ? W_LONDON : inNy ? W_NY : inLc ? W_LC : inAsia ? W_ASIA : W_OFF

int dowNy = dayofweek(time, tzInput)
int domNy = dayofmonth(time, tzInput)

bool weeklyOk = timeframe.isintraday or timeframe.isdaily

// the profile day rolls at midnight in the profile timezone; the week rolls on the first bar of the new
// calendar week (day-of-week index dropping back), so holiday-shortened weeks still roll correctly
bool newDay  = timeframe.isintraday and (barstate.isfirst or (na(domNy[1]) ? false : domNy != domNy[1]))
bool newWeek = weeklyOk and (barstate.isfirst or (na(dowNy[1]) ? false : dowNy < dowNy[1]))

[asiaStart, asiaEnd, asiaHiLive, asiaLoLive] = trackWindow(inAsia,   W_ASIA,   PHASE_ACC, asiaColorInput)
[lonStart,  lonEnd,  lonHiLive,  lonLoLive]  = trackWindow(inLondon, W_LONDON, PHASE_MAN, londonColorInput)
[nyStart,   nyEnd,   nyHiLive,   nyLoLive]   = trackWindow(inNy,     W_NY,     PHASE_DIS, nyColorInput)
[lcStart,   lcEnd,   lcHiLive,   lcLoLive]   = trackWindow(inLc,     W_LC,     "",        lcColorInput)

// the Asian range freezes when the Asia window completes and stays the sweep reference until the next one completes
var float asianHi    = na
var float asianLo    = na
var bool  asianValid = false
if asiaEnd
    asianHi    := asiaHiLive
    asianLo    := asiaLoLive
    asianValid := true

// Asian range high/low lines, built during the window and extended through the rest of the day
var line asianHiLine = na
var line asianLoLine = na
if showAsianRangeInput
    if asiaStart
        asianHiLine := line.new(bar_index, high, bar_index, high, color = asiaColorInput, width = 1)
        asianLoLine := line.new(bar_index, low,  bar_index, low,  color = asiaColorInput, width = 1)
    else if not na(asianHiLine)
        if inAsia
            line.set_y1(asianHiLine, asiaHiLive)
            line.set_y2(asianHiLine, asiaHiLive)
            line.set_y1(asianLoLine, asiaLoLive)
            line.set_y2(asianLoLine, asiaLoLive)
        line.set_x2(asianHiLine, bar_index)
        line.set_x2(asianLoLine, bar_index)

//---------------------------------------------------------------------------------------------------------------------}
// Day Profile
//---------------------------------------------------------------------------------------------------------------------{
var float dayOpenP    = na
var float dayHiP      = na
var float dayLoP      = na
var int   dayStartBar = na
var int   dayHiBar    = na
var int   dayLoBar    = na
var string dayHiWin   = W_OFF
var string dayLoWin   = W_OFF

// per-day template state, reset at each midnight roll
var bool lowSwept      = false
var bool highSwept     = false
var bool judasBullDone = false
var bool judasBearDone = false
var bool expUpDone     = false
var bool expDownDone   = false
var bool nyStartedDay  = false
var bool londonDone    = false
var bool nyTookLonLow  = false
var bool nyTookLonHigh = false
var bool nyRevBullDone = false
var bool nyRevBearDone = false

var float londonHiF = na
var float londonLoF = na

// completed-day classification events, evaluated once on the first bar of the next day
bool dayBullTemplateEvt = false
bool dayBearTemplateEvt = false
bool dayReversalEvt     = false
bool dayNoTemplateEvt   = false

if newDay
    // classify the day that just completed, before any state is reset
    if not barstate.isfirst and not na(dayOpenP) and not na(dayHiBar) and not na(dayLoBar)
        bool dBull      = close[1] > dayOpenP
        bool hiAfterLo  = dayHiBar > dayLoBar
        bool loAfterHi  = dayLoBar > dayHiBar
        bool classicBull = dBull and dayLoWin == W_LONDON and hiAfterLo
        bool nyRevBullC  = dBull and dayLoWin == W_NY and hiAfterLo
        bool lcRevBullC  = dBull and dayLoWin == W_LC and hiAfterLo
        bool classicBear = not dBull and dayHiWin == W_LONDON and loAfterHi
        bool nyRevBearC  = not dBull and dayHiWin == W_NY and loAfterHi
        bool lcRevBearC  = not dBull and dayHiWin == W_LC and loAfterHi
        string dayClass = "No Template"
        if classicBull
            dayClass := lowSwept ? "Classic Bullish · Judas" : "Classic Bullish"
        else if classicBear
            dayClass := highSwept ? "Classic Bearish · Judas" : "Classic Bearish"
        else if nyRevBullC
            dayClass := "NY Reversal · Bullish"
        else if nyRevBearC
            dayClass := "NY Reversal · Bearish"
        else if lcRevBullC
            dayClass := "LC Reversal · Bullish"
        else if lcRevBearC
            dayClass := "LC Reversal · Bearish"
        dayBullTemplateEvt := classicBull
        dayBearTemplateEvt := classicBear
        dayReversalEvt     := nyRevBullC or nyRevBearC or lcRevBullC or lcRevBearC
        dayNoTemplateEvt   := not (classicBull or classicBear or dayReversalEvt)
        if showDayClassInput
            color dayCss = classicBull or nyRevBullC or lcRevBullC ? bullColorInput : classicBear or nyRevBearC or lcRevBearC ? bearColorInput : neutralColorInput
            int midBar = math.round((dayStartBar + bar_index - 1) / 2.0)
            label.new(midBar, dayHiP, dayClass, color = COLOR_NONE, textcolor = color.new(dayCss, 15), style = label.style_label_down, size = size.tiny)
    // reset the day state onto the roll bar
    dayOpenP    := open
    dayHiP      := high
    dayLoP      := low
    dayStartBar := bar_index
    dayHiBar    := bar_index
    dayLoBar    := bar_index
    dayHiWin    := curWin
    dayLoWin    := curWin
    lowSwept      := false
    highSwept     := false
    judasBullDone := false
    judasBearDone := false
    expUpDone     := false
    expDownDone   := false
    nyStartedDay  := false
    londonDone    := false
    nyTookLonLow  := false
    nyTookLonHigh := false
    nyRevBullDone := false
    nyRevBearDone := false
else if timeframe.isintraday and not na(dayOpenP)
    if high > dayHiP
        dayHiP   := high
        dayHiBar := bar_index
        dayHiWin := curWin
    if low < dayLoP
        dayLoP   := low
        dayLoBar := bar_index
        dayLoWin := curWin

// the completed London killzone range, the reference New York reversals are measured against
if lonEnd
    londonHiF  := lonHiLive
    londonLoF  := lonLoLive
    londonDone := true

if nyStart
    nyStartedDay := true

// manipulation leg: London runs the stops beyond one side of the Asian range...
bool sweepLowEvt  = inLondon and asianValid and not lowSwept and low < asianLo
bool sweepHighEvt = inLondon and asianValid and not highSwept and high > asianHi
if sweepLowEvt
    lowSwept := true
if sweepHighEvt
    highSwept := true

// ...and the sweep is confirmed as a Judas swing when price closes back inside the range during London
bool judasBullEvt = inLondon and lowSwept and not judasBullDone and close > asianLo
bool judasBearEvt = inLondon and highSwept and not judasBearDone and close < asianHi
if judasBullEvt
    judasBullDone := true
    if showJudasInput
        label.new(bar_index, low, "Judas Sweep", color = COLOR_NONE, textcolor = bullColorInput, style = label.style_label_up, size = size.tiny)
if judasBearEvt
    judasBearDone := true
    if showJudasInput
        label.new(bar_index, high, "Judas Sweep", color = COLOR_NONE, textcolor = bearColorInput, style = label.style_label_down, size = size.tiny)

// distribution leg: after the London sweep, New York closes beyond the far side of the Asian range
bool expUpEvt   = nyStartedDay and asianValid and lowSwept and not expUpDone and close > asianHi
bool expDownEvt = nyStartedDay and asianValid and highSwept and not expDownDone and close < asianLo
if expUpEvt
    expUpDone := true
if expDownEvt
    expDownDone := true

// reversal profile: New York sweeps the London killzone extreme and closes back inside its range
if inNy and londonDone
    if not na(londonLoF) and low < londonLoF
        nyTookLonLow := true
    if not na(londonHiF) and high > londonHiF
        nyTookLonHigh := true
bool nyRevBullEvt = inNy and londonDone and nyTookLonLow and not nyRevBullDone and not na(londonLoF) and close > londonLoF
bool nyRevBearEvt = inNy and londonDone and nyTookLonHigh and not nyRevBearDone and not na(londonHiF) and close < londonHiF
if nyRevBullEvt
    nyRevBullDone := true
if nyRevBearEvt
    nyRevBearDone := true

//---------------------------------------------------------------------------------------------------------------------}
// Weekly Profile
//---------------------------------------------------------------------------------------------------------------------{
var float weekOpenP    = na
var float weekHiP      = na
var float weekLoP      = na
var int   weekHiDow    = 0
var int   weekLoDow    = 0
var int   weekHiBar    = na
var int   weekLoBar    = na
var int   weekStartBar = na

bool weekBullTemplateEvt = false
bool weekBearTemplateEvt = false
bool weekNoTemplateEvt   = false

if newWeek
    // classify the week that just completed, before the state rolls
    if not barstate.isfirst and not na(weekOpenP) and not na(weekHiBar) and not na(weekLoBar)
        bool wBull      = close[1] > weekOpenP
        bool wHiAfterLo = weekHiBar > weekLoBar
        bool wLoAfterHi = weekLoBar > weekHiBar
        bool earlyLowC   = wBull and weekLoDow >= 1 and weekLoDow <= 3 and wHiAfterLo
        bool wedRevBullC = wBull and weekLoDow == 4 and wHiAfterLo
        bool thuRevBullC = wBull and weekLoDow == 5 and wHiAfterLo
        bool earlyHighC  = not wBull and weekHiDow >= 1 and weekHiDow <= 3 and wLoAfterHi
        bool wedRevBearC = not wBull and weekHiDow == 4 and wLoAfterHi
        bool thuRevBearC = not wBull and weekHiDow == 5 and wLoAfterHi
        string weekClass = "Week · No Template"
        if earlyLowC
            weekClass := weekLoDow == 3 ? "Bullish Week · Tuesday Low" : "Bullish Week · Early Low"
        else if earlyHighC
            weekClass := weekHiDow == 3 ? "Bearish Week · Tuesday High" : "Bearish Week · Early High"
        else if wedRevBullC
            weekClass := "Bullish Week · Wednesday Reversal"
        else if wedRevBearC
            weekClass := "Bearish Week · Wednesday Reversal"
        else if thuRevBullC
            weekClass := "Bullish Week · Thursday Reversal"
        else if thuRevBearC
            weekClass := "Bearish Week · Thursday Reversal"
        weekBullTemplateEvt := earlyLowC or wedRevBullC or thuRevBullC
        weekBearTemplateEvt := earlyHighC or wedRevBearC or thuRevBearC
        weekNoTemplateEvt   := not (weekBullTemplateEvt or weekBearTemplateEvt)
        if showWeekClassInput
            color weekCss = weekBullTemplateEvt ? bullColorInput : weekBearTemplateEvt ? bearColorInput : neutralColorInput
            int wMidBar = math.round((weekStartBar + bar_index - 1) / 2.0)
            label.new(wMidBar, weekHiP, weekClass, color = COLOR_NONE, textcolor = weekCss, style = label.style_label_down, size = size.small)
    weekOpenP    := open
    weekHiP      := high
    weekLoP      := low
    weekHiDow    := dowNy
    weekLoDow    := dowNy
    weekHiBar    := bar_index
    weekLoBar    := bar_index
    weekStartBar := bar_index
else if weeklyOk and not na(weekOpenP)
    if high > weekHiP
        weekHiP   := high
        weekHiDow := dowNy
        weekHiBar := bar_index
    if low < weekLoP
        weekLoP   := low
        weekLoDow := dowNy
        weekLoBar := bar_index

// midweek check of the weekly template on the first bar of Wednesday
bool midweekBar        = weeklyOk and dowNy == 4 and (na(dowNy[1]) ? false : dowNy[1] != 4)
bool earlyLowTrackEvt  = midweekBar and not na(weekOpenP) and weekLoDow >= 1 and weekLoDow <= 3 and close > weekOpenP
bool earlyHighTrackEvt = midweekBar and not na(weekOpenP) and weekHiDow >= 1 and weekHiDow <= 3 and close < weekOpenP

// directional lean the templates are read against
bool biasBull = biasInput == BIAS_AUTO ? not na(weekOpenP) and close >= weekOpenP : biasInput == BIAS_BULL

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
color sessBg = not showShadingInput ? na : inLondon ? color.new(londonColorInput, shadeTranspInput) : inNy ? color.new(nyColorInput, shadeTranspInput) : inLc ? color.new(lcColorInput, shadeTranspInput) : inAsia ? color.new(asiaColorInput, shadeTranspInput) : na

bgcolor(sessBg, title = "Session Shading")

plot(showWeeklyOpenInput and weeklyOk ? weekOpenP : na, "Weekly Open", newWeek ? color(na) : weeklyOpenColorInput, 1, plot.style_linebr)
plot(showDayHlInput and timeframe.isintraday ? dayHiP : na, "Daily High", newDay ? color(na) : dayHlColorInput, 1, plot.style_linebr)
plot(showDayHlInput and timeframe.isintraday ? dayLoP : na, "Daily Low", newDay ? color(na) : dayHlColorInput, 1, plot.style_linebr)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dash = showDashInput ? table.new(dashPos, 2, 11, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1) : table(na)

if showDashInput and barstate.islast and not na(dash)
    bool   intra     = timeframe.isintraday
    string noData    = "—"
    string intraOnly = "intraday only"
    color  fgCss     = DASH_TEXT

    string biasText = (biasBull ? "Bullish" : "Bearish") + (biasInput == BIAS_AUTO ? " · auto" : " · manual")
    string expectedText = biasBull ? "London low → NY expansion up" : "London high → NY expansion down"

    string winText = not intra ? intraOnly : inAsia ? W_ASIA + " · " + PHASE_ACC : inLondon ? W_LONDON + " · " + PHASE_MAN : inNy ? W_NY + " · " + PHASE_DIS : inLc ? W_LC : W_OFF

    string asianText = not intra ? intraOnly : inAsia ? "forming…" : asianValid ? str.tostring(asianHi, format.mintick) + " / " + str.tostring(asianLo, format.mintick) : noData

    string sweepText = not intra or not asianValid ? noData : lowSwept and highSwept ? "Both sides swept" : lowSwept ? (judasBullDone ? "Asia low swept · reclaimed" : "Asia low swept") : highSwept ? (judasBearDone ? "Asia high swept · reclaimed" : "Asia high swept") : "None"
    color sweepCss = lowSwept and not highSwept ? bullColorInput : highSwept and not lowSwept ? bearColorInput : fgCss

    string dayReadText = noData
    if intra and not na(dayOpenP)
        bool liveBull = close >= dayOpenP
        if liveBull
            dayReadText := dayLoWin == W_LONDON ? "Classic Bullish · forming" : dayLoWin == W_NY ? "NY Reversal Bullish · forming" : dayLoWin == W_LC ? "LC Reversal Bullish · forming" : "No template yet"
        else
            dayReadText := dayHiWin == W_LONDON ? "Classic Bearish · forming" : dayHiWin == W_NY ? "NY Reversal Bearish · forming" : dayHiWin == W_LC ? "LC Reversal Bearish · forming" : "No template yet"

    string weekOpenText = na(weekOpenP) ? noData : str.tostring(weekOpenP, format.mintick) + (close >= weekOpenP ? " · Premium" : " · Discount")
    string weekHlText   = na(weekOpenP) ? noData : "H " + dowName(weekHiDow) + " · L " + dowName(weekLoDow)

    string weekReadText = noData
    if not na(weekOpenP)
        bool wLiveBull = close >= weekOpenP
        if wLiveBull
            weekReadText := weekLoDow <= 3 ? "Bullish · early low intact" : weekLoDow == 4 ? "Bullish · Wednesday low" : "Bullish · late low"
        else
            weekReadText := weekHiDow <= 3 ? "Bearish · early high intact" : weekHiDow == 4 ? "Bearish · Wednesday high" : "Bearish · late high"

    dashRow(dash, 0,  "Bias",        biasText,     biasBull ? bullColorInput : bearColorInput)
    dashRow(dash, 1,  "Expected",    expectedText, fgCss)
    dashRow(dash, 2,  "Window",      winText,      fgCss)
    dashRow(dash, 3,  "Asian Range", asianText,    fgCss)
    dashRow(dash, 4,  "Sweep",       sweepText,    sweepCss)
    dashRow(dash, 5,  "Day LOD",     not intra or na(dayOpenP) ? noData : dayLoWin, fgCss)
    dashRow(dash, 6,  "Day HOD",     not intra or na(dayOpenP) ? noData : dayHiWin, fgCss)
    dashRow(dash, 7,  "Day Read",    dayReadText,  fgCss)
    dashRow(dash, 8,  "Weekly Open", weekOpenText, na(weekOpenP) ? fgCss : close >= weekOpenP ? bullColorInput : bearColorInput)
    dashRow(dash, 9,  "Week H/L",    weekHlText,   fgCss)
    dashRow(dash, 10, "Week Read",   weekReadText, fgCss)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(sweepLowEvt,         "London Sweep of Asian Low",          "London killzone ran the stops below the Asian range low - potential manipulation leg of a bullish day template")
alertcondition(sweepHighEvt,        "London Sweep of Asian High",         "London killzone ran the stops above the Asian range high - potential manipulation leg of a bearish day template")
alertcondition(judasBullEvt,        "Bullish Judas Sweep Confirmed",      "Price swept the Asian range low during the London killzone and closed back inside the range - Judas swing of the classic bullish template")
alertcondition(judasBearEvt,        "Bearish Judas Sweep Confirmed",      "Price swept the Asian range high during the London killzone and closed back inside the range - Judas swing of the classic bearish template")
alertcondition(expUpEvt,            "Bullish New York Expansion",         "After the London sweep of the Asian low, price closed above the Asian range high in the New York session - classic bullish template delivering")
alertcondition(expDownEvt,          "Bearish New York Expansion",         "After the London sweep of the Asian high, price closed below the Asian range low in the New York session - classic bearish template delivering")
alertcondition(nyRevBullEvt,        "New York Reversal (Bullish)",        "New York killzone swept the London killzone low and closed back above it - New York undoing London's move")
alertcondition(nyRevBearEvt,        "New York Reversal (Bearish)",        "New York killzone swept the London killzone high and closed back below it - New York undoing London's move")
alertcondition(dayBullTemplateEvt,  "Day Classified: Classic Bullish",    "Completed day matched the classic bullish template - low of day in the London killzone with expansion higher afterward")
alertcondition(dayBearTemplateEvt,  "Day Classified: Classic Bearish",    "Completed day matched the classic bearish template - high of day in the London killzone with expansion lower afterward")
alertcondition(dayReversalEvt,      "Day Classified: Reversal Profile",   "Completed day matched a reversal profile - the day's extreme formed in the New York killzone or London close window")
alertcondition(dayNoTemplateEvt,    "Day Classified: No Template",        "Completed day matched no session profile template - stand-aside conditions by profile logic")
alertcondition(earlyLowTrackEvt,    "Weekly Template: Early Low Intact",  "Midweek check - the weekly low printed early in the week and price trades above the weekly open, consistent with the bullish weekly template")
alertcondition(earlyHighTrackEvt,   "Weekly Template: Early High Intact", "Midweek check - the weekly high printed early in the week and price trades below the weekly open, consistent with the bearish weekly template")
alertcondition(weekBullTemplateEvt, "Week Classified: Bullish Template",  "Completed week matched a bullish weekly template - early low or midweek/Thursday reversal followed by expansion higher")
alertcondition(weekBearTemplateEvt, "Week Classified: Bearish Template",  "Completed week matched a bearish weekly template - early high or midweek/Thursday reversal followed by expansion lower")
alertcondition(weekNoTemplateEvt,   "Week Classified: No Template",       "Completed week matched no weekly template")

//---------------------------------------------------------------------------------------------------------------------}
