//@version=6
indicator("Schaff Trend Cycle", shorttitle = "Schaff Trend Cycle", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MID_LEVEL = 50.0

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source", group = "Settings", tooltip = "Price series used to build the MACD that the trend cycle is measured on.")

fastInput = input.int(23, "Fast Length", minval = 1, group = "Settings", tooltip = "Fast EMA length of the underlying MACD. The 23 period default is slower than the classic 12, keeping the trend leg stable while the stochastic passes supply the speed.")

slowInput = input.int(50, "Slow Length", minval = 1, group = "Settings", tooltip = "Slow EMA length of the underlying MACD. The 50 period default pairs with the fast length to form the MACD difference the cycle is measured on.")

cycleInput = input.int(10, "Cycle Length", minval = 2, group = "Settings", tooltip = "Window of the two stochastic passes. Each pass measures where its input sits inside the range of its own values over this many bars.")

factorInput = input.float(0.5, "Smoothing Factor", minval = 0.01, maxval = 1, step = 0.05, group = "Settings", tooltip = "%D style recursive smoothing applied after each stochastic pass. 0.5 is the published default; higher values make an already fast line react faster.")

upperInput = input.float(75, "Upper Trigger", minval = 0, maxval = 100, group = "Trigger Levels", tooltip = "Upper trigger line. A cross down through it flags an emerging downtrend, while readings held above it read as an uptrend still in progress.")

lowerInput = input.float(25, "Lower Trigger", minval = 0, maxval = 100, group = "Trigger Levels", tooltip = "Lower trigger line. A cross up through it flags an emerging uptrend, while readings held below it read as a downtrend still in progress.")

//Style
bullColorInput = input.color(#089981, "Bullish Color", group = "Style", tooltip = "Color of the trend cycle line and gradient while the cycle holds the upper half of its 0-100 scale.")

bearColorInput = input.color(#f23645, "Bearish Color", group = "Style", tooltip = "Color of the trend cycle line and gradient while the cycle holds the lower half of its 0-100 scale.")

levelsColorInput = input.color(#787b86, "Levels Color", group = "Style", tooltip = "Color of the dashed trigger lines and the dotted midline.")

gradientInput = input.bool(true, "Gradient Fill", group = "Style", tooltip = "Vertical gradient between the midline and the trend cycle, colored by cycle side and fading out toward the midline.")

markersInput = input.bool(false, "Trigger Crossing Markers", group = "Style", tooltip = "Mark trigger line crossings inside the pane. Off by default to keep the pane clean; the alerts cover these events either way.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Stochastic normalization, position of `value` inside its own `length` bar range on a 0-100 scale.
// When the range is flat the previous reading is held to avoid division by zero.
stochNorm(value, length) =>
    lowest     = ta.lowest(value, length)
    valueRange = ta.highest(value, length) - lowest

    var float pct = na
    pct := valueRange > 0 ? 100 * (value - lowest) / valueRange : pct
    pct

// %D style recursive smoothing, na-seeded with the first available reading.
smoothStep(value, factor) =>
    var float smoothed = na
    smoothed := na(smoothed) ? value : smoothed + factor * (value - smoothed)
    smoothed

//---------------------------------------------------------------------------------------------------------------------}
// Schaff Trend Cycle
//---------------------------------------------------------------------------------------------------------------------{
fastEma  = ta.ema(srcInput, fastInput)
slowEma  = ta.ema(srcInput, slowInput)
macdLine = fastEma - slowEma

macdStoch  = stochNorm(macdLine, cycleInput)  //First stochastic pass, MACD inside its own range
macdCycle  = smoothStep(macdStoch, factorInput) //%D style smoothing of the first pass
cycleStoch = stochNorm(macdCycle, cycleInput) //Second stochastic pass, smoothed cycle inside its own range
stc        = smoothStep(cycleStoch, factorInput) //Final smoothing, the 0-100 Schaff Trend Cycle

//Trigger line events
bullCross    = ta.crossover(stc, lowerInput)
bearCross    = ta.crossunder(stc, upperInput)
upperExtreme = ta.crossover(stc, upperInput)
lowerExtreme = ta.crossunder(stc, lowerInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
stcColor = stc > MID_LEVEL ? bullColorInput : bearColorInput

stcPlotId = plot(stc, "Schaff Trend Cycle", stcColor, 2)
midPlotId = plot(MID_LEVEL, "Midline Anchor", color(na), editable = false, display = display.none)

//Centered gradient fill, transparent at the midline, stronger toward the cycle value
fillTopColor    = stc > MID_LEVEL ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)
fillBottomColor = stc > MID_LEVEL ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)

fill(stcPlotId, midPlotId, math.max(stc, MID_LEVEL), math.min(stc, MID_LEVEL), gradientInput ? fillTopColor : na, gradientInput ? fillBottomColor : na, "Cycle Gradient")

//Trigger lines and midline
hline(upperInput, "Upper Trigger", color.new(levelsColorInput, 25), hline.style_dashed)
hline(lowerInput, "Lower Trigger", color.new(levelsColorInput, 25), hline.style_dashed)
hline(MID_LEVEL, "Midline", color.new(levelsColorInput, 60), hline.style_dotted)

//Optional trigger crossing markers, defaulting to off
plotshape(markersInput and bullCross ? lowerInput : na, "Bullish Cross Marker", shape.triangleup, location.absolute, bullColorInput, size = size.tiny)
plotshape(markersInput and bearCross ? upperInput : na, "Bearish Cross Marker", shape.triangledown, location.absolute, bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullCross, "Bullish Trigger Cross", "Schaff Trend Cycle crossed up through the lower trigger — emerging uptrend signal")

alertcondition(bearCross, "Bearish Trigger Cross", "Schaff Trend Cycle crossed down through the upper trigger — emerging downtrend signal")

alertcondition(upperExtreme, "Upper Extreme Entered", "Schaff Trend Cycle crossed above the upper trigger — uptrend established, cycle pinned high")

alertcondition(lowerExtreme, "Lower Extreme Entered", "Schaff Trend Cycle crossed below the lower trigger — downtrend established, cycle pinned low")

//---------------------------------------------------------------------------------------------------------------------}
