//@version=6
indicator("Acceleration Bands", "Acceleration Bands", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86

FILL_CENTER_TRANSP = 100
FILL_EDGE_TRANSP   = 80
FILL_PHASE_TRANSP  = 60

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 1, group = "Settings",
  tooltip = "Lookback period 'n' for the simple moving averages of the range-adjusted highs, range-adjusted lows, and closes. The published default is 20; shorter windows make the bands jumpier.")

factorInput = input.float(4.0, "Band Factor", minval = 0, step = 0.25, group = "Settings",
  tooltip = "Scaling factor applied to each bar's normalized range (high - low) / (high + low) before averaging. The standard published form uses 4; changing it mainly shifts how often price closes outside the bands.")

showMarkersInput = input.bool(false, "Show Breakout Markers", group = "Breakout Signals",
  tooltip = "Show the classic rule on the chart: a triangle on the second of two consecutive closes outside a band (breakout entry) and a cross on the close back inside that band (standard exit). The matching alert conditions are available regardless of this setting.")

showFillInput = input.bool(true, "Gradient Fill", group = "Style",
  tooltip = "Fill the area between the midline and each band with a vertical gradient fading toward the midline.")

highlightPhaseInput = input.bool(true, "Highlight Acceleration Phase", group = "Style",
  tooltip = "Intensify the gradient on the broken side while the move is in its acceleration phase - from two consecutive closes outside a band until a close back inside it.")

upperColorInput = input.color(BULL_COLOR, "Upper Band", group = "Style")
midColorInput   = input.color(NEUTRAL_COLOR, "Midline", group = "Style")
lowerColorInput = input.color(BEAR_COLOR, "Lower Band", group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Half the bar's range expressed as a fraction of its midpoint - wide bars push the bands apart before averaging
rangeDenom = high + low
rangeRatio = rangeDenom != 0 ? (high - low) / rangeDenom : 0.0

upperBand = ta.sma(high * (1 + factorInput * rangeRatio), lengthInput)
lowerBand = ta.sma(low * (1 - factorInput * rangeRatio), lengthInput)
midline   = ta.sma(close, lengthInput)

// Classic rule state: enter after two consecutive closes outside a band, exit on a close back inside it
twoAbove = close > upperBand and close[1] > upperBand[1]
twoBelow = close < lowerBand and close[1] < lowerBand[1]

var int accelPhase = 0

bullBreakout = twoAbove and accelPhase != 1
bearBreakout = twoBelow and accelPhase != -1
bullExit     = accelPhase == 1 and close < upperBand
bearExit     = accelPhase == -1 and close > lowerBand

if bullBreakout
    accelPhase := 1
else if bearBreakout
    accelPhase := -1
else if bullExit or bearExit
    accelPhase := 0

midCrossUp   = ta.crossover(close, midline)
midCrossDown = ta.crossunder(close, midline)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
upperPlotId = plot(upperBand, "Upper Band", upperColorInput)
midPlotId   = plot(midline, "Midline", midColorInput)
lowerPlotId = plot(lowerBand, "Lower Band", lowerColorInput)

upperEdgeTransp = highlightPhaseInput and accelPhase == 1 ? FILL_PHASE_TRANSP : FILL_EDGE_TRANSP
lowerEdgeTransp = highlightPhaseInput and accelPhase == -1 ? FILL_PHASE_TRANSP : FILL_EDGE_TRANSP

upperEdgeColor   = showFillInput ? color.new(upperColorInput, upperEdgeTransp) : na
upperCenterColor = showFillInput ? color.new(upperColorInput, FILL_CENTER_TRANSP) : na
lowerEdgeColor   = showFillInput ? color.new(lowerColorInput, lowerEdgeTransp) : na
lowerCenterColor = showFillInput ? color.new(lowerColorInput, FILL_CENTER_TRANSP) : na

fill(midPlotId, upperPlotId, upperBand, midline, upperEdgeColor, upperCenterColor, title = "Upper Band Fill")
fill(midPlotId, lowerPlotId, midline, lowerBand, lowerCenterColor, lowerEdgeColor, title = "Lower Band Fill")

plotshape(showMarkersInput and bullBreakout, "Bullish Breakout", shape.triangleup, location.belowbar, upperColorInput, size = size.tiny)
plotshape(showMarkersInput and bearBreakout, "Bearish Breakout", shape.triangledown, location.abovebar, lowerColorInput, size = size.tiny)
plotshape(showMarkersInput and bullExit, "Bullish Breakout Exit", shape.xcross, location.abovebar, upperColorInput, size = size.tiny)
plotshape(showMarkersInput and bearExit, "Bearish Breakout Exit", shape.xcross, location.belowbar, lowerColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullBreakout, "Bullish Breakout", "acceleration bands: two consecutive closes above the upper band on {{ticker}} ({{interval}}) - bullish acceleration phase started")
alertcondition(bearBreakout, "Bearish Breakout", "acceleration bands: two consecutive closes below the lower band on {{ticker}} ({{interval}}) - bearish acceleration phase started")
alertcondition(bullExit, "Bullish Breakout Exit", "acceleration bands: close back inside the upper band on {{ticker}} ({{interval}}) - bullish acceleration phase ended")
alertcondition(bearExit, "Bearish Breakout Exit", "acceleration bands: close back inside the lower band on {{ticker}} ({{interval}}) - bearish acceleration phase ended")
alertcondition(midCrossUp, "Close Crossed Over Midline", "acceleration bands: close crossed over the midline on {{ticker}} ({{interval}})")
alertcondition(midCrossDown, "Close Crossed Under Midline", "acceleration bands: close crossed under the midline on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
