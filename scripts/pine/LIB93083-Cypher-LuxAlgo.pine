//@version=6
indicator("Cypher", "Cypher", overlay = true, max_lines_count = 500, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

int MAX_SWINGS = 10

int STATUS_NONE      = -1
int STATUS_AWAITING  = 0
int STATUS_COMPLETED = 1
int STATUS_INVALID   = 2
int STATUS_TARGET    = 3

string DETECTION_GROUP = 'Swing Detection'
string RULES_GROUP     = 'Cypher Rules'
string TARGETS_GROUP   = 'Trade Levels'
string STYLE_GROUP     = 'Style'

color TRANSPARENT_COLOR = #00000000

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{

swingLengthInput = input.int(8, 'Swing Length', minval = 2, maxval = 50, group = DETECTION_GROUP, tooltip = 'Pivot length used to detect the swing points forming the X, A, B and C points. Larger values return larger and rarer Cypher structures.')

bXaMinInput = input.float(0.382, 'B / XA Retracement', inline = 'bxa', minval = 0, maxval = 1, step = 0.001, group = RULES_GROUP, tooltip = 'Lower bound of the B retracement of the XA leg. The reference range is 0.382 to 0.618, the range platforms disagree on the most; a deeper B disqualifies the pattern in most rule sets.')
bXaMaxInput = input.float(0.618, '', inline = 'bxa', minval = 0, maxval = 1, step = 0.001, group = RULES_GROUP, tooltip = 'Upper bound of the B retracement of the XA leg.')

cXaMinInput = input.float(1.272, 'C / XA Extension', inline = 'cxa', minval = 1, step = 0.001, group = RULES_GROUP, tooltip = 'Lower bound of the C extension of XA, measured from the X origin. C must push past the A extreme, with the reference range at 1.272 to 1.414; a C holding inside XA points to Gartley-family patterns instead.')
cXaMaxInput = input.float(1.414, '', inline = 'cxa', minval = 1, step = 0.001, group = RULES_GROUP, tooltip = 'Upper bound of the C extension of XA, measured from the X origin.')

dXcInput = input.float(0.786, 'D / XC Retracement', minval = 0.05, maxval = 0.95, step = 0.001, group = RULES_GROUP, tooltip = 'Retracement of the full XC swing, drawn from the X origin to the C extreme, that marks the D completion level. Keying D off XC rather than XA is the defining Cypher rule and the measurement most often done wrong.')

target1Input = input.float(0.382, 'Target 1 (CD Retracement)', minval = 0.05, maxval = 1, step = 0.001, group = TARGETS_GROUP, tooltip = 'First staged target as a retracement of the CD leg back toward C, where common practice takes partial profit. The reference value is 0.382.')
target2Input = input.float(0.618, 'Target 2 (CD Retracement)', minval = 0.05, maxval = 1, step = 0.001, group = TARGETS_GROUP, tooltip = 'Second staged target as a retracement of the CD leg, with the remainder held toward the C extreme. The reference value is 0.618.')

bullColorInput    = input.color(#089981, 'Bullish Patterns', group = STYLE_GROUP, inline = 'colors')
bearColorInput    = input.color(#f23645, 'Bearish Patterns', group = STYLE_GROUP, inline = 'colors')
invalidColorInput = input.color(#787b86, 'Invalidated', group = STYLE_GROUP)

showLabelsInput  = input.bool(true, 'Point Labels', group = STYLE_GROUP)
showRatiosInput  = input.bool(true, 'Ratio Labels', group = STYLE_GROUP)
showTargetsInput = input.bool(true, 'Target Lines', group = STYLE_GROUP)
showStopInput    = input.bool(true, 'X Stop Line', group = STYLE_GROUP)

showSwingsInput = input.bool(true, 'Show Swings', group = STYLE_GROUP, inline = 'swings')
swingColorInput = input.color(color.new(#787b86, 50), '', group = STYLE_GROUP, inline = 'swings')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// registers a confirmed pivot into the swing zigzag, returns 0 = no change, 1 = new swing point, 2 = last swing point extended
f_addPivot(array<float> priceArray, array<int> barArray, array<int> dirArray, float pivotPrice, int pivotBar, int pivotDir, int maxSize) =>
    int changeType = 0
    int n = array.size(priceArray)
    if n == 0
        array.push(priceArray, pivotPrice)
        array.push(barArray, pivotBar)
        array.push(dirArray, pivotDir)
        changeType := 1
    else if pivotDir == array.get(dirArray, n - 1)
        float lastPrice = array.get(priceArray, n - 1)
        if (pivotDir == 1 and pivotPrice >= lastPrice) or (pivotDir == -1 and pivotPrice <= lastPrice)
            array.set(priceArray, n - 1, pivotPrice)
            array.set(barArray, n - 1, pivotBar)
            changeType := 2
    else
        array.push(priceArray, pivotPrice)
        array.push(barArray, pivotBar)
        array.push(dirArray, pivotDir)
        changeType := 1
        if array.size(priceArray) > maxSize
            array.shift(priceArray)
            array.shift(barArray)
            array.shift(dirArray)
    changeType

// draws or extends the faint zigzag segment joining the two most recent swing points
f_swingSegment(array<float> priceArray, array<int> barArray, int changeType, line previousSegment) =>
    line segment = previousSegment
    if showSwingsInput
        int n = array.size(priceArray)
        if changeType == 1 and n >= 2
            segment := line.new(array.get(barArray, n - 2), array.get(priceArray, n - 2), array.get(barArray, n - 1), array.get(priceArray, n - 1), color = swingColorInput, style = line.style_dotted)
        else if changeType == 2 and not na(previousSegment)
            line.set_xy2(previousSegment, array.get(barArray, n - 1), array.get(priceArray, n - 1))
    segment

// removes every drawing belonging to a projection that never completed
f_deleteDrawings(array<line> staticLineArray, array<label> staticLabelArray, array<line> levelLineArray, array<label> levelLabelArray) =>
    int staticLineCount = array.size(staticLineArray)
    if staticLineCount > 0
        for i = 0 to staticLineCount - 1
            line.delete(array.get(staticLineArray, i))
    int staticLabelCount = array.size(staticLabelArray)
    if staticLabelCount > 0
        for i = 0 to staticLabelCount - 1
            label.delete(array.get(staticLabelArray, i))
    int levelLineCount = array.size(levelLineArray)
    if levelLineCount > 0
        for i = 0 to levelLineCount - 1
            line.delete(array.get(levelLineArray, i))
    int levelLabelCount = array.size(levelLabelArray)
    if levelLabelCount > 0
        for i = 0 to levelLabelCount - 1
            label.delete(array.get(levelLabelArray, i))
    array.clear(staticLineArray)
    array.clear(staticLabelArray)
    array.clear(levelLineArray)
    array.clear(levelLabelArray)

// keeps the completion level, stop and target lines anchored to the latest bar while the pattern is live
f_extendLevels(array<line> levelLineArray, array<label> levelLabelArray) =>
    int levelLineCount = array.size(levelLineArray)
    if levelLineCount > 0
        for i = 0 to levelLineCount - 1
            line.set_x2(array.get(levelLineArray, i), bar_index)
    int levelLabelCount = array.size(levelLabelArray)
    if levelLabelCount > 0
        for i = 0 to levelLabelCount - 1
            label.set_x(array.get(levelLabelArray, i), bar_index)

// draws the CD leg, the D label and the staged target lines once price trades into the 0.786 XC level
f_drawCompletion(array<line> staticLineArray, array<label> staticLabelArray, array<line> levelLineArray, array<label> levelLabelArray, int barC, float priceC, int barD, float lvlD, float lvlT1, float lvlT2, bool isBull, color patternColor) =>
    array.push(staticLineArray, line.new(barC, priceC, barD, lvlD, color = patternColor, width = 2))
    if showLabelsInput
        array.push(staticLabelArray, label.new(barD, lvlD, 'D', color = TRANSPARENT_COLOR, textcolor = patternColor, style = isBull ? label.style_label_up : label.style_label_down, size = size.small))
    if showTargetsInput
        array.push(levelLineArray, line.new(barD, lvlT1, bar_index, lvlT1, color = color.new(patternColor, 30), style = line.style_dotted))
        array.push(levelLineArray, line.new(barD, lvlT2, bar_index, lvlT2, color = color.new(patternColor, 30), style = line.style_dotted))
        array.push(levelLineArray, line.new(barD, priceC, bar_index, priceC, color = color.new(patternColor, 30), style = line.style_dotted))
        if showRatiosInput
            array.push(levelLabelArray, label.new(bar_index, lvlT1, str.tostring(target1Input, '#.###') + ' × CD', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_left, size = size.tiny))
            array.push(levelLabelArray, label.new(bar_index, lvlT2, str.tostring(target2Input, '#.###') + ' × CD', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_left, size = size.tiny))
            array.push(levelLabelArray, label.new(bar_index, priceC, 'C extreme', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_left, size = size.tiny))

// fades the level lines and their texts once a decisive close beyond X kills the trade frame
f_markInvalid(array<line> levelLineArray, array<label> levelLabelArray, color invalidColor) =>
    int levelLineCount = array.size(levelLineArray)
    if levelLineCount > 0
        for i = 0 to levelLineCount - 1
            line levelLine = array.get(levelLineArray, i)
            line.set_color(levelLine, color.new(invalidColor, 30))
            line.set_style(levelLine, line.style_dashed)
    int levelLabelCount = array.size(levelLabelArray)
    if levelLabelCount > 0
        for i = 0 to levelLabelCount - 1
            label.set_textcolor(array.get(levelLabelArray, i), color.new(invalidColor, 20))

//---------------------------------------------------------------------------------------------------------------------}
// Swing Detection
//---------------------------------------------------------------------------------------------------------------------{

var array<float> swingPriceArray = array.new<float>()
var array<int>   swingBarArray   = array.new<int>()
var array<int>   swingDirArray   = array.new<int>()

var line lastSwingSegment = na

float pivotHigh = ta.pivothigh(swingLengthInput, swingLengthInput)
float pivotLow  = ta.pivotlow(swingLengthInput, swingLengthInput)

int swingChange = 0
if not na(pivotHigh)
    int changeType = f_addPivot(swingPriceArray, swingBarArray, swingDirArray, pivotHigh, bar_index - swingLengthInput, 1, MAX_SWINGS)
    if changeType != 0
        swingChange := changeType
        lastSwingSegment := f_swingSegment(swingPriceArray, swingBarArray, changeType, lastSwingSegment)
if not na(pivotLow)
    int changeType = f_addPivot(swingPriceArray, swingBarArray, swingDirArray, pivotLow, bar_index - swingLengthInput, -1, MAX_SWINGS)
    if changeType != 0
        swingChange := changeType
        lastSwingSegment := f_swingSegment(swingPriceArray, swingBarArray, changeType, lastSwingSegment)

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{

var int   patStatus  = STATUS_NONE
var int   patKey     = -1
var bool  patIsBull  = false
var float patPriceX  = na
var float patPriceC  = na
var int   patBarC    = na
var float patLvlD    = na
var float patLvlT1   = na
var float patLvlT2   = na
var bool  patReacted = false
var bool  patT1Hit   = false
var bool  patT2Hit   = false

var array<line>  patLineArray       = array.new<line>()
var array<label> patLabelArray      = array.new<label>()
var array<line>  patLevelLineArray  = array.new<line>()
var array<label> patLevelLabelArray = array.new<label>()

bool bullSetupAlert    = false
bool bearSetupAlert    = false
bool bullCompleteAlert = false
bool bearCompleteAlert = false
bool bullReactionAlert = false
bool bearReactionAlert = false
bool bullInvalidAlert  = false
bool bearInvalidAlert  = false
bool bullTarget1Alert  = false
bool bearTarget1Alert  = false
bool bullTarget2Alert  = false
bool bearTarget2Alert  = false
bool bullTargetCAlert  = false
bool bearTargetCAlert  = false

if swingChange != 0 and array.size(swingPriceArray) >= 4
    int n = array.size(swingPriceArray)
    float pX = array.get(swingPriceArray, n - 4)
    float pA = array.get(swingPriceArray, n - 3)
    float pB = array.get(swingPriceArray, n - 2)
    float pC = array.get(swingPriceArray, n - 1)
    int   bX = array.get(swingBarArray, n - 4)
    int   bA = array.get(swingBarArray, n - 3)
    int   bB = array.get(swingBarArray, n - 2)
    int   bC = array.get(swingBarArray, n - 1)
    bool  isBull = array.get(swingDirArray, n - 1) == 1
    float s = isBull ? 1 : -1

    // legs measured as positive price distances, the sign flips with the pattern direction
    float legXa   = s * (pA - pX)
    float xcSwing = s * (pC - pX)

    // an XA impulse, a B holding inside it, and a C that pushes past the A extreme
    bool geometryOk = legXa > 0 and s * (pA - pB) > 0 and s * (pB - pX) > 0 and s * (pC - pA) > 0

    if geometryOk
        float bRetracement = s * (pA - pB) / legXa
        float cExtension   = xcSwing / legXa

        bool ratiosOk = bRetracement >= bXaMinInput and bRetracement <= bXaMaxInput and cExtension >= cXaMinInput and cExtension <= cXaMaxInput

        int setupKey = bB * 2 + (isBull ? 1 : 0)

        if ratiosOk and not (setupKey == patKey and patStatus >= STATUS_COMPLETED)
            // a stale awaiting projection is removed, anything already resolved stays on the chart
            if patStatus == STATUS_AWAITING
                f_deleteDrawings(patLineArray, patLabelArray, patLevelLineArray, patLevelLabelArray)
            else
                array.clear(patLineArray)
                array.clear(patLabelArray)
                array.clear(patLevelLineArray)
                array.clear(patLevelLabelArray)

            color patternColor = isBull ? bullColorInput : bearColorInput

            patIsBull  := isBull
            patPriceX  := pX
            patPriceC  := pC
            patBarC    := bC
            patLvlD    := pC - s * dXcInput * xcSwing
            float cdLeg = s * (pC - patLvlD)
            patLvlT1   := patLvlD + s * target1Input * cdLeg
            patLvlT2   := patLvlD + s * target2Input * cdLeg
            patReacted := false
            patT1Hit   := false
            patT2Hit   := false
            patStatus  := STATUS_AWAITING

            array.push(patLineArray, line.new(bX, pX, bA, pA, color = patternColor, width = 2))
            array.push(patLineArray, line.new(bA, pA, bB, pB, color = patternColor, width = 2))
            array.push(patLineArray, line.new(bB, pB, bC, pC, color = patternColor, width = 2))

            if showLabelsInput
                string acSideStyle  = isBull ? label.style_label_down : label.style_label_up
                string xbdSideStyle = isBull ? label.style_label_up : label.style_label_down
                array.push(patLabelArray, label.new(bX, pX, 'X', color = TRANSPARENT_COLOR, textcolor = patternColor, style = xbdSideStyle, size = size.small))
                array.push(patLabelArray, label.new(bA, pA, 'A', color = TRANSPARENT_COLOR, textcolor = patternColor, style = acSideStyle, size = size.small))
                array.push(patLabelArray, label.new(bB, pB, 'B', color = TRANSPARENT_COLOR, textcolor = patternColor, style = xbdSideStyle, size = size.small))
                array.push(patLabelArray, label.new(bC, pC, 'C', color = TRANSPARENT_COLOR, textcolor = patternColor, style = acSideStyle, size = size.small))

            // the raw measurements, so the label can be checked instead of trusted
            if showRatiosInput
                array.push(patLabelArray, label.new(math.round(math.avg(bA, bB)), math.avg(pA, pB), str.tostring(bRetracement, '#.###') + ' × XA', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_center, size = size.tiny))
                array.push(patLabelArray, label.new(math.round(math.avg(bB, bC)), math.avg(pB, pC), str.tostring(cExtension, '#.###') + ' × XA', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_center, size = size.tiny))

            array.push(patLevelLineArray, line.new(bC, patLvlD, bar_index, patLvlD, color = patternColor, style = line.style_dotted))
            if showRatiosInput
                array.push(patLevelLabelArray, label.new(bar_index, patLvlD, str.tostring(dXcInput, '#.###') + ' × XC', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_left, size = size.tiny))
            if showStopInput
                array.push(patLevelLineArray, line.new(bX, pX, bar_index, pX, color = color.new(invalidColorInput, 30), style = line.style_dashed))
                if showRatiosInput
                    array.push(patLevelLabelArray, label.new(bar_index, pX, 'X stop', color = TRANSPARENT_COLOR, textcolor = color.new(invalidColorInput, 20), style = label.style_label_left, size = size.tiny))

            if setupKey != patKey
                bullSetupAlert := isBull
                bearSetupAlert := not isBull
            patKey := setupKey

            // events that already played out inside the pivot confirmation lag
            int  scanStatus  = STATUS_AWAITING
            int  scanBarD    = na
            bool scanReacted = false
            bool scanT1      = false
            bool scanT2      = false
            for j = 1 to swingLengthInput - 1
                int off = swingLengthInput - j
                if scanStatus == STATUS_AWAITING and (isBull ? low[off] <= patLvlD : high[off] >= patLvlD)
                    scanStatus := STATUS_COMPLETED
                    scanBarD   := bar_index - off
                if scanStatus == STATUS_COMPLETED
                    if isBull ? close[off] < patPriceX : close[off] > patPriceX
                        scanStatus := STATUS_INVALID
                    else
                        if not scanReacted and (isBull ? close[off] > patLvlD : close[off] < patLvlD)
                            scanReacted := true
                        if not scanT1 and (isBull ? high[off] >= patLvlT1 : low[off] <= patLvlT1)
                            scanT1 := true
                        if not scanT2 and (isBull ? high[off] >= patLvlT2 : low[off] <= patLvlT2)
                            scanT2 := true
                        if isBull ? high[off] >= patPriceC : low[off] <= patPriceC
                            scanStatus := STATUS_TARGET

            if scanStatus >= STATUS_COMPLETED
                patStatus  := scanStatus
                patReacted := scanReacted
                patT1Hit   := scanT1
                patT2Hit   := scanT2
                f_drawCompletion(patLineArray, patLabelArray, patLevelLineArray, patLevelLabelArray, patBarC, patPriceC, scanBarD, patLvlD, patLvlT1, patLvlT2, patIsBull, patternColor)
                bullCompleteAlert := isBull
                bearCompleteAlert := not isBull
                if scanReacted
                    bullReactionAlert := isBull
                    bearReactionAlert := not isBull
                if scanT1
                    bullTarget1Alert := isBull
                    bearTarget1Alert := not isBull
                if scanT2
                    bullTarget2Alert := isBull
                    bearTarget2Alert := not isBull
                if patStatus == STATUS_INVALID
                    f_markInvalid(patLevelLineArray, patLevelLabelArray, invalidColorInput)
                    bullInvalidAlert := isBull
                    bearInvalidAlert := not isBull
                if patStatus == STATUS_TARGET
                    bullTargetCAlert := isBull
                    bearTargetCAlert := not isBull

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Monitoring
//---------------------------------------------------------------------------------------------------------------------{

// keep the live completion level, stop and target lines anchored to the latest bar
if patStatus == STATUS_AWAITING or patStatus == STATUS_COMPLETED
    f_extendLevels(patLevelLineArray, patLevelLabelArray)

if patStatus == STATUS_AWAITING
    bool touched = patIsBull ? low <= patLvlD : high >= patLvlD
    bool beyondC = patIsBull ? high > patPriceC : low < patPriceC
    if touched
        color activeColor = patIsBull ? bullColorInput : bearColorInput
        patStatus := STATUS_COMPLETED
        f_drawCompletion(patLineArray, patLabelArray, patLevelLineArray, patLevelLabelArray, patBarC, patPriceC, bar_index, patLvlD, patLvlT1, patLvlT2, patIsBull, activeColor)
        bullCompleteAlert := patIsBull
        bearCompleteAlert := not patIsBull
    else if beyondC
        // price ran beyond the C extreme before pulling back into the level, the projection is stale
        f_deleteDrawings(patLineArray, patLabelArray, patLevelLineArray, patLevelLabelArray)
        patStatus := STATUS_NONE

if patStatus == STATUS_COMPLETED
    bool invalidClose = patIsBull ? close < patPriceX : close > patPriceX
    if invalidClose
        patStatus := STATUS_INVALID
        f_markInvalid(patLevelLineArray, patLevelLabelArray, invalidColorInput)
        bullInvalidAlert := patIsBull
        bearInvalidAlert := not patIsBull
    else
        if not patReacted and (patIsBull ? close > patLvlD : close < patLvlD)
            patReacted := true
            bullReactionAlert := patIsBull
            bearReactionAlert := not patIsBull
        if not patT1Hit and (patIsBull ? high >= patLvlT1 : low <= patLvlT1)
            patT1Hit := true
            bullTarget1Alert := patIsBull
            bearTarget1Alert := not patIsBull
        if not patT2Hit and (patIsBull ? high >= patLvlT2 : low <= patLvlT2)
            patT2Hit := true
            bullTarget2Alert := patIsBull
            bearTarget2Alert := not patIsBull
        if patIsBull ? high >= patPriceC : low <= patPriceC
            patStatus := STATUS_TARGET
            bullTargetCAlert := patIsBull
            bearTargetCAlert := not patIsBull

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bullSetupAlert, 'Bullish Cypher Setup', 'Bullish Cypher: B and C ratios qualified, D completion projected at the 0.786 retracement of the XC swing')
alertcondition(bearSetupAlert, 'Bearish Cypher Setup', 'Bearish Cypher: B and C ratios qualified, D completion projected at the 0.786 retracement of the XC swing')
alertcondition(bullCompleteAlert, 'Bullish Cypher Completion', 'Bullish Cypher completed: price traded into the 0.786 retracement of XC, watch for reaction in the direction of the C leg')
alertcondition(bearCompleteAlert, 'Bearish Cypher Completion', 'Bearish Cypher completed: price traded into the 0.786 retracement of XC, watch for reaction in the direction of the C leg')
alertcondition(bullReactionAlert, 'Bullish Cypher Reaction', 'Bullish Cypher reaction: price closed back above the D level in the direction of the C leg')
alertcondition(bearReactionAlert, 'Bearish Cypher Reaction', 'Bearish Cypher reaction: price closed back below the D level in the direction of the C leg')
alertcondition(bullInvalidAlert, 'Bullish Cypher Invalidation', 'Bullish Cypher invalidated: decisive close below the X origin behind the completion level')
alertcondition(bearInvalidAlert, 'Bearish Cypher Invalidation', 'Bearish Cypher invalidated: decisive close above the X origin behind the completion level')
alertcondition(bullTarget1Alert, 'Bullish Cypher Target 1', 'Bullish Cypher target 1 reached: 0.382 retracement of the CD leg')
alertcondition(bearTarget1Alert, 'Bearish Cypher Target 1', 'Bearish Cypher target 1 reached: 0.382 retracement of the CD leg')
alertcondition(bullTarget2Alert, 'Bullish Cypher Target 2', 'Bullish Cypher target 2 reached: 0.618 retracement of the CD leg')
alertcondition(bearTarget2Alert, 'Bearish Cypher Target 2', 'Bearish Cypher target 2 reached: 0.618 retracement of the CD leg')
alertcondition(bullTargetCAlert, 'Bullish Cypher Final Target', 'Bullish Cypher final target reached: price returned to the C extreme')
alertcondition(bearTargetCAlert, 'Bearish Cypher Final Target', 'Bearish Cypher final target reached: price returned to the C extreme')

//---------------------------------------------------------------------------------------------------------------------}
