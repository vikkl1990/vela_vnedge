//@version=6
indicator("Money Flow Index", "MFI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SETTINGS_GROUP = "Settings"
STYLE_GROUP    = "Style"
BULL_COLOR     = #089981 // oversold side - readings at or below the oversold level
BEAR_COLOR     = #f23645 // overbought side - readings at or above the overbought level
NEUTRAL_COLOR  = #787b86 // readings between the levels, and the levels themselves
LEVEL_COLOR    = NEUTRAL_COLOR
ZONE_TRANSP    = 91 // transparency of the soft overbought / oversold zone shading

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Number of bars used to sum positive and negative money flow.")

obLevelInput = input.float(80, "Overbought Level", minval = 0, maxval = 100, step = 1, group = SETTINGS_GROUP, tooltip = "Level above which the MFI is considered overbought.")
osLevelInput = input.float(20, "Oversold Level", minval = 0, maxval = 100, step = 1, group = SETTINGS_GROUP, tooltip = "Level below which the MFI is considered oversold.")

mfiColorInput  = input.color(NEUTRAL_COLOR, "MFI", group = STYLE_GROUP, tooltip = "Color of the MFI line while it sits between the levels. Toward either level the color blends into the overbought or oversold color.")
obColorInput   = input.color(BEAR_COLOR, "Overbought", inline = "zones", group = STYLE_GROUP, tooltip = "Color of the line and zone shading at and above the overbought level.")
osColorInput   = input.color(BULL_COLOR, "Oversold", inline = "zones", group = STYLE_GROUP, tooltip = "Color of the line and zone shading at and below the oversold level.")
fillColorInput = input.color(color.new(NEUTRAL_COLOR, 94), "OB/OS Zone Fill", group = STYLE_GROUP, tooltip = "Fill color of the area between the overbought and oversold levels.")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
typicalPrice = hlc3
tpChange     = ta.change(typicalPrice)
rawMoneyFlow = typicalPrice * volume

posMoneyFlow   = math.sum(tpChange > 0 ? rawMoneyFlow : 0, lengthInput)
negMoneyFlow   = math.sum(tpChange < 0 ? rawMoneyFlow : 0, lengthInput)
totalMoneyFlow = posMoneyFlow + negMoneyFlow

mfi = totalMoneyFlow > 0 ? 100 * posMoneyFlow / totalMoneyFlow : float(na)

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
//State coloring across the levels - oversold color below, neutral midway, overbought color above
midLevel = (obLevelInput + osLevelInput) / 2
mfiColor = na(mfi) ? mfiColorInput : mfi <= midLevel ? color.from_gradient(mfi, osLevelInput, midLevel, osColorInput, mfiColorInput) : color.from_gradient(mfi, midLevel, obLevelInput, mfiColorInput, obColorInput)

plot(mfi, "MFI", mfiColor, style = plot.style_linebr)

obHline = hline(obLevelInput, "Overbought", LEVEL_COLOR, hline.style_dashed)
osHline = hline(osLevelInput, "Oversold", LEVEL_COLOR, hline.style_dashed)

//Zone shading anchored on hidden plots - overbought band above, oversold band below, faint neutral band between
obAnchorId  = plot(obLevelInput, "Overbought Anchor", color(na), editable = false, display = display.none)
osAnchorId  = plot(osLevelInput, "Oversold Anchor", color(na), editable = false, display = display.none)
topAnchorId = plot(100, "Top Anchor", color(na), editable = false, display = display.none)
botAnchorId = plot(0, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obAnchorId, osAnchorId, fillColorInput, "OB/OS Zone")
fill(obAnchorId, topAnchorId, color.new(obColorInput, ZONE_TRANSP), "Overbought Zone")
fill(osAnchorId, botAnchorId, color.new(osColorInput, ZONE_TRANSP), "Oversold Zone")

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
enterOverbought = ta.crossover(mfi, obLevelInput)
exitOverbought  = ta.crossunder(mfi, obLevelInput)
enterOversold   = ta.crossunder(mfi, osLevelInput)
exitOversold    = ta.crossover(mfi, osLevelInput)

alertcondition(enterOverbought, "Enter Overbought", "MFI crossed above the overbought level")
alertcondition(exitOverbought, "Exit Overbought", "MFI crossed below the overbought level")
alertcondition(enterOversold, "Enter Oversold", "MFI crossed below the oversold level")
alertcondition(exitOversold, "Exit Oversold", "MFI crossed above the oversold level")
//----------------------------------------------------------------------------------------------------------------------}
