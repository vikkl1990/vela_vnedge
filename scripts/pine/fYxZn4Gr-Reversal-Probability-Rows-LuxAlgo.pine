//@version=6
indicator("Reversal Probability Rows [LuxAlgo]", "LuxAlgo - Reversal Probability Rows", overlay = true, max_boxes_count = 500, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
string CALC_GRP   = 'Calculation Settings'
int lookbackInput = input.int(500, "Range Period", minval = 10, group = CALC_GRP, tooltip = "The number of historical bars to look back for the price range and probability calculations.")
int rowsInput     = input.int(10, "Number of Rows", minval = 2, maxval = 50, group = CALC_GRP, tooltip = "Number of equidistant rows to divide the range into.")
int pivotInput    = input.int(3, "Pivot Sensitivity", minval = 1, group = CALC_GRP, tooltip = "Sensitivity for detecting tops and bottoms (left/right bars).")

string VIS_GRP    = 'Visualization Settings'
bool showMarkersInput = input.bool(true, "Show Pivot Markers", group = VIS_GRP, tooltip = "Highlight the tops and bottoms used for calculation within the lookback range.")
int widthInput    = input.int(20, "Box Width (Bars)", minval = 5, group = VIS_GRP, tooltip = "The width of the probability boxes to the right of the price.")
color rowColor    = input.color(color.new(color.gray, 90), "Row Highlight Color", group = VIS_GRP)

//---------------------------------------------------------------------------------------------------------------------}
// Logic
//---------------------------------------------------------------------------------------------------------------------{
// Pivot Detection
float ph = ta.pivothigh(pivotInput, pivotInput)
float pl = ta.pivotlow(pivotInput, pivotInput)

// Calculate range over history
float hi = ta.highest(high, lookbackInput)
float lo = ta.lowest(low, lookbackInput)

// Persistent arrays to track drawing objects for cleanup
var label[] labelArray = array.new_label()
var box[]   boxArray   = array.new_box()

// Only perform heavy calculations on the last bar
if barstate.islast
    // Cleanup previous drawings
    if array.size(labelArray) > 0
        for i = 0 to array.size(labelArray) - 1
            label.delete(array.get(labelArray, i))
        array.clear(labelArray)
    
    if array.size(boxArray) > 0
        for i = 0 to array.size(boxArray) - 1
            box.delete(array.get(boxArray, i))
        array.clear(boxArray)

    float rowHeight = (hi - lo) / rowsInput
    
    // Arrays to store counts for each row
    float[] topCounts    = array.new_float(rowsInput, 0)
    float[] bottomCounts = array.new_float(rowsInput, 0)
    float totalTops      = 0.0
    float totalBottoms   = 0.0

    // 1. Data Collection Phase
    for i = 0 to lookbackInput - 1
        float barPH = ph[i]
        float barPL = pl[i]

        // Only process pivots whose confirmation occurred within the lookback window
        if i + pivotInput < lookbackInput
            if not na(barPH)
                totalTops += 1
                if showMarkersInput
                    labelArray.push(label.new(bar_index - i - pivotInput, barPH, "•", color = #00000000, textcolor = BEAR_COLOR, style = label.style_label_center, size = size.large))
            if not na(barPL)
                totalBottoms += 1
                if showMarkersInput
                    labelArray.push(label.new(bar_index - i - pivotInput, barPL, "•", color = #00000000, textcolor = BULL_COLOR, style = label.style_label_center, size = size.large))

            // Map pivots to rows
            for r = 0 to rowsInput - 1
                float rHi = hi - (r * rowHeight)
                float rLo = rHi - rowHeight

                if not na(barPH) and barPH <= rHi and barPH >= rLo
                    array.set(topCounts, r, array.get(topCounts, r) + 1)
                if not na(barPL) and barPL <= rHi and barPL >= rLo
                    array.set(bottomCounts, r, array.get(bottomCounts, r) + 1)

    // 2. Rendering Phase
    float maxTops    = array.max(topCounts)
    float maxBottoms = array.max(bottomCounts)

    for r = 0 to rowsInput - 1
        float rHi = hi - (r * rowHeight)
        float rLo = rHi - rowHeight
        float tCount = array.get(topCounts, r)
        float bCount = array.get(bottomCounts, r)
        
        float prob = 0.0
        color boxColor = na
        float count = 0.0
        float maxCount = 1.0

        // Determine probability based on distribution and set relative strength for transparency
        if close < rLo // Resistance (Tops)
            prob := totalTops > 0 ? (tCount / totalTops) * 100 : 0
            boxColor := BEAR_COLOR
            count := tCount
            maxCount := maxTops
        else if close > rHi // Support (Bottoms)
            prob := totalBottoms > 0 ? (bCount / totalBottoms) * 100 : 0
            boxColor := BULL_COLOR
            count := bCount
            maxCount := maxBottoms
        else // Price is currently inside the row - choose dominant reversal type
            float tProb = totalTops > 0 ? (tCount / totalTops) * 100 : 0
            float bProb = totalBottoms > 0 ? (bCount / totalBottoms) * 100 : 0
            if tProb >= bProb
                prob := tProb
                boxColor := BEAR_COLOR
                count := tCount
                maxCount := maxTops
            else
                prob := bProb
                boxColor := BULL_COLOR
                count := bCount
                maxCount := maxBottoms

        // Calculate gradient transparency (higher value = more solid)
        float transp = maxCount > 0 ? 90 - (count / maxCount * 50) : 90

        // Draw Row Range
        boxArray.push(box.new(
             bar_index - lookbackInput + 1, rHi, bar_index, rLo,
             bgcolor = rowColor,
             border_color = color.new(rowColor, 60),
             border_style = line.style_dotted
             ))

        // Draw Probability Dashboard with gradient transparency
        int xStart = bar_index + 2
        int xEnd   = bar_index + 2 + widthInput
        
        boxArray.push(box.new(
             xStart, rHi, xEnd, rLo,
             bgcolor = color.new(boxColor, transp),
             border_color = color.new(boxColor, math.max(0, transp - 20)),
             text = str.format("{0,number,#.##}%", prob),
             text_color = boxColor,
             text_size = size.small,
             text_halign = text.align_center,
             text_valign = text.align_center
             ))

//---------------------------------------------------------------------------------------------------------------------}
