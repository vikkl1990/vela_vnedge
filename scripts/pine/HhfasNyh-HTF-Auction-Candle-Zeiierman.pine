indicator("HTF Auction Candle (Zeiierman)", overlay = true, max_bars_back = 2500, max_lines_count = 100, max_labels_count = 100, max_boxes_count = 300, max_polylines_count = 20)

// ~~ Tooltips {
var tHtf = "Selects the higher timeframe reconstructed as the live candle. Its open, high, low, close, profile, delta, and control price update while the HTF candle is forming."
var tAutoLtf = "Automatically selects a lower timeframe close to the chart timeframe while remaining below it whenever a lower supported interval exists. Common mappings include 1m -> 45s, 2m -> 1m, 3m -> 2m, 15m -> 10m, 1h -> 45m, and 4h -> 3h. When enabled, the Manual LTF input is ignored."
var tLtf = "Manual lower timeframe used to build the auction profile when Auto LTF is turned off. It must be below the selected HTF and no higher than the chart timeframe."
var tRows = "Number of vertical price cells used across the current HTF high-to-low range. More cells give finer price detail but increase realtime calculation and drawing work."
var tFocus = "Controls how tightly each LTF candle's estimated buy and sell volume is concentrated around its directional activity centers. Higher values produce more concentrated row distributions."
var tSamples = "Maximum number of stored LTF samples for the current HTF candle. When this limit is exceeded, adjacent samples are merged to keep realtime processing bounded."
var tGap = "Horizontal distance in chart bars between the newest chart bar and the auction structure. Increase it to create more visual separation from live price."
var tBodyWidth = "Half-width of the reconstructed HTF candle body in chart bars. A value of 2 draws the body two bars to each side of the wick center."
var tBull = "Body and border color used when the current HTF close is greater than or equal to its open."
var tBear = "Body and border color used when the current HTF close is below its open."
var tWick = "Color used for the reconstructed HTF candle wick."
var tBodyFade = "Transparency of the reconstructed HTF candle body fill. Higher values make the body more transparent while preserving its border."
var tShowWings = "Shows or hides the buy and sell volume silhouettes. Turning this off does not disable delta, the candle, control price, anchored lines, or calculations."
var tWingWidth = "Maximum horizontal width of each volume wing in chart bars. Sell volume extends left and buy volume extends right from the HTF candle."
var tBuyWing = "Color used for the buy-side volume silhouette on the right side of the HTF candle."
var tSellWing = "Color used for the sell-side volume silhouette on the left side of the HTF candle."
var tWingFade = "Transparency of the buy and sell volume wing fills. Higher values make the wings more transparent while keeping their outlines visible."
var tShowDelta = "Shows or hides row-by-row delta dominance. Positive delta extends right and negative delta extends left independently of whether the volume wings are visible."
var tDeltaWidth = "Maximum horizontal width of the delta bars in chart bars. Each row scales from one bar up to this width according to its absolute delta strength."
var tPosDelta = "Color used for positive delta rows where estimated buy volume exceeds estimated sell volume."
var tNegDelta = "Color used for negative delta rows where estimated sell volume exceeds estimated buy volume."
var tControl = "Shows or hides the live control price. The control row is the price cell with the highest combined estimated buy and sell volume."
var tCaps = "Shows or hides the anchored HTF high and low lines. Each line begins at the chart bar that first created the current HTF extreme and ends exactly at the reconstructed wick."
var tLineCol = "Color used for both anchored HTF high and low lines."
var tLineStyle = "Line style used for both anchored HTF high and low lines."
var tLineWidth = "Thickness used for both anchored HTF high and low lines."
var tHeader = "Shows or hides the live information label above the auction structure. It displays HTF, LTF, estimated delta, intrabar count, and compression state when applicable."
var tShowBattle = "Shows or hides the 20-segment battle bubbles. Each bubble is aligned with one equal price segment of the current HTF range. Green marks a buyer win and red marks a seller win. Bubble size represents normalized battle strength."
var tBattleGap = "Horizontal distance in chart bars between the right edge of the auction profile and the battle-bubble column."
var tBattleMin = "Minimum bubble diameter used for the weakest visible battle segment."
var tBattleMax = "Maximum bubble diameter used for the strongest battle segment in the current HTF candle."
var tBattleBuy = "Color used when buyers win a battle segment."
var tBattleSell = "Color used when sellers win a battle segment."
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Groups {
var gTf = "01. Timeframes"
var gProf = "02. Profile Engine"
var gLayout = "03. Layout"
var gCandle = "04. HTF Candle"
var gWings = "05. Volume Wings"
var gDelta = "06. Delta"
var gLevels = "07. Levels"
var gHeader = "08. Header"
var gBattle = "09. Battle Bubbles"
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Timeframes {
htfTf = input.timeframe("240", "Higher Timeframe", group = gTf, tooltip = tHtf)
autoLtf = input.bool(true, "Auto LTF", inline = "ltf", group = gTf, tooltip = tAutoLtf)
manualLtfTf = input.timeframe("1", "Manual LTF", inline = "ltf", group = gTf, tooltip = tLtf, active = not autoLtf)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Profile Engine {
rows = input.int(72, "Price Cells", minval = 24, maxval = 160, group = gProf, tooltip = tRows)
focus = input.float(2.15, "Cell Concentration", minval = 0.25, maxval = 6.0, step = 0.05, group = gProf, tooltip = tFocus)
maxSamples = input.int(3000, "LTF Sample Capacity", minval = 250, maxval = 12000, group = gProf, tooltip = tSamples)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Layout {
gap = input.int(5, "Gap From Price", minval = 2, maxval = 40, group = gLayout, tooltip = tGap)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: HTF Candle {
bodyHalfWidth = input.int(2, "Body Half-Width", minval = 1, maxval = 5, group = gCandle, tooltip = tBodyWidth)
bullCol = input.color(#45A3FF, "Bull Candle", inline = "candle", group = gCandle, tooltip = tBull)
bearCol = input.color(#FF647B, "Bear Candle", inline = "candle", group = gCandle, tooltip = tBear)
wickCol = input.color(color.gray, "Wick", group = gCandle, tooltip = tWick)
bodyFade = input.int(20, "Body Transparency", minval = 0, maxval = 95, group = gCandle, tooltip = tBodyFade)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Volume Wings {
showWings = input.bool(true, "Show Volume Wings", group = gWings, tooltip = tShowWings)
width = input.int(20, "Wing Width", minval = 6, maxval = 80, group = gWings, tooltip = tWingWidth)
buyCol = input.color(#45A3FF, "Buy Wing", inline = "wing", group = gWings, tooltip = tBuyWing)
sellCol = input.color(#FF647B, "Sell Wing", inline = "wing", group = gWings, tooltip = tSellWing)
wingFade = input.int(82, "Wing Transparency", minval = 0, maxval = 100, group = gWings, tooltip = tWingFade)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Delta {
showDelta = input.bool(true, "Show Delta Dominance", group = gDelta, tooltip = tShowDelta)
deltaWidth = input.int(13, "Delta Max Width", minval = 2, maxval = 40, group = gDelta, tooltip = tDeltaWidth)
posDeltaCol = input.color(#2962ff, "Positive Delta", inline = "delta", group = gDelta, tooltip = tPosDelta)
negDeltaCol = input.color(#e91e63, "Negative Delta", inline = "delta", group = gDelta, tooltip = tNegDelta)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Levels {
showControl = input.bool(true, "Show Control Price", group = gLevels, tooltip = tControl)
showCaps = input.bool(true, "Show Anchored High / Low", group = gLevels, tooltip = tCaps)
LineCol = input.color(#8F95A8, "High / Low Color", group = gLevels, tooltip = tLineCol)
rangeLineStyle = input.string("Dotted", "High / Low Style", options = ["Solid", "Dashed", "Dotted"], inline = "range", group = gLevels, tooltip = tLineStyle)
rangeLineWidth = input.int(1, "Width", minval = 1, maxval = 4, inline = "range", group = gLevels, tooltip = tLineWidth)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Header {
showHeader = input.bool(true, "Show Live Header", group = gHeader, tooltip = tHeader)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs: Battle Bubbles {
showBattle = input.bool(true, "Show Battle Bubbles", group = gBattle, tooltip = tShowBattle)
battleGap = input.int(40, "Bubble Offset", minval = 8, maxval = 80, group = gBattle, tooltip = tBattleGap)
battleMinSize = input.int(7, "Min Size", minval = 4, maxval = 20, inline = "battleSize", group = gBattle, tooltip = tBattleMin)
battleMaxSize = input.int(34, "Max Size", minval = 12, maxval = 48, inline = "battleSize", group = gBattle, tooltip = tBattleMax)
battleBuyCol = input.color(#00E676, "Buy Winner", inline = "battleCol", group = gBattle, tooltip = tBattleBuy)
battleSellCol = input.color(#FF3B5C, "Sell Winner", inline = "battleCol", group = gBattle, tooltip = tBattleSell)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Auto LTF Resolver {
autoLtfForChart() =>
    string tf = "1"
    int mult = timeframe.multiplier

    if timeframe.isseconds
        tf := switch mult
            1 => "1S"
            5 => "1S"
            10 => "5S"
            15 => "10S"
            30 => "15S"
            45 => "30S"
            => "1S"
    else if timeframe.isminutes
        tf := switch mult
            1 => "45S"
            2 => "1"
            3 => "2"
            5 => "3"
            10 => "5"
            15 => "10"
            20 => "15"
            30 => "20"
            45 => "30"
            60 => "45"
            90 => "60"
            120 => "90"
            180 => "120"
            240 => "180"
            360 => "240"
            480 => "360"
            720 => "480"
            1440 => "1080"
            => str.tostring(math.max(1, int(math.floor(mult * 0.75))))
    else if timeframe.isdaily
        tf := switch mult
            1 => "1080"
            2 => "1D"
            3 => "2D"
            => str.tostring(math.max(1, int(math.floor(mult * 0.75)))) + "D"
    else if timeframe.isweekly
        tf := switch mult
            1 => "5D"
            2 => "1W"
            3 => "2W"
            => str.tostring(math.max(1, int(math.floor(mult * 0.75)))) + "W"
    else if timeframe.ismonthly
        tf := switch mult
            1 => "3W"
            2 => "1M"
            3 => "2M"
            6 => "4M"
            12 => "9M"
            => str.tostring(math.max(1, int(math.floor(mult * 0.75)))) + "M"

    tf
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Timeframe Validation {
chartSec = timeframe.in_seconds()
htfSec = timeframe.in_seconds(htfTf)
ltfTf = autoLtf ? autoLtfForChart() : manualLtfTf
ltfSec = timeframe.in_seconds(ltfTf)

if htfSec <= chartSec
    runtime.error("Higher Timeframe must be greater than the chart timeframe.")
if ltfSec > chartSec
    runtime.error("Lower Timeframe must be less than or equal to the chart timeframe.")
if ltfSec >= htfSec
    runtime.error("Lower Timeframe must be below the selected Higher Timeframe.")
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Helpers {
fit(v, lo, hi) => math.max(lo, math.min(hi, v))
fitRow(v, lo, hi) => math.max(lo, math.min(hi, v))
priceTxt(v) => str.tostring(v, format.mintick)

buyShare(o, h, l, c) =>
    rng = h - l
    share = 0.5
    if rng > 0.0
        closePos = fit((c - l) / rng, 0.0, 1.0)
        body = fit((c - o) / rng, -1.0, 1.0)
        upperWick = math.max(h - math.max(o, c), 0.0) / rng
        lowerWick = math.max(math.min(o, c) - l, 0.0) / rng
        drive = 0.48 * (2.0 * closePos - 1.0) + 0.32 * body + 0.20 * (lowerWick - upperWick)
        share := fit(0.5 + 0.43 * drive, 0.025, 0.975)
    share

rowWeight(mid, anchor, rng, touch, power) =>
    dist = rng > 0.0 ? math.min(math.abs(mid - anchor) / rng, 1.0) : 0.0
    touch * (1.0 + 2.6 * math.pow(1.0 - dist, power))

clearLines(array<line> items) =>
    if items.size() > 0
        for item in items
            line.delete(item)
    items.clear()

clearLabels(array<label> items) =>
    if items.size() > 0
        for item in items
            label.delete(item)
    items.clear()

clearBoxes(array<box> items) =>
    if items.size() > 0
        for item in items
            box.delete(item)
    items.clear()

clearPolys(array<polyline> items) =>
    if items.size() > 0
        for item in items
            polyline.delete(item)
    items.clear()
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Intrabar Storage {
var sampleO = array.new<float>()
var sampleH = array.new<float>()
var sampleL = array.new<float>()
var sampleC = array.new<float>()
var sampleV = array.new<float>()
var compressionPasses = 0

compressSamples() =>
    n = sampleO.size()
    newN = int(math.ceil(n * 0.5))
    if n > 1
        for j = 0 to newN - 1
            i1 = j * 2
            i2 = i1 + 1
            oOut = sampleO.get(i1)
            hOut = sampleH.get(i1)
            lOut = sampleL.get(i1)
            cOut = sampleC.get(i1)
            vOut = sampleV.get(i1)
            if i2 < n
                hOut := math.max(hOut, sampleH.get(i2))
                lOut := math.min(lOut, sampleL.get(i2))
                cOut := sampleC.get(i2)
                vOut += sampleV.get(i2)
            sampleO.set(j, oOut)
            sampleH.set(j, hOut)
            sampleL.set(j, lOut)
            sampleC.set(j, cOut)
            sampleV.set(j, vOut)
        while sampleO.size() > newN
            sampleO.pop()
            sampleH.pop()
            sampleL.pop()
            sampleC.pop()
            sampleV.pop()
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ State {
const int BATTLE_SEGMENTS = 20
var buyRows = array.new<float>(rows, 0.0)
var sellRows = array.new<float>(rows, 0.0)
var battleBuyVol = array.new<float>(BATTLE_SEGMENTS, 0.0)
var battleSellVol = array.new<float>(BATTLE_SEGMENTS, 0.0)
var battleBuyWins = array.new<float>(BATTLE_SEGMENTS, 0.0)
var battleSellWins = array.new<float>(BATTLE_SEGMENTS, 0.0)
var battleScores = array.new<float>(BATTLE_SEGMENTS, 0.0)
var battleStrengths = array.new<float>(BATTLE_SEGMENTS, 0.0)
var polys = array.new<polyline>()
var lines = array.new<line>()
var labels = array.new<label>()
var boxes = array.new<box>()
var float liveCtrlPx = na
var float liveDeltaPct = na
var float liveBuyTotal = na
var float liveSellTotal = na
var float liveIntrabars = na
var float liveHtfOpen = na
var float liveHtfHigh = na
var float liveHtfLow = na
var int liveHtfHighBar = na
var int liveHtfLowBar = na
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Data Requests {
[ltfO, ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfTf, [open, high, low, close, volume])
[devLtfO, devLtfH, devLtfL, devLtfC] = request.security(syminfo.tickerid, ltfTf, [open, high, low, close], lookahead = barmerge.lookahead_off)
newHtf = timeframe.change(htfTf)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Current HTF Candle State {
if newHtf or na(liveHtfOpen) or na(liveHtfHigh) or na(liveHtfLow)
    liveHtfOpen := open
    liveHtfHigh := high
    liveHtfLow := low
    liveHtfHighBar := bar_index
    liveHtfLowBar := bar_index
else
    if high > liveHtfHigh
        liveHtfHigh := high
        liveHtfHighBar := bar_index
    if low < liveHtfLow
        liveHtfLow := low
        liveHtfLowBar := bar_index
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Current HTF LTF Samples {
if newHtf
    sampleO.clear()
    sampleH.clear()
    sampleL.clear()
    sampleC.clear()
    sampleV.clear()
    compressionPasses := 0

incoming = ltfO.size()
incomingVolume = 0.0

if incoming > 0
    for i = 0 to incoming - 1
        o = ltfO.get(i)
        h = ltfH.get(i)
        l = ltfL.get(i)
        c = ltfC.get(i)
        rawV = ltfV.get(i)
        if not na(o) and not na(h) and not na(l) and not na(c)
            v = na(rawV) ? 0.0 : math.max(rawV, 0.0)
            incomingVolume += v
            sampleO.push(o)
            sampleH.push(h)
            sampleL.push(l)
            sampleC.push(c)
            sampleV.push(v)

if barstate.isrealtime and not na(volume)
    residualVolume = math.max(volume - incomingVolume, 0.0)
    minResidual = math.max(volume * 0.0000001, 0.0)
    if residualVolume > minResidual and not na(devLtfO) and not na(devLtfH) and not na(devLtfL) and not na(devLtfC)
        sampleO.push(devLtfO)
        sampleH.push(devLtfH)
        sampleL.push(devLtfL)
        sampleC.push(devLtfC)
        sampleV.push(residualVolume)

while sampleO.size() > maxSamples
    compressSamples()
    compressionPasses += 1
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Live Auction {
if barstate.islast
    clearPolys(polys)
    clearLines(lines)
    clearLabels(labels)
    clearBoxes(boxes)
    buyRows.fill(0.0)
    sellRows.fill(0.0)
    battleBuyVol.fill(0.0)
    battleSellVol.fill(0.0)
    battleBuyWins.fill(0.0)
    battleSellWins.fill(0.0)
    battleScores.fill(0.0)
    battleStrengths.fill(0.0)
    liveCtrlPx := na
    liveDeltaPct := na
    liveBuyTotal := na
    liveSellTotal := na
    liveIntrabars := sampleO.size()
    sampleCount = sampleO.size()

    if sampleCount > 0
        // ~~ HTF Range {
        htfOpen = liveHtfOpen
        htfHigh = liveHtfHigh
        htfLow = liveHtfLow
        htfClose = close
        profLo = htfLow
        profHi = htfHigh

        if profHi <= profLo
            pad = syminfo.mintick * rows * 0.5
            profLo -= pad
            profHi += pad

        rowH = (profHi - profLo) / rows
        battleH = (profHi - profLo) / BATTLE_SEGMENTS
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

        // ~~ Profile Distribution {
        for slot = 0 to sampleCount - 1
            o = sampleO.get(slot)
            h = sampleH.get(slot)
            l = sampleL.get(slot)
            c = sampleC.get(slot)
            v = sampleV.get(slot)
            ok = not na(o) and not na(h) and not na(l) and not na(c) and not na(v) and v > 0.0

            if ok
                rng = h - l
                bShare = buyShare(o, h, l, c)
                bVol = v * bShare
                sVol = v - bVol

                // Battle win evidence intentionally does not use raw volume. It measures
                // how consistently directional LTF auctions win across each price segment,
                // while the segment delta below supplies the volume-weighted component.
                sampleBias = 2.0 * bShare - 1.0
                sampleEvidence = math.abs(sampleBias)
                if sampleEvidence > 0.0
                    if rng <= 0.0
                        battleSeg = fitRow(int(math.floor((c - profLo) / battleH)), 0, BATTLE_SEGMENTS - 1)
                        if sampleBias > 0.0
                            battleBuyWins.set(battleSeg, battleBuyWins.get(battleSeg) + sampleEvidence)
                        else
                            battleSellWins.set(battleSeg, battleSellWins.get(battleSeg) + sampleEvidence)
                    else
                        firstBattleSeg = fitRow(int(math.floor((l - profLo) / battleH)), 0, BATTLE_SEGMENTS - 1)
                        lastBattleSeg = fitRow(int(math.floor((h - profLo) / battleH)), 0, BATTLE_SEGMENTS - 1)
                        for battleSeg = firstBattleSeg to lastBattleSeg
                            battleLo = profLo + battleSeg * battleH
                            battleHi = battleLo + battleH
                            battleTouched = math.max(0.0, math.min(h, battleHi) - math.max(l, battleLo))
                            if battleTouched > 0.0
                                battleEvidence = sampleEvidence * battleTouched / rng
                                if sampleBias > 0.0
                                    battleBuyWins.set(battleSeg, battleBuyWins.get(battleSeg) + battleEvidence)
                                else
                                    battleSellWins.set(battleSeg, battleSellWins.get(battleSeg) + battleEvidence)

                if rng <= 0.0
                    row = fitRow(int(math.floor((c - profLo) / rowH)), 0, rows - 1)
                    buyRows.set(row, buyRows.get(row) + bVol)
                    sellRows.set(row, sellRows.get(row) + sVol)
                else
                    first = fitRow(int(math.floor((l - profLo) / rowH)), 0, rows - 1)
                    last = fitRow(int(math.floor((h - profLo) / rowH)), 0, rows - 1)
                    buyAt = fit(0.50 * c + 0.32 * h + 0.18 * o, l, h)
                    sellAt = fit(0.50 * c + 0.32 * l + 0.18 * o, l, h)
                    bWeight = 0.0
                    sWeight = 0.0

                    for row = first to last
                        rowLo = profLo + row * rowH
                        rowHi = rowLo + rowH
                        touched = math.max(0.0, math.min(h, rowHi) - math.max(l, rowLo))
                        if touched > 0.0
                            mid = 0.5 * (rowLo + rowHi)
                            touch = touched / rng
                            bWeight += rowWeight(mid, buyAt, rng, touch, focus)
                            sWeight += rowWeight(mid, sellAt, rng, touch, focus)

                    if bWeight > 0.0 and sWeight > 0.0
                        for row = first to last
                            rowLo = profLo + row * rowH
                            rowHi = rowLo + rowH
                            touched = math.max(0.0, math.min(h, rowHi) - math.max(l, rowLo))
                            if touched > 0.0
                                mid = 0.5 * (rowLo + rowHi)
                                touch = touched / rng
                                bw = rowWeight(mid, buyAt, rng, touch, focus)
                                sw = rowWeight(mid, sellAt, rng, touch, focus)
                                buyRows.set(row, buyRows.get(row) + bVol * bw / bWeight)
                                sellRows.set(row, sellRows.get(row) + sVol * sw / sWeight)
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

        // ~~ Profile Statistics {
        buyTotal = 0.0
        sellTotal = 0.0
        peak = -1.0
        maxSide = 0.0
        maxDelta = 0.0
        ctrlRow = 0

        for row = 0 to rows - 1
            b = buyRows.get(row)
            s = sellRows.get(row)
            both = b + s
            d = b - s
            buyTotal += b
            sellTotal += s
            maxSide := math.max(maxSide, math.max(b, s))
            maxDelta := math.max(maxDelta, math.abs(d))
            if both > peak
                peak := both
                ctrlRow := row

            // Transfer each profile cell into the fixed 20 equal-price battle segments.
            // Fractional overlap keeps segment totals accurate when 72 profile rows do not
            // divide evenly into 20 battle segments.
            if both > 0.0
                rowLoBattle = profLo + row * rowH
                rowHiBattle = rowLoBattle + rowH
                firstBattleSeg = fitRow(int(math.floor((rowLoBattle - profLo) / battleH)), 0, BATTLE_SEGMENTS - 1)
                lastBattleSeg = fitRow(int(math.floor((rowHiBattle - profLo) / battleH)), 0, BATTLE_SEGMENTS - 1)
                for battleSeg = firstBattleSeg to lastBattleSeg
                    battleLo = profLo + battleSeg * battleH
                    battleHi = battleLo + battleH
                    overlap = math.max(0.0, math.min(rowHiBattle, battleHi) - math.max(rowLoBattle, battleLo))
                    if overlap > 0.0
                        frac = overlap / rowH
                        battleBuyVol.set(battleSeg, battleBuyVol.get(battleSeg) + b * frac)
                        battleSellVol.set(battleSeg, battleSellVol.get(battleSeg) + s * frac)

        total = buyTotal + sellTotal

        // ~~ Battle Statistics {
        maxBattleActivity = 0.0
        for battleSeg = 0 to BATTLE_SEGMENTS - 1
            battleActivity = battleBuyVol.get(battleSeg) + battleSellVol.get(battleSeg)
            maxBattleActivity := math.max(maxBattleActivity, battleActivity)

        maxBattleStrength = 0.0
        if maxBattleActivity > 0.0
            for battleSeg = 0 to BATTLE_SEGMENTS - 1
                segBuy = battleBuyVol.get(battleSeg)
                segSell = battleSellVol.get(battleSeg)
                segTotal = segBuy + segSell
                buyWinEvidence = battleBuyWins.get(battleSeg)
                sellWinEvidence = battleSellWins.get(battleSeg)
                winEvidenceTotal = buyWinEvidence + sellWinEvidence

                // deltaDir is volume dominance. winDir is the consistency of directional
                // LTF wins in this segment. Delta receives the larger weight because it is
                // the actual volume result; win consistency confirms or weakens that result.
                deltaDir = segTotal > 0.0 ? (segBuy - segSell) / segTotal : 0.0
                winDir = winEvidenceTotal > 0.0 ? (buyWinEvidence - sellWinEvidence) / winEvidenceTotal : 0.0
                battleScore = 0.70 * deltaDir + 0.30 * winDir

                // Participation prevents a nearly empty price segment from producing a huge
                // bubble merely because its tiny amount of activity was one-sided.
                activityNorm = segTotal > 0.0 ? segTotal / maxBattleActivity : 0.0
                rawStrength = math.abs(battleScore) * math.sqrt(activityNorm)

                battleScores.set(battleSeg, battleScore)
                battleStrengths.set(battleSeg, rawStrength)
                maxBattleStrength := math.max(maxBattleStrength, rawStrength)
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

        if total > 0.0 and maxSide > 0.0
            // ~~ Live Values {
            ctrlPx = profLo + (ctrlRow + 0.5) * rowH
            deltaPct = 100.0 * (buyTotal - sellTotal) / total
            liveCtrlPx := ctrlPx
            liveDeltaPct := deltaPct
            liveBuyTotal := buyTotal
            liveSellTotal := sellTotal
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ Layout {
            bodyCenter = bar_index + gap + width + bodyHalfWidth + 1
            bodyLeft = bodyCenter - bodyHalfWidth
            bodyRight = bodyCenter + bodyHalfWidth
            sellSpine = bodyLeft - 1
            buySpine = bodyRight + 1
            leftX = sellSpine - width
            rightX = buySpine + width
            tagX = rightX + 3
            capStyle = rangeLineStyle == "Solid" ? line.style_solid : rangeLineStyle == "Dashed" ? line.style_dashed : line.style_dotted
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ Anchored High / Low Lines {
            if showCaps
                highOriginX = na(liveHtfHighBar) ? leftX : liveHtfHighBar
                lowOriginX = na(liveHtfLowBar) ? leftX : liveHtfLowBar
                lines.push(line.new(highOriginX, htfHigh, bodyCenter, htfHigh, xloc = xloc.bar_index, color = LineCol, style = capStyle, width = rangeLineWidth))
                lines.push(line.new(lowOriginX, htfLow, bodyCenter, htfLow, xloc = xloc.bar_index, color = LineCol, style = capStyle, width = rangeLineWidth))
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ Volume Wings {
            if showWings
                sellPts = array.new<chart.point>()
                sellPts.push(chart.point.from_index(sellSpine, profLo))
                for row = 0 to rows - 1
                    y0 = profLo + row * rowH
                    y1 = y0 + rowH
                    x = sellSpine - int(math.round(width * sellRows.get(row) / maxSide))
                    sellPts.push(chart.point.from_index(x, y0))
                    sellPts.push(chart.point.from_index(x, y1))
                sellPts.push(chart.point.from_index(sellSpine, profHi))
                polys.push(polyline.new(sellPts, curved = false, closed = true, xloc = xloc.bar_index, line_color = sellCol, fill_color = color.new(sellCol, wingFade), line_width = 1))

                buyPts = array.new<chart.point>()
                buyPts.push(chart.point.from_index(buySpine, profLo))
                for row = 0 to rows - 1
                    y0 = profLo + row * rowH
                    y1 = y0 + rowH
                    x = buySpine + int(math.round(width * buyRows.get(row) / maxSide))
                    buyPts.push(chart.point.from_index(x, y0))
                    buyPts.push(chart.point.from_index(x, y1))
                buyPts.push(chart.point.from_index(buySpine, profHi))
                polys.push(polyline.new(buyPts, curved = false, closed = true, xloc = xloc.bar_index, line_color = buyCol, fill_color = color.new(buyCol, wingFade), line_width = 1))
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ Delta Dominance {
            if showDelta and maxDelta > 0.0
                deltaWidthEff = math.min(deltaWidth, width)

                for row = 0 to rows - 1
                    y0 = profLo + row * rowH
                    y1 = y0 + rowH
                    b = buyRows.get(row)
                    s = sellRows.get(row)
                    d = b - s

                    if d != 0.0
                        strength = math.pow(math.abs(d) / maxDelta, 0.72)
                        ext = math.max(1, int(math.round(deltaWidthEff * strength)))
                        alpha = math.max(8, math.min(88, 88 - int(math.round(74.0 * strength))))
                        buyWins = d > 0.0
                        deltaCol = buyWins ? posDeltaCol : negDeltaCol
                        fillCol = color.new(deltaCol, alpha)
                        edgeCol = color.new(deltaCol, math.max(alpha - 20, 0))
                        x1 = buyWins ? buySpine : sellSpine - ext
                        x2 = buyWins ? buySpine + ext : sellSpine
                        boxes.push(box.new(left = x1, top = y1, right = x2, bottom = y0, xloc = xloc.bar_index, border_color = edgeCol, border_width = 1, bgcolor = fillCol))
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ HTF Candle {
            candleCol = htfClose >= htfOpen ? bullCol : bearCol
            lines.push(line.new(bodyCenter, htfHigh, bodyCenter, htfLow, xloc = xloc.bar_index, color = wickCol, width = 2))

            bodyTop = math.max(htfOpen, htfClose)
            bodyBottom = math.min(htfOpen, htfClose)

            if bodyTop <= bodyBottom
                bodyTop += syminfo.mintick * 0.5
                bodyBottom -= syminfo.mintick * 0.5

            boxes.push(box.new(left = bodyLeft, top = bodyTop, right = bodyRight, bottom = bodyBottom, xloc = xloc.bar_index, border_color = candleCol, border_width = 2, bgcolor = color.new(candleCol, bodyFade)))
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ Control Price {
            if showControl
                ctrlBuy = buyRows.get(ctrlRow)
                ctrlSell = sellRows.get(ctrlRow)
                ctrlCol = ctrlBuy > ctrlSell ? buyCol : ctrlSell > ctrlBuy ? sellCol : #F5B14C
                lines.push(line.new(leftX - 1, ctrlPx, rightX + 1, ctrlPx, xloc = xloc.bar_index, color = ctrlCol, width = 2))
                labels.push(label.new(tagX, ctrlPx, "CONTROL\n" + priceTxt(ctrlPx), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(ctrlCol, 86), textcolor = ctrlCol, size = size.small, tooltip = "Current highest combined estimated buy and sell activity inside the forming HTF candle."))
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ Battle Bubbles {
            if showBattle and maxBattleStrength > 0.0
                bubbleX = rightX + battleGap
                minBubble = math.min(battleMinSize, battleMaxSize)
                maxBubble = math.max(battleMinSize, battleMaxSize)

                for battleSeg = 0 to BATTLE_SEGMENTS - 1
                    score = battleScores.get(battleSeg)
                    rawStrength = battleStrengths.get(battleSeg)
                    segBuy = battleBuyVol.get(battleSeg)
                    segSell = battleSellVol.get(battleSeg)
                    segTotal = segBuy + segSell

                    if segTotal > 0.0 and rawStrength > 0.0001 and score != 0.0
                        relativeStrength = fit(rawStrength / maxBattleStrength, 0.0, 1.0)

                        // Diameter follows the square root of normalized strength so the
                        // apparent bubble area is closer to proportional to battle strength.
                        visualScale = math.sqrt(relativeStrength)
                        outerSize = int(math.round(minBubble + (maxBubble - minBubble) * visualScale))
                        innerSize = math.max(3, int(math.round(outerSize * 0.88)))

                        buyersWon = score > 0.0
                        bubbleCol = buyersWon ? battleBuyCol : battleSellCol
                        bubbleY = profLo + (battleSeg + 0.5) * battleH
                        battleLo = profLo + battleSeg * battleH
                        battleHi = battleLo + battleH

                        deltaDir = (segBuy - segSell) / segTotal
                        buySellRatio = segSell > 0.0 ? segBuy / segSell : na
                        buyWinEvidence = battleBuyWins.get(battleSeg)
                        sellWinEvidence = battleSellWins.get(battleSeg)
                        winEvidenceTotal = buyWinEvidence + sellWinEvidence
                        buyWinPct = winEvidenceTotal > 0.0 ? 100.0 * buyWinEvidence / winEvidenceTotal : 50.0
                        sellWinPct = 100.0 - buyWinPct
                        winnerTxt = buyersWon ? "BUYERS" : "SELLERS"
                        deltaSignSeg = deltaDir > 0.0 ? "+" : ""
                        ratioTxt = na(buySellRatio) ? "INF" : str.tostring(buySellRatio, "0.00")
                        segmentNo = BATTLE_SEGMENTS - battleSeg
                        tip = "BATTLE " + str.tostring(segmentNo) + "/" + str.tostring(BATTLE_SEGMENTS) + "\n" +
                              "Range: " + priceTxt(battleLo) + " - " + priceTxt(battleHi) + "\n" +
                              "Winner: " + winnerTxt + "\n" +
                              "Delta: " + deltaSignSeg + str.tostring(deltaDir * 100.0, "0.0") + "%\n" +
                              "Buy/Sell volume ratio: " + ratioTxt + "x\n" +
                              "Win evidence: Buy " + str.tostring(buyWinPct, "0.0") + "% / Sell " + str.tostring(sellWinPct, "0.0") + "%\n" +
                              "Battle strength: " + str.tostring(rawStrength * 100.0, "0.0") + "%\n" +
                              "Relative bubble strength: " + str.tostring(relativeStrength * 100.0, "0.0") + "%"

                        // Two concentric circles create the outlined / lightly-filled bubble
                        // look from the reference image while retaining a large hover target.
                        labels.push(label.new(bubbleX, bubbleY, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_circle, color = bubbleCol, textcolor = bubbleCol, size = outerSize, tooltip = tip))
                        labels.push(label.new(bubbleX, bubbleY, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_circle, color = color.new(chart.bg_color, 10), textcolor = bubbleCol, size = innerSize, tooltip = tip))
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

            // ~~ Live Header {
            if showHeader
                deltaSign = deltaPct > 0.0 ? "+" : ""
                compressedTxt = compressionPasses > 0 ? " | coarse x" + str.tostring(compressionPasses) : ""
                stateTxt = barstate.isrealtime ? "LIVE" : "CURRENT"
                ltfModeTxt = autoLtf ? "AUTO " : ""
                header = stateTxt + "  " + htfTf + " HTF / " + ltfModeTxt + ltfTf + " LTF | Delta " + deltaSign + str.tostring(deltaPct, "0.0") + "% | " + str.tostring(sampleCount) + " intrabars" + compressedTxt
                labelPad = math.max((profHi - profLo) * 0.06, syminfo.mintick * 8.0)
                labels.push(label.new(bodyCenter, profHi + labelPad, header, xloc = xloc.bar_index, style = label.style_label_down, color = color.new(candleCol, 88), textcolor = candleCol, size = size.small))
            //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Data Window {
plot(liveCtrlPx, "Live HTF Auction Control Price", display = display.data_window, editable = false)
plot(liveDeltaPct, "Live HTF Estimated Delta %", display = display.data_window, editable = false, precision = 2)
plot(liveBuyTotal, "Live HTF Estimated Buy Volume", display = display.data_window, editable = false)
plot(liveSellTotal, "Live HTF Estimated Sell Volume", display = display.data_window, editable = false)
plot(liveIntrabars, "Live HTF Intrabars Used", display = display.data_window, editable = false, precision = 0)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}