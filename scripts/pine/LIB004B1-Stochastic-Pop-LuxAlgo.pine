//@version=6
indicator("Stochastic Pop", "Stochastic Pop", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981
BEAR_COLOR        = #f23645
NEUTRAL_COLOR     = #5b9cf6
MID_COLOR         = color.new(#787b86, 50)

FILL_VALUE_TRANSP = 50
FILL_LEVEL_TRANSP = 100
STATE_BG_TRANSP   = 90
LEVEL_LINE_TRANSP = 50

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
kLengthInput     = input.int(14, "%K Length", minval = 1, group = "Stochastic",
     tooltip = "Lookback of the raw stochastic %K — where the close sits inside the high/low range of the last N bars, on a 0-100 scale. Published pop versions favor fast settings, since the tactic depends on catching the line pinning to its ceiling in real time.")

kSmoothInput     = input.int(1, "%K Smoothing", minval = 1, group = "Stochastic",
     tooltip = "SMA applied to %K. 1 keeps the raw fast line the pop was designed around; heavy smoothing defeats the purpose of the tactic.")

upperInput       = input.float(80, "Upper Threshold", minval = 50, maxval = 100, step = 1, group = "Thresholds",
     tooltip = "Pop trigger level, classically 80 (75 in some published versions). The pop deliberately inverts the textbook reading: a push above this line is ignition rather than overbought, and the bullish signal stays alive while %K holds above it.")

lowerInput       = input.float(20, "Lower Threshold", minval = 0, maxval = 50, step = 1, group = "Thresholds",
     tooltip = "Drop trigger level, the bearish mirror of the pop. A plunge below this line is read as downside ignition, and the bearish signal stays alive while %K holds below it.")

adxFilterInput   = input.bool(true, "ADX Contraction Filter", group = "Filters",
     tooltip = "Steckler screen: only trigger when ADX is below its ceiling, marking a market that has been resting rather than already running — the pop then fires at the transition from rest to expansion. Disable for Bernstein's raw, unfiltered pop.")

adxLengthInput   = input.int(14, "ADX Length", minval = 1, inline = "adx", group = "Filters",
     tooltip = "Wilder DMI/ADX length used by the contraction screen.")

adxMaxInput      = input.float(20, "Below", minval = 1, maxval = 100, step = 1, inline = "adx", group = "Filters",
     tooltip = "ADX ceiling a trigger bar must be under to count as a low-ADX lull — 14-period ADX below 20 in the published version.")

trendFilterInput = input.bool(true, "Higher Timeframe Trend Filter", group = "Filters",
     tooltip = "Steckler screen: only take pops in the direction of the larger trend — bullish pops require price above the higher-timeframe EMA, bearish drops require price below it.")

trendTfInput     = input.timeframe("W", "Timeframe", inline = "trend", group = "Filters",
     tooltip = "Higher timeframe supplying the trend backdrop. Keep it above the chart timeframe — the published version filtered daily signals with the weekly trend.")

trendLengthInput = input.int(20, "EMA", minval = 1, inline = "trend", group = "Filters",
     tooltip = "EMA length, computed on the trend timeframe, defining the larger trend direction.")

volFilterInput   = input.bool(false, "Volume Expansion Filter", group = "Filters",
     tooltip = "Require above-average volume on the trigger bar. Expansion on the pop bar strengthens the case that the burst is genuine; off by default since not every published version demands it.")

volLengthInput   = input.int(20, "Volume Average Length", minval = 1, group = "Filters",
     tooltip = "Length of the simple moving average of volume a trigger bar must exceed when the volume filter is enabled.")

showDashInput    = input.bool(true, "Show Dashboard", group = "Dashboard",
     tooltip = "Checklist table of the published screening recipe — higher-timeframe trend, ADX contraction, %K zone — plus the currently active state. Every pop condition is computable, so the table doubles as a scanner readout for the symbol on the chart.")

dashPosInput     = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "dash", group = "Dashboard",
     tooltip = "Dashboard corner.")

dashSizeInput    = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], inline = "dash", group = "Dashboard",
     tooltip = "Dashboard text size.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "colors", group = "Style",
     tooltip = "Bullish color: embedded shading above the upper threshold, pop markers and the pop state background.")

bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = "Style",
     tooltip = "Bearish color: embedded shading below the lower threshold, drop markers and the drop state background.")

kColorInput      = input.color(NEUTRAL_COLOR, "%K Line", group = "Style",
     tooltip = "%K color while inside the bands. Beyond a threshold the line takes the bullish or bearish color, so embedding is readable at a glance.")

showMarkersInput = input.bool(true, "Entry / Exit Markers", group = "Style",
     tooltip = "Triangles mark filtered pop/drop triggers; crosses mark the exit, when %K hooks back through its threshold and the embedded reading is lost.")

showStateInput   = input.bool(true, "State Background", group = "Style",
     tooltip = "Tints the pane from a filtered trigger until its exit — the window the signal is considered alive. The threshold shading on %K itself appears whenever the line is beyond a band, filtered or not, which exposes the fake pops the screens rejected.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
getTablePosition(positionText) =>
    switch positionText
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

getTextSize(sizeText) =>
    switch sizeText
        "Tiny"  => size.tiny
        "Small" => size.small
        => size.normal

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Fast stochastic — raw %K with optional light smoothing (1 = raw), the line the pop pins to its ceiling
rawK   = ta.stoch(close, high, low, kLengthInput)
kValue = ta.sma(rawK, kSmoothInput)

//Wilder ADX for the contraction screen — computed every bar regardless of the toggle
[diPlus, diMinus, adxValue] = ta.dmi(adxLengthInput, adxLengthInput)

//Higher-timeframe trend backdrop and the volume average for the expansion screen
htfEma    = request.security(syminfo.tickerid, trendTfInput, ta.ema(close, trendLengthInput))
volumeAvg = ta.sma(volume, volLengthInput)

//Embedded zones — the oscillator saturated beyond a band, the trend signature the pop rides
inBullZone = not na(kValue) and kValue > upperInput
inBearZone = not na(kValue) and kValue < lowerInput

//Screen readings, na-guarded over the warmup bars
adxQuiet    = not na(adxValue) and adxValue < adxMaxInput
trendIsUp   = not na(htfEma) and close > htfEma
trendIsDown = not na(htfEma) and close < htfEma
volumeHigh  = not na(volumeAvg) and volume > volumeAvg

//Each screen passes when disabled, so toggles narrow the raw Bernstein pop into the filtered Steckler version
adxOk       = not adxFilterInput or adxQuiet
bullTrendOk = not trendFilterInput or trendIsUp
bearTrendOk = not trendFilterInput or trendIsDown
volumeOk    = not volFilterInput or volumeHigh

//---------------------------------------------------------------------------------------------------------------------}
// Pop / Drop State
//---------------------------------------------------------------------------------------------------------------------{
//Triggers — %K punching through a band out of the screened backdrop, read as ignition rather than stretch
popTrigger  = ta.crossover(kValue, upperInput) and adxOk and bullTrendOk and volumeOk
dropTrigger = ta.crossunder(kValue, lowerInput) and adxOk and bearTrendOk and volumeOk

var bool popActive  = false
var bool dropActive = false

//Exits — the hook back through the threshold; loss of saturation is the burst being spent (or a fake pop)
popExit  = popActive and not na(kValue) and kValue < upperInput
dropExit = dropActive and not na(kValue) and kValue > lowerInput

if popExit
    popActive := false
if dropExit
    dropActive := false
if popTrigger
    popActive := true
if dropTrigger
    dropActive := true

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
//%K takes the directional color while embedded beyond a band, neutral inside them
kColor = inBullZone ? bullColorInput : inBearZone ? bearColorInput : kColorInput

kPlotId     = plot(kValue, "%K", kColor, 1)
upperPlotId = plot(upperInput, "Upper Threshold", color = na, editable = false, display = display.none)
lowerPlotId = plot(lowerInput, "Lower Threshold", color = na, editable = false, display = display.none)

hline(upperInput, "Pop Threshold", color.new(BULL_COLOR, LEVEL_LINE_TRANSP), hline.style_dashed)
hline(lowerInput, "Drop Threshold", color.new(BEAR_COLOR, LEVEL_LINE_TRANSP), hline.style_dashed)
hline(50, "Midline", MID_COLOR, hline.style_dotted)

//Embedded-zone gradients — strongest at the %K value, fading out at the violated threshold
fill(kPlotId, upperPlotId, top_value = math.max(nz(kValue, upperInput), upperInput), bottom_value = upperInput, top_color = inBullZone ? color.new(bullColorInput, FILL_VALUE_TRANSP) : na, bottom_color = inBullZone ? color.new(bullColorInput, FILL_LEVEL_TRANSP) : na, title = "Pop Zone Gradient")
fill(kPlotId, lowerPlotId, top_value = lowerInput, bottom_value = math.min(nz(kValue, lowerInput), lowerInput), top_color = inBearZone ? color.new(bearColorInput, FILL_LEVEL_TRANSP) : na, bottom_color = inBearZone ? color.new(bearColorInput, FILL_VALUE_TRANSP) : na, title = "Drop Zone Gradient")

//Signal-alive window — from a filtered trigger until %K hooks back through its threshold
bgcolor(showStateInput and popActive ? color.new(bullColorInput, STATE_BG_TRANSP) : showStateInput and dropActive ? color.new(bearColorInput, STATE_BG_TRANSP) : na, title = "Active Signal State")

plotshape(showMarkersInput and popTrigger, "Bullish Pop Trigger", shape.triangleup, location.bottom, bullColorInput, size = size.tiny)
plotshape(showMarkersInput and popExit, "Bullish Pop Exit", shape.xcross, location.bottom, bullColorInput, size = size.tiny)
plotshape(showMarkersInput and dropTrigger, "Bearish Drop Trigger", shape.triangledown, location.top, bearColorInput, size = size.tiny)
plotshape(showMarkersInput and dropExit, "Bearish Drop Exit", shape.xcross, location.top, bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashTable = na

if barstate.isfirst and showDashInput
    dashTable := table.new(getTablePosition(dashPosInput), 2, 4, bgcolor = color.new(chart.bg_color, 25), frame_color = color.new(chart.fg_color, 85), frame_width = 1, border_color = color.new(chart.fg_color, 85), border_width = 1)

if barstate.islast and showDashInput and not na(dashTable)
    dashTextSize = getTextSize(dashSizeInput)
    labelColor   = color.new(chart.fg_color, 30)
    mutedColor   = color.new(chart.fg_color, 55)

    trendText  = na(htfEma) ? "-" : trendIsUp ? "Up" : trendIsDown ? "Down" : "Flat"
    trendColor = trendIsUp ? bullColorInput : trendIsDown ? bearColorInput : mutedColor

    adxText  = na(adxValue) ? "-" : str.tostring(adxValue, "#.#") + (adxQuiet ? " (low)" : " (high)")
    adxColor = adxQuiet ? kColorInput : mutedColor

    kText      = na(kValue) ? "-" : str.tostring(kValue, "#.#") + (inBullZone ? " (above)" : inBearZone ? " (below)" : " (inside)")
    kZoneColor = inBullZone ? bullColorInput : inBearZone ? bearColorInput : chart.fg_color

    stateText  = popActive ? "Pop" : dropActive ? "Drop" : "None"
    stateColor = popActive ? bullColorInput : dropActive ? bearColorInput : mutedColor

    table.cell(dashTable, 0, 0, "HTF Trend", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, trendText, text_color = trendColor, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 1, "ADX (" + str.tostring(adxLengthInput) + ")", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, adxText, text_color = adxColor, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, "%K", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, kText, text_color = kZoneColor, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 3, "State", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, stateText, text_color = stateColor, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(popTrigger, "Bullish Pop", "Stochastic Pop on {{ticker}} - {{interval}}: %K pushed above the upper threshold with the enabled screens aligned — momentum ignition, continuation favored while the reading stays embedded")
alertcondition(popExit, "Bullish Pop Exit", "Stochastic Pop exit on {{ticker}} - {{interval}}: %K hooked back below the upper threshold — embedded reading lost, the burst is treated as spent")
alertcondition(dropTrigger, "Bearish Drop", "Stochastic Drop on {{ticker}} - {{interval}}: %K plunged below the lower threshold with the enabled screens aligned — downside ignition, continuation favored while the reading stays embedded")
alertcondition(dropExit, "Bearish Drop Exit", "Stochastic Drop exit on {{ticker}} - {{interval}}: %K hooked back above the lower threshold — embedded reading lost, the burst is treated as spent")

//---------------------------------------------------------------------------------------------------------------------}
