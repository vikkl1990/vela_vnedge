//@version=6
indicator("Fisher Transform", "Fisher", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // Fisher above its trigger - momentum turning up
BEAR_COLOR    = #f23645 // Fisher below its trigger - momentum turning down
NEUTRAL_COLOR = #787b86 // trigger line and reference levels

FILL_TRANSP = 80 // transparency of the fill between the Fisher and trigger lines
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(9, "Length", minval = 1, group = "Settings", tooltip = "Lookback period used to locate the median price hl2 within its highest-lowest range. Ehlers' original length is 10; 9 is the common platform default.")

fisherColorInput = input.color(NEUTRAL_COLOR, "Fisher Line", group = "Style", tooltip = "Color of the Fisher Transform line when it sits exactly on its trigger. Above and below the trigger the line takes the bullish and bearish colors.")
triggerColorInput = input.color(NEUTRAL_COLOR, "Trigger Line", group = "Style", tooltip = "Color of the trigger line, the Fisher Transform value delayed one bar.")
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style", tooltip = "Color of the Fisher line and fill while it is above the trigger.")
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style", tooltip = "Color of the Fisher line and fill while it is below the trigger.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
medianPrice = hl2

highestPrice = ta.highest(medianPrice, lengthInput)
lowestPrice = ta.lowest(medianPrice, lengthInput)
priceRange = highestPrice - lowestPrice

// A flat range contributes a 0 position term so the recursion stays defined; na only during the initial warm-up window
rangePosition = na(priceRange) ? float(na) : priceRange > 0 ? (medianPrice - lowestPrice) / priceRange - 0.5 : 0.0

var float smoothedPosition = na
var float fisher = na

smoothedPosition := 0.66 * rangePosition + 0.67 * nz(smoothedPosition[1])
smoothedPosition := smoothedPosition > 0.99 ? 0.999 : smoothedPosition < -0.99 ? -0.999 : smoothedPosition

fisher := 0.5 * math.log((1 + smoothedPosition) / (1 - smoothedPosition)) + 0.5 * nz(fisher[1])
trigger = fisher[1]
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish while Fisher leads its trigger, bearish while it lags
fisherColor = fisher > trigger ? bullColorInput : fisher < trigger ? bearColorInput : fisherColorInput

fisherPlotId  = plot(fisher, "Fisher", fisherColor, 2)
triggerPlotId = plot(trigger, "Trigger", triggerColorInput)

fill(fisherPlotId, triggerPlotId, color.new(fisherColor, FILL_TRANSP), title = "Fisher / Trigger Fill")

hline(1.5, "Upper Level", color = NEUTRAL_COLOR, linestyle = hline.style_dashed)
hline(-1.5, "Lower Level", color = NEUTRAL_COLOR, linestyle = hline.style_dashed)
hline(0, "Zero Line", color = NEUTRAL_COLOR, linestyle = hline.style_dotted)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
bullishTriggerCross = ta.crossover(fisher, trigger)
bearishTriggerCross = ta.crossunder(fisher, trigger)
bullishZeroCross = ta.crossover(fisher, 0)
bearishZeroCross = ta.crossunder(fisher, 0)

alertcondition(bullishTriggerCross, "Bullish Trigger Cross", "Fisher Transform crossed above its trigger line")
alertcondition(bearishTriggerCross, "Bearish Trigger Cross", "Fisher Transform crossed below its trigger line")
alertcondition(bullishZeroCross, "Bullish Zero Cross", "Fisher Transform crossed above zero")
alertcondition(bearishZeroCross, "Bearish Zero Cross", "Fisher Transform crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
