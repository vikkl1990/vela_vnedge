//@version=6
indicator("Market Structure & Fibonacci Zones + RR", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

// --- Inputs ---
string termInput = input.string("Mid", "Market Structure Term", options = ["Short", "Mid", "Long"])
bool   showOnlyValid = input.bool(false, "Show Only Valid Setups")
float  rrRatio   = input.float(2.0, "Risk/Reward Ratio", step = 0.5)
color bullColor  = input.color(#089981, "Bullish Color", group = "Style")
color bearColor  = input.color(#f23645, "Bearish Color", group = "Style")

// --- Logic ---
int len = termInput == "Short" ? 5 : termInput == "Mid" ? 10 : 20

float ph = ta.pivothigh(high, len, len)
float pl = ta.pivotlow(low, len, len)

var float lastPh = na
var int   lastPhIndex = na
var float lastPl = na
var int   lastPlIndex = na

var int trend = 0

var float lowestSincePh = na
var float highestSincePl = na
var int lowestSincePhIndex = na
var int highestSincePlIndex = na

// Active setup tracking
var box activeFibBox = na
var line activeBOSLine = na
var label activeBOSLabel = na

var float originPrice = na
var int fibDirection = 0 // 1 for bull, -1 for bear
var bool mitigateFib = false
var bool tradeTriggered = false

// Trade tracking
var box rrStopBox = na
var box rrTargetBox = na
var float tradeSl = na
var float tradeTp = na
var bool tradeActive = false

if not na(ph)
    lastPh := ph
    lastPhIndex := bar_index[len]
    lowestSincePh := low[len]
    lowestSincePhIndex := bar_index[len]

if not na(pl)
    lastPl := pl
    lastPlIndex := bar_index[len]
    highestSincePl := high[len]
    highestSincePlIndex := bar_index[len]

if not na(lastPh)
    if low < nz(lowestSincePh, low)
        lowestSincePh := low
        lowestSincePhIndex := bar_index

if not na(lastPl)
    if high > nz(highestSincePl, high)
        highestSincePl := high
        highestSincePlIndex := bar_index

bool bullBOS = false
bool bearBOS = false

if not na(lastPh) and close > lastPh and trend <= 0
    bullBOS := true
    trend := 1
    
if not na(lastPl) and close < lastPl and trend >= 0
    bearBOS := true
    trend := -1

if bullBOS
    if showOnlyValid and not tradeTriggered and not na(activeFibBox)
        box.delete(activeFibBox)
        line.delete(activeBOSLine)
        label.delete(activeBOSLabel)

    activeBOSLine := line.new(lastPhIndex, lastPh, bar_index, lastPh, color = bullColor, style = line.style_dashed)
    activeBOSLabel := label.new(math.round(math.avg(lastPhIndex, bar_index)), lastPh, "BOS", color = color.new(color.white, 100), style = label.style_label_down, textcolor = bullColor, size = size.tiny)
    
    originPrice := lowestSincePh
    float breakoutPoint = close
    float fib50 = originPrice + (breakoutPoint - originPrice) * 0.50
    float fib618 = originPrice + (breakoutPoint - originPrice) * 0.618
    
    activeFibBox := box.new(lowestSincePhIndex, fib50, bar_index + 10, fib618, border_color = color.new(bullColor, 50), bgcolor = color.new(bullColor, 80))
    mitigateFib := false
    tradeTriggered := false
    tradeActive := false
    fibDirection := 1
    lastPh := na

if bearBOS
    if showOnlyValid and not tradeTriggered and not na(activeFibBox)
        box.delete(activeFibBox)
        line.delete(activeBOSLine)
        label.delete(activeBOSLabel)

    activeBOSLine := line.new(lastPlIndex, lastPl, bar_index, lastPl, color = bearColor, style = line.style_dashed)
    activeBOSLabel := label.new(math.round(math.avg(lastPlIndex, bar_index)), lastPl, "BOS", color = color.new(color.white, 100), style = label.style_label_up, textcolor = bearColor, size = size.tiny)
    
    originPrice := highestSincePl
    float breakoutPoint = close
    float fib50 = originPrice - (originPrice - breakoutPoint) * 0.50
    float fib618 = originPrice - (originPrice - breakoutPoint) * 0.618
    
    activeFibBox := box.new(highestSincePlIndex, fib50, bar_index + 10, fib618, border_color = color.new(bearColor, 50), bgcolor = color.new(bearColor, 80))
    mitigateFib := false
    tradeTriggered := false
    tradeActive := false
    fibDirection := -1
    lastPl := na

if not na(activeFibBox) and not tradeTriggered
    if not mitigateFib
        box.set_right(activeFibBox, bar_index + 5)
        float bTop = box.get_top(activeFibBox)
        float bBot = box.get_bottom(activeFibBox)
        
        if (high >= bBot and low <= bTop) and bar_index > box.get_left(activeFibBox)
            mitigateFib := true
    else
        float bTop = box.get_top(activeFibBox)
        float bBot = box.get_bottom(activeFibBox)
        
        if fibDirection == 1 
            if low <= bTop and close > open 
                tradeTriggered := true
                tradeActive := true
                float entryPrice = close
                tradeSl := originPrice
                float risk = entryPrice - tradeSl
                tradeTp := entryPrice + (risk * rrRatio) 
                
                rrStopBox := box.new(bar_index, entryPrice, bar_index + 5, tradeSl, bgcolor=color.new(bearColor, 80), border_color=bearColor)
                rrTargetBox := box.new(bar_index, tradeTp, bar_index + 5, entryPrice, bgcolor=color.new(bullColor, 80), border_color=bullColor)
                
        else if fibDirection == -1 
            if high >= bBot and close < open 
                tradeTriggered := true
                tradeActive := true
                float entryPrice = close
                tradeSl := originPrice
                float risk = tradeSl - entryPrice
                tradeTp := entryPrice - (risk * rrRatio)
                
                rrStopBox := box.new(bar_index, entryPrice, bar_index + 5, tradeSl, bgcolor=color.new(bearColor, 80), border_color=bearColor)
                rrTargetBox := box.new(bar_index, tradeTp, bar_index + 5, entryPrice, bgcolor=color.new(bullColor, 80), border_color=bullColor)

if tradeActive
    box.set_right(rrStopBox, bar_index)
    box.set_right(rrTargetBox, bar_index)
    
    if fibDirection == 1
        if low <= tradeSl or high >= tradeTp
            tradeActive := false
    else if fibDirection == -1
        if high >= tradeSl or low <= tradeTp
            tradeActive := false

plotshape(not showOnlyValid and not na(ph), "Pivot High", shape.xcross, location.abovebar, color=color.new(bullColor, 50), size=size.tiny, offset=-len)
plotshape(not showOnlyValid and not na(pl), "Pivot Low", shape.xcross, location.belowbar, color=color.new(bearColor, 50), size=size.tiny, offset=-len)
