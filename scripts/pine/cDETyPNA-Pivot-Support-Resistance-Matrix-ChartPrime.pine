//@version=6
indicator('Pivot Support & Resistance Matrix [ChartPrime]', overlay = true, max_lines_count = 500, max_labels_count = 500, max_polylines_count = 100)

// --------------------------------------------------------------------------------------------------------------------}
// 📌 𝙐𝙎𝙀𝙍 𝙄𝙉𝙋𝙐𝙏𝙎
// --------------------------------------------------------------------------------------------------------------------{
grp_pivot = 'Pivot Settings'
p_left = input.int(5, 'Pivot Left Bars', minval = 1, group = grp_pivot)
p_right = input.int(5, 'Pivot Right Bars', minval = 1, group = grp_pivot)
lookback_bars = input.int(600, 'Calculation Lookback Window', minval = 10, tooltip = 'Limits profile execution, boundary tracking, and extends the POC line back by this many bars.', group = grp_pivot)

grp_sr = 'Support & Resistance Lines'
col_sup = input.color(color.teal, 'Support Color', group = grp_sr)
col_res = input.color(color.orange, 'Resistance Color', group = grp_sr)
col_broken = input.color(color.gray, 'Broken Line Color', group = grp_sr)
atr_len = input.int(14, 'ATR Length for Proximity', minval = 1, group = grp_sr)
atr_mult = input.float(2.0, 'ATR Proximity Multiplier', minval = 0.0, step = 0.1, tooltip = 'New lines won\'t spawn if an active line exists within this many ATRs', group = grp_sr)

grp_prof = 'Polyline Pivot Profile'
show_prof = input.bool(true, 'Show Profile', group = grp_prof)
prof_dist = input.int(20, 'Profile Distance', tooltip = 'Profile Distance from the last bar', group = grp_prof)
num_bins = input.int(200, 'Number of Bins', minval = 10, maxval = 300, group = grp_prof)
bin_radius = input.int(3, 'Bin Smoothing Radius (e.g., 1 looks at ±1 bin)', minval = 0, group = grp_prof)
prof_width = input.int(50, 'Profile Max Width (Bars)', minval = 10, group = grp_prof)

// --------------------------------------------------------------------------------------------------------------------}
// 📌 𝙄𝙉𝘿𝙄𝘾𝘼𝙏𝙊𝙍 𝘾𝘼𝙇𝘾𝙐𝙇𝘼𝙏𝙄𝙊index𝙉𝙎
// --------------------------------------------------------------------------------------------------------------------{
type SRLine
    line ln
    label lbl
    float level
    bool is_support
    bool is_broken
    int start_bar

// New custom Type to cache raw historical pivots accurately 
type PivotPoint
    float price
    int bar_idx

var array<SRLine> sr_lines = array.new<SRLine>()
var array<PivotPoint> all_pivots = array.new<PivotPoint>()

int calculation_start_bar = math.max(0, bar_index - lookback_bars)
// Core Calculations
ph = ta.pivothigh(high, p_left, p_right)
pl = ta.pivotlow(low, p_left, p_right)
atr = ta.atr(atr_len)

// Dynamic boundary coordinates tracking
var float max_price = high
var float min_price = low
if high > max_price or bar_index == 0
    max_price := high
if low < min_price or bar_index == 0
    min_price := low

var array<int> bin_counts = array.new_int(num_bins, 0)

// Persistent counters to determine the dominant pivot orientation
int total_res_pivots = 0
int total_sup_pivots = 0

// Proximity Filter Check Logic
is_overlapping(float price, float threshold, array<SRLine> lines) =>
    bool overlap = false
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1 by 1
            SRLine item = array.get(lines, i)
            if not item.is_broken and math.abs(item.level - price) <= threshold
                overlap := true
                break
    overlap

proximity_threshold = atr * atr_mult

// --------------------------------------------------------------------------------------------------------------------}
// 📌 𝙑𝙄𝙎𝙐𝘼𝙇𝙄𝙕𝘼𝙏𝙄𝙊𝙉
// --------------------------------------------------------------------------------------------------------------------{
// Track and collect all valid historical raw pivots regardless of overlap filtering rules
if not na(ph)
    array.push(all_pivots, PivotPoint.new(ph, bar_index - p_right))
if not na(pl)
    array.push(all_pivots, PivotPoint.new(pl, bar_index - p_right))

if last_bar_index - bar_index < lookback_bars
    // Spawn Resistance
    if not na(ph) and not is_overlapping(ph, proximity_threshold, sr_lines)
        int start_bar = bar_index - p_right
        line l = line.new(start_bar, ph, bar_index, ph, color = col_res, width = 1)
        label lb = label.new(bar_index, ph, text = str.tostring(ph, '#.##'), color = color.new(col_res, 80), style = label.style_label_left, textcolor = col_res, size = size.small)
        array.push(sr_lines, SRLine.new(l, lb, ph, false, false, start_bar))

    // Spawn Support
    if not na(pl) and not is_overlapping(pl, proximity_threshold, sr_lines)
        int start_bar = bar_index - p_right
        line l = line.new(start_bar, pl, bar_index, pl, color = col_sup, width = 1)
        label lb = label.new(bar_index, pl, text = str.tostring(pl, '#.##'), color = color.new(col_sup, 80), style = label.style_label_left, textcolor = col_sup, size = size.small)
        array.push(sr_lines, SRLine.new(l, lb, pl, true, false, start_bar))

    // Track breakouts and manage line properties dynamically
    if array.size(sr_lines) > 0
        for i = array.size(sr_lines) - 1 to 0 by 1
            SRLine item = array.get(sr_lines, i)

            if not item.is_broken
                line.set_x2(item.ln, bar_index)
                label.set_x(item.lbl, bar_index)

                // Dynamic evaluation window check
                if last_bar_index - item.start_bar <= lookback_bars
                    if not item.is_support
                        total_res_pivots += 1
                    else 
                        total_sup_pivots += 1

                bool broken_up = close > item.level and item.is_support == false
                bool broken_dn = close < item.level and item.is_support == true

                if broken_up or broken_dn
                    item.is_broken := true
                    line.set_color(item.ln, col_broken)
                    line.set_style(item.ln, line.style_dashed)

                    string vol_text = volume > 1000000 ? str.tostring(volume / 1000000, '#.#M') : volume > 1000 ? str.tostring(volume / 1000, '#.#K') : str.tostring(volume)

                    label.set_text(item.lbl, vol_text)
                    label.set_color(item.lbl, color.new(col_broken, 100))
                    label.set_textcolor(item.lbl, chart.fg_color)
                    label.set_style(item.lbl, broken_up ? label.style_label_lower_right : label.style_label_upper_right)

// Draw Polyline Profile Matrix & Labels
var polyline prof_line = na
var label top_lbl = na
var label btm_lbl = na
var line poc_line = na
var label poc_lbl = na

if show_prof and barstate.islast
    polyline.delete(prof_line)
    label.delete(top_lbl)
    label.delete(btm_lbl)
    line.delete(poc_line)
    label.delete(poc_lbl)

    // Recalculate true boundaries exclusively within the chosen window profile range
    float local_max = high
    float local_min = low
    
    for k = 0 to bar_index - calculation_start_bar by 1
        float hi = high[k]
        float lo = low[k]
        if hi > local_max or k == 0
            local_max := hi
        if lo < local_min or k == 0
            local_min := lo

    float bin_size = (local_max - local_min) / num_bins

    // Calculate bin counts mapping across all historical points captured inside your lookback range
    if array.size(all_pivots) > 0 and local_max > local_min
        for i = 0 to array.size(all_pivots) - 1 by 1
            PivotPoint p_point = array.get(all_pivots, i)
            
            // Filter strictly based on your calculation window choice 
            if bar_index - p_point.bar_idx <= lookback_bars and p_point.price >= local_min and p_point.price <= local_max
                int central_bin = math.floor((p_point.price - local_min) / bin_size)
                central_bin := math.max(0, math.min(num_bins - 1, central_bin))

                int start_bin = math.max(0, central_bin - bin_radius)
                int end_bin = math.min(num_bins - 1, central_bin + bin_radius)
                
                for j = start_bin to end_bin by 1
                    array.set(bin_counts, j, array.get(bin_counts, j) + 1)

    int max_count = array.max(bin_counts)
    float scale = max_count > 0 ? float(prof_width) / max_count : 1.0

    array<chart.point> points = array.new<chart.point>()
    int anchor_x = bar_index + prof_width + prof_dist

    int max_bin_index = 0
    int max_bin_count = 0

    for i = 0 to num_bins - 1 by 1
        int count = array.get(bin_counts, i)
        float floor_y = local_min + i * bin_size
        float ceil_y = floor_y + bin_size

        if count > max_bin_count
            max_bin_count := count
            max_bin_index := i

        int push_back_x = bar_index - math.round(count * scale) + prof_width + prof_dist

        if i == 0
            array.push(points, chart.point.from_index(anchor_x, floor_y))

        array.push(points, chart.point.from_index(push_back_x, floor_y))
        array.push(points, chart.point.from_index(push_back_x, ceil_y))

        if i == num_bins - 1
            array.push(points, chart.point.from_index(anchor_x, ceil_y))

    // Determine the profile color based on dominant pivot registration counts
    color dynamic_prof_color = total_res_pivots <= total_sup_pivots ? col_sup : col_res

    // Render the Profile Polyline
    prof_line := polyline.new(points, line_color = color.new(dynamic_prof_color, 0), fill_color = color.new(dynamic_prof_color, 90), line_width = 1)

    // Render Point of Control (POC) structural elements extended across our complete lookback matrix input window
    if max_bin_count > 0
        float poc_level = local_min + (max_bin_index * bin_size) + (bin_size / 2.0)
        int poc_extended_back_x = math.max(0, bar_index - lookback_bars)
        
        poc_line := line.new(poc_extended_back_x, poc_level, anchor_x, poc_level, color = color.red, width = 1, style = line.style_solid)
        poc_lbl  := label.new(anchor_x, poc_level, text = "Pivots: " + str.tostring(max_bin_count), color = color.new(chart.bg_color, 100), textcolor = color.red, style = label.style_label_left, size = size.small)

    // Render Metric Labels at the absolute profile margins
    string top_text = "Pivot Profile\n" + str.tostring(local_max, "#.##")
    top_lbl := label.new(anchor_x, local_max, text = top_text, color = color.new(chart.bg_color, 100), textcolor = chart.fg_color, style = label.style_label_down, size = size.small)
    
    string btm_text = str.tostring(local_min, "#.##")
    btm_lbl := label.new(anchor_x, local_min, text = btm_text, color = color.new(chart.bg_color, 100), textcolor = chart.fg_color, style = label.style_label_up, size = size.small)
// --------------------------------------------------------------------------------------------------------------------}