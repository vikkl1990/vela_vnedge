//@version=6
indicator("Macro Risk Sentinel", shorttitle="Risk Sentinel", overlay=false)

grp_data    = "Macro Data"
sym_hyg     = input.symbol("AMEX:HYG", "High Yield Bond", group=grp_data)
sym_ief     = input.symbol("NASDAQ:IEF", "7-10Y Treasury", group=grp_data)
sym_vix     = input.symbol("CBOE:VIX", "VIX (Short Term)", group=grp_data)
sym_vix3m   = input.symbol("CBOE:VIX3M", "VIX3M (Mid Term)", group=grp_data)

grp_trig    = "Triggers (Sensitivity)"
trig_min_roc = input.float(-0.8, "Yellow Threshold (Credit %)", step=0.1, maxval=0, group=grp_trig)
trig_maj_vix = input.float(1.08, "Red Threshold (VIX Ratio)", step=0.01, group=grp_trig, tooltip="True panic (>1.08) is required to trigger the lockdown.")
trig_maj_roc = input.float(-2.0, "Red Threshold (Credit %)", step=0.1, maxval=0, group=grp_trig)

grp_recov   = "Buffer & Recovery (Smart Unlock)"
buffer_max  = input.int(30, "Max Lockdown Duration (Days)", minval=10, group=grp_recov)
recov_ema   = input.int(20, "Recovery EMA (Price)", minval=10, group=grp_recov, tooltip="If price closes above this EMA and VIX is calm, unlock immediately.")

grp_visu    = "Display"
show_ban    = input.bool(true, "Red Zone (Stop)", group=grp_visu)
show_warn   = input.bool(true, "Yellow Zone (Caution)", group=grp_visu)

c_hyg   = request.security(sym_hyg, timeframe.period, close, gaps=barmerge.gaps_on)
c_ief   = request.security(sym_ief, timeframe.period, close, gaps=barmerge.gaps_on)
c_vix   = request.security(sym_vix, timeframe.period, close, gaps=barmerge.gaps_on)
c_vix3m = request.security(sym_vix3m, timeframe.period, close, gaps=barmerge.gaps_on)

ratio_credit = c_hyg / c_ief
ratio_vol    = c_vix / c_vix3m
credit_roc   = ta.roc(ratio_credit, 2)

ema_recovery = ta.ema(close, recov_ema)
is_market_healthy = (close > ema_recovery) and (ratio_vol < 1.0)

bool signal_red   = (credit_roc < trig_maj_roc) or (ratio_vol > trig_maj_vix)
bool signal_yellow= ((credit_roc < trig_min_roc) or (ratio_vol > 1.00)) and not signal_red

var bool locked = false
var int days_locked = 0

if signal_red
    locked := true
    days_locked := 0
else if locked
    days_locked += 1
    
    if is_market_healthy
        locked := false
        days_locked := 0
    else if days_locked >= buffer_max
        locked := false
        days_locked := 0

int state = 0
if locked
    state := 2
else if signal_yellow
    state := 1

color col_state = color.new(color.teal, 60)
if state == 1
    col_state := color.new(color.yellow, 10)
if state == 2
    col_state := color.red

plot(state, "Market State", color=col_state, style=plot.style_columns, linewidth=4)

bg_red = (show_ban and state == 2) ? color.new(color.red, 80) : na
bg_yel = (show_warn and state == 1) ? color.new(color.yellow, 85) : na
bgcolor(bg_red, title="Red Zone")
bgcolor(bg_yel, title="Yellow Zone")

plotchar(signal_red and not signal_red[1], title="CRASH", char="⛔", location=location.top, color=color.red, size=size.tiny)

bool smart_unlock = not locked and locked[1] and is_market_healthy
plotchar(smart_unlock, title="SMART RECOVERY", char="🚀", location=location.top, color=color.lime, size=size.small)

bool time_unlock = not locked and locked[1] and not is_market_healthy
plotchar(time_unlock, title="TIME UNLOCK", char="⏳", location=location.top, color=color.white, size=size.tiny)

var table panel = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "MACRO RISK SENTINEL", bgcolor=color.black, text_color=color.white)
    
    string txt = "SAFE"
    color col = color.green
    
    if locked
        txt := "LOCKED (" + str.tostring(days_locked) + "/" + str.tostring(buffer_max) + "d)"
        col := color.red
    else if state == 1
        txt := "YELLOW ALERT"
        col := color.yellow
        
    table.cell(panel, 1, 0, txt, bgcolor=col, text_color=col == color.yellow ? color.black : color.white)
    
    table.cell(panel, 0, 1, "Recovery Cond.", bgcolor=color.gray, text_color=color.white)
    string recov_txt = is_market_healthy ? "VALID (Price > EMA)" : "WAITING"
    table.cell(panel, 1, 1, recov_txt, bgcolor=is_market_healthy ? color.green : color.black, text_color=color.white)

    table.cell(panel, 0, 2, "VIX Ratio (>1.08)", bgcolor=color.gray, text_color=color.white)
    table.cell(panel, 1, 2, str.tostring(ratio_vol, "#.##"), bgcolor=ratio_vol > trig_maj_vix ? color.red : color.black, text_color=color.white)
    
    table.cell(panel, 0, 3, "Credit ROC (<-2%)", bgcolor=color.gray, text_color=color.white)
    table.cell(panel, 1, 3, str.tostring(credit_roc, "#.##") + "%", bgcolor=credit_roc < trig_maj_roc ? color.red : color.black, text_color=color.white)