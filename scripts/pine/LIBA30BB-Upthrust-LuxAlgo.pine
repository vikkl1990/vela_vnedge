//@version=6
indicator("Upthrust", "Upthrust", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
//Input groups
GRP_RANGE = "Trading Range"
GRP_UT    = "Upthrust"
GRP_STYLE = "Style"

//Drawing transparencies
RANGE_FILL_TRANSPARENCY   = 92
SUPPORT_LINE_TRANSPARENCY = 40
ZONE_BG_TRANSPARENCY      = 85
ZONE_BORDER_TRANSPARENCY  = 60
UT_LINE_TRANSPARENCY      = 30

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
swingLengthInput = input.int(10, "Swing Length", minval = 2, maxval = 50, group = GRP_RANGE,
  tooltip = "Bars to the left and right required to confirm a swing high or swing low. Clustered swing highs define the range resistance - the climax high and its later tests - while swing lows seed and refine range support.")

toleranceInput = input.float(0.5, "Resistance Tolerance (ATR)", minval = 0.05, maxval = 3, step = 0.05, group = GRP_RANGE,
  tooltip = "Maximum distance between swing highs, in ATR multiples, for them to count as tests of the same resistance. A trading range is framed once two swing highs cluster inside this tolerance with nothing in between exceeding the level by more than the tolerance.")

atrLengthInput = input.int(14, "ATR Length", minval = 5, maxval = 100, group = GRP_RANGE,
  tooltip = "Average True Range length used to normalize the resistance tolerance, the minimum penetration and the penetration grade.")

maturityInput = input.int(20, "Minimum Range Maturity (Bars)", minval = 0, maxval = 500, group = GRP_RANGE,
  tooltip = "Bars the range must have aged since its first swing high before a poke above resistance may be labeled an upthrust. The upthrust is defined by its context - a mature trading range where breakout buy stops have built up above the highs.")

uptrendFilterInput = input.bool(true, "Require Prior Uptrend", group = GRP_RANGE,
  tooltip = "Only frame ranges that price advanced into, matching the classical distribution context of a mature range following an uptrend. Disable to also monitor accumulation or re-accumulation ranges, where failed pokes above resistance are labeled upthrusts as well.")

uptrendLookbackInput = input.int(50, "Uptrend Lookback", minval = 5, maxval = 300, group = GRP_RANGE,
  tooltip = "Bars used to measure the advance into the range: the close at the range's first swing high must exceed the close this many bars earlier.")

penetrationInput = input.float(0.0, "Minimum Penetration (ATR)", minval = 0, maxval = 3, step = 0.05, group = GRP_UT,
  tooltip = "Minimum distance above resistance, in ATR multiples, the excursion high must reach before a failed poke qualifies as an upthrust. 0 accepts any trade above the level.")

acceptanceWindowInput = input.int(3, "Acceptance Window (Bars)", minval = 1, maxval = 20, group = GRP_UT,
  tooltip = "Maximum consecutive closes beyond a range boundary before price is treated as accepted there. A push above resistance reclaimed inside the window confirms an upthrust; closes persisting beyond it mark a genuine breakout - and, below support, the breakdown that retires the range. Fewer closes above means a swifter reclaim and a stronger upthrust read.")

volumeLengthInput = input.int(20, "Volume Average Length", minval = 1, maxval = 200, group = GRP_UT,
  tooltip = "Length of the moving average used as the effort baseline. The heaviest volume printed during the excursion above resistance is measured against it.")

highEffortInput = input.float(1.5, "High Effort Volume x", minval = 1, step = 0.1, group = GRP_UT,
  tooltip = "Excursion volume at or above this multiple of the baseline grades the upthrust as high effort: volume expanded into new highs yet the bar closed back inside - supply meeting the breakout buying.")

lowEffortInput = input.float(0.8, "No Demand Volume x", minval = 0.1, maxval = 1, step = 0.05, group = GRP_UT,
  tooltip = "Excursion volume at or below this multiple of the baseline grades the upthrust as no demand: a listless poke where buyers never showed up. Both signatures support the bearish read; what matters most is the close back inside the range.")

showRangeInput = input.bool(true, "Range Boundaries", group = GRP_STYLE,
  tooltip = "Draw the framed trading range: solid resistance at the clustered swing highs, dashed support at the range lows, and a soft fill between them. Boundaries stop extending once the range resolves.")

showLabelsInput = input.bool(true, "Upthrust Labels", group = GRP_STYLE,
  tooltip = "Mark each confirmed upthrust at its excursion high - UT for an ordinary upthrust, UTAD when a later upthrust fails above the prior range high. The label tooltip carries the grade: penetration, effort and reclaim speed.")

showZonesInput = input.bool(true, "Upthrust Zones", group = GRP_STYLE,
  tooltip = "Shade the failed excursion between resistance and the upthrust high, from the poke to the bar that closed back inside - the trap holding the breakout buyers.")

showLineInput = input.bool(true, "Upthrust High Line", group = GRP_STYLE,
  tooltip = "Extend a dashed line from the upthrust high while the level is tracked - the invalidation reference conventionally used for stops above the high. The line stops where price accepts back above it or the range resolves.")

showTestsInput = input.bool(true, "Test Labels", group = GRP_STYLE,
  tooltip = "Mark the completed secondary test: the first rally after the upthrust that stalls beneath the upthrust high on volume lighter than the upthrust itself.")

bearColorInput = input.color(#f23645, "Upthrust", group = GRP_STYLE,
  tooltip = "Color of the upthrust labels, excursion zones, tracked upthrust high line and test marks.")

bullColorInput = input.color(#089981, "Invalidation", group = GRP_STYLE,
  tooltip = "Color of the invalidation cross printed when price accepts back above the tracked upthrust high.")

rangeColorInput = input.color(#787b86, "Range", group = GRP_STYLE,
  tooltip = "Color of the framed trading range boundaries and fill.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
//Classify the effort spent on the excursion relative to the volume baseline
effortLabel(float volumeRatio) =>
    string gradeText = volumeRatio >= highEffortInput ? "high effort - supply met the breakout" : volumeRatio <= lowEffortInput ? "no demand - buyers never showed up" : "average effort"
    na(volumeRatio) ? "n/a" : str.tostring(volumeRatio, "#.##") + "x average (" + gradeText + ")"

//Grade block attached to each upthrust label: penetration, effort and reclaim speed
upthrustTooltip(bool isUtad, float penetrationAtr, float volumeRatio, int closesAboveCount) =>
    string headLine    = isUtad ? "UTAD - failed final test of demand above the prior range high" : "UT - failed poke above range resistance"
    string penetration = na(penetrationAtr) ? "n/a" : str.tostring(penetrationAtr, "#.##") + " ATR above resistance"
    string reclaim     = closesAboveCount == 0 ? "same bar" : str.tostring(closesAboveCount) + (closesAboveCount == 1 ? " close above resistance" : " closes above resistance")
    headLine + "\nPenetration: " + penetration + "\nEffort: " + effortLabel(volumeRatio) + "\nReclaim: " + reclaim

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Volatility and effort baselines
float atrValue      = ta.atr(atrLengthInput)
float volumeAverage = ta.sma(volume, volumeLengthInput)

//Confirmed swing points framing the range (known swingLength bars after the fact)
float pivotHighPrice = ta.pivothigh(swingLengthInput, swingLengthInput)
float pivotLowPrice  = ta.pivotlow(swingLengthInput, swingLengthInput)

//Window extremes seeding a fresh resistance candidate (pivot bar through its confirmation bar)
float windowHigh = ta.highest(high, swingLengthInput + 1)
float windowLow  = ta.lowest(low, swingLengthInput + 1)

//Advance into the swing high being confirmed - the prior-uptrend context of distribution
float referenceClose = close[swingLengthInput + uptrendLookbackInput]
bool  advanceOk      = not na(referenceClose) and close[swingLengthInput] > referenceClose
bool  contextOk      = not uptrendFilterInput or advanceOk

//Resistance candidate awaiting its confirming test
var float candidateLevel   = na
var int   candidateBar     = na
var float candidateMaxHigh = na
var float candidateMinLow  = na

//Active trading range
var bool  rangeActive     = false
var float resistanceLevel = na
var float supportLevel    = na
var int   rangeStartBar   = na
var float rangeHigh       = na
var int   upthrustCount   = 0
var int   closesBelow     = 0

//Running excursion above resistance
var bool  excursionActive   = false
var int   excursionStartBar = na
var int   closesAbove       = 0
var float excursionHigh     = na
var int   excursionHighBar  = na
var float excursionVolume   = na
var float excursionBaseHigh = na

//Tracked upthrust awaiting its test or invalidation
var bool  upthrustActive = false
var float upthrustHigh   = na
var int   upthrustBar    = na
var float upthrustVolume = na
var bool  upthrustTested = false

//Range drawings
var line resistanceLine = na
var line supportLine    = na
var box  rangeBox       = na
var line upthrustLine   = na

//Per-bar events
bool  upthrustEvent     = false
bool  utadEvent         = false
bool  testEvent         = false
bool  invalidationEvent = false
float invalidationLevel = na

if barstate.isconfirmed
    //Manage the active range
    if rangeActive
        //Keep drawings in step with the developing range
        if not na(resistanceLine)
            line.set_x2(resistanceLine, bar_index)
        if not na(supportLine)
            line.set_x2(supportLine, bar_index)
            line.set_y1(supportLine, supportLevel)
            line.set_y2(supportLine, supportLevel)
        if not na(rangeBox)
            box.set_right(rangeBox, bar_index)
            box.set_bottom(rangeBox, supportLevel)
        if upthrustActive and not na(upthrustLine)
            line.set_x2(upthrustLine, bar_index)

        bool endRange      = false
        bool acceptedAbove = false

        //Acceptance back above the tracked upthrust high - the conventional exit, not a level to argue with
        if upthrustActive and close > upthrustHigh
            invalidationEvent := true
            invalidationLevel := upthrustHigh
            upthrustActive    := false
            upthrustLine      := line(na)

        //Pokes and excursions at the range's upper boundary
        bool  rangeMature      = bar_index - rangeStartBar >= maturityInput
        float penetrationFloor = resistanceLevel + penetrationInput * atrValue
        bool  confirmUpthrust  = false

        if not excursionActive
            if close > resistanceLevel
                //Close above resistance - the excursion runs until price is reclaimed or accepted
                excursionActive   := true
                excursionStartBar := bar_index
                closesAbove       := 1
                excursionHigh     := high
                excursionHighBar  := bar_index
                excursionVolume   := volume
                excursionBaseHigh := rangeHigh
            else if high > penetrationFloor and close <= resistanceLevel and rangeMature
                //Same-bar upthrust: traded above resistance yet closed back inside
                excursionStartBar := bar_index
                closesAbove       := 0
                excursionHigh     := high
                excursionHighBar  := bar_index
                excursionVolume   := volume
                excursionBaseHigh := rangeHigh
                confirmUpthrust   := true
        else
            //Track the running excursion extreme and its heaviest effort
            if high > excursionHigh
                excursionHigh    := high
                excursionHighBar := bar_index
            excursionVolume := math.max(excursionVolume, volume)
            if close <= resistanceLevel
                //Reclaimed inside the window - the failed breakout is an upthrust
                excursionActive := false
                if rangeMature and excursionHigh > penetrationFloor
                    confirmUpthrust := true
            else
                closesAbove += 1
                if closesAbove > acceptanceWindowInput
                    //Price built acceptance above the range - a breakout, not an upthrust
                    endRange      := true
                    acceptedAbove := true

        //Register the confirmed upthrust with its grade
        if confirmUpthrust
            float volumeRatio    = na(volumeAverage) or volumeAverage == 0 ? na : excursionVolume / volumeAverage
            float penetrationAtr = na(atrValue) or atrValue == 0 ? na : (excursionHigh - resistanceLevel) / atrValue
            bool  isUtad         = upthrustCount > 0 and excursionHigh > excursionBaseHigh
            upthrustEvent := true
            utadEvent     := isUtad
            if showZonesInput
                box.new(excursionStartBar, excursionHigh, bar_index, resistanceLevel
                  , border_color = color.new(bearColorInput, ZONE_BORDER_TRANSPARENCY)
                  , border_style = line.style_dashed
                  , border_width = 1
                  , bgcolor      = color.new(bearColorInput, ZONE_BG_TRANSPARENCY))
            if showLabelsInput
                label.new(excursionHighBar, excursionHigh, isUtad ? "UTAD" : "UT"
                  , style     = label.style_label_down
                  , color     = bearColorInput
                  , textcolor = chart.bg_color
                  , size      = size.small
                  , tooltip   = upthrustTooltip(isUtad, penetrationAtr, volumeRatio, closesAbove))
            //The excursion high becomes (or lifts) the tracked invalidation level
            if not upthrustActive or excursionHigh > upthrustHigh
                upthrustHigh := excursionHigh
                if showLineInput
                    upthrustLine := line.new(excursionHighBar, excursionHigh, bar_index, excursionHigh
                      , color = color.new(bearColorInput, UT_LINE_TRANSPARENCY)
                      , style = line.style_dashed
                      , width = 1)
            upthrustActive := true
            upthrustBar    := bar_index
            upthrustVolume := excursionVolume
            upthrustTested := false
            upthrustCount  += 1

        //Secondary test: a later rally stalling beneath the upthrust high on shrinking volume
        if upthrustActive and not upthrustTested and not na(pivotHighPrice)
            int   testBar       = bar_index - swingLengthInput
            float testVolume    = volume[swingLengthInput]
            bool  afterUpthrust = testBar > upthrustBar
            bool  stalledBelow  = pivotHighPrice < upthrustHigh and pivotHighPrice >= resistanceLevel - toleranceInput * atrValue
            bool  volumeShrank  = na(testVolume) or na(upthrustVolume) or testVolume < upthrustVolume
            if afterUpthrust and stalledBelow and volumeShrank
                upthrustTested := true
                testEvent      := true
                if showTestsInput
                    label.new(testBar, pivotHighPrice, "Test"
                      , style     = label.style_label_down
                      , color     = #00000000
                      , textcolor = bearColorInput
                      , size      = size.tiny
                      , tooltip   = "Rally stalled beneath the upthrust high on volume lighter than the upthrust - the failure is confirmed")

        //Refine support on confirmed swing lows printed inside the range
        if not na(pivotLowPrice) and bar_index - swingLengthInput >= rangeStartBar and pivotLowPrice < supportLevel
            supportLevel := pivotLowPrice

        //Retire the range once closes below support persist - the resolution out of the range
        closesBelow := close < supportLevel ? closesBelow + 1 : 0
        if closesBelow > acceptanceWindowInput
            endRange := true

        if endRange
            if acceptedAbove and upthrustActive
                //Acceptance back above the range contradicts the upthrust read
                invalidationEvent := true
                invalidationLevel := upthrustHigh
            rangeActive     := false
            excursionActive := false
            upthrustActive  := false
            upthrustLine    := line(na)
            closesAbove     := 0
            closesBelow     := 0

        //Mark the invalidation at the level being negated
        if invalidationEvent and not na(invalidationLevel)
            label.new(bar_index, invalidationLevel, ""
              , style     = label.style_xcross
              , color     = bullColorInput
              , textcolor = bullColorInput
              , size      = size.small
              , tooltip   = "Acceptance back above the upthrust high - the upthrust read is invalidated")

        //Running range extreme; its pre-poke value is snapshotted when an excursion begins
        rangeHigh := math.max(rangeHigh, high)

    //Scan for a fresh range while none is active
    if not rangeActive
        //Track the candidate segment's extremes
        if not na(candidateLevel)
            candidateMaxHigh := math.max(candidateMaxHigh, high)
            candidateMinLow  := math.min(candidateMinLow, low)
        if not na(pivotHighPrice)
            float clusterTolerance = toleranceInput * atrValue
            if na(candidateLevel)
                //A swing high preceded by an advance opens a resistance candidate
                if contextOk
                    candidateLevel   := pivotHighPrice
                    candidateBar     := bar_index - swingLengthInput
                    candidateMaxHigh := windowHigh
                    candidateMinLow  := windowLow
            else
                bool sameLevel = math.abs(pivotHighPrice - candidateLevel) <= clusterTolerance
                bool heldBelow = candidateMaxHigh <= math.max(pivotHighPrice, candidateLevel) + clusterTolerance
                bool insideNow = close <= math.max(pivotHighPrice, candidateLevel)
                if sameLevel and heldBelow and insideNow
                    //Resistance established: the climax high confirmed by a later test
                    rangeActive     := true
                    resistanceLevel := math.max(pivotHighPrice, candidateLevel)
                    supportLevel    := candidateMinLow
                    rangeStartBar   := candidateBar
                    rangeHigh       := candidateMaxHigh
                    upthrustCount   := 0
                    closesAbove     := 0
                    closesBelow     := 0
                    upthrustActive  := false
                    upthrustTested  := false
                    excursionActive := false
                    candidateLevel  := na
                    if showRangeInput
                        resistanceLine := line.new(rangeStartBar, resistanceLevel, bar_index, resistanceLevel, color = rangeColorInput, width = 1)
                        supportLine    := line.new(rangeStartBar, supportLevel, bar_index, supportLevel
                          , color = color.new(rangeColorInput, SUPPORT_LINE_TRANSPARENCY)
                          , style = line.style_dashed
                          , width = 1)
                        rangeBox       := box.new(rangeStartBar, resistanceLevel, bar_index, supportLevel, border_color = color(na), bgcolor = color.new(rangeColorInput, RANGE_FILL_TRANSPARENCY))
                    else
                        resistanceLine := line(na)
                        supportLine    := line(na)
                        rangeBox       := box(na)
                else if contextOk
                    //Start over from the newest swing high
                    candidateLevel   := pivotHighPrice
                    candidateBar     := bar_index - swingLengthInput
                    candidateMaxHigh := windowHigh
                    candidateMinLow  := windowLow
                else
                    candidateLevel := na

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(upthrustEvent, "Upthrust Detected", "Upthrust - price poked above range resistance and closed back inside the range")
alertcondition(utadEvent, "UTAD Detected", "UTAD - a failed final test of demand above the prior range high; watch the following rallies for weakness")
alertcondition(testEvent, "Upthrust Test Completed", "Upthrust test - a rally stalled beneath the upthrust high on shrinking volume, confirming the failure")
alertcondition(invalidationEvent, "Upthrust Invalidated", "Upthrust invalidated - price accepted back above the upthrust high, contradicting the distribution read")

//---------------------------------------------------------------------------------------------------------------------}
