//@version=6
indicator("MSS Sweeps", "MSS Sweeps", overlay = true, max_labels_count = 500, max_lines_count = 500, calc_bars_count = 5000)

// --- Constants ---
int BULLISH_LEG = 1
int BEARISH_LEG = 0
int BULLISH = 1
int BEARISH = -1
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color NEUTRAL_COLOR = #5b9cf6

// --- Inputs ---
groupStructure = "Internal Structure"
groupDisplay = "Display"
groupStyle = "Style"

internalLengthInput = input.int(5, "Internal structure length", minval = 2, maxval = 50, group = groupStructure, tooltip = "Internal pivot length used by the SMC leg calculation. The SMC default is 5.")
confluenceFilterInput = input.bool(false, "Confluence filter", group = groupStructure, tooltip = "Use the SMC internal candle confluence filter. Disabled by default to match the standard SMC setting.")
showBosInput = input.bool(true, "Show BOS labels", group = groupDisplay, tooltip = "Display only BOS events that follow a hidden CHOCH.")
showChochInput = input.bool(false, "Show CHOCH labels", group = groupDisplay, tooltip = "Display the first break against the current internal trend. Disabled by default.")
showSignalInput = input.bool(true, "Show MSS sweeps", group = groupDisplay, tooltip = "Show only first-touch higher-low and lower-high sweeps that close in the BOS direction.")
showProtectedLevelInput = input.bool(true, "Show protected level", group = groupDisplay, tooltip = "Extend the protected higher low or lower high after a visible BOS.")
bullColorInput = input.color(BULL_COLOR, "Bullish color", group = groupStyle, tooltip = "Color used for bullish BOS and bullish MSS sweeps.")
bearColorInput = input.color(BEAR_COLOR, "Bearish color", group = groupStyle, tooltip = "Color used for bearish BOS and bearish MSS sweeps.")
levelColorInput = input.color(NEUTRAL_COLOR, "Protected level color", group = groupStyle, tooltip = "Color used for protected higher-low and lower-high levels.")

// --- SMC internal leg calculation ---
leg(int size) =>
    var int legValue = 0
    newLegHigh = high[size] > ta.highest(size)
    newLegLow = low[size] < ta.lowest(size)
    if newLegHigh
        legValue := BEARISH_LEG
    else if newLegLow
        legValue := BULLISH_LEG
    legValue

currentLeg = leg(internalLengthInput)
legChange = ta.change(currentLeg)
newInternalLow = legChange == BULLISH_LEG
newInternalHigh = legChange == BEARISH_LEG - 1

var float internalHighLevel = na
var int internalHighIndex = na
var bool internalHighCrossed = false
var float internalLowLevel = na
var int internalLowIndex = na
var bool internalLowCrossed = false

if newInternalLow
    internalLowLevel := low[internalLengthInput]
    internalLowIndex := bar_index[internalLengthInput]
    internalLowCrossed := false

if newInternalHigh
    internalHighLevel := high[internalLengthInput]
    internalHighIndex := bar_index[internalLengthInput]
    internalHighCrossed := false

// --- SMC structure breaks ---
bullishBar = high - math.max(close, open) > math.min(close, open - low)
bearishBar = high - math.max(close, open) < math.min(close, open - low)
bullishCross = ta.crossover(close, internalHighLevel)
bearishCross = ta.crossunder(close, internalLowLevel)
bullishStructureBreak = not na(internalHighLevel) and not internalHighCrossed and bullishCross and (not confluenceFilterInput or bullishBar)
bearishStructureBreak = not na(internalLowLevel) and not internalLowCrossed and bearishCross and (not confluenceFilterInput or bearishBar)

var int internalTrend = 0
var bool bullishChochOccurred = false
var bool bearishChochOccurred = false

// SMC classifies a break against the current trend as CHOCH and the next break
// in that direction as BOS. CHOCH is intentionally not displayed.
bullishChoch = bullishStructureBreak and internalTrend == BEARISH
bearishChoch = bearishStructureBreak and internalTrend == BULLISH
bullishBos = bullishStructureBreak and internalTrend == BULLISH and bullishChochOccurred
bearishBos = bearishStructureBreak and internalTrend == BEARISH and bearishChochOccurred

if bullishStructureBreak
    internalHighCrossed := true
    if bullishChoch
        bullishChochOccurred := true
        bearishChochOccurred := false
    internalTrend := BULLISH

if bearishStructureBreak
    internalLowCrossed := true
    if bearishChoch
        bearishChochOccurred := true
        bullishChochOccurred := false
    internalTrend := BEARISH

// --- Protected level and MSS sweep state ---
var int activeDirection = 0
var float protectedLevel = na
var int protectedIndex = na
var line protectedLine = na

// Only the first wick through the protected level can produce a signal.
protectedLowWick = activeDirection == BULLISH and not na(protectedLevel) and low < protectedLevel
protectedHighWick = activeDirection == BEARISH and not na(protectedLevel) and high > protectedLevel
protectedLowSweep = barstate.isconfirmed and protectedLowWick and close > protectedLevel and close > open
protectedHighSweep = barstate.isconfirmed and protectedHighWick and close < protectedLevel and close < open
protectedLowFailure = barstate.isconfirmed and protectedLowWick and not protectedLowSweep
protectedHighFailure = barstate.isconfirmed and protectedHighWick and not protectedHighSweep

if protectedLowSweep
    if showSignalInput
        label.new(bar_index, low, "HL sweep", style = label.style_label_up, color = bullColorInput, textcolor = chart.fg_color, size = size.small)
    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)
        line.set_extend(protectedLine, extend.none)
    activeDirection := 0
    protectedLevel := na
    protectedIndex := na
else if protectedLowFailure
    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)
        line.set_extend(protectedLine, extend.none)
    activeDirection := 0
    protectedLevel := na
    protectedIndex := na

if protectedHighSweep
    if showSignalInput
        label.new(bar_index, high, "LH sweep", style = label.style_label_down, color = bearColorInput, textcolor = chart.fg_color, size = size.small)
    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)
        line.set_extend(protectedLine, extend.none)
    activeDirection := 0
    protectedLevel := na
    protectedIndex := na
else if protectedHighFailure
    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)
        line.set_extend(protectedLine, extend.none)
    activeDirection := 0
    protectedLevel := na
    protectedIndex := na

// --- Optional CHOCH events ---
if bullishChoch and showChochInput
    line.new(internalHighIndex, internalHighLevel, bar_index, internalHighLevel, xloc = xloc.bar_index, extend = extend.none, color = bullColorInput, style = line.style_dashed, width = 1)
    chochLabelIndex = int(math.round((internalHighIndex + bar_index) / 2.0))
    label.new(chochLabelIndex, internalHighLevel, "CHoCH", xloc = xloc.bar_index, style = label.style_label_down, color = color(na), textcolor = bullColorInput, size = size.small)

if bearishChoch and showChochInput
    line.new(internalLowIndex, internalLowLevel, bar_index, internalLowLevel, xloc = xloc.bar_index, extend = extend.none, color = bearColorInput, style = line.style_dashed, width = 1)
    chochLabelIndex = int(math.round((internalLowIndex + bar_index) / 2.0))
    label.new(chochLabelIndex, internalLowLevel, "CHoCH", xloc = xloc.bar_index, style = label.style_label_up, color = color(na), textcolor = bearColorInput, size = size.small)

// --- Visible BOS events ---
if bullishBos
    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)
        line.set_extend(protectedLine, extend.none)
    activeDirection := BULLISH
    protectedLevel := internalLowLevel
    protectedIndex := internalLowIndex
    if showBosInput
        line.new(internalHighIndex, internalHighLevel, bar_index, internalHighLevel, xloc = xloc.bar_index, extend = extend.none, color = bullColorInput, style = line.style_dashed, width = 1)
        bosLabelIndex = int(math.round((internalHighIndex + bar_index) / 2.0))
        label.new(bosLabelIndex, internalHighLevel, "BOS", xloc = xloc.bar_index, style = label.style_label_down, color = color(na), textcolor = bullColorInput, size = size.small)
    if showProtectedLevelInput
        protectedLine := line.new(protectedIndex, protectedLevel, bar_index, protectedLevel, xloc = xloc.bar_index, extend = extend.right, color = levelColorInput, style = line.style_dashed, width = 1)

if bearishBos
    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)
        line.set_extend(protectedLine, extend.none)
    activeDirection := BEARISH
    protectedLevel := internalHighLevel
    protectedIndex := internalHighIndex
    if showBosInput
        line.new(internalLowIndex, internalLowLevel, bar_index, internalLowLevel, xloc = xloc.bar_index, extend = extend.none, color = bearColorInput, style = line.style_dashed, width = 1)
        bosLabelIndex = int(math.round((internalLowIndex + bar_index) / 2.0))
        label.new(bosLabelIndex, internalLowLevel, "BOS", xloc = xloc.bar_index, style = label.style_label_up, color = color(na), textcolor = bearColorInput, size = size.small)
    if showProtectedLevelInput
        protectedLine := line.new(protectedIndex, protectedLevel, bar_index, protectedLevel, xloc = xloc.bar_index, extend = extend.right, color = levelColorInput, style = line.style_dashed, width = 1)

// --- Alerts ---
alertcondition(bullishBos, "Bullish BOS", "Bullish internal BOS formed after a hidden CHOCH.")
alertcondition(bearishBos, "Bearish BOS", "Bearish internal BOS formed after a hidden CHOCH.")
alertcondition(protectedLowSweep, "Higher Low MSS Sweep", "The protected higher low was swept and reclaimed bullishly.")
alertcondition(protectedHighSweep, "Lower High MSS Sweep", "The protected lower high was swept and reclaimed bearishly.")

if protectedLowSweep
    alert("MSS Sweeps: Bullish higher-low sweep on " + syminfo.ticker + " (" + timeframe.period + ")", alert.freq_once_per_bar_close)

if protectedHighSweep
    alert("MSS Sweeps: Bearish lower-high sweep on " + syminfo.ticker + " (" + timeframe.period + ")", alert.freq_once_per_bar_close)
