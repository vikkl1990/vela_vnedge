// ---- Header ----
    table.cell(drcid_tab, 1, 0, "Trend", bgcolor = color.black, text_color = color.white,text_size=font_size)
    table.cell(drcid_tab, 2, 0, "Cloud Zone", bgcolor = color.black, text_color = color.white,text_size=font_size)
    table.cell(drcid_tab, 3, 0, "Main Signal", bgcolor = color.black, text_color = color.white,text_size=font_size)
    table.cell(drcid_tab, 4, 0, "Additional", bgcolor = color.black, text_color = color.white,text_size=font_size)
    table.cell(drcid_tab, 5, 0, "Partial Exit", bgcolor = color.black, text_color = color.white,text_size=font_size)
    table.cell(drcid_tab, 6, 0, "Close Trade", bgcolor = color.black, text_color = color.white,text_size=font_size)

    table.cell(drcid_tab, 7, 0, "Strength", bgcolor=color.black, text_color=color.white, text_size=font_size)
    table.cell(drcid_tab, 8, 0, "TF1-Trend", bgcolor=color.black, text_color=color.white, text_size=font_size)
    table.cell(drcid_tab, 9, 0, "TF2-Trend", bgcolor=color.black, text_color=color.white, text_size=font_size)
    table.cell(drcid_tab, 10, 0, "TF3-Trend", bgcolor=color.black, text_color=color.white, text_size=font_size)

// ---- Text Logic ----
trend_txt = trend == 4 ? "🟢 Strong Bullish" : trend == -4 ? "🔴 Strong Bearish" : "⚪ Neutral"
main_txt  = uptrend ? "Buy" : downtrend ? "Sell" : "—"
add_txt   = bouncbackup ? "Add Buy" : bouncbackdn ? "Add Sell" : "—"
part_txt  = partclose ? "Partial Exit" : "—"
close_txt = closetrade ? "Close" : "—"
cloud_txt = inthecloud ? "Inside Cloud" : mtrend == 1 ? "Above Cloud" : "Below Cloud"

// ---- Color Logic ----
trend_col = trend == 4 ? color.green : trend == -4 ? color.red : color.gray
main_col  = uptrend ? color.green : downtrend ? color.red : color.new(color.gray, 70)
add_col   = bouncbackup ? color.green : bouncbackdn ? color.red : color.new(color.gray, 80)
part_col  = partclose ? color.orange : color.new(color.gray, 80)
close_col = closetrade ? color.red : color.new(color.gray, 80)
cloud_col = inthecloud ? color.blue : mtrend == 1 ? color.new(color.green, 40) : color.new(color.red, 40)

// ---- Fill Table ----
table.cell(drcid_tab, 1, 1, trend_txt, bgcolor = trend_col, text_color = color.white,text_size=font_size)
table.cell(drcid_tab, 2, 1, cloud_txt, bgcolor = cloud_col, text_color = color.white,text_size=font_size)
table.cell(drcid_tab, 3, 1, main_txt,  bgcolor = main_col,  text_color = color.white,text_size=font_size)
table.cell(drcid_tab, 4, 1, add_txt,   bgcolor = add_col,   text_color = color.white,text_size=font_size)
table.cell(drcid_tab, 5, 1, part_txt,  bgcolor = part_col,  text_color = color.white,text_size=font_size)
table.cell(drcid_tab, 6, 1, close_txt, bgcolor = close_col, text_color = color.white,text_size=font_size)

table.cell(drcid_tab, 7, 1, strength_txt, bgcolor=color.new(color.purple,70), text_color=color.white, text_size=font_size)
table.cell(drcid_tab, 8, 1, tf1_txt, bgcolor = trend_tf1 > 0 ? color.green : trend_tf1 < 0 ? color.red : color.gray, text_color=color.white, text_size=font_size)
table.cell(drcid_tab, 9, 1, tf2_txt, bgcolor = trend_tf2 > 0 ? color.green : trend_tf2 < 0 ? color.red : color.gray, text_color=color.white, text_size=font_size)
table.cell(drcid_tab, 10, 1, tf3_txt, bgcolor = trend_tf3 > 0 ? color.green : trend_tf3 < 0 ? color.red : color.gray, text_color=color.white, text_size=font_size)


