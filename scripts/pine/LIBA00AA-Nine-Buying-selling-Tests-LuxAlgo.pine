//@version=6
indicator("Nine Buying/selling Tests"
  , shorttitle    = "Nine Buying/selling Tests"
  , overlay       = true
  , format        = format.price
  , max_bars_back = 1000)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

color BULL_COLOR   = #089981
color BEAR_COLOR   = #f23645
color TRANSP_COLOR = #00000000

int MAX_PIVOTS      = 120
int DIM_TEXT_TRANSP = 40
int FRAME_TRANSP    = 85
int TABLE_BG_TRANSP = 20
int HEADER_TRANSP   = 85
int LINE_TRANSP     = 50

string MODE_AUTO = "Auto"
string MODE_BUY  = "Buying Tests"
string MODE_SELL = "Selling Tests"

string GROUP_RANGE = "Range Detection"
string GROUP_TESTS = "Tests"
string GROUP_DASH  = "Dashboard"
string GROUP_STYLE = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

modeInput = input.string(MODE_AUTO, "Test Set"
  , options = [MODE_AUTO, MODE_BUY, MODE_SELL]
  , group   = GROUP_RANGE
  , tooltip = "Which checklist to audit. 'Auto' runs the nine buying tests when the scan window fell from its high into its low (candidate accumulation) and the nine selling tests when it rose from its low into its high (candidate distribution). The other options force one side regardless of the preceding trend.")

scanLenInput = input.int(250, "Scan Lookback (Bars)"
  , minval  = 50
  , maxval  = 500
  , group   = GROUP_RANGE
  , tooltip = "Bars scanned for the audit. The window should span both the prior trend and the base or top under review: the range is anchored at the window's extreme low (buying tests) or extreme high (selling tests), and the trend into that anchor is measured across the same window.")

pivotLenInput = input.int(5, "Swing Length"
  , minval  = 2
  , maxval  = 20
  , group   = GROUP_RANGE
  , tooltip = "Swing strength of the pivots used for the stride line, the stepping-structure tests and the secondary test. A pivot must be the extreme of this many bars on each side, so swings confirm this many bars after they print.")

atrLenInput = input.int(14, "ATR Length"
  , minval  = 1
  , group   = GROUP_RANGE
  , tooltip = "Average True Range length used to normalize trend depth, climactic spread, secondary-test proximity and the distance to the stride line.")

trendDepthInput = input.float(3.0, "Minimum Prior Trend (xATR)"
  , minval  = 0.5
  , step    = 0.5
  , group   = GROUP_RANGE
  , tooltip = "Travel between the scan window's high and low, in ATR multiples at the anchor, required before the move into the range counts as a trend that has run its course. Without a meaningful prior trend there is no fulfilled objective to audit.")

holdBarsInput = input.int(10, "Extreme Hold (Bars)"
  , minval  = 1
  , group   = GROUP_RANGE
  , tooltip = "Bars the range extreme must remain unbroken before the prior trend's objective is treated as fulfilled - a fresh low (or high) means the trend may still be extending.")

volLenInput = input.int(20, "Volume Average Length"
  , minval  = 1
  , group   = GROUP_TESTS
  , tooltip = "Simple moving average length of volume used as the baseline the climactic bar is compared against.")

climaxMultInput = input.float(2.0, "Climax Volume Multiple"
  , minval  = 1
  , step    = 0.25
  , group   = GROUP_TESTS
  , tooltip = "Volume multiple of its average, together with a spread of at least one ATR, required at the bar that set the range extreme for it to count as climactic behavior (selling climax under the buying tests, buying climax under the selling tests).")

testVolRatioInput = input.float(0.75, "Secondary Test Volume Ratio"
  , minval  = 0.05
  , maxval  = 2
  , step    = 0.05
  , group   = GROUP_TESTS
  , tooltip = "Maximum volume of the secondary test swing, as a fraction of the climax bar's volume. Wyckoff-style successful tests return to the climax area on clearly lighter activity.")

testProxInput = input.float(1.5, "Secondary Test Proximity (xATR)"
  , minval  = 0.25
  , step    = 0.25
  , group   = GROUP_TESTS
  , tooltip = "How close to the range extreme, in ATR multiples, a later swing must come for it to qualify as a secondary test of the climax.")

activityRatioInput = input.float(1.1, "Activity Ratio"
  , minval  = 1
  , step    = 0.05
  , group   = GROUP_TESTS
  , tooltip = "Required ratio between average up-close volume and average down-close volume inside the range (inverted for the selling tests). Above 1 demands that rallies draw more volume than reactions - the bullish-activity signature.")

benchmarkInput = input.symbol("SP:SPX", "Benchmark"
  , group   = GROUP_TESTS
  , tooltip = "Market benchmark used by the stronger/weaker-than-market test. Pick the index the symbol is naturally judged against - an equity index for stocks, total-market or dominance measures for crypto, and so on.")

rsLenInput = input.int(50, "Relative Strength Length"
  , minval  = 2
  , maxval  = 500
  , group   = GROUP_TESTS
  , tooltip = "Bars over which the symbol's return is compared with the benchmark's return for the relative-strength test.")

causeBarsInput = input.int(40, "Minimum Cause (Bars)"
  , minval  = 5
  , group   = GROUP_TESTS
  , tooltip = "Minimum age of the range, in bars, before the base (or crown) counts as a cause of sufficient size. Duration is used as the cause proxy here; point & figure counting is the traditional measure and is its own tool.")

objMultInput = input.float(1.0, "Objective (x Range Height)"
  , minval  = 0.25
  , step    = 0.25
  , group   = GROUP_TESTS
  , tooltip = "Projected objective used by the reward-to-risk test, expressed in range heights beyond the range boundary: 1 projects a full measured move of the base above its top (below its bottom for the selling tests).")

rrMinInput = input.float(3.0, "Minimum Reward/Risk"
  , minval  = 0.5
  , step    = 0.5
  , group   = GROUP_TESTS
  , tooltip = "Required ratio between the distance from the current close to the projected objective and the distance from the close to the opposite range extreme (the stop). Wyckoff-tradition teaching asks for roughly three times the risk.")

scoreAlertInput = input.int(7, "Score Alert Threshold"
  , minval  = 1
  , maxval  = 9
  , group   = GROUP_TESTS
  , tooltip = "Number of passed tests at which the threshold alert fires. The full-checklist alert at 9/9 is always available separately.")

showTableInput = input.bool(true, "Show Checklist"
  , group   = GROUP_DASH
  , tooltip = "Shows the nine-test checklist with each test's current reading and pass/fail state, plus the running score.")

tablePositionInput = input.string("Top Right", "Position"
  , options = ["Top Right", "Top Left", "Middle Right", "Middle Left", "Bottom Right", "Bottom Left"]
  , group   = GROUP_DASH
  , tooltip = "Chart corner or side the checklist is anchored to.")

tableSizeInput = input.string("Small", "Size"
  , options = ["Tiny", "Small", "Normal"]
  , group   = GROUP_DASH
  , tooltip = "Checklist text size.")

showRangeInput = input.bool(true, "Range Box"
  , group   = GROUP_STYLE
  , tooltip = "Draws the audited trading range from its anchor extreme to the current bar.")

showStrideInput = input.bool(true, "Stride Line"
  , group   = GROUP_STYLE
  , tooltip = "Draws the stride line - the trendline joining the last two swings of the move into the range - whose break is test 4. Shown in the side color once broken, dimmed while intact.")

showObjectiveInput = input.bool(true, "Objective Level"
  , group   = GROUP_STYLE
  , tooltip = "Draws the projected objective used by the reward-to-risk test.")

showMarkersInput = input.bool(false, "Climax / Test Markers"
  , group   = GROUP_STYLE
  , tooltip = "Marks the climactic bar at the range extreme (SC/BC) and the detected secondary test (ST) supporting test 2.")

fillTransparencyInput = input.int(94, "Range Fill Transparency"
  , minval  = 50
  , maxval  = 100
  , group   = GROUP_STYLE)

bullColorInput = input.color(BULL_COLOR, "Buying", inline = "colors", group = GROUP_STYLE)

bearColorInput = input.color(BEAR_COLOR, "Selling", inline = "colors", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

//Most recent two pivots strictly inside the range (after the anchor bar); [newest, previous, found]
findLastTwoAfter(barsArray, valuesArray, anchorBar) =>
    float newestValue   = na
    float previousValue = na
    int   foundCount    = 0
    int   arraySize     = array.size(barsArray)
    if arraySize > 0
        for j = 0 to arraySize - 1
            int i = arraySize - 1 - j
            if array.get(barsArray, i) <= anchorBar
                break
            float pivotValue = array.get(valuesArray, i)
            if foundCount == 0
                newestValue := pivotValue
            else
                previousValue := pivotValue
            foundCount += 1
            if foundCount >= 2
                break
    [newestValue, previousValue, foundCount >= 2]

//Stride anchors: the last pivot at or before the range anchor plus the nearest older pivot beyond it in
//the trend direction (higher for a downward stride, lower for an upward one); [olderBar, olderValue, newerBar, newerValue, found]
findStridePair(barsArray, valuesArray, anchorBar, descendingStride) =>
    int   newerBar   = na
    float newerValue = na
    int   olderBar   = na
    float olderValue = na
    int   arraySize  = array.size(barsArray)
    if arraySize > 0
        for j = 0 to arraySize - 1
            int i = arraySize - 1 - j
            int pivotBar = array.get(barsArray, i)
            if pivotBar > anchorBar
                continue
            float pivotValue = array.get(valuesArray, i)
            if na(newerValue)
                newerBar   := pivotBar
                newerValue := pivotValue
            else if descendingStride ? pivotValue > newerValue : pivotValue < newerValue
                olderBar   := pivotBar
                olderValue := pivotValue
                break
    [olderBar, olderValue, newerBar, newerValue, not na(olderValue)]

//Most recent pivot after the anchor that retested the climax extreme within the proximity band on volume
//at most the allowed fraction of climax volume; [testBar, testValue, found]
findSecondaryTest(barsArray, valuesArray, volumesArray, anchorBar, extremeValue, proximityWidth, maxVolume, testFromAbove) =>
    int   testBar   = na
    float testValue = na
    int   arraySize = array.size(barsArray)
    if arraySize > 0
        for j = 0 to arraySize - 1
            int i = arraySize - 1 - j
            int pivotBar = array.get(barsArray, i)
            if pivotBar <= anchorBar
                break
            float pivotValue  = array.get(valuesArray, i)
            float pivotVolume = array.get(volumesArray, i)
            float distance    = testFromAbove ? pivotValue - extremeValue : extremeValue - pivotValue
            if distance >= 0 and distance <= proximityWidth and pivotVolume <= maxVolume
                testBar   := pivotBar
                testValue := pivotValue
                break
    [testBar, testValue, not na(testValue)]

//"-" placeholder when a reading is not available yet
formatValue(value, formatString, suffix) =>
    na(value) ? "-" : str.tostring(value, formatString) + suffix

//---------------------------------------------------------------------------------------------------------------------}
// Range Anchor & Market Data
//---------------------------------------------------------------------------------------------------------------------{

float atrValue  = ta.atr(atrLenInput)
float volumeSma = ta.sma(nz(volume), volLenInput)
float barSpread = high - low

int   lowestBarsBack  = ta.lowestbars(low, scanLenInput)
int   highestBarsBack = ta.highestbars(high, scanLenInput)
float scanLowValue    = ta.lowest(low, scanLenInput)
float scanHighValue   = ta.highest(high, scanLenInput)

int lowOffset  = nz(-lowestBarsBack, 0)
int highOffset = nz(-highestBarsBack, 0)

//Range boundaries measured from the anchor extreme: the far boundary is the extreme reached since it
float baseHighValue = ta.highest(high, math.max(lowOffset + 1, 1))
float baseLowValue  = ta.lowest(low, math.max(highOffset + 1, 1))

//Benchmark series for the stronger/weaker-than-market test
float benchmarkClose = request.security(benchmarkInput, timeframe.period, close, ignore_invalid_symbol = true)

//Buying tests audit a base built after a decline (window high older than window low); selling tests the mirror
bool isBuySide = switch modeInput
    MODE_BUY  => true
    MODE_SELL => false
    => highOffset > lowOffset

int   anchorOffset     = isBuySide ? lowOffset : highOffset
int   anchorBar        = bar_index - anchorOffset
float anchorAtr        = atrValue[anchorOffset]
float anchorVolume     = nz(volume[anchorOffset])
float anchorVolumeSma  = volumeSma[anchorOffset]
float anchorSpread     = barSpread[anchorOffset]
float anchorExtreme    = isBuySide ? scanLowValue : scanHighValue
float rangeTopValue    = isBuySide ? baseHighValue : scanHighValue
float rangeBottomValue = isBuySide ? scanLowValue : baseLowValue
float rangeHeight      = rangeTopValue - rangeBottomValue

bool dataReady = not na(lowestBarsBack) and not na(highestBarsBack) and not na(anchorAtr) and anchorAtr > 0 and not na(anchorVolumeSma)

//Confirmed swings with the volume they printed on, for the stride line, stepping structure and secondary test
var array<int>   pivotHighBarsArray    = array.new<int>()
var array<float> pivotHighValuesArray  = array.new<float>()
var array<float> pivotHighVolumesArray = array.new<float>()
var array<int>   pivotLowBarsArray     = array.new<int>()
var array<float> pivotLowValuesArray   = array.new<float>()
var array<float> pivotLowVolumesArray  = array.new<float>()

float pivotHighPrice = ta.pivothigh(high, pivotLenInput, pivotLenInput)
float pivotLowPrice  = ta.pivotlow(low, pivotLenInput, pivotLenInput)

if not na(pivotHighPrice)
    array.push(pivotHighBarsArray, bar_index - pivotLenInput)
    array.push(pivotHighValuesArray, pivotHighPrice)
    array.push(pivotHighVolumesArray, nz(volume[pivotLenInput]))
    if array.size(pivotHighBarsArray) > MAX_PIVOTS
        array.shift(pivotHighBarsArray)
        array.shift(pivotHighValuesArray)
        array.shift(pivotHighVolumesArray)

if not na(pivotLowPrice)
    array.push(pivotLowBarsArray, bar_index - pivotLenInput)
    array.push(pivotLowValuesArray, pivotLowPrice)
    array.push(pivotLowVolumesArray, nz(volume[pivotLenInput]))
    if array.size(pivotLowBarsArray) > MAX_PIVOTS
        array.shift(pivotLowBarsArray)
        array.shift(pivotLowValuesArray)
        array.shift(pivotLowVolumesArray)

//Running up-close / down-close volume tallies, differenced at the anchor for the activity test
var float cumUpVolume   = 0.0
var float cumDownVolume = 0.0
var int   cumUpCount    = 0
var int   cumDownCount  = 0

if close > close[1]
    cumUpVolume += nz(volume)
    cumUpCount  += 1
else if close < close[1]
    cumDownVolume += nz(volume)
    cumDownCount  += 1

//---------------------------------------------------------------------------------------------------------------------}
// Nine Tests
//---------------------------------------------------------------------------------------------------------------------{

//Test 1 - prior trend objective fulfilled: the move into the range was deep enough to count as a trend
//and its extreme has stopped extending, so the prior objective is treated as accomplished
float trendDepthAtr = dataReady ? (scanHighValue - scanLowValue) / anchorAtr : na
bool  trendOrderOk  = isBuySide ? highOffset > lowOffset : lowOffset > highOffset
bool  test1Passed   = dataReady and trendOrderOk and not na(trendDepthAtr) and trendDepthAtr >= trendDepthInput and anchorOffset >= holdBarsInput

//Test 2 - climactic behavior and successful secondary test: the range extreme printed on climactic
//volume and spread, and a later swing retested it nearby on clearly lighter volume
float climaxVolumeRatio = dataReady and anchorVolumeSma > 0 ? anchorVolume / anchorVolumeSma : na
bool  climaxFound       = dataReady and not na(climaxVolumeRatio) and climaxVolumeRatio >= climaxMultInput and anchorSpread >= anchorAtr

[secondaryTestBar, secondaryTestValue, secondaryTestFound] = findSecondaryTest(isBuySide ? pivotLowBarsArray : pivotHighBarsArray, isBuySide ? pivotLowValuesArray : pivotHighValuesArray, isBuySide ? pivotLowVolumesArray : pivotHighVolumesArray, anchorBar, anchorExtreme, testProxInput * atrValue, testVolRatioInput * anchorVolume, isBuySide)

bool test2Passed = climaxFound and secondaryTestFound

//Test 3 - activity bullish (bearish): volume expanding on rallies and shrinking on reactions across the
//whole range, read as the ratio of average up-close volume to average down-close volume
float windowUpVolume    = cumUpVolume - cumUpVolume[anchorOffset]
float windowDownVolume  = cumDownVolume - cumDownVolume[anchorOffset]
int   windowUpCount     = cumUpCount - cumUpCount[anchorOffset]
int   windowDownCount   = cumDownCount - cumDownCount[anchorOffset]
float rallyAvgVolume    = windowUpCount > 0 ? windowUpVolume / windowUpCount : na
float reactionAvgVolume = windowDownCount > 0 ? windowDownVolume / windowDownCount : na
float activityValue     = not na(rallyAvgVolume) and not na(reactionAvgVolume) and rallyAvgVolume > 0 and reactionAvgVolume > 0 ? (isBuySide ? rallyAvgVolume / reactionAvgVolume : reactionAvgVolume / rallyAvgVolume) : na
bool  test3Passed       = dataReady and not na(activityValue) and activityValue >= activityRatioInput

//Test 4 - stride broken: close beyond the trendline joining the last two swings of the move into the
//range (supply line under the buying tests, demand line under the selling tests)
[strideOlderBar, strideOlderValue, strideNewerBar, strideNewerValue, strideFound] = findStridePair(isBuySide ? pivotHighBarsArray : pivotLowBarsArray, isBuySide ? pivotHighValuesArray : pivotLowValuesArray, anchorBar, isBuySide)

float strideSlope       = strideFound ? (strideNewerValue - strideOlderValue) / (strideNewerBar - strideOlderBar) : na
float strideProjection  = strideFound ? strideNewerValue + strideSlope * (bar_index - strideNewerBar) : na
bool  test4Passed       = dataReady and strideFound and (isBuySide ? close > strideProjection : close < strideProjection)
float strideDistanceAtr = strideFound and not na(atrValue) and atrValue > 0 ? (isBuySide ? close - strideProjection : strideProjection - close) / atrValue : na

//Tests 5 & 6 - stepping structure: the two most recent confirmed swings inside the range make higher
//lows and higher highs (lower highs and lower lows for the selling tests)
[lowNewest, lowPrevious, lowPairFound]    = findLastTwoAfter(pivotLowBarsArray, pivotLowValuesArray, anchorBar)
[highNewest, highPrevious, highPairFound] = findLastTwoAfter(pivotHighBarsArray, pivotHighValuesArray, anchorBar)

float lowsStepPercent  = lowPairFound and lowPrevious != 0 ? 100 * (lowNewest / lowPrevious - 1) : na
float highsStepPercent = highPairFound and highPrevious != 0 ? 100 * (highNewest / highPrevious - 1) : na
bool  test5Passed      = dataReady and (isBuySide ? lowPairFound and lowNewest > lowPrevious : highPairFound and highNewest < highPrevious)
bool  test6Passed      = dataReady and (isBuySide ? highPairFound and highNewest > highPrevious : lowPairFound and lowNewest < lowPrevious)

//Test 7 - stronger (weaker) than the market: the symbol's return over the relative-strength window
//against the benchmark's return over the same window
float symbolReturn     = close[rsLenInput] > 0 ? 100 * (close / close[rsLenInput] - 1) : na
float benchmarkReturn  = benchmarkClose[rsLenInput] > 0 ? 100 * (benchmarkClose / benchmarkClose[rsLenInput] - 1) : na
float relativeStrength = symbolReturn - benchmarkReturn
bool  test7Passed      = dataReady and not na(relativeStrength) and (isBuySide ? relativeStrength > 0 : relativeStrength < 0)

//Test 8 - cause of sufficient size: the range has lasted long enough to fund a move worth trading,
//with duration standing in for the traditional point & figure count
bool test8Passed = dataReady and anchorOffset >= causeBarsInput

//Test 9 - reward outweighs risk: projected objective (range heights beyond the boundary) against the
//stop at the opposite range extreme, from the current close
float objectiveValue  = isBuySide ? rangeTopValue + objMultInput * rangeHeight : rangeBottomValue - objMultInput * rangeHeight
float rewardValue     = isBuySide ? objectiveValue - close : close - objectiveValue
float riskValue       = isBuySide ? close - rangeBottomValue : rangeTopValue - close
float rewardRiskValue = not na(riskValue) and riskValue > 0 ? rewardValue / riskValue : na
bool  test9Passed     = dataReady and rangeHeight > 0 and not na(rewardRiskValue) and rewardValue > 0 and rewardRiskValue >= rrMinInput

int testScore = (test1Passed ? 1 : 0) + (test2Passed ? 1 : 0) + (test3Passed ? 1 : 0) + (test4Passed ? 1 : 0) + (test5Passed ? 1 : 0) + (test6Passed ? 1 : 0) + (test7Passed ? 1 : 0) + (test8Passed ? 1 : 0) + (test9Passed ? 1 : 0)

color sideColor = isBuySide ? bullColorInput : bearColorInput

plot(testScore, "Tests Passed", color = sideColor, display = display.data_window)
plot(rewardRiskValue, "Reward/Risk", color = sideColor, display = display.data_window)
plot(relativeStrength, "Relative Strength %", color = sideColor, display = display.data_window)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{

string tablePosition = switch tablePositionInput
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Middle Right" => position.middle_right
    "Middle Left"  => position.middle_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

string tableTextSize = switch tableSizeInput
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

if showTableInput and barstate.islast
    var table checklistTable = table.new(tablePosition, 4, 10, bgcolor = color.new(chart.bg_color, TABLE_BG_TRANSP), frame_color = color.new(chart.fg_color, FRAME_TRANSP), frame_width = 1)
    var bool headerMerged = false
    if not headerMerged
        table.merge_cells(checklistTable, 0, 0, 2, 0)
        headerMerged := true

    color dimColor   = color.new(chart.fg_color, DIM_TEXT_TRANSP)
    color headerBg   = color.new(sideColor, HEADER_TRANSP)
    color scoreColor = color.from_gradient(testScore, 0, 9, dimColor, sideColor)

    array<string> nameArray = array.from(
       isBuySide ? "Downside objective fulfilled" : "Upside objective fulfilled",
       "Climax & secondary test",
       isBuySide ? "Activity bullish" : "Activity bearish",
       isBuySide ? "Downward stride broken" : "Upward stride broken",
       isBuySide ? "Higher lows" : "Lower highs",
       isBuySide ? "Higher highs" : "Lower lows",
       isBuySide ? "Stronger than market" : "Weaker than market",
       isBuySide ? "Base of sufficient size" : "Crown of sufficient size",
       "Reward outweighs risk")

    string climaxText = na(climaxVolumeRatio) ? "-" : str.tostring(climaxVolumeRatio, "#.#") + "x" + (climaxFound ? (secondaryTestFound ? "" : ", no test") : ", no climax")

    array<string> valueArray = array.from(
       formatValue(trendDepthAtr, "#.#", " ATR"),
       climaxText,
       formatValue(activityValue, "#.##", "x"),
       formatValue(strideDistanceAtr, "#.#", " ATR"),
       formatValue(isBuySide ? lowsStepPercent : highsStepPercent, "#.##", "%"),
       formatValue(isBuySide ? highsStepPercent : lowsStepPercent, "#.##", "%"),
       formatValue(relativeStrength, "#.##", "%"),
       dataReady ? str.tostring(anchorOffset) + " bars" : "-",
       formatValue(rewardRiskValue, "#.#", "x"))

    array<string> tooltipArray = array.from(
       "The move into the range must have run its course: at least " + str.tostring(trendDepthInput, "#.#") + " ATR of travel across the scan window, with the range extreme unbroken for " + str.tostring(holdBarsInput) + "+ bars.",
       "The range extreme must print on climactic activity (volume at least " + str.tostring(climaxMultInput, "#.##") + "x its average with a spread of at least 1 ATR), later retested by a swing within " + str.tostring(testProxInput, "#.##") + " ATR of the extreme on at most " + str.tostring(math.round(testVolRatioInput * 100)) + "% of the climax volume.",
       isBuySide ? "Average volume on up closes inside the range must exceed average volume on down closes by the activity ratio - rallies drawing volume, reactions starving." : "Average volume on down closes inside the range must exceed average volume on up closes by the activity ratio - reactions drawing volume, rallies starving.",
       isBuySide ? "The close must be above the supply line joining the last two descending swing highs of the decline into the range." : "The close must be below the demand line joining the last two ascending swing lows of the advance into the range.",
       isBuySide ? "The two most recent swing lows inside the range must step upward." : "The two most recent swing highs inside the range must step downward.",
       isBuySide ? "The two most recent swing highs inside the range must step upward." : "The two most recent swing lows inside the range must step downward.",
       (isBuySide ? "The symbol's return must beat " : "The symbol's return must lag ") + benchmarkInput + " over the last " + str.tostring(rsLenInput) + " bars.",
       "The range must be at least " + str.tostring(causeBarsInput) + " bars old. Duration stands in for the cause here - point & figure counting is the traditional measure.",
       "The projected objective (" + str.tostring(objMultInput, "#.##") + "x the range height beyond the boundary) must offer at least " + str.tostring(rrMinInput, "#.#") + "x the risk to the opposite range extreme.")

    array<bool> passArray = array.from(test1Passed, test2Passed, test3Passed, test4Passed, test5Passed, test6Passed, test7Passed, test8Passed, test9Passed)

    table.cell(checklistTable, 0, 0, isBuySide ? "Nine Buying Tests" : "Nine Selling Tests", text_color = sideColor, text_size = tableTextSize, text_halign = text.align_left, bgcolor = headerBg)
    table.cell(checklistTable, 3, 0, str.tostring(testScore) + "/9", text_color = scoreColor, text_size = tableTextSize, text_halign = text.align_right, bgcolor = headerBg)

    for i = 0 to 8
        bool rowPassed = array.get(passArray, i)
        table.cell(checklistTable, 0, i + 1, str.tostring(i + 1), text_color = dimColor, text_size = tableTextSize, text_halign = text.align_center)
        table.cell(checklistTable, 1, i + 1, array.get(nameArray, i), text_color = chart.fg_color, text_size = tableTextSize, text_halign = text.align_left, tooltip = array.get(tooltipArray, i))
        table.cell(checklistTable, 2, i + 1, array.get(valueArray, i), text_color = dimColor, text_size = tableTextSize, text_halign = text.align_right)
        table.cell(checklistTable, 3, i + 1, rowPassed ? "✓" : "✗", text_color = rowPassed ? sideColor : dimColor, text_size = tableTextSize, text_halign = text.align_center)

//---------------------------------------------------------------------------------------------------------------------}
// Chart Visuals
//---------------------------------------------------------------------------------------------------------------------{

var box   rangeBox           = na
var line  strideLine         = na
var line  objectiveLine      = na
var label objectiveLabel     = na
var label climaxLabel        = na
var label secondaryTestLabel = na

if barstate.islast
    //Audited trading range from its anchor extreme to the current bar
    if showRangeInput and dataReady
        if na(rangeBox)
            rangeBox := box.new(anchorBar, rangeTopValue, bar_index, rangeBottomValue, border_color = color.new(sideColor, LINE_TRANSP), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(sideColor, fillTransparencyInput))
        else
            box.set_lefttop(rangeBox, anchorBar, rangeTopValue)
            box.set_rightbottom(rangeBox, bar_index, rangeBottomValue)
            box.set_border_color(rangeBox, color.new(sideColor, LINE_TRANSP))
            box.set_bgcolor(rangeBox, color.new(sideColor, fillTransparencyInput))
    else if not na(rangeBox)
        box.delete(rangeBox)
        rangeBox := na

    //Stride line of the move into the range, projected to the current bar - test 4's trendline
    if showStrideInput and dataReady and strideFound
        color strideColor = test4Passed ? sideColor : color.new(chart.fg_color, LINE_TRANSP)
        if na(strideLine)
            strideLine := line.new(strideOlderBar, strideOlderValue, bar_index, strideProjection, style = line.style_dashed, color = strideColor, width = 1)
        else
            line.set_xy1(strideLine, strideOlderBar, strideOlderValue)
            line.set_xy2(strideLine, bar_index, strideProjection)
            line.set_color(strideLine, strideColor)
    else if not na(strideLine)
        line.delete(strideLine)
        strideLine := na

    //Projected objective feeding the reward-to-risk test
    if showObjectiveInput and dataReady and rangeHeight > 0
        if na(objectiveLine)
            objectiveLine  := line.new(anchorBar, objectiveValue, bar_index, objectiveValue, style = line.style_dotted, color = sideColor, width = 1)
            objectiveLabel := label.new(bar_index, objectiveValue, "", style = label.style_label_left, color = TRANSP_COLOR, textcolor = sideColor, size = size.small)
        else
            line.set_xy1(objectiveLine, anchorBar, objectiveValue)
            line.set_xy2(objectiveLine, bar_index, objectiveValue)
            line.set_color(objectiveLine, sideColor)
            label.set_xy(objectiveLabel, bar_index, objectiveValue)
            label.set_textcolor(objectiveLabel, sideColor)
        label.set_text(objectiveLabel, "Objective " + str.tostring(objectiveValue, format.mintick))
    else
        if not na(objectiveLine)
            line.delete(objectiveLine)
            objectiveLine := na
        if not na(objectiveLabel)
            label.delete(objectiveLabel)
            objectiveLabel := na

    //Evidence markers behind test 2: the climactic extreme and its secondary test
    if showMarkersInput and climaxFound
        if na(climaxLabel)
            climaxLabel := label.new(anchorBar, anchorExtreme, isBuySide ? "SC" : "BC", style = isBuySide ? label.style_label_up : label.style_label_down, color = TRANSP_COLOR, textcolor = sideColor, size = size.tiny)
        else
            label.set_xy(climaxLabel, anchorBar, anchorExtreme)
            label.set_text(climaxLabel, isBuySide ? "SC" : "BC")
            label.set_style(climaxLabel, isBuySide ? label.style_label_up : label.style_label_down)
            label.set_textcolor(climaxLabel, sideColor)
    else if not na(climaxLabel)
        label.delete(climaxLabel)
        climaxLabel := na

    if showMarkersInput and secondaryTestFound
        if na(secondaryTestLabel)
            secondaryTestLabel := label.new(secondaryTestBar, secondaryTestValue, "ST", style = isBuySide ? label.style_label_up : label.style_label_down, color = TRANSP_COLOR, textcolor = sideColor, size = size.tiny)
        else
            label.set_xy(secondaryTestLabel, secondaryTestBar, secondaryTestValue)
            label.set_style(secondaryTestLabel, isBuySide ? label.style_label_up : label.style_label_down)
            label.set_textcolor(secondaryTestLabel, sideColor)
    else if not na(secondaryTestLabel)
        label.delete(secondaryTestLabel)
        secondaryTestLabel := na

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

bool buyAllPassed        = isBuySide and dataReady and testScore == 9
bool sellAllPassed       = not isBuySide and dataReady and testScore == 9
bool buyThresholdPassed  = isBuySide and dataReady and testScore >= scoreAlertInput
bool sellThresholdPassed = not isBuySide and dataReady and testScore >= scoreAlertInput
bool starterPassed       = dataReady and test4Passed and test5Passed

alertcondition(buyAllPassed and not buyAllPassed[1], "All Buying Tests Passed", "All nine buying tests passed on {{ticker}} ({{interval}}) - the accumulation base satisfies the full Wyckoff checklist for markup")

alertcondition(sellAllPassed and not sellAllPassed[1], "All Selling Tests Passed", "All nine selling tests passed on {{ticker}} ({{interval}}) - the distribution top satisfies the full Wyckoff checklist for markdown")

alertcondition(buyThresholdPassed and not buyThresholdPassed[1], "Buying Score Threshold Reached", "Buying tests score reached the alert threshold on {{ticker}} ({{interval}}) - review the remaining items on the checklist before committing size")

alertcondition(sellThresholdPassed and not sellThresholdPassed[1], "Selling Score Threshold Reached", "Selling tests score reached the alert threshold on {{ticker}} ({{interval}}) - review the remaining items on the checklist before committing size")

alertcondition(starterPassed and not starterPassed[1], "Stride Break With Stepping Structure", "Stride break and stepping-structure tests both pass on {{ticker}} ({{interval}}) - the combination some practitioners use to stage a starter position while the remaining tests develop")

//---------------------------------------------------------------------------------------------------------------------}
