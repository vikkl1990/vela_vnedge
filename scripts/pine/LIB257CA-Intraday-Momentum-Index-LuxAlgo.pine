//@version=6
indicator("Intraday Momentum Index"
  , shorttitle = "Intraday Momentum Index"
  , overlay    = false
  , format     = format.price
  , precision  = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MIDLINE = 50.

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 1, group = "Settings"
  , tooltip = "Lookback window used to sum bullish and bearish candle bodies. 14 is the common default borrowed from RSI convention; shorter lookbacks produce more signals and more noise. The open-to-close bodies are measured on whatever timeframe the chart uses, so the indicator works on daily or weekly charts as well as intraday ones.")

obInput = input.float(70, "Overbought", minval = 0, maxval = 100, step = 1, group = "Settings"
  , tooltip = "Level above which sessions have persistently closed above their opens. 70 is the common default; some traders widen it to 80 on volatile symbols. Band entries are conditions rather than triggers - many practitioners wait for the reading to curl back through the band before fading it.")

osInput = input.float(30, "Oversold", minval = 0, maxval = 100, step = 1, group = "Settings"
  , tooltip = "Level below which sessions have persistently closed below their opens. 30 is the common default; some traders widen it to 20 on volatile symbols. Band entries are conditions rather than triggers - many practitioners wait for the reading to curl back through the band before fading it.")

//Style
bullColorInput = input.color(#089981, "Bullish Color", group = "Style"
  , tooltip = "Color of the oscillator line and gradient fill when the IMI is above the 50 midline, marking buyer-controlled sessions.")

bearColorInput = input.color(#f23645, "Bearish Color", group = "Style"
  , tooltip = "Color of the oscillator line and gradient fill when the IMI is at or below the 50 midline, marking seller-controlled sessions.")

levelColorInput = input.color(#787b86, "Levels Color", group = "Style"
  , tooltip = "Color of the dashed overbought/oversold levels and the dotted 50 midline.")

fillInput = input.bool(true, "Gradient Fill", group = "Style"
  , tooltip = "Fill the area between the oscillator and the 50 midline with a vertical gradient, bullish above the midline and bearish below it.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Intrabar open-to-close movement (candle body) - gaps do not contribute
body = close - open

//RSI template on bodies: up-bar bodies play the role of gains, down-bar bodies the role of losses
upSum = math.sum(body > 0 ? body : 0., lengthInput)
dnSum = math.sum(body < 0 ? -body : 0., lengthInput)

totalSum = upSum + dnSum

//Up-body total as a percentage of all body movement over the window, 0-100 scale
//A reading of 50 means bullish and bearish bodies balanced (also used when no body movement occurred)
imi = na(totalSum) ? na : totalSum > 0 ? 100 * upSum / totalSum : MIDLINE

//Band and midline events
obEntry = ta.crossover(imi, obInput)
obExit  = ta.crossunder(imi, obInput)
osEntry = ta.crossunder(imi, osInput)
osExit  = ta.crossover(imi, osInput)

midCrossUp = ta.crossover(imi, MIDLINE)
midCrossDn = ta.crossunder(imi, MIDLINE)

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
imiColor = imi > MIDLINE ? bullColorInput : bearColorInput

imiPlotId = plot(imi, "IMI", imiColor)
midPlotId = plot(MIDLINE, "Midline Anchor", na, editable = false, display = display.none)

//Dashed overbought/oversold levels, dotted midline
hline(obInput, "Overbought", levelColorInput, hline.style_dashed)
hline(MIDLINE, "Midline", color.new(levelColorInput, 50), hline.style_dotted)
hline(osInput, "Oversold", levelColorInput, hline.style_dashed)

//Vertical gradient fill from the 50 midline to the oscillator value
fill(imiPlotId, midPlotId
  , top_value    = math.max(imi, MIDLINE)
  , bottom_value = math.min(imi, MIDLINE)
  , top_color    = fillInput ? (imi > MIDLINE ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)) : na
  , bottom_color = fillInput ? (imi > MIDLINE ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)) : na)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(obEntry, "Overbought Entry", "Intraday Momentum Index crossed above its overbought level")
alertcondition(obExit, "Overbought Exit", "Intraday Momentum Index crossed back below its overbought level")
alertcondition(osEntry, "Oversold Entry", "Intraday Momentum Index crossed below its oversold level")
alertcondition(osExit, "Oversold Exit", "Intraday Momentum Index crossed back above its oversold level")
alertcondition(midCrossUp, "Bullish Midline Cross", "Intraday Momentum Index crossed above its 50 midline")
alertcondition(midCrossDn, "Bearish Midline Cross", "Intraday Momentum Index crossed below its 50 midline")

//---------------------------------------------------------------------------------------------------------------------}
