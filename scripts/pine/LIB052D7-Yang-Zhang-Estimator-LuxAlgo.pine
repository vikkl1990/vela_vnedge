//@version=6
indicator("Yang-Zhang Estimator", "Yang-Zhang Estimator", overlay = false, format = format.percent, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
// Yang & Zhang (2000), Journal of Business — variance-minimizing weight k = 0.34 / (1.34 + (n + 1) / (n - 1))
K_NUMERATOR = 0.34
K_OFFSET    = 1.34
PCT_SCALE   = 100

HIGH_VOL_COLOR       = #f23645 // estimate at or above the threshold - elevated volatility
LOW_VOL_COLOR        = #089981 // estimate below the threshold - subdued volatility
COMPARISON_COLOR     = #787b86 // comparison window estimate - a reference line
OVERNIGHT_COLOR      = #ffd700 // component lines are told apart by hue, not by state
OPEN_CLOSE_COLOR     = #ff9800
ROGERS_SATCHELL_COLOR = #ab47bc
LEVEL_COLOR          = #787b86

CALC_GROUP  = "Calculation"
COMP_GROUP  = "Comparison"
LEVEL_GROUP = "Threshold"
STYLE_GROUP = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Window Length", minval = 2, group = CALC_GROUP
  , tooltip = "Number of bars (n) in the estimation window. The overnight, open-to-close, and Rogers-Satchell variance components are all computed over this window. Daily windows in the tens of bars are typical — shorter windows track regime shifts faster but jump around more, longer windows are steadier but slower to react.")

barsPerYearInput = input.int(252, "Bars per Year", minval = 1, group = CALC_GROUP
  , tooltip = "Number of bars in one year, used to annualize the per-bar variance before taking the square root. Use 252 for daily bars on markets with a trading calendar (equity convention) and 365 for daily bars on 24/7 markets such as crypto. On intraday charts, use bars per day multiplied by days per year (e.g. 24 x 365 = 8760 for hourly bars on a 24/7 market).")

showComparisonInput = input.bool(false, "Show Comparison Window", group = COMP_GROUP
  , tooltip = "Plot a second Yang-Zhang estimate computed over the comparison window. Comparing a shorter and a longer window is a common way to read volatility regime shifts rather than defending a single number.")

comparisonLengthInput = input.int(60, "Comparison Length", minval = 2, group = COMP_GROUP
  , tooltip = "Number of bars in the comparison (slower) window. The expansion/contraction alerts fire when the primary estimate crosses this series.")

showThresholdInput = input.bool(true, "Show Threshold", group = LEVEL_GROUP
  , tooltip = "Display a dashed horizontal reference line at the threshold level.")

thresholdInput = input.float(20, "Threshold Level (%)", minval = 0, step = 0.5, group = LEVEL_GROUP
  , tooltip = "Annualized volatility level, in percent, used for the reference line and the threshold alerts.")

showComponentsInput = input.bool(false, "Show Components", group = STYLE_GROUP
  , tooltip = "Plot the three annualized variance components separately: overnight (close-to-open), open-to-close, and Rogers-Satchell. On 24/7 markets the overnight component sits near zero and the estimate is driven by the other two.")

highColorInput = input.color(HIGH_VOL_COLOR, "Above Threshold", inline = "volatility", group = STYLE_GROUP
  , tooltip = "Color of the Yang-Zhang volatility line and its gradient fill while the estimate sits at or above the threshold level.")

lowColorInput = input.color(LOW_VOL_COLOR, "Below Threshold", inline = "volatility", group = STYLE_GROUP
  , tooltip = "Color of the Yang-Zhang volatility line and its gradient fill while the estimate sits below the threshold level.")

comparisonColorInput = input.color(COMPARISON_COLOR, "Comparison", group = STYLE_GROUP
  , tooltip = "Color of the comparison window estimate.")

overnightColorInput = input.color(OVERNIGHT_COLOR, "Overnight Component", group = STYLE_GROUP
  , tooltip = "Color of the annualized overnight (close-to-open) component.")

openCloseColorInput = input.color(OPEN_CLOSE_COLOR, "Open-to-Close Component", group = STYLE_GROUP
  , tooltip = "Color of the annualized open-to-close component.")

rogersSatchellColorInput = input.color(ROGERS_SATCHELL_COLOR, "Rogers-Satchell Component", group = STYLE_GROUP
  , tooltip = "Color of the annualized Rogers-Satchell (drift-independent range) component.")

thresholdColorInput = input.color(LEVEL_COLOR, "Threshold", group = STYLE_GROUP
  , tooltip = "Color of the dashed threshold reference line.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Variance-minimizing weight from the original paper — depends only on the window length n
yangZhangWeight(windowLength) =>
    K_NUMERATOR / (K_OFFSET + (windowLength + 1.0) / (windowLength - 1.0))

// Convert a per-bar variance into an annualized volatility percentage
annualizedVolatility(perBarVariance) =>
    math.sqrt(math.max(perBarVariance, 0) * barsPerYearInput) * PCT_SCALE

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Per-bar log return series: overnight (open over prior close) and open-to-close (close over same-bar open)
overnightReturn = math.log(open / close[1])
openCloseReturn = math.log(close / open)

// Per-bar Rogers-Satchell term — the drift-independent range component
rogersSatchellTerm = math.log(high / close) * math.log(high / open) + math.log(low / close) * math.log(low / open)

// Primary window — ordinary sample variances of the two return series plus the Rogers-Satchell window mean
overnightVariance      = ta.variance(overnightReturn, lengthInput, false)
openCloseVariance      = ta.variance(openCloseReturn, lengthInput, false)
rogersSatchellVariance = ta.sma(rogersSatchellTerm, lengthInput)

k = yangZhangWeight(lengthInput)
yangZhangVariance   = overnightVariance + k * openCloseVariance + (1 - k) * rogersSatchellVariance
yangZhangVolatility = annualizedVolatility(yangZhangVariance)

// Comparison window — same estimator over a second, user-set length
comparisonOvernightVariance      = ta.variance(overnightReturn, comparisonLengthInput, false)
comparisonOpenCloseVariance      = ta.variance(openCloseReturn, comparisonLengthInput, false)
comparisonRogersSatchellVariance = ta.sma(rogersSatchellTerm, comparisonLengthInput)

comparisonK          = yangZhangWeight(comparisonLengthInput)
comparisonVariance   = comparisonOvernightVariance + comparisonK * comparisonOpenCloseVariance + (1 - comparisonK) * comparisonRogersSatchellVariance
comparisonVolatility = annualizedVolatility(comparisonVariance)

// Annualized component volatilities (for the optional component display)
overnightVolatility      = annualizedVolatility(overnightVariance)
openCloseVolatility      = annualizedVolatility(openCloseVariance)
rogersSatchellVolatility = annualizedVolatility(rogersSatchellVariance)

// Events
crossAboveThreshold = ta.crossover(yangZhangVolatility, thresholdInput)
crossBelowThreshold = ta.crossunder(yangZhangVolatility, thresholdInput)
fastAboveSlow       = ta.crossover(yangZhangVolatility, comparisonVolatility)
fastBelowSlow       = ta.crossunder(yangZhangVolatility, comparisonVolatility)

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
// State coloring against the threshold - elevated volatility at or above it, subdued below it
volatilityColor = yangZhangVolatility >= thresholdInput ? highColorInput : lowColorInput

zeroPlotId      = plot(0, "Zero Baseline", color = na, editable = false, display = display.none)
yangZhangPlotId = plot(yangZhangVolatility, "Yang-Zhang Volatility", color = volatilityColor, linewidth = 2)

// Metric gradient — fully transparent at zero, 50% transparency at the current value
fill(yangZhangPlotId, zeroPlotId, top_value = yangZhangVolatility, bottom_value = 0, top_color = color.new(volatilityColor, 50), bottom_color = color.new(volatilityColor, 100), title = "Volatility Gradient")

plot(comparisonVolatility, "Comparison Volatility", color = comparisonColorInput, display = showComparisonInput ? display.all : display.none)

plot(overnightVolatility, "Overnight Volatility", color = overnightColorInput, display = showComponentsInput ? display.all : display.none)
plot(openCloseVolatility, "Open-to-Close Volatility", color = openCloseColorInput, display = showComponentsInput ? display.all : display.none)
plot(rogersSatchellVolatility, "Rogers-Satchell Volatility", color = rogersSatchellColorInput, display = showComponentsInput ? display.all : display.none)

hline(thresholdInput, "Threshold", color = thresholdColorInput, linestyle = hline.style_dashed, display = showThresholdInput ? display.all : display.none)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossAboveThreshold, "Volatility Above Threshold", "Yang-Zhang annualized volatility crossed above the threshold level on {{ticker}} ({{interval}})")
alertcondition(crossBelowThreshold, "Volatility Below Threshold", "Yang-Zhang annualized volatility crossed below the threshold level on {{ticker}} ({{interval}})")
alertcondition(fastAboveSlow, "Volatility Expansion", "Yang-Zhang volatility crossed above the comparison window estimate on {{ticker}} ({{interval}}) — volatility expanding")
alertcondition(fastBelowSlow, "Volatility Contraction", "Yang-Zhang volatility crossed below the comparison window estimate on {{ticker}} ({{interval}}) — volatility contracting")

//---------------------------------------------------------------------------------------------------------------------}
