//@version=6
indicator("Astro Cycles"
  , shorttitle       = "Astro Cycles"
  , overlay          = true
  , precision        = 2
  , max_lines_count  = 500
  , max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
// Standard astronomical constants (Meeus, Astronomical Algorithms)
SYNODIC_MONTH = 29.530588861   // mean lunation length in days
MS_PER_DAY    = 86400000.0
JD_UNIX_EPOCH = 2440587.5      // Julian date of the Unix epoch
J2000_JD      = 2451545.0      // Julian date of epoch J2000.0
MEAN_NEW_2000 = 2451550.09766  // JDE of the mean new moon of 2000-01-06 (lunation k = 0)
ECLIPSE_LIMIT = 0.36           // |sin F| below this at a syzygy places it inside an eclipse window
DEG2RAD       = math.pi / 180.0

BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86
LABEL_BG      = #00000000
DASH_BG       = #161616
DASH_FRAME    = #2E2E2E
DASH_HEADER   = #808080
DASH_TEXT     = #DBDBDB
DASH_NA_TEXT  = "—"

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
showNewInput = input.bool(true, "New moons", group = "Lunar Calendar"
  , tooltip = "Marks every new moon with a vertical line at its exact astronomical time, computed from the standard lunation series (accurate to within a few minutes).")

showFullInput = input.bool(true, "Full moons", group = "Lunar Calendar"
  , tooltip = "Marks every full moon with a vertical line at its exact astronomical time, computed from the standard lunation series (accurate to within a few minutes).")

labelsInput = input.bool(true, "Event labels", group = "Lunar Calendar"
  , tooltip = "Tags the bar containing each new/full moon with a tiny N / F label. The label tooltip holds the exact event time in UTC.")

eclipseTagInput = input.bool(true, "Tag eclipse windows", group = "Lunar Calendar"
  , tooltip = "Flags new/full moons occurring near a lunar node (|sin F| < 0.36), where a solar eclipse (new moon) or lunar eclipse (full moon) is possible.")

projCountInput = input.int(4, "Upcoming events", minval = 0, maxval = 12, group = "Lunar Calendar"
  , tooltip = "Number of future new/full moons projected past the last bar as dotted lines. Astronomical dates are computable years ahead - the precision that gives astro calendars their aura of objectivity. Treat them as watchlist dates only, never as signals.")

shadeInput = input.bool(true, "Shade lunar halves", group = "Cycle Halves"
  , tooltip = "Tints the background over the new-moon half of each lunation (last quarter through new moon to first quarter) and the full-moon half - the claimed lunar sentiment rhythm of favoring longs around new moons. Published support is tiny, unstable and sample-dependent. Active on timeframes up to weekly.")

dashInput = input.bool(true, "Show dashboard", group = "Dashboard"
  , tooltip = "Shows the current phase, the next new/full moon dates, and a descriptive split of this chart's bar returns by lunar half - a quick null-hypothesis check of the claimed bias on the symbol at hand. Descriptive only, not evidence of predictive power.")

dashPosInput = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Dashboard"
  , tooltip = "Dashboard placement on the chart.")

dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = "Dashboard"
  , tooltip = "Dashboard text size.")

newColorInput  = input.color(BULL_COLOR, "New moon",  group = "Style")
fullColorInput = input.color(BEAR_COLOR, "Full moon", group = "Style")

shadeTranspInput = input.int(94, "Shading transparency", minval = 80, maxval = 99, group = "Style"
  , tooltip = "Transparency of the lunar-half background shading.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// sine of an angle expressed in degrees
dsin(float angleDeg) =>
    math.sin(angleDeg * DEG2RAD)

// fractional part mapped into [0, 1)
frac01(float value) =>
    value - math.floor(value)

// lunation index k: integers are new moons, half-integers are full moons
isNewMoonK(float k) =>
    math.abs(k - math.round(k)) < 0.25

// instantaneous lunar phase as a fraction of the cycle: 0 = new moon, 0.5 = full moon.
// True elongation of the Moon from the Sun via the principal periodic terms of the
// standard illuminated-fraction series (Meeus ch. 48)
phaseFraction(int timeMs) =>
    float jd = timeMs / MS_PER_DAY + JD_UNIX_EPOCH
    float t  = (jd - J2000_JD) / 36525.0
    float dE = 297.8501921 + 445267.1114034 * t - 0.0018819 * t * t   // mean elongation
    float mS = 357.5291092 + 35999.0502909  * t - 0.0001536 * t * t   // Sun's mean anomaly
    float mM = 134.9633964 + 477198.8675055 * t + 0.0087414 * t * t   // Moon's mean anomaly
    float trueElong = dE + 6.289 * dsin(mM) - 2.100 * dsin(mS) + 1.274 * dsin(2.0 * dE - mM) + 0.658 * dsin(2.0 * dE) + 0.214 * dsin(2.0 * mM) + 0.110 * dsin(dE)
    frac01(trueElong / 360.0)

// exact time of the syzygy at lunation index k, in Unix milliseconds.
// Mean phase time plus the principal planetary/lunar corrections of the standard
// phases-of-the-Moon series (Meeus ch. 49); truncation keeps timing well within
// the tolerance needed to place an event inside the correct chart bar
syzygyMs(float k) =>
    float t  = k / 1236.85
    float t2 = t * t
    float t3 = t2 * t
    float t4 = t3 * t
    float jde = MEAN_NEW_2000 + SYNODIC_MONTH * k + 0.00015437 * t2 - 0.000000150 * t3 + 0.00000000073 * t4
    float eF  = 1.0 - 0.002516 * t - 0.0000074 * t2                                                   // eccentricity factor
    float mS  = 2.5534   + 29.10535670  * k - 0.0000014 * t2 - 0.00000011 * t3                        // Sun's mean anomaly
    float mM  = 201.5643 + 385.81693528 * k + 0.0107582 * t2 + 0.00001238 * t3 - 0.000000058 * t4     // Moon's mean anomaly
    float fL  = 160.7108 + 390.67050284 * k - 0.0016118 * t2 - 0.00000227 * t3 + 0.000000011 * t4     // argument of latitude
    float om  = 124.7746 - 1.56375588   * k + 0.0020672 * t2 + 0.00000215 * t3                        // ascending node
    bool newEvent = isNewMoonK(k)
    float corr = (newEvent ? -0.40720 : -0.40614) * dsin(mM)
    corr += (newEvent ?  0.17241 :  0.17302) * eF * dsin(mS)
    corr += (newEvent ?  0.01608 :  0.01614) * dsin(2.0 * mM)
    corr += (newEvent ?  0.01039 :  0.01043) * dsin(2.0 * fL)
    corr += (newEvent ?  0.00739 :  0.00734) * eF * dsin(mM - mS)
    corr += (newEvent ? -0.00514 : -0.00515) * eF * dsin(mM + mS)
    corr += (newEvent ?  0.00208 :  0.00209) * eF * eF * dsin(2.0 * mS)
    corr += -0.00111 * dsin(mM - 2.0 * fL)
    corr += -0.00057 * dsin(mM + 2.0 * fL)
    corr +=  0.00056 * eF * dsin(2.0 * mM + mS)
    corr += -0.00042 * dsin(3.0 * mM)
    corr +=  0.00042 * eF * dsin(mS + 2.0 * fL)
    corr +=  0.00038 * eF * dsin(mS - 2.0 * fL)
    corr += -0.00024 * eF * dsin(2.0 * mM - mS)
    corr += -0.00017 * dsin(om)
    (jde + corr - JD_UNIX_EPOCH) * MS_PER_DAY

// true when the syzygy at lunation index k falls close enough to a lunar node
// for an eclipse to be possible (standard quick test: |sin F| < 0.36)
syzygyEclipse(float k) =>
    float t  = k / 1236.85
    float t2 = t * t
    float t3 = t2 * t
    float t4 = t3 * t
    float fL = 160.7108 + 390.67050284 * k - 0.0016118 * t2 - 0.00000227 * t3 + 0.000000011 * t4
    math.abs(dsin(fL)) < ECLIPSE_LIMIT

phaseName(float phaseValue) =>
    switch
        phaseValue < 0.0625 or phaseValue >= 0.9375 => "New moon"
        phaseValue < 0.1875 => "Waxing crescent"
        phaseValue < 0.3125 => "First quarter"
        phaseValue < 0.4375 => "Waxing gibbous"
        phaseValue < 0.5625 => "Full moon"
        phaseValue < 0.6875 => "Waning gibbous"
        phaseValue < 0.8125 => "Last quarter"
        => "Waning crescent"

signColorOf(float value) =>
    na(value) ? DASH_TEXT : value > 0 ? newColorInput : value < 0 ? fullColorInput : DASH_TEXT

getTablePosition(string positionText) =>
    switch positionText
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

getTextSize(string sizeText) =>
    switch sizeText
        "Tiny"  => size.tiny
        "Small" => size.small
        => size.normal

//---------------------------------------------------------------------------------------------------------------------}
// Lunar event engine — exact syzygy times mapped onto chart bars
//---------------------------------------------------------------------------------------------------------------------{
var float nextK  = na   // lunation index of the next pending syzygy
var float nextMs = na   // its exact time in Unix milliseconds

if barstate.isfirst
    float jd0 = time / MS_PER_DAY + JD_UNIX_EPOCH
    float k0  = math.floor((jd0 - MEAN_NEW_2000) / SYNODIC_MONTH * 2.0) / 2.0 - 1.0
    float ms0 = syzygyMs(k0)
    int initGuard = 0
    while ms0 <= time and initGuard < 12
        k0 += 0.5
        ms0 := syzygyMs(k0)
        initGuard += 1
    nextK  := k0
    nextMs := ms0

bool newMoonBar  = false
bool fullMoonBar = false
bool eclipseBar  = false

int eventGuard = 0
while nextMs <= time_close and eventGuard < 60
    bool  newEvent   = isNewMoonK(nextK)
    bool  eclipseWin = syzygyEclipse(nextK)
    int   eventTs    = math.round(nextMs)
    color eventColor = newEvent ? newColorInput : fullColorInput
    if newEvent ? showNewInput : showFullInput
        line.new(eventTs, low, eventTs, high, xloc.bar_time, extend.both, color.new(eventColor, 35), line.style_solid, 1)
        if labelsInput
            string tagText = (newEvent ? "N" : "F") + (eclipseWin and eclipseTagInput ? " ·E" : "")
            string tipText = (newEvent ? "New moon — " : "Full moon — ") + str.format_time(eventTs, "yyyy-MM-dd HH:mm", "UTC") + " UTC" + (eclipseWin ? (newEvent ? "\nSolar-eclipse window (near lunar node)" : "\nLunar-eclipse window (near lunar node)") : "")
            label.new(bar_index, na, tagText, yloc = yloc.abovebar, style = label.style_label_down, color = LABEL_BG, textcolor = eventColor, size = size.tiny, tooltip = tipText)
    if newEvent
        newMoonBar := true
    else
        fullMoonBar := true
    if eclipseWin
        eclipseBar := true
    nextK  += 0.5
    nextMs := syzygyMs(nextK)
    eventGuard += 1

//---------------------------------------------------------------------------------------------------------------------}
// Cycle halves & per-half return statistics
//---------------------------------------------------------------------------------------------------------------------{
// halves are meaningless once a single bar spans a large share of the lunation
bool tfSuitable = timeframe.in_seconds() <= 7 * 86400

float phaseNow = phaseFraction(time)
float illumNow = (1.0 - math.cos(phaseNow * 360.0 * DEG2RAD)) / 2.0
bool  newHalfNow = phaseNow >= 0.75 or phaseNow < 0.25

var bool wasNewHalf = false
bool enteredNewHalf  = tfSuitable and bar_index > 0 and newHalfNow and not wasNewHalf
bool enteredFullHalf = tfSuitable and bar_index > 0 and not newHalfNow and wasNewHalf
wasNewHalf := newHalfNow

var float newHalfRetSum  = 0.0
var float fullHalfRetSum = 0.0
var int   newHalfBars    = 0
var int   fullHalfBars   = 0
var int   newHalfWins    = 0
var int   fullHalfWins   = 0

float barReturn = na(close[1]) ? na : close / close[1] - 1.0
if tfSuitable and not na(barReturn)
    if newHalfNow
        newHalfRetSum += barReturn
        newHalfBars   += 1
        newHalfWins   += barReturn > 0 ? 1 : 0
    else
        fullHalfRetSum += barReturn
        fullHalfBars   += 1
        fullHalfWins   += barReturn > 0 ? 1 : 0

//---------------------------------------------------------------------------------------------------------------------}
// Background shading & data-window series
//---------------------------------------------------------------------------------------------------------------------{
bgcolor(shadeInput and tfSuitable ? color.new(newHalfNow ? newColorInput : fullColorInput, shadeTranspInput) : na, title = "Lunar half shading")

plot(phaseNow * 100.0, "Lunar cycle position %", color = NEUTRAL_COLOR, display = display.data_window)
plot(illumNow * 100.0, "Moon illumination %",    color = NEUTRAL_COLOR, display = display.data_window)

//---------------------------------------------------------------------------------------------------------------------}
// Future event projection — the calendar known in advance
//---------------------------------------------------------------------------------------------------------------------{
var array<line>  futureLineArray  = array.new<line>()
var array<label> futureLabelArray = array.new<label>()

if barstate.islast
    if array.size(futureLineArray) > 0
        for i = 0 to array.size(futureLineArray) - 1
            line.delete(array.get(futureLineArray, i))
        array.clear(futureLineArray)
    if array.size(futureLabelArray) > 0
        for i = 0 to array.size(futureLabelArray) - 1
            label.delete(array.get(futureLabelArray, i))
        array.clear(futureLabelArray)
    if projCountInput > 0
        for i = 0 to projCountInput - 1
            float kF = nextK + 0.5 * i
            bool  newEvent = isNewMoonK(kF)
            if newEvent ? showNewInput : showFullInput
                bool  eclipseWin = syzygyEclipse(kF)
                int   eventTs    = math.round(syzygyMs(kF))
                color eventColor = newEvent ? newColorInput : fullColorInput
                string dateText  = (newEvent ? "New" : "Full") + " · " + str.format_time(eventTs, "MMM dd", syminfo.timezone) + (eclipseWin and eclipseTagInput ? " · ecl" : "")
                string tipText   = (newEvent ? "Upcoming new moon — " : "Upcoming full moon — ") + str.format_time(eventTs, "yyyy-MM-dd HH:mm", "UTC") + " UTC" + (eclipseWin ? (newEvent ? "\nSolar-eclipse window (near lunar node)" : "\nLunar-eclipse window (near lunar node)") : "") + "\nWatchlist date only — no direction implied"
                array.push(futureLineArray, line.new(eventTs, low, eventTs, high, xloc.bar_time, extend.both, color.new(eventColor, 50), line.style_dotted, 1))
                array.push(futureLabelArray, label.new(eventTs, close, dateText, xloc.bar_time, color = LABEL_BG, style = label.style_label_left, textcolor = eventColor, size = size.tiny, tooltip = tipText))

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
string tableTextSize = getTextSize(dashSizeInput)

var table dashTable = dashInput ? table.new(getTablePosition(dashPosInput), 3, 10
  , bgcolor      = DASH_BG
  , frame_color  = DASH_FRAME
  , frame_width  = 1
  , border_width = 0) : table(na)

var bool tableMergedFlag = false

if dashInput and barstate.islast and not na(dashTable)
    // next upcoming event of each type (the watchlist rows)
    float nextNewMs   = na
    float nextFullMs  = na
    bool  nextNewEcl  = false
    bool  nextFullEcl = false
    float kScan = nextK
    for scanIdx = 0 to 3
        bool scanNew = isNewMoonK(kScan)
        if scanNew and na(nextNewMs)
            nextNewMs  := syzygyMs(kScan)
            nextNewEcl := syzygyEclipse(kScan)
        if not scanNew and na(nextFullMs)
            nextFullMs  := syzygyMs(kScan)
            nextFullEcl := syzygyEclipse(kScan)
        kScan += 0.5

    color  labelColor  = DASH_HEADER
    float  newAvgVal   = newHalfBars  > 0 ? newHalfRetSum  / newHalfBars       : na
    float  fullAvgVal  = fullHalfBars > 0 ? fullHalfRetSum / fullHalfBars      : na
    string newAvgText  = na(newAvgVal)    ? DASH_NA_TEXT : str.tostring(newAvgVal  * 100.0, "0.000") + "%"
    string fullAvgText = na(fullAvgVal)   ? DASH_NA_TEXT : str.tostring(fullAvgVal * 100.0, "0.000") + "%"
    string newWinText  = newHalfBars  > 0 ? str.tostring(100.0 * newHalfWins  / newHalfBars,  "0.0") + "%" : DASH_NA_TEXT
    string fullWinText = fullHalfBars > 0 ? str.tostring(100.0 * fullHalfWins / fullHalfBars, "0.0") + "%" : DASH_NA_TEXT
    string nextNewText  = na(nextNewMs)  ? DASH_NA_TEXT : str.format_time(math.round(nextNewMs),  "yyyy-MM-dd", syminfo.timezone) + (nextNewEcl  and eclipseTagInput ? " · solar-ecl window" : "")
    string nextFullText = na(nextFullMs) ? DASH_NA_TEXT : str.format_time(math.round(nextFullMs), "yyyy-MM-dd", syminfo.timezone) + (nextFullEcl and eclipseTagInput ? " · lunar-ecl window" : "")
    string halfNowText  = tfSuitable ? " · " + (newHalfNow ? "new-moon half" : "full-moon half") : ""
    string footerText   = tfSuitable ? "Watchlist dates only — no robust predictive evidence" : "Timeframe above weekly — halves and stats disabled, event lines stay exact"

    table.cell(dashTable, 0, 0, "Astro cycles — lunar calendar", text_halign = text.align_left, text_color = DASH_TEXT, text_size = tableTextSize, bgcolor = DASH_BG)
    table.cell(dashTable, 0, 1, "Phase", text_halign = text.align_left, text_color = labelColor, text_size = tableTextSize)
    table.cell(dashTable, 1, 1, phaseName(phaseNow) + " · " + str.tostring(illumNow * 100.0, "0") + "% lit", text_halign = text.align_left, text_color = DASH_TEXT, text_size = tableTextSize)
    table.cell(dashTable, 0, 2, "Cycle day", text_halign = text.align_left, text_color = labelColor, text_size = tableTextSize)
    table.cell(dashTable, 1, 2, str.tostring(phaseNow * SYNODIC_MONTH, "0.0") + " / 29.5" + halfNowText, text_halign = text.align_left, text_color = tfSuitable ? (newHalfNow ? newColorInput : fullColorInput) : DASH_TEXT, text_size = tableTextSize)
    table.cell(dashTable, 0, 3, "Next new moon", text_halign = text.align_left, text_color = labelColor, text_size = tableTextSize)
    table.cell(dashTable, 1, 3, nextNewText, text_halign = text.align_left, text_color = newColorInput, text_size = tableTextSize)
    table.cell(dashTable, 0, 4, "Next full moon", text_halign = text.align_left, text_color = labelColor, text_size = tableTextSize)
    table.cell(dashTable, 1, 4, nextFullText, text_halign = text.align_left, text_color = fullColorInput, text_size = tableTextSize)
    table.cell(dashTable, 0, 5, "History (this chart)", text_halign = text.align_left, text_color = DASH_HEADER, text_size = tableTextSize, tooltip = "Descriptive split of this chart's bar returns by lunar half. A quick null-hypothesis check of the claimed lunar rhythm - random date sets produce spreads like these easily, so treat any edge shown here with suspicion.")
    table.cell(dashTable, 1, 5, "New half", text_color = newColorInput, text_size = tableTextSize, tooltip = "Bars in the half-lunation centered on the new moon (last quarter to first quarter) - the claimed-favorable phase.")
    table.cell(dashTable, 2, 5, "Full half", text_color = fullColorInput, text_size = tableTextSize, tooltip = "Bars in the half-lunation centered on the full moon (first quarter to last quarter) - the claimed-cautious phase.")
    table.cell(dashTable, 0, 6, "Avg bar return", text_halign = text.align_left, text_color = labelColor, text_size = tableTextSize)
    table.cell(dashTable, 1, 6, newAvgText, text_color = signColorOf(newAvgVal), text_size = tableTextSize)
    table.cell(dashTable, 2, 6, fullAvgText, text_color = signColorOf(fullAvgVal), text_size = tableTextSize)
    table.cell(dashTable, 0, 7, "Win rate", text_halign = text.align_left, text_color = labelColor, text_size = tableTextSize)
    table.cell(dashTable, 1, 7, newWinText, text_color = DASH_TEXT, text_size = tableTextSize)
    table.cell(dashTable, 2, 7, fullWinText, text_color = DASH_TEXT, text_size = tableTextSize)
    table.cell(dashTable, 0, 8, "Bars", text_halign = text.align_left, text_color = labelColor, text_size = tableTextSize)
    table.cell(dashTable, 1, 8, str.tostring(newHalfBars), text_color = DASH_TEXT, text_size = tableTextSize)
    table.cell(dashTable, 2, 8, str.tostring(fullHalfBars), text_color = DASH_TEXT, text_size = tableTextSize)
    table.cell(dashTable, 0, 9, footerText, text_halign = text.align_left, text_color = DASH_HEADER, text_size = size.tiny, bgcolor = DASH_BG)
    if not tableMergedFlag
        table.cell(dashTable, 1, 0, "", text_size = tableTextSize)
        table.cell(dashTable, 2, 0, "", text_size = tableTextSize)
        table.cell(dashTable, 2, 1, "", text_size = tableTextSize)
        table.cell(dashTable, 2, 2, "", text_size = tableTextSize)
        table.cell(dashTable, 2, 3, "", text_size = tableTextSize)
        table.cell(dashTable, 2, 4, "", text_size = tableTextSize)
        table.cell(dashTable, 1, 9, "", text_size = tableTextSize)
        table.cell(dashTable, 2, 9, "", text_size = tableTextSize)
        table.merge_cells(dashTable, 0, 0, 2, 0)
        table.merge_cells(dashTable, 1, 1, 2, 1)
        table.merge_cells(dashTable, 1, 2, 2, 2)
        table.merge_cells(dashTable, 1, 3, 2, 3)
        table.merge_cells(dashTable, 1, 4, 2, 4)
        table.merge_cells(dashTable, 0, 9, 2, 9)
        tableMergedFlag := true

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(newMoonBar,      "New moon",              "astro cycles: new moon on {{ticker}} — watchlist date only, no direction implied")
alertcondition(fullMoonBar,     "Full moon",             "astro cycles: full moon on {{ticker}} — watchlist date only, no direction implied")
alertcondition(eclipseBar,      "Eclipse-window syzygy", "astro cycles: new/full moon near a lunar node on {{ticker}} — eclipse window")
alertcondition(enteredNewHalf,  "New-moon half begins",  "astro cycles: lunar cycle entered its new-moon half on {{ticker}} (claimed-favorable phase — no robust evidence)")
alertcondition(enteredFullHalf, "Full-moon half begins", "astro cycles: lunar cycle entered its full-moon half on {{ticker}} (claimed-cautious phase — no robust evidence)")

//---------------------------------------------------------------------------------------------------------------------}
