//@version=6
indicator("Trend Step Channel [BigBeluga]", overlay = true)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

GRP = "Trend"
maLengthInput = 25
volatility  =  200
width = input.float(2, "Channel Width", step = 0.1, group = GRP, inline = "Channel")
chanCol = input.color(color.rgb(120, 123, 134, 70), "", inline = "Channel", group = GRP)

colUp = input.color(color.rgb(27, 255, 145), "", inline = "col")
colDn = input.color(color.rgb(255, 135, 22), "", inline = "col")

// }
// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

var direction 	= bool(na)
var band 		= float(na)

tf = array.from("60", "120", "180", "240", "300")

tfConvert(tf)=>
	switch tf
		"60" => "1h"
		"120" => "2h"
		"180" => "3h"
		"240" => "4h"
		"300" => "5h"

atr = ta.atr(volatility)
MaUp =  ta.sma(close, 25) + atr
MaDn =  ta.sma(close, 25) - atr 

upperBand = band + atr*width
lowerBand = band - atr*width


if bar_index < 300
	if close >= MaUp
		direction := true 
	if close <= MaDn
		direction := false 
else 
	if low >= upperBand
		direction := true 
	if high <= lowerBand
		direction := false 


if direction
    band := math.max(nz(band), hl2)
else
    band := math.min(nz(band), hl2)

Tcolor  = band > band[1] ? colUp : band < band[1] ? colDn : color.new(direction ? colUp : colDn, 35)



// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{


pm = plot(band, "Trend Line", color = Tcolor, linewidth = 4)
pu = plot(upperBand, display = display.none, editable = false)
pb = plot(lowerBand, display = display.none, editable = false)

fill(pm, pu, upperBand, band, chanCol, color(na))
fill(pm, pb, band, lowerBand, color(na), chanCol)

bbr = (close - lowerBand)/(upperBand - lowerBand)
bbr := bbr > 1 ? 1 : bbr < 0 ? 0 : bbr 
bbr := bbr * 100
var dash = table.new(position.bottom_right, 100, 100, border_color = chart.bg_color, border_width = 1, frame_width = 1, frame_color = chart.bg_color)

if barstate.islast
	step = (upperBand-lowerBand)/100

	l1 = line.new(bar_index+3, upperBand, bar_index+3, lowerBand, color = Tcolor)
	lbl1 = label.new(bar_index+3, lowerBand + step * bbr, "<", style = "lcn", color = color(na), size = size.large, textcolor = direction ? colUp : colDn)
	lbl2 = label.new(bar_index+3, lowerBand + step * bbr, str.tostring(int(bbr)) + "%", style = "llf", color = color(na), textcolor = direction ? colUp : colDn)

	(l1[1]).delete()
	(lbl1[1]).delete()
	(lbl2[1]).delete()

	for i = 0 to tf.size() - 1
		tff = tf.get(i)
		[data, direct] = request.security("", tff, [bbr, direction])

		dash.cell(i, 0, tfConvert(tff), text_color = chart.fg_color)
		dash.cell(i, 1, (direct ? "↑" : "↓") + str.tostring(int(data)) + "%", bgcolor = direct ? colUp : colDn, text_color = color.rgb(0, 0, 0))


// }