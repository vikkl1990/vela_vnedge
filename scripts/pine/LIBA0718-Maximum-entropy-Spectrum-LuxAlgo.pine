//@version=6
indicator("Maximum-entropy Spectrum", "Maximum-entropy Spectrum", overlay = false, format = format.price, precision = 1, max_boxes_count = 200, max_labels_count = 10)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // a sharp, tradeable rhythm
NEUTRAL_COLOR = #787b86 // a flat or drifting spectrum
HEAT_COLOR    = #ff9800 // the one accent - the strongest spectral peak in the profile

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

EPSILON        = 1e-12
MAX_LOOKBACK   = 300
PROFILE_OFFSET = 2

FIRST_DIFF  = "First Difference"
SMA_DETREND = "SMA Detrend"

GRP_MODEL  = "Data & Model"
GRP_SPEC   = "Spectrum"
GRP_SIG    = "Signals"
GRP_DISP   = "Display"
GRP_STYLE  = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput    = input.source(close, "Source", group = GRP_MODEL, tooltip = "Price series fed to the spectral estimator, after conditioning.")
windowInput = input.int(64, "Sample Window", minval = 24, maxval = 250, group = GRP_MODEL, tooltip = "Number of conditioned samples fitted by Burg's method each bar. Maximum-entropy analysis is designed for short windows; shorter windows track drifting cycles faster, longer ones stabilize the spectrum.")
orderInput  = input.int(12, "AR Order", minval = 2, maxval = 40, group = GRP_MODEL, tooltip = "Autoregressive model order p, the key tuning choice: too low blurs peaks together, too high can split one real cycle into spurious ones. The order is automatically capped below half the sample window.")

conditioningInput  = input.string(FIRST_DIFF, "Conditioning", options = [FIRST_DIFF, SMA_DETREND], group = GRP_MODEL, tooltip = "High-pass conditioning applied before fitting so the trend does not masquerade as a very long cycle. First Difference uses bar-to-bar changes; SMA Detrend subtracts a moving average from the source.")
detrendLengthInput = input.int(48, "Detrend Length", minval = 2, maxval = 200, group = GRP_MODEL, tooltip = "Moving average length used by the SMA Detrend conditioning mode.")
calcBarsInput      = input.int(2000, "Calculation Bars", minval = 0, group = GRP_MODEL, tooltip = "Most recent bars on which the spectrum is estimated. 0 computes over the entire chart history (slower).")

minPeriodInput = input.int(8, "Minimum Period", minval = 4, maxval = 100, group = GRP_SPEC, tooltip = "Shortest cycle period, in bars, evaluated on the spectral grid.")
maxPeriodInput = input.int(48, "Maximum Period", minval = 8, maxval = 100, group = GRP_SPEC, tooltip = "Longest cycle period, in bars, evaluated on the spectral grid. Kept a few bars above the minimum period automatically.")
smoothingInput = input.int(3, "Cycle Smoothing", minval = 1, maxval = 20, group = GRP_SPEC, tooltip = "Median smoothing applied to the dominant period and sharpness readouts. 1 disables smoothing.")

sharpThresholdInput = input.float(4.0, "Sharpness Threshold", minval = 1.0, step = 0.5, group = GRP_SIG, tooltip = "Peak-to-average power ratio above which the spectrum is considered to hold one sharp, tradeable rhythm; below it the spectrum reads as flat or drifting.")
shiftThresholdInput = input.float(5.0, "Cycle Shift Threshold", minval = 1.0, step = 1.0, group = GRP_SIG, tooltip = "Minimum bar-to-bar change of the smoothed dominant period, in bars, that fires the cycle shift alert.")

showProfileInput  = input.bool(true, "Show Spectrum Profile", group = GRP_DISP, tooltip = "Draws the current power spectrum as a horizontal profile to the right of the last bar, sharing the period axis with the dominant cycle line so peaks line up with the plot.")
profileWidthInput = input.int(30, "Profile Width", minval = 10, maxval = 100, group = GRP_DISP, tooltip = "Width, in bars, allotted to the strongest spectral peak in the profile.")
showHalfInput     = input.bool(false, "Show Half Cycle", group = GRP_DISP, tooltip = "Plots half the dominant period, a common choice when setting oscillator lookbacks from the measured cycle.")

showDashboardInput = input.bool(true, "Show Dashboard", group = GRP_DISP, tooltip = "Displays a summary dashboard with the dominant cycle, secondary peak, and spectrum state.")
dashPositionInput  = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = GRP_DISP, tooltip = "Chart corner holding the dashboard.")
dashSizeInput      = input.string("Small", "Dashboard Size", options = ["Tiny", "Small", "Normal"], group = GRP_DISP, tooltip = "Text size of the dashboard.")

mainColorInput     = input.color(BULL_COLOR, "Dominant Cycle", group = GRP_STYLE, tooltip = "Color of the dominant cycle while the spectrum holds a sharp rhythm. The line turns neutral while the spectrum reads flat or drifting.")
flatColorInput     = input.color(NEUTRAL_COLOR, "Flat Spectrum", group = GRP_STYLE)
heatLowColorInput  = input.color(color.new(NEUTRAL_COLOR, 85), "Spectrum Low / High", inline = "heat", group = GRP_STYLE)
heatHighColorInput = input.color(HEAT_COLOR, "", inline = "heat", group = GRP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// maps the dashboard position setting to a table position
getTablePosition(positionText) =>
    switch positionText
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        =>                position.top_right

// maps the dashboard size setting to a text size
getTextSize(sizeText) =>
    switch sizeText
        "Tiny"   => size.tiny
        "Normal" => size.normal
        =>          size.small

// fits an autoregressive model x(t) = a1*x(t-1) + ... + ap*x(t-p) + e(t) with Burg's recursion,
// minimizing forward and backward prediction error, returns [coefficients, residual variance]
burgFit(sampleArray, order) =>
    n           = array.size(sampleArray)
    coeffsArray = array.new_float(order, 0.0)
    prevArray   = array.new_float(order, 0.0)
    fwdArray    = array.copy(sampleArray)
    bwdArray    = array.copy(sampleArray)
    errPower    = 0.0
    for i = 0 to n - 1
        v = array.get(sampleArray, i)
        errPower += v * v
    errPower /= n
    for m = 1 to order
        // reflection coefficient minimizing the summed forward + backward prediction error
        num = 0.0
        den = 0.0
        for i = m to n - 1
            fv = array.get(fwdArray, i)
            bv = array.get(bwdArray, i - 1)
            num += fv * bv
            den += fv * fv + bv * bv
        k = den > EPSILON ? 2 * num / den : 0.0
        k := math.max(-0.9999, math.min(0.9999, k))
        // Levinson update of the AR coefficients
        for i = 0 to order - 1
            array.set(prevArray, i, array.get(coeffsArray, i))
        array.set(coeffsArray, m - 1, k)
        if m > 1
            for i = 1 to m - 1
                array.set(coeffsArray, i - 1, array.get(prevArray, i - 1) - k * array.get(prevArray, m - i - 1))
        // update the forward / backward prediction errors in place
        bOld = array.get(bwdArray, m - 1)
        for i = m to n - 1
            fv    = array.get(fwdArray, i)
            bNext = array.get(bwdArray, i)
            array.set(fwdArray, i, fv - k * bOld)
            array.set(bwdArray, i, bOld - k * fv)
            bOld := bNext
        errPower *= 1 - k * k
    [coeffsArray, math.max(errPower, EPSILON)]

// evaluates the AR spectral density P(f) = s2 / |1 - sum a(k) * exp(-i*2*pi*f*k)|^2 at a cycle period
arPower(coeffsArray, residVar, period) =>
    omega = 2 * math.pi / period
    re    = 1.0
    im    = 0.0
    for k = 1 to array.size(coeffsArray)
        ak = array.get(coeffsArray, k - 1)
        re -= ak * math.cos(omega * k)
        im += ak * math.sin(omega * k)
    residVar / math.max(re * re + im * im, EPSILON)

//---------------------------------------------------------------------------------------------------------------------}
// Maximum-Entropy Spectrum
//---------------------------------------------------------------------------------------------------------------------{
// input conditioning: high-pass the data so the trend does not masquerade as a very long cycle
diffSeries        = srcInput - srcInput[1]
detrendSeries     = srcInput - ta.sma(srcInput, detrendLengthInput)
conditionedSeries = conditioningInput == FIRST_DIFF ? diffSeries : detrendSeries
max_bars_back(conditionedSeries, MAX_LOOKBACK)

// effective parameters: the order stays well below half the window, the grid stays valid
effOrder   = math.max(2, math.min(orderInput, math.floor(windowInput / 2) - 1))
maxPeriod  = math.max(maxPeriodInput, minPeriodInput + 4)
gridCount  = maxPeriod - minPeriodInput + 1
warmupBars = conditioningInput == FIRST_DIFF ? 1 : detrendLengthInput
canCompute = bar_index >= windowInput + warmupBars and (calcBarsInput == 0 or last_bar_index - bar_index <= calcBarsInput)

var windowArray = array.new_float(windowInput, 0.0)
var powerArray  = array.new_float(gridCount, 0.0)

domRaw       = float(na)
sharpnessRaw = float(na)
secondPeriod = float(na)

if canCompute
    // rolling sample of the conditioned series, oldest first
    hasNa = false
    for i = 0 to windowInput - 1
        v = conditionedSeries[windowInput - 1 - i]
        hasNa := hasNa or na(v)
        array.set(windowArray, i, nz(v))
    if not hasNa
        // demean, fit the AR model, then evaluate the spectrum over the period grid
        meanValue = array.avg(windowArray)
        for i = 0 to windowInput - 1
            array.set(windowArray, i, array.get(windowArray, i) - meanValue)
        [coeffsArray, residVar] = burgFit(windowArray, effOrder)
        maxPower  = 0.0
        sumPower  = 0.0
        peakIndex = 0
        for j = 0 to gridCount - 1
            pw = arPower(coeffsArray, residVar, minPeriodInput + j)
            array.set(powerArray, j, pw)
            sumPower += pw
            if pw > maxPower
                maxPower  := pw
                peakIndex := j
        if maxPower > EPSILON
            // dominant period at the largest peak, refined by parabolic interpolation
            domValue = float(minPeriodInput + peakIndex)
            if peakIndex > 0 and peakIndex < gridCount - 1
                pL    = array.get(powerArray, peakIndex - 1)
                pC    = array.get(powerArray, peakIndex)
                pR    = array.get(powerArray, peakIndex + 1)
                denom = pL - 2 * pC + pR
                if math.abs(denom) > EPSILON
                    domValue += math.max(-0.5, math.min(0.5, 0.5 * (pL - pR) / denom))
            domRaw       := domValue
            sharpnessRaw := maxPower / math.max(sumPower / gridCount, EPSILON)
            // strongest secondary local maximum away from the dominant peak (competing cycle)
            secondBest = 0.0
            for j = 1 to gridCount - 2
                pw         = array.get(powerArray, j)
                isLocalMax = pw > array.get(powerArray, j - 1) and pw >= array.get(powerArray, j + 1)
                if isLocalMax and math.abs(j - peakIndex) > 2 and pw > secondBest
                    secondBest   := pw
                    secondPeriod := minPeriodInput + j

// smoothed readouts and spectral events
domSmooth   = ta.median(domRaw, smoothingInput)
sharpSmooth = ta.median(sharpnessRaw, smoothingInput)

isSharp    = nz(sharpSmooth) >= sharpThresholdInput
sharpCross = ta.crossover(sharpSmooth, sharpThresholdInput)
flatCross  = ta.crossunder(sharpSmooth, sharpThresholdInput)
cycleShift = not na(domSmooth) and not na(domSmooth[1]) and math.abs(domSmooth - domSmooth[1]) >= shiftThresholdInput

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
// state coloring - the cycle reading is tradeable while the spectrum holds one sharp peak, neutral while it is flat or drifting
cycleColor = isSharp ? mainColorInput : flatColorInput

domPlotId  = plot(domSmooth, "Dominant Cycle", color = cycleColor, linewidth = 2, style = plot.style_linebr)
halfPlotId = plot(showHalfInput ? domSmooth / 2 : na, "Half Cycle", color = color.new(cycleColor, 40), style = plot.style_linebr)
zeroPlotId = plot(0, "Base", display = display.none, editable = false)

// metric-style vertical gradient, fully transparent at zero
fill(domPlotId, zeroPlotId, top_value = nz(domSmooth), bottom_value = 0, top_color = color.new(cycleColor, 50), bottom_color = color.new(cycleColor, 100))

//---------------------------------------------------------------------------------------------------------------------}
// Spectrum Profile & Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var profileBoxArray  = array.new_box()
var label domLabelId = na
var table dashTableId = showDashboardInput ? table.new(getTablePosition(dashPositionInput), 2, 5, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1) : na

dashTextSize = getTextSize(dashSizeInput)

if barstate.islast
    // current spectrum drawn as a horizontal power profile on the shared period axis
    for boxId in profileBoxArray
        box.delete(boxId)
    array.clear(profileBoxArray)
    label.delete(domLabelId)
    maxPower = array.max(powerArray)
    if showProfileInput and not na(domRaw) and maxPower > EPSILON
        for j = 0 to gridCount - 1
            normPower = array.get(powerArray, j) / maxPower
            boxWidth  = math.max(1, math.round(normPower * profileWidthInput))
            boxColor  = color.from_gradient(normPower, 0, 1, heatLowColorInput, heatHighColorInput)
            array.push(profileBoxArray, box.new(bar_index + PROFILE_OFFSET, minPeriodInput + j + 0.5, bar_index + PROFILE_OFFSET + boxWidth, minPeriodInput + j - 0.5, border_color = na, bgcolor = boxColor))
        domLabelId := label.new(bar_index + PROFILE_OFFSET + profileWidthInput + 1, domRaw, str.tostring(domRaw, "#.#"), style = label.style_label_left, color = #00000000, textcolor = cycleColor, size = size.small)
    if not na(dashTableId)
        stateText  = isSharp ? "Sharp rhythm" : "Flat / drifting"
        stateColor = isSharp ? mainColorInput : flatColorInput
        table.cell(dashTableId, 0, 0, "Dominant Cycle", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
        table.cell(dashTableId, 1, 0, na(domSmooth) ? "-" : str.tostring(domSmooth, "#.#") + " bars", text_color = cycleColor, text_size = dashTextSize, text_halign = text.align_right)
        table.cell(dashTableId, 0, 1, "Half Cycle", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
        table.cell(dashTableId, 1, 1, na(domSmooth) ? "-" : str.tostring(domSmooth / 2, "#.#") + " bars", text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
        table.cell(dashTableId, 0, 2, "2nd Peak", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
        table.cell(dashTableId, 1, 2, na(secondPeriod) ? "-" : str.tostring(secondPeriod, "#") + " bars", text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
        table.cell(dashTableId, 0, 3, "Peak / Avg Power", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
        table.cell(dashTableId, 1, 3, na(sharpSmooth) ? "-" : str.tostring(sharpSmooth, "#.#") + "x", text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
        table.cell(dashTableId, 0, 4, "Spectrum", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
        table.cell(dashTableId, 1, 4, na(domSmooth) ? "-" : stateText, text_color = stateColor, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(sharpCross, "Spectrum Turned Sharp", "Maximum-entropy spectrum: peak sharpness crossed above the threshold - a single dominant rhythm is emerging.")
alertcondition(flatCross, "Spectrum Turned Flat", "Maximum-entropy spectrum: peak sharpness fell below the threshold - the period landscape is flat or drifting.")
alertcondition(cycleShift, "Dominant Cycle Shift", 'Maximum-entropy spectrum: the dominant cycle shifted to {{plot("Dominant Cycle")}} bars.')

//---------------------------------------------------------------------------------------------------------------------}
