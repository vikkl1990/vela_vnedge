//@version=6
indicator("Ergodic Oscillator", shorttitle = "Ergodic Oscillator", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
SCALE             = 100     // scales the bounded momentum ratio to +/-100
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // signal line color
LEVELS_COLOR      = #787b86 // extreme bands and zero line color
FILL_VALUE_TRANSP = 50      // gradient transparency at the ergodic value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line
HIST_GROW_TRANSP  = 40      // histogram transparency while the line-signal gap widens
HIST_FADE_TRANSP  = 70      // histogram transparency once the gap narrows

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Series fed into the double-smoothed ratio. The construction is input-agnostic - any series can replace the closing price - but a short pipeline keeps the reading close to price.")

longLengthInput = input.int(20, "Long Smoothing Length", minval = 1
  , group   = "Settings"
  , tooltip = "Length of the first EMA stage applied to one-bar price change and, identically, to its absolute value. Longer first-stage smoothing gives a slower, cleaner line for regime and divergence work. The common SMI Ergodic default is 20.")

shortLengthInput = input.int(5, "Short Smoothing Length", minval = 1
  , group   = "Settings"
  , tooltip = "Length of the second EMA stage. Blau's two successive light smoothings strip bar-to-bar noise while keeping more of the turn timing than a single heavy average; shorter settings act more like a responsive trigger. The common default is 5.")

signalLengthInput = input.int(5, "Signal Length", minval = 1
  , group   = "Settings"
  , tooltip = "Length of the EMA of the ergodic line forming the signal line - the pairing that marks the commonly charted SMI Ergodic form. The common default is 5.")

//---------------------------------------------------------------------------------------------------------------------}
// Extreme Bands
//---------------------------------------------------------------------------------------------------------------------{
showBandsInput = input.bool(false, "Extreme Bands"
  , group   = "Extreme Bands"
  , tooltip = "Draws dashed bands marking bounded-extreme context - visits are read as overbought/oversold conditions, a reason to stand down on fresh momentum entries rather than to fade automatically. Off by default because extremes are instrument-specific; calibrate the levels to the symbol and timeframe.")

upperBandInput = input.float(25, "Upper", minval = 0, step = 1, inline = "bands"
  , group   = "Extreme Bands"
  , tooltip = "Upper and lower extreme band levels on the +/-100 scale. +/-25 is the published convention for the same construction under its True Strength Index name and serves only as a starting point. The band-entry alerts fire on these levels whether or not the bands are displayed.")

lowerBandInput = input.float(-25, "Lower", maxval = 0, step = 1, inline = "bands"
  , group   = "Extreme Bands"
  , tooltip = "Lower extreme band level, mirroring the upper band below zero.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of the ergodic line, gradient fill and histogram above the zero line.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of the ergodic line, gradient fill and histogram below the zero line.")

signalColorInput = input.color(SIGNAL_COLOR, "Signal Line"
  , group   = "Style"
  , tooltip = "Color of the signal line, the EMA of the ergodic line.")

levelsColorInput = input.color(LEVELS_COLOR, "Levels Color"
  , group   = "Style"
  , tooltip = "Color of the dashed extreme bands and of the dotted zero line.")

showHistInput = input.bool(true, "Show Histogram"
  , group   = "Style"
  , tooltip = "Displays the oscillator variant - the gap between the ergodic line and its signal line - as columns. Bright columns mark a still-widening gap, faded columns a gap already shrinking: the deceleration read that warns of momentum rolling over before the actual cross.")

gradientInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Fills the area between the zero line and the ergodic line with a vertical gradient, fully transparent at zero and strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// One-bar price change - Blau's raw ingredient, too noisy to read directly
momentum = ta.change(srcInput)

// Double smoothing - two successive EMAs applied to one-bar momentum and, with the same lengths, to its
// absolute value, so numerator and denominator carry identical lag
momEma     = ta.ema(momentum, longLengthInput)
momEma2    = ta.ema(momEma, shortLengthInput)
absMomEma  = ta.ema(math.abs(momentum), longLengthInput)
absMomEma2 = ta.ema(absMomEma, shortLengthInput)

// Ergodic line - double-smoothed momentum divided by double-smoothed absolute momentum, scaled to +/-100.
// Comparing net change to total change bounds the line and makes it comparable across instruments, at the
// price of measuring directional consistency rather than size. A dead-flat stretch would divide by zero,
// so it maps to 0 instead
ergodic = na(absMomEma2) ? na : absMomEma2 != 0 ? SCALE * momEma2 / absMomEma2 : 0

// Signal line and histogram - the EMA of the ergodic line, and the line-minus-signal gap plotted by the
// oscillator variant
signalLine = ta.ema(ergodic, signalLengthInput)
histogram  = ergodic - signalLine

// Signal grammar - signal-line crosses are the MACD-style momentum triggers, zero crosses the slow
// trend-change cue, extreme-band entries the overbought/oversold context, and a positive/negative histogram
// that stops widening flags momentum rolling over ahead of the actual cross
bullCross = ta.crossover(ergodic, signalLine)
bearCross = ta.crossunder(ergodic, signalLine)

zeroCrossUp   = ta.crossover(ergodic, 0)
zeroCrossDown = ta.crossunder(ergodic, 0)

upperBandEntry = ta.crossover(ergodic, upperBandInput)
lowerBandEntry = ta.crossunder(ergodic, lowerBandInput)

upsideFading   = histogram > 0 and histogram < histogram[1] and histogram[1] >= histogram[2]
downsideFading = histogram < 0 and histogram > histogram[1] and histogram[1] <= histogram[2]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// Histogram shading encodes the gap's direction - bright while line and signal pull apart, faded once the
// gap narrows back toward the signal line
histExpanding   = histogram >= 0 ? histogram > histogram[1] : histogram < histogram[1]
histStrongColor = histogram >= 0 ? color.new(bullColorInput, HIST_GROW_TRANSP) : color.new(bearColorInput, HIST_GROW_TRANSP)
histSoftColor   = histogram >= 0 ? color.new(bullColorInput, HIST_FADE_TRANSP) : color.new(bearColorInput, HIST_FADE_TRANSP)
histColor       = histExpanding ? histStrongColor : histSoftColor

plot(showHistInput ? histogram : na, "Histogram", style = plot.style_columns, color = histColor)

plot(signalLine, "Signal Line", signalColorInput, 1)

ergodicPlotId = plot(ergodic, "Ergodic Line", ergodic > 0 ? bullColorInput : bearColorInput, 2)

zeroPlotId = plot(0, "Zero Anchor", editable = false, display = display.none)

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the ergodic value
fillTopColor    = ergodic > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_ZERO_TRANSP)
fillBottomColor = ergodic > 0 ? color.new(bullColorInput, FILL_ZERO_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(ergodicPlotId, zeroPlotId
  , math.max(ergodic, 0)
  , math.min(ergodic, 0)
  , gradientInput ? fillTopColor : na
  , gradientInput ? fillBottomColor : na
  , title = "Zero-line Gradient Fill")

// Dotted zero centerline and dashed instrument-specific extreme bands
hline(0, "Zero Line", color.new(levelsColorInput, 50), hline.style_dotted)
hline(upperBandInput, "Upper Extreme Band", levelsColorInput, hline.style_dashed, display = showBandsInput ? display.all : display.none)
hline(lowerBandInput, "Lower Extreme Band", levelsColorInput, hline.style_dashed, display = showBandsInput ? display.all : display.none)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullCross, "Bullish Signal Cross", "Ergodic line crossed above its signal line on {{ticker}} - MACD-style momentum trigger to the upside; filter by zero-line position or a trend gauge to cut counter-trend noise ({{interval}})")
alertcondition(bearCross, "Bearish Signal Cross", "Ergodic line crossed below its signal line on {{ticker}} - MACD-style momentum trigger to the downside; filter by zero-line position or a trend gauge to cut counter-trend noise ({{interval}})")
alertcondition(zeroCrossUp, "Bullish Zero Cross", "Ergodic line crossed above zero on {{ticker}} - net double-smoothed momentum turned positive, the slow trend-change cue ({{interval}})")
alertcondition(zeroCrossDown, "Bearish Zero Cross", "Ergodic line crossed below zero on {{ticker}} - net double-smoothed momentum turned negative, the slow trend-change cue ({{interval}})")
alertcondition(upperBandEntry, "Upper Extreme Band Entry", "Ergodic line entered the upper extreme band on {{ticker}} - overbought context, stand down on fresh momentum entries rather than fading automatically ({{interval}})")
alertcondition(lowerBandEntry, "Lower Extreme Band Entry", "Ergodic line entered the lower extreme band on {{ticker}} - oversold context, stand down on fresh momentum entries rather than fading automatically ({{interval}})")
alertcondition(upsideFading, "Upside Momentum Fading", "Ergodic histogram is shrinking while above zero on {{ticker}} - the line-signal gap is closing, flagging upside momentum rolling over ahead of a bearish cross ({{interval}})")
alertcondition(downsideFading, "Downside Momentum Fading", "Ergodic histogram is shrinking while below zero on {{ticker}} - the line-signal gap is closing, flagging downside momentum rolling over ahead of a bullish cross ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
