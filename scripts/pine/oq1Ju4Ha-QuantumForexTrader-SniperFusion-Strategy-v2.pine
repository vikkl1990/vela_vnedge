//@version=6
strategy("QuantumForexTrader_SOLUSDT_SniperFusion_Strategy_v2", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=100,
     max_bars_back=5000)

// === Inputs ===
group_analysis = "=== Quantum Core ==="
historyBars = input.int(72, "History bars for analysis", group=group_analysis, minval=32, maxval=4096)
confThreshold = input.float(0.54, "Minimum confidence", group=group_analysis, step=0.01)
momentumThreshold = input.float(0.08, "Minimum momentum", group=group_analysis, step=0.01)
memoryDecay = input.float(0.88, "Memory decay", group=group_analysis, minval=0.50, maxval=0.99, step=0.01)
memoryThreshold = input.float(0.05, "Memory threshold", group=group_analysis, minval=0.01, maxval=1.00, step=0.01)

group_filters = "=== Trend Filters ==="
useEMAfilter = input.bool(true, "Use EMA Trend Filter", group=group_filters)
useMTFfilter = input.bool(true, "Use higher timeframe trend filter", group=group_filters)
useVolFilter = input.bool(true, "Use Volume Filter", group=group_filters)
useATRfilter = input.bool(true, "Use ATR Volatility Filter", group=group_filters)
useCandleFilter = input.bool(true, "Use Candle Body Filter", group=group_filters)
trendEmaLen = input.int(34, "Trend EMA Length", group=group_filters)
mtfTf = input.timeframe("5", "MTF Trend TF", group=group_filters)
volLookback = input.int(24, "Volume SMA Length", group=group_filters)
volMultiplier = input.float(1.00, "Min Relative Volume", group=group_filters, step=0.05)
atrLen = input.int(14, "ATR Length", group=group_filters)
atrMaLen = input.int(21, "ATR SMA Length", group=group_filters)
atrMultiplier = input.float(0.95, "Min ATR vs ATR-SMA", group=group_filters, step=0.05)
bodyRatioMin = input.float(0.35, "Min Candle Body Ratio", group=group_filters, step=0.05)

group_sniper = "=== Sniper Logic ==="
useSniperBiasFilter = input.bool(true, "Require sniper bias alignment", group=group_sniper)
sniperMinPct = input.float(57.0, "Minimum sniper score %", group=group_sniper, minval=40, maxval=100, step=1)
useSniperCrossTrigger = input.bool(true, "Allow EMA 9/21 cross trigger", group=group_sniper)
strongBiasDiff = input.float(40.0, "Strong bias difference", group=group_sniper, minval=10, maxval=100, step=5)

group_signal = "=== Signal Generation ==="
signalIntervalMin = input.int(3, "Signal interval (minutes)", group=group_signal, minval=1, maxval=240)
signalScoreMin = input.int(8, "Minimum total score", group=group_signal, minval=1, maxval=20)
signalEdgeMin = input.int(2, "Minimum score edge", group=group_signal, minval=0, maxval=20)
minMoveAtr = input.float(0.30, "Min move from last signal (ATR)", group=group_signal, step=0.05)
includePriceInAlert = input.bool(true, "Include price in webhook", group=group_signal)
useCloseActionForExit = input.bool(true, "Use close instead of reverse-open", group=group_signal)
allowLongs  = input.bool(true, "Allow long entries", group=group_signal)
allowShorts = input.bool(false, "Allow short entries (PF short was 1.002 in audit)", group=group_signal)

group_hold = "=== Trade Lifecycle Gates ==="
minHoldBars = input.int(3, "Min bars in trade before any signal-based exit", group=group_hold, minval=0)
earlyExitAfterTP1 = input.bool(true, "Early exits only after TP1 hit", group=group_hold)

group_risk = "=== Risk Management ==="
slAtrMultiplier = input.float(1.5, "SL ATR Multiplier", group=group_risk, minval=0.1, step=0.1)
useTakeProfits = input.bool(true, "Use TP1-TP5 partial exits (20% each)", group=group_risk)
tpStepR = input.float(1.0, "TP step (R multiples of initial risk)", group=group_risk, minval=0.5, step=0.25)

group_tsl = "=== Trailing Stop Loss ==="
useTrailingStop = input.bool(true, "Use Trailing Stop Loss", group=group_tsl)
tslAtrMultiplier = input.float(1.5, "TSL ATR Multiplier", group=group_tsl, minval=0.1, step=0.1)
tslActivationAtr = input.float(0.5, "TSL Activation (ATR)", group=group_tsl, minval=0.0, step=0.1, tooltip="Profit in ATR needed to activate trailing stop. 0 = active immediately.")

// === Responsive Exits ===
group_exits = "=== Responsive Exits ==="
useEarlyExit   = input.bool(true, "Enable Early Reversal Exits", group=group_exits)
exitEmaLength  = input.int(9, "Fast EMA Length for Exit", group=group_exits)
useRsiExit     = input.bool(true, "Use RSI Exhaustion Exit", group=group_exits)
rsiLength      = input.int(14, "RSI Length", group=group_exits)
rsiOverbought  = input.int(75, "RSI Overbought (Long Exit)", group=group_exits)
rsiOversold    = input.int(25, "RSI Oversold (Short Exit)", group=group_exits)

group_visual = "=== Visuals ==="
showDashboard = input.bool(true, "Show sniper dashboard", group=group_visual)
showRibbon = input.bool(true, "Show EMA ribbon", group=group_visual)
showTargets = input.bool(true, "Show ATR targets", group=group_visual)
showSignalLabels = input.bool(true, "Show entry/exit markers", group=group_visual)
showVwap = input.bool(true, "Show VWAP", group=group_visual)
ribbonOpacity = input.int(75, "EMA Ribbon Opacity", group=group_visual, minval=0, maxval=100)
dashTextSizeStr = input.string("small", "Dashboard font size", options=["tiny", "small", "normal", "large", "huge"], group=group_visual)
tradeTextSizeStr = input.string("small", "Trade label size", options=["tiny", "small", "normal", "large", "huge"], group=group_visual)
labelOffset = input.int(12, "Label right offset (bars)", minval=1, group=group_visual)

group_time = "=== Trading Schedule ==="
useTimeFilter = input.bool(false, "Use time filter", group=group_time)
startHour = input.int(7, "Start trading hour", group=group_time, minval=0, maxval=23)
endHour = input.int(23, "End trading hour", group=group_time, minval=0, maxval=23)

// === Functions ===
getTextSize(string s) =>
    switch s
        "tiny" => size.tiny
        "normal" => size.normal
        "large" => size.large
        "huge" => size.huge
        => size.small

inSession() =>
    if not useTimeFilter
        true
    else
        int h = hour(time, syminfo.timezone)
        startHour <= endHour ? (h >= startHour and h < endHour) : (h >= startHour or h < endHour)

f_addDashRow(_table, _row, _title, _value, _textColor, _size) =>
    table.cell(_table, 0, _row, _title, text_color=color.black, text_halign=text.align_left, text_size=_size)
    table.cell(_table, 1, _row, _value, text_color=_textColor, text_halign=text.align_right, text_size=_size)

// === Session ===
sessionOK = inSession()

// === Shared indicators (all ta.* calls unconditional, evaluated every bar) ===
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
vwapValue = ta.vwap(hlc3)
atrValue = ta.atr(atrLen)
rsiValue = ta.rsi(close, rsiLength)
// Anti-repaint: use last CONFIRMED HTF bar via [1] offset + explicit lookahead_off
rsi5m = request.security(syminfo.tickerid, "5", ta.rsi(close, rsiLength)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[macdMain, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
[dmiPlus, dmiMinus, adxValue] = ta.dmi(14, 14)
volAvg = ta.sma(volume, 20)

// === Quantum Analysis ===
int maxHist = 4096
int histLen = historyBars > maxHist ? maxHist : historyBars

float upCount = 0.0
float downCount = 0.0

for i = 1 to histLen
    if not na(close[i]) and not na(close[i + 1])
        float chg = close[i] - close[i + 1]
        float weight = 1.0 + ((histLen - i) / histLen)
        if chg > 0
            upCount += weight
        else if chg < 0
            downCount += weight

totalMoves = upCount + downCount
bullProb = totalMoves > 0 ? upCount / totalMoves : 0.0
bearProb = totalMoves > 0 ? downCount / totalMoves : 0.0

trendDir =
     bullProb > bearProb ? 1 :
     bearProb > bullProb ? -1 : 0

stateMomentum =
     bullProb > bearProb ? (bullProb - bearProb) :
     bearProb > bullProb ? (bearProb - bullProb) : 0.0

confidence = math.max(bullProb, bearProb)
confidenceScore = confidence >= confThreshold ? 1 : 0
momentumScore = stateMomentum >= momentumThreshold ? 1 : 0

// === Quantum filters ===
trendEmaValue = ta.ema(close, trendEmaLen)
trendEmaSlope = trendEmaValue - trendEmaValue[1]
emaBull = close > trendEmaValue and trendEmaSlope > 0
emaBear = close < trendEmaValue and trendEmaSlope < 0

// Anti-repaint MTF: whole boolean expression evaluated on last confirmed MTF bar
mtfBull = request.security(syminfo.tickerid, mtfTf, (close > ta.ema(close, trendEmaLen) and ta.ema(close, trendEmaLen) > ta.ema(close, trendEmaLen)[1])[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
mtfBear = request.security(syminfo.tickerid, mtfTf, (close < ta.ema(close, trendEmaLen) and ta.ema(close, trendEmaLen) < ta.ema(close, trendEmaLen)[1])[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

volSMA = ta.sma(volume, volLookback)
volOK = not na(volSMA) and volume > volSMA * volMultiplier

atrBase = ta.sma(atrValue, atrMaLen)
atrOK = not useATRfilter or (not na(atrBase) and atrValue >= atrBase * atrMultiplier)

candleRange = math.max(high - low, syminfo.mintick)
bodyRatio = math.abs(close - open) / candleRange
bullCandle = close > open and bodyRatio >= bodyRatioMin
bearCandle = close < open and bodyRatio >= bodyRatioMin

// === Sniper dual-score logic ===
float bullScoreSniper = 0
bullScoreSniper += close > vwapValue ? 1 : 0
bullScoreSniper += rsiValue > 50 ? 1 : 0
bullScoreSniper += macdMain > macdSignal ? 1 : 0
bullScoreSniper += ema9 > ema21 ? 1 : 0
bullScoreSniper += adxValue > 25 and close > ema9 ? 1 : 0
bullScoreSniper += volume > volAvg and close > open ? 1 : 0
bullScoreSniper += rsi5m > 50 ? 1 : 0
bullPct = bullScoreSniper / 7.0 * 100.0

float bearScoreSniper = 0
bearScoreSniper += close < vwapValue ? 1 : 0
bearScoreSniper += rsiValue < 50 ? 1 : 0
bearScoreSniper += macdMain < macdSignal ? 1 : 0
bearScoreSniper += ema9 < ema21 ? 1 : 0
bearScoreSniper += adxValue > 25 and close < ema9 ? 1 : 0
bearScoreSniper += volume > volAvg and close < open ? 1 : 0
bearScoreSniper += rsi5m < 50 ? 1 : 0
bearPct = bearScoreSniper / 7.0 * 100.0

biasDiff = bullPct - bearPct
biasText =
     biasDiff >= strongBiasDiff ? "STRONG BULL" :
     -biasDiff >= strongBiasDiff ? "STRONG BEAR" :
     bullPct > bearPct ? "MILD BULL" :
     bearPct > bullPct ? "MILD BEAR" : "NEUTRAL"

biasColor =
     biasText == "STRONG BULL" ? color.green :
     biasText == "STRONG BEAR" ? color.red :
     color.gray

sniperLongBias = bullPct > bearPct and bullPct >= sniperMinPct
sniperShortBias = bearPct > bullPct and bearPct >= sniperMinPct

sniperLongTrigger = useSniperCrossTrigger and ta.crossover(ema9, ema21) and sniperLongBias and close > vwapValue and macdMain > macdSignal and rsi5m > 50
sniperShortTrigger = useSniperCrossTrigger and ta.crossunder(ema9, ema21) and sniperShortBias and close < vwapValue and macdMain < macdSignal and rsi5m < 50

// === State (var = once per confirmed bar, deterministic, no intrabar repaint) ===
var int lastSignalBarIndex = na
var int lastSignalType = 0
var float lastSignalPrice = na
var float qMemory = 0.0
var int orderSeq = 0
var string openLongOrderId = ""
var string openShortOrderId = ""

var float entryPrice = na
var float stopPrice = na
var float trailingStopPrice = na
var float highestPriceSinceEntry = na
var float lowestPriceSinceEntry = na
var bool tslActive = false
var bool anchored = false
var int entryBarNum = na

var float tp1Price = na
var float tp2Price = na
var float tp3Price = na
var float tp4Price = na
var float tp5Price = na
var bool tp1Hit = false
var bool tp2Hit = false
var bool tp3Hit = false
var bool tp4Hit = false
var bool tp5Hit = false

var line entryLine = na
var line stopLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line tp4Line = na
var line tp5Line = na

var label entryLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na
var label tp4Label = na
var label tp5Label = na

chartSecondsRaw = timeframe.in_seconds(timeframe.period)
chartSeconds = na(chartSecondsRaw) ? 60 : chartSecondsRaw
intervalBars = math.max(1, int(math.ceil(signalIntervalMin * 60.0 / chartSeconds)))
newCheck = na(lastSignalBarIndex) ? true : (bar_index - lastSignalBarIndex >= intervalBars)

memoryInput =
     trendDir == 1 ? (0.18 + stateMomentum * 0.30) :
     trendDir == -1 ? -(0.18 + stateMomentum * 0.30) : 0.0

qMemory := math.max(-1.0, math.min(1.0, qMemory * memoryDecay + memoryInput))
memoryBias =
     qMemory > memoryThreshold ? 1 :
     qMemory < -memoryThreshold ? -1 : 0

preferredDir = trendDir != 0 ? trendDir : memoryBias

// === Hybrid score ===
longScore =
     (preferredDir == 1 ? 2 : 0) +
     (trendDir == 1 ? 1 : 0) +
     (memoryBias == 1 ? 1 : 0) +
     confidenceScore +
     momentumScore +
     ((not useEMAfilter or emaBull) ? 1 : 0) +
     ((not useMTFfilter or mtfBull) ? 1 : 0) +
     ((not useVolFilter or volOK) ? 1 : 0) +
     (atrOK ? 1 : 0) +
     ((not useCandleFilter or bullCandle) ? 1 : 0) +
     (bullPct > bearPct ? 2 : 0) +
     (biasDiff >= strongBiasDiff ? 1 : 0) +
     (close > vwapValue ? 1 : 0) +
     (macdMain > macdSignal ? 1 : 0) +
     (adxValue > 25 ? 1 : 0) +
     (rsi5m > 50 ? 1 : 0)

shortScore =
     (preferredDir == -1 ? 2 : 0) +
     (trendDir == -1 ? 1 : 0) +
     (memoryBias == -1 ? 1 : 0) +
     confidenceScore +
     momentumScore +
     ((not useEMAfilter or emaBear) ? 1 : 0) +
     ((not useMTFfilter or mtfBear) ? 1 : 0) +
     ((not useVolFilter or volOK) ? 1 : 0) +
     (atrOK ? 1 : 0) +
     ((not useCandleFilter or bearCandle) ? 1 : 0) +
     (bearPct > bullPct ? 2 : 0) +
     (-biasDiff >= strongBiasDiff ? 1 : 0) +
     (close < vwapValue ? 1 : 0) +
     (macdMain < macdSignal ? 1 : 0) +
     (adxValue > 25 ? 1 : 0) +
     (rsi5m < 50 ? 1 : 0)

longEdge = longScore - shortScore
shortEdge = shortScore - longScore

longRearmOK = na(lastSignalPrice) or lastSignalType != 1 or close >= lastSignalPrice + atrValue * minMoveAtr
shortRearmOK = na(lastSignalPrice) or lastSignalType != -1 or close <= lastSignalPrice - atrValue * minMoveAtr

longBiasGate = not useSniperBiasFilter or sniperLongBias or biasText == "STRONG BULL"
shortBiasGate = not useSniperBiasFilter or sniperShortBias or biasText == "STRONG BEAR"

bool rawLongSignal = sessionOK and newCheck and longRearmOK and longBiasGate and longScore >= signalScoreMin and longEdge >= signalEdgeMin
bool rawShortSignal = sessionOK and newCheck and shortRearmOK and shortBiasGate and shortScore >= signalScoreMin and shortEdge >= signalEdgeMin

rawLongSignal := rawLongSignal or sniperLongTrigger
rawShortSignal := rawShortSignal or sniperShortTrigger

if rawLongSignal and rawShortSignal
    if bullPct >= bearPct
        rawShortSignal := false
    else
        rawLongSignal := false

// === Position state from the strategy engine (single source of truth) ===
bool inLong = strategy.position_size > 0
bool inShort = strategy.position_size < 0
bool isFlat = strategy.position_size == 0

// === Early exit components (computed every bar, but only ACT on them in position) ===
fastExitEma = ta.ema(close, exitEmaLength)
priceCrossesBelowEma = ta.crossunder(close, fastExitEma)
priceCrossesAboveEma = ta.crossover(close, fastExitEma)

rsiExhaustionLong = rsiValue[1] > rsiOverbought and rsiValue < rsiOverbought
rsiExhaustionShort = rsiValue[1] < rsiOversold and rsiValue > rsiOversold

bullishEngulfing = close > open and close[1] < open[1] and close > open[1] and open < close[1]
bearishEngulfing = close < open and close[1] > open[1] and close < open[1] and open > close[1]

bool earlyLongExitRaw = useEarlyExit and (priceCrossesBelowEma or (useRsiExit and rsiExhaustionLong) or bearishEngulfing)
bool earlyShortExitRaw = useEarlyExit and (priceCrossesAboveEma or (useRsiExit and rsiExhaustionShort) or bullishEngulfing)

// FIX: early exits only when position is open AND lifecycle gates passed
int barsInTrade = na(entryBarNum) ? 0 : bar_index - entryBarNum
bool holdGatePassed = barsInTrade >= minHoldBars
bool earlyLongExit = earlyLongExitRaw and inLong and holdGatePassed and (not earlyExitAfterTP1 or tp1Hit)
bool earlyShortExit = earlyShortExitRaw and inShort and holdGatePassed and (not earlyExitAfterTP1 or tp1Hit)

// === Entry signals: confirmed bars only, flat only, direction toggles ===
bool enterLong = barstate.isconfirmed and rawLongSignal and isFlat and allowLongs
bool enterShort = barstate.isconfirmed and rawShortSignal and isFlat and allowShorts

// FIX: only real entries reset the signal interval timer (phantom exits no longer block entries)
if enterLong or enterShort
    lastSignalBarIndex := bar_index
    lastSignalType := enterLong ? 1 : -1
    lastSignalPrice := close

// === Alert payload builder (Pionex-compatible JSON) ===
pionexOrderPrefix = "QF_SOLUSDT_SNIPE"

makeOrderId(action, seq) =>
    pionexOrderPrefix + "_" + timeframe.period + "_" + str.tostring(bar_index) + "_" + str.tostring(seq) + "_" + action

makeAlertMessage(action, orderId) =>
    priceField = includePriceInAlert ? ',"price":' + str.tostring(close, format.mintick) : ""
    '{"action":"' + action + '","symbol":"' + syminfo.ticker + '"' + priceField + ',"order_id":"' + orderId + '"}'

// === Entries (provisional levels from signal bar; re-anchored to avg fill below) ===
if enterLong
    float risk = atrValue * slAtrMultiplier
    entryPrice := close
    stopPrice := close - risk
    highestPriceSinceEntry := high
    lowestPriceSinceEntry := na
    trailingStopPrice := na
    tslActive := false
    anchored := false
    entryBarNum := bar_index
    tp1Price := close + risk * tpStepR
    tp2Price := close + risk * tpStepR * 2.0
    tp3Price := close + risk * tpStepR * 3.0
    tp4Price := close + risk * tpStepR * 4.0
    tp5Price := close + risk * tpStepR * 5.0
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    tp4Hit := false
    tp5Hit := false
    orderSeq += 1
    openLongOrderId := makeOrderId("buy", orderSeq)
    strategy.entry("L", strategy.long, alert_message=makeAlertMessage("buy", openLongOrderId))

if enterShort
    float risk = atrValue * slAtrMultiplier
    entryPrice := close
    stopPrice := close + risk
    highestPriceSinceEntry := na
    lowestPriceSinceEntry := low
    trailingStopPrice := na
    tslActive := false
    anchored := false
    entryBarNum := bar_index
    tp1Price := close - risk * tpStepR
    tp2Price := close - risk * tpStepR * 2.0
    tp3Price := close - risk * tpStepR * 3.0
    tp4Price := close - risk * tpStepR * 4.0
    tp5Price := close - risk * tpStepR * 5.0
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    tp4Hit := false
    tp5Hit := false
    orderSeq += 1
    openShortOrderId := makeOrderId("sell", orderSeq)
    strategy.entry("S", strategy.short, alert_message=makeAlertMessage("sell", openShortOrderId))

// === Re-anchor levels to the actual average fill (once per trade) ===
if inLong and not anchored
    float riskA = atrValue * slAtrMultiplier
    entryPrice := strategy.position_avg_price
    stopPrice := strategy.position_avg_price - riskA
    tp1Price := strategy.position_avg_price + riskA * tpStepR
    tp2Price := strategy.position_avg_price + riskA * tpStepR * 2.0
    tp3Price := strategy.position_avg_price + riskA * tpStepR * 3.0
    tp4Price := strategy.position_avg_price + riskA * tpStepR * 4.0
    tp5Price := strategy.position_avg_price + riskA * tpStepR * 5.0
    anchored := true

if inShort and not anchored
    float riskB = atrValue * slAtrMultiplier
    entryPrice := strategy.position_avg_price
    stopPrice := strategy.position_avg_price + riskB
    tp1Price := strategy.position_avg_price - riskB * tpStepR
    tp2Price := strategy.position_avg_price - riskB * tpStepR * 2.0
    tp3Price := strategy.position_avg_price - riskB * tpStepR * 3.0
    tp4Price := strategy.position_avg_price - riskB * tpStepR * 4.0
    tp5Price := strategy.position_avg_price - riskB * tpStepR * 5.0
    anchored := true

// === Trailing stop maintenance (persistent var floats, monotonic) ===
if inLong and useTrailingStop
    highestPriceSinceEntry := math.max(nz(highestPriceSinceEntry, high), high)
    if (highestPriceSinceEntry - entryPrice) >= (atrValue * tslActivationAtr)
        tslActive := true
    if tslActive
        float newTslL = highestPriceSinceEntry - (atrValue * tslAtrMultiplier)
        trailingStopPrice := na(trailingStopPrice) ? newTslL : math.max(trailingStopPrice, newTslL)

if inShort and useTrailingStop
    lowestPriceSinceEntry := math.min(nz(lowestPriceSinceEntry, low), low)
    if (entryPrice - lowestPriceSinceEntry) >= (atrValue * tslActivationAtr)
        tslActive := true
    if tslActive
        float newTslS = lowestPriceSinceEntry + (atrValue * tslAtrMultiplier)
        trailingStopPrice := na(trailingStopPrice) ? newTslS : math.min(trailingStopPrice, newTslS)

// Effective stop = max(initial SL, trailing stop) for long / min for short
float effStopLong = useTrailingStop and tslActive and not na(trailingStopPrice) ? math.max(stopPrice, trailingStopPrice) : stopPrice
float effStopShort = useTrailingStop and tslActive and not na(trailingStopPrice) ? math.min(stopPrice, trailingStopPrice) : stopPrice

// === Order-based exits: SL + TP1..TP5 partials (placed every bar while in position) ===
if inLong
    strategy.exit("L_SL", from_entry="L", stop=effStopLong, alert_message=makeAlertMessage("close", openLongOrderId))
    if useTakeProfits
        strategy.exit("L_TP1", from_entry="L", qty_percent=20, limit=tp1Price)
        strategy.exit("L_TP2", from_entry="L", qty_percent=20, limit=tp2Price)
        strategy.exit("L_TP3", from_entry="L", qty_percent=20, limit=tp3Price)
        strategy.exit("L_TP4", from_entry="L", qty_percent=20, limit=tp4Price)
        strategy.exit("L_TP5", from_entry="L", qty_percent=20, limit=tp5Price)

if inShort
    strategy.exit("S_SL", from_entry="S", stop=effStopShort, alert_message=makeAlertMessage("close", openShortOrderId))
    if useTakeProfits
        strategy.exit("S_TP1", from_entry="S", qty_percent=20, limit=tp1Price)
        strategy.exit("S_TP2", from_entry="S", qty_percent=20, limit=tp2Price)
        strategy.exit("S_TP3", from_entry="S", qty_percent=20, limit=tp3Price)
        strategy.exit("S_TP4", from_entry="S", qty_percent=20, limit=tp4Price)
        strategy.exit("S_TP5", from_entry="S", qty_percent=20, limit=tp5Price)

// === Responsive closes: early reversal exit / opposite signal (position-gated) ===
bool closeLongNow = barstate.isconfirmed and inLong and (earlyLongExit or (useCloseActionForExit and rawShortSignal and holdGatePassed))
bool closeShortNow = barstate.isconfirmed and inShort and (earlyShortExit or (useCloseActionForExit and rawLongSignal and holdGatePassed))

if closeLongNow
    strategy.close("L", comment="EARLY_OPP", alert_message=makeAlertMessage("close", openLongOrderId))

if closeShortNow
    strategy.close("S", comment="EARLY_OPP", alert_message=makeAlertMessage("close", openShortOrderId))

// === Reset trade state when flat (reset-when-flat per standard) ===
if isFlat and not na(entryPrice)
    entryPrice := na
    stopPrice := na
    trailingStopPrice := na
    highestPriceSinceEntry := na
    lowestPriceSinceEntry := na
    tslActive := false
    anchored := false
    entryBarNum := na
    tp1Price := na
    tp2Price := na
    tp3Price := na
    tp4Price := na
    tp5Price := na
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    tp4Hit := false
    tp5Hit := false
    openLongOrderId := ""
    openShortOrderId := ""

// === TP hit flags (visual only) ===
if inLong
    tp1Hit := tp1Hit or high >= tp1Price
    tp2Hit := tp2Hit or high >= tp2Price
    tp3Hit := tp3Hit or high >= tp3Price
    tp4Hit := tp4Hit or high >= tp4Price
    tp5Hit := tp5Hit or high >= tp5Price
else if inShort
    tp1Hit := tp1Hit or low <= tp1Price
    tp2Hit := tp2Hit or low <= tp2Price
    tp3Hit := tp3Hit or low <= tp3Price
    tp4Hit := tp4Hit or low <= tp4Price
    tp5Hit := tp5Hit or low <= tp5Price

// === Visuals ===
dashTextSize = getTextSize(dashTextSizeStr)
tradeTextSize = getTextSize(tradeTextSizeStr)

pFast = plot(showRibbon ? ema9 : na, color=color.new(color.green, 20), title="EMA 9")
pSlow = plot(showRibbon ? ema21 : na, color=color.new(color.red, 20), title="EMA 21")
fill(pFast, pSlow, color = ema9 > ema21 ? color.new(color.green, 100 - ribbonOpacity) : color.new(color.red, 100 - ribbonOpacity))
plot(showVwap ? vwapValue : na, color=close > vwapValue ? color.green : color.red, linewidth=2, title="VWAP")

plot(inLong and not na(effStopLong) ? effStopLong : inShort and not na(effStopShort) ? effStopShort : na, color=color.fuchsia, style=plot.style_stepline, linewidth=2, title="Active Stop")

plotshape(showSignalLabels and enterLong, title="Buy Open", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, text="BUY")
plotshape(showSignalLabels and enterShort, title="Sell Open", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, text="SELL")
plotshape(showSignalLabels and closeLongNow, title="Close Long", style=shape.xcross, location=location.belowbar, color=color.orange, text="X-L")
plotshape(showSignalLabels and closeShortNow, title="Close Short", style=shape.xcross, location=location.abovebar, color=color.orange, text="X-S")

isRetest = (inLong and low <= ema9 and low > ema21) or (inShort and high >= ema9 and high < ema21)
barcolor(isRetest ? color.orange : na)

// === Target lines & labels (one statement per line; redrawn on entry, deleted when flat) ===
bool justEntered = (enterLong or enterShort) and showTargets
bool justWentFlat = isFlat and strategy.position_size[1] != 0

if justEntered
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    line.delete(tp4Line)
    line.delete(tp5Line)
    label.delete(entryLabel)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)
    label.delete(tp4Label)
    label.delete(tp5Label)
    entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice, color=color.blue, width=2, extend=extend.right)
    stopLine := line.new(bar_index, stopPrice, bar_index + 20, stopPrice, color=color.red, width=2, extend=extend.right)
    tp1Line := line.new(bar_index, tp1Price, bar_index + 20, tp1Price, color=color.green, style=line.style_dashed, extend=extend.right)
    tp2Line := line.new(bar_index, tp2Price, bar_index + 20, tp2Price, color=color.green, style=line.style_dashed, extend=extend.right)
    tp3Line := line.new(bar_index, tp3Price, bar_index + 20, tp3Price, color=color.green, style=line.style_dashed, extend=extend.right)
    tp4Line := line.new(bar_index, tp4Price, bar_index + 20, tp4Price, color=color.rgb(0, 100, 0), width=2, extend=extend.right)
    tp5Line := line.new(bar_index, tp5Price, bar_index + 20, tp5Price, color=color.rgb(0, 70, 0), width=3, extend=extend.right)
    entryLabel := label.new(bar_index + labelOffset, entryPrice, "ENTRY: " + str.tostring(entryPrice, format.mintick), color=color.blue, textcolor=color.white, style=label.style_label_left, size=tradeTextSize)
    tp1Label := label.new(bar_index + labelOffset, tp1Price, "TP1: " + str.tostring(tp1Price, format.mintick), color=color.green, textcolor=color.white, style=label.style_label_left, size=tradeTextSize)
    tp2Label := label.new(bar_index + labelOffset, tp2Price, "TP2: " + str.tostring(tp2Price, format.mintick), color=color.green, textcolor=color.white, style=label.style_label_left, size=tradeTextSize)
    tp3Label := label.new(bar_index + labelOffset, tp3Price, "TP3: " + str.tostring(tp3Price, format.mintick), color=color.green, textcolor=color.white, style=label.style_label_left, size=tradeTextSize)
    tp4Label := label.new(bar_index + labelOffset, tp4Price, "TP4: " + str.tostring(tp4Price, format.mintick), color=color.rgb(0, 100, 0), textcolor=color.white, style=label.style_label_left, size=tradeTextSize)
    tp5Label := label.new(bar_index + labelOffset, tp5Price, "TP5: " + str.tostring(tp5Price, format.mintick), color=color.rgb(0, 70, 0), textcolor=color.white, style=label.style_label_left, size=tradeTextSize)

if justWentFlat or not showTargets
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    line.delete(tp4Line)
    line.delete(tp5Line)
    label.delete(entryLabel)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)
    label.delete(tp4Label)
    label.delete(tp5Label)

if showTargets and not isFlat and not na(entryLine)
    int labelX = bar_index + labelOffset
    float liveStop = inLong ? effStopLong : effStopShort
    line.set_y1(stopLine, liveStop)
    line.set_y2(stopLine, liveStop)
    line.set_color(tp1Line, tp1Hit ? #40E0D0 : color.green)
    line.set_color(tp2Line, tp2Hit ? #40E0D0 : color.green)
    line.set_color(tp3Line, tp3Hit ? #40E0D0 : color.green)
    line.set_color(tp4Line, tp4Hit ? #40E0D0 : color.rgb(0, 100, 0))
    line.set_color(tp5Line, tp5Hit ? #40E0D0 : color.rgb(0, 70, 0))
    label.set_xy(entryLabel, labelX, entryPrice)
    label.set_xy(tp1Label, labelX, tp1Price)
    label.set_xy(tp2Label, labelX, tp2Price)
    label.set_xy(tp3Label, labelX, tp3Price)
    label.set_xy(tp4Label, labelX, tp4Price)
    label.set_xy(tp5Label, labelX, tp5Price)
    label.set_text(entryLabel, "ENTRY: " + str.tostring(entryPrice, format.mintick))
    label.set_text(tp1Label, "TP1: " + str.tostring(tp1Price, format.mintick) + (tp1Hit ? " hit" : ""))
    label.set_text(tp2Label, "TP2: " + str.tostring(tp2Price, format.mintick) + (tp2Hit ? " hit" : ""))
    label.set_text(tp3Label, "TP3: " + str.tostring(tp3Price, format.mintick) + (tp3Hit ? " hit" : ""))
    label.set_text(tp4Label, "TP4: " + str.tostring(tp4Price, format.mintick) + (tp4Hit ? " hit" : ""))
    label.set_text(tp5Label, "TP5: " + str.tostring(tp5Price, format.mintick) + (tp5Hit ? " hit" : ""))

// === Dashboard (now with real strategy engine stats) ===
var table dash = table.new(position.middle_left, 2, 17, bgcolor=color.new(#FFF9C4, 10), border_width=1, border_color=color.new(color.gray, 60))
if showDashboard and barstate.islast
    float openPnl = strategy.openprofit
    float winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
    table.cell(dash, 0, 0, "BULL SCORE", text_color=color.white, bgcolor=color.green, text_size=dashTextSize)
    table.cell(dash, 1, 0, str.tostring(bullPct, "#") + "%", text_color=color.white, bgcolor=color.green, text_size=dashTextSize)
    table.cell(dash, 0, 1, "BEAR SCORE", text_color=color.white, bgcolor=color.red, text_size=dashTextSize)
    table.cell(dash, 1, 1, str.tostring(bearPct, "#") + "%", text_color=color.white, bgcolor=color.red, text_size=dashTextSize)
    table.cell(dash, 0, 2, "MARKET BIAS", text_color=color.white, bgcolor=color.black, text_size=dashTextSize)
    table.cell(dash, 1, 2, biasText, text_color=color.white, bgcolor=biasColor, text_size=dashTextSize)
    f_addDashRow(dash, 3, "Quantum", preferredDir == 1 ? "LONG" : preferredDir == -1 ? "SHORT" : "NEUTRAL", preferredDir == 1 ? color.green : preferredDir == -1 ? color.red : color.gray, dashTextSize)
    f_addDashRow(dash, 4, "VWAP", close > vwapValue ? "ABOVE" : "BELOW", close > vwapValue ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 5, "RSI 14", str.tostring(rsiValue, "#.#"), rsiValue > 50 ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 6, "RSI 5m", str.tostring(rsi5m, "#.#"), rsi5m > 50 ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 7, "MACD", macdMain > macdSignal ? "BULL" : "BEAR", macdMain > macdSignal ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 8, "ADX", str.tostring(adxValue, "#.#"), adxValue > 25 ? color.green : color.gray, dashTextSize)
    f_addDashRow(dash, 9, "Score L/S", str.tostring(longScore, "#") + " / " + str.tostring(shortScore, "#"), longScore > shortScore ? color.green : shortScore > longScore ? color.red : color.gray, dashTextSize)
    f_addDashRow(dash, 10, "Signal", enterLong ? "BUY" : enterShort ? "SELL" : closeLongNow or closeShortNow ? "CLOSE" : "WAIT", enterLong ? color.green : enterShort ? color.red : closeLongNow or closeShortNow ? color.orange : color.gray, dashTextSize)
    f_addDashRow(dash, 11, "Position", inLong ? "LONG" : inShort ? "SHORT" : "FLAT", inLong ? color.green : inShort ? color.red : color.gray, dashTextSize)
    f_addDashRow(dash, 12, "ATR", str.tostring(atrValue, "#.##"), color.black, dashTextSize)
    f_addDashRow(dash, 13, "Open PnL", str.tostring(openPnl, "#.##"), openPnl >= 0 ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 14, "Net PnL", str.tostring(strategy.netprofit, "#.##"), strategy.netprofit >= 0 ? color.green : color.red, dashTextSize)
    f_addDashRow(dash, 15, "Trades", str.tostring(strategy.closedtrades), color.black, dashTextSize)
    f_addDashRow(dash, 16, "Win Rate", str.tostring(winRate, "#.#") + "%", winRate >= 50 ? color.green : color.red, dashTextSize)

// === Notes for live automation ===
// Create ONE TradingView alert on this strategy, message: {{strategy.order.alert_message}}
// Every entry/exit/close order then posts its Pionex JSON payload automatically.