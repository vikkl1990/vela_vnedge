//@version=6
indicator("Detrended Price Oscillator", "DPO", overlay = false, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
const string SETTINGS_GROUP = "Settings"
const string STYLE_GROUP    = "Style"

BULL_COLOR    = #089981 // oscillator above zero - price above its displaced average
BEAR_COLOR    = #f23645 // oscillator below zero - price below its displaced average
NEUTRAL_COLOR = #787b86 // zero line and the oscillator exactly at zero

FILL_LINE_TRANSP = 50  // gradient transparency at the oscillator
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero line
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput   = input.int(21, "Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Lookback of the simple moving average that price is detrended against. The comparison is displaced by Length / 2 + 1 bars")
srcInput      = input.source(close, "Source", group = SETTINGS_GROUP, tooltip = "Price series used in the detrending calculation")
centeredInput = input.bool(false, "Centered", group = SETTINGS_GROUP, tooltip = "When enabled the oscillator is shifted back by Length / 2 + 1 bars so it is centered on the prices it detrends. The most recent bars show no value")

dpoColorInput  = input.color(NEUTRAL_COLOR, "DPO", group = STYLE_GROUP, tooltip = "Color of the detrended price oscillator line when it sits exactly at zero. Above and below zero the line takes the bullish and bearish colors")
bullColorInput = input.color(BULL_COLOR, "Above Zero", inline = "state", group = STYLE_GROUP, tooltip = "Color of the line and fill while the oscillator is above zero")
bearColorInput = input.color(BEAR_COLOR, "Below Zero", inline = "state", group = STYLE_GROUP, tooltip = "Color of the line and fill while the oscillator is below zero")
zeroColorInput = input.color(NEUTRAL_COLOR, "Zero Line", group = STYLE_GROUP, tooltip = "Color of the zero reference line")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
barsBack = lengthInput / 2 + 1

priceSma = ta.sma(srcInput, lengthInput)

dpo = centeredInput ? srcInput[barsBack] - priceSma : srcInput - priceSma[barsBack]
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish above zero, bearish below, neutral exactly at zero
dpoColor = dpo > 0 ? bullColorInput : dpo < 0 ? bearColorInput : dpoColorInput

plotOffset = centeredInput ? -barsBack : 0

dpoPlotId  = plot(dpo, "DPO", dpoColor, offset = plotOffset)
zeroPlotId = plot(0, "Zero Anchor", color(na), offset = plotOffset, editable = false, display = display.none)

// Vertical gradient fill toward zero following the line color
fill(dpoPlotId, zeroPlotId, top_value = math.max(dpo, 0), bottom_value = math.min(dpo, 0), top_color = dpo > 0 ? color.new(dpoColor, FILL_LINE_TRANSP) : color.new(dpoColor, FILL_ZERO_TRANSP), bottom_color = dpo > 0 ? color.new(dpoColor, FILL_ZERO_TRANSP) : color.new(dpoColor, FILL_LINE_TRANSP), title = "DPO Gradient")

hline(0, "Zero Line", zeroColorInput, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossUp   = ta.crossover(dpo, 0)
crossDown = ta.crossunder(dpo, 0)

alertcondition(crossUp, "Bullish Zero Cross", "DPO crossed above zero")
alertcondition(crossDown, "Bearish Zero Cross", "DPO crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
