//@version=6
indicator("Linear Regression", "LinReg", overlay = false, format = format.price, max_lines_count = 3)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
MODE_CURVE   = "Curve"
MODE_SLOPE   = "Slope"
MODE_CHANNEL = "Channel"

BULL_COLOR    = #089981 // rising fit, lower channel band (support)
BEAR_COLOR    = #f23645 // falling fit, upper channel band (resistance)
NEUTRAL_COLOR = #787b86 // zero line, flat fit

FILL_LINE_TRANSP = 60  // slope gradient transparency at the slope line
FILL_ZERO_TRANSP = 100 // slope gradient transparency at the zero line

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
modeInput    = input.string(MODE_CURVE, "Mode", options = [MODE_CURVE, MODE_SLOPE, MODE_CHANNEL], group = "Settings", tooltip = "Curve plots the regression value on the price chart, Slope plots the per-bar slope of the fit in the pane, Channel draws the fitted line with parallel deviation bands over the last Length bars.")
lengthInput  = input.int(100, "Length", minval = 2, group = "Settings", tooltip = "Number of bars used to fit the linear regression.")
srcInput     = input.source(close, "Source", group = "Settings", tooltip = "Price series the regression is fitted to.")
devMultInput = input.float(2.0, "Deviation Multiplier", minval = 0, step = 0.1, group = "Settings", tooltip = "Channel band offset in standard deviations of price around the fitted line, also used by the band cross alerts.")

bullColorInput = input.color(BULL_COLOR, "Rising", inline = "slope", group = "Style", tooltip = "Color of the regression curve, slope line and channel base line while the fit slopes upward, and of the lower channel band.")
bearColorInput = input.color(BEAR_COLOR, "Falling", inline = "slope", group = "Style", tooltip = "Color of the regression curve, slope line and channel base line while the fit slopes downward, and of the upper channel band.")
lineColorInput = input.color(NEUTRAL_COLOR, "Regression Line", group = "Style", tooltip = "Color of the regression curve, slope line, and channel base line while the fit is flat.")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
curveValue = ta.linreg(srcInput, lengthInput, 0)
slopeValue = curveValue - ta.linreg(srcInput, lengthInput, 1)
startValue = ta.linreg(srcInput, lengthInput, lengthInput - 1)

// Residual standard deviation of the fit: total stdev scaled by sqrt(1 - r^2)
rValue     = nz(ta.correlation(bar_index, srcInput, lengthInput))
sigmaValue = ta.stdev(srcInput, lengthInput) * math.sqrt(math.max(1 - rValue * rValue, 0))

bandOffset = devMultInput * sigmaValue
upperBound = curveValue + bandOffset
lowerBound = curveValue - bandOffset

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
slopeColor = slopeValue > 0 ? bullColorInput : slopeValue < 0 ? bearColorInput : lineColorInput

plot(modeInput == MODE_CURVE ? curveValue : float(na), "Curve", slopeColor, 2, force_overlay = true)
slopePlotId = plot(modeInput == MODE_SLOPE ? slopeValue : float(na), "Slope", slopeColor, 2)
zeroPlotId  = plot(modeInput == MODE_SLOPE ? 0 : float(na), "Zero Anchor", color(na), editable = false, display = display.none)
fill(slopePlotId, zeroPlotId, top_value = slopeValue >= 0 ? slopeValue : 0, bottom_value = slopeValue >= 0 ? 0 : slopeValue, top_color = color.new(slopeColor, slopeValue >= 0 ? FILL_LINE_TRANSP : FILL_ZERO_TRANSP), bottom_color = color.new(slopeColor, slopeValue >= 0 ? FILL_ZERO_TRANSP : FILL_LINE_TRANSP), title = "Slope Gradient")
hline(0, "Zero Line", color.new(NEUTRAL_COLOR, 50), hline.style_dashed, display = modeInput == MODE_SLOPE ? display.all : display.none)

var line baseLineId  = na
var line upperLineId = na
var line lowerLineId = na

if barstate.islast and modeInput == MODE_CHANNEL and not na(startValue)
    if na(baseLineId)
        baseLineId  := line.new(na, na, na, na, color = lineColorInput, width = 2, force_overlay = true)
        upperLineId := line.new(na, na, na, na, color = bearColorInput, force_overlay = true)
        lowerLineId := line.new(na, na, na, na, color = bullColorInput, force_overlay = true)
    startIndex = bar_index - lengthInput + 1
    line.set_color(baseLineId, slopeColor)
    line.set_xy1(baseLineId, startIndex, startValue)
    line.set_xy2(baseLineId, bar_index, curveValue)
    line.set_xy1(upperLineId, startIndex, startValue + bandOffset)
    line.set_xy2(upperLineId, bar_index, upperBound)
    line.set_xy1(lowerLineId, startIndex, startValue - bandOffset)
    line.set_xy2(lowerLineId, bar_index, lowerBound)

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossAboveUpper = ta.crossover(srcInput, upperBound)
crossBelowLower = ta.crossunder(srcInput, lowerBound)

alertcondition(crossAboveUpper, "Upper Band Cross", "Source crossed above the upper Linear Regression channel band")
alertcondition(crossBelowLower, "Lower Band Cross", "Source crossed below the lower Linear Regression channel band")
//----------------------------------------------------------------------------------------------------------------------}
