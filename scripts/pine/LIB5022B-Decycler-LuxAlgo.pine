//@version=6
indicator("Decycler", "Decycler", overlay = false, format = format.price, precision = 3)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
DEC_GROUP   = "Decycler"
OSC_GROUP   = "Decycler Oscillator"
STYLE_GROUP = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput        = input.source(close, "Source", group = DEC_GROUP
  , tooltip = "Price series the decycler is computed on.")

cutoffInput     = input.int(60, "Cutoff Period", minval = 5, group = DEC_GROUP
  , tooltip = "High-pass cutoff period in bars. Cycle components with periods shorter than the cutoff are subtracted from price, leaving the trend and longer swings. Ehlers' examples commonly use 60 bars or more.")

showLineInput   = input.bool(true, "Show Decycler On Price Chart", group = DEC_GROUP
  , tooltip = "Plots the decycler over price as a low lag trend baseline acting as dynamic support/resistance. Price above a rising decycler is treated as an uptrend, price below a falling one as a downtrend, the line is colored accordingly.")

fastCutoffInput = input.int(30, "Fast Cutoff", minval = 5, group = OSC_GROUP
  , tooltip = "Cutoff period of the faster decycler. The oscillator is the fast decycler minus the slow one, plotted around zero as a trend-change indicator.")

slowCutoffInput = input.int(60, "Slow Cutoff", minval = 5, group = OSC_GROUP
  , tooltip = "Cutoff period of the slower decycler. Use a value larger than the fast cutoff so the difference oscillates around zero.")

percentInput    = input.bool(true, "As Percentage Of Price", group = OSC_GROUP
  , tooltip = "Expresses the oscillator as a percentage of the source price rather than in absolute price units, making its levels comparable across symbols and timeframes.")

bandInput       = input.float(0.5, "Signal Band Level", minval = 0, step = 0.05, group = OSC_GROUP
  , tooltip = "Symmetric signal band plotted around zero. Oscillator crossings of the band can act as stronger trend-change triggers than the zero cross alone. Expressed in oscillator units, adjust it when disabling the percentage mode. A value of 0 disables the band alerts.")

markersInput    = input.bool(false, "Show Trend Change Markers", group = OSC_GROUP
  , tooltip = "Displays markers on the zero line when the oscillator crosses it. Disabled by default, the matching alerts remain available either way.")

bullColorInput    = input.color(#089981, "Bullish", group = STYLE_GROUP)
bearColorInput    = input.color(#f23645, "Bearish", group = STYLE_GROUP)
neutralColorInput = input.color(color.gray, "Neutral", group = STYLE_GROUP)
bandColorInput    = input.color(color.gray, "Signal Band", group = STYLE_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Ehlers simple decycler: price minus a high-pass filter of price, which reduces to the one-pole recursion below.
// The filter coefficient is derived from the cutoff period, with the 360 / cutoff angle expressed in radians
decycler(float src, int cutoff) =>
    float angle = 2 * math.pi / cutoff
    float alpha = (math.cos(angle) + math.sin(angle) - 1) / math.cos(angle)
    float dec   = na
    dec := alpha / 2 * (src + nz(src[1], src)) + (1 - alpha) * nz(dec[1], src)
    dec

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Decycler trend baseline and the two differently tuned decyclers forming the oscillator
float dec     = decycler(srcInput, cutoffInput)
float decFast = decycler(srcInput, fastCutoffInput)
float decSlow = decycler(srcInput, slowCutoffInput)

//Decycler oscillator, difference between the fast and slow decyclers, optionally as a percentage of price
float oscDiff = decFast - decSlow
float osc     = percentInput ? (srcInput != 0 ? 100 * oscDiff / srcInput : 0) : oscDiff

//Trend state of the baseline, price above a rising decycler = uptrend, below a falling one = downtrend
bool decRising  = dec > nz(dec[1], dec)
bool decFalling = dec < nz(dec[1], dec)
int  trend      = srcInput > dec and decRising ? 1 : srcInput < dec and decFalling ? -1 : 0

//Events
bool bullTrendStart = trend == 1 and nz(trend[1]) != 1
bool bearTrendStart = trend == -1 and nz(trend[1]) != -1
bool oscCrossUp     = ta.crossover(osc, 0)
bool oscCrossDown   = ta.crossunder(osc, 0)
bool bandCrossUp    = ta.crossover(osc, bandInput)
bool bandCrossDown  = ta.crossunder(osc, -bandInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
color trendColor = trend == 1 ? bullColorInput : trend == -1 ? bearColorInput : neutralColorInput

//Decycler baseline drawn on the price chart
plot(showLineInput ? dec : na, "Decycler", trendColor, 2, force_overlay = true)

//Oscillator pane
oscPlotId  = plot(osc, "Decycler Oscillator", osc > 0 ? bullColorInput : bearColorInput)
zeroPlotId = plot(0, "Zero Line", color.new(chart.fg_color, 70))

fill(oscPlotId, zeroPlotId
  , math.max(osc, 0)
  , math.min(osc, 0)
  , osc > 0 ? color.new(bullColorInput, 50)  : color.new(bearColorInput, 100)
  , osc > 0 ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)
  , title = "Oscillator Gradient")

//Signal band
hline(bandInput, "Upper Signal Band", bandColorInput, hline.style_dashed)
hline(-bandInput, "Lower Signal Band", bandColorInput, hline.style_dashed)

//Optional zero cross markers, disabled by default
plotshape(markersInput and oscCrossUp ? 0 : na, "Bullish Zero Cross Marker", shape.circle, location.absolute, bullColorInput, size = size.tiny)
plotshape(markersInput and oscCrossDown ? 0 : na, "Bearish Zero Cross Marker", shape.circle, location.absolute, bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullTrendStart, "Uptrend Established", "Price is above a rising decycler, uptrend conditions established")
alertcondition(bearTrendStart, "Downtrend Established", "Price is below a falling decycler, downtrend conditions established")
alertcondition(oscCrossUp, "Oscillator Bullish Zero Cross", "Decycler oscillator crossed above the zero line")
alertcondition(oscCrossDown, "Oscillator Bearish Zero Cross", "Decycler oscillator crossed below the zero line")
alertcondition(bandCrossUp and bandInput > 0, "Oscillator Crossed Above Signal Band", "Decycler oscillator crossed above the upper signal band")
alertcondition(bandCrossDown and bandInput > 0, "Oscillator Crossed Below Signal Band", "Decycler oscillator crossed below the lower signal band")

//---------------------------------------------------------------------------------------------------------------------}
