//@version=5
indicator("Swing + Value Setup [Marcos]", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════
grp1 = "── EMAs ──"
ema21_len   = input.int(21,  "EMA Rápida",  group=grp1)
ema50_len   = input.int(50,  "EMA Media",   group=grp1)
ema200_len  = input.int(200, "EMA Lenta",   group=grp1)

grp2 = "── Supertrend ──"
st_factor   = input.float(3.0, "Factor ATR", step=0.1, group=grp2)
st_period   = input.int(10,    "Período ATR", group=grp2)

grp3 = "── RSI ──"
rsi_len     = input.int(14,  "Período RSI", group=grp3)
rsi_low     = input.int(40,  "RSI mínimo entrada", group=grp3)
rsi_high    = input.int(55,  "RSI máximo entrada", group=grp3)

grp4 = "── MACD ──"
macd_fast   = input.int(12, "MACD Rápida", group=grp4)
macd_slow   = input.int(26, "MACD Lenta",  group=grp4)
macd_signal = input.int(9,  "MACD Señal",  group=grp4)

grp5 = "── Volumen ──"
vol_ma_len  = input.int(20, "Media Volumen (días)", group=grp5)

grp6 = "── Visualización ──"
show_emas   = input.bool(true,  "Mostrar EMAs",       group=grp6)
show_labels = input.bool(true,  "Mostrar etiquetas",  group=grp6)
show_bg     = input.bool(true,  "Fondo en zona válida", group=grp6)

// ═══════════════════════════════════════════════
//  CÁLCULOS
// ═══════════════════════════════════════════════

// EMAs
ema21  = ta.ema(close, ema21_len)
ema50  = ta.ema(close, ema50_len)
ema200 = ta.ema(close, ema200_len)

// Supertrend
[st_line, st_dir] = ta.supertrend(st_factor, st_period)
bullish_st = st_dir < 0  // verde = alcista

// RSI
rsi = ta.rsi(close, rsi_len)
rsi_ok = rsi >= rsi_low and rsi <= rsi_high

// MACD
[macd_line, signal_line, hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)
macd_cross_up   = ta.crossover(macd_line, signal_line)
macd_below_zero = macd_line < 0
macd_hist_up    = hist > hist[1]  // histograma creciendo
macd_ok         = macd_cross_up or (macd_hist_up and macd_below_zero)

// Divergencia bullish RSI (mínimos más bajos en precio, más altos en RSI)
price_lower_low = low < low[5] and low[5] < low[10]
rsi_higher_low  = rsi > rsi[5] and rsi[5] > rsi[10]
rsi_divergence  = price_lower_low and rsi_higher_low

// OBV tendencia alcista
obv = ta.obv
obv_ma = ta.ema(obv, 20)
obv_ok = obv > obv_ma  // OBV sobre su media = acumulación

// Volumen en pullback (volumen decreciente = corrección sana)
vol_ma     = ta.sma(volume, vol_ma_len)
pullback_vol_ok = volume < vol_ma  // volumen bajo = pullback, no distribución

// Precio sobre EMA 200 (filtro alcista principal)
above_200 = close > ema200

// Pullback a zona de EMAs rápidas
near_ema21 = math.abs(close - ema21) / close * 100 < 1.5   // dentro del 1.5% de la EMA21
near_ema50 = math.abs(close - ema50) / close * 100 < 1.5   // dentro del 1.5% de la EMA50
near_ema   = near_ema21 or near_ema50

// ═══════════════════════════════════════════════
//  CONDICIÓN MAESTRA DE ENTRADA
// ═══════════════════════════════════════════════
//  TODAS deben cumplirse simultáneamente

entry_signal = above_200       // sobre EMA 200
             and bullish_st    // Supertrend alcista
             and rsi_ok        // RSI en zona 40-55
             and macd_ok       // MACD cruce o divergencia
             and obv_ok        // OBV acumulando
             and near_ema      // pullback a EMA 21 o 50

// Señal de alta convicción: además divergencia RSI + volumen bajo en pullback
strong_signal = entry_signal and rsi_divergence and pullback_vol_ok

// ═══════════════════════════════════════════════
//  VISUALIZACIÓN
// ═══════════════════════════════════════════════

// EMAs
plot(show_emas ? ema21  : na, "EMA 21",  color=color.new(color.lime,   0), linewidth=1)
plot(show_emas ? ema50  : na, "EMA 50",  color=color.new(color.yellow, 0), linewidth=1)
plot(show_emas ? ema200 : na, "EMA 200", color=color.new(color.red,    0), linewidth=2)

// Supertrend
plot(bullish_st ? st_line : na, "ST Alcista", color=color.new(color.teal, 0),  linewidth=2, style=plot.style_linebr)
plot(bullish_st ? na : st_line, "ST Bajista", color=color.new(color.red,  0),  linewidth=2, style=plot.style_linebr)

// Fondo verde suave cuando hay setup válido
bgcolor(show_bg and entry_signal ? color.new(color.green, 90) : na, title="Zona de setup")
bgcolor(show_bg and strong_signal ? color.new(color.green, 75) : na, title="Setup alta convicción")

// Etiquetas en vela de señal
if show_labels and strong_signal and not strong_signal[1]
    label.new(bar_index, low * 0.995,
         "🎯 SETUP\n⭐ ALTA CONV.",
         style=label.style_label_up,
         color=color.new(color.green, 0),
         textcolor=color.white,
         size=size.normal)

else if show_labels and entry_signal and not entry_signal[1]
    label.new(bar_index, low * 0.998,
         "✅ SETUP\nSWING/VALUE",
         style=label.style_label_up,
         color=color.new(color.teal, 20),
         textcolor=color.white,
         size=size.small)

// ═══════════════════════════════════════════════
//  PANEL DE ESTADO (tabla)
// ═══════════════════════════════════════════════
var table status_table = table.new(position.top_right, 2, 8,
     border_width=1,
     border_color=color.new(color.gray, 50),
     bgcolor=color.new(color.black, 60))

if barstate.islast
    ok_col   = color.new(color.green, 20)
    fail_col = color.new(color.red,   40)
    txt_col  = color.white

    table.cell(status_table, 0, 0, "CONDICIÓN",    text_color=color.gray, bgcolor=color.new(color.black,70))
    table.cell(status_table, 1, 0, "ESTADO",       text_color=color.gray, bgcolor=color.new(color.black,70))

    table.cell(status_table, 0, 1, "Precio > EMA200", text_color=txt_col)
    table.cell(status_table, 1, 1, above_200  ? "✅" : "❌", bgcolor=above_200  ? ok_col : fail_col, text_color=txt_col)

    table.cell(status_table, 0, 2, "Supertrend alcista", text_color=txt_col)
    table.cell(status_table, 1, 2, bullish_st ? "✅" : "❌", bgcolor=bullish_st ? ok_col : fail_col, text_color=txt_col)

    table.cell(status_table, 0, 3, "RSI 40–55", text_color=txt_col)
    table.cell(status_table, 1, 3, rsi_ok     ? "✅" : "❌", bgcolor=rsi_ok     ? ok_col : fail_col, text_color=txt_col)

    table.cell(status_table, 0, 4, "MACD señal", text_color=txt_col)
    table.cell(status_table, 1, 4, macd_ok    ? "✅" : "❌", bgcolor=macd_ok    ? ok_col : fail_col, text_color=txt_col)

    table.cell(status_table, 0, 5, "OBV acumulando", text_color=txt_col)
    table.cell(status_table, 1, 5, obv_ok     ? "✅" : "❌", bgcolor=obv_ok     ? ok_col : fail_col, text_color=txt_col)

    table.cell(status_table, 0, 6, "Pullback EMA21/50", text_color=txt_col)
    table.cell(status_table, 1, 6, near_ema   ? "✅" : "❌", bgcolor=near_ema   ? ok_col : fail_col, text_color=txt_col)

    table.cell(status_table, 0, 7, "Div. RSI bullish", text_color=txt_col)
    table.cell(status_table, 1, 7, rsi_divergence ? "⭐" : "—", bgcolor=rsi_divergence ? ok_col : color.new(color.gray,70), text_color=txt_col)

// ═══════════════════════════════════════════════
//  ALERTAS
// ═══════════════════════════════════════════════
alertcondition(entry_signal  and not entry_signal[1],  "Setup Swing/Value",         "✅ Setup Swing+Value detectado — revisar entrada")
alertcondition(strong_signal and not strong_signal[1], "Setup ALTA CONVICCIÓN ⭐",   "🎯 Setup de alta convicción — todas las condiciones OK")
alertcondition(rsi_divergence and above_200 and bullish_st, "Divergencia RSI Bullish", "📊 Divergencia bullish RSI en tendencia alcista")
