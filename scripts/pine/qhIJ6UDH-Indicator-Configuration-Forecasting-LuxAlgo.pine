//@version=6
indicator("Indicator Configuration Forecasting [LuxAlgo]", "LuxAlgo - Indicator Configuration Forecasting", overlay = true, max_bars_back = 5000, max_polylines_count = 100, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
// Table Colors
DATA                    = #DBDBDB
HEADERS                 = #808080
BACKGROUND              = #161616
BORDERS                 = #2E2E2E

// Table Positions
TOP_RIGHT               = 'Top Right'
BOTTOM_RIGHT            = 'Bottom Right'
BOTTOM_LEFT             = 'Bottom Left'

// Table Sizes
TINY                    = 'Tiny'
SMALL                   = 'Small'
NORMAL                  = 'Normal'
LARGE                   = 'Large'
HUGE                    = 'Huge'

// Palette
GREEN                   = #089981
RED                     = #f23645
BLUE_MATCH              = #5b9cf6
GRAY                    = #808080

MAX_HIST                = 5000
//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
K_GROUP                 = 'Parameters'
kInput                  = input.int(10, "Top K Neighbors", minval = 1, maxval = 50, group = K_GROUP, tooltip = "Number of similar historical configurations to consider.")
nInput                  = input.int(20, "Forecast Horizon (N)", minval = 1, maxval = 100, group = K_GROUP, tooltip = "Number of bars to forecast into the future.")
lookbackInput           = input.int(2000, "Historical Lookback", minval = 100, maxval = 4900, group = K_GROUP, tooltip = "How many bars back to search for similarities.")

CONFIG_GROUP            = 'Indicator Configuration'
// RSI
useRsiInput             = input.bool(true,  "RSI",                group = CONFIG_GROUP, inline = "rsi", tooltip = "1 if RSI > 70, -1 if RSI < 30, 0 otherwise.")
rsiLenInput             = input.int(14,     "Length",             group = CONFIG_GROUP, inline = "rsi", minval = 1)
// SMA
useSmaInput             = input.bool(true,  "SMA Cross",          group = CONFIG_GROUP, inline = "sma", tooltip = "1 if Fast SMA > Slow SMA, -1 otherwise.")
smaFastInput            = input.int(50,     "Fast",               group = CONFIG_GROUP, inline = "sma", minval = 1)
smaSlowInput            = input.int(200,    "Slow",               group = CONFIG_GROUP, inline = "sma", minval = 1)
// Supertrend
useStInput              = input.bool(true,  "Supertrend",         group = CONFIG_GROUP, inline = "st", tooltip = "1 if Supertrend is Bullish, -1 if Bearish.")
stFactorInput           = input.float(3.0,  "Factor",             group = CONFIG_GROUP, inline = "st", step = 0.1)
stPeriodInput           = input.int(10,     "Period",             group = CONFIG_GROUP, inline = "st", minval = 1)
// MACD
useMacdInput            = input.bool(true,  "MACD",               group = CONFIG_GROUP, inline = "macd", tooltip = "1 if MACD Line > Signal Line, -1 otherwise.")
macdFastInput           = input.int(12,     "Fast",               group = CONFIG_GROUP, inline = "macd", minval = 1)
macdSlowInput           = input.int(26,     "Slow",               group = CONFIG_GROUP, inline = "macd", minval = 1)
macdSignalInput         = input.int(9,      "Signal",             group = CONFIG_GROUP, inline = "macd", minval = 1)
// ADX
useAdxInput             = input.bool(true,  "ADX",                group = CONFIG_GROUP, inline = "adx", tooltip = "1 if ADX > Threshold, 0 otherwise.")
adxLenInput             = input.int(14,     "Length",             group = CONFIG_GROUP, inline = "adx", minval = 1)
adxThresholdInput       = input.int(25,     "Thresh",             group = CONFIG_GROUP, inline = "adx")
// BB
useBbInput              = input.bool(false, "Bollinger Bands",    group = CONFIG_GROUP, inline = "bb", tooltip = "1 if Close > Upper Band, -1 if Close < Lower Band, 0 otherwise.")
bbLenInput              = input.int(20,     "Length",             group = CONFIG_GROUP, inline = "bb", minval = 1)
bbMultInput             = input.float(2.0,  "StdDev",             group = CONFIG_GROUP, inline = "bb", step = 0.1)
// Stoch RSI
useStochRsiInput        = input.bool(false, "Stoch RSI",          group = CONFIG_GROUP, inline = "srsi", tooltip = "1 if %K > 80, -1 if %K < 20, 0 otherwise.")
srsiLenInput            = input.int(14,     "Length",             group = CONFIG_GROUP, inline = "srsi", minval = 1)
srsiKInput              = input.int(3,      "K",                  group = CONFIG_GROUP, inline = "srsi", minval = 1)
// EMA
useEmaInput             = input.bool(false, "EMA Cross",          group = CONFIG_GROUP, inline = "ema", tooltip = "1 if Fast EMA > Slow EMA, -1 otherwise.")
emaFastInput            = input.int(9,      "Fast",               group = CONFIG_GROUP, inline = "ema", minval = 1)
emaSlowInput            = input.int(21,     "Slow",               group = CONFIG_GROUP, inline = "ema", minval = 1)
// PSAR
usePsarInput            = input.bool(false, "PSAR",               group = CONFIG_GROUP, inline = "psar", tooltip = "1 if Close > PSAR, -1 otherwise.")
psarStartInput          = input.float(0.02, "Start",              group = CONFIG_GROUP, inline = "psar", step = 0.01)
psarIncInput            = input.float(0.02, "Inc",                group = CONFIG_GROUP, inline = "psar", step = 0.01)
psarMaxInput            = input.float(0.2,  "Max",                group = CONFIG_GROUP, inline = "psar", step = 0.1)
// CCI
useCciInput             = input.bool(false, "CCI",                group = CONFIG_GROUP, inline = "cci", tooltip = "1 if CCI > Threshold, -1 if CCI < -Threshold, 0 otherwise.")
cciLenInput             = input.int(20,     "Length",             group = CONFIG_GROUP, inline = "cci", minval = 1)
cciThresholdInput       = input.int(100,    "Thresh",             group = CONFIG_GROUP, inline = "cci")

VIS_GROUP               = 'Visibility'
showPathsInput          = input.bool(true, "Show Individual Match Paths", group = VIS_GROUP, tooltip = "Draw the historical path of each match found.")

STYLE_GROUP             = 'Style Settings'
medianColorInput        = input.color(GRAY, "Median Forecast Color", group = STYLE_GROUP)
upperColorInput         = input.color(GREEN, "Upper Bound Color (75th)", group = STYLE_GROUP)
lowerColorInput         = input.color(RED, "Lower Bound Color (25th)", group = STYLE_GROUP)
pathColorInput          = input.color(BLUE_MATCH, "Match Path Color", group = STYLE_GROUP)
fillTranspInput         = input.int(80, "Fill Transparency", minval = 0, maxval = 100, group = STYLE_GROUP)

DASHBOARD_GROUP         = 'Dashboard'
dashboardInput          = input.bool(true, 'Dashboard', group = DASHBOARD_GROUP, tooltip = 'Enable or disable the dashboard.')
dashboardPositionInput  = input.string(TOP_RIGHT, 'Position', group = DASHBOARD_GROUP, tooltip = 'Select the dashboard location.', options = [TOP_RIGHT, BOTTOM_RIGHT, BOTTOM_LEFT])
dashboardSizeInput      = input.string(SMALL, 'Size', group = DASHBOARD_GROUP, tooltip = 'Select the dashboard size.', options = [TINY, SMALL, NORMAL, LARGE, HUGE])
//---------------------------------------------------------------------------------------------------------------------}
// Functions / Methods
//---------------------------------------------------------------------------------------------------------------------{
// Parse table position
var parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT       => position.top_right
    BOTTOM_RIGHT    => position.bottom_right
    BOTTOM_LEFT     => position.bottom_left

// Parse table size
var parsedDashboardSize = switch dashboardSizeInput
    TINY            => size.tiny
    SMALL           => size.small
    NORMAL          => size.normal
    LARGE           => size.large
    HUGE            => size.huge

// Helper function to create cells
cell(table t_able, int column, int row, string data, color = #FFFFFF, align = text.align_right, color background = na, float height = 0) => 
    t_able.cell(column, row, data, text_color = color, text_size = parsedDashboardSize, text_halign = align, bgcolor = background, height = height)

// Helper function to create dividers
divider(table t_able, int row, int lastColumn) =>    
    string rowDivider = '━━━━━━━━━━━━━━━━━━━━'
    t_able.merge_cells(0, row, lastColumn, row)
    cell(t_able, 0, row, rowDivider, align = text.align_center, height = 0.5, color = BORDERS)
//---------------------------------------------------------------------------------------------------------------------}
// Indicators & State Encoding
//---------------------------------------------------------------------------------------------------------------------{
// RSI
rsiVal = ta.rsi(close, rsiLenInput)
rsiState = rsiVal > 70 ? 1 : rsiVal < 30 ? -1 : 0

// SMA Cross
smaFast = ta.sma(close, smaFastInput)
smaSlow = ta.sma(close, smaSlowInput)
smaState = smaFast > smaSlow ? 1 : -1

// Supertrend
[_, stDir] = ta.supertrend(stFactorInput, stPeriodInput)
stState = stDir < 0 ? 1 : -1

// MACD
[macdLine, signalLine, _] = ta.macd(close, macdFastInput, macdSlowInput, macdSignalInput)
macdState = macdLine > signalLine ? 1 : -1

// ADX
[_, _, adxVal] = ta.dmi(adxLenInput, adxLenInput)
adxState = adxVal > adxThresholdInput ? 1 : 0

// BB
[bbM, bbU, bbL] = ta.bb(close, bbLenInput, bbMultInput)
bbState = close > bbU ? 1 : close < bbL ? -1 : 0

// Stoch RSI
stochRsiVal = ta.rsi(close, srsiLenInput)
stochK = ta.sma(ta.stoch(stochRsiVal, stochRsiVal, stochRsiVal, srsiLenInput), srsiKInput)
stochRsiState = stochK > 80 ? 1 : stochK < 20 ? -1 : 0

// EMA Cross
emaFast = ta.ema(close, emaFastInput)
emaSlow = ta.ema(close, emaSlowInput)
emaState = emaFast > emaSlow ? 1 : -1

// PSAR
psarVal = ta.sar(psarStartInput, psarIncInput, psarMaxInput)
psarState = close > psarVal ? 1 : -1

// CCI
cciVal = ta.cci(close, cciLenInput)
cciState = cciVal > cciThresholdInput ? 1 : cciVal < -cciThresholdInput ? -1 : 0

// Store states in arrays
var rsiH   = array.new_int()
var smaH   = array.new_int()
var stH    = array.new_int()
var macdH  = array.new_int()
var adxH   = array.new_int()
var bbH    = array.new_int()
var srsiH  = array.new_int()
var emaH   = array.new_int()
var psarH  = array.new_int()
var cciH   = array.new_int()
var closeH = array.new_float()

// Update history
array.push(rsiH, rsiState), array.push(smaH, smaState), array.push(stH, stState), array.push(macdH, macdState), array.push(adxH, adxState)
array.push(bbH, bbState), array.push(srsiH, stochRsiState), array.push(emaH, emaState), array.push(psarH, psarState), array.push(cciH, cciState)
array.push(closeH, close)

if array.size(closeH) > MAX_HIST
    array.shift(rsiH), array.shift(smaH), array.shift(stH), array.shift(macdH), array.shift(adxH)
    array.shift(bbH), array.shift(srsiH), array.shift(emaH), array.shift(psarH), array.shift(cciH)
    array.shift(closeH)

// Drawing cleanup arrays
var polylines = array.new<polyline>()
var labels    = array.new<label>()
//---------------------------------------------------------------------------------------------------------------------}
// Similarity Search & Forecasting
//---------------------------------------------------------------------------------------------------------------------{
if barstate.islast
    // Cleanup
    if array.size(polylines) > 0
        for p in polylines
            p.delete()
        array.clear(polylines)

    if array.size(labels) > 0
        for lb in labels
            lb.delete()
        array.clear(labels)

    int totalBars = array.size(closeH)
    int searchLimit = math.min(totalBars - nInput - 1, lookbackInput)
    
    // Similarity Search
    float[] distances = array.new_float(0)
    int[] indices = array.new_int(0)

    for i = nInput to searchLimit
        int idx = totalBars - 1 - i
        float dist = 0.0
        
        if useRsiInput      
            dist += math.abs(rsiState - array.get(rsiH, idx))
        if useSmaInput      
            dist += math.abs(smaState - array.get(smaH, idx))
        if useStInput       
            dist += math.abs(stState - array.get(stH, idx))
        if useMacdInput     
            dist += math.abs(macdState - array.get(macdH, idx))
        if useAdxInput      
            dist += math.abs(adxState - array.get(adxH, idx))
        if useBbInput       
            dist += math.abs(bbState - array.get(bbH, idx))
        if useStochRsiInput 
            dist += math.abs(stochRsiState - array.get(srsiH, idx))
        if useEmaInput      
            dist += math.abs(emaState - array.get(emaH, idx))
        if usePsarInput     
            dist += math.abs(psarState - array.get(psarH, idx))
        if useCciInput      
            dist += math.abs(cciState - array.get(cciH, idx))
            
        array.push(distances, dist)
        array.push(indices, idx)

    // Find Top K
    int[] topKIndices = array.new_int(0)
    if array.size(distances) > 0
        for k = 1 to array.size(distances)
            if array.size(topKIndices) >= kInput
                break

            float minDist = 1e10
            int minIdx = -1, int minPos = -1
            for j = 0 to array.size(distances) - 1
                float d = array.get(distances, j)
                if d < minDist
                    minDist := d
                    minIdx := array.get(indices, j)
                    minPos := j
            
            if minIdx != -1
                bool overlaps = false
                for pickedIdx in topKIndices
                    if math.abs(minIdx - pickedIdx) < nInput
                        overlaps := true
                        break
                if not overlaps
                    array.push(topKIndices, minIdx)
                array.set(distances, minPos, 1e11)

    // Statistics
    int kCount = array.size(topKIndices)
    matrix<float> returnsMatrix = matrix.new<float>(kCount, nInput)
    for row = 0 to kCount - 1
        int matchIdx = array.get(topKIndices, row)
        float basePrice = array.get(closeH, matchIdx)
        for col = 1 to nInput
            matrix.set(returnsMatrix, row, col - 1, (array.get(closeH, matchIdx + col) - basePrice) / basePrice)

    float[] medianReturns = array.new_float(0), float[] upperReturns = array.new_float(0), float[] lowerReturns = array.new_float(0)
    for col = 0 to nInput - 1
        float[] colVal = matrix.col(returnsMatrix, col)
        array.push(medianReturns, array.median(colVal))
        array.push(upperReturns,  array.percentile_linear_interpolation(colVal, 75))
        array.push(lowerReturns,  array.percentile_linear_interpolation(colVal, 25))

    // Drawing
    for row = 0 to kCount - 1
        int matchIdx = array.get(topKIndices, row)
        int matchBarIdx = bar_index - (totalBars - 1) + matchIdx
        float basePrice = array.get(closeH, matchIdx)

        array.push(labels, label.new(matchBarIdx, basePrice, "Match", color = BLUE_MATCH, style = label.style_label_down, textcolor = color.white, size = size.tiny))

        if showPathsInput
            array<chart.point> pathPoints = array.new<chart.point>()
            for col = 0 to nInput
                array.push(pathPoints, chart.point.from_index(matchBarIdx + col, array.get(closeH, matchIdx + col)))
            array.push(polylines, polyline.new(pathPoints, line_color = pathColorInput, line_width = 1))

    // Forecast Polylines
    array<chart.point> medianPoints = array.new<chart.point>(0), array<chart.point> upperPoints = array.new<chart.point>(0), array<chart.point> lowerPoints = array.new<chart.point>(0)
    array.push(medianPoints, chart.point.now(close)), array.push(upperPoints, chart.point.now(close)), array.push(lowerPoints, chart.point.now(close))
    for t = 0 to nInput - 1
        int x = bar_index + t + 1
        array.push(medianPoints, chart.point.from_index(x, close * (1 + array.get(medianReturns, t))))
        array.push(upperPoints,  chart.point.from_index(x, close * (1 + array.get(upperReturns, t))))
        array.push(lowerPoints,  chart.point.from_index(x, close * (1 + array.get(lowerReturns, t))))

    array<chart.point> greenFill = array.copy(upperPoints), array<chart.point> redFill = array.copy(medianPoints)
    for t = nInput to 0
        array.push(greenFill, array.get(medianPoints, t)), array.push(redFill, array.get(lowerPoints, t))
    
    array.push(polylines, polyline.new(greenFill, line_color = na, fill_color = color.new(upperColorInput, fillTranspInput), closed = true))
    array.push(polylines, polyline.new(redFill,   line_color = na, fill_color = color.new(lowerColorInput, fillTranspInput), closed = true))
    array.push(polylines, polyline.new(medianPoints, line_color = medianColorInput, line_width = 1, line_style = line.style_dashed))
    array.push(polylines, polyline.new(upperPoints,  line_color = upperColorInput,  line_width = 1, line_style = line.style_dashed))
    array.push(polylines, polyline.new(lowerPoints,  line_color = lowerColorInput,  line_width = 1, line_style = line.style_dashed))

    // Dashboard
    if dashboardInput
        var table t = table.new(parsedDashboardPosition, 2, 7, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1)
        t.merge_cells(0, 0, 1, 0), cell(t, 0, 0, 'Forecast Info', color = DATA, align = text.align_center)
        divider(t, 1, 1), cell(t, 0, 2, 'Matches Found', color = HEADERS, align = text.align_left), cell(t, 1, 2, str.tostring(kCount), color = DATA)
        divider(t, 3, 1), cell(t, 0, 4, 'Horizon (N)', color = HEADERS, align = text.align_left), cell(t, 1, 4, str.tostring(nInput), color = DATA)
        divider(t, 5, 1), cell(t, 0, 6, 'Confidence', color = HEADERS, align = text.align_left), cell(t, 1, 6, '25th-75th %', color = DATA)

//---------------------------------------------------------------------------------------------------------------------}
