//@version=6
indicator("Standard-deviation Channel Width"
  , shorttitle = "Standard-deviation Channel Width"
  , overlay    = false
  , format     = format.price
  , precision  = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

BULL_COLOR        = #089981 // width below its own average - an orderly, tightening trend
BEAR_COLOR        = #f23645 // width above its own average - a loosening trend
NEUTRAL_COLOR     = #787b86 // structure - the average, the price-chart channel
COMPRESSION_COLOR = #ff9800 // the one accent - the compression screen

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

int FULL_TRANSP  = 100
int HALF_TRANSP  = 50
int LEVEL_TRANSP = 50
int MID_TRANSP   = 40
int BG_TRANSP    = 88

string MODE_NORM = "Normalized (% of midline)"
string MODE_ABS  = "Absolute (price units)"
string DIV_N     = "n"
string DIV_N2    = "n - 2"

string GRP_CHANNEL = "Channel"
string GRP_WIDTH   = "Width Reading"
string GRP_CHART   = "Price Chart"
string GRP_DASH    = "Dashboard"
string GRP_STYLE   = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

lengthInput = input.int(100, "Regression Length"
  , minval  = 5
  , maxval  = 500
  , group   = GRP_CHANNEL
  , tooltip = "Lookback n, in bars, of the least-squares regression the channel is fitted over. 100 is the common default. Both the fit and the residuals are window-dependent, so width readings are only comparable at a fixed lookback: a short window hugs recent action and prints narrow, a long one straddles multiple swings and prints wide.")

sourceInput = input.source(close, "Source"
  , group   = GRP_CHANNEL
  , tooltip = "Series the regression is fitted on, usually the close.")

multiplierInput = input.float(2.0, "Deviation Multiplier"
  , minval  = 0.1
  , step    = 0.25
  , group   = GRP_CHANNEL
  , tooltip = "Multiple k of the residual standard deviation offsetting each rail from the fitted line. Two standard deviations is the common default, containing most of the window's price action when residuals are roughly normal. It scales the width linearly, so keeping it constant matters more than its exact value.")

divisorInput = input.string(DIV_N, "Deviation Divisor"
  , options = [DIV_N, DIV_N2]
  , group   = GRP_CHANNEL
  , tooltip = "Divisor of the summed squared residuals. n is the population form most charting platforms compute; some platforms divide by n - 2 (the regression degrees of freedom), which reads slightly wider. Values differ only slightly on common lookbacks.")

modeInput = input.string(MODE_NORM, "Display Mode"
  , options = [MODE_NORM, MODE_ABS]
  , group   = GRP_WIDTH
  , tooltip = "Normalized quotes the rail-to-rail width as a percent of the regression midline, keeping the reading meaningful across instruments and over long histories. Absolute quotes it in price units, the form used to scale stops and targets to the trend's typical noise.")

avgLengthInput = input.int(100, "Average Length"
  , minval  = 1
  , group   = GRP_WIDTH
  , tooltip = "Lookback of the simple moving average applied to the width, the reference for comparing the current reading to its own history. Width below its average marks an orderly, efficient trend; width above it marks a trend that is loosening.")

showAvgInput = input.bool(true, "Show Average"
  , group   = GRP_WIDTH
  , tooltip = "Plot the width's own-history average as a reference line in the pane.")

compressionInput = input.float(0.5, "Compression Threshold"
  , minval  = 0.05
  , maxval  = 1.0
  , step    = 0.05
  , group   = GRP_WIDTH
  , tooltip = "Fraction of the width average below which the channel counts as unusually narrow. Readings under this level flag coiled, tightly ordered trends - the compression screen use of the width.")

highlightInput = input.bool(true, "Highlight Compression"
  , group   = GRP_WIDTH
  , tooltip = "Draw the compression threshold level and tint the pane background while the width holds below it.")

trajectoryInput = input.int(5, "Trajectory Lookback"
  , minval  = 1
  , group   = GRP_WIDTH
  , tooltip = "Bars back the current width is compared against to call its trajectory widening or narrowing in the dashboard. Narrowing shows an increasingly orderly trend; widening warns the trend is getting sloppy.")

showChannelInput = input.bool(false, "Show Regression Channel"
  , group   = GRP_CHART
  , tooltip = "Draw the current window's regression channel (fitted line and rails at k standard deviations) on the price chart for context. The whole fit is recomputed each bar, so this drawing repaints as the window rolls forward.")

showDashInput = input.bool(true, "Show Dashboard"
  , group   = GRP_DASH
  , tooltip = "Display a panel with the current width in price units and percent of midline, the reading relative to its own average, and its trajectory.")

dashLocInput = input.string("Top Right", "Location"
  , options = ["Top Right", "Top Left", "Middle Right", "Middle Left", "Bottom Right", "Bottom Left"]
  , group   = GRP_DASH
  , tooltip = "Dashboard position on the chart.")

dashSizeInput = input.string("Small", "Size"
  , options = ["Tiny", "Small", "Normal"]
  , group   = GRP_DASH
  , tooltip = "Dashboard text size.")

tightColorInput     = input.color(BULL_COLOR, "Tightening", group = GRP_STYLE, inline = "clr0", tooltip = "Color of the width line and gradient while the reading holds below its own-history average - an orderly, efficient trend.")
looseColorInput     = input.color(BEAR_COLOR, "Loosening", group = GRP_STYLE, inline = "clr0", tooltip = "Color of the width line and gradient while the reading holds above its own-history average - a trend getting sloppy.")
avgColorInput       = input.color(NEUTRAL_COLOR, "Average", group = GRP_STYLE, inline = "clr1")
thresholdColorInput = input.color(COMPRESSION_COLOR, "Compression", group = GRP_STYLE, inline = "clr1")
channelColorInput   = input.color(NEUTRAL_COLOR, "Channel", group = GRP_STYLE, inline = "clr2")

gradientInput = input.bool(true, "Gradient Fill"
  , group   = GRP_STYLE
  , tooltip = "Shade the area between zero and the width with a vertical gradient.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// Format a width reading in price units for the dashboard
formatPrice(float value) =>
    na(value) ? "n/a" : str.tostring(value, format.mintick)

// Format a normalized width reading in percent for the dashboard
formatPercent(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.##") + "%"

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{

int regressionLength = lengthInput

// Rolling moments feeding the least-squares fit y_i = a + b * i over the last n bars (i = 0 at the window start)
float smaValue    = ta.sma(sourceInput, regressionLength)
float wmaValue    = ta.wma(sourceInput, regressionLength)
float meanSquares = ta.sma(sourceInput * sourceInput, regressionLength)

// Closed-form fit: slope b = 6 * (WMA - SMA) / (n - 1), endpoint a + b * (n - 1) = 3 * WMA - 2 * SMA
float slopeValue     = 6.0 * (wmaValue - smaValue) / math.max(regressionLength - 1, 1)
float midlineValue   = 3.0 * wmaValue - 2.0 * smaValue
float interceptValue = midlineValue - slopeValue * (regressionLength - 1)

// Residual dispersion: sum(resid_i^2) / n = Var(y) - b^2 * Var(x), with Var(x) = (n^2 - 1) / 12 for i = 0..n-1
float sourceVariance = math.max(meanSquares - smaValue * smaValue, 0.0)
float axisVariance   = (regressionLength * regressionLength - 1) / 12.0
float residualMeanSq = math.max(sourceVariance - slopeValue * slopeValue * axisVariance, 0.0)

// sd = sqrt(sum(resid_i^2) / n), or the n - 2 divisor variant some platforms compute
float sdValue = divisorInput == DIV_N
  ? math.sqrt(residualMeanSq)
  : math.sqrt(residualMeanSq * regressionLength / math.max(regressionLength - 2, 1))

// Width = 2 * k * sd (rail to rail), NormWidth = 100 * Width / Mid (percent of the midline, guarded for non-positive fits)
float widthValue     = 2.0 * multiplierInput * sdValue
float normWidthValue = midlineValue != 0 ? 100.0 * widthValue / math.abs(midlineValue) : na

float displayValue = modeInput == MODE_NORM ? normWidthValue : widthValue

// Own-history reference: the width's rolling average and the compression level derived from it
float widthAverage     = ta.sma(displayValue, avgLengthInput)
float compressionLevel = compressionInput * widthAverage

bool isCompressed = not na(displayValue) and not na(compressionLevel) and displayValue < compressionLevel

// Trajectory of the reading: widening (trend loosening) versus narrowing (trend tightening)
float trajectoryChange = displayValue - displayValue[trajectoryInput]

bool crossAboveAverage = ta.crossover(displayValue, widthAverage)
bool crossBelowAverage = ta.crossunder(displayValue, widthAverage)
bool compressionStart  = ta.crossunder(displayValue, compressionLevel)
bool compressionEnd    = ta.crossover(displayValue, compressionLevel)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

// State coloring - tightening below the own-history average, loosening above it
color widthColor = na(displayValue) or na(widthAverage) ? NEUTRAL_COLOR : displayValue < widthAverage ? tightColorInput : looseColorInput

zeroPlotId  = plot(0, "Zero Baseline", color(na), editable = false, display = display.none)
widthPlotId = plot(displayValue, "Channel Width", widthColor, 1)

plot(showAvgInput ? widthAverage : na, "Width Average", avgColorInput, 1, plot.style_circles)
plot(highlightInput ? compressionLevel : na, "Compression Threshold", color.new(thresholdColorInput, LEVEL_TRANSP), 1)

fill(zeroPlotId, widthPlotId
  , top_value    = displayValue
  , bottom_value = 0.0
  , top_color    = gradientInput ? color.new(widthColor, HALF_TRANSP) : color(na)
  , bottom_color = gradientInput ? color.new(widthColor, FULL_TRANSP) : color(na)
  , title        = "Width Gradient")

bgcolor(highlightInput and isCompressed ? color.new(thresholdColorInput, BG_TRANSP) : color(na), title = "Compression Highlight")

// Data-window twins of the displayed reading, so both quotes stay inspectable in either mode
plot(widthValue, "Width (price units)", color(na), editable = false, display = display.data_window)
plot(normWidthValue, "Width (% of midline)", color(na), editable = false, display = display.data_window)
plot(slopeValue, "Regression Slope", color(na), editable = false, display = display.data_window)

// Current-window regression channel on the price chart: rails a constant k * sd above and below the fitted line
var line channelUpperId = line.new(0, 0.0, 1, 0.0, color = showChannelInput ? channelColorInput : color(na), width = 1, force_overlay = true)
var line channelMidId   = line.new(0, 0.0, 1, 0.0, color = showChannelInput ? color.new(channelColorInput, MID_TRANSP) : color(na), style = line.style_dotted, force_overlay = true)
var line channelLowerId = line.new(0, 0.0, 1, 0.0, color = showChannelInput ? channelColorInput : color(na), width = 1, force_overlay = true)

if showChannelInput and barstate.islast and not na(midlineValue) and not na(sdValue)
    int   windowStart = math.max(bar_index - (regressionLength - 1), 0)
    float railOffset  = multiplierInput * sdValue

    line.set_xy1(channelUpperId, windowStart, interceptValue + railOffset)
    line.set_xy2(channelUpperId, bar_index, midlineValue + railOffset)
    line.set_xy1(channelMidId, windowStart, interceptValue)
    line.set_xy2(channelMidId, bar_index, midlineValue)
    line.set_xy1(channelLowerId, windowStart, interceptValue - railOffset)
    line.set_xy2(channelLowerId, bar_index, midlineValue - railOffset)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{

dashLocation = switch dashLocInput
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Middle Right" => position.middle_right
    "Middle Left"  => position.middle_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

dashTextSize = switch dashSizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    => size.normal

if showDashInput and barstate.islast
    var table dashTable = table.new(dashLocation, 2, 5, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

    float averageRatio = not na(displayValue) and not na(widthAverage) and widthAverage != 0 ? displayValue / widthAverage : na

    string ratioText = na(averageRatio) ? "n/a" : str.tostring(averageRatio, "#.##") + "x" + (isCompressed ? " (compressed)" : "")
    string trajText  = na(trajectoryChange) ? "n/a" : trajectoryChange > 0 ? "Widening" : trajectoryChange < 0 ? "Narrowing" : "Flat"

    color ratioColor = isCompressed ? thresholdColorInput : na(averageRatio) ? DASH_TEXT : averageRatio < 1 ? tightColorInput : looseColorInput
    color trajColor  = na(trajectoryChange) ? DASH_TEXT : trajectoryChange > 0 ? looseColorInput : trajectoryChange < 0 ? tightColorInput : NEUTRAL_COLOR

    table.cell(dashTable, 0, 0, "Channel Width", text_color = DASH_TEXT, text_halign = text.align_left, text_size = dashTextSize)
    table.cell(dashTable, 1, 0, "n = " + str.tostring(lengthInput) + ", k = " + str.tostring(multiplierInput), text_color = DASH_HEADER, text_halign = text.align_right, text_size = dashTextSize)

    table.cell(dashTable, 0, 1, "Width", text_color = DASH_HEADER, text_halign = text.align_left, text_size = dashTextSize)
    table.cell(dashTable, 1, 1, formatPrice(widthValue), text_color = DASH_TEXT, text_halign = text.align_right, text_size = dashTextSize)

    table.cell(dashTable, 0, 2, "% Of Midline", text_color = DASH_HEADER, text_halign = text.align_left, text_size = dashTextSize)
    table.cell(dashTable, 1, 2, formatPercent(normWidthValue), text_color = DASH_TEXT, text_halign = text.align_right, text_size = dashTextSize)

    table.cell(dashTable, 0, 3, "vs Average (" + str.tostring(avgLengthInput) + ")", text_color = DASH_HEADER, text_halign = text.align_left, text_size = dashTextSize)
    table.cell(dashTable, 1, 3, ratioText, text_color = ratioColor, text_halign = text.align_right, text_size = dashTextSize)

    table.cell(dashTable, 0, 4, "Trajectory", text_color = DASH_HEADER, text_halign = text.align_left, text_size = dashTextSize)
    table.cell(dashTable, 1, 4, trajText, text_color = trajColor, text_halign = text.align_right, text_size = dashTextSize)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(crossAboveAverage, "Width Above Average", "standard-deviation channel width crossed above its own-history average (trend loosening) on {{ticker}} {{interval}}")
alertcondition(crossBelowAverage, "Width Below Average", "standard-deviation channel width crossed below its own-history average (trend tightening) on {{ticker}} {{interval}}")
alertcondition(compressionStart, "Compression Start", "standard-deviation channel width dropped below its compression threshold (coiled trend) on {{ticker}} {{interval}}")
alertcondition(compressionEnd, "Compression Release", "standard-deviation channel width crossed back above its compression threshold on {{ticker}} {{interval}}")

//---------------------------------------------------------------------------------------------------------------------}
