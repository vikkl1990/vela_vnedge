//@version=5
indicator('Wolfe Wave Detector [LuxAlgo]', shorttitle='LuxAlgo - Wolfe Wave Detector', max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_polylines_count = 100, max_bars_back=5000, calc_bars_count=10000, overlay=true)

//----------------------------------------------------------------------------------------------------------------------
// Settings
//---------------------------------------------------------------------------------------------------------------------{
s = '     '
t = '             '
u = '                               '
stt        = input.int   (2        ,        'Minimum'   , group=  'Swings Length' , minval=1  , maxval= 99      )
num        = math.max    (stt +1
           , input.int   (100      ,        'Maximum'   , group=  'Swings Length' , minval=2  , maxval=100           ) )
margin     = input.float (70       ,         'Margin'          , group='Tolerance', minval=0.1, maxval=100, step=0.1 ) / 100
angle      = input.float (70       ,         'Angle'           , group='Tolerance', minval=5  , maxval=100, step=5   ) / 100
iBull      = input.bool  (true     ,         'Bullish '        , group='Style'    , inline='1'                              )
iBear      = input.bool  (true     ,         'Bearish'         , group='Style'    , inline='2'                             )
extend     = input.int   (0        ,    'Extend Target Line'   , group='Style'    , minval=0  , maxval= 50                )
iProg      = input.string('None'    ,    'Show Progression'    , group='Style'    , options=['Full', 'Partial', 'None']  )
colBl      = input.color (#089981,            ''             , group='Style'    , inline='1'                            )
colBr      = input.color (#f23645,            ''             , group='Style'    , inline='2'                              )
textSize=str.lower(input.string('Normal',    'Dot Size'        , group='Style'    , options=['Tiny', 'Small', 'Normal']        ))
showDash   = input.bool  (true     ,      'Show Dashboard'     , group='Dashboard'                                                  )
table_position=str.replace(str.lower(
             input.string('Top Right',       'Location'        , group='Dashboard', options=['Top Right', 'Bottom Right', 'Bottom Left']))
                         , ' ', '_')
dashSize=str.lower(input.string('Small',    'Text Size'        , group='Dashboard', options=['Tiny', 'Small', 'Normal']))

dif        = num - stt, INV        = color(na)   , SLV         = color.new(color.silver, 50)

//---------------------------------------------------------------------------------------------------------------------}
//UDT's
//---------------------------------------------------------------------------------------------------------------------{
type piv     
    int   d
    int   x 
    float y

type ZZ 
    array<piv>piv

type drawing
    int  breakIdx = na 
    float breakPrc = na
    array<chart.point>cp
    array<int>  iWave_5
    array<line>  lines
    box       bWave_5
    float     slope0 
    float    slope1
    bool    active
    bool tg=false
    linefill  lf
    string  dir

//---------------------------------------------------------------------------------------------------------------------}
//Variables
//---------------------------------------------------------------------------------------------------------------------{
int   n   = bar_index

var array<  ZZ   > arrayZZ  = array.new<   ZZ  >() 
var array<drawing> patterns = array.new<drawing>() 
var array<  int  > counts = array.from(0, 0, 0, 0)

bull = 0, bear = 1, tgBl = 2, tgBr = 3 

var tb = table.new(table_position, 3, 4
  , bgcolor      = #1e222d
  , border_color = #373a46
  , border_width = 1
  , frame_color  = #373a46
  , frame_width  = 1)

if barstate.isfirst 
    //First bar
    line.new(n, close, n, close + syminfo.mintick, extend=extend.both)
    for i = 0 to dif -1
        ZZnew = ZZ.new(array.new<piv>())
        for j = 0 to 5 
            ZZnew.piv.unshift(piv.new(0, 0, high))

        arrayZZ.unshift(ZZnew) 

//---------------------------------------------------------------------------------------------------------------------}
//Methods
//---------------------------------------------------------------------------------------------------------------------{
method in_out(ZZ aZZ, int d, int Dx, float Dy) => aZZ.piv.unshift(piv.new(d, Dx, Dy)), aZZ.piv.pop()

method n(float v) => not na(v) 

method clean(drawing pat) =>
    for ln in pat.lines 
        ln.delete() 
    pat.bWave_5.delete()
    pat.active := false

method zigzag(array<ZZ>arrZZ, int index, int left, int right) =>
    aZZ      = arrZZ.get(index)
    ph       = ta.pivothigh(left, right)
    pl       = ta.pivotlow (left, right)

    if ph.n()
        piv  = aZZ.piv.first()
        dr_  = piv.d 
        Cx_  = piv.x 
        Cy_  = piv.y 
        Dx_  = n  - right
        Dy_  = high[right]
        //
        if Dy_ > Cy_
            if dr_ <  1  // if previous point was a pl, add, and change direction ( 1)
                aZZ.in_out( 1, Dx_, Dy_)
            else
                if dr_ ==  1 and ph > Cy_
                    piv.x := Dx_, piv.y := Dy_   
    if pl.n() 
        piv  = aZZ.piv.first()
        dr_  = piv.d 
        Cx_  = piv.x 
        Cy_  = piv.y 
        Dx_  = n  - right
        Dy_  = low [right]
        //
        if Dy_ < Cy_
            if dr_ > -1  // if previous point was a ph, add, and change direction (-1)
                aZZ.in_out(-1, Dx_, Dy_)
            else
                if dr_ == -1 and pl < Cy_ 
                    piv.x := Dx_, piv.y := Dy_    

    Y = aZZ.piv.get(5), Yx = Y.x, Yy = Y.y
    Z = aZZ.piv.get(4), Zx = Z.x, Zy = Z.y
    A = aZZ.piv.get(3), Ax = A.x, Ay = A.y
    B = aZZ.piv.get(2), Bx = B.x, By = B.y
    C = aZZ.piv.get(1), Cx = C.x, Cy = C.y
    D = aZZ.piv.get(0), Dx = D.x, Dy = D.y, dir = D.d 

    if ph.n() and iBull
        if (math.max(Bx - Ax, Dx - Cx) / math.min(Bx - Ax, Dx - Cx)) -1 <= margin
         and Dy > Cy and Cy < Ay
            already_in = false
            slope0 = (Cy - Ay) / (Cx - Ax)                
            slope1 = (Dy - By) / (Dx - Bx) 
            x1 = math.round(Dx + ((Cx - Bx) * (1 - margin)))
            x2 = math.round(Dx + ((Cx - Bx) * (1 + margin)))
            rightAngle = Dy >= By + (slope0 * (1 + angle) * (Dx - Bx)) 
                     and Dy <= By + (slope0 * (1 - angle) * (Dx - Bx)) 

            if rightAngle and Cx != Dx and x1 < n + 500 and x2 < n + 500 //if x1-2 not too far
                if patterns.size() > 0 
                    for pat in patterns 
                        patDx3    =  pat.cp.get(3).index
                        if     Ax == pat.cp.get(0).index 
                         and   Bx == pat.cp.get(1).index                      
                         and   Cx == pat.cp.get(2).index 
                            if Dx == patDx3 
                                already_in := true
                            else                                 
                                //same pattern except D -> update pattern
                                if pat.active and Dx > patDx3 and Dx - patDx3 < 8
                                    y1 = (Cy + slope0 * (x1 - Cx)) + ((Dy - Cy) / 4)
                                    y2 = (Cy + slope0 * (x2 - Cx)) - ((Dy - Cy) / 4)
                                    pat.slope1  := slope1     
                                    if iProg == 'Full'                
                                        pat.lines.get(9).set_color(color.new(colBl, 25))
                                    pat.iWave_5 := array.from(x1, x2)
                                    pat.lines.get(1).set_xy2 (Dx, Dy)
                                    pat.lines.get(4).set_xy2 (Dx, Dy)
                                    pat.lines.get(9).set_xy2( patDx3, pat.cp.get(3).price)
                                    pat.lines.get(9).set_xy1 (Cx, Cy)
                                    if iProg != 'None'
                                        pat.lines.get(5).set_xy1 (Dx, Dy)
                                        pat.lines.get(5).set_xy2(math.round(math.avg(x1, x2)), math.avg(y1, y2))
                                        pat.bWave_5.set_lefttop(x1, y1)
                                        pat.bWave_5.set_rightbottom(x2, y2)
                                    point = pat.cp.get(3)
                                    point.index := Dx 
                                    point.price := Dy
                                    already_in  := true
                if not already_in

                    y1 = (Cy + slope0 * (x1 - Cx)) + ((Dy - Cy) / 4)
                    y2 = (Cy + slope0 * (x2 - Cx)) - ((Dy - Cy) / 4)

                    dr = drawing.new() 
                    dr.dir     := 'bull'
                    dr.slope0  := slope0                
                    dr.slope1  := slope1
                    dr.lines   := array.new<line>() 
                    dr.iWave_5 := array.from(x1, x2)
                    cSLV = iProg == 'Full' ? SLV   : INV
                    clBl = iProg == 'Full' ? colBl : INV
                    dr.lines.push(line.new(Ax, Ay, Cx, Cy, style=line.style_dotted, color=cSLV )) //0
                    dr.lines.push(line.new(Bx, By, Dx, Dy, style=line.style_dotted, color=cSLV )) //1
                    dr.lines.push(line.new(Ax, Ay, Bx, By, color=clBl))                           //2
                    dr.lines.push(line.new(Bx, By, Cx, Cy, color=clBl))                           //3
                    dr.lines.push(line.new(Cx, Cy, Dx, Dy, color=clBl))                           //4
                    dr.lines.push(line.new(
                       iProg == 'None' ? na : Dx, iProg == 'None' ? na : Dy
                     , iProg == 'None' ? na : math.round(math.avg  (x1 , x2))
                     , iProg == 'None' ? na : math.avg             (y1 , y2)      
                                                         , style=line.style_dotted, color=SLV  )) //5
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dotted, color=colBl)) //6               
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dotted, color=colBl)) //7
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dashed, color=colBr)) //8
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dotted, color=INV  )) //9 - previous D-line
                    if iProg != 'None'
                        dr.bWave_5 := box.new(x1, y1, x2, y2, border_color=INV, bgcolor=color.new(chart.fg_color, 90))
                    dr.cp := array.from(
                       chart.point.from_index(Ax, Ay)
                     , chart.point.from_index(Bx, By)
                     , chart.point.from_index(Cx, Cy)
                     , chart.point.from_index(Dx, Dy) 
                     )
                    dr.active := true
                    patterns.push(dr)
   
    if pl.n() and iBear
        if (math.max(Bx - Ax, Dx - Cx) / math.min(Ax - Bx, Cx - Dx)) -1 <= margin
         and Dy < Cy and Cy > Ay
            already_in = false
            slope0 = (Cy - Ay) / (Cx - Ax)               
            slope1 = (Dy - By) / (Dx - Bx)
            x1 = math.round(Dx + ((Cx - Bx) * (1 - margin)))
            x2 = math.round(Dx + ((Cx - Bx) * (1 + margin)))
            rightAngle = Dy <= By + (slope0 * (1 + angle) * (Dx - Bx)) 
                     and Dy >= By + (slope0 * (1 - angle) * (Dx - Bx)) 

            if rightAngle and Cx != Dx and x1 < n + 500 and x2 < n + 500 
                if patterns.size() > 0 
                    for pat in patterns 
                        patDx3    =  pat.cp.get(3).index
                        if     Ax == pat.cp.get(0).index 
                         and   Bx == pat.cp.get(1).index                      
                         and   Cx == pat.cp.get(2).index 
                            if Dx == patDx3
                                already_in := true
                            else 
                                if pat.active and Dx > patDx3 and Dx - patDx3 < 8
                                    y1 = (Cy + slope0 * (x1 - Cx)) + ((Cy - Dy) / 4)
                                    y2 = (Cy + slope0 * (x2 - Cx)) - ((Cy - Dy) / 4)
                                    pat.slope1  := slope1        
                                    if iProg == 'Full'                  
                                        pat.lines.get(9).set_color(color.new(colBr, 25))            
                                    pat.iWave_5 := array.from(x1, x2)
                                    pat.lines.get(1).set_xy2 (Dx, Dy)
                                    pat.lines.get(4).set_xy2 (Dx, Dy)                                 
                                    pat.lines.get(9).set_xy2( patDx3, pat.cp.get(3).price)
                                    pat.lines.get(9).set_xy1 (Cx, Cy)
                                    if iProg != 'None'                                    
                                        pat.lines.get(5).set_xy1 (Dx, Dy)
                                        pat.lines.get(5).set_xy2(math.round(math.avg(x1, x2)), math.avg(y1, y2))   
                                        pat.bWave_5.set_lefttop(x1, y1)
                                        pat.bWave_5.set_rightbottom(x2, y2)
                                    point = pat.cp.get(3)
                                    point.index := Dx 
                                    point.price := Dy 
                                    already_in  := true
                if not already_in

                    y1 = (Cy + slope0 * (x1 - Cx)) + ((Cy - Dy) / 4)
                    y2 = (Cy + slope0 * (x2 - Cx)) - ((Cy - Dy) / 4)

                    dr = drawing.new() 
                    dr.dir     := 'bear'
                    dr.slope0  := slope0                
                    dr.slope1  := slope1
                    dr.lines   := array.new<line>() 
                    dr.iWave_5 := array.from(x1, x2)
                    cSLV = iProg == 'Full' ? SLV   : INV
                    clBr = iProg == 'Full' ? colBr : INV
                    dr.lines.push(line.new(Ax, Ay, Cx, Cy, style=line.style_dotted, color=cSLV )) //0
                    dr.lines.push(line.new(Bx, By, Dx, Dy, style=line.style_dotted, color=cSLV )) //1
                    dr.lines.push(line.new(Ax, Ay, Bx, By, color=clBr))                           //2
                    dr.lines.push(line.new(Bx, By, Cx, Cy, color=clBr))                           //3
                    dr.lines.push(line.new(Cx, Cy, Dx, Dy, color=clBr))                           //4
                    dr.lines.push(line.new(
                       iProg == 'None' ? na : Dx, iProg == 'None' ? na : Dy
                     , iProg == 'None' ? na : math.round(math.avg  (x1 , x2))
                     , iProg == 'None' ? na : math.avg             (y1 , y2) 
                                                         , style=line.style_dotted, color=SLV  )) //5
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dotted, color=colBr)) //6             
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dotted, color=colBr)) //7
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dashed, color=colBl)) //8                      
                    dr.lines.push(line.new(na, na, na, na, style=line.style_dotted, color=INV  )) //9
                    if iProg != 'None'
                        dr.bWave_5 := box.new(x1, y1, x2, y2, border_color=INV, bgcolor=color.new(chart.fg_color, 90))
                    dr.cp := array.from(
                       chart.point.from_index(Ax, Ay)
                     , chart.point.from_index(Bx, By)
                     , chart.point.from_index(Cx, Cy)
                     , chart.point.from_index(Dx, Dy) 
                     )                    
                    dr.active := true
                    patterns.push(dr)

//---------------------------------------------------------------------------------------------------------------------}
//Execution
//---------------------------------------------------------------------------------------------------------------------{
for i = dif -1 to 0
    arrayZZ.zigzag(i, stt + i, 1)

sz = patterns.size()
if sz > 0
    for i = sz -1 to 0  
        pat = patterns.get(i)
        if sz > 55 
            if i < 55 and not pat.active
                for ln in pat.lines 
                    ln.delete() 
                pat.bWave_5.delete()
                patterns.remove(i)
        else            
            ln7 = pat.lines.get(7)
            ln8 = pat.lines.get(8)

            if not pat.tg and not na(ln8.get_x2())
                if n >  ln8.get_x2() 
                    if  ln8.get_x2() < ln7.get_x2() + extend 
                        ln8.set_xy2(n, ln8.get_y2() + ((ln8.get_y2() - ln8.get_y1()) / (ln8.get_x2() - ln8.get_x1()) * (n - ln8.get_x2()))) 

                if n <= ln8.get_x2()
                    switch pat.dir 
                        'bull' => 
                            if close[1] < ln8.get_price(n) and high > ln8.get_price(n)
                                counts.set(tgBl, counts.get(tgBl) +1)
                                label.new(n, high, text='●', color=INV, textcolor=colBl, size=textSize)
                                pat.tg := true
                        'bear' => 
                            if close[1] > ln8.get_price(n) and low  < ln8.get_price(n)
                                counts.set(tgBr, counts.get(tgBr) +1)
                                label.new(n, low , text='●', color=INV, textcolor=colBr
                                 , style= label.style_label_up, size=textSize)
                                pat.tg := true

            if pat.active and na(ln8.get_x2()) //Only active, not complete patterns (no dashed target line)
                ln0 = pat.lines.get(0)                
                ln1 = pat.lines.get(1)            
                ln4 = pat.lines.get(4)                
                
                if n <= pat.iWave_5.last() 
                    ln0.set_xy2(n, ln0.get_y2() + (n-ln0.get_x2())*pat.slope0)
                    ln1.set_xy2(n, ln1.get_y2() + pat.slope1)
                switch 
                    n <  pat.iWave_5.first() =>
                        if  (pat.dir == 'bull' and (close < ln0.get_y2() or close > ln1.get_y2())) 
                         or (pat.dir == 'bear' and (close > ln0.get_y2() or close < ln1.get_y2())) 
                            pat.clean()

                    n <= pat.iWave_5.last() and n >= pat.iWave_5.first() =>
                        if  (pat.dir == 'bull' and close > ln1.get_y2())
                         or (pat.dir == 'bear' and close < ln1.get_y2())
                            pat.clean()
                        else
                            if pat.dir == 'bull' and close < ln0.get_y2() 
                                if not na(pat.breakPrc) 
                                    if low < pat.breakPrc
                                        pat.breakPrc := low
                                        pat.breakIdx := n
                                else 
                                    pat.breakPrc := low
                                    pat.breakIdx := n

                            if pat.dir == 'bear' and close > ln0.get_y2() 
                                if not na(pat.breakPrc) 
                                    if high > pat.breakPrc
                                        pat.breakPrc := high
                                        pat.breakIdx := n
                                else 
                                    pat.breakPrc := high
                                    pat.breakIdx := n

                    n-1 == pat.iWave_5.last() or n-2 == pat.iWave_5.last() =>
                        //if close is not returned up - above bottome line - delete
                        if na(pat.breakPrc) 
                         or ((pat.dir == 'bull' and close < ln0.get_y2()) or (pat.dir == 'bear' and close > ln0.get_y2()))
                            pat.clean()
                        else 
                            if iProg != 'Full'
                                for j = 0 to 1 
                                    pat.lines.get(j).set_color(SLV)
                                for j = 2 to 4 
                                    pat.lines.get(j).set_color(pat.dir == 'bull' ? colBl : colBr)
                            col = pat.dir == 'bull' ? colBl : colBr
                            //D -> E
                            ln5 = pat.lines.get(5), ln5.set_xy1(ln4.get_x2(), ln4.get_y2()), ln5.set_xy2(pat.breakIdx, pat.breakPrc), ln5.set_style(line.style_solid), ln5.set_color(col) 
                            //Target line 1         
                            ln6 = pat.lines.get(6), ln6.set_xy1(pat.breakIdx, pat.breakPrc), ln6.set_xy2(math.round(pat.breakIdx + ((ln4.get_x2() - ln4.get_x1()) * (1 - margin))), pat.breakPrc + (ln4.get_y2() - ln4.get_y1()))   
                            //Target line 2       
                            ln7 = pat.lines.get(7), ln7.set_xy1(pat.breakIdx, pat.breakPrc), ln7.set_xy2(math.round(pat.breakIdx + ((ln4.get_x2() - ln4.get_x1()) * (1 + margin))), pat.breakPrc + (ln4.get_y2() - ln4.get_y1())) 
                            //Dashed Target line
                            x1 = ln0.get_x1(), y1 = ln0.get_y1(), x2 = ln4.get_x2(), y2 = ln4.get_y2()
                            ln8 = pat.lines.get(8), ln8.set_xy1(x1, y1), ln8.set_xy2(x2, y2)

                            s1a  = ln6.get_price(n), s1b  = ln7.get_price(n), s2 = ln8.get_price(n)
                            ch1a = (ln6.get_y2() - ln6.get_y1()) / (ln6.get_x2() - ln6.get_x1())
                            ch1b = (ln7.get_y2() - ln7.get_y1()) / (ln7.get_x2() - ln7.get_x1())
                            ch2  = (ln8.get_y2() - ln8.get_y1()) / (ln8.get_x2() - ln8.get_x1())

                            sf_a = (s2 - s1a) / (ch1a - ch2)
                            sf_b = (s2 - s1b) / (ch1b - ch2)

                            I_a  =  s1a + ch1a * sf_a                            
                            I_b  =  s1b + ch1b * sf_b
                            if sf_a > 400 or sf_b > 400
                                pat.clean()
                            else 
                                ln6.set_xy2(math.round(n + sf_a), I_a)
                                ln7.set_xy2(math.round(n + sf_b), I_b)
                                ln8.set_xy2(math.round(n + sf_b), I_b)

                                pat.lf := linefill.new(ln6, ln7, color.new(col, 90))
                                if iProg != 'None'
                                    pat.bWave_5.set_bgcolor(color.new(chart.fg_color, 98))
                                idx = pat.dir == 'bull' ? bull : bear
                                counts.set(idx, counts.get(idx) +1)

//---------------------------------------------------------------------------------------------------------------------}
//Dashboard
//---------------------------------------------------------------------------------------------------------------------{
if barstate.islast and showDash and (iBull or iBear)    
    
    tb.cell(0, 1, 'Amount'                      , text_size=dashSize, text_color=color.white)  
    tb.cell(0, 2, 'Target Reached'              , text_size=dashSize, text_color=color.white)  

    if iBull
        tb.cell(1, 0, 'Bullish Wave'                , text_size=dashSize, text_color=color.white)      
        tb.cell(1, 1, str.tostring(counts.get(bull)), text_size=dashSize, text_color=color.white) 
        tb.cell(1, 2, str.tostring(counts.get(tgBl)), text_size=dashSize, text_color=color.white) 

    if iBear
        tb.cell(2, 0, 'Bearish Wave'                , text_size=dashSize, text_color=color.white)  
        tb.cell(2, 1, str.tostring(counts.get(bear)), text_size=dashSize, text_color=color.white) 
        tb.cell(2, 2, str.tostring(counts.get(tgBr)), text_size=dashSize, text_color=color.white) 

//---------------------------------------------------------------------------------------------------------------------}      