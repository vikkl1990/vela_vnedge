//@version=6
indicator("Rolling Trendline [LuxAlgo]", "LuxAlgo - Rolling Trendline", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
int lengthInput      = input.int(100, "Slope Lookback", minval = 2, tooltip = "The period used to calculate the linear regression slope.")
float multInput      = input.float(2.0, "Deviation Multiplier", minval = 0.1, step = 0.1, tooltip = "How far price can deviate from the trendline before it readjusts.")
float slopeDivInput  = input.float(1.5, "Slope Divisor", minval = 0.1, step = 0.1, tooltip = "Divides the calculated slope to tame the trajectory. Higher values result in flatter lines.")
sourceInput          = input.source(close, "Source")

// ATR Zone Inputs
int atrLengthInput   = input.int(200, "ATR Length", minval = 1, group = "ATR Zones", tooltip = "The length used for the ATR calculation.")
float atrMultInput   = input.float(3.0, "ATR Multiplier", minval = 0.0, step = 0.1, group = "ATR Zones", tooltip = "Multiplier applied to the ATR to determine zone width.")

// Visuals
color bullColorInput = input.color(BULL_COLOR, "Bullish Trend", inline = "colors")
color bearColorInput = input.color(BEAR_COLOR, "Bearish Trend", inline = "colors")
color zoneColorInput = input.color(color.new(#787b86, 80), "Zone Color")
int widthInput       = input.int(2, "Line Width", minval = 1)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Calculate linear regression slope using ta.linreg
// Slope = (Value at bar 0 - Value at bar n) / n
float lrValueCurrent = ta.linreg(sourceInput, lengthInput, 0)
float lrValuePast    = ta.linreg(sourceInput, lengthInput, lengthInput - 1)
float lrSlope        = ((lrValueCurrent - lrValuePast) / (lengthInput - 1)) / slopeDivInput

// Standard deviation for thresholding
float dev            = ta.stdev(sourceInput, lengthInput)
float threshold      = dev * multInput

// ATR Calculation for zones
float atrVal         = ta.atr(atrLengthInput)

// Persistence variables for the rolling trendline
var float trendValue  = na
var float activeSlope = na
var float resetAtr    = na

// Logic to initialize or reset the trendline
// We calculate the projected price based on the previous bar's trend value and slope
float projectedValue = trendValue[1] + activeSlope
bool isDeviating     = math.abs(sourceInput - projectedValue) > threshold
bool isFirstBar      = bar_index == lengthInput 

if isFirstBar or isDeviating
    trendValue  := sourceInput
    activeSlope := lrSlope
    resetAtr    := atrVal
else
    trendValue  := projectedValue

// Calculate Zone Bands
float upperBand = trendValue + resetAtr * atrMultInput
float lowerBand = trendValue - resetAtr * atrMultInput

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Define color based on current active slope
color trendColor = activeSlope >= 0 ? bullColorInput : bearColorInput
color dynamicZoneColor = activeSlope >= 0 ? bullColorInput : bearColorInput

// Plot the rolling trendline. 
// We set color to na on deviation bars to create clean visual cuts without vertical jumps.
plotTrend = plot(trendValue, "Rolling Trendline", color = isDeviating ? na : trendColor, linewidth = widthInput)

// ATR Zones Plots
plotUpper = plot(upperBand, "Upper Band", color = isDeviating ? na : color.new(dynamicZoneColor, 80))
plotLower = plot(lowerBand, "Lower Band", color = isDeviating ? na : color.new(dynamicZoneColor, 80))

// Vertical gradient fills from trendline to upper/lower bands
fill(plotUpper, plotTrend, upperBand, trendValue, color.new(dynamicZoneColor, 80), color.new(dynamicZoneColor, 100), "Upper Zone Fill")
fill(plotLower, plotTrend, lowerBand, trendValue, color.new(dynamicZoneColor, 80), color.new(dynamicZoneColor, 100), "Lower Zone Fill")

// Highlight resets with a small circle at the source price using plot
// Using a small linewidth to keep the marker subtle
plot(isDeviating ? sourceInput : na, "Reset Point", color = trendColor, linewidth = 3, style = plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
