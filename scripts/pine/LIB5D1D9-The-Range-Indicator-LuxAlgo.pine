//@version=6
indicator("The Range Indicator", shorttitle = "The Range Indicator", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
SETTINGS_GROUP = "Settings"
LEVELS_GROUP   = "Thresholds"
STYLE_GROUP    = "Style"

METRIC_COLOR  = #5b9cf6
NEUTRAL_COLOR = #787b86

DEGENERATE_ZERO = "Output Zero"
DEGENERATE_HOLD = "Hold Previous Value"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
normLengthInput = input.int(10, "Normalization Length", minval = 2, group = SETTINGS_GROUP, tooltip = "Lookback, in bars, of the stochastic-style normalization applied to the raw range ratio. Commonly 10. Longer windows make extreme readings rarer and steadier, shorter windows keep readings pinned to recent behavior.")

smoothLengthInput = input.int(3, "Smoothing Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Length of the exponential moving average that smooths the normalized series into the final reading. Commonly 3. Shorter smoothing makes the line jumpier, longer smoothing slows it down.")

degenerateInput = input.string(DEGENERATE_ZERO, "Degenerate Window Handling", options = [DEGENERATE_ZERO, DEGENERATE_HOLD], group = SETTINGS_GROUP, tooltip = "Value used when the highest and lowest raw ratios coincide over the normalization window, making the normalization degenerate. Platforms typically output zero or hold the prior value.")

showLevelsInput = input.bool(true, "Show Thresholds", group = LEVELS_GROUP, tooltip = "Display dashed threshold levels marking churn extremes and efficient-travel readings.")

highThresholdInput = input.float(80, "High Threshold", minval = 0, maxval = 100, step = 5, group = LEVELS_GROUP, tooltip = "Reading above which intraday churn is treated as overwhelming close-to-close progress, a condition Weinberg read as a sign the current trend may be ending. Commonly 70 or 80.")

lowThresholdInput = input.float(20, "Low Threshold", minval = 0, maxval = 100, step = 5, group = LEVELS_GROUP, tooltip = "Reading below which bars are treated as covering ground efficiently, an environment where trend-following entries have historically fared better. Commonly 20 or 30.")

triColorInput = input.color(METRIC_COLOR, "TRI", group = STYLE_GROUP)

showFillInput = input.bool(true, "Gradient Fill", group = STYLE_GROUP)

levelsColorInput = input.color(NEUTRAL_COLOR, "Thresholds", group = STYLE_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//True range of the bar and interday close-to-close change
trueRange   = ta.tr(true)
closeChange = close - close[1]

//Raw range ratio - true range over the close-to-close gain on up-closing bars, raw true range otherwise
//A flat or down close falls into the raw true range branch, so the denominator is never zero or negative
rawRatio = not na(closeChange) and closeChange > 0 ? trueRange / closeChange : trueRange

//Window extremes of the raw ratio used by the stochastic-style normalization
lowestRatio  = ta.lowest(rawRatio, normLengthInput)
highestRatio = ta.highest(rawRatio, normLengthInput)
ratioSpan    = highestRatio - lowestRatio

//Last normalized value, carried for the degenerate hold-previous mode
var float heldNorm = 0.0

//Normalized ratio, bounded 0 to 100 - degenerate windows output zero or hold the prior value
float stochNorm = na(ratioSpan) ? na : ratioSpan > 0 ? 100 * (rawRatio - lowestRatio) / ratioSpan : degenerateInput == DEGENERATE_HOLD ? heldNorm : 0

heldNorm := nz(stochNorm, heldNorm)

//The Range Indicator - exponential smoothing of the normalized series
tri = ta.ema(stochNorm, smoothLengthInput)

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
triPlotId  = plot(tri, "TRI", triColorInput, 1)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

//Vertical gradient fill - fully transparent at zero, 50% opacity at the reading
fillTopColor    = showFillInput ? color.new(triColorInput, 50) : color(na)
fillBottomColor = showFillInput ? color.new(triColorInput, 100) : color(na)

fill(triPlotId, zeroPlotId, top_value = tri, bottom_value = 0, top_color = fillTopColor, bottom_color = fillBottomColor, title = "TRI Gradient")

//Threshold levels - churn extreme above, efficient travel below
levelColor = showLevelsInput ? levelsColorInput : color(na)

hline(highThresholdInput, "High Threshold", levelColor, hline.style_dashed)
hline(lowThresholdInput, "Low Threshold", levelColor, hline.style_dashed)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(ta.crossover(tri, highThresholdInput), "Churn Extreme", "The Range Indicator crossed above the high threshold on {{ticker}} ({{interval}}) - intraday range is overwhelming close-to-close progress, a churn condition Weinberg associated with trend endings")

alertcondition(ta.crossunder(tri, highThresholdInput), "Churn Easing", "The Range Indicator crossed back below the high threshold on {{ticker}} ({{interval}}) - the churn extreme is unwinding")

alertcondition(ta.crossunder(tri, lowThresholdInput), "Efficient Travel", "The Range Indicator crossed below the low threshold on {{ticker}} ({{interval}}) - bars are covering ground efficiently, an environment that has historically favored trend-following entries")

alertcondition(ta.crossover(tri, lowThresholdInput), "Efficiency Fading", "The Range Indicator crossed back above the low threshold on {{ticker}} ({{interval}}) - efficient travel is giving way to churn")

//---------------------------------------------------------------------------------------------------------------------}
