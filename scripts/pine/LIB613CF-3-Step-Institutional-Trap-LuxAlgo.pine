//@version=6
indicator("3-Step Institutional Trap", overlay = true, max_labels_count = 500)

// --- Settings ---
lookback    = input.int(20, "Lookback Period", minval = 5, tooltip = "Number of bars to determine the recent high/low level to be swept.")
step2Window = input.int(3, "Max Bars for Rejection (Step 2)", minval = 1, tooltip = "How many bars price has to close back inside the level after the sweep.")
step3Window = input.int(10, "Max Bars for Shift (Step 3)", minval = 1, tooltip = "How many bars to wait for the trigger after the rejection.")

// --- State Variables ---
var int longStep   = 0
var int shortStep  = 0
var int longTimer  = 0
var int shortTimer = 0
var float longLevel  = na
var float shortLevel = na
var float longTriggerPrice  = na
var float shortTriggerPrice = na

// --- Levels ---
float recentHigh = ta.highest(high[1], lookback)
float recentLow  = ta.lowest(low[1], lookback)

// --- Logic for Long Trap (Bullish Reversal) ---
// Step 1: The Sweep (Price breaks below recent low)
if low < recentLow and longStep == 0
    longStep := 1
    longLevel := recentLow
    longTimer := step2Window

// Step 2: The Rejection (Close back above the level)
if longStep == 1 and longTimer > 0
    if close > longLevel
        longStep := 2
        longTimer := step3Window
        // The trigger is the high of the lowest candle in the sweep
        longTriggerPrice := high 
    else
        // Update trigger price if we make a lower high while still below the level
        longTriggerPrice := math.max(nz(longTriggerPrice), high)

// Step 3: The Shift (Close above the 'Trap Bar' high)
bool longSignal = false
if longStep == 2 and longTimer > 0
    if ta.crossover(close, longTriggerPrice)
        longSignal := true
        longStep := 0
        longTimer := 0

// Timers and Resets
longTimer := longTimer > 0 ? longTimer - 1 : 0
if longTimer == 0
    longStep := 0

// --- Logic for Short Trap (Bearish Reversal) ---
// Step 1: The Sweep (Price breaks above recent high)
if high > recentHigh and shortStep == 0
    shortStep := 1
    shortLevel := recentHigh
    shortTimer := step2Window

// Step 2: The Rejection (Close back below the level)
if shortStep == 1 and shortTimer > 0
    if close < shortLevel
        shortStep := 2
        shortTimer := step3Window
        // The trigger is the low of the highest candle in the sweep
        shortTriggerPrice := low
    else
        shortTriggerPrice := math.min(nz(shortTriggerPrice, 1e10), low)

// Step 3: The Shift (Close below the 'Trap Bar' low)
bool shortSignal = false
if shortStep == 2 and shortTimer > 0
    if ta.crossunder(close, shortTriggerPrice)
        shortSignal := true
        shortStep := 0
        shortTimer := 0

// Timers and Resets
shortTimer := shortTimer > 0 ? shortTimer - 1 : 0
if shortTimer == 0
    shortStep := 0

// --- Visuals ---
// Levels
plot(recentHigh, "Recent High", color = color.new(#f23645, 80), style = plot.style_linebr)
plot(recentLow, "Recent Low", color = color.new(#089981, 80), style = plot.style_linebr)

// Step Labels
plotshape(longStep == 1 and longStep[1] == 0, "Long Step 1", shape.triangleup, location.belowbar, #089981, size = size.tiny, text = "1", textcolor = chart.fg_color)
plotshape(longStep == 2 and longStep[1] == 1, "Long Step 2", shape.triangleup, location.belowbar, #089981, size = size.tiny, text = "2", textcolor = chart.fg_color)

plotshape(shortStep == 1 and shortStep[1] == 0, "Short Step 1", shape.triangledown, location.abovebar, #f23645, size = size.tiny, text = "1", textcolor = chart.fg_color)
plotshape(shortStep == 2 and shortStep[1] == 1, "Short Step 2", shape.triangledown, location.abovebar, #f23645, size = size.tiny, text = "2", textcolor = chart.fg_color)

// Final Signal
plotshape(longSignal, "Trap Buy", shape.triangleup, location.belowbar, #089981, size = size.small)
plotshape(shortSignal, "Trap Sell", shape.triangledown, location.abovebar, #f23645, size = size.small)

// Optional: Plot Trigger Levels while waiting for Step 3
plot(longStep == 2 ? longTriggerPrice : na, "Long Trigger", color = color.new(#089981, 50), style = plot.style_circles)
plot(shortStep == 2 ? shortTriggerPrice : na, "Short Trigger", color = color.new(#f23645, 50), style = plot.style_circles)
