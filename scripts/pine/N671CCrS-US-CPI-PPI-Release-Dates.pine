f_eventOnBar(int[] dates) =>
    bool found = false
    for eventTime in dates
        if time <= eventTime and time_close > eventTime
            found := true
    found

isCPI = showCPI and f_eventOnBar(cpiDates)
isPPI = showPPI and f_eventOnBar(ppiDates)

if isCPI
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=cpiColor, style=style, width=lineWidth)
    if showLabels
        label.new(bar_index, high, "CPI", color=cpiColor, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if isPPI
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=ppiColor, style=style, width=lineWidth)
    if showLabels
        label.new(bar_index, high, "PPI", color=ppiColor, textcolor=color.white, style=label.style_label_down, size=size.tiny)

