//@version=6
indicator("US CPI & PPI Release Dates — 5 Years", overlay=true, max_lines_count=250, max_labels_count=250)

showCPI    = input.bool(true, "Show CPI", group="Events")
showPPI    = input.bool(true, "Show PPI", group="Events")
showLabels = input.bool(true, "Show labels", group="Display")
lineWidth  = input.int(1, "Line width", minval=1, maxval=4, group="Display")
lineStyle  = input.string("Dashed", "Line style", options=["Solid", "Dashed", "Dotted"], group="Display")
cpiColor   = input.color(color.rgb(255, 82, 82), "CPI colour", group="Colours")
ppiColor   = input.color(color.rgb(41, 182, 246), "PPI colour", group="Colours")

style = lineStyle == "Solid" ? line.style_solid : lineStyle == "Dotted" ? line.style_dotted : line.style_dashed

