//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
indicator("CRT Sweep & Setup Highlighter", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- Inputs ---
grp_set = "Settings"
htf = input.timeframe("60", "Higher Timeframe", group = grp_set)
setupType = input.string("FVG", "Setup Type", options = ["FVG", "MSS", "Both", "None"], group = grp_set)
drawRR = input.bool(true, "Draw Risk:Reward", group = grp_set)
onlyShowWithSetup = input.bool(true, "Only Keep Visuals if Setup Found", group = grp_set, tooltip = "Deletes the previous HTF drawing and manipulation highlights if no setup occurred during that period.")

grp_manip = "Manipulation Rules"
minBreakType = input.string("Ticks", "Minimum Break Type", options = ["Ticks", "%"], group = grp_manip)
minBreakValue = input.float(0.0, "Minimum Break Value", group = grp_manip, tooltip = "How far price must break the level to be considered a manipulation sweep.")

grp_sty = "Style"
bullColor = input.color(color.new(#089981, 85), "Bullish Background", group = grp_sty)
bearColor = input.color(color.new(#f23645, 85), "Bearish Background", group = grp_sty)
borderColor = input.color(color.new(color.gray, 0), "Border & Wick Color", group = grp_sty)
levelColor = input.color(color.new(color.gray, 0), "Support & Resistance Color", group = grp_sty)
manipColor = input.color(color.new(color.orange, 70), "Manipulation Box Color", group = grp_sty)
labelColor = input.color(color.orange, "Label Text Color", group = grp_sty)
rrProfitColor = input.color(color.new(#089981, 80), "RR Profit Color", group = grp_sty)
rrLossColor = input.color(color.new(#f23645, 80), "RR Loss Color", group = grp_sty)

// --- Manipulation & Setup State Variables ---
var int sweepState = 0
var float sweepExtremum = na
var bool setupFound = false

// --- HTF Tracking ---
htfTime = time(htf)
isNewHTF = nz(ta.change(htfTime)) != 0

// Variables for the developing HTF
var float htfO = na
var float htfH = na
var float htfL = na
var float htfC = na
var int startBar = na

// Variables for the finalized PREVIOUS HTF
var float prevHtfO = na
var float prevHtfH = na
var float prevHtfL = na
var float prevHtfC = na
var int prevStartBar = na
var int prevEndBar = na

// Visual objects for the previous HTF
var box prevBodyBox = na
var line prevTopWick = na
var line prevBtmWick = na
var line resLine = na
var line supLine = na

// Tracking manipulation objects for cleanup
var box manipBox = na
var label manipLabel = na

if isNewHTF
    // Clean up if requested
    if onlyShowWithSetup and not setupFound
        if not na(prevBodyBox)
            box.delete(prevBodyBox)
        if not na(prevTopWick)
            line.delete(prevTopWick)
        if not na(prevBtmWick)
            line.delete(prevBtmWick)
        if not na(resLine)
            line.delete(resLine)
        if not na(supLine)
            line.delete(supLine)
        if not na(manipBox)
            box.delete(manipBox)
        if not na(manipLabel)
            label.delete(manipLabel)

    // Reset setup logic states for the new period
    sweepState := 0
    sweepExtremum := na
    setupFound := false
    manipBox := na
    manipLabel := na

    // Lock in the previous HTF values
    prevHtfO := htfO
    prevHtfH := htfH
    prevHtfL := htfL
    prevHtfC := htfC
    prevStartBar := startBar
    prevEndBar := bar_index - 1

    // Reset the developing HTF values for the new period
    htfO := open
    htfH := high
    htfL := low
    htfC := close
    startBar := bar_index
    
    // Draw the completed PREVIOUS HTF visually on the chart
    if not na(prevHtfO)
        prevBodyBox := box.new(prevStartBar, math.max(prevHtfO, prevHtfC), prevEndBar, math.min(prevHtfO, prevHtfC), border_color = borderColor, border_style = line.style_dashed, bgcolor = prevHtfO <= prevHtfC ? bullColor : bearColor)
        
        int midBar = math.round((prevStartBar + prevEndBar) / 2)
        prevTopWick := line.new(midBar, prevHtfH, midBar, math.max(prevHtfO, prevHtfC), color = borderColor, style = line.style_dashed)
        prevBtmWick := line.new(midBar, prevHtfL, midBar, math.min(prevHtfO, prevHtfC), color = borderColor, style = line.style_dashed)
        
        // Draw the S/R Levels projecting OUT from the Previous HTF wicks across the current period
        resLine := line.new(prevEndBar, prevHtfH, bar_index, prevHtfH, color = levelColor, style = line.style_solid)
        supLine := line.new(prevEndBar, prevHtfL, bar_index, prevHtfL, color = levelColor, style = line.style_solid)
else if not na(htfO)
    // Update developing HTF highs/lows
    htfH := math.max(htfH, high)
    htfL := math.min(htfL, low)
    htfC := close
    
    // Extend the S/R projection lines to the current bar
    if not na(prevHtfH)
        line.set_x2(resLine, bar_index)
        line.set_x2(supLine, bar_index)

// --- Manipulation Logic ---
bool alertBearishSweep = false
bool alertBullishSweep = false

if not na(prevHtfH)
    float breakDistBearish = high[1] - prevHtfH
    float breakDistBullish = prevHtfL - low[1]
    
    bool validBearishBreak = false
    bool validBullishBreak = false
    
    if minBreakType == "Ticks"
        validBearishBreak := breakDistBearish >= (minBreakValue * syminfo.mintick)
        validBullishBreak := breakDistBullish >= (minBreakValue * syminfo.mintick)
    else
        validBearishBreak := (breakDistBearish / prevHtfH * 100) >= minBreakValue
        validBullishBreak := (breakDistBullish / prevHtfL * 100) >= minBreakValue

    isBearishSweep = high[1] > prevHtfH and close[1] < prevHtfH and sweepState != 1 and validBearishBreak
    isBullishSweep = low[1] < prevHtfL and close[1] > prevHtfL and sweepState != -1 and validBullishBreak

    if isBearishSweep
        sweepState := 1
        sweepExtremum := high[1]
        setupFound := false
        alertBearishSweep := true
        if not na(manipBox)
            box.delete(manipBox)
        if not na(manipLabel)
            label.delete(manipLabel)
        manipBox := box.new(bar_index - 2, sweepExtremum, bar_index, prevHtfH, border_color = na, bgcolor = manipColor)
        manipLabel := label.new(bar_index - 1, sweepExtremum, "Manipulation", style = label.style_label_down, color = color.new(color.white, 100), textcolor = labelColor, size = size.small)

    if isBullishSweep
        sweepState := -1
        sweepExtremum := low[1]
        setupFound := false
        alertBullishSweep := true
        if not na(manipBox)
            box.delete(manipBox)
        if not na(manipLabel)
            label.delete(manipLabel)
        manipBox := box.new(bar_index - 2, prevHtfL, bar_index, sweepExtremum, border_color = na, bgcolor = manipColor)
        manipLabel := label.new(bar_index - 1, sweepExtremum, "Manipulation", style = label.style_label_up, color = color.new(color.white, 100), textcolor = labelColor, size = size.small)

// --- Setup Detection ---
bullishFVG = low > high[2] and close[1] > open[1]
bearishFVG = high < low[2] and close[1] < open[1]

ph = ta.pivothigh(high, 3, 3)
pl = ta.pivotlow(low, 3, 3)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

bullishMSS = ta.crossover(close, lastPH)
bearishMSS = ta.crossunder(close, lastPL)

validBullishSetup = (setupType == "FVG" or setupType == "Both") and bullishFVG or (setupType == "MSS" or setupType == "Both") and bullishMSS
validBearishSetup = (setupType == "FVG" or setupType == "Both") and bearishFVG or (setupType == "MSS" or setupType == "Both") and bearishMSS

bool alertBullishSetup = false
bool alertBearishSetup = false

if sweepState == -1 and validBullishSetup and not setupFound and setupType != "None" and not na(prevHtfH)
    setupFound := true
    alertBullishSetup := true
    entryPrice = close
    slPrice = sweepExtremum
    tpPrice = prevHtfH
    
    if drawRR and tpPrice > entryPrice and entryPrice > slPrice
        box.new(bar_index, entryPrice, bar_index + 10, slPrice, border_color = color.new(color.red, 50), bgcolor = rrLossColor)
        box.new(bar_index, tpPrice, bar_index + 10, entryPrice, border_color = color.new(color.green, 50), bgcolor = rrProfitColor)
        line.new(bar_index, entryPrice, bar_index + 10, entryPrice, color = color.gray, style = line.style_solid)
        line.new(bar_index, slPrice, bar_index + 10, slPrice, color = color.red, style = line.style_solid)
        line.new(bar_index, tpPrice, bar_index + 10, tpPrice, color = color.green, style = line.style_solid)

if sweepState == 1 and validBearishSetup and not setupFound and setupType != "None" and not na(prevHtfH)
    setupFound := true
    alertBearishSetup := true
    entryPrice = close
    slPrice = sweepExtremum
    tpPrice = prevHtfL
    
    if drawRR and tpPrice < entryPrice and entryPrice < slPrice
        box.new(bar_index, entryPrice, bar_index + 10, slPrice, border_color = color.new(color.red, 50), bgcolor = rrLossColor)
        box.new(bar_index, tpPrice, bar_index + 10, entryPrice, border_color = color.new(color.green, 50), bgcolor = rrProfitColor)
        line.new(bar_index, entryPrice, bar_index + 10, entryPrice, color = color.gray, style = line.style_solid)
        line.new(bar_index, slPrice, bar_index + 10, slPrice, color = color.red, style = line.style_solid)
        line.new(bar_index, tpPrice, bar_index + 10, tpPrice, color = color.green, style = line.style_solid)

// --- Alerts ---
alertcondition(alertBearishSweep, title = "Bearish Manipulation", message = "Bearish manipulation detected (Sweep of Previous HTF High).")
alertcondition(alertBullishSweep, title = "Bullish Manipulation", message = "Bullish manipulation detected (Sweep of Previous HTF Low).")
alertcondition(alertBearishSetup, title = "Bearish Setup Triggered", message = "Bearish setup triggered after manipulation.")
alertcondition(alertBullishSetup, title = "Bullish Setup Triggered", message = "Bullish setup triggered after manipulation.")
