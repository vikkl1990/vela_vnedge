//@version=6
indicator("OsMA", "OsMA", overlay = false, format = format.price)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput    = input.source(close, "Source",       group = "Settings", tooltip = "Price series used to compute the fast and slow moving averages of the underlying oscillator.")
fastInput   = input.int(12, "Fast Length",   minval = 1, group = "Settings", tooltip = "Length of the fast EMA. Together with the slow EMA it forms the underlying oscillator (the MACD line). Standard default is 12.")
slowInput   = input.int(26, "Slow Length",   minval = 1, group = "Settings", tooltip = "Length of the slow EMA subtracted from the fast EMA to form the underlying oscillator. Standard default is 26.")
signalInput = input.int(9,  "Signal Length", minval = 1, group = "Settings", tooltip = "Length of the EMA of the oscillator used as its signal line. OsMA plots the oscillator minus this signal, so a zero cross is exactly a signal-line crossover. Standard default is 9.")

bullGrowInput = input.color(#089981,                "Bullish  Growing", inline = "bull", group = "Style")
bullFadeInput = input.color(color.new(#089981, 60), "Fading",           inline = "bull", group = "Style", tooltip = "Colors of positive histogram bars. Growing bars extend away from zero (bullish momentum building), fading bars shrink toward zero (bullish momentum fading ahead of a potential signal-line cross).")
bearGrowInput = input.color(#f23645,                "Bearish  Growing", inline = "bear", group = "Style")
bearFadeInput = input.color(color.new(#f23645, 60), "Fading",           inline = "bear", group = "Style", tooltip = "Colors of negative histogram bars. Growing bars extend away from zero (bearish momentum building), fading bars shrink toward zero (bearish momentum fading ahead of a potential signal-line cross).")
zeroInput     = input.color(color.new(#787b86, 50), "Zero Line",        group = "Style", tooltip = "Color of the zero reference line. A histogram sign flip across it is the oscillator crossing its own signal line.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Underlying oscillator (MACD line) and its signal average
fastMa     = ta.ema(srcInput, fastInput)
slowMa     = ta.ema(srcInput, slowInput)
oscillator = fastMa - slowMa
signalLine = ta.ema(oscillator, signalInput)

//OsMA = oscillator minus its signal line (the spread between the spread and its own average)
osma = oscillator - signalLine

//Bar-to-bar change, na-guarded over the warmup bars
delta = osma - nz(osma[1], osma)

//4-state histogram color: side of zero x growing/fading
osmaColor = osma >= 0 ? (delta >= 0 ? bullGrowInput : bullFadeInput) : (delta <= 0 ? bearGrowInput : bearFadeInput)

//Zero crosses, the signal-line crossover expressed as a sign flip
crossUp   = ta.crossover(osma, 0)
crossDown = ta.crossunder(osma, 0)

//Momentum turns: first shrinking bar after growth, the early deceleration cue that precedes a cross
bullFading = osma > 0 and delta < 0 and nz(delta[1]) >= 0
bearFading = osma < 0 and delta > 0 and nz(delta[1]) <= 0

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
hline(0, "Zero Line", zeroInput, hline.style_dotted)

plot(osma, "OsMA", osmaColor, 1, plot.style_columns)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp,    "Bullish Zero Cross",      "OsMA crossed above zero (oscillator crossed above its signal line) on {{ticker}} - {{interval}}")
alertcondition(crossDown,  "Bearish Zero Cross",      "OsMA crossed below zero (oscillator crossed below its signal line) on {{ticker}} - {{interval}}")
alertcondition(bullFading, "Bullish Momentum Fading", "OsMA bars started shrinking above zero, bullish momentum fading ahead of a potential signal-line cross on {{ticker}} - {{interval}}")
alertcondition(bearFading, "Bearish Momentum Fading", "OsMA bars started shrinking below zero, bearish momentum fading ahead of a potential signal-line cross on {{ticker}} - {{interval}}")

//---------------------------------------------------------------------------------------------------------------------}
