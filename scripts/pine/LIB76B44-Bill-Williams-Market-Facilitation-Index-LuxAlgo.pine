//@version=6
indicator("Bill Williams Market Facilitation Index"
  , shorttitle = "Bill Williams Market Facilitation Index"
  , overlay    = false
  , format     = format.price
  , precision  = 10)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
int STATE_NONE  = 0
int STATE_GREEN = 1
int STATE_FADE  = 2
int STATE_FAKE  = 3
int STATE_SQUAT = 4

color GREEN_COLOR   = #089981 // MFI up, volume up - participated move (bullish for the move)
color FADE_COLOR    = #f23645 // MFI down, volume down - interest draining (brown in the classic palette, bearish for the move here)
color FAKE_COLOR    = #787b86 // MFI up, volume down - movement without backing (blue in the classic palette, unbacked - structure grey here)
color SQUAT_COLOR   = #ff9800 // MFI down, volume up - heavy trade, little range (pink in the classic palette, the one accent here - watch for a turn)
color NEUTRAL_COLOR = color.new(#787b86, 55) // no state - index or volume unchanged, or volume missing

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

string ARROW_UP   = "▲"
string ARROW_DOWN = "▼"
string TXT_NA     = "-"

string GREEN_TIP = "MFI ▲ with volume ▲ - each unit of rising volume is buying more range, a participated move. Strings of green bars describe a facilitated trend."
string FADE_TIP  = "MFI ▼ with volume ▼ - interest draining away, a dying move. Repeated fades describe a market losing its audience; mind scheduled session lulls."
string FAKE_TIP  = "MFI ▲ with volume ▼ - range expanding while volume shrinks, movement without backing and vulnerable to retracing once the thin push exhausts."
string SQUAT_TIP = "Volume ▲ while MFI ▼ - heavy trade producing little range, a battle at one price. Often prints near turns and breakout points without saying which way it resolves."
string NONE_TIP  = "No state - the index or volume is unchanged from the prior bar, or volume data is missing."

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
streakLenInput = input.int(3, "Streak Length", minval = 2, group = "Market Facilitation Index",
     tooltip = "Consecutive bars of the same state that count as a string. Strings are the message rather than single prints - this many green bars in a row describe a facilitated move, this many fades a market losing its audience. Drives the Green Streak and Fade Streak alerts.")

markSquatsInput = input.bool(false, "Mark Squat Bars On Price", group = "Price Chart",
     tooltip = "Draws a small square above price bars where volume rose while the index fell - heavy trade buying little range, the state Williams flagged near turns and breakout points. A squat carries no direction on its own, so confirm with the following bars.")

colorCandlesInput = input.bool(false, "Color Price Bars By State", group = "Price Chart",
     tooltip = "Paints the price bars with the state palette so the four reads can be followed directly on the chart.")

showDashInput = input.bool(true, "Show Dashboard", group = "Dashboard",
     tooltip = "Legend of the four MFI × volume states, with the current bar's state and how many consecutive bars have printed it.")

dashPosInput = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Dashboard",
     tooltip = "Dashboard position on the pane.")

dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = "Dashboard",
     tooltip = "Dashboard text size.")

greenColorInput = input.color(GREEN_COLOR, "Green", group = "Style",
     tooltip = "MFI up with volume up - a participated move.")

fadeColorInput = input.color(FADE_COLOR, "Fade", group = "Style",
     tooltip = "MFI down with volume down - interest draining away. Brown in the classic palette.")

fakeColorInput = input.color(FAKE_COLOR, "Fake", group = "Style",
     tooltip = "MFI up with volume down - movement without backing. Blue in the classic palette.")

squatColorInput = input.color(SQUAT_COLOR, "Squat", group = "Style",
     tooltip = "MFI down with volume up - heavy trade producing little range. Pink in the classic palette.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Unclassified", group = "Style",
     tooltip = "Bars where the index or volume is unchanged from the prior bar, or where volume data is missing.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
//Color associated with a bar state
stateColor(int barState) =>
    barState == STATE_GREEN ? greenColorInput :
      barState == STATE_FADE  ? fadeColorInput  :
      barState == STATE_FAKE  ? fakeColorInput  :
      barState == STATE_SQUAT ? squatColorInput : neutralColorInput

//Display name of a bar state
stateName(int barState) =>
    barState == STATE_GREEN ? "Green" :
      barState == STATE_FADE  ? "Fade"  :
      barState == STATE_FAKE  ? "Fake"  :
      barState == STATE_SQUAT ? "Squat" : "Unclassified"

//Reading attached to a bar state, used as dashboard tooltip
stateTip(int barState) =>
    barState == STATE_GREEN ? GREEN_TIP :
      barState == STATE_FADE  ? FADE_TIP  :
      barState == STATE_FAKE  ? FAKE_TIP  :
      barState == STATE_SQUAT ? SQUAT_TIP : NONE_TIP

//---------------------------------------------------------------------------------------------------------------------}
// Market Facilitation Index
//---------------------------------------------------------------------------------------------------------------------{
float cumulativeVolume = ta.cum(nz(volume))

if barstate.islast and cumulativeVolume == 0
    runtime.error("No volume is available for this symbol. The Market Facilitation Index requires volume data.")

//Range bought per unit of volume - the raw value is scale-dependent, so only its bar-to-bar change is read
bool  hasVolume = not na(volume) and volume > 0
float mfiValue  = hasVolume ? (high - low) / volume : na

//Directions of the index and of volume over the same bar
bool readOk  = not na(mfiValue) and not na(mfiValue[1])
bool mfiUp   = readOk and mfiValue > mfiValue[1]
bool mfiDown = readOk and mfiValue < mfiValue[1]
bool volUp   = readOk and volume > volume[1]
bool volDown = readOk and volume < volume[1]

//The two directions combine into one of the four classic states
int state = STATE_NONE

if mfiUp and volUp
    state := STATE_GREEN
else if mfiDown and volDown
    state := STATE_FADE
else if mfiUp and volDown
    state := STATE_FAKE
else if mfiDown and volUp
    state := STATE_SQUAT

//Strings of the same state are the message, not single prints
var int streak = 0
streak := state == STATE_NONE ? 0 : state == nz(state[1], STATE_NONE) ? streak + 1 : 1

int  statePrev = nz(state[1], STATE_NONE)
bool newGreen  = state == STATE_GREEN and statePrev != STATE_GREEN
bool newFade   = state == STATE_FADE  and statePrev != STATE_FADE
bool newFake   = state == STATE_FAKE  and statePrev != STATE_FAKE
bool newSquat  = state == STATE_SQUAT and statePrev != STATE_SQUAT

bool greenStreakHit = state == STATE_GREEN and streak == streakLenInput
bool fadeStreakHit  = state == STATE_FADE  and streak == streakLenInput

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color stateColorValue = stateColor(state)

plot(mfiValue, "Market Facilitation Index", color = stateColorValue, style = plot.style_columns)

plotshape(markSquatsInput and state == STATE_SQUAT, "Squat Bar Marker", shape.square, location.abovebar, color = squatColorInput, size = size.tiny, force_overlay = true)

barcolor(colorCandlesInput and state != STATE_NONE ? stateColorValue : na, title = "State Bar Coloring")

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
dashPosition = switch dashPosInput
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    =>                position.top_right

dashTextSize = switch dashSizeInput
    "Tiny"   => size.tiny
    "Normal" => size.normal
    =>          size.small

var table dashTable = table.new(dashPosition, 3, 5
  , bgcolor      = DASH_BG
  , border_width = 0
  , frame_color  = DASH_FRAME
  , frame_width  = 1)

if barstate.islast and showDashInput
    color  valueColor = DASH_HEADER
    string streakText = streak > 0 ? "×" + str.tostring(streak) : TXT_NA

    table.cell(dashTable, 0, 0, "BW MFI", text_color = DASH_HEADER, text_halign = text.align_left, text_size = dashTextSize,
         tooltip = "Range per unit of volume, (high - low) / volume. The raw value is scale-dependent, so only its bar-to-bar change is read.")
    table.cell(dashTable, 1, 0, stateName(state), text_color = state == STATE_NONE ? DASH_HEADER : stateColorValue, text_halign = text.align_center, text_size = dashTextSize,
         tooltip = stateTip(state))
    table.cell(dashTable, 2, 0, streakText, text_color = DASH_TEXT, text_halign = text.align_center, text_size = dashTextSize,
         tooltip = "Consecutive bars printing the current state.")

    array<string> legendNames  = array.from("Green", "Fade", "Fake", "Squat")
    array<color>  legendColors = array.from(greenColorInput, fadeColorInput, fakeColorInput, squatColorInput)
    array<string> legendMfi    = array.from(ARROW_UP, ARROW_DOWN, ARROW_UP, ARROW_DOWN)
    array<string> legendVol    = array.from(ARROW_UP, ARROW_DOWN, ARROW_DOWN, ARROW_UP)
    array<string> legendTips   = array.from(GREEN_TIP, FADE_TIP, FAKE_TIP, SQUAT_TIP)

    for i = 0 to 3
        bool  rowActive = state == i + 1
        color rowColor  = array.get(legendColors, i)

        table.cell(dashTable, 0, i + 1, array.get(legendNames, i), text_color = rowColor, text_halign = text.align_left, text_size = dashTextSize, tooltip = array.get(legendTips, i))
        table.cell(dashTable, 1, i + 1, "MFI " + array.get(legendMfi, i), text_color = rowActive ? DASH_TEXT : valueColor, text_halign = text.align_center, text_size = dashTextSize)
        table.cell(dashTable, 2, i + 1, "Vol " + array.get(legendVol, i), text_color = rowActive ? DASH_TEXT : valueColor, text_halign = text.align_center, text_size = dashTextSize)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(newGreen, "Green Bar", "BW MFI turned green on {{ticker}} - the index and volume both rose, a participated move ({{interval}})")
alertcondition(newFade, "Fade Bar", "BW MFI turned fade on {{ticker}} - the index and volume both fell, interest draining away ({{interval}})")
alertcondition(newFake, "Fake Bar", "BW MFI turned fake on {{ticker}} - range expanded while volume fell, movement without backing ({{interval}})")
alertcondition(newSquat, "Squat Bar", "BW MFI turned squat on {{ticker}} - volume rose while range per unit of volume fell, heavy trade going nowhere ({{interval}})")
alertcondition(greenStreakHit, "Green Streak", "BW MFI green streak on {{ticker}} - consecutive participated bars describe a facilitated move ({{interval}})")
alertcondition(fadeStreakHit, "Fade Streak", "BW MFI fade streak on {{ticker}} - repeated fade bars describe a market losing its audience ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
