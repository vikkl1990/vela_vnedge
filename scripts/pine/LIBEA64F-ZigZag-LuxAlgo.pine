//@version=6
indicator("ZigZag", "ZigZag", overlay = true, format = format.price, max_lines_count = 500)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
MAX_LINES = 500
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
deviationInput = input.float(5.0, "Deviation (%)", minval = 0.01, step = 0.1, group = "Settings",
  tooltip = "Minimum reversal from the leg extreme, as a percentage of that extreme, required to confirm a new pivot.")

depthInput = input.int(10, "Depth", minval = 2, group = "Settings",
  tooltip = "Minimum number of bars required between two consecutive pivots.")

bullColorInput = input.color(#089981, "Up Leg", inline = "line", group = "Style",
  tooltip = "Color of rising zigzag segments.")

bearColorInput = input.color(#f23645, "Down Leg", inline = "line", group = "Style",
  tooltip = "Color of falling zigzag segments.")

lineWidthInput = input.int(2, "Width", minval = 1, inline = "line", group = "Style",
  tooltip = "Width of the zigzag segments.")
//----------------------------------------------------------------------------------------------------------------------}
// Functions
//----------------------------------------------------------------------------------------------------------------------{
newLeg(zzArray, x1, y1, x2, y2) =>
    if array.size(zzArray) >= MAX_LINES
        line.delete(array.shift(zzArray))
    legId = line.new(x1, y1, x2, y2, color = y2 >= y1 ? bullColorInput : bearColorInput, width = lineWidthInput)
    array.push(zzArray, legId)
    legId
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
var int   legDir        = 0
var float legExtreme    = na
var int   legExtremeBar = na
var float lastPivot     = na
var int   lastPivotBar  = na
var float seedHigh      = na
var int   seedHighBar   = na
var float seedLow       = na
var int   seedLowBar    = na
var line  activeLineId  = na

var array<line> zigzagArray = array.new<line>()

bool swingHighConfirmed = false
bool swingLowConfirmed  = false

// Direction seeds on the first countermove exceeding the deviation threshold; afterwards the newest leg stays
// provisional: its endpoint follows each new extreme until the opposite countermove confirms it as a pivot.
if legDir == 0
    if na(seedHigh) or high > seedHigh
        seedHigh    := high
        seedHighBar := bar_index
    if na(seedLow) or low < seedLow
        seedLow    := low
        seedLowBar := bar_index
    if seedHigh - low >= seedHigh * deviationInput / 100
        lastPivot          := seedHigh
        lastPivotBar       := seedHighBar
        legDir             := -1
        legExtreme         := low
        legExtremeBar      := bar_index
        activeLineId       := newLeg(zigzagArray, lastPivotBar, lastPivot, legExtremeBar, legExtreme)
        swingHighConfirmed := true
    else if high - seedLow >= seedLow * deviationInput / 100
        lastPivot         := seedLow
        lastPivotBar      := seedLowBar
        legDir            := 1
        legExtreme        := high
        legExtremeBar     := bar_index
        activeLineId      := newLeg(zigzagArray, lastPivotBar, lastPivot, legExtremeBar, legExtreme)
        swingLowConfirmed := true
else if legDir == 1
    if high > legExtreme
        legExtreme    := high
        legExtremeBar := bar_index
        line.set_xy2(activeLineId, legExtremeBar, legExtreme)
    else if legExtreme - low >= legExtreme * deviationInput / 100 and legExtremeBar - lastPivotBar >= depthInput
        lastPivot          := legExtreme
        lastPivotBar       := legExtremeBar
        legDir             := -1
        legExtreme         := low
        legExtremeBar      := bar_index
        activeLineId       := newLeg(zigzagArray, lastPivotBar, lastPivot, legExtremeBar, legExtreme)
        swingHighConfirmed := true
else
    if low < legExtreme
        legExtreme    := low
        legExtremeBar := bar_index
        line.set_xy2(activeLineId, legExtremeBar, legExtreme)
    else if high - legExtreme >= legExtreme * deviationInput / 100 and legExtremeBar - lastPivotBar >= depthInput
        lastPivot         := legExtreme
        lastPivotBar      := legExtremeBar
        legDir            := 1
        legExtreme        := high
        legExtremeBar     := bar_index
        activeLineId      := newLeg(zigzagArray, lastPivotBar, lastPivot, legExtremeBar, legExtreme)
        swingLowConfirmed := true
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(swingHighConfirmed, "New Swing High", "ZigZag: new confirmed swing high")
alertcondition(swingLowConfirmed, "New Swing Low", "ZigZag: new confirmed swing low")
//----------------------------------------------------------------------------------------------------------------------}
