//@version=6
indicator("Elder Ray", "Elder Ray", overlay = false, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
emaLengthInput = input.int(13, "EMA Length", minval = 1, group = "Settings", tooltip = "Number of bars in the exponential moving average of closing prices used as the reference level for Bull Power and Bear Power. Alexander Elder's classic setting is 13.")

bullColorInput = input.color(#089981, "Bull Power", group = "Style", tooltip = "Color of the Bull Power columns.")
bearColorInput = input.color(#f23645, "Bear Power", group = "Style", tooltip = "Color of the Bear Power columns.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
emaValue = ta.ema(close, emaLengthInput)

bullPower = high - emaValue
bearPower = low - emaValue
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(bullPower, "Bull Power", bullColorInput, style = plot.style_columns)
plot(bearPower, "Bear Power", bearColorInput, style = plot.style_columns)

hline(0, "Zero Line", color.new(chart.fg_color, 30), hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(ta.cross(bullPower, 0), "Bull Power Zero Cross", "Bull Power crossed the zero line")
alertcondition(ta.cross(bearPower, 0), "Bear Power Zero Cross", "Bear Power crossed the zero line")
//----------------------------------------------------------------------------------------------------------------------}
