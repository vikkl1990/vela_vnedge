//@version=6
indicator("Stochastic", "Stoch", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
K_COLOR    = #5b9cf6
D_COLOR    = #ff9800
BAND_COLOR = #787b86

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthKInput = input.int(14, "%K Length", minval = 1, group = "Settings", tooltip = "Number of bars used for the highest high / lowest low range of the raw %K.")
smoothKInput = input.int(3, "%K Smoothing", minval = 1, group = "Settings", tooltip = "Simple moving average length applied to the raw %K. 1 gives the fast stochastic, 3 the classic slow stochastic.")
smoothDInput = input.int(3, "%D Smoothing", minval = 1, group = "Settings", tooltip = "Simple moving average length of the %D signal line, applied to the smoothed %K.")
obLevelInput = input.float(80, "Overbought Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level above which the oscillator is considered overbought.")
osLevelInput = input.float(20, "Oversold Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level below which the oscillator is considered oversold.")

kColorInput    = input.color(K_COLOR, "%K", group = "Style", tooltip = "Color of the %K line.")
dColorInput    = input.color(D_COLOR, "%D", group = "Style", tooltip = "Color of the %D signal line.")
fillColorInput = input.color(color.new(K_COLOR, 90), "Band Fill", group = "Style", tooltip = "Fill color of the area between the overbought and oversold levels.")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
rawK     = ta.stoch(close, high, low, lengthKInput)
percentK = ta.sma(rawK, smoothKInput)
percentD = ta.sma(percentK, smoothDInput)

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(percentK, "%K", kColorInput)
plot(percentD, "%D", dColorInput)

obHlineId = hline(obLevelInput, "Overbought Level", BAND_COLOR, hline.style_dashed)
osHlineId = hline(osLevelInput, "Oversold Level", BAND_COLOR, hline.style_dashed)
fill(obHlineId, osHlineId, fillColorInput, "Overbought/Oversold Band")

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
bullishCross    = ta.crossover(percentK, percentD)
bearishCross    = ta.crossunder(percentK, percentD)
overboughtEnter = ta.crossover(percentK, obLevelInput)
overboughtExit  = ta.crossunder(percentK, obLevelInput)
oversoldEnter   = ta.crossunder(percentK, osLevelInput)
oversoldExit    = ta.crossover(percentK, osLevelInput)

alertcondition(bullishCross, "Bullish %K/%D Cross", "Stochastic %K crossed above %D")
alertcondition(bearishCross, "Bearish %K/%D Cross", "Stochastic %K crossed below %D")
alertcondition(overboughtEnter, "Overbought Enter", "Stochastic %K crossed above the overbought level")
alertcondition(overboughtExit, "Overbought Exit", "Stochastic %K crossed below the overbought level")
alertcondition(oversoldEnter, "Oversold Enter", "Stochastic %K crossed below the oversold level")
alertcondition(oversoldExit, "Oversold Exit", "Stochastic %K crossed above the oversold level")

//----------------------------------------------------------------------------------------------------------------------}
