//@version=6
indicator("VT VWAP Suite [ValieTrades]", shorttitle="VT VWAP Suite", overlay=true)

// ─────────────────────────────────────────────────────────────────────────────
// VT VWAP Suite
// A clean intraday context tool. It does not generate trade recommendations.
// Completed historical values do not repaint. The active VWAP develops as new
// price and volume data enters the current day, week, month, or custom session.
// ─────────────────────────────────────────────────────────────────────────────

string GROUP_VWAPS   = "VWAPs"
string GROUP_SESSION = "Custom Session"
string GROUP_BANDS   = "Deviation Bands"
string GROUP_CONTEXT = "Display & Alerts"
string GROUP_COLORS  = "Colors"

// Core VWAPs
bool showDaily   = input.bool(true,  "Daily VWAP",  tooltip="Volume-weighted average price that resets at the start of each trading day.", group=GROUP_VWAPS)
bool showWeekly  = input.bool(true,  "Weekly VWAP", tooltip="Volume-weighted average price that resets at the start of each trading week.", group=GROUP_VWAPS)
bool showMonthly = input.bool(false, "Monthly VWAP", tooltip="Volume-weighted average price that resets at the start of each trading month.", group=GROUP_VWAPS)
bool showSession = input.bool(false, "Custom Session VWAP", tooltip="A separate VWAP calculated only from bars inside your selected session.", group=GROUP_VWAPS)

// Custom session
string sessionHours    = input.session("0930-1600", "Session", tooltip="Start and end time used for the Custom Session VWAP.", group=GROUP_SESSION)
string sessionTimezone = input.string("America/New_York", "Time zone", options=["America/New_York", "Europe/Zurich", "Etc/UTC", "Europe/London", "Asia/Tokyo"], tooltip="Time zone used to interpret the custom session. Named zones adjust automatically for daylight saving time.", group=GROUP_SESSION)

// Simple Daily VWAP deviation bands with fixed, standard multipliers.
bool showBand1 = input.bool(false, "Show Band 1 (±1 SD)", tooltip="Shows the first standard deviation band around the Daily VWAP.", group=GROUP_BANDS)
bool showBand2 = input.bool(false, "Show Band 2 (±2 SD)", tooltip="Shows the second standard deviation band around the Daily VWAP.", group=GROUP_BANDS)

// Display and alerts
bool showDashboard = input.bool(true, "Show dashboard", tooltip="Displays the current price location relative to each VWAP. This is market information, not a trade signal.", group=GROUP_CONTEXT)
string dashboardSize = input.string("Normal", "Dashboard size", options=["Small", "Normal", "Large"], tooltip="Changes the text size of the entire dashboard. Normal is the default.", group=GROUP_CONTEXT)
bool showReactions = input.bool(true, "Show VWAP reaction markers", tooltip="Marks confirmed candles that touch the selected VWAP and close away from it with directional rejection. These are context markers, not entry signals.", group=GROUP_CONTEXT)
string reactionBasis = input.string("Daily VWAP", "Reaction VWAP", options=["Daily VWAP", "Weekly VWAP", "Monthly VWAP", "Custom Session VWAP"], tooltip="Selects which VWAP is evaluated for reaction markers and alerts.", group=GROUP_CONTEXT)

// Colors
color dailyColor   = input.color(color.rgb(47, 107, 255), "Daily VWAP", group=GROUP_COLORS)
color weeklyColor  = input.color(color.rgb(242, 184, 75), "Weekly VWAP", group=GROUP_COLORS)
color monthlyColor = input.color(color.rgb(177, 106, 255), "Monthly VWAP", group=GROUP_COLORS)
color sessionColor = input.color(color.rgb(42, 201, 176), "Custom Session VWAP", group=GROUP_COLORS)
color bullishColor = color.rgb(38, 198, 142)
color bearishColor = color.rgb(239, 83, 80)

float source = hlc3
float barVolume = nz(volume, 0.0)

// Anchored VWAP calculations. The returned bands provide the weighted standard
// deviation for the selected anchor period.
bool newDay   = timeframe.change("1D")
bool newWeek  = timeframe.change("1W")
bool newMonth = timeframe.change("1M")

[dailyVWAP, dailyUpper1, dailyLower1]  = ta.vwap(source, newDay, 1.0)
[dailyVWAP2, dailyUpper2, dailyLower2] = ta.vwap(source, newDay, 2.0)
weeklyVWAP  = ta.vwap(source, newWeek)
monthlyVWAP = ta.vwap(source, newMonth)

// Custom-session VWAP. Only bars inside the selected session contribute.
bool inSession  = not na(time(timeframe.period, sessionHours, sessionTimezone))
bool newSession = inSession and not inSession[1]

var float sessionPV  = 0.0
var float sessionVol = 0.0

if newSession
    sessionPV  := source * barVolume
    sessionVol := barVolume
else if inSession
    sessionPV  += source * barVolume
    sessionVol += barVolume

float sessionVWAP = inSession and sessionVol > 0.0 ? sessionPV / sessionVol : na

// Main lines
plot(showDaily ? dailyVWAP : na, "Daily VWAP", color=dailyColor, linewidth=2)
plot(showWeekly ? weeklyVWAP : na, "Weekly VWAP", color=weeklyColor, linewidth=2)
plot(showMonthly ? monthlyVWAP : na, "Monthly VWAP", color=monthlyColor, linewidth=2)
plot(showSession ? sessionVWAP : na, "Custom Session VWAP", color=sessionColor, linewidth=2, style=plot.style_linebr)

// Both bands are anchored automatically to the Daily VWAP.
band1UpperPlot = plot(showBand1 ? dailyUpper1 : na, "Daily Upper Band 1", color=color.new(dailyColor, 35), linewidth=1)
band1LowerPlot = plot(showBand1 ? dailyLower1 : na, "Daily Lower Band 1", color=color.new(dailyColor, 35), linewidth=1)
band2UpperPlot = plot(showBand2 ? dailyUpper2 : na, "Daily Upper Band 2", color=color.new(dailyColor, 55), linewidth=1)
band2LowerPlot = plot(showBand2 ? dailyLower2 : na, "Daily Lower Band 2", color=color.new(dailyColor, 55), linewidth=1)
fill(band1UpperPlot, band1LowerPlot, color=color.new(dailyColor, 92), title="Band 1 Fill")
fill(band2UpperPlot, band2LowerPlot, color=color.new(dailyColor, 96), title="Band 2 Fill")

// A reaction requires a touch of the chosen VWAP and a directional close away
// from it. Candle quality, distance, optional volume, VWAP direction, and a
// marker cooldown prevent clusters of weak reactions.
float reactionVWAP = switch reactionBasis
    "Weekly VWAP"        => weeklyVWAP
    "Monthly VWAP"       => monthlyVWAP
    "Custom Session VWAP" => sessionVWAP
    => dailyVWAP

float candleRange = high - low
float closeLocation = candleRange > 0.0 ? (close - low) / candleRange : 0.5
float bodyRatio = candleRange > 0.0 ? math.abs(close - open) / candleRange : 0.0
float atrValue = ta.atr(14)
float reactionDistance = not na(atrValue) and atrValue > 0.0 ? math.abs(close - reactionVWAP) / atrValue : 0.0
float averageVolume = ta.sma(volume, 20)
bool volumeAvailable = not na(volume) and not na(averageVolume) and averageVolume > 0.0
bool averageVolumeMet = not volumeAvailable or volume >= averageVolume

bool reactionReset = switch reactionBasis
    "Weekly VWAP"         => newWeek
    "Monthly VWAP"        => newMonth
    "Custom Session VWAP" => newSession
    => newDay

bool reactionVWAPRising = not reactionReset and not na(reactionVWAP[1]) and reactionVWAP > reactionVWAP[1]
bool reactionVWAPFalling = not reactionReset and not na(reactionVWAP[1]) and reactionVWAP < reactionVWAP[1]

bool bullishTouch = not na(reactionVWAP) and low <= reactionVWAP and close > reactionVWAP and close > open and closeLocation >= 0.65
bool bearishTouch = not na(reactionVWAP) and high >= reactionVWAP and close < reactionVWAP and close < open and closeLocation <= 0.35
bool bullishStrongQuality = bodyRatio >= 0.40 and reactionDistance >= 0.08 and averageVolumeMet and reactionVWAPRising
bool bearishStrongQuality = bodyRatio >= 0.40 and reactionDistance >= 0.08 and averageVolumeMet and reactionVWAPFalling

int reactionCooldown = 3
var int lastReactionBar = na
bool cooldownPassed = na(lastReactionBar) or bar_index - lastReactionBar > reactionCooldown
bool bullishReaction = barstate.isconfirmed and cooldownPassed and bullishTouch and bullishStrongQuality
bool bearishReaction = barstate.isconfirmed and cooldownPassed and bearishTouch and bearishStrongQuality

if bullishReaction or bearishReaction
    lastReactionBar := bar_index

plotshape(showReactions and bullishReaction, title="Bullish VWAP Reaction", style=shape.arrowup, location=location.belowbar, color=bullishColor, size=size.tiny)
plotshape(showReactions and bearishReaction, title="Bearish VWAP Reaction", style=shape.arrowdown, location=location.abovebar, color=bearishColor, size=size.tiny)

alertcondition(bullishReaction, "Bullish VWAP Reaction", "{{ticker}} confirmed a bullish reaction at the selected VT VWAP on {{interval}}.")
alertcondition(bearishReaction, "Bearish VWAP Reaction", "{{ticker}} confirmed a bearish reaction at the selected VT VWAP on {{interval}}.")

// Daily VWAP direction is shown separately from price location. For example,
// price can be above the VWAP while new volume pulls the VWAP downward.
bool dailyRising  = not newDay and not na(dailyVWAP[1]) and dailyVWAP > dailyVWAP[1]
bool dailyFalling = not newDay and not na(dailyVWAP[1]) and dailyVWAP < dailyVWAP[1]

f_relation(float level) =>
    na(level) ? "N/A" : close > level ? "Above" : close < level ? "Below" : "At VWAP"

f_relation_color(float level) =>
    na(level) ? color.gray : close > level ? bullishColor : close < level ? bearishColor : color.gray

f_timeframe_label() =>
    string label = timeframe.period
    if timeframe.isseconds
        label := str.tostring(timeframe.multiplier) + "S"
    else if timeframe.isminutes
        label := timeframe.multiplier % 60 == 0 ? str.tostring(int(timeframe.multiplier / 60)) + "H" : str.tostring(timeframe.multiplier) + "M"
    else if timeframe.isdaily
        label := str.tostring(timeframe.multiplier) + "D"
    else if timeframe.isweekly
        label := str.tostring(timeframe.multiplier) + "W"
    else if timeframe.ismonthly
        label := str.tostring(timeframe.multiplier) + "MO"
    label

string dailySlopeText = dailyRising ? " · VWAP ↑" : dailyFalling ? " · VWAP ↓" : " · VWAP →"
string dashboardTextSize = dashboardSize == "Small" ? size.small : dashboardSize == "Large" ? size.large : size.normal
string chartTimeframeLabel = f_timeframe_label()

var table dashboard = table.new(position.top_right, 2, 5, bgcolor=color.new(color.rgb(11, 22, 38), 8), frame_color=color.new(color.white, 80), frame_width=1, border_width=0)

if barstate.islast and showDashboard
    table.cell(dashboard, 0, 0, "VT VWAP SUITE", text_color=color.white, text_size=dashboardTextSize, bgcolor=color.rgb(7, 17, 31))
    table.cell(dashboard, 1, 0, chartTimeframeLabel, text_color=color.new(color.white, 25), text_size=dashboardTextSize, bgcolor=color.rgb(7, 17, 31))
    table.cell(dashboard, 0, 1, "Daily VWAP", text_color=dailyColor, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 1, f_relation(dailyVWAP) + dailySlopeText, text_color=f_relation_color(dailyVWAP), text_size=dashboardTextSize)
    table.cell(dashboard, 0, 2, "Weekly VWAP", text_color=weeklyColor, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 2, f_relation(weeklyVWAP), text_color=f_relation_color(weeklyVWAP), text_size=dashboardTextSize)
    table.cell(dashboard, 0, 3, "Monthly VWAP", text_color=monthlyColor, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 3, f_relation(monthlyVWAP), text_color=f_relation_color(monthlyVWAP), text_size=dashboardTextSize)
    if showSession
        table.cell(dashboard, 0, 4, "Session VWAP", text_color=sessionColor, text_size=dashboardTextSize)
        table.cell(dashboard, 1, 4, f_relation(sessionVWAP), text_color=f_relation_color(sessionVWAP), text_size=dashboardTextSize)
    else
        table.clear(dashboard, 0, 4, 1, 4)

if barstate.islast and not showDashboard
    table.clear(dashboard, 0, 0, 1, 4)
