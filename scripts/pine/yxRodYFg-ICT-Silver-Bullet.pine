//@version=6
indicator("ICT Silver Bullet", shorttitle="Silver-Bullet", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

validTimeframe = timeframe.in_seconds() / 60 == 1 or timeframe.in_seconds() / 60 == 3 or timeframe.in_seconds() / 60 == 5

grp_gen = "1. General Settings"
i_bias         = input.string("All", "Bias Filter & Timeframe", group=grp_gen, options=["All", "Bullish", "Bearish"], inline="bias")
i_biasTF       = input.timeframe("15", "", group=grp_gen, inline="bias")
i_status       = input.string("All", "Status Filter & Max History", group=grp_gen, options=["All", "Active", "Formation Only", "Success Only"], inline="stat")
i_maxModels    = input.int(2, "", group=grp_gen, minval=1, maxval=10, inline="stat")
i_discardInval = input.bool(false, "Delete Invalidated Models", group=grp_gen)

grp_exec = "2. Execution Settings"
i_execTF      = input.string("1", "Timeframe", group=grp_exec, options=["1", "3", "5"])
i_requireZone = input.bool(true, "Require FVG Confluence (Lookback)", group=grp_exec, inline="fvg_req")
i_ltfLookback = input.int(10, "", group=grp_exec, minval=3, maxval=40, inline="fvg_req")

grp_kz = "3. Killzone Sessions"
i_useLondon  = input.bool(true, "London Session", group=grp_kz, inline="kz1")
i_londonSess = input.session("0300-0400", "", group=grp_kz, inline="kz1")

i_useNYAM    = input.bool(true, "NY AM Session ", group=grp_kz, inline="kz2")
i_nyAmSess   = input.session("1000-1100", "", group=grp_kz, inline="kz2")

i_useNYPM    = input.bool(true, "NY PM Session ", group=grp_kz, inline="kz3")
i_nyPmSess   = input.session("1400-1500", "", group=grp_kz, inline="kz3")

i_showKzShade = input.bool(true, "Show Bracket (Line / Text Col)", group=grp_kz, inline="kzL1")
i_kzLineColor = input.color(color.new(#000000, 0), "", group=grp_kz, inline="kzL1")
i_kzTextColor = input.color(color.new(#000000, 0), "", group=grp_kz, inline="kzL1")
i_kzLineStyle = input.string("Solid", "Bracket Line (Style / Width)", group=grp_kz, options=["Solid", "Dashed", "Dotted"], inline="kzL2")
i_kzLineWidth = input.int(2, "", group=grp_kz, inline="kzL2", minval=1, maxval=3)

i_showKzZoneBox = input.bool(false, "Show Zone Shading (Color / Opacity)", group=grp_kz, inline="kzZ")
i_kzZoneColor   = input.color(color.new(#b8b8b8, 0), "", group=grp_kz, inline="kzZ")
i_kzZoneTransp  = input.int(88, "", group=grp_kz, inline="kzZ", minval=0, maxval=100)

grp_swp = "4. Sweep & Liquidity"
i_showSweep   = input.bool(true, "Show Sweep Line (Lookback)", group=grp_swp, inline="swp_gen")
i_swingLen    = input.int(6, "", group=grp_swp, minval=2, maxval=50, inline="swp_gen")

i_bullSwpColor= input.color(color.new(#000000, 0), "Bullish Line (Color / Width)", group=grp_swp, inline="swp_bull")
i_swpLineWidth= input.int(1, "", group=grp_swp, inline="swp_bull", minval=1, maxval=4)

i_bearSwpColor= input.color(color.new(#000000, 0), "Bearish Line (Color)", group=grp_swp, inline="swp_bear")

i_showSArea      = input.bool(true, "Sweep Box (Extend / Opacity)", group=grp_swp, inline="swp_box")
i_extendSweepBox = input.bool(false, "", group=grp_swp, inline="swp_box")
i_swpZoneTransp  = input.int(88, "", group=grp_swp, minval=0, maxval=100, inline="swp_box")

i_sweepPointSize      = input.string("Small", "Sweep Point (Size / Bull / Bear)", group=grp_swp, options=["Tiny", "Small", "Normal", "Large"], inline="swp_pt")
i_sweepPointBullColor = input.color(color.new(#089981, 0), "", group=grp_swp, inline="swp_pt")
i_sweepPointBearColor = input.color(color.new(#f23645, 0), "", group=grp_swp, inline="swp_pt")

grp_mss = "5. Market Structure Shift"
i_showMSS     = input.bool(true, "Show MSS Break (Confirm / Window)", group=grp_mss, inline="mss_m1")
i_mssConfirm  = input.string("Close", "", group=grp_mss, options=["Close", "Wick"], inline="mss_m1")
i_mssMaxBars  = input.int(30, "", group=grp_mss, minval=5, maxval=200, inline="mss_m1")

i_mssLeft     = input.int(2, "Pivot Lookback (Left / Right)", group=grp_mss, inline="mss_piv", minval=1)
i_mssRight    = input.int(2, "", group=grp_mss, inline="mss_piv", minval=1)

i_bullMssCol  = input.color(color.new(#089981, 0), "Bull MSS (Color / Style / Width)", group=grp_mss, inline="mss_bull")
i_mssLineStyle= input.string("Solid", "", group=grp_mss, inline="mss_bull", options=["Solid", "Dashed", "Dotted"])
i_mssLineWidth= input.int(1, "", group=grp_mss, inline="mss_bull", minval=1, maxval=4)

i_bearMssCol  = input.color(color.new(#f23645, 0), "Bear MSS (Color)", group=grp_mss, inline="mss_bear")

grp_fvg = "6. FVG Entry Zone"
i_extendFVGZone = input.bool(false, "Extended FVG Mode", group=grp_fvg)
i_fvgBullColor  = input.color(color.new(#089981, 60), "Zone Color (Bull / Bear)", group=grp_fvg, inline="fvg_col")
i_fvgBearColor  = input.color(color.new(#f23645, 60), "", group=grp_fvg, inline="fvg_col")

i_showZoneCE    = input.bool(true, "Center Line (Style / Width)", group=grp_fvg, inline="fvg_ce")
i_zoneCeStyle   = input.string("Dotted", "", group=grp_fvg, options=["Solid", "Dashed", "Dotted"], inline="fvg_ce")
i_zoneCeWidth   = input.int(1, "", group=grp_fvg, inline="fvg_ce", minval=1, maxval=4)

grp_risk = "7. Risk & Target"
i_rrEntryMode = input.string("MSS Close", "Entry Ref / Target Ratio", group=grp_risk, options=["MSS Close", "FVG Retest Entry"], inline="rr_m")
i_rrTarget    = input.float(2.0, "", group=grp_risk, minval=0.1, inline="rr_m")

i_showRRLine  = input.bool(true, "RR Line (Line / Text Col)", group=grp_risk, inline="rr_L")
i_rrLineColor = input.color(color.new(#000000, 0), "", group=grp_risk, inline="rr_L")
i_rrTextColor = input.color(color.new(#000000, 0), "", group=grp_risk, inline="rr_L")
i_rrLineStyle = input.string("Dotted", "RR Line (Style / Width / Len)", group=grp_risk, options=["Solid", "Dashed", "Dotted"], inline="rr_L2")
i_rrLineWidth = input.int(1, "", group=grp_risk, inline="rr_L2", minval=1, maxval=4)
i_rrLineBars  = input.int(2, "", group=grp_risk, minval=1, maxval=50, inline="rr_L2")

i_entryMarkerSize = input.string("Auto", "Marker (Size / Bull / Bear)", group=grp_risk, options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], inline="ent_mk")
i_entryBullColor  = input.color(color.new(#089981, 0), "", group=grp_risk, inline="ent_mk")
i_entryBearColor  = input.color(color.new(#f23645, 0), "", group=grp_risk, inline="ent_mk")

grp_htf = "8. HTF Candle Panel"
i_showHTFCandles= input.bool(true, "Show Panel (Auto / Manual TF)", group=grp_htf, inline="htf_s")
i_htfAuto       = input.bool(true, "", group=grp_htf, inline="htf_s")
i_htfManualTF   = input.timeframe("15", "", group=grp_htf, inline="htf_s")

i_htfCount      = input.int(6, "Count / Width / Space / Offset", group=grp_htf, minval=2, maxval=6, inline="htf_d")
i_htfSize       = input.int(2, "", group=grp_htf, minval=2, maxval=20, inline="htf_d")
i_htfSpace      = input.int(1, "", group=grp_htf, minval=0, maxval=10, inline="htf_d")
i_htfOffset     = input.int(15, "", group=grp_htf, minval=1, inline="htf_d")

i_htfBullBody   = input.color(color.new(#83b785, 0), "Bull Candle (Body / Border)", group=grp_htf, inline="htf_bc")
i_htfBullBorder = input.color(color.new(#5f5f5f, 0), "", group=grp_htf, inline="htf_bc")

i_htfBearBody   = input.color(color.new(#5f5f5f, 0), "Bear Candle (Body / Border)", group=grp_htf, inline="htf_brc")
i_htfBearBorder = input.color(color.new(#5f5f5f, 0), "", group=grp_htf, inline="htf_brc")

grp_dash = "9. Dashboard"
i_showDashboard = input.bool(true, "Show Dashboard (Location)", group=grp_dash, inline="dash_1")
i_dashPosition  = input.string("Bottom Right", "", group=grp_dash, options=["Top Right", "Top Left", "Top Center", "Bottom Right", "Bottom Left", "Bottom Center"], inline="dash_1")

i_dashHeaderSz  = input.string("Normal", "Sizes (Header / Row)", group=grp_dash, options=["Small", "Normal", "Large"], inline="dash_2")
i_dashRowSz     = input.string("Small", "", group=grp_dash, options=["Tiny", "Small", "Normal"], inline="dash_2")

i_dashBg        = input.color(color.new(#e2e2e2, 100), "Colors (BG / Text / Border)", group=grp_dash, inline="dash_3")
i_dashText      = input.color(color.new(#000000, 0), "", group=grp_dash, inline="dash_3")
i_dashBorder    = input.color(color.new(#000000, 100), "", group=grp_dash, inline="dash_3")

grp_alert = "10. Alerts"
i_alertOnSweep  = input.bool(true, "Alert on Sweep", group=grp_alert, inline="al1")
i_alertOnMSS    = input.bool(true, "MSS", group=grp_alert, inline="al1")
i_alertOnEntry  = input.bool(true, "Entry", group=grp_alert, inline="al1")
i_alertOnSucc   = input.bool(true, "Alert on Target", group=grp_alert, inline="al2")
i_alertOnInvalid= input.bool(true, "Invalidation", group=grp_alert, inline="al2")

type SwingPoint
    float price
    int   barIndex
    bool  taken = false

type SBModel
    bool    isBull
    int     sweepBar
    float   sweepLevel
    float   sweepExtreme
    int     swingBar       = na
    int     mssBar         = na
    int     mssMidBar      = na
    float   mssLevel       = na
    bool    mssConfirmed   = false
    bool    zoneConfluence = false
    float   zoneTop        = na
    float   zoneBot        = na
    int     zoneBar        = na
    string  status         = "Formation"
    int     entryBar       = na
    float   entryPrice     = na
    float   slPrice        = na
    float   tpPrice        = na
    float   rrEntryRef     = na
    int     successBar     = na
    int     invalidBar     = na
    line    sweepLine      = na
    label   sweepLabel     = na
    line    mssLine        = na
    label   mssLabel       = na
    box     sArea          = na
    box     zoneBox        = na
    line    zoneCe         = na
    label   entryMarker    = na
    line    rrLine         = na
    label   rrLabel        = na

f_labelSize(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large

f_lineStyle(s) =>
    s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed

f_fmtRR(float r) =>
    string _s = r == math.round(r) ? str.tostring(math.round(r)) : str.tostring(r)
    _s + "R"

f_markerSize(string s) =>
    s == "Auto" ? size.auto : s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge

f_tablePos(p) =>
    switch p
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right

f_inSess(s) => not na(time(timeframe.period, s, "America/New_York"))

f_fmtTF(tf) =>
    _s = timeframe.in_seconds(tf)
    _s < 60     ? str.tostring(math.round(_s)) + "s" :
     _s < 3600   ? str.tostring(math.round(_s/60)) + "m" :
     _s < 86400  ? str.tostring(math.round(_s/3600)) + "H" :
     _s < 604800 ? str.tostring(math.round(_s/86400)) + "D" :
     _s < 2592000? str.tostring(math.round(_s/604800)) + "W" : str.tostring(math.round(_s/2592000)) + "M"

f_fmtHM(string hhmm) =>
    int _hh = int(str.tonumber(str.substring(hhmm, 0, 2)))
    int _mm = int(str.tonumber(str.substring(hhmm, 2, 4)))
    string _ampm = _hh >= 12 ? "PM" : "AM"
    int _hh12 = _hh % 12
    _hh12 := _hh12 == 0 ? 12 : _hh12
    string _mmStr = _mm < 10 ? "0" + str.tostring(_mm) : str.tostring(_mm)
    str.tostring(_hh12) + ":" + _mmStr + " " + _ampm

f_fmtSession(string sess) =>
    string _start = str.substring(sess, 0, 4)
    string _end   = str.substring(sess, 5, 9)
    "(" + f_fmtHM(_start) + " - " + f_fmtHM(_end) + ")"

inLondonKZ = f_inSess(i_londonSess)
inNYAMKZ   = f_inSess(i_nyAmSess)
inNYPMKZ   = f_inSess(i_nyPmSess)

anyKzSelected = i_useLondon or i_useNYAM or i_useNYPM
kzActive      = (i_useLondon and inLondonKZ) or (i_useNYAM and inNYAMKZ) or (i_useNYPM and inNYPMKZ)

allowNewModel = validTimeframe and anyKzSelected and kzActive

bgcolor(validTimeframe and i_showKzZoneBox and kzActive ? color.new(i_kzZoneColor, i_kzZoneTransp) : na, title = "Killzone Zone Shading")

kzBuffer       = ta.atr(14) * 0.5
f_kzGrow(float curTop) =>
    float _candidate = high + kzBuffer
    na(curTop) or _candidate > curTop ? _candidate : curTop

type KzSession
    line  ln  = na
    label lbl = na
    float top = na

var KzSession kzLondon = KzSession.new()
var KzSession kzNYAM   = KzSession.new()
var KzSession kzNYPM   = KzSession.new()

f_updateKzSession(KzSession s, bool active, bool activePrev, string label_, string sess) =>
    if not activePrev and active
        if not na(s.ln)
            line.delete(s.ln)
        if not na(s.lbl)
            label.delete(s.lbl)
        s.top := high + kzBuffer * 2
        s.ln  := line.new(bar_index, s.top, bar_index + 1, s.top, color = i_kzLineColor, width = i_kzLineWidth, style = f_lineStyle(i_kzLineStyle))
        s.lbl := label.new(bar_index, s.top, label_ + " SB " + f_fmtSession(sess),
             style = label.style_label_down, color = color.new(color.white, 100),
             textcolor = i_kzTextColor, size = size.small)
    if active and not na(s.ln)
        s.top := f_kzGrow(s.top)
        line.set_x2(s.ln, bar_index + 1)
        label.set_x(s.lbl, math.round(math.avg(line.get_x1(s.ln), bar_index)))
        line.set_y1(s.ln, s.top)
        line.set_y2(s.ln, s.top)
        label.set_y(s.lbl, s.top)
        line.set_color(s.ln, i_kzLineColor)
        line.set_width(s.ln, i_kzLineWidth)
        line.set_style(s.ln, f_lineStyle(i_kzLineStyle))
        label.set_textcolor(s.lbl, i_kzTextColor)

if validTimeframe and i_showKzShade and i_useLondon
    f_updateKzSession(kzLondon, inLondonKZ, inLondonKZ[1], "London", i_londonSess)

if validTimeframe and i_showKzShade and i_useNYAM
    f_updateKzSession(kzNYAM, inNYAMKZ, inNYAMKZ[1], "NY AM", i_nyAmSess)

if validTimeframe and i_showKzShade and i_useNYPM
    f_updateKzSession(kzNYPM, inNYPMKZ, inNYPMKZ[1], "NY PM", i_nyPmSess)

f_activeKzName() =>
    string _n = "None"
    if i_useLondon and inLondonKZ
        _n := "London SB"
    else if i_useNYAM and inNYAMKZ
        _n := "NY AM SB"
    else if i_useNYPM and inNYPMKZ
        _n := "NY PM SB"
    _n

[bias_c0, bias_c1, bias_o0] = request.security(syminfo.tickerid, i_biasTF,
     [close[0], close[1], open[0]], lookahead = barmerge.lookahead_off)

htfIsBullish = bias_c0 > bias_c1 and bias_c0 > bias_o0
htfIsBearish = bias_c0 < bias_c1 and bias_c0 < bias_o0
htfBiasLabel = htfIsBullish ? "Bullish" : htfIsBearish ? "Bearish" : "Neutral"

var array<SwingPoint> bslArray = array.new<SwingPoint>()
var array<SwingPoint> sslArray = array.new<SwingPoint>()

var array<float> mssHighPrices = array.new_float()
var array<int>   mssHighBars   = array.new_int()
var array<float> mssLowPrices  = array.new_float()
var array<int>   mssLowBars    = array.new_int()

var array<SBModel> models = array.new<SBModel>()

pivH = ta.pivothigh(high, i_swingLen, i_swingLen)
pivL = ta.pivotlow(low,  i_swingLen, i_swingLen)

if not na(pivH)
    int _actualBar = bar_index - i_swingLen
    array.push(bslArray, SwingPoint.new(pivH, _actualBar))
    while array.size(bslArray) > 60
        array.shift(bslArray)
if not na(pivL)
    int _actualBar = bar_index - i_swingLen
    array.push(sslArray, SwingPoint.new(pivL, _actualBar))
    while array.size(sslArray) > 60
        array.shift(sslArray)

phLocal = ta.pivothigh(high, i_mssLeft, i_mssRight)
plLocal = ta.pivotlow(low,  i_mssLeft, i_mssRight)
if not na(phLocal)
    array.push(mssHighPrices, phLocal), array.push(mssHighBars, bar_index - i_mssRight)
if not na(plLocal)
    array.push(mssLowPrices, plLocal), array.push(mssLowBars, bar_index - i_mssRight)
while array.size(mssHighBars) > 80
    array.shift(mssHighBars), array.shift(mssHighPrices)
while array.size(mssLowBars) > 80
    array.shift(mssLowBars), array.shift(mssLowPrices)

f_findFVG(bool wantBull, int lookback) =>
    bool  _found = false
    float _top   = na
    float _bot   = na
    int   _bar   = na
    for b = 0 to lookback - 3
        if wantBull
            if low[b] > high[b + 2]
                _found := true
                _top   := low[b]
                _bot   := high[b + 2]
                _bar   := bar_index - b - 2
        else
            if high[b] < low[b + 2]
                _found := true
                _top   := low[b + 2]
                _bot   := high[b]
                _bar   := bar_index - b - 2
        if _found
            break
    [_found, _top, _bot, _bar]

f_deleteModel(SBModel m) =>
    if not na(m.sweepLine)
        line.delete(m.sweepLine)
    if not na(m.sweepLabel)
        label.delete(m.sweepLabel)
    if not na(m.mssLine)
        line.delete(m.mssLine)
    if not na(m.mssLabel)
        label.delete(m.mssLabel)
    if not na(m.sArea)
        box.delete(m.sArea)
    if not na(m.zoneBox)
        box.delete(m.zoneBox)
    if not na(m.zoneCe)
        line.delete(m.zoneCe)
    if not na(m.entryMarker)
        label.delete(m.entryMarker)
    if not na(m.rrLine)
        line.delete(m.rrLine)
    if not na(m.rrLabel)
        label.delete(m.rrLabel)

f_hideModel(SBModel m) =>
    f_deleteModel(m)
    m.sweepLine := na, m.sweepLabel := na, m.mssLine := na, m.mssLabel := na
    m.sArea := na, m.zoneBox := na, m.zoneCe := na
    m.entryMarker := na
    m.rrLine := na, m.rrLabel := na

f_shouldShow(SBModel m) =>
    _statusOK = i_status == "All" or
                 (i_status == "Active" and m.status != "Success" and m.status != "Invalidation") or
                 (i_status == "Formation Only" and m.status == "Formation") or
                 (i_status == "Success Only" and m.status == "Success")
    _biasOK   = i_bias == "All" or (i_bias == "Bullish" and m.isBull) or (i_bias == "Bearish" and not m.isBull)
    validTimeframe and _statusOK and _biasOK

f_newModel(bool isBull, float sweepLevel, float sweepExtreme, int swingBar) =>
    m = SBModel.new(isBull, bar_index, sweepLevel, sweepExtreme)
    m.swingBar := swingBar
    array.push(models, m)
    while array.size(models) > i_maxModels
        f_deleteModel(array.shift(models))
    if i_alertOnSweep
        alert((isBull ? "Bullish" : "Bearish") + " Silver Bullet Sweep @ " + str.tostring(sweepExtreme) + " [" + f_activeKzName() + "]", alert.freq_once_per_bar_close)
    m

f_hasNearbyActiveModel(float lvl) =>
    bool _res   = false
    float _tol  = (ta.highest(high, 100) - ta.lowest(low, 100)) * 0.0015
    if array.size(models) > 0
        for i = 0 to array.size(models) - 1
            SBModel ex = array.get(models, i)
            if ex.status != "Invalidation" and math.abs(ex.sweepLevel - lvl) <= _tol
                _res := true
                break
    _res

f_scanSweeps(array<SwingPoint> arr, bool isBullModel) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            SwingPoint sp = array.get(arr, i)
            bool _swept = isBullModel ? (low < sp.price) : (high > sp.price)
            if not sp.taken and _swept and bar_index > sp.barIndex
                sp.taken := true
                bool _reversed = isBullModel ? (close > sp.price) : (close < sp.price)
                if _reversed
                    bool _biasOK = isBullModel ? (i_bias == "All" or i_bias == "Bullish") : (i_bias == "All" or i_bias == "Bearish")
                    if allowNewModel and _biasOK and not f_hasNearbyActiveModel(sp.price)
                        f_newModel(isBullModel, sp.price, isBullModel ? low : high, sp.barIndex)

if i_showSweep
    f_scanSweeps(bslArray, false)
    f_scanSweeps(sslArray, true)

f_checkMSS(SBModel m) =>
    bool _breach = m.isBull ? low < m.sweepExtreme : high > m.sweepExtreme
    if _breach and m.mssConfirmed == false
        m.status     := "Invalidation"
        m.invalidBar := bar_index
        if i_alertOnInvalid
            alert((m.isBull ? "Bullish" : "Bearish") + " Silver Bullet Invalidated (Deeper Sweep)", alert.freq_once_per_bar_close)

    if m.status != "Invalidation" and not m.mssConfirmed
        int _bars = bar_index - m.sweepBar
        if _bars > i_mssMaxBars
            m.status     := "Invalidation"
            m.invalidBar := bar_index
            if i_alertOnInvalid
                alert((m.isBull ? "Bullish" : "Bearish") + " Silver Bullet Invalidated (Timeout)", alert.freq_once_per_bar_close)

        if m.status != "Invalidation"
            if m.isBull
                int targetBar = na
                float targetPrice = na
                if array.size(mssHighBars) > 0
                    for k = array.size(mssHighBars) - 1 to 0
                        int _hb = array.get(mssHighBars, k)
                        if _hb < bar_index and _hb >= m.sweepBar - 8
                            targetBar := _hb
                            targetPrice := array.get(mssHighPrices, k)
                            break
                if not na(targetBar)
                    bool _breakUp = (i_mssConfirm == "Close" ? close : high) > targetPrice
                    if _breakUp and bar_index > targetBar
                        [_zFound, _zTop, _zBot, _zBar] = f_findFVG(true, i_ltfLookback)
                        if not i_requireZone or _zFound
                            m.mssConfirmed   := true
                            m.mssBar         := bar_index
                            m.mssLevel       := targetPrice
                            m.zoneConfluence := _zFound
                            m.zoneTop        := _zTop
                            m.zoneBot        := _zBot
                            m.zoneBar        := _zBar
                            m.status         := _zFound ? "Awaiting Entry" : "Formation"
                            m.slPrice := m.sweepExtreme
                            if i_rrEntryMode == "MSS Close"
                                m.rrEntryRef := close
                                float _riskDistB = math.abs(m.rrEntryRef - m.slPrice)
                                m.tpPrice := m.rrEntryRef + _riskDistB * i_rrTarget
                                m.entryBar       := bar_index
                                m.entryPrice     := close
                                m.status         := "In Trade"
                                m.entryMarker := label.new(bar_index, low - (high - low) * 0.3, "",
                                     style = label.style_triangleup,
                                     color = i_entryBullColor,
                                     size = f_markerSize(i_entryMarkerSize))
                                if i_alertOnEntry
                                    alert("Bullish Silver Bullet Entry @ " + str.tostring(close), alert.freq_once_per_bar_close)
                            m.mssMidBar := math.round((targetBar + bar_index) / 2)
                            if i_showMSS
                                m.mssLine := line.new(targetBar, targetPrice, bar_index, targetPrice, color = i_bullMssCol, width = i_mssLineWidth, style = f_lineStyle(i_mssLineStyle))
                                m.mssLabel := label.new(m.mssMidBar, targetPrice, "MSS",
                                     style = label.style_label_down, color = color.new(color.black, 100), textcolor = i_bullMssCol, size = size.small)
                            if i_alertOnMSS
                                alert("Bullish Silver Bullet MSS Confirmed @ " + str.tostring(close), alert.freq_once_per_bar_close)
            else
                int targetBar = na
                float targetPrice = na
                if array.size(mssLowBars) > 0
                    for k = array.size(mssLowBars) - 1 to 0
                        int _lb = array.get(mssLowBars, k)
                        if _lb < bar_index and _lb >= m.sweepBar - 8
                            targetBar := _lb
                            targetPrice := array.get(mssLowPrices, k)
                            break
                if not na(targetBar)
                    bool _breakDn = (i_mssConfirm == "Close" ? close : low) < targetPrice
                    if _breakDn and bar_index > targetBar
                        [_zFound, _zTop, _zBot, _zBar] = f_findFVG(false, i_ltfLookback)
                        if not i_requireZone or _zFound
                            m.mssConfirmed   := true
                            m.mssBar         := bar_index
                            m.mssLevel       := targetPrice
                            m.zoneConfluence := _zFound
                            m.zoneTop        := _zTop
                            m.zoneBot        := _zBot
                            m.zoneBar        := _zBar
                            m.status         := _zFound ? "Awaiting Entry" : "Formation"
                            m.slPrice := m.sweepExtreme
                            if i_rrEntryMode == "MSS Close"
                                m.rrEntryRef := close
                                float _riskDistS = math.abs(m.rrEntryRef - m.slPrice)
                                m.tpPrice := m.rrEntryRef - _riskDistS * i_rrTarget
                                m.entryBar       := bar_index
                                m.entryPrice     := close
                                m.status         := "In Trade"
                                m.entryMarker := label.new(bar_index, high + (high - low) * 0.3, "",
                                     style = label.style_triangledown,
                                     color = i_entryBearColor,
                                     size = f_markerSize(i_entryMarkerSize))
                                if i_alertOnEntry
                                    alert("Bearish Silver Bullet Entry @ " + str.tostring(close), alert.freq_once_per_bar_close)
                            m.mssMidBar := math.round((targetBar + bar_index) / 2)
                            if i_showMSS
                                m.mssLine := line.new(targetBar, targetPrice, bar_index, targetPrice, color = i_bearMssCol, width = i_mssLineWidth, style = f_lineStyle(i_mssLineStyle))
                                m.mssLabel := label.new(m.mssMidBar, targetPrice, "MSS",
                                     style = label.style_label_up, color = color.new(color.black, 100), textcolor = i_bearMssCol, size = size.small)
                            if i_alertOnMSS
                                alert("Bearish Silver Bullet MSS Confirmed @ " + str.tostring(close), alert.freq_once_per_bar_close)

f_checkEntry(SBModel m) =>
    if m.status == "Awaiting Entry" and not na(m.zoneTop) and not na(m.zoneBot)
        bool _hit = m.isBull ? (low <= m.zoneTop) : (high >= m.zoneBot)
        if _hit
            m.entryBar       := bar_index
            m.entryPrice     := m.isBull ? math.min(m.zoneTop, close) : math.max(m.zoneBot, close)

            if i_rrEntryMode == "FVG Retest Entry"
                m.rrEntryRef := m.entryPrice
                float _riskDist = math.abs(m.rrEntryRef - m.slPrice)
                m.tpPrice := m.isBull ? (m.rrEntryRef + _riskDist * i_rrTarget) : (m.rrEntryRef - _riskDist * i_rrTarget)

            m.status := "In Trade"
            if i_alertOnEntry
                alert((m.isBull ? "Bullish" : "Bearish") + " Silver Bullet Entry @ " + str.tostring(m.entryPrice), alert.freq_once_per_bar_close)

            m.entryMarker := label.new(bar_index, m.isBull ? low - (high - low) * 0.3 : high + (high - low) * 0.3, "",
                 style = m.isBull ? label.style_triangleup : label.style_triangledown,
                 color = m.isBull ? i_entryBullColor : i_entryBearColor,
                 size = f_markerSize(i_entryMarkerSize))

f_checkTradeOutcome(SBModel m) =>
    if m.status == "In Trade" and not na(m.entryBar)
        if m.isBull
            if low <= m.slPrice
                m.status     := "Invalidation"
                m.invalidBar := bar_index
                if i_alertOnInvalid
                    alert("Bullish Silver Bullet Stopped Out", alert.freq_once_per_bar_close)
            else if high >= m.tpPrice
                m.status     := "Success"
                m.successBar := bar_index
                if i_alertOnSucc
                    alert("Bullish Silver Bullet Target Reached", alert.freq_once_per_bar_close)
        else
            if high >= m.slPrice
                m.status     := "Invalidation"
                m.invalidBar := bar_index
                if i_alertOnInvalid
                    alert("Bearish Silver Bullet Stopped Out", alert.freq_once_per_bar_close)
            else if low <= m.tpPrice
                m.status     := "Success"
                m.successBar := bar_index
                if i_alertOnSucc
                    alert("Bearish Silver Bullet Target Reached", alert.freq_once_per_bar_close)

for m in models
    if m.status != "Invalidation" and m.status != "Success"
        if not m.mssConfirmed
            f_checkMSS(m)
        else if m.status == "Awaiting Entry"
            f_checkEntry(m)
        else if m.status == "In Trade"
            f_checkTradeOutcome(m)

f_drawZoneBox(SBModel m) =>
    if m.zoneConfluence and not na(m.zoneTop) and not na(m.zoneBot)
        color _bg     = m.isBull ? color.new(i_fvgBullColor, 85) : color.new(i_fvgBearColor, 85)
        color _txtCol = m.isBull ? color.new(i_fvgBullColor, 0)  : color.new(i_fvgBearColor, 0)
        float _ce     = (m.zoneTop + m.zoneBot) / 2
        color _ceCol  = m.isBull ? color.new(i_fvgBullColor, 40) : color.new(i_fvgBearColor, 40)

        bool _stillWaiting = (m.status == "Awaiting Entry")
        int  _compactEnd   = m.zoneBar + 2
        int  _frozenEnd    = na(m.entryBar) ? m.zoneBar + 35 : m.entryBar + 4
        int  _end          = i_extendFVGZone ? (_stillWaiting ? bar_index + 10 : _frozenEnd) : _compactEnd

        string _boxText = i_extendFVGZone ? "FVG" : ""
        if na(m.zoneBox)
            m.zoneBox := box.new(m.zoneBar, m.zoneTop, _end, m.zoneBot,
                                 border_color = color.new(color.white, 100),
                                 bgcolor = _bg,
                                 text = _boxText,
                                 text_size = size.tiny,
                                 text_color = _txtCol,
                                 text_halign = text.align_right,
                                 text_valign = text.align_center)
        if i_extendFVGZone and _stillWaiting
            box.set_right(m.zoneBox, _end)
        if not i_extendFVGZone
            box.set_right(m.zoneBox, _compactEnd)
        box.set_bgcolor(m.zoneBox, _bg)

        if i_showZoneCE
            if na(m.zoneCe)
                m.zoneCe := line.new(m.zoneBar, _ce, _end, _ce,
                                     color = _ceCol, width = i_zoneCeWidth, style = f_lineStyle(i_zoneCeStyle))
            line.set_x1(m.zoneCe, m.zoneBar)
            if i_extendFVGZone and _stillWaiting
                line.set_x2(m.zoneCe, _end)
            if not i_extendFVGZone
                line.set_x2(m.zoneCe, _compactEnd)
            line.set_y1(m.zoneCe, _ce)
            line.set_y2(m.zoneCe, _ce)
            line.set_color(m.zoneCe, _ceCol)
            true
        else
            if not na(m.zoneCe)
                line.delete(m.zoneCe)
                m.zoneCe := na
            true
    else
        if not na(m.zoneBox)
            box.delete(m.zoneBox)
            m.zoneBox := na
        if not na(m.zoneCe)
            line.delete(m.zoneCe)
            m.zoneCe := na
        true

f_drawSweep(SBModel m) =>
    bool _isInvalid = (m.status == "Invalidation")

    if _isInvalid
        if i_discardInval
            if not na(m.sweepLine)
                line.delete(m.sweepLine)
                m.sweepLine := na
            if not na(m.sweepLabel)
                label.delete(m.sweepLabel)
                m.sweepLabel := na
            if not na(m.sArea)
                box.delete(m.sArea)
                m.sArea := na
        else
            if not na(m.sweepLine)
                line.set_color(m.sweepLine, color.new(#9E9E9E, 40))
            if not na(m.sweepLabel)
                label.set_textcolor(m.sweepLabel, color.new(#9E9E9E, 50))
            if not na(m.sArea)
                box.set_bgcolor(m.sArea, color.new(#9E9E9E, 93))
                box.set_border_color(m.sArea, color.new(#9E9E9E, 100))

    if not _isInvalid and not (i_discardInval and _isInvalid)
        color _themeCol = m.isBull ? i_bullSwpColor : i_bearSwpColor
        float _top = math.max(m.sweepLevel, m.sweepExtreme)
        float _bot = math.min(m.sweepLevel, m.sweepExtreme)
        int _fixedEnd = m.sweepBar + 18
        int _endBar   = na(m.mssBar) ? _fixedEnd : m.mssBar + 4

        if i_showSweep
            if na(m.sweepLine)
                m.sweepLine := line.new(m.swingBar, m.sweepLevel, _endBar, m.sweepLevel,
                                        color = color.new(_themeCol, 20), style = line.style_solid, width = i_swpLineWidth)
            line.set_color(m.sweepLine, color.new(_themeCol, 20))
            line.set_x1(m.sweepLine, m.swingBar)
            if bar_index <= _fixedEnd or not na(m.mssBar)
                line.set_x2(m.sweepLine, _endBar)

            color _pointCol  = m.isBull ? i_sweepPointBullColor : i_sweepPointBearColor
            float _ptOffset  = ta.atr(14) * 0.12
            float _ptY       = m.isBull ? m.sweepExtreme - _ptOffset : m.sweepExtreme + _ptOffset
            if na(m.sweepLabel)
                m.sweepLabel := label.new(m.sweepBar, _ptY, "●",
                     style     = label.style_none,
                     color     = color.new(color.black, 100),
                     textcolor = _pointCol,
                     size      = f_markerSize(i_sweepPointSize))
            label.set_y(m.sweepLabel, _ptY)
            label.set_textcolor(m.sweepLabel, _pointCol)
            label.set_size(m.sweepLabel, f_markerSize(i_sweepPointSize))

            if i_showSArea
                color _zoneBg = color.new(_themeCol, i_swpZoneTransp)
                int _boxStart = m.sweepBar - 1
                int _boxEnd   = i_extendSweepBox ? _endBar : m.sweepBar + 3

                if na(m.sArea)
                    m.sArea := box.new(_boxStart, _top, _boxEnd, _bot,
                                       border_color = color.new(color.white, 100),
                                       bgcolor = _zoneBg)
                box.set_left(m.sArea, _boxStart)
                box.set_top(m.sArea, _top)
                box.set_bottom(m.sArea, _bot)
                if i_extendSweepBox
                    if bar_index <= _fixedEnd or not na(m.mssBar)
                        box.set_right(m.sArea, _boxEnd)
                if not i_extendSweepBox
                    box.set_right(m.sArea, _boxEnd)

f_drawRR(SBModel m) =>
    if m.status == "Invalidation"
        if not na(m.rrLine)
            line.delete(m.rrLine)
            m.rrLine := na
        if not na(m.rrLabel)
            label.delete(m.rrLabel)
            m.rrLabel := na
    if m.status != "Invalidation" and i_showRRLine and not na(m.tpPrice) and not na(m.mssMidBar)
        int _x1 = m.mssMidBar
        int _x2 = m.mssMidBar + i_rrLineBars
        if na(m.rrLine)
            m.rrLine := line.new(_x1, m.tpPrice, _x2, m.tpPrice, color = i_rrLineColor, width = i_rrLineWidth, style = f_lineStyle(i_rrLineStyle))
        line.set_color(m.rrLine, i_rrLineColor)
        line.set_width(m.rrLine, i_rrLineWidth)
        line.set_style(m.rrLine, f_lineStyle(i_rrLineStyle))
        if na(m.rrLabel)
            m.rrLabel := label.new(_x2, m.tpPrice, f_fmtRR(i_rrTarget),
                 style = label.style_label_left, color = color.new(color.black, 100),
                 textcolor = i_rrTextColor, size = size.small)
        label.set_textcolor(m.rrLabel, i_rrTextColor)
        label.set_text(m.rrLabel, f_fmtRR(i_rrTarget))

f_drawModel(SBModel m) =>
    f_drawSweep(m)
    if m.mssConfirmed
        if m.status != "Invalidation"
            f_drawZoneBox(m)
        f_drawRR(m)
        if m.status == "Invalidation" and i_discardInval
            if not na(m.mssLine)
                line.delete(m.mssLine)
                m.mssLine := na
            if not na(m.mssLabel)
                label.delete(m.mssLabel)
                m.mssLabel := na
            if not na(m.entryMarker)
                label.delete(m.entryMarker)
                m.entryMarker := na
            if not na(m.zoneBox)
                box.delete(m.zoneBox)
                m.zoneBox := na
            if not na(m.zoneCe)
                line.delete(m.zoneCe)
                m.zoneCe := na
        if m.status == "Invalidation" and not i_discardInval
            if not na(m.mssLine)
                line.set_color(m.mssLine, color.new(#9E9E9E, 40))
            if not na(m.mssLabel)
                label.set_textcolor(m.mssLabel, color.new(#9E9E9E, 50))
            if not na(m.entryMarker)
                label.set_color(m.entryMarker, color.new(#9E9E9E, 40))
            if not na(m.zoneBox)
                box.set_bgcolor(m.zoneBox, color.new(#9E9E9E, 90))
                box.set_border_color(m.zoneBox, color.new(#9E9E9E, 100))
            if not na(m.zoneCe)
                line.set_color(m.zoneCe, color.new(#9E9E9E, 50))

for m in models
    if f_shouldShow(m)
        f_drawModel(m)
    else
        f_hideModel(m)

htfPanelTF = i_htfAuto ? i_biasTF : i_htfManualTF

[hp_o0, hp_h0, hp_l0, hp_c0,
 hp_o1, hp_h1, hp_l1, hp_c1,
 hp_o2, hp_h2, hp_l2, hp_c2,
 hp_o3, hp_h3, hp_l3, hp_c3,
 hp_o4, hp_h4, hp_l4, hp_c4,
 hp_o5, hp_h5, hp_l5, hp_c5] = request.security(
     syminfo.tickerid, htfPanelTF,
     [open[0], high[0], low[0], close[0],
      open[1], high[1], low[1], close[1],
      open[2], high[2], low[2], close[2],
      open[3], high[3], low[3], close[3],
      open[4], high[4], low[4], close[4],
      open[5], high[5], low[5], close[5]], lookahead = barmerge.lookahead_off)

var box[]   hp_boxes   = array.new_box(6, na)
var line[]  hp_wickUp  = array.new_line(6, na)
var line[]  hp_wickDn  = array.new_line(6, na)
var line[]  hp_sweepHi = array.new_line(5, na)
var line[]  hp_sweepLo = array.new_line(5, na)
var label   hp_label   = na

f_renderHTFPanel(string tfName, int xStart, int count,
                 float o0, float h0, float l0, float c0,
                 float o1, float h1, float l1, float c1,
                 float o2, float h2, float l2, float c2,
                 float o3, float h3, float l3, float c3,
                 float o4, float h4, float l4, float c4,
                 float o5, float h5, float l5, float c5,
                 box[] bArray, line[] wuArray, line[] wdArray, line[] sHiArray, line[] sLoArray, label tagObj) =>
    float[] oArr = array.from(o0, o1, o2, o3, o4, o5)
    float[] hArr = array.from(h0, h1, h2, h3, h4, h5)
    float[] lArr = array.from(l0, l1, l2, l3, l4, l5)
    float[] cArr = array.from(c0, c1, c2, c3, c4, c5)

    color colBull     = i_htfBullBody
    color colBear     = i_htfBearBody
    color colBordBull = i_htfBullBorder
    color colBordBear = i_htfBearBorder

    int nCandles = math.min(count, 6)
    float panelMaxH = -1.0e10
    color _hidden = color.new(color.black, 100)

    for k = 0 to nCandles - 1
        int idx = nCandles - 1 - k
        float _o = array.get(oArr, idx)
        float _h = array.get(hArr, idx)
        float _l = array.get(lArr, idx)
        float _c = array.get(cArr, idx)
        panelMaxH := math.max(panelMaxH, _h)

        bool isBull = _c >= _o
        int posX = xStart + k * (i_htfSize + i_htfSpace)
        int midX = posX + int(i_htfSize / 2)
        color currentBorder = isBull ? colBordBull : colBordBear
        color currentBody   = isBull ? colBull : colBear

        box b = array.get(bArray, k)
        if na(b)
            b := box.new(posX, math.max(_o, _c), posX + i_htfSize, math.min(_o, _c),
                         border_color = currentBorder, bgcolor = currentBody)
            array.set(bArray, k, b)
        else
            box.set_lefttop(b, posX, math.max(_o, _c))
            box.set_rightbottom(b, posX + i_htfSize, math.min(_o, _c))
            box.set_border_color(b, currentBorder)
            box.set_bgcolor(b, currentBody)

        line wu = array.get(wuArray, k)
        if na(wu)
            wu := line.new(midX, _h, midX, math.max(_o, _c), color = currentBorder, width = 1)
            array.set(wuArray, k, wu)
        else
            line.set_xy1(wu, midX, _h)
            line.set_xy2(wu, midX, math.max(_o, _c))
            line.set_color(wu, currentBorder)

        line wd = array.get(wdArray, k)
        if na(wd)
            wd := line.new(midX, math.min(_o, _c), midX, _l, color = currentBorder, width = 1)
            array.set(wdArray, k, wd)
        else
            line.set_xy1(wd, midX, math.min(_o, _c))
            line.set_xy2(wd, midX, _l)
            line.set_color(wd, currentBorder)

        if k > 0
            int sIdx = k - 1
            float prevH = array.get(hArr, idx + 1)
            float prevL = array.get(lArr, idx + 1)
            int prevMidX = xStart + (k - 1) * (i_htfSize + i_htfSpace) + int(i_htfSize / 2)
            bool hiHit = _h > prevH and _c < prevH and close < prevH
            bool loHit = _l < prevL and _c > prevL and close > prevL

            line sHi = array.get(sHiArray, sIdx)
            if na(sHi)
                sHi := line.new(prevMidX, prevH, posX + i_htfSize + 2, prevH, color = _hidden, width = 1)
                array.set(sHiArray, sIdx, sHi)
            if hiHit
                line.set_xy1(sHi, prevMidX, prevH)
                line.set_xy2(sHi, posX + i_htfSize + 2, prevH)
                line.set_color(sHi, color.new(color.black, 15))
            else
                line.set_color(sHi, _hidden)

            line sLo = array.get(sLoArray, sIdx)
            if na(sLo)
                sLo := line.new(prevMidX, prevL, posX + i_htfSize + 2, prevL, color = _hidden, width = 1)
                array.set(sLoArray, sIdx, sLo)
            if loHit
                line.set_xy1(sLo, prevMidX, prevL)
                line.set_xy2(sLo, posX + i_htfSize + 2, prevL)
                line.set_color(sLo, color.new(color.black, 15))
            else
                line.set_color(sLo, _hidden)

    int midPanelX = xStart + int((nCandles * (i_htfSize + i_htfSpace)) / 2)
    string _panelTag = f_fmtTF(tfName)
    label resLabel = tagObj
    if na(tagObj)
        resLabel := label.new(midPanelX, panelMaxH, _panelTag, style = label.style_none,
                              textcolor = color.black, size = size.normal, textalign = text.align_center)
    label.set_xy(resLabel, midPanelX, panelMaxH)
    label.set_text(resLabel, _panelTag)
    resLabel

if validTimeframe and i_showHTFCandles and barstate.islast
    int hpX = bar_index + i_htfOffset
    hp_label := f_renderHTFPanel(htfPanelTF, hpX, i_htfCount,
                                 hp_o0, hp_h0, hp_l0, hp_c0,
                                 hp_o1, hp_h1, hp_l1, hp_c1,
                                 hp_o2, hp_h2, hp_l2, hp_c2,
                                 hp_o3, hp_h3, hp_l3, hp_c3,
                                 hp_o4, hp_h4, hp_l4, hp_c4,
                                 hp_o5, hp_h5, hp_l5, hp_c5,
                                 hp_boxes, hp_wickUp, hp_wickDn, hp_sweepHi, hp_sweepLo, hp_label)

f_getActiveModel() =>
    SBModel _res = na
    if array.size(models) > 0
        for i = array.size(models) - 1 to 0
            SBModel m = array.get(models, i)
            if m.status != "Invalidation"
                _res := m
                break
        if na(_res)
            _res := array.get(models, array.size(models) - 1)
    _res

f_currentTFMatches() =>
    string _cur = timeframe.period
    _cur == i_execTF

var table hud = na

if validTimeframe and i_showDashboard and barstate.islast
    if na(hud)
        hud := table.new(f_tablePos(i_dashPosition), 1, 7, bgcolor = i_dashBg, frame_color = i_dashBorder, frame_width = 1, border_width = 1, border_color = i_dashBorder)

    SBModel m = f_getActiveModel()
    string _ticker    = syminfo.prefix + ":" + syminfo.ticker
    string _kzName    = f_activeKzName()
    string _kzState   = anyKzSelected and kzActive ? "ACTIVE NOW" : "Waiting for Killzone"
    string _bias      = htfBiasLabel
    string _execState = f_currentTFMatches() ? "Chart TF OK (" + i_execTF + "m)" : "⚠ Switch chart to " + i_execTF + "m"
    string _status    = not na(m) ? (m.status == "Success" ? "Successful" : m.status) : "No Active Setup"
    string _dir       = not na(m) ? (m.isBull ? "Bullish" : "Bearish") : "-"
    string _entryMode = i_rrEntryMode == "MSS Close" ? "Entry: MSS Close (Instant)" : "Entry: FVG Retest"

    table.cell(hud, 0, 0, "ICT Silver Bullet",     text_color = i_dashText, text_size = f_labelSize(i_dashHeaderSz))
    table.cell(hud, 0, 1, _ticker,                  text_color = i_dashText, text_size = f_labelSize(i_dashRowSz))
    string _kzDisplay = kzActive ? _kzName : "No SB Window"
    table.cell(hud, 0, 2, _kzDisplay,                           text_color = i_dashText, text_size = f_labelSize(i_dashRowSz))
    table.cell(hud, 0, 3, "Narrative: " + _bias,                text_color = i_dashText, text_size = f_labelSize(i_dashRowSz))
    table.cell(hud, 0, 4, "Setup: " + _dir + " - " + _status,  text_color = i_dashText, text_size = f_labelSize(i_dashRowSz))
    table.cell(hud, 0, 5, _entryMode,                           text_color = i_dashText, text_size = f_labelSize(i_dashRowSz))
    table.cell(hud, 0, 6, _execState,                           text_color = i_dashText, text_size = f_labelSize(i_dashRowSz))

bullSweptThisBar   = false
bearSweptThisBar   = false
bullMSSThisBar     = false
bearMSSThisBar     = false
bullEntryThisBar   = false
bearEntryThisBar   = false
bullSuccessThisBar = false
bearSuccessThisBar = false
bullInvalidThisBar = false
bearInvalidThisBar = false

if array.size(models) > 0
    for i = 0 to array.size(models) - 1
        SBModel _lm = array.get(models, i)
        if _lm.isBull and _lm.sweepBar == bar_index
            bullSweptThisBar := true
        if not _lm.isBull and _lm.sweepBar == bar_index
            bearSweptThisBar := true
        if _lm.isBull and _lm.mssConfirmed and _lm.mssBar == bar_index
            bullMSSThisBar := true
        if not _lm.isBull and _lm.mssConfirmed and _lm.mssBar == bar_index
            bearMSSThisBar := true
        if _lm.isBull and not na(_lm.entryBar) and _lm.entryBar == bar_index
            bullEntryThisBar := true
        if not _lm.isBull and not na(_lm.entryBar) and _lm.entryBar == bar_index
            bearEntryThisBar := true
        if _lm.isBull and not na(_lm.successBar) and _lm.successBar == bar_index
            bullSuccessThisBar := true
        if not _lm.isBull and not na(_lm.successBar) and _lm.successBar == bar_index
            bearSuccessThisBar := true
        if _lm.isBull and not na(_lm.invalidBar) and _lm.invalidBar == bar_index
            bullInvalidThisBar := true
        if not _lm.isBull and not na(_lm.invalidBar) and _lm.invalidBar == bar_index
            bearInvalidThisBar := true

alertcondition(bullSweptThisBar, title = "Bullish Silver Bullet Sweep", message = "{{ticker}}: Bullish Silver Bullet sweep on {{interval}}")
alertcondition(bearSweptThisBar, title = "Bearish Silver Bullet Sweep", message = "{{ticker}}: Bearish Silver Bullet sweep on {{interval}}")
alertcondition(bullMSSThisBar, title = "Bullish Silver Bullet MSS", message = "{{ticker}}: Bullish MSS confirmed on {{interval}}")
alertcondition(bearMSSThisBar, title = "Bearish Silver Bullet MSS", message = "{{ticker}}: Bearish MSS confirmed on {{interval}}")
alertcondition(bullEntryThisBar, title = "Bullish Silver Bullet Entry", message = "{{ticker}}: Bullish entry confirmed on {{interval}}")
alertcondition(bearEntryThisBar, title = "Bearish Silver Bullet Entry", message = "{{ticker}}: Bearish entry confirmed on {{interval}}")
alertcondition(bullSuccessThisBar, title = "Bullish Silver Bullet Target Reached", message = "{{ticker}}: Bullish Silver Bullet target reached on {{interval}}")
alertcondition(bearSuccessThisBar, title = "Bearish Silver Bullet Target Reached", message = "{{ticker}}: Bearish Silver Bullet target reached on {{interval}}")
alertcondition(bullInvalidThisBar, title = "Bullish Silver Bullet Invalidated", message = "{{ticker}}: Bullish Silver Bullet invalidated on {{interval}}")
alertcondition(bearInvalidThisBar, title = "Bearish Silver Bullet Invalidated", message = "{{ticker}}: Bearish Silver Bullet invalidated on {{interval}}")