//@version=6
indicator("Fibonacci Bollinger Bands", shorttitle = "Fibonacci Bollinger Bands", overlay = true, format = format.price, max_labels_count = 20)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_COLOR = #089981
BEARISH_COLOR = #f23645
NEUTRAL_COLOR = #787b86

// The Fibonacci ratios the outer span is subdivided at - the defining constants of the construction
RATIO_1 = 0.236
RATIO_2 = 0.382
RATIO_3 = 0.500
RATIO_4 = 0.618
RATIO_5 = 0.764

// Rung line transparencies grade outward - faint beside the basis, strongest at the outer rail
RUNG_TRANSP_1 = 72
RUNG_TRANSP_2 = 62
RUNG_TRANSP_3 = 52
RUNG_TRANSP_4 = 42
RUNG_TRANSP_5 = 32

FILL_RAIL_TRANSP  = 80  // gradient transparency at the outer rail (strongest shading)
FILL_BASIS_TRANSP = 100 // gradient transparency at the basis (fully transparent)

LABEL_OFFSET = 3 // bars to the right of the last bar the rung labels sit at

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Price series the basis and the standard deviation are computed on. Closing prices are the standard Bollinger convention; hlc3 is a common alternative on the volume-rich charts where the tool grew up.")

basisTypeInput = input.string("VWMA", "Basis Type", options = ["VWMA", "SMA", "EMA", "WMA", "SMMA (RMA)"]
  , group   = "Settings"
  , tooltip = "Moving average at the center of the ladder. The most-shared configuration uses a volume-weighted average, centering the ladder on participation-weighted price; SMA or EMA work identically in structure and center it on time-weighted consensus instead. VWMA requires volume data.")

lengthInput = input.int(200, "Basis Length", minval = 2
  , group   = "Settings"
  , tooltip = "Lookback of both the basis and the standard deviation the span is built from. 200 matches the widely shared long-basis configuration and turns the basis into a regime axis; a classic 20 behaves like standard Bollinger timing. Match it to your holding period.")

multInput = input.float(3.0, "Outer Deviation Multiplier", minval = 0.1, step = 0.1
  , group   = "Settings"
  , tooltip = "Standard deviations from the basis to the outermost rail - the span the Fibonacci ratios subdivide. 3 is the common wide-rail default: the interior rungs do the day-to-day support and resistance work while the rail keeps the classic stretched-tag meaning.")

upperColorInput = input.color(BULLISH_COLOR, "Upper Ladder"
  , group   = "Style"
  , tooltip = "Color of the rungs above the basis - the half of the ladder in play while closes hold the bullish side. Rung lines fade toward the basis so the outer rail reads strongest.")

lowerColorInput = input.color(BEARISH_COLOR, "Lower Ladder"
  , group   = "Style"
  , tooltip = "Color of the rungs below the basis - the half of the ladder in play while closes hold the bearish side.")

basisColorInput = input.color(NEUTRAL_COLOR, "Basis"
  , group   = "Style"
  , tooltip = "Color of the basis line - the ladder's regime divider: price above it keeps the bullish half in play, below it the bearish half, oscillation around it marks balance.")

showFillInput = input.bool(true, "Ladder Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient from the basis out to each rail - fully transparent at the basis, strongest at the outermost band - so band space intensifies toward the stretch zone. Purely visual, the levels are unaffected.")

showLabelsInput = input.bool(true, "Rung Labels"
  , group   = "Style"
  , tooltip = "Marks each rung with its Fibonacci ratio and current price, and the basis with its configuration, to the right of the last bar.")

showTagMarkersInput = input.bool(false, "Outer Tag Markers"
  , group   = "Style"
  , tooltip = "Optional circles on bars where price tags an outermost rail. Off by default to keep the chart clean - the tag alerts cover the same events regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Push one right-side rung label: rung name plus the rung's current price
drawRungLabel(array<label> labelArray, float price, string rungName, color labelColor) =>
    if not na(price)
        labelArray.push(label.new(bar_index + LABEL_OFFSET, price, rungName + " " + str.tostring(price, format.mintick)
          , color = #00000000, textcolor = labelColor, style = label.style_label_left, size = size.tiny))

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Every basis candidate is computed on every bar, so the selected one is always internally consistent
vwmaValue = ta.vwma(srcInput, lengthInput)
smaValue  = ta.sma(srcInput, lengthInput)
emaValue  = ta.ema(srcInput, lengthInput)
wmaValue  = ta.wma(srcInput, lengthInput)
rmaValue  = ta.rma(srcInput, lengthInput)

basis = switch basisTypeInput
    "SMA"        => smaValue
    "EMA"        => emaValue
    "WMA"        => wmaValue
    "SMMA (RMA)" => rmaValue
    => vwmaValue

// One deviation measure feeds the whole geometry: the outer rail sits the full multiple out and every interior rung
// is a fixed Fibonacci fraction of that same span, so the entire ladder breathes together with volatility
span = multInput * ta.stdev(srcInput, lengthInput)

upperBand1 = basis + span * RATIO_1
upperBand2 = basis + span * RATIO_2
upperBand3 = basis + span * RATIO_3
upperBand4 = basis + span * RATIO_4
upperBand5 = basis + span * RATIO_5
upperBand6 = basis + span

lowerBand1 = basis - span * RATIO_1
lowerBand2 = basis - span * RATIO_2
lowerBand3 = basis - span * RATIO_3
lowerBand4 = basis - span * RATIO_4
lowerBand5 = basis - span * RATIO_5
lowerBand6 = basis - span

//---------------------------------------------------------------------------------------------------------------------}
// Ladder Events
//---------------------------------------------------------------------------------------------------------------------{
// Regime axis: which side of the basis closing prices hold decides which half of the ladder is in play
basisCrossUp   = ta.crossover(close, basis)
basisCrossDown = ta.crossunder(close, basis)

// Stretch: pushes into the outermost rail keep the classic band-tag meaning - a fade candidate in ranging tape, a
// strength signal in trending tape
upperOuterTag = ta.crossover(high, upperBand6)
lowerOuterTag = ta.crossunder(low, lowerBand6)

// Rung crossings are judged on closes, one crossover stream per interior rung so every level taken or lost is caught
crossUpUpper1 = ta.crossover(close, upperBand1)
crossUpUpper2 = ta.crossover(close, upperBand2)
crossUpUpper3 = ta.crossover(close, upperBand3)
crossUpUpper4 = ta.crossover(close, upperBand4)
crossUpUpper5 = ta.crossover(close, upperBand5)
crossUpLower1 = ta.crossover(close, lowerBand1)
crossUpLower2 = ta.crossover(close, lowerBand2)
crossUpLower3 = ta.crossover(close, lowerBand3)
crossUpLower4 = ta.crossover(close, lowerBand4)
crossUpLower5 = ta.crossover(close, lowerBand5)

crossDownUpper1 = ta.crossunder(close, upperBand1)
crossDownUpper2 = ta.crossunder(close, upperBand2)
crossDownUpper3 = ta.crossunder(close, upperBand3)
crossDownUpper4 = ta.crossunder(close, upperBand4)
crossDownUpper5 = ta.crossunder(close, upperBand5)
crossDownLower1 = ta.crossunder(close, lowerBand1)
crossDownLower2 = ta.crossunder(close, lowerBand2)
crossDownLower3 = ta.crossunder(close, lowerBand3)
crossDownLower4 = ta.crossunder(close, lowerBand4)
crossDownLower5 = ta.crossunder(close, lowerBand5)

rungCrossUp = crossUpUpper1 or crossUpUpper2 or crossUpUpper3 or crossUpUpper4 or crossUpUpper5 or crossUpLower1 or crossUpLower2 or crossUpLower3 or crossUpLower4 or crossUpLower5

rungCrossDown = crossDownUpper1 or crossDownUpper2 or crossDownUpper3 or crossDownUpper4 or crossDownUpper5 or crossDownLower1 or crossDownLower2 or crossDownLower3 or crossDownLower4 or crossDownLower5

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// The ladder top to bottom: interior rungs fade toward the basis, the outer rails and the basis carry the weight
upperRailPlotId = plot(upperBand6, "Upper 1.000 (Outer Rail)", color = upperColorInput, linewidth = 2)
plot(upperBand5, "Upper 0.764", color = color.new(upperColorInput, RUNG_TRANSP_5), linewidth = 1)
plot(upperBand4, "Upper 0.618", color = color.new(upperColorInput, RUNG_TRANSP_4), linewidth = 1)
plot(upperBand3, "Upper 0.500", color = color.new(upperColorInput, RUNG_TRANSP_3), linewidth = 1)
plot(upperBand2, "Upper 0.382", color = color.new(upperColorInput, RUNG_TRANSP_2), linewidth = 1)
plot(upperBand1, "Upper 0.236", color = color.new(upperColorInput, RUNG_TRANSP_1), linewidth = 1)

basisPlotId = plot(basis, "Basis", color = basisColorInput, linewidth = 2)

plot(lowerBand1, "Lower 0.236", color = color.new(lowerColorInput, RUNG_TRANSP_1), linewidth = 1)
plot(lowerBand2, "Lower 0.382", color = color.new(lowerColorInput, RUNG_TRANSP_2), linewidth = 1)
plot(lowerBand3, "Lower 0.500", color = color.new(lowerColorInput, RUNG_TRANSP_3), linewidth = 1)
plot(lowerBand4, "Lower 0.618", color = color.new(lowerColorInput, RUNG_TRANSP_4), linewidth = 1)
plot(lowerBand5, "Lower 0.764", color = color.new(lowerColorInput, RUNG_TRANSP_5), linewidth = 1)
lowerRailPlotId = plot(lowerBand6, "Lower 1.000 (Outer Rail)", color = lowerColorInput, linewidth = 2)

fill(basisPlotId, upperRailPlotId
  , top_value    = upperBand6
  , bottom_value = basis
  , top_color    = showFillInput ? color.new(upperColorInput, FILL_RAIL_TRANSP) : na
  , bottom_color = showFillInput ? color.new(upperColorInput, FILL_BASIS_TRANSP) : na
  , title        = "Upper Ladder Gradient Fill")

fill(basisPlotId, lowerRailPlotId
  , top_value    = basis
  , bottom_value = lowerBand6
  , top_color    = showFillInput ? color.new(lowerColorInput, FILL_BASIS_TRANSP) : na
  , bottom_color = showFillInput ? color.new(lowerColorInput, FILL_RAIL_TRANSP) : na
  , title        = "Lower Ladder Gradient Fill")

plotshape(showTagMarkersInput and upperOuterTag, "Upper Outer Band Tag", shape.circle, location.abovebar, color = upperColorInput, size = size.tiny)
plotshape(showTagMarkersInput and lowerOuterTag, "Lower Outer Band Tag", shape.circle, location.belowbar, color = lowerColorInput, size = size.tiny)

// Right-side rung labels, deleted and redrawn on the last bar so exactly one set ever exists
var array<label> rungLabelArray = array.new<label>()

if barstate.islast
    if rungLabelArray.size() > 0
        for i = 0 to rungLabelArray.size() - 1
            label.delete(rungLabelArray.get(i))
        rungLabelArray.clear()
    if showLabelsInput
        drawRungLabel(rungLabelArray, upperBand6, "1.000", upperColorInput)
        drawRungLabel(rungLabelArray, upperBand5, "0.764", upperColorInput)
        drawRungLabel(rungLabelArray, upperBand4, "0.618", upperColorInput)
        drawRungLabel(rungLabelArray, upperBand3, "0.500", upperColorInput)
        drawRungLabel(rungLabelArray, upperBand2, "0.382", upperColorInput)
        drawRungLabel(rungLabelArray, upperBand1, "0.236", upperColorInput)
        drawRungLabel(rungLabelArray, basis, basisTypeInput + " " + str.tostring(lengthInput), basisColorInput)
        drawRungLabel(rungLabelArray, lowerBand1, "0.236", lowerColorInput)
        drawRungLabel(rungLabelArray, lowerBand2, "0.382", lowerColorInput)
        drawRungLabel(rungLabelArray, lowerBand3, "0.500", lowerColorInput)
        drawRungLabel(rungLabelArray, lowerBand4, "0.618", lowerColorInput)
        drawRungLabel(rungLabelArray, lowerBand5, "0.764", lowerColorInput)
        drawRungLabel(rungLabelArray, lowerBand6, "1.000", lowerColorInput)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(basisCrossUp, "Basis Cross Up", "Fibonacci Bollinger Bands: price closed above the basis on {{ticker}} - the bullish half of the ladder is in play ({{interval}})")
alertcondition(basisCrossDown, "Basis Cross Down", "Fibonacci Bollinger Bands: price closed below the basis on {{ticker}} - the bearish half of the ladder is in play ({{interval}})")
alertcondition(upperOuterTag, "Upper Outer Band Tag", "Fibonacci Bollinger Bands: price tagged the upper outer rail on {{ticker}} - a stretched move, faded in balance and respected as strength in trends ({{interval}})")
alertcondition(lowerOuterTag, "Lower Outer Band Tag", "Fibonacci Bollinger Bands: price tagged the lower outer rail on {{ticker}} - a stretched move, faded in balance and respected as strength in downtrends ({{interval}})")
alertcondition(rungCrossUp, "Interior Rung Crossed Up", "Fibonacci Bollinger Bands: price closed above an interior Fibonacci rung on {{ticker}} - grade the move by the rungs it holds from here ({{interval}})")
alertcondition(rungCrossDown, "Interior Rung Crossed Down", "Fibonacci Bollinger Bands: price closed below an interior Fibonacci rung on {{ticker}} - successive rung losses walk the read toward the basis and beyond ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
