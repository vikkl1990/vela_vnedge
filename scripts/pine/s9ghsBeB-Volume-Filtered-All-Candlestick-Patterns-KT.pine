//@version=5

// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/

// © Tradingview 
// © Kioseff Trading
indicator("Volume Filtered Candle Patterns With Statistics [Kioseff Trading]", overlay=true, max_lines_count = 500, max_labels_count = 500)



//  ________________________________________________
// |                                               |  
// |       ---------------------------------       | 
// |      | K̲ i̲ o̲ s̲ e̲ f̲ f̲     T̲ r̲ a̲ d̲ i̲ n̲ g |      | 
// |      |                                 |      |  
// |      | ƃ u ᴉ p ɐ ɹ ꓕ     ⅎ ⅎ ǝ s o ᴉ ꓘ |      |  
// |       --------------------------------        |  
// |                                               | 
// |_______________________________________________|

dataType = input.string("Mean Reversions", title = "Data Type", options = ["Frequency", "Mean Reversions"], group = "Calculation Type [REQUIRED - Try Both]", tooltip = 'Setting the "Data Type" to "Frequency" calculates the raw number of candlestick patterns that have formed, in addition to the next candle close - whether higher or lower. Setting the "Data Type" to "Mean Reversions" calculates candlestick patterns that form near the outer Bollinger Bands. Bearish patterns must form when the high price of the candle, or the previous candle, extends above the upper band to be distinguished by the indicator. Bullish patterns must form when the low price of the candle, or the previous candle, extends below the lower band to be distinguished by the indicator. ')

volinput = input.float(1.25, title = "Volume Must Be at Least [X] Percent Greater Than Average", group = "Volume Requirement", tooltip = "(1.01 = 1% Greater, 1.25 = 25% = 25% Greater, Numbers Less Than 1.00 Do Not Require the Pattern to Have Greater Than Average Volume) ", step = 0.01, minval = 0.00) 
len = input.int(defval = 5, minval = 1, maxval = 10, title = "Average PnL Calculation Length", group = "Average Gain/loss Calculation Length", tooltip = 'When "Data Type" is set to "Mean Reversions", this setting configures the number of sessions that must occur subsequent to a candlestick pattern for the average gain/loss calculation.')
tabl = input.string("On", title = "Show Statistics Table?", options = ["On", "Off"], group = "Display Options")

volMA = ta.sma(volume, 28)

[middle, upper, lower] = ta.bb(close, 20, 2.0)

l1 = plot(dataType == "Mean Reversions" ? lower : na, color = color.yellow)
u1 = plot(dataType == "Mean Reversions" ? upper : na, color = color.yellow)
fill(l1, u1, color.new(color.yellow, 90))

DownTrend = true
UpTrend = true
var trendRule1 = "SMA50"
var trendRule2 = "SMA50, SMA200"
var trendRule = input.string("No detection", "Detect Trend Based On", options=[trendRule1, trendRule2, "No detection"])

if trendRule == trendRule1
	priceAvg = ta.sma(close, 50)
	DownTrend := close < priceAvg
	UpTrend := close > priceAvg

if trendRule == trendRule2
	sma200 = ta.sma(close, 200)
	sma50 = ta.sma(close, 50)
	DownTrend := close < sma50 and sma50 < sma200
	UpTrend := close > sma50 and sma50 > sma200
Len = 14 // ta.ema depth for bodyAvg
ShadowPercent = 5.0 // size of shadows
ShadowEqualsPercent = 100.0
DojiBodyPercent = 5.0
Factor = 2.0 // shows the TIMES the shadow dominates the candlestick body

BodyHi = math.max(close, open)
BodyLo = math.min(close, open)
Body = BodyHi - BodyLo
BodyAvg = ta.ema(Body, Len)
SmallBody = Body < BodyAvg
LongBody = Body > BodyAvg
UpShadow = high - BodyHi
DnShadow = BodyLo - low
HasUpShadow = UpShadow > ShadowPercent / 100 * Body
HasDnShadow = DnShadow > ShadowPercent / 100 * Body
WhiteBody = open < close
BlackBody = open > close
Range = high-low
IsInsideBar = BodyHi[1] > BodyHi and BodyLo[1] < BodyLo
BodyMiddle = Body / 2 + BodyLo
ShadowEquals = UpShadow == DnShadow or (math.abs(UpShadow - DnShadow) / DnShadow * 100) < ShadowEqualsPercent and (math.abs(DnShadow - UpShadow) / UpShadow * 100) < ShadowEqualsPercent
IsDojiBody = Range > 0 and Body <= Range * DojiBodyPercent / 100
Doji = IsDojiBody and ShadowEquals

patternLabelPosLow = low - (ta.atr(30) * 0.6)
patternLabelPosHigh = high + (ta.atr(30) * 0.6)

label_color_bullish = input(color.blue, "Label Color Bullish")
label_color_bearish = input(color.red, "Label Color Bearish")
label_color_neutral = input(color.gray, "Label Color Neutral")
CandleType = input.string(title = "Pattern Type", defval="Both", options=["Bullish", "Bearish", "Both"])

AbandonedBabyInput = input(title = "Abandoned Baby" ,defval=true) 

DarkCloudCoverInput = input(title = "Dark Cloud Cover" ,defval=true) //

DojiInput = input(title = "Doji" ,defval=true) 

DojiStarInput = input(title = "Doji Star" ,defval=true) 

DownsideTasukiGapInput = input(title = "Downside Tasuki Gap" ,defval=true) 

DragonflyDojiInput = input(title = "Dragonfly Doji" ,defval=true) 

EngulfingInput = input(title = "Engulfing" ,defval=true) //

EveningDojiStarInput = input(title = "Evening Doji Star" ,defval=true) 

EveningStarInput = input(title = "Evening Star" ,defval=true) //

FallingThreeMethodsInput = input(title = "Falling Three Methods" ,defval=true) 

FallingWindowInput = input(title = "Falling Window" ,defval=false) 

GravestoneDojiInput = input(title = "Gravestone Doji" ,defval=true) 

HammerInput = input(title = "Hammer" ,defval=true) //

HangingManInput = input(title = "Hanging Man" ,defval=true) 

HaramiCrossInput = input(title = "Harami Cross" ,defval=true) 

HaramiInput = input(title = "Harami" ,defval=true) 

InvertedHammerInput = input(title = "Inverted Hammer" ,defval=true) 

KickingInput = input(title = "Kicking" ,defval=true) //

LongLowerShadowInput = input(title = "Long Lower Shadow" ,defval=false) 

LongUpperShadowInput = input(title = "Long Upper Shadow" ,defval=false) 

MarubozuBlackInput = input(title = "Marubozu Black" ,defval=true) 

MarubozuWhiteInput = input(title = "Marubozu White" ,defval=true) 

MorningDojiStarInput = input(title = "Morning Doji Star" ,defval=true) 

MorningStarInput = input(title = "Morning Star" ,defval=true) //

OnNeckInput = input(title = "On Neck" ,defval=true) 

PiercingInput = input(title = "Piercing" ,defval=true) //

RisingThreeMethodsInput = input(title = "Rising Three Methods" ,defval=true) 

RisingWindowInput = input(title = "Rising Window" ,defval=false) 

ShootingStarInput = input(title = "Shooting Star" ,defval=true) //

SpinningTopBlackInput = input(title = "Spinning Top Black" ,defval=true) 

SpinningTopWhiteInput = input(title = "Spinning Top White" ,defval=true) 

ThreeBlackCrowsInput = input(title = "Three Black Crows" ,defval=true) 

ThreeWhiteSoldiersInput = input(title = "Three White Soldiers" ,defval=true) 

TriStarInput = input(title = "Tri-Star" ,defval=true) 

TweezerBottomInput = input(title = "Tweezer Bottom" ,defval=true) 

TweezerTopInput = input(title = "Tweezer Top" ,defval=true) 

UpsideTasukiGapInput = input(title = "Upside Tasuki Gap" ,defval=true) 


v1(x, y) =>
    j = y - x
    t = math.abs(x)
    fin = j / t * 100

c = v1(volMA, volume)


var label [] x = array.new_label()
var line [] y = array.new_line()
var label [] z = array.new_label()
var float [] cX = array.new_float(44)

xL = array.size(y) > 0 ? line.get_y2(array.get(y, array.size(y) - 1)) : na
xString = "Volume Is " +  str.tostring(c, format.percent) + " Greater Than Average"

xZ(x) => 
    array.push(x, line.new(bar_index, patternLabelPosHigh, bar_index, patternLabelPosHigh * 1.05, color = color.new(color.red, 50), style = line.style_dashed))
xY(x) =>
    array.push(x, line.new(bar_index, patternLabelPosLow, bar_index, patternLabelPosLow * .95, color = color.new(color.blue, 50), style = line.style_dashed))
zX(x) =>
    array.push(x, label.new(bar_index, array.size(y) > 0 ? line.get_y2(array.get(y, array.size(y) - 1)) : patternLabelPosHigh * 1.05, text = xString, textcolor = color.white, color = color.new(color.red, 50)))
zY(x) =>
    array.push(x, label.new(bar_index,  array.size(y) > 0 ? line.get_y2(array.get(y, array.size(y) - 1)) : patternLabelPosLow * .95, style = label.style_label_up, text = xString, textcolor = color.white, color = color.new(color.blue, 50)))


zN(x) =>
    array.push(x, line.new(bar_index, patternLabelPosLow, bar_index, patternLabelPosLow * .95, color = color.new(color.gray, 50), style = line.style_dashed))
zM(x) =>
    array.push(x, label.new(bar_index, array.size(y) > 0 ? line.get_y2(array.get(y, array.size(y) - 1)) : patternLabelPosLow * .95, style = label.style_label_up, text = xString, textcolor = color.white, color = color.new(color.gray, 50)))


// _________________________________________________________________________________________________________________________________________

OnNeckBearish = DownTrend and BlackBody[1] and LongBody[1] and WhiteBody and open < close[1] and SmallBody and Range!=0 and math.abs(close-low[1])<=BodyAvg*0.05
OnNeck = OnNeckBearish  and  OnNeckInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if OnNeck and dataType == "Frequency"
    var ttBearishOnNeck = "On Neck\nOn Neck is a two-line continuation pattern found in a downtrend. The first candle is long and red, the second candle is short and has a green body. The closing price of the second candle is close or equal to the first candle's low price. The pattern hints at a continuation of a downtrend, and penetrating the low of the green candlestick is sometimes considered a confirmation. "
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="ON", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishOnNeck))
    xZ(y)
    zX(z)


// _________________________________________________________________________________________________________________________________________ //

RisingWindowBullish = UpTrend[1] and (Range!=0 and Range[1]!=0) and low > high[1]
rWB = RisingWindowBullish and  RisingWindowInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if rWB and dataType == "Frequency"
    var ttBullishRisingWindow = "Rising Window\nRising Window is a two-candle bullish continuation pattern that forms during an uptrend. Both candles in the pattern can be of any type with the exception of the Four-Price Doji. The most important characteristic of the pattern is a price gap between the first candle's high and the second candle's low. That gap (window) between two bars signifies support against the selling pressure."

    array.push(x, label.new(bar_index, patternLabelPosLow, text="RW", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishRisingWindow))
    xY(y)
    zY(z)


// _________________________________________________________________________________________________________________________________________


FallingWindowBearish = DownTrend[1] and (Range!=0 and Range[1]!=0) and high < low[1]
cWB = FallingWindowBearish  and  FallingWindowInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cWB and dataType == "Frequency"
    var ttBearishFallingWindow = "Falling Window\nFalling Window is a two-candle bearish continuation pattern that forms during a downtrend. Both candles in the pattern can be of any type, with the exception of the Four-Price Doji. The most important characteristic of the pattern is a price gap between the first candle's low and the second candle's high. The existence of this gap (window) means that the bearish trend is expected to continue."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="FW", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishFallingWindow))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________

FallingThreeMethodsBearish = DownTrend[4] and (LongBody[4] and BlackBody[4]) and (SmallBody[3] and WhiteBody[3] and open[3]>low[4] and close[3]<high[4]) and (SmallBody[2] and WhiteBody[2] and open[2]>low[4] and close[2]<high[4]) and (SmallBody[1] and WhiteBody[1] and open[1]>low[4] and close[1]<high[4]) and (LongBody and BlackBody and close<close[4])
cFTMB =  FallingThreeMethodsBearish  and  FallingThreeMethodsInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cFTMB and dataType == "Frequency"
    var ttBearishFallingThreeMethods = "Falling Three Methods\nFalling Three Methods is a five-candle bearish pattern that signifies a continuation of an existing downtrend. The first candle is long and red, followed by three short green candles with bodies inside the range of the first candle. The last candle is also red and long and it closes below the close of the first candle. This decisive fifth strongly bearish candle hints that bulls could not reverse the prior downtrend and that bears have regained control of the market."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="FTM", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishFallingThreeMethods))
    xZ(y)
    zX(z)
    


// _________________________________________________________________________________________________________________________________________

RisingThreeMethodsBullish = UpTrend[4] and (LongBody[4] and WhiteBody[4]) and (SmallBody[3] and BlackBody[3] and open[3]<high[4] and close[3]>low[4]) and (SmallBody[2] and BlackBody[2] and open[2]<high[4] and close[2]>low[4]) and (SmallBody[1] and BlackBody[1] and open[1]<high[4] and close[1]>low[4]) and (LongBody and WhiteBody and close>close[4])
cRTMB =  RisingThreeMethodsBullish  and  RisingThreeMethodsInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cRTMB and dataType == "Frequency"
    var ttBullishRisingThreeMethods = "Rising Three Methods\nRising Three Methods is a five-candle bullish pattern that signifies a continuation of an existing uptrend. The first candle is long and green, followed by three short red candles with bodies inside the range of the first candle. The last candle is also green and long and it closes above the close of the first candle. This decisive fifth strongly bullish candle hints that bears could not reverse the prior uptrend and that bulls have regained control of the market."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="RTM", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishRisingThreeMethods))
    xY(y)
    zY(z)
    
// _________________________________________________________________________________________________________________________________________

TweezerTopBearish = UpTrend[1] and (not IsDojiBody or (HasUpShadow and HasDnShadow)) and math.abs(high-high[1]) <= BodyAvg*0.05 and WhiteBody[1] and BlackBody and LongBody[1]
cTTB = TweezerTopBearish  and  TweezerTopInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cTTB and dataType == "Frequency"
    var ttBearishTweezerTop = "Tweezer Top\nTweezer Top is a two-candle pattern that signifies a potential bearish reversal. The pattern is found during an uptrend. The first candle is long and green, the second candle is red, and its high is nearly identical to the high of the previous candle. The virtually identical highs, together with the inverted directions, hint that bears might be taking over the market."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="TT", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishTweezerTop))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________

TweezerBottomBullish = UpTrend[1] and (not IsDojiBody or (HasUpShadow and HasDnShadow)) and math.abs(low-low[1]) <= BodyAvg*0.05 and BlackBody[1] and WhiteBody and LongBody[1]
cTTb = TweezerBottomBullish  and  TweezerBottomInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cTTb and dataType == "Frequency"
    var ttBullishTweezerBottom = "Tweezer Bottom\nTweezer Bottom is a two-candle pattern that signifies a potential bullish reversal. The pattern is found during a downtrend. The first candle is long and red, the second candle is green, its lows nearly identical to the low of the previous candle. The virtually identical lows together with the inverted directions hint that bulls might be taking over the market."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="TB", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishTweezerBottom))
    xY(y)
    zY(z)
    

// _________________________________________________________________________________________________________________________________________

DarkCloudCoverBearish = (UpTrend[1] and WhiteBody[1] and LongBody[1]) and (BlackBody and open >= high[1] and  close < BodyMiddle[1] and close > open[1])
cDCCB =  DarkCloudCoverBearish  and  DarkCloudCoverInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cDCCB and dataType == "Frequency"
    var ttBearishDarkCloudCover = "Dark Cloud Cover\nDark Cloud Cover is a two-candle bearish reversal candlestick pattern found in an uptrend. The first candle is green and has a larger than average body. The second candle is red and opens above the high of the prior candle, creating a gap, and then closes below the midpoint of the first candle. The pattern shows a possible shift in the momentum from the upside to the downside, indicating that a reversal might happen soon."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="DCC", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishDarkCloudCover))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________

DownsideTasukiGapBearish = LongBody[2] and SmallBody[1] and DownTrend and BlackBody[2] and BodyHi[1] < BodyLo[2] and BlackBody[1] and WhiteBody and BodyHi <= BodyLo[2] and BodyHi >= BodyHi[1]
cDTGB = DownsideTasukiGapBearish  and  DownsideTasukiGapInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cDTGB and dataType == "Frequency"
    var ttBearishDownsideTasukiGap = "Downside Tasuki Gap\nDownside Tasuki Gap is a three-candle pattern found in a downtrend that usually hints at the continuation of the downtrend. The first candle is long and red, followed by a smaller red candle with its opening price that gaps below the body of the previous candle. The third candle is green and it closes inside the gap created by the first two candles, unable to close it fully. The bull’s inability to close that gap hints that the downtrend might continue."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="DTG", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishDownsideTasukiGap))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________

UpsideTasukiGapBullish = LongBody[2] and SmallBody[1] and UpTrend and WhiteBody[2] and BodyLo[1] > BodyHi[2] and WhiteBody[1] and BlackBody and BodyLo >= BodyHi[2] and BodyLo <= BodyLo[1]
cUTGB = UpsideTasukiGapBullish  and  UpsideTasukiGapInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cUTGB and dataType == "Frequency"
    var ttBullishUpsideTasukiGap = "Upside Tasuki Gap\nUpside Tasuki Gap is a three-candle pattern found in an uptrend that usually hints at the continuation of the uptrend. The first candle is long and green, followed by a smaller green candle with its opening price that gaps above the body of the previous candle. The third candle is red and it closes inside the gap created by the first two candles, unable to close it fully. The bear’s inability to close the gap hints that the uptrend might continue."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="UTG", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishUpsideTasukiGap))
    xY(y)
    zY(z)
    

// _________________________________________________________________________________________________________________________________________

EveningDojiStarBearish = LongBody[2] and IsDojiBody[1] and LongBody and UpTrend and WhiteBody[2] and BodyLo[1] > BodyHi[2] and BlackBody and BodyLo <= BodyMiddle[2] and BodyLo > BodyLo[2] and BodyLo[1] > BodyHi
cEDSB = EveningDojiStarBearish  and  EveningDojiStarInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cEDSB and dataType == "Frequency"
    var ttBearishEveningDojiStar = "Evening Doji Star \nThis candlestick pattern is a variation of the EVENING STAR pattern. It is bearish and continues an uptrend with a long-bodied, green candle day. It is then followed by a gap and a Doji candle and concludes with a downward close. The close would be below the first day’s midpoint. It is more bearish than the regular EVENING STAR pattern because of the existence of the Doji."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="EDS", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishEveningDojiStar))
    xZ(y)
    zX(z)
    

DojiStarBearish =  UpTrend and WhiteBody[1] and LongBody[1] and IsDojiBody and BodyLo > BodyHi[1]
cDSB = DojiStarBearish  and  DojiStarInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cDSB and dataType == "Frequency"
    var ttBearishDojiStar = "Doji Star\nThis is a bearish reversal candlestick pattern that is found in an uptrend and consists of two candles. First comes a long green candle, followed by a Doji candle (except 4-Price Doji) that opens above the body of the first one, creating a gap. It is considered a reversal signal with confirmation during the next trading day."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="DS", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishDojiStar))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
DojiStarBullish = DownTrend and BlackBody[1] and LongBody[1] and IsDojiBody and BodyHi < BodyLo[1]
cDSb = DojiStarBullish  and  DojiStarInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cDSb and dataType == "Frequency"
    var ttBullishDojiStar = "Doji Star\nThis is a bullish reversal candlestick pattern that is found in a downtrend and consists of two candles. First comes a long red candle, followed by a Doji candle (except 4-Price Doji) that opens below the body of the first one, creating a gap. It is considered a reversal signal with confirmation during the next trading day."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="DS", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishDojiStar))
    xY(y)
    zY(z)
    


// _________________________________________________________________________________________________________________________________________
MorningDojiStarBullish = LongBody[2] and IsDojiBody[1] and LongBody and DownTrend and BlackBody[2] and BodyHi[1] < BodyLo[2] and WhiteBody and BodyHi >= BodyMiddle[2] and BodyHi < BodyHi[2] and BodyHi[1] < BodyLo
cMDSB = MorningDojiStarBullish  and  MorningDojiStarInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cMDSB  and dataType == "Frequency"
    var ttBullishMorningDojiStar = "Morning Doji Star\nThis candlestick pattern is a variation of the Morning Star pattern. A three-day bullish reversal pattern, which consists of three candlesticks will look something like this: The first being a long-bodied red candle that extends the current downtrend. Next comes a Doji that gaps down on the open. After that comes a long-bodied green candle, which gaps up on the open and closes above the midpoint of the body of the first day. It is more bullish than the regular morning star pattern because of the existence of the Doji."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="MDS", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishMorningDojiStar))
    xY(y)
    zY(z)
    


// _________________________________________________________________________________________________________________________________________
PiercingBullish = (DownTrend[1] and BlackBody[1] and LongBody[1]) and (WhiteBody and open <= low[1] and close > BodyMiddle[1] and close < open[1])
cPB = PiercingBullish  and  PiercingInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cPB and dataType == "Frequency"
    var ttBullishPiercing = "Piercing\nPiercing is a two-candle bullish reversal candlestick pattern found in a downtrend. The first candle is red and has a larger than average body. The second candle is green and opens below the low of the prior candle, creating a gap, and then closes above the midpoint of the first candle. The pattern shows a possible shift in the momentum from the downside to the upside, indicating that a reversal might happen soon."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="P", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishPiercing))
    xY(y)
    zY(z)
    


// _________________________________________________________________________________________________________________________________________
HammerBullish = false
if SmallBody and Body > 0 and BodyLo > hl2 and DnShadow >= Factor * Body and not HasUpShadow
    if DownTrend
        HammerBullish := true
cHB = HammerBullish  and  HammerInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cHB and dataType == "Frequency"
    var ttBullishHammer = "Hammer\nHammer candlesticks form when a security moves lower after the open, but continues to rally into close above the intraday low. The candlestick that you are left with will look like a square attached to a long stick-like figure. This candlestick is called a Hammer if it happens to form during a decline."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="H", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishHammer))
    xY(y)
    zY(z)
    


// _________________________________________________________________________________________________________________________________________
HangingManBearish = false
if SmallBody and Body > 0 and BodyLo > hl2 and DnShadow >= Factor * Body and not HasUpShadow
	if UpTrend
	    HangingManBearish := true
alertcondition(HangingManBearish, title = "Hanging Man – Bearish", message = "New Hanging Man – Bearish pattern detected")
cHMB = HangingManBearish  and  HangingManInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cHMB and dataType == "Frequency"
    var ttBearishHangingMan = "Hanging Man\nWhen a specified security notably moves lower after the open, but continues to rally to close above the intraday low, a Hanging Man candlestick will form. The candlestick will resemble a square, attached to a long stick-like figure. It is referred to as a Hanging Man if the candlestick forms during an advance."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="HM", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishHangingMan))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
ShootingStarBearish = false
if SmallBody and Body > 0 and BodyHi < hl2 and UpShadow >= Factor * Body and not HasDnShadow
	if UpTrend
	    ShootingStarBearish := true
alertcondition(ShootingStarBearish, title = "Shooting Star – Bearish", message = "New SHOOTING STAR – Bearish pattern detected")
cSSB = ShootingStarBearish  and  ShootingStarInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cSSB and dataType == "Frequency"
    var ttBearishShootingStar = "Shooting Star\nThis single day pattern can appear during an uptrend and opens high, while it closes near its open. It trades much higher as well. It is bearish in nature, but looks like an Inverted Hammer."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="SS", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishShootingStar))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
InvertedHammerBullish = false
if SmallBody and Body > 0 and BodyHi < hl2 and UpShadow >= Factor * Body and not HasDnShadow
    if DownTrend
        InvertedHammerBullish := true
alertcondition(InvertedHammerBullish, title = "Inverted Hammer – Bullish", message = "New Inverted Hammer – Bullish pattern detected")
cIHB = InvertedHammerBullish  and  InvertedHammerInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cIHB and dataType == "Frequency"
    var ttBullishInvertedHammer = "Inverted Hammer\nIf in a downtrend, then the open is lower. When it eventually trades higher, but closes near its open, it will look like an inverted version of the Hammer Candlestick. This is a one-day bullish reversal pattern."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="IH", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishInvertedHammer))
    xY(y)
    zY(z)
    



// _________________________________________________________________________________________________________________________________________
MorningStarBullish = false
if LongBody[2] and SmallBody[1] and LongBody
    if DownTrend and BlackBody[2] and BodyHi[1] < BodyLo[2] and WhiteBody and BodyHi >= BodyMiddle[2] and BodyHi < BodyHi[2] and BodyHi[1] < BodyLo
        MorningStarBullish := true
alertcondition(MorningStarBullish, title = "Morning Star – Bullish", message = "New Morning Star – Bullish pattern detected")
cMSB = MorningStarBullish  and  MorningStarInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cMSB and dataType == "Frequency"
    var ttBullishMorningStar = "Morning Star\nA three-day bullish reversal pattern, which consists of three candlesticks will look something like this: The first being a long-bodied red candle that extends the current downtrend. Next comes a short, middle candle that gaps down on the open. After comes a long-bodied green candle, which gaps up on the open and closes above the midpoint of the body of the first day."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="MS", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishMorningStar))
    xY(y)
    zY(z)
    



// _________________________________________________________________________________________________________________________________________
EveningStarBearish = false
if LongBody[2] and SmallBody[1] and LongBody
    if UpTrend and WhiteBody[2] and BodyLo[1] > BodyHi[2] and BlackBody and BodyLo <= BodyMiddle[2] and BodyLo > BodyLo[2] and BodyLo[1] > BodyHi
        EveningStarBearish := true
alertcondition(EveningStarBearish, title = "Evening Star – Bearish", message = "New EVENING STAR – Bearish pattern detected")
cESB = EveningStarBearish  and  EveningStarInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cESB and dataType == "Frequency"
    var ttBearishEveningStar = "Evening Star\nThis candlestick pattern is bearish and continues an uptrend with a long-bodied, green candle day. It is then followed by a gapped and small-bodied candle day, and concludes with a downward close. The close would be below the first day’s midpoint."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="ES", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishEveningStar))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
MarubozuShadowPercentWhite = 5.0
MarubozuWhiteBullish = WhiteBody and LongBody and UpShadow <= MarubozuShadowPercentWhite/100*Body and DnShadow <= MarubozuShadowPercentWhite/100*Body and WhiteBody
cMWB =  MarubozuWhiteBullish  and  MarubozuWhiteInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cMWB and dataType == "Frequency"
    var ttBullishMarubozuWhite = "Marubozu White\nA MARUBOZU WHITE Candle is a candlestick that does not have a shadow that extends from its candle body at either the open or the close. Marubozu is Japanese for “close-cropped” or “close-cut.” Other sources may call it a Bald or Shaven Head Candle."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="MW", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishMarubozuWhite))
    xY(y)
    zY(z)
    




// _________________________________________________________________________________________________________________________________________
MarubozuShadowPercentBearish = 5.0
MarubozuBlackBearish = BlackBody and LongBody and UpShadow <= MarubozuShadowPercentBearish/100*Body and DnShadow <= MarubozuShadowPercentBearish/100*Body and BlackBody
cMBB = MarubozuBlackBearish  and  MarubozuBlackInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cMBB and dataType == "Frequency"
    // var ttBearishMarubozuBlack = "Marubozu Black\nThis is a candlestick that has no shadow, which extends from the red-bodied candle at the open, the close, or even at both. In Japanese, the name means “close-cropped” or “close-cut.” The candlestick can also be referred to as Bald or Shaven Head."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="MB", style=label.style_label_down, color = label_color_bearish, textcolor=color.white))
    xZ(y)
    zX(z)
    


// _________________________________________________________________________________________________________________________________________
DragonflyDoji = IsDojiBody and UpShadow <= Body
GravestoneDojiOne = IsDojiBody and DnShadow <= Body
cD = Doji and not DragonflyDoji and not GravestoneDojiOne and DojiInput and volume >= (volMA * volinput)
  
if cD  and dataType == "Frequency"
    var ttDoji = "Doji\nWhen the open and close of a security are essentially equal to each other, a doji candle forms. The length of both upper and lower shadows may vary, causing the candlestick you are left with to either resemble a cross, an inverted cross, or a plus sign. Doji candles show the playout of buyer-seller indecision in a tug-of-war of sorts. As price moves either above or below the opening level during the session, the close is either at or near the opening level."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="D", style=label.style_label_up, color = label_color_neutral, textcolor=color.white, tooltip = ttDoji))
    zN(y)
    zM(z)
    




// _________________________________________________________________________________________________________________________________________
GravestoneDojiBearish = IsDojiBody and DnShadow <= Body
cGDB = GravestoneDojiBearish  and  GravestoneDojiInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cGDB and dataType == "Frequency"
    var ttBearishGravestoneDoji = "Gravestone Doji\nWhen a doji is at or is close to the day’s low point, a doji line will develop."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="GD", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishGravestoneDoji))
    xZ(y)
    zX(z)
    


// _________________________________________________________________________________________________________________________________________
DragonflyDojiBullish = IsDojiBody and UpShadow <= Body

cDDB = DragonflyDojiBullish  and  DragonflyDojiInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cDDB and dataType == "Frequency"
    var ttBullishDragonflyDoji = "Dragonfly Doji\nSimilar to other Doji days, this particular Doji also regularly appears at pivotal market moments. This is a specific Doji where both the open and close price are at the high of a given day."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="DD", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishDragonflyDoji))
    xY(y)
    zY(z)
    




// _________________________________________________________________________________________________________________________________________
HaramiCrossBullish = LongBody[1] and BlackBody[1] and DownTrend[1] and IsDojiBody and high <= BodyHi[1] and low >= BodyLo[1]

cHCB = HaramiCrossBullish  and  HaramiCrossInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cHCB and dataType == "Frequency"
    var ttBullishHaramiCross = "Harami Cross\nThis candlestick pattern is a variation of the HARAMI BULLISH pattern. It is found during a downtrend. The two-day candlestick pattern consists of a Doji candle that is entirely encompassed within the body of what was once a red-bodied candle."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="HC", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishHaramiCross))
    xY(y)
    zY(z)
    




// _________________________________________________________________________________________________________________________________________
HaramiCrossBearish = LongBody[1] and WhiteBody[1] and UpTrend[1] and IsDojiBody and high <= BodyHi[1] and low >= BodyLo[1]

cHCb = HaramiCrossBearish  and  HaramiCrossInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cHCb and dataType == "Frequency"
    var ttBearishHaramiCross = "Harami Cross\nThis candlestick pattern is a variation of the HARAMI BEARISH pattern. It is found during an uptrend. This is a two-day candlestick pattern with a Doji candle that is entirely encompassed within the body that was once a green-bodied candle. The Doji shows that some indecision has entered the minds of sellers, and the pattern hints that the trend might reverse."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="HC", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishHaramiCross))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
HaramiBullish = LongBody[1] and BlackBody[1] and DownTrend[1] and WhiteBody and SmallBody and high <= BodyHi[1] and low >= BodyLo[1]

cHBu = HaramiBullish  and  HaramiInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cHBu and dataType == "Frequency"
    var ttBullishHarami = "Harami\nThis two-day candlestick pattern consists of a small-bodied green candle that is entirely encompassed within the body of what was once a red-bodied candle."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="BH", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishHarami))
    xY(y)
    zY(z)
    




// _________________________________________________________________________________________________________________________________________
HaramiBearish = LongBody[1] and WhiteBody[1] and UpTrend[1] and BlackBody and SmallBody and high <= BodyHi[1] and low >= BodyLo[1]

cHb = HaramiBearish  and  HaramiInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cHb and dataType == "Frequency"
    var ttBearishHarami = "Harami\nThis is a two-day candlestick pattern with a small, red-bodied candle that is entirely encompassed within the body that was once a green-bodied candle."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="BH", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishHarami))
    xZ(y)
    zX(z)
    


// _________________________________________________________________________________________________________________________________________
LongLowerShadowPercent = 75.0
LongLowerShadowBullish = DnShadow > Range/100*LongLowerShadowPercent

cLLSB = LongLowerShadowBullish  and  LongLowerShadowInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cLLSB and dataType == "Frequency"
    var ttBullishLongLowerShadow = "Long Lower Shadow\nTo indicate seller domination of the first part of a session, candlesticks will present with LONG LOWER SHADOWs and short upper shadows, consequently lowering prices."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="LLS", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishLongLowerShadow))
    xY(y)
    zY(z)
    




// _________________________________________________________________________________________________________________________________________
LongShadowPercent = 75.0
LongUpperShadowBearish = UpShadow > Range/100*LongShadowPercent
cLUSB = LongUpperShadowBearish  and  LongUpperShadowInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cLUSB and dataType == "Frequency"
    var ttBearishLongUpperShadow = "Long Upper Shadow\nTo indicate buyer domination of the first part of a session, candlesticks will present with LONG UPPER SHADOWs, as well as short lower shadows, consequently raising bidding prices."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="LUS", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishLongUpperShadow))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
SpinningTopWhitePercent = 34.0
IsSpinningTopWhite = DnShadow >= Range / 100 * SpinningTopWhitePercent and UpShadow >= Range / 100 * SpinningTopWhitePercent and not IsDojiBody
SpinningTopWhite = IsSpinningTopWhite and WhiteBody
cSTW = SpinningTopWhite and SpinningTopWhiteInput and volume >= (volMA * volinput)

if cSTW and dataType == "Frequency"
    var ttSpinningTopWhite = "Spinning Top White\nWhite spinning tops are candlestick lines that are small, green-bodied, and possess shadows (upper and lower) that end up exceeding the length of candle bodies. They often signal indecision between buyer and seller."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="STW", style=label.style_label_up, color = label_color_neutral, textcolor=color.white, tooltip = ttSpinningTopWhite))
    zN(y)
    zM(z)
    


// _________________________________________________________________________________________________________________________________________
SpinningTopBlackPercent = 34.0
IsSpinningTop = DnShadow >= Range / 100 * SpinningTopBlackPercent and UpShadow >= Range / 100 * SpinningTopBlackPercent and not IsDojiBody
SpinningTopBlack = IsSpinningTop and BlackBody



cSTB = SpinningTopBlack and SpinningTopBlackInput and volume >= (volMA * volinput)
if cSTB     and dataType == "Frequency"
    var ttSpinningTopBlack = "Spinning Top Black\nBlack spinning tops are candlestick lines that are small, red-bodied, and possess shadows (upper and lower) that end up exceeding the length of candle bodies. They often signal indecision."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="STB", style=label.style_label_up, color = label_color_neutral, textcolor=color.white, tooltip = ttSpinningTopBlack))
    zN(y)
    zM(z)
    


// _________________________________________________________________________________________________________________________________________
WSld_ShadowPercent = 5.0
WSld_HaveNotUpShadow = Range * WSld_ShadowPercent / 100 > UpShadow
ThreeWhiteSoldiersBullish = false

if LongBody and LongBody[1] and LongBody[2]
    if WhiteBody and WhiteBody[1] and WhiteBody[2]
        ThreeWhiteSoldiersBullish := close > close[1] and close[1] > close[2] and open < close[1] and open > open[1] and open[1] < close[2] and open[1] > open[2] and WSld_HaveNotUpShadow and WSld_HaveNotUpShadow[1] and WSld_HaveNotUpShadow[2]
cTWSB = ThreeWhiteSoldiersBullish  and  ThreeWhiteSoldiersInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cTWSB and dataType == "Frequency"
    var ttBullishThreeWhiteSoldiers = "Three White Soldiers\nThis bullish reversal pattern is made up of three long-bodied, green candles in immediate succession. Each one opens within the body before it and the close is near to the daily high."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="3WS", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishThreeWhiteSoldiers))
    xY(y)
    zY(z)
    



// _________________________________________________________________________________________________________________________________________
BCrw_ShadowPercent = 5.0
BCrw_HaveNotDnShadow = Range * BCrw_ShadowPercent / 100 > DnShadow
ThreeBlackCrowsBearish = false
if LongBody and LongBody[1] and LongBody[2]
    if BlackBody and BlackBody[1] and BlackBody[2]
        ThreeBlackCrowsBearish := close < close[1] and close[1] < close[2] and open > close[1] and open < open[1] and open[1] > close[2] and open[1] < open[2] and BCrw_HaveNotDnShadow and BCrw_HaveNotDnShadow[1] and BCrw_HaveNotDnShadow[2]
cTBCB = ThreeBlackCrowsBearish  and  ThreeBlackCrowsInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cTBCB and dataType == "Frequency"
    var ttBearishThreeBlackCrows = "Three Black Crows\nThis is a bearish reversal pattern that consists of three long, red-bodied candles in immediate succession. For each of these candles, each day opens within the body of the day before and closes either at or near its low."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="3BC", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishThreeBlackCrows))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
EngulfingBullish = DownTrend and WhiteBody and LongBody and BlackBody[1] and SmallBody[1] and close >= open[1] and open <= close[1] and ( close > open[1] or open < close[1] )
cEB = EngulfingBullish  and  EngulfingInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cEB and dataType == "Frequency"
    var ttBullishEngulfing = "Engulfing\nAt the end of a given downward trend, there will most likely be a reversal pattern. To distinguish the first day, this candlestick pattern uses a small body, followed by a day where the candle body fully overtakes the body from the day before, and closes in the trend’s opposite direction. Although similar to the outside reversal chart pattern, it is not essential for this pattern to completely overtake the range (high to low), rather only the open and the close."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="BE", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishEngulfing))
    xY(y)
    zY(z)
    



// _________________________________________________________________________________________________________________________________________
EngulfingBearish = UpTrend and BlackBody and LongBody and WhiteBody[1] and SmallBody[1] and close <= open[1] and open >= close[1] and ( close < open[1] or open > close[1] )
cEb = EngulfingBearish  and  EngulfingInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cEb and dataType == "Frequency"
    var ttBearishEngulfing = "Engulfing\nAt the end of a given uptrend, a reversal pattern will most likely appear. During the first day, this candlestick pattern uses a small body. It is then followed by a day where the candle body fully overtakes the body from the day before it and closes in the trend’s opposite direction. Although similar to the outside reversal chart pattern, it is not essential for this pattern to fully overtake the range (high to low), rather only the open and the close."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="BE", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishEngulfing))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
AbandonedBabyBullish = DownTrend[2] and BlackBody[2] and IsDojiBody[1] and low[2] > high[1] and WhiteBody and high[1] < low
cABB = AbandonedBabyBullish  and  AbandonedBabyInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cABB and dataType == "Frequency"
    var ttBullishAbandonedBaby = "Abandoned Baby\nThis candlestick pattern is quite rare as far as reversal patterns go. The first of the pattern is a large down candle. Next comes a doji candle that gaps below the candle before it. The doji candle is then followed by another candle that opens even higher and swiftly moves to the upside."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="AB", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishAbandonedBaby))
    xY(y)
    zY(z)
    


// _________________________________________________________________________________________________________________________________________
AbandonedBabyBearish = UpTrend[2] and WhiteBody[2] and IsDojiBody[1] and high[2] < low[1] and BlackBody and low[1] > high
cABb =  AbandonedBabyBearish  and  AbandonedBabyInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cABb and dataType == "Frequency"
    var ttBearishAbandonedBaby = "Abandoned Baby\nA bearish abandoned baby is a specific candlestick pattern that often signals a downward reversal trend in terms of security price. It is formed when a gap appears between the lowest price of a doji-like candle and the candlestick of the day before. The earlier candlestick is green, tall, and has small shadows. The doji candle is also tailed by a gap between its lowest price point and the highest price point of the candle that comes next, which is red, tall and also has small shadows. The doji candle shadows must completely gap either below or above the shadows of the first and third day in order to have the abandoned baby pattern effect."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="AB", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishAbandonedBaby))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
DojisBullish = Doji[2] and Doji[1] and Doji
BodyGapUpBullish = BodyHi[1] < BodyLo
BodyGapDnBullish = BodyLo[1] > BodyHi
TriStarBullish = DojisBullish and DownTrend[2] and BodyGapDnBullish[1] and BodyGapUpBullish
cTSB = TriStarBullish  and  TriStarInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cTSB and dataType == "Frequency"
    var ttBullishTriStar = "Tri-Star\nA bullish TriStar candlestick pattern can form when three doji candlesticks materialize in immediate succession at the tail-end of an extended downtrend. The first doji candle marks indecision between bull and bear. The second doji gaps in the direction of the leading trend. The third changes the attitude of the market once the candlestick opens in the direction opposite to the trend. Each doji candle has a shadow, all comparatively shallow, which signify an interim cutback in volatility."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="3S", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishTriStar))
    xY(y)
    zY(z)
    



// _________________________________________________________________________________________________________________________________________
Dojis = Doji[2] and Doji[1] and Doji
BodyGapUp = BodyHi[1] < BodyLo
BodyGapDn = BodyLo[1] > BodyHi
TriStarBearish = Dojis and UpTrend[2] and BodyGapUp[1] and BodyGapDn
cTSb = TriStarBearish  and  TriStarInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cTSb and dataType == "Frequency"
    var ttBearishTriStar = "Tri-Star\nThis particular pattern can form when three doji candlesticks appear in immediate succession at the end of an extended uptrend. The first doji candle marks indecision between bull and bear. The second doji gaps in the direction of the leading trend. The third changes the attitude of the market once the candlestick opens in the direction opposite to the trend. Each doji candle has a shadow, all comparatively shallow, which signify an interim cutback in volatility."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="3S", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishTriStar))
    xZ(y)
    zX(z)
    

// _________________________________________________________________________________________________________________________________________
MarubozuShadowPercent = 5.0
Marubozu = LongBody and UpShadow <= MarubozuShadowPercent/100*Body and DnShadow <= MarubozuShadowPercent/100*Body
MarubozuWhiteBullishKicking = Marubozu and WhiteBody
MarubozuBlackBullish = Marubozu and BlackBody
KickingBullish = MarubozuBlackBullish[1] and MarubozuWhiteBullishKicking and high[1] < low
cKB = KickingBullish  and  KickingInput and (("Bullish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cKB and dataType == "Frequency"
    var ttBullishKicking = "Kicking\nThe first day candlestick is a bearish marubozu candlestick with next to no upper or lower shadow and where the price opens at the day’s high and closes at the day’s low. The second day is a bullish marubozu pattern, with next to no upper or lower shadow and where the price opens at the day’s low and closes at the day’s high. Additionally, the second day gaps up extensively and opens above the opening price of the day before. This gap or window, as the Japanese call it, lies between day one and day two’s bullish candlesticks."
    array.push(x, label.new(bar_index, patternLabelPosLow, text="K", style=label.style_label_up, color = label_color_bullish, textcolor=color.white, tooltip = ttBullishKicking))
    xY(y)
    zY(z)
    



// _________________________________________________________________________________________________________________________________________
KickingBearishNumberOfCandles = 2
MarubozuBullishShadowPercent = 5.0
MarubozuBearishKicking = LongBody and UpShadow <= MarubozuBullishShadowPercent/100*Body and DnShadow <= MarubozuBullishShadowPercent/100*Body
MarubozuWhiteBearish = MarubozuBearishKicking and WhiteBody
MarubozuBlackBearishKicking = MarubozuBearishKicking and BlackBody
KickingBearish = MarubozuWhiteBearish[1] and MarubozuBlackBearishKicking and low[1] > high
cKb = KickingBearish  and  KickingInput and (("Bearish" == CandleType) or CandleType == "Both") and volume >= (volMA * volinput)

if cKb and dataType == "Frequency"
    var ttBearishKicking = "Kicking\nA bearish kicking pattern will occur, subsequently signaling a reversal for a new downtrend. The first day candlestick is a bullish marubozu. The second day gaps down extensively and opens below the opening price of the day before. There is a gap between day one and two’s bearish candlesticks."
    array.push(x, label.new(bar_index, patternLabelPosHigh, text="K", style=label.style_label_down, color = label_color_bearish, textcolor=color.white, tooltip = ttBearishKicking))
    xZ(y)
    zX(z)    
    
    var ttAllCandlestickPatterns = "All Candlestick Patterns\n"
    array.push(x, label.new(bar_index, patternLabelPosLow, text="Collection", style=label.style_label_up, color = label_color_neutral, textcolor=color.white, tooltip = ttAllCandlestickPatterns))
    xY(y)
    zY(z)
    
    
// End Tradingview Code


