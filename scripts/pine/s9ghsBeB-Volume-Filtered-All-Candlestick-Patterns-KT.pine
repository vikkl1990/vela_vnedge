volYY = volume[1] >= (volMA[1] * volinput)         
        
volr(x) =>
    array.get(count, x)

sZ(x, y) =>
    array.set(count, x, y and volY ? volr(x) + 1 : volr(x))
        
        
cXcount(y) =>
    array.get(cX, y)
    
cXcond = volYY and close > close[1] 

cXfin(x, y) => 
    array.set(cX, x,  y [1] and cXcond ? cXcount(x) + 1 : cXcount(x))    
    
    
div(x) =>
    j = nz(array.get(cX, x) / array.get(count, x)) * 100
    

set(x) =>
    array.set(perc, x, div(x))


loww = low < lower or low[1] < lower[1]
highh = high > upper or high[1] > upper[1]
var float [] stdC = array.new_float(44)

setX(x, y) =>
    if barstate.isfirst
        array.set(stdC, x, 0)
    else
        array.set(stdC, x, loww and y and volume >= (volMA * volinput) ? array.get(stdC, x) + 1 : array.get(stdC, x))
    
setXB(x, y) => 
    if barstate.isfirst
        array.set(stdC, x, 0)
    else
        array.set(stdC, x, highh and y and volume >= (volMA * volinput) ? array.get(stdC, x) + 1 : array.get(stdC, x))
            
        
        
