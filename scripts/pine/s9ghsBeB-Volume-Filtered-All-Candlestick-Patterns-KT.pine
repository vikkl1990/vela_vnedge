str(x) =>
    str.tostring(array.get(cX, x))  + " (" + str.tostring(array.get(perc,  x), format.percent) + ")\n\n"
strX(x) =>
    str.tostring(array.get(count, x))
strY(x) =>
    x + ", Next Session Higher Closes: "

