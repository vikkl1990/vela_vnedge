// 
// 


new(x) =>
    str.tostring(array.get(stdC, x)) 

newY(x) =>  
    x + " Closed Near Lower Band, Avg. " + str.tostring(len, "#") + "-Session PnL: "
    
newYY(x) =>
    x + " Closed Near Upper Band, Avg. " + str.tostring(len, "#") + "-Session PnL: "
    
newX(x) =>
    str.tostring(x, format.percent) + "\n\n"



tab = array.new_table()

array.push(tab, table.new(position.bottom_right, 10, 10, bgcolor = na, frame_color = color.white, frame_width = 1, border_color = #000000, border_width = 2))

if barstate.islast
    if tabl == "On" 
        if dataType == "Frequency"
            table.cell(
            
                 array.get(tab, 0), 0, 0, text_color = color.white, bgcolor = color.new(color.black, 90), text = "Candlestick Patterns With at Least " + str.tostring(volinput * 100 - 100, format.percent) + " Greater Than Average Volume" )
