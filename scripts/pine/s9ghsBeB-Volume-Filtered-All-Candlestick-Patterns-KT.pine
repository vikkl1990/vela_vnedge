f(x) => 
    ta.barssince(ta.change(array.get(stdC, x))) == len

f1(x) =>
    ta.change(array.get(stdC, x))

bull = f1(0) or f1(2 ) or f1(4 ) or f1(6 ) or f1(8 ) or f1(9) or f1(10) or f1(11) or f1(12 ) or f1(13 )or f1(14 ) or f1(15 ) or f1(16 ) or f1(17 ) or f1(18 ) or f1(19 ) or f1(20 ) or f1(21 ) or f1(22 ) or f1(23 )
f2(y) =>
    array.push(xP, label.new(bar_index, bull ? low * .97 : high * 1.03, style = bull ? label.style_label_up : label.style_label_down, textcolor = color.white, color = bull ? color.new(color.blue, 75) : color.new(color.red, 75), text = y + "\n" + str.tostring(c, format.percent) + " Greater Than Average Volume"))

f3() => 
    array.push(xPl, line.new(bar_index, bull ? low * .97 : high * 1.03, bar_index, bull ? low : high, style = line.style_dashed, color = color.white))

if dataType == "Mean Reversions"

    if f1(0)
        f2("Bullish Engulfing")      
        f3()
    if f1(1 )
        f2("Bearish Engulfing")
        f3()
    if f1(2 )
        f2("Piercing Bullish")
