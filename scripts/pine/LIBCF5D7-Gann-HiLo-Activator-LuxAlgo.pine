//@version=6
indicator("Gann HiLo Activator", shorttitle = "Gann HiLo Activator", overlay = true)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
SMA_TYPE  = "SMA"
EMA_TYPE  = "EMA"
VWMA_TYPE = "VWMA"

TREND_UP   =  1
TREND_DOWN = -1
TREND_NONE =  0

BULL_COLOR = #089981
BEAR_COLOR = #f23645

FILL_PRICE_TRANSP = 50  // gradient transparency at the price end of the fill
FILL_STOP_TRANSP  = 100 // gradient transparency at the activator end of the fill

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(3, "Length", minval = 1, group = "Settings",
     tooltip = "Lookback of the moving averages taken separately over the highs and over the lows. 3 is the classic default from Krausz's construction — longer lookbacks flip less often and trail price more loosely, shorter ones hug price and whipsaw in ranges.")

maTypeInput = input.string(SMA_TYPE, "Average Type", options = [SMA_TYPE, EMA_TYPE, VWMA_TYPE], group = "Settings",
     tooltip = "Moving average applied to the highs and to the lows. The classic construction uses simple moving averages; EMA and VWMA are common substitutions in later variants.")

showMarkersInput = input.bool(true, "Flip Markers", group = "Style",
     tooltip = "Marks each state flip with a small dot on the new side of price — the bar whose close crossed the line in force, swapping the activator to the opposite average.")

showFillInput = input.bool(true, "Gradient Trail Fill", group = "Style",
     tooltip = "Fills the span between price and the activator with a vertical gradient in the state color — fully transparent at the line, strongest near price — visualizing the room a close has left before it would flip the state.")

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style",
     tooltip = "Color of the line, fill and markers while the state is up (activator riding the smoothed lows beneath price as trailing support).")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style",
     tooltip = "Color of the line, fill and markers while the state is down (activator riding the smoothed highs above price as trailing resistance).")

lineWidthInput = input.int(1, "Line Width", minval = 1, maxval = 5, group = "Style",
     tooltip = "Width of the stepped activator line.")

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// Every average variant is computed on every bar so the selected series stays consistent across history
smaHigh  = ta.sma(high, lengthInput)
emaHigh  = ta.ema(high, lengthInput)
vwmaHigh = ta.vwma(high, lengthInput)
smaLow   = ta.sma(low, lengthInput)
emaLow   = ta.ema(low, lengthInput)
vwmaLow  = ta.vwma(low, lengthInput)

float highAverage = switch maTypeInput
    SMA_TYPE => smaHigh
    EMA_TYPE => emaHigh
    => vwmaHigh

float lowAverage = switch maTypeInput
    SMA_TYPE => smaLow
    EMA_TYPE => emaLow
    => vwmaLow

// Compact two-sided state machine: only a close through the line in force flips the state, so intrabar
// pokes leave it unchanged. Closes are compared with the previous bar's averages — the line the trader
// was watching while the bar formed (Krausz's published construction)
var int trendState = TREND_NONE
trendState := close > highAverage[1] ? TREND_UP : close < lowAverage[1] ? TREND_DOWN : trendState

// One candidate value per side, with the state deciding which one is active and visible:
// the smoothed lows beneath price in an up state, the smoothed highs above price in a down state
float activator = trendState == TREND_UP ? lowAverage : trendState == TREND_DOWN ? highAverage : na

bool flipBullish = trendState == TREND_UP   and trendState[1] == TREND_DOWN
bool flipBearish = trendState == TREND_DOWN and trendState[1] == TREND_UP
bool flipped     = flipBullish or flipBearish

// Pullback tests that held: an intrabar poke through the active line that closes back on the trend side
bool supportHeld    = trendState == TREND_UP   and trendState[1] == TREND_UP   and low  <= activator and close > activator
bool resistanceHeld = trendState == TREND_DOWN and trendState[1] == TREND_DOWN and high >= activator and close < activator

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color stateColor = trendState == TREND_UP ? bullColorInput : bearColorInput

// Vertical gradient between the activator and price — fully transparent at the line, strongest near price
color fillTopColor    = showFillInput ? (trendState == TREND_UP ? color.new(bullColorInput, FILL_PRICE_TRANSP) : color.new(bearColorInput, FILL_STOP_TRANSP)) : na
color fillBottomColor = showFillInput ? (trendState == TREND_UP ? color.new(bullColorInput, FILL_STOP_TRANSP) : color.new(bearColorInput, FILL_PRICE_TRANSP)) : na

// The line breaks on flip bars (na color) so each state reads as its own stepped segment on one side of price
activatorPlotId = plot(activator, "Gann HiLo Activator", color = flipped ? na : stateColor, linewidth = lineWidthInput, style = plot.style_linebr)
pricePlotId     = plot(close, "Price Anchor", color = na, editable = false, display = display.none)

fill(activatorPlotId, pricePlotId, top_value = math.max(activator, close), bottom_value = math.min(activator, close), top_color = fillTopColor, bottom_color = fillBottomColor, title = "Trail Gradient Fill")

plotshape(showMarkersInput and flipBullish ? activator : na, "Bullish Flip", shape.circle, location.absolute, color = bullColorInput, size = size.tiny)
plotshape(showMarkersInput and flipBearish ? activator : na, "Bearish Flip", shape.circle, location.absolute, color = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(flipBullish, "Bullish Flip", "Gann HiLo Activator flipped bullish on {{ticker}} ({{interval}}) — price closed above the high-side average and the line now trails the smoothed lows beneath price")
alertcondition(flipBearish, "Bearish Flip", "Gann HiLo Activator flipped bearish on {{ticker}} ({{interval}}) — price closed below the low-side average and the line now trails the smoothed highs above price")
alertcondition(flipped, "Any Flip", "Gann HiLo Activator flipped on {{ticker}} ({{interval}}) — the stepped line swapped to the opposite side of price")
alertcondition(supportHeld, "Trailing Support Test Held", "Gann HiLo Activator support test held on {{ticker}} ({{interval}}) — price poked below the up-state line intrabar and closed back above it")
alertcondition(resistanceHeld, "Trailing Resistance Test Held", "Gann HiLo Activator resistance test held on {{ticker}} ({{interval}}) — price poked above the down-state line intrabar and closed back below it")

//---------------------------------------------------------------------------------------------------------------------}
