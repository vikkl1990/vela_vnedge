//@version=6
indicator("On Balance Volume", "OBV", overlay = false, format = format.volume)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
smoothingInput = input.bool(false, "Smoothing MA", group = "Settings", tooltip = "Display a moving average of OBV to act as a smoothing/signal line.")
maTypeInput    = input.string("SMA", "MA Type", options = ["SMA", "EMA", "WMA", "RMA (SMMA)"], group = "Settings", tooltip = "Moving average type used for the smoothing MA.")
maLengthInput  = input.int(20, "MA Length", minval = 1, group = "Settings", tooltip = "Number of bars used for the smoothing MA.")

obvColorInput = input.color(#5b9cf6, "OBV", group = "Style", tooltip = "Color of the OBV line.")
maColorInput  = input.color(#ff9800, "Smoothing MA", group = "Style", tooltip = "Color of the smoothing MA line.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
obv = ta.obv

obvSma = ta.sma(obv, maLengthInput)
obvEma = ta.ema(obv, maLengthInput)
obvWma = ta.wma(obv, maLengthInput)
obvRma = ta.rma(obv, maLengthInput)

obvMa = switch maTypeInput
    "SMA"        => obvSma
    "EMA"        => obvEma
    "WMA"        => obvWma
    "RMA (SMMA)" => obvRma

maCrossUp   = ta.crossover(obv, obvMa)
maCrossDown = ta.crossunder(obv, obvMa)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(obv, "OBV", obvColorInput)
plot(smoothingInput ? obvMa : na, "Smoothing MA", maColorInput)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(maCrossUp, "Bullish MA Cross", "OBV crossed above its smoothing MA")
alertcondition(maCrossDown, "Bearish MA Cross", "OBV crossed below its smoothing MA")
//----------------------------------------------------------------------------------------------------------------------}
