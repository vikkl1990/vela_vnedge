//@version=6
indicator('Up/down Volume', 'Up/down Volume', overlay = false, format = format.volume)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
PAIR_MODE = 'Up/down Volume'
NET_MODE  = 'Net Volume'
CVI_MODE  = 'Cumulative Volume Index'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
displayInput = input.string(PAIR_MODE, 'Display', options = [PAIR_MODE, NET_MODE, CVI_MODE], group = 'Settings'
  , tooltip = 'Up/down Volume shows the two directional streams as mirrored columns. Net Volume shows the difference between the up and down streams as a centered oscillator. Cumulative Volume Index shows the running total of the net figure, where slope and divergences matter rather than the absolute level. A bar counts as up volume when it closes above the prior close, as down volume when it closes below it, unchanged bars feed neither stream.')

smoothInput    = input.bool(true, 'Smoothed Averages', inline = 'avg', group = 'Settings')
smoothLenInput = input.int(20, '', minval = 1, inline = 'avg', group = 'Settings'
  , tooltip = 'Show smoothed averages of the displayed series and set their length. The averages of the up and down streams overlay the columns, the Net Volume line uses the smoothed net difference, and the Cumulative Volume Index is paired with its own average. Alerts use the smoothed values whether or not the averages are displayed.')

smoothTypeInput = input.string('SMA', 'Average Type', options = ['SMA', 'EMA', 'WMA', 'RMA'], group = 'Settings'
  , tooltip = 'Moving average type used for all smoothed averages.')

//Style
bullColorInput = input.color(#089981, 'Up Volume', inline = 'dir', group = 'Style')
bearColorInput = input.color(#f23645, 'Down Volume', inline = 'dir', group = 'Style'
  , tooltip = 'Colors of the up volume and down volume sides of the indicator.')

neutralColorInput = input.color(#787b86, 'Neutral', group = 'Style'
  , tooltip = 'Color of the Cumulative Volume Index average, also used for the CVI line when smoothed averages are disabled.')

gradientInput = input.bool(true, 'Gradient Columns', group = 'Style'
  , tooltip = 'Scale column intensity with volume relative to twice its recent average, making unusually heavy bars stand out.')

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Volume guard, the concept requires reported volume
float cumVolume = ta.cum(nz(volume))

if barstate.islast and cumVolume == 0
    runtime.error('No volume data is provided by the data vendor for this symbol.')

//Directional classification, advancing bars feed the up stream, declining bars the down stream, unchanged bars neither
float priceChange = close - nz(close[1], open)

float upVolume   = priceChange > 0 ? nz(volume) : 0
float downVolume = priceChange < 0 ? nz(volume) : 0

//Net difference between the two streams and its running total (Cumulative Volume Index)
float netVolume = upVolume - downVolume
float cvi       = ta.cum(netVolume)

//Smoothed averages, every average type is computed on each bar so ta.* calls stay unconditional
float upSma = ta.sma(upVolume, smoothLenInput)
float upEma = ta.ema(upVolume, smoothLenInput)
float upWma = ta.wma(upVolume, smoothLenInput)
float upRma = ta.rma(upVolume, smoothLenInput)

float dnSma = ta.sma(downVolume, smoothLenInput)
float dnEma = ta.ema(downVolume, smoothLenInput)
float dnWma = ta.wma(downVolume, smoothLenInput)
float dnRma = ta.rma(downVolume, smoothLenInput)

float cviSma = ta.sma(cvi, smoothLenInput)
float cviEma = ta.ema(cvi, smoothLenInput)
float cviWma = ta.wma(cvi, smoothLenInput)
float cviRma = ta.rma(cvi, smoothLenInput)

float avgUpVolume = switch smoothTypeInput
    'EMA' => upEma
    'WMA' => upWma
    'RMA' => upRma
    => upSma

float avgDownVolume = switch smoothTypeInput
    'EMA' => dnEma
    'WMA' => dnWma
    'RMA' => dnRma
    => dnSma

float avgCvi = switch smoothTypeInput
    'EMA' => cviEma
    'WMA' => cviWma
    'RMA' => cviRma
    => cviSma

//Smoothed net volume, positive when the up stream dominates
float avgNetVolume = avgUpVolume - avgDownVolume

//Average total volume, scales the column gradient
float avgVolume   = ta.sma(nz(volume), smoothLenInput)
float gradientTop = 2 * nz(avgVolume, nz(volume))

//Events, net flips double as dominance shifts between the two streams
netFlipBull  = ta.crossover(avgNetVolume, 0)
netFlipBear  = ta.crossunder(avgNetVolume, 0)
cviCrossBull = ta.crossover(cvi, avgCvi)
cviCrossBear = ta.crossunder(cvi, avgCvi)

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
bool pairMode = displayInput == PAIR_MODE
bool netMode  = displayInput == NET_MODE
bool cviMode  = displayInput == CVI_MODE

//Column colors, intensity scales with volume against twice its recent average
color upColumnColor = gradientInput ? color.from_gradient(upVolume, 0, gradientTop, color.new(bullColorInput, 75), bullColorInput) : color.new(bullColorInput, 25)
color dnColumnColor = gradientInput ? color.from_gradient(downVolume, 0, gradientTop, color.new(bearColorInput, 75), bearColorInput) : color.new(bearColorInput, 25)

//Net oscillator, smoothed net difference when averages are enabled, raw net otherwise
float netOsc = netMode ? (smoothInput ? avgNetVolume : netVolume) : na

//Cumulative Volume Index color, directional against its average
color cviColor = smoothInput and not na(avgCvi) ? (cvi > avgCvi ? bullColorInput : bearColorInput) : neutralColorInput

//Zero line level, hidden in cumulative mode to avoid distorting the scale
float zeroLevel = cviMode ? na : 0.

//Up/down streams as mirrored columns with their smoothed averages
plot(pairMode ? upVolume : na, 'Up Volume', upColumnColor, 1, plot.style_columns)
plot(pairMode ? -downVolume : na, 'Down Volume', dnColumnColor, 1, plot.style_columns)
plot(pairMode and smoothInput ? avgUpVolume : na, 'Up Volume Average', bullColorInput)
plot(pairMode and smoothInput ? -avgDownVolume : na, 'Down Volume Average', bearColorInput)

//Net volume as a centered oscillator
netPlotId  = plot(netOsc, 'Net Volume', netOsc > 0 ? bullColorInput : bearColorInput)
zeroPlotId = plot(zeroLevel, 'Zero Line', #787b86)

fill(netPlotId, zeroPlotId
  , top_value    = math.max(netOsc, 0)
  , bottom_value = math.min(netOsc, 0)
  , top_color    = netOsc > 0 ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)
  , bottom_color = netOsc > 0 ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)
  , title        = 'Net Volume Gradient')

//Cumulative Volume Index with its average
cviPlotId   = plot(cviMode ? cvi : na, 'Cumulative Volume Index', cviColor)
cviMaPlotId = plot(cviMode and smoothInput ? avgCvi : na, 'CVI Average', neutralColorInput)

fill(cviPlotId, cviMaPlotId, color = cvi > avgCvi ? color.new(bullColorInput, 85) : color.new(bearColorInput, 85), title = 'CVI Fill')

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(netFlipBull, 'Bullish Net Volume Flip', 'Up/down Volume: smoothed net volume crossed above zero, up volume is now dominant')
alertcondition(netFlipBear, 'Bearish Net Volume Flip', 'Up/down Volume: smoothed net volume crossed below zero, down volume is now dominant')
alertcondition(cviCrossBull, 'CVI Crossed Above Average', 'Up/down Volume: the Cumulative Volume Index crossed above its smoothed average')
alertcondition(cviCrossBear, 'CVI Crossed Below Average', 'Up/down Volume: the Cumulative Volume Index crossed below its smoothed average')

//---------------------------------------------------------------------------------------------------------------------}
