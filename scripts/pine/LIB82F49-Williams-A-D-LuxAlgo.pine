//@version=6
indicator("Williams A/D"
  , shorttitle       = "Williams A/D"
  , overlay          = false
  , format           = format.volume
  , max_lines_count  = 500
  , max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
const string CALC_GROUP   = "Calculation"
const string SMOOTH_GROUP = "Smoothing"
const string DIV_GROUP    = "Divergences"
const string STYLE_GROUP  = "Style"

const color LABEL_BG = #00000000

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
volumeWeightedInput = input.bool(false, "Volume-Weighted Variant", group = CALC_GROUP
  , tooltip = "The original Larry Williams construction is price-only: each bar adds the close's progress from the true low on up-closes and subtracts its distance from the true high on down-closes. Enable to multiply each bar's contribution by volume, matching platform variants of the line.")

smoothTypeInput = input.string("EMA", "Smoothing Method", options = ["None", "SMA", "EMA", "RMA", "WMA"], group = SMOOTH_GROUP
  , tooltip = "Optional moving average of the Williams A/D line, useful for reading slope changes and regime turns after long drifts. Select 'None' to disable.")

smoothLengthInput = input.int(20, "Smoothing Length", minval = 1, maxval = 500, group = SMOOTH_GROUP
  , tooltip = "Length of the smoothing moving average applied to the Williams A/D line.")

showDivergencesInput = input.bool(true, "Show Divergences", group = DIV_GROUP
  , tooltip = "Highlights regular divergences, the primary application of Williams A/D: price making a new high (low) that the line fails to confirm. Dashed lines connect the diverging pivots, with a label at the confirming pivot.")

divLookbackInput = input.int(5, "Pivot Lookback", minval = 1, maxval = 50, group = DIV_GROUP
  , tooltip = "Number of bars to the left and right required to confirm a pivot on the Williams A/D line. Higher values return more significant pivots, detected later.")

divMaxDistanceInput = input.int(60, "Maximum Pivot Distance", minval = 5, maxval = 500, group = DIV_GROUP
  , tooltip = "Maximum number of bars allowed between two compared pivots. Pivots further apart are not evaluated for divergence.")

directionalInput = input.bool(true, "Directional Coloring", group = STYLE_GROUP
  , tooltip = "Colors the Williams A/D line by its direction: bullish when the line rises, bearish when it falls. Disable to use the single color below.")

bullColorInput = input.color(#089981, "Bullish", inline = "direction", group = STYLE_GROUP)

bearColorInput = input.color(#f23645, "Bearish", inline = "direction", group = STYLE_GROUP)

neutralColorInput = input.color(#787b86, "Single Color", group = STYLE_GROUP)

smoothColorInput = input.color(#ff9800, "Smoothing", group = STYLE_GROUP)

gradientFillInput = input.bool(true, "Gradient Fill", group = STYLE_GROUP
  , tooltip = "Fills the area between the Williams A/D line and its smoothing with a directional gradient.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculation
//---------------------------------------------------------------------------------------------------------------------{
float prevClose = close[1]

//True range extremes, extended by the prior close when it gaps outside the bar
float trueHigh = math.max(high, nz(prevClose, high))
float trueLow  = math.min(low,  nz(prevClose, low))

//Per-bar term: close progress from the true low on up-closes, distance from the true high on down-closes
float wadChange = close > prevClose ? close - trueLow : close < prevClose ? close - trueHigh : 0.0

//Price-only in the original form, optionally multiplied by volume for the platform variant
float wadWeight = volumeWeightedInput ? nz(volume) : 1.0

//Cumulative line, seeded at 0
var float wad = 0.0
wad += wadChange * wadWeight

//Optional smoothing
float smaValue = ta.sma(wad, smoothLengthInput)
float emaValue = ta.ema(wad, smoothLengthInput)
float rmaValue = ta.rma(wad, smoothLengthInput)
float wmaValue = ta.wma(wad, smoothLengthInput)

float smoothWad = smoothTypeInput == "None" ? na
  : smoothTypeInput == "SMA" ? smaValue
  : smoothTypeInput == "EMA" ? emaValue
  : smoothTypeInput == "RMA" ? rmaValue
  : wmaValue

//---------------------------------------------------------------------------------------------------------------------}
// Divergences
//---------------------------------------------------------------------------------------------------------------------{
float pivotHighWad = ta.pivothigh(wad, divLookbackInput, divLookbackInput)
float pivotLowWad  = ta.pivotlow(wad, divLookbackInput, divLookbackInput)

var float prevPhWad   = na
var float prevPhPrice = na
var int   prevPhBar   = na

var float prevPlWad   = na
var float prevPlPrice = na
var int   prevPlBar   = na

bool bearishDivergence = false
bool bullishDivergence = false

//Bearish divergence: price makes a higher high while the Williams A/D line makes a lower high
if not na(pivotHighWad)
    float phPrice = high[divLookbackInput]
    int   phBar   = bar_index - divLookbackInput

    if not na(prevPhWad) and phBar - prevPhBar <= divMaxDistanceInput and phPrice > prevPhPrice and pivotHighWad < prevPhWad
        bearishDivergence := true

        if showDivergencesInput
            line.new(prevPhBar, prevPhWad, phBar, pivotHighWad, color = bearColorInput, style = line.style_dashed)
            label.new(phBar, pivotHighWad, "Bearish", style = label.style_label_down, color = LABEL_BG, textcolor = bearColorInput, size = size.small)

    prevPhWad   := pivotHighWad
    prevPhPrice := phPrice
    prevPhBar   := phBar

//Bullish divergence: price makes a lower low while the Williams A/D line makes a higher low
if not na(pivotLowWad)
    float plPrice = low[divLookbackInput]
    int   plBar   = bar_index - divLookbackInput

    if not na(prevPlWad) and plBar - prevPlBar <= divMaxDistanceInput and plPrice < prevPlPrice and pivotLowWad > prevPlWad
        bullishDivergence := true

        if showDivergencesInput
            line.new(prevPlBar, prevPlWad, plBar, pivotLowWad, color = bullColorInput, style = line.style_dashed)
            label.new(plBar, pivotLowWad, "Bullish", style = label.style_label_up, color = LABEL_BG, textcolor = bullColorInput, size = size.small)

    prevPlWad   := pivotLowWad
    prevPlPrice := plPrice
    prevPlBar   := plBar

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
//Only direction and slope carry information: color the line by its bar-to-bar direction
var color slopeColor = na
slopeColor := wad > wad[1] ? bullColorInput : wad < wad[1] ? bearColorInput : slopeColor

color wadColor = directionalInput ? slopeColor : neutralColorInput

wadPlot    = plot(wad, "Williams A/D", wadColor)
smoothPlot = plot(smoothWad, "Smoothing", smoothColorInput)

//Directional gradient fill between the line and its smoothing
bool aboveSmoothing = wad >= smoothWad

color fillTopColor    = gradientFillInput ? (aboveSmoothing ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)) : na
color fillBottomColor = gradientFillInput ? (aboveSmoothing ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)) : na

fill(wadPlot, smoothPlot
  , top_value    = math.max(wad, smoothWad)
  , bottom_value = math.min(wad, smoothWad)
  , top_color    = fillTopColor
  , bottom_color = fillBottomColor)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullishDivergence, "Bullish Divergence", "Bullish divergence on Williams A/D: price made a lower low while the Williams A/D line made a higher low ({{ticker}}, {{interval}})")

alertcondition(bearishDivergence, "Bearish Divergence", "Bearish divergence on Williams A/D: price made a higher high while the Williams A/D line made a lower high ({{ticker}}, {{interval}})")

alertcondition(ta.crossover(wad, smoothWad), "Smoothing Crossover", "Williams A/D crossed above its smoothing ({{ticker}}, {{interval}})")

alertcondition(ta.crossunder(wad, smoothWad), "Smoothing Crossunder", "Williams A/D crossed below its smoothing ({{ticker}}, {{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
