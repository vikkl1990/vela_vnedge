//@version=6
indicator("Average Directional Index", "ADX", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // +DI, and the ADX while trending with +DI in charge
BEAR_COLOR    = #f23645 // -DI, and the ADX while trending with -DI in charge
NEUTRAL_COLOR = #787b86 // key level, and the ADX below it - no trend to trade
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
diLengthInput  = input.int(14, "DI Length", minval = 1, group = "Settings", tooltip = "Wilder RMA smoothing length applied to directional movement and true range when computing +DI and -DI")
adxLengthInput = input.int(14, "ADX Smoothing", minval = 1, group = "Settings", tooltip = "Wilder RMA smoothing length applied to DX to obtain the ADX line")
keyLevelInput  = input.float(25, "Key Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Trend strength reference level, ADX above this level is commonly read as a trending market")

plusDiColorInput  = input.color(BULL_COLOR, "+DI Color", group = "Style", tooltip = "Color of the plus directional indicator line, and of the ADX line while it sits above the key level with +DI above -DI")
minusDiColorInput = input.color(BEAR_COLOR, "-DI Color", group = "Style", tooltip = "Color of the minus directional indicator line, and of the ADX line while it sits above the key level with -DI above +DI")
adxColorInput     = input.color(NEUTRAL_COLOR, "ADX Color", group = "Style", tooltip = "Color of the average directional index line while it sits below the key level - no trend strong enough to trade")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
[plusDi, minusDi, adx] = ta.dmi(diLengthInput, adxLengthInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - the ADX takes the dominant DI's color once it clears the key level, neutral below it
adxColor = adx > keyLevelInput ? (plusDi > minusDi ? plusDiColorInput : minusDiColorInput) : adxColorInput

plot(plusDi, "+DI", color.new(plusDiColorInput, 30))
plot(minusDi, "-DI", color.new(minusDiColorInput, 30))
plot(adx, "ADX", adxColor, 2)

hline(keyLevelInput, "Key Level", NEUTRAL_COLOR, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
diCrossUp   = ta.crossover(plusDi, minusDi)
diCrossDown = ta.crossunder(plusDi, minusDi)
adxKeyCross = ta.crossover(adx, keyLevelInput)

alertcondition(diCrossUp, "Bullish DI Cross", "+DI crossed above -DI")
alertcondition(diCrossDown, "Bearish DI Cross", "+DI crossed below -DI")
alertcondition(adxKeyCross, "ADX Above Key Level", "ADX crossed above the key level")
//----------------------------------------------------------------------------------------------------------------------}
