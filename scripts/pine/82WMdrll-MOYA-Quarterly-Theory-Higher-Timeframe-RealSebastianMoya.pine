// ============================================================
// MODULE 3: MACRO CYCLES (Monthly / Weekly Quarters)
// ============================================================
if enable_macro
    tf = timeframe.period
    var tz = use_exchange ? syminfo.timezone : str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

    // ------------------- Monthly Quarters (Q1-Q4) -------------------
    if show_macro_monthly
        dayOfMonth = dayofmonth(time, tz)
        is_mw1 = dayOfMonth >= 1  and dayOfMonth <= 7
        is_mw2 = dayOfMonth >= 8  and dayOfMonth <= 14
        is_mw3 = dayOfMonth >= 15 and dayOfMonth <= 21
        is_mw4 = dayOfMonth >= 22
        if show_mw1
            get_range_macro(is_mw1, mw1_txt, mw1_css, bg_transp_mw, show_outline_mw, show_txt_mw, line_width_mw)
        if show_mw2
            get_range_macro(is_mw2, mw2_txt, mw2_css, bg_transp_mw, show_outline_mw, show_txt_mw, line_width_mw)
        if show_mw3
            get_range_macro(is_mw3, mw3_txt, mw3_css, bg_transp_mw, show_outline_mw, show_txt_mw, line_width_mw)
        if show_mw4
            get_range_macro(is_mw4, mw4_txt, mw4_css, bg_transp_mw, show_outline_mw, show_txt_mw, line_width_mw)

    // ------------------- Weekly Quarters (Q1-Q5) -------------------
    if show_macro_weekly
        dow = dayofweek(time, tz)
        is_wd1 = dow == dayofweek.monday
        is_wd2 = dow == dayofweek.tuesday
        is_wd3 = dow == dayofweek.wednesday
        is_wd4 = dow == dayofweek.thursday
        is_wd5 = dow == dayofweek.friday
        if show_wd1
            get_range_macro(is_wd1, wd1_txt, wd1_css, bg_transp_wd, show_outline_wd, show_txt_wd, line_width_wd)
        if show_wd2
            get_range_macro(is_wd2, wd2_txt, wd2_css, bg_transp_wd, show_outline_wd, show_txt_wd, line_width_wd)
        if show_wd3
            get_range_macro(is_wd3, wd3_txt, wd3_css, bg_transp_wd, show_outline_wd, show_txt_wd, line_width_wd)
        if show_wd4
            get_range_macro(is_wd4, wd4_txt, wd4_css, bg_transp_wd, show_outline_wd, show_txt_wd, line_width_wd)
        if show_wd5
            get_range_macro(is_wd5, wd5_txt, wd5_css, bg_transp_wd, show_outline_wd, show_txt_wd, line_width_wd)

// ============================================================
// MODULE 4: TRUE OPENS
// ============================================================
if enable_true_opens and timeframe.isintraday
    if show_true_day_open
        isNewDay = timeframe.change("D")
        if isNewDay
            line.new(bar_index, open, bar_index, open, color=true_day_open_color, width=true_open_width, style=lineStyle())
            if true_open_show_label
                label.new(bar_index, open, "True Day Open", color=color.new(color.black, 100), textcolor=true_day_open_color, style=label.style_label_left, size=getLabelSizeMacro(true_open_label_size))

    if show_true_week_open
        isNewWeek = timeframe.change("W")
        if isNewWeek
            line.new(bar_index, open, bar_index, open, color=true_week_open_color, width=true_open_width, style=lineStyle())
            if true_open_show_label
                label.new(bar_index, open, "True Week Open", color=color.new(color.black, 100), textcolor=true_week_open_color, style=label.style_label_left, size=getLabelSizeMacro(true_open_label_size))

    if show_true_month_open
        isNewMonth = timeframe.change("M")
        if isNewMonth
            line.new(bar_index, open, bar_index, open, color=true_month_open_color, width=true_open_width, style=lineStyle())
            if true_open_show_label
                label.new(bar_index, open, "True Month Open", color=color.new(color.black, 100), textcolor=true_month_open_color, style=label.style_label_left, size=getLabelSizeMacro(true_open_label_size))

    if show_true_quarter_open
        isNewQuarter = timeframe.change("3M")
        if isNewQuarter
            line.new(bar_index, open, bar_index, open, color=true_quarter_open_color, width=true_open_width, style=lineStyle())
            if true_open_show_label
                label.new(bar_index, open, "True Quarter Open", color=color.new(color.black, 100), textcolor=true_quarter_open_color, style=label.style_label_left, size=getLabelSizeMacro(true_open_label_size))