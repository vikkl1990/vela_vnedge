indicator(" MOYA Quarterly Theory & Higher Timeframe Suite [RealSebastianMoya]", shorttitle="MOYA Quarterly Theory & Higher Timeframe Suite [RealSebastianMoya]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)
// ----------------------------------------------------------------------------
// Higher Timeframe (HTF) Overlay:
//   Projects the open, high, low, and close of a larger timeframe directly
//   onto the current chart, so the higher timeframe structure, bias, and key
//   levels stay visible without switching charts
//
// Quarterly Theory (Q23 / Q90 / Q360):
//   A time-based framework that divides a trading cycle into four equal
//   quarters, commonly associated with the Accumulation, Manipulation,
//   Distribution, and Reversal/Continuation (AMDX) phases, applied across
//   multiple fractal cycles: 23-minute, 90-minute, and 6-hour sessions.
//
// Macro Cycles (Monthly / Weekly Quarters + True Opens):
//   Extends the same fractal logic to the macro scale:
//     - Monthly cycle split into 4 quarters (Q1, Q2, Q3, Q4)
//     - Weekly cycle split into 5 quarters (Q1 Mon, Q2 Tue, Q3 Wed, Q4 Thu, Q5 Fri)
//   Also plots True Opens (True Day / Week / Month / Quarter) as reference lines.
// =============================================================================
// ============================================================
// MAIN TOGGLES
// ============================================================

enable_htf_candles = input(true, "Enable Higher Timeframe Candle Overlay", group="MAIN TOGGLES")
enable_sessions    = input(true, "Enable Quarterly Theory Sessions", group="MAIN TOGGLES")
enable_macro       = input(true, "Enable Macro Cycles", group="MAIN TOGGLES")
enable_true_opens  = input(true, "Enable True Opens", group="MAIN TOGGLES")

// ============================================================
// HIGHER TIMEFRAME CANDLE OVERLAY
// ============================================================

htf_period_selection = input.string("1 Day", "candlestick overlay", options=["1 Minute", "3 Minutes", "5 Minutes", "10 Minutes", "15 Minutes", "30 Minutes", "45 Minutes", "1 Hour", "2 Hours", "3 Hours", "4 Hours", "5 Hours", "6 Hours", "8 Hours", "10 Hours", "12 Hours", "1 Day", "2 Days", "3 Days", "4 Days", "5 Days", "6 Days", "7 Days", "1 Week", "2 Weeks", "3 Weeks", "4 Weeks", "5 Weeks", "1 Month", "2 Months", "3 Months", "4 Months", "5 Months", "6 Months", "7 Months"], group="HIGHER TIMEFRAME CANDLE OVERLAY")

higher_timeframe = switch htf_period_selection
    "1 Minute"    => "1"
    "3 Minutes"   => "3"
    "5 Minutes"   => "5"
    "10 Minutes"  => "10"
    "15 Minutes"  => "15"
    "30 Minutes"  => "30"
    "45 Minutes"  => "45"
    "1 Hour"      => "60"
    "2 Hours"     => "120"
    "3 Hours"     => "180"
    "4 Hours"     => "240"
    "5 Hours"     => "300"
    "6 Hours"     => "360"
    "8 Hours"     => "480"
    "10 Hours"    => "600"
    "12 Hours"    => "720"
    "1 Day"       => "1D"
    "2 Days"      => "2D"
    "3 Days"      => "3D"
    "4 Days"      => "4D"
    "5 Days"      => "5D"
    "6 Days"      => "6D"
    "7 Days"      => "7D"
    "1 Week"      => "1W"
    "2 Weeks"     => "2W"
    "3 Weeks"     => "3W"
    "4 Weeks"     => "4W"
    "5 Weeks"     => "5W"
    "1 Month"     => "1M"
    "2 Months"    => "2M"
    "3 Months"    => "3M"
    "4 Months"    => "4M"
    "5 Months"    => "5M"
    "6 Months"    => "6M"
    "7 Months"    => "7M"
    => "1D"

show_timeframe_label = input(true, "Show Timeframe Label on Candle", group="HIGHER TIMEFRAME CANDLE OVERLAY")
label_text_size = input.string("Small", "Label Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="HIGHER TIMEFRAME CANDLE OVERLAY")

bullish_fill_color       = input.color(color.new(color.lime, 20), title="Bullish Fill Color", group="HIGHER TIMEFRAME CANDLE OVERLAY")
bullish_line_color       = input.color(color.lime, title="Bullish Line Color", group="HIGHER TIMEFRAME CANDLE OVERLAY")
bearish_fill_color       = input.color(color.new(color.red, 20), title="Bearish Fill Color", group="HIGHER TIMEFRAME CANDLE OVERLAY")
bearish_line_color       = input.color(color.rgb(255, 120, 120), title="Bearish Line Color", group="HIGHER TIMEFRAME CANDLE OVERLAY")
candle_body_transparency = input.int(95, title="Candle Body Transparency", minval=0, maxval=100, group="HIGHER TIMEFRAME CANDLE OVERLAY")
line_thickness           = input.int(2, title="Line Thickness", minval=1, maxval=10, group="HIGHER TIMEFRAME CANDLE OVERLAY")


// ============================================================
// QUARTERLY THEORY - GENERAL SETTINGS
// ============================================================
tz_incr      = input.int(-5, 'UTC Offset (+/-)', group='QUARTERLY THEORY - GENERAL SETTINGS')
use_exchange = input(false, 'Use Exchange Timezone', group='QUARTERLY THEORY - GENERAL SETTINGS')

show_indicator23  = input(true, 'Show Q23 (23-Minute Quarters)',  group='QUARTERLY THEORY - GENERAL SETTINGS')
show_indicator90  = input(true, 'Show Q90 (90-Minute Quarters)',  group='QUARTERLY THEORY - GENERAL SETTINGS')
show_indicator360 = input(true, 'Show Q360 (6-Hour Quarters)', group='QUARTERLY THEORY - GENERAL SETTINGS')

