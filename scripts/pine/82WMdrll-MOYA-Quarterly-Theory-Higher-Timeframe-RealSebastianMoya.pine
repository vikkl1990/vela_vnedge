wd3_txt  = input('Q3', '',               inline='wd3', group='MACRO CYCLES - WEEKLY QUARTERS')
wd3_css  = input.color(color.new(color.blue, 0), '', inline='wd3', group='MACRO CYCLES - WEEKLY QUARTERS')

show_wd4 = input(true, 'Q4 (Thursday)',  inline='wd4', group='MACRO CYCLES - WEEKLY QUARTERS')
wd4_txt  = input('Q4', '',               inline='wd4', group='MACRO CYCLES - WEEKLY QUARTERS')
wd4_css  = input.color(color.new(color.green, 0), '', inline='wd4', group='MACRO CYCLES - WEEKLY QUARTERS')

show_wd5 = input(true, 'Q5 (Friday)',    inline='wd5', group='MACRO CYCLES - WEEKLY QUARTERS')
wd5_txt  = input('Q5', '',               inline='wd5', group='MACRO CYCLES - WEEKLY QUARTERS')
wd5_css  = input.color(color.new(color.orange, 0), '', inline='wd5', group='MACRO CYCLES - WEEKLY QUARTERS')

// ============================================================
// TRUE OPENS - SETTINGS
// ============================================================
true_open_style      = input.string('Dashed', 'True Opens Line Style', options=['Solid', 'Dotted', 'Dashed'], group='TRUE OPENS')
true_open_width      = input.int(1, 'True Opens Line Width', minval=1, maxval=5, group='TRUE OPENS')
true_open_show_label = input(true, 'Show True Opens Labels', group='TRUE OPENS')
true_open_label_size = input.string('Small', 'True Opens Label Size', options=['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group='TRUE OPENS')

show_true_day_open     = input(true, 'True Day Open (00:00)',     inline='tdo', group='TRUE OPENS')
true_day_open_color    = input.color(color.new(color.yellow, 0),   '', inline='tdo', group='TRUE OPENS')

show_true_week_open    = input(true, 'True Week Open (Mon 00:00)', inline='two', group='TRUE OPENS')
true_week_open_color   = input.color(color.new(color.aqua, 0),     '', inline='two', group='TRUE OPENS')

show_true_month_open   = input(true, 'True Month Open (1st 00:00)', inline='tmo', group='TRUE OPENS')
true_month_open_color  = input.color(color.new(color.orange, 0),   '', inline='tmo', group='TRUE OPENS')

show_true_quarter_open = input(true, 'True Quarter Open',          inline='tqo', group='TRUE OPENS')
true_quarter_open_color= input.color(color.new(color.fuchsia, 0),  '', inline='tqo', group='TRUE OPENS')

// ============================================================
// FUNCTIONS (top level, no conditional blocks)
// ============================================================

// --- Range builders for Quarterly Theory ---
get_range(session, session_name, session_css) =>
    var t = 0
    var max = high
    var min = low
    var box bx = na
    var label lbl = na
    if session > session[1]
        t := time
        max := high
        min := low
        bx := box.new(bar_index, max, bar_index, min, bgcolor=color.new(session_css, bg_transp), border_color=show_outline ? session_css : na, border_style=line.style_dotted, border_width=line_width)
        if show_txt
            lbl := label.new(t, max, session_name, xloc=xloc.bar_time, textcolor=color.new(color.blue, 0), style=label.style_label_down, color=color.new(color.white, 90), size=size.normal)
    if session != 0 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        box.set_top(bx, max)
        box.set_rightbottom(bx, bar_index, min)
        if show_txt
            label.set_xy(lbl, int(math.avg(t, time)), max)

get_range360(session, session_name, session_css) =>
    var t = 0
    var max = high
    var min = low
    var box bx = na
    var label lbl = na
    if session > session[1]
        t := time
        max := high
        min := low
        bx := box.new(bar_index, max, bar_index, min, bgcolor=color.new(session_css, bg_transp360), border_color=session_css, border_style=line.style_solid, border_width=line_width360)
        if show_txt360
            lbl := label.new(t, max, session_name, xloc=xloc.bar_time, textcolor=session_css, style=label.style_label_down, color=color.new(color.white, 100), size=size.normal)
    if session != 0 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        box.set_top(bx, max)
        box.set_rightbottom(bx, bar_index, min)
        if show_txt360
            label.set_xy(lbl, int(math.avg(t, time)), max)

get_range23(session, session_name, session_css) =>
