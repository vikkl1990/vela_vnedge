        if show_txt23
            lbl := label.new(t, max, session_name, xloc=xloc.bar_time, textcolor=color.new(color.black, 0), style=label.style_label_down, color=color.new(color.white, 100), size=size.normal)
    if session != 0 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        box.set_top(bx, max)
        box.set_rightbottom(bx, bar_index, min)
        if show_txt23
            label.set_xy(lbl, int(math.avg(t, time)), max)

// --- Generic Range builder for Macro Cycles ---
get_range_macro(trigger, session_name, session_css, box_transp, box_border_show, box_labels_show, box_line_width) =>
    var t = 0
    var max = high
    var min = low
    var box bx = na
    var label lbl = na
    int trig = trigger ? 1 : 0
    int trigPrev = trigger[1] ? 1 : 0
    if trig > trigPrev
        t := time
        max := high
        min := low
        bx := box.new(bar_index, max, bar_index, min, bgcolor=color.new(session_css, box_transp), border_color=box_border_show ? session_css : na, border_style=line.style_dotted, border_width=box_line_width)
        if box_labels_show
            lbl := label.new(t, max, session_name, xloc=xloc.bar_time, textcolor=color.new(color.white, 0), style=label.style_label_down, color=color.new(color.black, 30), size=size.normal)
    if trig == 1 and trigPrev == 1
        max := math.max(high, max)
        min := math.min(low, min)
        box.set_top(bx, max)
        box.set_rightbottom(bx, bar_index, min)
        if box_labels_show
            label.set_xy(lbl, int(math.avg(t, time)), max)

// --- Line style selector for True Opens ---
lineStyle() =>
    switch true_open_style
        'Solid'  => line.style_solid
        'Dotted' => line.style_dotted
        'Dashed' => line.style_dashed
        => line.style_dashed

// --- Label size selector for True Opens ---
getLabelSizeMacro(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.small

// ============================================================
// MODULE 1: HIGHER TIMEFRAME CANDLE OVERLAY
// ============================================================
if enable_htf_candles
    new_htf_candle_started = timeframe.change(higher_timeframe)

    var float current_htf_open_price = na
    var float current_htf_high_price = na
    var float current_htf_low_price = na
    var float current_htf_close_price = na
    var int htf_candle_start_bar = na

    var color current_fill_color = na
    var color current_line_color = na

    var box[] all_candle_bodies = array.new_box()
    var line[] all_upper_shadows = array.new_line()
    var line[] all_lower_shadows = array.new_line()
    var label[] all_timeframe_labels = array.new_label()

    if new_htf_candle_started
        if not na(current_htf_open_price)
            int middle_bar = htf_candle_start_bar + int((bar_index - 1 - htf_candle_start_bar) / 2)

            body_top = math.max(current_htf_open_price, current_htf_close_price)
            body_bottom = math.min(current_htf_open_price, current_htf_close_price)
            body_mid = (body_top + body_bottom) / 2

            var box permanent_candle_body = na
            permanent_candle_body := box.new(
                 left=htf_candle_start_bar,
                 right=bar_index - 1,
                 top=body_top,
                 bottom=body_bottom,
                 bgcolor=color.new(current_fill_color, candle_body_transparency),
                 border_color=current_line_color,
                 border_width=line_thickness
             )
            array.push(all_candle_bodies, permanent_candle_body)

            if show_timeframe_label
                label_text = htf_period_selection
                size_const = switch label_text_size
                    "Tiny"  => size.tiny
                    "Small" => size.small
                    "Normal"=> size.normal
                    "Large" => size.large
                    "Huge"  => size.huge
                    =>       size.small
                var label timeframe_label = na
                timeframe_label := label.new(
                    x=htf_candle_start_bar + int((bar_index - 1 - htf_candle_start_bar) / 2),
                    y=body_mid,
                    text=label_text,
                    xloc=xloc.bar_index,
                    color=color.new(color.white, 100),
                    textcolor=current_line_color,
                    style=label.style_label_center,
                    size=size_const
                )
                array.push(all_timeframe_labels, timeframe_label)

            if current_htf_high_price > body_top
                var line permanent_upper_shadow = na
                permanent_upper_shadow := line.new(
                     x1=middle_bar,
                     y1=body_top,
                     x2=middle_bar,
                     y2=current_htf_high_price,
                     color=current_line_color,
                     width=line_thickness
                 )
                array.push(all_upper_shadows, permanent_upper_shadow)

            if current_htf_low_price < body_bottom
                var line permanent_lower_shadow = na
                permanent_lower_shadow := line.new(
                     x1=middle_bar,
                     y1=body_bottom,
                     x2=middle_bar,
                     y2=current_htf_low_price,
                     color=current_line_color,
                     width=line_thickness
                 )
                array.push(all_lower_shadows, permanent_lower_shadow)

        current_htf_open_price := open
        current_htf_high_price := high
        current_htf_low_price := low
        current_htf_close_price := close
        htf_candle_start_bar := bar_index

        is_bullish = current_htf_close_price >= current_htf_open_price
        current_fill_color := is_bullish ? bullish_fill_color : bearish_fill_color
        current_line_color := is_bullish ? bullish_line_color : bearish_line_color

    else
        current_htf_high_price := math.max(current_htf_high_price, high)
        current_htf_low_price := math.min(current_htf_low_price, low)
        current_htf_close_price := close

        is_bullish = current_htf_close_price >= current_htf_open_price
        current_fill_color := is_bullish ? bullish_fill_color : bearish_fill_color
        current_line_color := is_bullish ? bullish_line_color : bearish_line_color

    if not na(current_htf_open_price) and barstate.islast
        int middle_bar = htf_candle_start_bar + int((bar_index - htf_candle_start_bar) / 2)

        body_top = math.max(current_htf_open_price, current_htf_close_price)
        body_bottom = math.min(current_htf_open_price, current_htf_close_price)
        body_mid = (body_top + body_bottom) / 2

        current_candle_body = box.new(
             left=htf_candle_start_bar,
             right=bar_index,
             top=body_top,
             bottom=body_bottom,
             bgcolor=color.new(current_fill_color, candle_body_transparency),
             border_color=current_line_color,
             border_width=line_thickness
         )

        if show_timeframe_label
            label_text = htf_period_selection
            size_const = switch label_text_size
                "Tiny"  => size.tiny
                "Small" => size.small
                "Normal"=> size.normal
                "Large" => size.large
                "Huge"  => size.huge
                =>       size.small
            var label current_timeframe_label = na
            current_timeframe_label := label.new(
                x=htf_candle_start_bar + int((bar_index - htf_candle_start_bar) / 2),
                y=body_mid,
                text=label_text,
                xloc=xloc.bar_index,
                color=color.new(color.white, 100),
                textcolor=current_line_color,
                style=label.style_label_center,
                size=size_const
            )

        if current_htf_high_price > body_top
            current_upper_shadow = line.new(
                 x1=middle_bar,
                 y1=body_top,
                 x2=middle_bar,
                 y2=current_htf_high_price,
                 color=current_line_color,
                 width=line_thickness
             )

        if current_htf_low_price < body_bottom
            current_lower_shadow = line.new(
                 x1=middle_bar,
                 y1=body_bottom,
                 x2=middle_bar,
                 y2=current_htf_low_price,
                 color=current_line_color,
                 width=line_thickness
             )

// ============================================================
// MODULE 2: QUARTERLY THEORY SESSIONS
// ============================================================
if enable_sessions
    tf = timeframe.period
    var tz = use_exchange ? syminfo.timezone : str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

    is_ses90A1 = math.sign(nz(time(tf, ses90A1_ses, tz)))
    is_ses90A2 = math.sign(nz(time(tf, ses90A2_ses, tz)))
    is_ses90A3 = math.sign(nz(time(tf, ses90A3_ses, tz)))
    is_ses90A4 = math.sign(nz(time(tf, ses90A4_ses, tz)))
    is_ses90L1 = math.sign(nz(time(tf, ses90L1_ses, tz)))
    is_ses90L2 = math.sign(nz(time(tf, ses90L2_ses, tz)))
    is_ses90L3 = math.sign(nz(time(tf, ses90L3_ses, tz)))
    is_ses90L4 = math.sign(nz(time(tf, ses90L4_ses, tz)))
    is_ses90NY1 = math.sign(nz(time(tf, ses90NY1_ses, tz)))
    is_ses90NY2 = math.sign(nz(time(tf, ses90NY2_ses, tz)))
    is_ses90NY3 = math.sign(nz(time(tf, ses90NY3_ses, tz)))
    is_ses90NY4 = math.sign(nz(time(tf, ses90NY4_ses, tz)))
    is_ses90CBDR1 = math.sign(nz(time(tf, ses90CBDR1_ses, tz)))
    is_ses90CBDR2 = math.sign(nz(time(tf, ses90CBDR2_ses, tz)))
    is_ses90CBDR3 = math.sign(nz(time(tf, ses90CBDR3_ses, tz)))
    is_ses90CBDR4 = math.sign(nz(time(tf, ses90CBDR4_ses, tz)))

    is_ses360A1 = math.sign(nz(time(tf, ses360A1_ses, tz)))
    is_ses360L1 = math.sign(nz(time(tf, ses360L1_ses, tz)))
    is_ses360NY1 = math.sign(nz(time(tf, ses360NY1_ses, tz)))
    is_ses360CBDR1 = math.sign(nz(time(tf, ses360CBDR1_ses, tz)))

    is_ses23A11 = math.sign(nz(time(tf, ses23A11_ses, tz)))
    is_ses23A12 = math.sign(nz(time(tf, ses23A12_ses, tz)))
    is_ses23A13 = math.sign(nz(time(tf, ses23A13_ses, tz)))
    is_ses23A14 = math.sign(nz(time(tf, ses23A14_ses, tz)))
    is_ses23A21 = math.sign(nz(time(tf, ses23A21_ses, tz)))
    is_ses23A22 = math.sign(nz(time(tf, ses23A22_ses, tz)))
    is_ses23A23 = math.sign(nz(time(tf, ses23A23_ses, tz)))
    is_ses23A24 = math.sign(nz(time(tf, ses23A24_ses, tz)))
    is_ses23A31 = math.sign(nz(time(tf, ses23A31_ses, tz)))
    is_ses23A32 = math.sign(nz(time(tf, ses23A32_ses, tz)))
    is_ses23A33 = math.sign(nz(time(tf, ses23A33_ses, tz)))
    is_ses23A34 = math.sign(nz(time(tf, ses23A34_ses, tz)))
    is_ses23A41 = math.sign(nz(time(tf, ses23A41_ses, tz)))
    is_ses23A42 = math.sign(nz(time(tf, ses23A42_ses, tz)))
    is_ses23A43 = math.sign(nz(time(tf, ses23A43_ses, tz)))
    is_ses23A44 = math.sign(nz(time(tf, ses23A44_ses, tz)))
    is_ses23L11 = math.sign(nz(time(tf, ses23L11_ses, tz)))
    is_ses23L12 = math.sign(nz(time(tf, ses23L12_ses, tz)))
    is_ses23L13 = math.sign(nz(time(tf, ses23L13_ses, tz)))
    is_ses23L14 = math.sign(nz(time(tf, ses23L14_ses, tz)))
    is_ses23L21 = math.sign(nz(time(tf, ses23L21_ses, tz)))
    is_ses23L22 = math.sign(nz(time(tf, ses23L22_ses, tz)))
    is_ses23L23 = math.sign(nz(time(tf, ses23L23_ses, tz)))
    is_ses23L24 = math.sign(nz(time(tf, ses23L24_ses, tz)))
    is_ses23L31 = math.sign(nz(time(tf, ses23L31_ses, tz)))
    is_ses23L32 = math.sign(nz(time(tf, ses23L32_ses, tz)))
    is_ses23L33 = math.sign(nz(time(tf, ses23L33_ses, tz)))
    is_ses23L34 = math.sign(nz(time(tf, ses23L34_ses, tz)))
    is_ses23L41 = math.sign(nz(time(tf, ses23L41_ses, tz)))
    is_ses23L42 = math.sign(nz(time(tf, ses23L42_ses, tz)))
    is_ses23L43 = math.sign(nz(time(tf, ses23L43_ses, tz)))
    is_ses23L44 = math.sign(nz(time(tf, ses23L44_ses, tz)))
    is_ses23NY11 = math.sign(nz(time(tf, ses23NY11_ses, tz)))
    is_ses23NY12 = math.sign(nz(time(tf, ses23NY12_ses, tz)))
    is_ses23NY13 = math.sign(nz(time(tf, ses23NY13_ses, tz)))
    is_ses23NY14 = math.sign(nz(time(tf, ses23NY14_ses, tz)))
    is_ses23NY21 = math.sign(nz(time(tf, ses23NY21_ses, tz)))
    is_ses23NY22 = math.sign(nz(time(tf, ses23NY22_ses, tz)))
    is_ses23NY23 = math.sign(nz(time(tf, ses23NY23_ses, tz)))
    is_ses23NY24 = math.sign(nz(time(tf, ses23NY24_ses, tz)))
    is_ses23NY31 = math.sign(nz(time(tf, ses23NY31_ses, tz)))
    is_ses23NY32 = math.sign(nz(time(tf, ses23NY32_ses, tz)))
    is_ses23NY33 = math.sign(nz(time(tf, ses23NY33_ses, tz)))
    is_ses23NY34 = math.sign(nz(time(tf, ses23NY34_ses, tz)))
    is_ses23NY41 = math.sign(nz(time(tf, ses23NY41_ses, tz)))
    is_ses23NY42 = math.sign(nz(time(tf, ses23NY42_ses, tz)))
    is_ses23NY43 = math.sign(nz(time(tf, ses23NY43_ses, tz)))
    is_ses23NY44 = math.sign(nz(time(tf, ses23NY44_ses, tz)))
    is_ses23CBDR2311 = math.sign(nz(time(tf, ses23CBDR2311_ses, tz)))
    is_ses23CBDR2312 = math.sign(nz(time(tf, ses23CBDR2312_ses, tz)))
    is_ses23CBDR2313 = math.sign(nz(time(tf, ses23CBDR2313_ses, tz)))
    is_ses23CBDR2314 = math.sign(nz(time(tf, ses23CBDR2314_ses, tz)))
    is_ses23CBDR2321 = math.sign(nz(time(tf, ses23CBDR2321_ses, tz)))
    is_ses23CBDR2322 = math.sign(nz(time(tf, ses23CBDR2322_ses, tz)))
    is_ses23CBDR2323 = math.sign(nz(time(tf, ses23CBDR2323_ses, tz)))
    is_ses23CBDR2324 = math.sign(nz(time(tf, ses23CBDR2324_ses, tz)))
    is_ses23CBDR2331 = math.sign(nz(time(tf, ses23CBDR2331_ses, tz)))
    is_ses23CBDR2332 = math.sign(nz(time(tf, ses23CBDR2332_ses, tz)))
    is_ses23CBDR2333 = math.sign(nz(time(tf, ses23CBDR2333_ses, tz)))
    is_ses23CBDR2334 = math.sign(nz(time(tf, ses23CBDR2334_ses, tz)))
    is_ses23CBDR2341 = math.sign(nz(time(tf, ses23CBDR2341_ses, tz)))
    is_ses23CBDR2342 = math.sign(nz(time(tf, ses23CBDR2342_ses, tz)))
    is_ses23CBDR2343 = math.sign(nz(time(tf, ses23CBDR2343_ses, tz)))
    is_ses23CBDR2344 = math.sign(nz(time(tf, ses23CBDR2344_ses, tz)))

    if show_indicator90 and timeframe.isintraday and timeframe.multiplier <= 15
        if show_ses90A1
            get_range(is_ses90A1, ses90A1_txt, ses90A1_css)
        if show_ses90A2
            get_range(is_ses90A2, ses90A2_txt, ses90A2_css)
        if show_ses90A3
            get_range(is_ses90A3, ses90A3_txt, ses90A3_css)
        if show_ses90A4
            get_range(is_ses90A4, ses90A4_txt, ses90A4_css)
        if show_ses90L1
            get_range(is_ses90L1, ses90L1_txt, ses90L1_css)
        if show_ses90L2
            get_range(is_ses90L2, ses90L2_txt, ses90L2_css)
        if show_ses90L3
            get_range(is_ses90L3, ses90L3_txt, ses90L3_css)
        if show_ses90L4
            get_range(is_ses90L4, ses90L4_txt, ses90L4_css)
        if show_ses90NY1
            get_range(is_ses90NY1, ses90NY1_txt, ses90NY1_css)
        if show_ses90NY2
            get_range(is_ses90NY2, ses90NY2_txt, ses90NY2_css)
        if show_ses90NY3
            get_range(is_ses90NY3, ses90NY3_txt, ses90NY3_css)
        if show_ses90NY4
            get_range(is_ses90NY4, ses90NY4_txt, ses90NY4_css)
        if show_ses90CBDR1
            get_range(is_ses90CBDR1, ses90CBDR1_txt, ses90CBDR1_css)
        if show_ses90CBDR2
            get_range(is_ses90CBDR2, ses90CBDR2_txt, ses90CBDR2_css)
        if show_ses90CBDR3
            get_range(is_ses90CBDR3, ses90CBDR3_txt, ses90CBDR3_css)
        if show_ses90CBDR4
            get_range(is_ses90CBDR4, ses90CBDR4_txt, ses90CBDR4_css)

    if show_indicator360 and timeframe.isintraday and timeframe.multiplier >= 15 and timeframe.multiplier <= 60
        if show_ses360A1
            get_range360(is_ses360A1, ses360A1_txt, ses360A1_css)
        if show_ses360L1
            get_range360(is_ses360L1, ses360L1_txt, ses360L1_css)
        if show_ses360NY1
            get_range360(is_ses360NY1, ses360NY1_txt, ses360NY1_css)
        if show_ses360CBDR1
            get_range360(is_ses360CBDR1, ses360CBDR1_txt, ses360CBDR1_css)

    if show_indicator23 and timeframe.isintraday and timeframe.multiplier <= 1
        if show_ses23A11
            get_range23(is_ses23A11, ses23A11_txt, ses23A11_css)
        if show_ses23A12
            get_range23(is_ses23A12, ses23A12_txt, ses23A12_css)
        if show_ses23A13
            get_range23(is_ses23A13, ses23A13_txt, ses23A13_css)
        if show_ses23A14
            get_range23(is_ses23A14, ses23A14_txt, ses23A14_css)
