//@version=6
indicator("Relative Strength Index", "RSI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // toward and below the oversold level - stretched to the downside
BEAR_COLOR    = #f23645 // toward and above the overbought level - stretched to the upside
NEUTRAL_COLOR = #787b86 // midline readings and the levels themselves

ZONE_TRANSP = 92 // transparency of the soft overbought / oversold zone shading
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput     = input.int(14, "Length", minval = 1, group = "Settings", tooltip = "Number of bars used in the Wilder smoothing of average gains and losses.")
srcInput        = input.source(close, "Source", group = "Settings", tooltip = "Price series the RSI is calculated on.")
overboughtInput = input.float(70, "Overbought", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level above which the market is considered overbought.")
oversoldInput   = input.float(30, "Oversold", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level below which the market is considered oversold.")

rsiColorInput   = input.color(NEUTRAL_COLOR, "RSI", group = "Style", tooltip = "Color of the RSI line at the midline. Toward the oversold level it blends into the oversold color, toward the overbought level into the overbought color.")
osColorInput    = input.color(BULL_COLOR, "Oversold", inline = "zones", group = "Style", tooltip = "Color of the line and zone shading at and below the oversold level.")
obColorInput    = input.color(BEAR_COLOR, "Overbought", inline = "zones", group = "Style", tooltip = "Color of the line and zone shading at and above the overbought level.")
levelColorInput = input.color(NEUTRAL_COLOR, "Levels", group = "Style", tooltip = "Color of the overbought, midline and oversold levels.")
fillColorInput  = input.color(color.new(NEUTRAL_COLOR, 90), "Band Fill", group = "Style", tooltip = "Color of the fill between the overbought and oversold levels.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
rsiValue = ta.rsi(srcInput, lengthInput)

overboughtEnter = ta.crossover(rsiValue, overboughtInput)
overboughtExit  = ta.crossunder(rsiValue, overboughtInput)
oversoldEnter   = ta.crossunder(rsiValue, oversoldInput)
oversoldExit    = ta.crossover(rsiValue, oversoldInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
midLevel = (overboughtInput + oversoldInput) / 2
rsiColor = na(rsiValue) ? rsiColorInput : rsiValue <= midLevel ? color.from_gradient(rsiValue, oversoldInput, midLevel, osColorInput, rsiColorInput) : color.from_gradient(rsiValue, midLevel, overboughtInput, rsiColorInput, obColorInput)

plot(rsiValue, "RSI", rsiColor, 2)

// Soft zone shading anchored on hidden plots
obZoneId       = plot(overboughtInput, "Overbought Zone Anchor", color(na), editable = false, display = display.none)
osZoneId       = plot(oversoldInput, "Oversold Zone Anchor", color(na), editable = false, display = display.none)
topAnchorId    = plot(100, "Top Anchor", color(na), editable = false, display = display.none)
bottomAnchorId = plot(0, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(obColorInput, ZONE_TRANSP), title = "Overbought Zone")
fill(osZoneId, bottomAnchorId, color.new(osColorInput, ZONE_TRANSP), title = "Oversold Zone")

obLineId = hline(overboughtInput, "Overbought Level", levelColorInput, hline.style_dashed)
hline(50, "Midline", levelColorInput, hline.style_dotted)
osLineId = hline(oversoldInput, "Oversold Level", levelColorInput, hline.style_dashed)

fill(obLineId, osLineId, fillColorInput, "Overbought/Oversold Band")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(overboughtEnter, "Overbought", "RSI crossed above the overbought level")
alertcondition(overboughtExit, "Exit Overbought", "RSI crossed below the overbought level")
alertcondition(oversoldEnter, "Oversold", "RSI crossed below the oversold level")
alertcondition(oversoldExit, "Exit Oversold", "RSI crossed above the oversold level")
//----------------------------------------------------------------------------------------------------------------------}
