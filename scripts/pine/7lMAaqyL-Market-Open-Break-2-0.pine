// =============================================================================
// MNQ 09:30 Breakout Strategy v2.0 — Pine Script v6
// Changes from v1:
//   - Risk-based position sizing: contracts = floor(risk_per_trade / (sl_points * point_value))
//   - Intra-day circuit breaker: 2 losses in the same day → no more entries that day
// =============================================================================
//@version=6
strategy(
    title             = "MNQ 09:30 Breakout v2",
    shorttitle        = "B0930v2",
    overlay           = true,
    default_qty_type  = strategy.fixed,
    default_qty_value = 1,
    commission_type   = strategy.commission.cash_per_contract,
    commission_value  = 0.25,
    slippage          = 1,
    pyramiding        = 0,
    calc_on_every_tick= false
)

// =============================================================================
// INPUTS
// =============================================================================
var g_entry = "Entry Rules"
risk_per_trade = input.float(350.0, "Risk Per Trade ($)", group=g_entry, minval=1,    step=10,   tooltip="Max dollar loss per trade. Contracts = floor(risk / (sl_points × point_value)).")
point_value    = input.float(2.0,   "Point Value ($)",    group=g_entry, minval=0.01, step=0.5,  tooltip="Dollar value per point per contract. MNQ = $2, NQ = $20.")
tp_pct         = input.float(0.10,  "TP %",               group=g_entry, minval=0.01, step=0.01, tooltip="Profit target as % of entry price.")
max_sl_pct     = input.float(0.30,  "Max SL %",           group=g_entry, minval=0.01, step=0.01, tooltip="Skip trade if SL distance exceeds this % of entry.")
max_trades          = input.int(3, "Max Trades/Day",             group=g_entry, minval=1, maxval=10)
max_losses_day      = input.int(2, "Max Losses/Day (CB)",         group=g_entry, minval=1, maxval=10, tooltip="Para de entrar após esse nº de losses no dia. Use 10 para desativar.")
max_consec_days     = input.int(2, "Max Consec Loss Days (CB)",   group=g_entry, minval=1, maxval=10, tooltip="Pula o dia inteiro após esse nº de dias consecutivos perdendo.")

var g_viz = "Visualization"
show_anchor = input.bool(true, "Show Anchor Lines", group=g_viz)

// =============================================================================
// TIME HELPERS — America/New_York
// =============================================================================
ny_time = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")

at_anchor   = ny_time == 9 * 60 + 30
in_window   = ny_time >= 9 * 60 + 31 and ny_time <= 11 * 60 + 30
past_window = ny_time > 11 * 60 + 30

// =============================================================================
// DAILY STATE
// =============================================================================
var float anchor_high    = na
var float anchor_low     = na
var bool  anchor_set     = false
var int   trades_today   = 0
var int   losses_today   = 0   // intra-day loss counter (circuit breaker)
var bool  skip_today     = false
var int   last_direction = 0   // 1=last was long, -1=last was short
var int   consec_loss    = 0   // consecutive losing DAYS (cross-day filter)
var float day_start_eq   = 0.0
var int   prev_closed    = 0   // closed-trade count at day open (for intra-day tracking)

if at_anchor
    if anchor_set
        day_pnl = strategy.netprofit - day_start_eq
        if day_pnl < 0
            consec_loss += 1
        else
            consec_loss := 0

    skip_today     := consec_loss >= max_consec_days
    if consec_loss >= max_consec_days
        consec_loss := 0

    anchor_high    := high
    anchor_low     := low
    anchor_set     := true
    trades_today   := 0
    losses_today   := 0
    last_direction := 0
    day_start_eq   := strategy.netprofit
    prev_closed    := strategy.closedtrades

// Detect trades that closed during this session and count intra-day losses
if strategy.closedtrades > prev_closed
    for i = prev_closed to strategy.closedtrades - 1
        if strategy.closedtrades.profit(i) < 0
            losses_today += 1
    prev_closed := strategy.closedtrades

// =============================================================================
// ENTRY LOGIC
// =============================================================================
// losses_today < 2: after 2 losses in the day, no more entries
day_ok    = anchor_set and not skip_today and trades_today < max_trades and losses_today < max_losses_day
can_trade = day_ok and strategy.position_size == 0 and in_window

break_above = not na(anchor_high) and close > anchor_high and close[1] <= anchor_high
break_below = not na(anchor_low)  and close < anchor_low  and close[1] >= anchor_low

long_sl_ok      = not na(anchor_low)  and (close - anchor_low)  / close * 100 <= max_sl_pct
short_sl_ok     = not na(anchor_high) and (anchor_high - close) / close * 100 <= max_sl_pct
long_entry_bar  = can_trade and break_above and long_sl_ok  and last_direction != 1
short_entry_bar = can_trade and break_below and short_sl_ok and last_direction != -1

// Long breakout
if can_trade and break_above and last_direction != 1
    sl_pct = (close - anchor_low) / close * 100
    if sl_pct <= max_sl_pct
        sl_points = close - anchor_low
        qty       = math.max(1, math.floor(risk_per_trade / (sl_points * point_value)))
        tp_price  = close * (1.0 + tp_pct / 100.0)
        trades_today   += 1
        last_direction := 1
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("Long Exit", from_entry="Long", limit=tp_price, stop=anchor_low)

// Short breakout
if can_trade and break_below and last_direction != -1
    sl_pct = (anchor_high - close) / close * 100
    if sl_pct <= max_sl_pct
        sl_points = anchor_high - close
        qty       = math.max(1, math.floor(risk_per_trade / (sl_points * point_value)))
        tp_price  = close * (1.0 - tp_pct / 100.0)
        trades_today   += 1
        last_direction := -1
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Short Exit", from_entry="Short", limit=tp_price, stop=anchor_high)

// Time stop: close at 11:31 ET
if past_window and strategy.position_size != 0
    strategy.close_all(comment="Time Stop")

// =============================================================================
// VISUALIZATION
// =============================================================================
var line line_anchor_high = na
var line line_anchor_low  = na

if at_anchor and show_anchor
    if not na(line_anchor_high)
        line.delete(line_anchor_high)
    if not na(line_anchor_low)
        line.delete(line_anchor_low)
    line_anchor_high := line.new(bar_index, high, bar_index + 100, high,
         color=color.red,  width=1, extend=extend.right, style=line.style_dashed)
    line_anchor_low  := line.new(bar_index, low,  bar_index + 100, low,
         color=color.blue, width=1, extend=extend.right, style=line.style_dashed)

plotshape(long_entry_bar,  title="Long Entry",  style=shape.triangleup,
          location=location.belowbar, color=color.green, size=size.small)
plotshape(short_entry_bar, title="Short Entry", style=shape.triangledown,
          location=location.abovebar, color=color.red,   size=size.small)

// =============================================================================
// PERFORMANCE TABLE
// =============================================================================
var table perf_table = table.new(position.bottom_right, 2, 9,
     border_color=color.gray, border_width=1, bgcolor=color.new(color.black, 70))

total_trades     = strategy.closedtrades
winning_trades   = strategy.wintrades
losing_trades    = strategy.losstrades
gross_profit     = strategy.grossprofit
gross_loss       = strategy.grossloss
net_profit       = strategy.netprofit
initial_capital  = strategy.initial_capital
total_return_pct = initial_capital > 0 ? net_profit / initial_capital * 100 : 0.0
win_rate         = total_trades > 0 ? winning_trades / total_trades * 100 : 0.0
profit_factor    = gross_loss != 0 ? gross_profit / math.abs(gross_loss) : na
avg_win          = winning_trades > 0 ? gross_profit           / winning_trades : 0.0
avg_loss         = losing_trades  > 0 ? math.abs(gross_loss)  / losing_trades  : 0.0

var int max_consec_loss = 0
var int cur_consec_loss = 0
if barstate.islastconfirmedhistory
    cur_consec_loss := 0
    max_consec_loss := 0
    for i = 0 to strategy.closedtrades - 1
        if strategy.closedtrades.profit(i) < 0
            cur_consec_loss += 1
            if cur_consec_loss > max_consec_loss
                max_consec_loss := cur_consec_loss
        else
            cur_consec_loss := 0

if barstate.islast
    table.cell(perf_table, 0, 0, "Metric",         text_color=color.yellow, text_halign=text.align_left)
    table.cell(perf_table, 1, 0, "Value",           text_color=color.yellow, text_halign=text.align_right)
    table.cell(perf_table, 0, 1, "Total Trades",    text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 1, str.tostring(total_trades),
               text_color=color.white, text_halign=text.align_right)
    table.cell(perf_table, 0, 2, "Win Rate",        text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 2, str.tostring(math.round(win_rate * 10) / 10) + "%",
               text_color=win_rate >= 40 ? color.green : color.red, text_halign=text.align_right)
    table.cell(perf_table, 0, 3, "Profit Factor",   text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 3, na(profit_factor) ? "N/A" : str.tostring(math.round(profit_factor * 100) / 100),
               text_color=not na(profit_factor) and profit_factor >= 1.5 ? color.green : color.red, text_halign=text.align_right)
    table.cell(perf_table, 0, 4, "Avg Win",         text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 4, "$" + str.tostring(math.round(avg_win * 100) / 100),
               text_color=color.green, text_halign=text.align_right)
    table.cell(perf_table, 0, 5, "Avg Loss",        text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 5, "$" + str.tostring(math.round(avg_loss * 100) / 100),
               text_color=color.red, text_halign=text.align_right)
    table.cell(perf_table, 0, 6, "Max Consec Loss", text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 6, str.tostring(max_consec_loss),
               text_color=max_consec_loss >= 5 ? color.red : color.white, text_halign=text.align_right)
    table.cell(perf_table, 0, 7, "Net Profit",      text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 7, "$" + str.tostring(math.round(net_profit * 100) / 100),
               text_color=net_profit >= 0 ? color.green : color.red, text_halign=text.align_right)
    table.cell(perf_table, 0, 8, "Total Return",    text_color=color.white,  text_halign=text.align_left)
    table.cell(perf_table, 1, 8, str.tostring(math.round(total_return_pct * 10) / 10) + "%",
               text_color=total_return_pct >= 0 ? color.green : color.red, text_halign=text.align_right)
