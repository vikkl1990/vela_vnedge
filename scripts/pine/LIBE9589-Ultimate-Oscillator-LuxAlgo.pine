//@version=6
indicator("Ultimate Oscillator", "UO", overlay = false, format = format.price, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
FAST_WEIGHT   = 4
MIDDLE_WEIGHT = 2
SLOW_WEIGHT   = 1
WEIGHT_SUM    = FAST_WEIGHT + MIDDLE_WEIGHT + SLOW_WEIGHT
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
fastLengthInput   = input.int(7, "Fast Length", minval = 1, group = "Settings", tooltip = "Bars in the fastest averaging window. Weighted 4 in the final blend, so it dominates the oscillator.")
middleLengthInput = input.int(14, "Middle Length", minval = 1, group = "Settings", tooltip = "Bars in the intermediate averaging window. Weighted 2 in the final blend.")
slowLengthInput   = input.int(28, "Slow Length", minval = 1, group = "Settings", tooltip = "Bars in the slowest averaging window. Weighted 1 in the final blend.")

obLevelInput = input.float(70, "Overbought", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level above which the oscillator is considered overbought.")
osLevelInput = input.float(30, "Oversold", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level below which the oscillator is considered oversold.")

uoColorInput    = input.color(#787b86, "Oscillator", group = "Style", tooltip = "Color of the Ultimate Oscillator line midway between the levels. The line blends toward the oversold color as it nears the oversold level and toward the overbought color as it nears the overbought level.")
levelColorInput = input.color(#787b86, "Levels", group = "Style", tooltip = "Color of the overbought and oversold levels.")
osColorInput    = input.color(#089981, "Oversold", inline = "zones", group = "Style", tooltip = "Color of the line at the oversold level and of the oversold zone shading.")
obColorInput    = input.color(#f23645, "Overbought", inline = "zones", group = "Style", tooltip = "Color of the line at the overbought level and of the overbought zone shading.")
//----------------------------------------------------------------------------------------------------------------------}
// Functions
//----------------------------------------------------------------------------------------------------------------------{
uoAverage(bpSeries, trSeries, length) =>
    bpSum = math.sum(bpSeries, length)
    trSum = math.sum(trSeries, length)
    (na(trSum) or trSum == 0) ? float(na) : bpSum / trSum
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
trueLow        = math.min(low, close[1])
buyingPressure = close - trueLow
trueRange      = math.max(high, close[1]) - trueLow

avgFast   = uoAverage(buyingPressure, trueRange, fastLengthInput)
avgMiddle = uoAverage(buyingPressure, trueRange, middleLengthInput)
avgSlow   = uoAverage(buyingPressure, trueRange, slowLengthInput)

uo = 100 * (FAST_WEIGHT * avgFast + MIDDLE_WEIGHT * avgMiddle + SLOW_WEIGHT * avgSlow) / WEIGHT_SUM
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring across the levels - oversold color below, neutral midway, overbought color above
midLevel = (obLevelInput + osLevelInput) / 2
uoColor  = na(uo) ? uoColorInput : uo <= midLevel ? color.from_gradient(uo, osLevelInput, midLevel, osColorInput, uoColorInput) : color.from_gradient(uo, midLevel, obLevelInput, uoColorInput, obColorInput)

plot(uo, "UO", uoColor, 1)

hline(obLevelInput, "Overbought", levelColorInput, hline.style_dashed)
hline(osLevelInput, "Oversold", levelColorInput, hline.style_dashed)

// Soft zone shading - overbought zone above, oversold zone below, anchored on hidden plots
obZoneId     = plot(obLevelInput, "Overbought Zone Anchor", color(na), editable = false, display = display.none)
osZoneId     = plot(osLevelInput, "Oversold Zone Anchor", color(na), editable = false, display = display.none)
topAnchorId  = plot(100, "Top Anchor", color(na), editable = false, display = display.none)
baseAnchorId = plot(0, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(obColorInput, 91), title = "Overbought Zone")
fill(osZoneId, baseAnchorId, color.new(osColorInput, 91), title = "Oversold Zone")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
enterObCondition = ta.crossover(uo, obLevelInput)
exitObCondition  = ta.crossunder(uo, obLevelInput)
enterOsCondition = ta.crossunder(uo, osLevelInput)
exitOsCondition  = ta.crossover(uo, osLevelInput)

alertcondition(enterObCondition, "Overbought", "Ultimate Oscillator crossed above the overbought level")
alertcondition(exitObCondition, "Overbought Exit", "Ultimate Oscillator crossed back below the overbought level")
alertcondition(enterOsCondition, "Oversold", "Ultimate Oscillator crossed below the oversold level")
alertcondition(exitOsCondition, "Oversold Exit", "Ultimate Oscillator crossed back above the oversold level")
//----------------------------------------------------------------------------------------------------------------------}