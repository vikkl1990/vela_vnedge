//@version=6
indicator("Market State Matrix [LuxAlgo]", "LuxAlgo - Market State Matrix", overlay = true, max_polylines_count = 100, scale = scale.none)

//---------------------------------------------------------------------------------------------------------------------}
// Constants & Inputs
//---------------------------------------------------------------------------------------------------------------------{
// --- Visual Style ---
color NEUT_COLOR     = #131722
color BORDER_COLOR   = #2a2e39
color HIGHLIGHT_COL  = #ffffff

// --- Ring Palettes ---
color R1_BULL = #089981, color R1_BEAR = #f23645 // Trend (Teal/Red)
color R2_BULL = #00e5ff, color R2_BEAR = #d500f9 // Momentum (Cyan/Purple)
color R3_HOT  = #ffea00                          // Volatility (Gold)
color R4_HOT  = #ffffff                          // Volume (White)
color R5_BULL = #aeea00, color R5_BEAR = #ff3d00 // Structure (Lime/Orange)

// --- Dashboard Settings ---
color DATA       = #DBDBDB
color HEADERS    = #808080
color BACKGROUND = #161616
color BORDERS    = #2E2E2E

string G_VIS = "Visual Settings"
int   posInput       = input.int(80, "Horizontal Offset", minval = 0, group = G_VIS, tooltip = "Adjusts the X-axis position of the wheel.")
float radiusInput    = input.float(12, "Core Radius", minval = 2, group = G_VIS, tooltip = "Size of the inner-most circle.")
float ringWidth      = input.float(4.5, "Ring Width", minval = 1, group = G_VIS, tooltip = "Thickness of each concentric ring.")
float gapWidth       = input.float(0.5, "Ring Gap", minval = 0, group = G_VIS, tooltip = "Thin separation between segments.")
bool  showLegend     = input.bool(true, "Show Dashboard Legend", group = G_VIS)

// Fixed Coordinate System
plot(0, "Y-Axis Min", color = na)
plot(100, "Y-Axis Max", color = na)

//---------------------------------------------------------------------------------------------------------------------}
// Multi-Scale Metric Engine
//---------------------------------------------------------------------------------------------------------------------{
// Each of the 12 slices represents a progressively longer lookback (Cluster)
L0 = 8, L1 = 12, L2 = 18, L3 = 24, L4 = 32, L5 = 45, L6 = 60, L7 = 80, L8 = 100, L9 = 130, L10 = 170, L11 = 220

// Normalizer for volatility ring
atrRef = ta.sma(ta.atr(14), 100)

// Master calculation function: Extracts 5 dimensions of market data
calcState(int len) =>
    // 1. Regime (EMA-based)
    reg = ta.ema(close, len) > ta.ema(close, len * 2) ? 1. : -1.
    // 2. Momentum (RSI-based)
    rsiVal = ta.rsi(close, len)
    // 3. Volatility (ATR Ratio)
    vlt = math.min(100, (ta.atr(len) / (atrRef + 0.00001)) * 50)
    // 4. Volume (Relative Pressure)
    vlm = volume / (ta.sma(volume, len) + 0.00001)
    // 5. Structure (HH/HL vs LH/LL)
    hh = ta.highest(high, len) > ta.highest(high, len)[1]
    hl = ta.lowest(low, len) >= ta.lowest(low, len)[1]
    lh = ta.highest(high, len) <= ta.highest(high, len)[1]
    ll = ta.lowest(low, len) < ta.lowest(low, len)[1]
    structureResult = (hh and hl) ? 1. : (lh and ll) ? -1. : 0.
    [reg, rsiVal, vlt, vlm, structureResult]

// Pre-calculate all 12 slices globally to satisfy Pine Script state tracking
[r0, rsi0, v0, vlm0, s0] = calcState(L0)
[r1, rsi1, v1, vlm1, s1] = calcState(L1)
[r2, rsi2, v2, vlm2, s2] = calcState(L2)
[r3, rsi3, v3, vlm3, s3] = calcState(L3)
[r4, rsi4, v4, vlm4, s4] = calcState(L4)
[r5, rsi5, v5, vlm5, s5] = calcState(L5)
[r6, rsi6, v6, vlm6, s6] = calcState(L6)
[r7, rsi7, v7, vlm7, s7] = calcState(L7)
[r8, rsi8, v8, vlm8, s8] = calcState(L8)
[r9, rsi9, v9, vlm9, s9] = calcState(L9)
[r10, rsi10, v10, vlm10, s10] = calcState(L10)
[r11, rsi11, v11, vlm11, s11] = calcState(L11)

// Getter functions for the drawing loop
getReg(int i) => 
    switch i
        0 => r0
        1 => r1
        2 => r2
        3 => r3
        4 => r4
        5 => r5
        6 => r6
        7 => r7
        8 => r8
        9 => r9
        10 => r10
        11 => r11
        => 0.0

getRSI(int i) => 
    switch i
        0 => rsi0
        1 => rsi1
        2 => rsi2
        3 => rsi3
        4 => rsi4
        5 => rsi5
        6 => rsi6
        7 => rsi7
        8 => rsi8
        9 => rsi9
        10 => rsi10
        11 => rsi11
        => 50.0

getVlt(int i) => 
    switch i
        0 => v0
        1 => v1
        2 => v2
        3 => v3
        4 => v4
        5 => v5
        6 => v6
        7 => v7
        8 => v8
        9 => v9
        10 => v10
        11 => v11
        => 0.0

getVlm(int i) => 
    switch i
        0 => vlm0
        1 => vlm1
        2 => vlm2
        3 => vlm3
        4 => vlm4
        5 => vlm5
        6 => vlm6
        7 => vlm7
        8 => vlm8
        9 => vlm9
        10 => vlm10
        11 => vlm11
        => 1.0

getStr(int i) => 
    switch i
        0 => s0
        1 => s1
        2 => s2
        3 => s3
        4 => s4
        5 => s5
        6 => s6
        7 => s7
        8 => s8
        9 => s9
        10 => s10
        11 => s11
        => 0.0

//---------------------------------------------------------------------------------------------------------------------}
// Radial Logic & Visuals
//---------------------------------------------------------------------------------------------------------------------{
var polyline[] segments = array.new<polyline>()

// Coordinate Helper
getPt(float cX, float cY, float r, float angle) =>
    rad = (angle - 90) * math.pi / 180
    chart.point.from_index(int(cX + r * 1.5 * math.cos(rad)), cY + r * math.sin(rad))

// Segment Drawer
drawSeg(float cX, float cY, float rIn, float rOut, float sA, float eA, color col) =>
    pts = array.new<chart.point>()
    pts.push(getPt(cX, cY, rOut, sA))
    pts.push(getPt(cX, cY, rOut, eA))
    pts.push(getPt(cX, cY, rIn, eA))
    pts.push(getPt(cX, cY, rIn, sA))
    polyline.new(pts, closed = true, fill_color = col, line_color = BORDER_COLOR, line_width = 1)

// Table Helper
cell(table t, int col, int row, string txt, color c = #FFFFFF, align = text.align_right) => 
    t.cell(col, row, txt, text_color = c, text_size = size.small, text_halign = align, bgcolor = na)

if barstate.islast
    // Clear Canvas
    for p in segments
        polyline.delete(p)
    array.clear(segments)

    float cX = last_bar_index + posInput
    float cY = 50.0
    float arcWidth = 360.0 / 12

    // 1. Dashboard Legend Table
    if showLegend
        var t = table.new(position.top_right, 2, 7, bgcolor = BACKGROUND, frame_color = BORDERS, frame_width = 1)
        t.merge_cells(0, 0, 1, 0)
        t.cell(0, 0, 'MATRIX LAYERS', text_color = DATA, text_size = size.small, text_halign = text.align_center)
        cell(t, 0, 1, 'Ring 1', R1_BULL, text.align_left), cell(t, 1, 1, 'Trend Regime', DATA)
        cell(t, 0, 2, 'Ring 2', R2_BULL, text.align_left), cell(t, 1, 2, 'Momentum', DATA)
        cell(t, 0, 3, 'Ring 3', R3_HOT,  text.align_left), cell(t, 1, 3, 'Volatility', DATA)
        cell(t, 0, 4, 'Ring 4', R4_HOT,  text.align_left), cell(t, 1, 4, 'Volume Pressure', DATA)
        cell(t, 0, 5, 'Ring 5', R5_BULL, text.align_left), cell(t, 1, 5, 'Price Structure', DATA)
        t.merge_cells(0, 6, 1, 6)
        t.cell(0, 6, 'Selected Slice = Active Phase', text_color = HEADERS, text_size = size.tiny, text_halign = text.align_center)

    // 2. Core (Master State)
    masterReg = getReg(0), masterRSI = getRSI(0)
    coreCol = masterReg > 0 ? R1_BULL : R1_BEAR
    array.push(segments, drawSeg(cX, cY, 0, radiusInput, 0, 360, color.new(coreCol, 15)))

    // 3. Wheel Loop (12 Slices)
    for i = 0 to 11
        float sA = i * arcWidth
        float eA = (i + 1) * arcWidth
        regVal = getReg(i), rsiVal = getRSI(i), vltVal = getVlt(i), vlmVal = getVlm(i), strVal = getStr(i)

        // Ring 1: Trend
        r1Col = regVal > 0 ? color.from_gradient(regVal, 0, 1, NEUT_COLOR, R1_BULL) : color.from_gradient(math.abs(regVal), 0, 1, NEUT_COLOR, R1_BEAR)
        array.push(segments, drawSeg(cX, cY, radiusInput + gapWidth, radiusInput + ringWidth, sA, eA, r1Col))

        // Ring 2: Momentum
        mInt = math.abs(rsiVal - 50) * 2
        r2Col = rsiVal > 50 ? color.from_gradient(mInt, 0, 100, NEUT_COLOR, R2_BULL) : color.from_gradient(mInt, 0, 100, NEUT_COLOR, R2_BEAR)
        array.push(segments, drawSeg(cX, cY, radiusInput + ringWidth + gapWidth, radiusInput + ringWidth * 2, sA, eA, r2Col))

        // Ring 3: Volatility
        r3Col = color.from_gradient(math.min(100, vltVal), 0, 100, NEUT_COLOR, R3_HOT)
        array.push(segments, drawSeg(cX, cY, radiusInput + ringWidth * 2 + gapWidth, radiusInput + ringWidth * 3, sA, eA, r3Col))

        // Ring 4: Volume
        r4Col = color.from_gradient(math.min(100, vlmVal * 30), 0, 100, NEUT_COLOR, R4_HOT)
        array.push(segments, drawSeg(cX, cY, radiusInput + ringWidth * 3 + gapWidth, radiusInput + ringWidth * 4, sA, eA, r4Col))

        // Ring 5: Structure
        r5Col = strVal > 0 ? R5_BULL : strVal < 0 ? R5_BEAR : NEUT_COLOR
        array.push(segments, drawSeg(cX, cY, radiusInput + ringWidth * 4 + gapWidth, radiusInput + ringWidth * 5, sA, eA, color.new(r5Col, 35)))

    // 4. Highlighter: Focus on current Market Phase
    highAngle = masterReg > 0 ? (masterRSI > 50 ? 45 : 135) : (masterRSI < 50 ? 225 : 315)
    
    // Glowing Slice
    hpts = array.new<chart.point>()
    hpts.push(getPt(cX, cY, radiusInput, highAngle - 15))
    hpts.push(getPt(cX, cY, radiusInput + ringWidth * 5.2, highAngle - 15))
    hpts.push(getPt(cX, cY, radiusInput + ringWidth * 5.2, highAngle + 15))
    hpts.push(getPt(cX, cY, radiusInput, highAngle + 15))
    array.push(segments, polyline.new(hpts, closed = true, line_color = color.new(HIGHLIGHT_COL, 60), fill_color = color.new(HIGHLIGHT_COL, 92)))

    // Outer Arc
    hArc = array.new<chart.point>()
    for k = 0 to 10
        a = (highAngle - 18) + (36 * k / 10)
        hArc.push(getPt(cX, cY, radiusInput + ringWidth * 5.8, a))
    array.push(segments, polyline.new(hArc, line_color = HIGHLIGHT_COL, line_width = 3))

//---------------------------------------------------------------------------------------------------------------------}