//@version=6
indicator("Dynamic Momentum Index", shorttitle = "Dynamic Momentum Index", overlay = false, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
// Chande & Kroll's Dynamic Momentum Index (not Wilder's directional DMI): a variable-length RSI whose
// lookback contracts when volatility rises and stretches when it falls.
int   BANK_MIN  = 2
int   BANK_MAX  = 50
float MID_LEVEL = 50.0

color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color ACCENT_COLOR  = #ff9800 // the one accent - the optional effective-length stepline
color LEVEL_COLOR   = #787b86

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

int ZONE_TRANSP = 91 // transparency of the soft overbought / oversold zone shading

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
string GRP_CALC  = "Calculation"
string GRP_LEVEL = "Levels"
string GRP_DASH  = "Dashboard"
string GRP_STYLE = "Style"

srcInput         = input.source(close, "Source", group = GRP_CALC, tooltip = "Price series used for both the volatility index and the RSI calculation. Chande & Kroll's specification uses closes.")
baseLengthInput  = input.int(14, "Base RSI Length", minval = BANK_MIN, maxval = BANK_MAX, group = GRP_CALC, tooltip = "Base period being adapted (14 in the published specification). Each bar it is divided by the volatility index to obtain the dynamic lookback.")
stdevLengthInput = input.int(5, "Volatility Stdev Length", minval = 2, group = GRP_CALC, tooltip = "Number of bars in the standard deviation of the source (5 in the published specification).")
smaLengthInput   = input.int(10, "Volatility Average Length", minval = 1, group = GRP_CALC, tooltip = "Number of bars in the simple moving average of the standard deviation (10 in the published specification). The volatility index is the current deviation divided by this average.")
minLengthInput   = input.int(5, "Minimum RSI Length", minval = BANK_MIN, maxval = BANK_MAX, group = GRP_CALC, tooltip = "Lower clamp of the dynamic lookback (5 in the published specification), reached when volatility is well above its recent norm.")
maxLengthInput   = input.int(30, "Maximum RSI Length", minval = BANK_MIN, maxval = BANK_MAX, group = GRP_CALC, tooltip = "Upper clamp of the dynamic lookback (30 in the published specification), reached when volatility is well below its recent norm.")

obInput = input.float(70, "Overbought Level", minval = 50, maxval = 100, step = 1, group = GRP_LEVEL, tooltip = "Overbought threshold. The usual RSI conventions apply, but since the effective period shortens in volatile markets the DMI reaches extremes more often — some users widen 70/30 to 80/20.")
osInput = input.float(30, "Oversold Level", minval = 0, maxval = 50, step = 1, group = GRP_LEVEL, tooltip = "Oversold threshold. The usual RSI conventions apply, but since the effective period shortens in volatile markets the DMI reaches extremes more often — some users widen 70/30 to 80/20.")

showDashInput = input.bool(true, "Show Dashboard", group = GRP_DASH, tooltip = "Display a compact panel with the current effective RSI length and volatility index.")
dashLocInput  = input.string("Top Right", "Location", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = GRP_DASH, tooltip = "Dashboard position within the pane.")
dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = GRP_DASH, tooltip = "Dashboard text size.")

bullColorInput   = input.color(BULL_COLOR, "Bullish Color", group = GRP_STYLE)
bearColorInput   = input.color(BEAR_COLOR, "Bearish Color", group = GRP_STYLE)
levelColorInput  = input.color(LEVEL_COLOR, "Levels Color", group = GRP_STYLE)
showLengthInput  = input.bool(false, "Show Effective Length", inline = "len", group = GRP_STYLE)
lengthColorInput = input.color(ACCENT_COLOR, "", inline = "len", group = GRP_STYLE, tooltip = "Plot the dynamic lookback (in bars) as a stepline to visualize the period contracting in volatile phases and stretching in quiet ones.")

//---------------------------------------------------------------------------------------------------------------------}
// Dynamic Length
//---------------------------------------------------------------------------------------------------------------------{
// Volatility index: current 5-bar standard deviation of the source relative to its own 10-bar average
float sd    = ta.stdev(srcInput, stdevLengthInput)
float sdAvg = ta.sma(sd, smaLengthInput)
float vi    = sdAvg > 0 ? sd / sdAvg : na

int loLen = math.min(minLengthInput, maxLengthInput)
int hiLen = math.max(minLengthInput, maxLengthInput)

// TD = int(base / Vi), truncated to whole bars and clamped between the minimum and maximum lengths.
// While the volatility index is still undefined the base period is used; a zero deviation maps to the
// longest lookback (the limit of base / Vi as Vi approaches 0).
int dynLength = switch
    na(vi)  => math.min(math.max(baseLengthInput, loLen), hiLen)
    vi <= 0 => hiLen
    =>         math.min(math.max(int(math.min(baseLengthInput / vi, BANK_MAX)), loLen), hiLen)

//---------------------------------------------------------------------------------------------------------------------}
// Dynamic Momentum Index
//---------------------------------------------------------------------------------------------------------------------{
// The DMI is an ordinary RSI reading taken on the adaptive length. ta.rsi() requires a fixed length per
// call, so a standard Wilder RSI is maintained for every admissible lookback and the series matching the
// current dynamic length is sampled on each bar.
float[] rsiBank = array.new_float()
array.push(rsiBank, ta.rsi(srcInput, 2))
array.push(rsiBank, ta.rsi(srcInput, 3))
array.push(rsiBank, ta.rsi(srcInput, 4))
array.push(rsiBank, ta.rsi(srcInput, 5))
array.push(rsiBank, ta.rsi(srcInput, 6))
array.push(rsiBank, ta.rsi(srcInput, 7))
array.push(rsiBank, ta.rsi(srcInput, 8))
array.push(rsiBank, ta.rsi(srcInput, 9))
array.push(rsiBank, ta.rsi(srcInput, 10))
array.push(rsiBank, ta.rsi(srcInput, 11))
array.push(rsiBank, ta.rsi(srcInput, 12))
array.push(rsiBank, ta.rsi(srcInput, 13))
array.push(rsiBank, ta.rsi(srcInput, 14))
array.push(rsiBank, ta.rsi(srcInput, 15))
array.push(rsiBank, ta.rsi(srcInput, 16))
array.push(rsiBank, ta.rsi(srcInput, 17))
array.push(rsiBank, ta.rsi(srcInput, 18))
array.push(rsiBank, ta.rsi(srcInput, 19))
array.push(rsiBank, ta.rsi(srcInput, 20))
array.push(rsiBank, ta.rsi(srcInput, 21))
array.push(rsiBank, ta.rsi(srcInput, 22))
array.push(rsiBank, ta.rsi(srcInput, 23))
array.push(rsiBank, ta.rsi(srcInput, 24))
array.push(rsiBank, ta.rsi(srcInput, 25))
array.push(rsiBank, ta.rsi(srcInput, 26))
array.push(rsiBank, ta.rsi(srcInput, 27))
array.push(rsiBank, ta.rsi(srcInput, 28))
array.push(rsiBank, ta.rsi(srcInput, 29))
array.push(rsiBank, ta.rsi(srcInput, 30))
array.push(rsiBank, ta.rsi(srcInput, 31))
array.push(rsiBank, ta.rsi(srcInput, 32))
array.push(rsiBank, ta.rsi(srcInput, 33))
array.push(rsiBank, ta.rsi(srcInput, 34))
array.push(rsiBank, ta.rsi(srcInput, 35))
array.push(rsiBank, ta.rsi(srcInput, 36))
array.push(rsiBank, ta.rsi(srcInput, 37))
array.push(rsiBank, ta.rsi(srcInput, 38))
array.push(rsiBank, ta.rsi(srcInput, 39))
array.push(rsiBank, ta.rsi(srcInput, 40))
array.push(rsiBank, ta.rsi(srcInput, 41))
array.push(rsiBank, ta.rsi(srcInput, 42))
array.push(rsiBank, ta.rsi(srcInput, 43))
array.push(rsiBank, ta.rsi(srcInput, 44))
array.push(rsiBank, ta.rsi(srcInput, 45))
array.push(rsiBank, ta.rsi(srcInput, 46))
array.push(rsiBank, ta.rsi(srcInput, 47))
array.push(rsiBank, ta.rsi(srcInput, 48))
array.push(rsiBank, ta.rsi(srcInput, 49))
array.push(rsiBank, ta.rsi(srcInput, 50))

float dmi      = array.get(rsiBank, dynLength - BANK_MIN)
bool  dmiAbove = dmi > MID_LEVEL

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
color oscColor = dmiAbove ? bullColorInput : bearColorInput

dmiPlotId = plot(dmi, "DMI", color = oscColor, linewidth = 1)
midPlotId = plot(MID_LEVEL, "Mid Anchor", color = na, editable = false, display = display.none)

color fillTopColor    = dmiAbove ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)
color fillBottomColor = dmiAbove ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)
fill(dmiPlotId, midPlotId, math.max(dmi, MID_LEVEL), math.min(dmi, MID_LEVEL), fillTopColor, fillBottomColor, title = "DMI Gradient")

plot(showLengthInput ? dynLength : na, "Effective Length", color = lengthColorInput, style = plot.style_stepline)

// Soft zone shading - overbought band above the upper level, oversold band below the lower level
obAnchorId  = plot(obInput, "Overbought Anchor", color = na, editable = false, display = display.none)
osAnchorId  = plot(osInput, "Oversold Anchor", color = na, editable = false, display = display.none)
topAnchorId = plot(100, "Top Anchor", color = na, editable = false, display = display.none)
botAnchorId = plot(0, "Bottom Anchor", color = na, editable = false, display = display.none)

fill(obAnchorId, topAnchorId, color.new(bearColorInput, ZONE_TRANSP), title = "Overbought Zone")
fill(osAnchorId, botAnchorId, color.new(bullColorInput, ZONE_TRANSP), title = "Oversold Zone")

hline(obInput, "Overbought", color = levelColorInput, linestyle = hline.style_dashed)
hline(osInput, "Oversold", color = levelColorInput, linestyle = hline.style_dashed)
hline(MID_LEVEL, "Middle", color = levelColorInput, linestyle = hline.style_dotted)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
string tablePos = switch dashLocInput
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    =>                position.bottom_left

string tableSize = switch dashSizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    =>         size.normal

var table dashboardTable = table.new(tablePos, 2, 2, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if showDashInput and barstate.islast
    table.cell(dashboardTable, 0, 0, "Effective Length", text_color = DASH_HEADER, text_size = tableSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 0, str.tostring(dynLength), text_color = DASH_TEXT, text_size = tableSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 1, "Volatility Index", text_color = DASH_HEADER, text_size = tableSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 1, na(vi) ? "-" : str.tostring(vi, "#.##"), text_color = DASH_TEXT, text_size = tableSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
crossAboveOb  = ta.crossover(dmi, obInput)
crossBelowOb  = ta.crossunder(dmi, obInput)
crossBelowOs  = ta.crossunder(dmi, osInput)
crossAboveOs  = ta.crossover(dmi, osInput)
crossAboveMid = ta.crossover(dmi, MID_LEVEL)
crossBelowMid = ta.crossunder(dmi, MID_LEVEL)

alertcondition(crossAboveOb, "Overbought", "Dynamic Momentum Index crossed above the overbought level")
alertcondition(crossBelowOb, "Exit Overbought", "Dynamic Momentum Index crossed back below the overbought level")
alertcondition(crossBelowOs, "Oversold", "Dynamic Momentum Index crossed below the oversold level")
alertcondition(crossAboveOs, "Exit Oversold", "Dynamic Momentum Index crossed back above the oversold level")
alertcondition(crossAboveMid, "Bullish Centerline Cross", "Dynamic Momentum Index crossed above the 50 centerline")
alertcondition(crossBelowMid, "Bearish Centerline Cross", "Dynamic Momentum Index crossed below the 50 centerline")

//---------------------------------------------------------------------------------------------------------------------}
