//@version=6
indicator("Inertial Stochastic [LuxAlgo]", "LuxAlgo - Inertial Stochastic", precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color D_COLOR    = #787b86

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
int minLenInput    = input.int(10, "Minimum Length", minval = 2, group = "Settings")
int maxLenInput    = input.int(40, "Maximum Length", minval = 2, group = "Settings")
int smoothKInput   = input.int(3, "K Smoothing", minval = 1, group = "Settings")
int smoothDInput   = input.int(3, "D Smoothing", minval = 1, group = "Settings")

color bullColorInput = input.color(BULL_COLOR, "Bullish Color", group = "Style")
color bearColorInput = input.color(BEAR_COLOR, "Bearish Color", group = "Style")
color dColorInput    = input.color(D_COLOR   , "%D Color"     , group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Logic
//---------------------------------------------------------------------------------------------------------------------{
var float lvStoch = 50.0

// Finding the length N that minimizes variation from the previous value
float bestStoch = 50.0
float minDiff   = 1e10

float hh = high
float ll = low

for i = 1 to maxLenInput - 1
    hh := math.max(hh, high[i])
    ll := math.min(ll, low[i])
    
    int currentLen = i + 1
    
    if currentLen >= minLenInput
        float den = hh - ll
        float stoch = den == 0 ? 50.0 : 100 * (close - ll) / den
        float diff = math.abs(stoch - lvStoch)
        
        if diff < minDiff
            minDiff   := diff
            bestStoch := stoch

lvStoch := bestStoch

// Smoothing
float k = ta.sma(lvStoch, smoothKInput)
float d = ta.sma(k, smoothDInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Plotting the K and D lines
plotK = plot(k, "K", color = k > 50 ? bullColorInput : bearColorInput)
plotD = plot(d, "D", color = dColorInput, linestyle = plot.linestyle_dotted)

// Center line for gradient fill
midPlot = plot(50, "Middle Level", color = color.new(chart.fg_color, 80), display = display.none)

// Overbought/Oversold levels
h80 = hline(80, "Overbought", color = color.new(chart.fg_color, 50), linestyle = hline.style_dashed)
l20 = hline(20, "Oversold", color = color.new(chart.fg_color, 50), linestyle = hline.style_dashed)

// Normalized Oscillator Gradient Fill
// Fades from the line color to transparency at the center (50)
fill(plotK, midPlot, 100, 50, bullColorInput, color.new(bullColorInput, 100), "Bullish Gradient")
fill(plotK, midPlot, 50, 0, color.new(bearColorInput, 100), bearColorInput, "Bearish Gradient")

//---------------------------------------------------------------------------------------------------------------------}
