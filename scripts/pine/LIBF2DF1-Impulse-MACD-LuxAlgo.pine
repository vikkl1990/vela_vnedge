//@version=6
indicator("Impulse MACD", shorttitle = "Impulse MACD", overlay = false, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // signal line color
RANGE_COLOR       = #787b86 // dead-zone / range color
FILL_VALUE_TRANSP = 50      // gradient transparency at the impulse value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line
HIST_GROW_TRANSP  = 40      // histogram transparency while momentum expands
HIST_FADE_TRANSP  = 70      // histogram transparency once momentum contracts
BAND_LINE_TRANSP  = 30      // on-chart band line transparency
BG_TRANSP         = 92      // dead-zone background transparency

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput          = input.source(hlc3, "Source", group = "Settings",
     tooltip = "Price series tracked against the smoothed high/low band. The published construction uses the typical price - the average of high, low and close (hlc3).")

lengthInput       = input.int(34, "Length", minval = 1, group = "Settings",
     tooltip = "Number of bars for the smoothed (Wilder-style) moving averages of the highs and of the lows that build the band, and for the zero-lag average of the source tracked against it. 34 is the widely used default - lengthening widens the dead zone, shortening narrows it.")

signalLengthInput = input.int(9, "Signal Length", minval = 1, group = "Settings",
     tooltip = "Number of bars for the simple moving average of the impulse line that acts as the signal, with the histogram measuring the gap between them. 9 is the published default.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Color of the impulse line, gradient fill, histogram and ignition markers while the line is above zero.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Color of the impulse line, gradient fill, histogram and ignition markers while the line is below zero.")

rangeColorInput   = input.color(RANGE_COLOR, "Dead Zone", group = "Style",
     tooltip = "Color of the flatlined impulse line while the zero-lag average sits inside the smoothed high/low band, and of the optional background highlight and on-chart band.")

signalColorInput  = input.color(SIGNAL_COLOR, "Signal Line", group = "Style",
     tooltip = "Color of the signal line.")

showHistInput     = input.bool(true, "Show Histogram", group = "Style",
     tooltip = "Displays the histogram (impulse line minus signal line) as columns. Bright columns mark expanding momentum, faded columns mark a histogram already contracting back toward its signal line.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the zero line and the impulse line with a vertical gradient, fully transparent at zero and strongest at the current value.")

highlightInput    = input.bool(false, "Highlight Dead Zone", group = "Style",
     tooltip = "Tints the pane background while the impulse line is flat at zero - the stretches this tool classifies as range, where the designed response is to stand aside.")

markersInput      = input.bool(false, "Ignition Markers", group = "Style",
     tooltip = "Marks the first print off zero with a dot on the oscillator - the moment price escapes its smoothed high/low band. Kept off by default so the pane stays clean; the ignition alerts cover the same events.")

showBandInput     = input.bool(false, "Show Band on Chart", group = "Style",
     tooltip = "Draws the smoothed moving averages of the highs and of the lows on the price chart - the band whose interior is the dead zone. While the zero-lag average holds inside it, the oscillator prints zero.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Smoothed high/low band - Wilder-style smoothed moving averages (SMMA) of the highs and of the lows. ta.rma
// implements the SMMA recursion (previous * (length - 1) + value) / length, seeded with a simple average
upperBand = ta.rma(high, lengthInput)
lowerBand = ta.rma(low, lengthInput)

// Zero-lag exponential average of the source - an EMA that offsets its smoothing delay by measuring its own lag
// (the EMA minus the EMA of the EMA) and extrapolating that lag back onto itself
srcEma      = ta.ema(srcInput, lengthInput)
srcEmaEma   = ta.ema(srcEma, lengthInput)
zeroLagMean = srcEma + (srcEma - srcEmaEma)

// Impulse line - zero while the zero-lag mean holds inside the band, otherwise the displacement beyond it
impulseMacd = na(zeroLagMean) or na(upperBand) or na(lowerBand) ? na :
     zeroLagMean > upperBand ? zeroLagMean - upperBand :
     zeroLagMean < lowerBand ? zeroLagMean - lowerBand : 0.0

// Signal line and histogram - simple average of the impulse line, and the gap between the two
signalLine = ta.sma(impulseMacd, signalLengthInput)
histogram  = impulseMacd - signalLine

// Oscillator states - active means price has escaped the band, the dead zone means it trades inside it
activeState = not na(impulseMacd) and impulseMacd != 0
inDeadZone  = not na(impulseMacd) and impulseMacd == 0

// Signal grammar - band escapes (ignitions), the return to zero, and MACD grammar gated outside the dead zone
igniteUp     = activeState and impulseMacd > 0 and not na(impulseMacd[1]) and impulseMacd[1] <= 0
igniteDown   = activeState and impulseMacd < 0 and not na(impulseMacd[1]) and impulseMacd[1] >= 0
returnToZero = inDeadZone and not na(impulseMacd[1]) and impulseMacd[1] != 0

crossUp   = ta.crossover(impulseMacd, signalLine)
crossDown = ta.crossunder(impulseMacd, signalLine)
bullCross = crossUp and activeState
bearCross = crossDown and activeState

histTurnUp   = activeState and not na(histogram[2]) and histogram > histogram[1] and histogram[1] <= histogram[2]
histTurnDown = activeState and not na(histogram[2]) and histogram < histogram[1] and histogram[1] >= histogram[2]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// Histogram shading encodes turns - bright while momentum expands, faded once it starts contracting
histExpanding   = histogram >= 0 ? histogram > histogram[1] : histogram < histogram[1]
histStrongColor = histogram >= 0 ? color.new(bullColorInput, HIST_GROW_TRANSP) : color.new(bearColorInput, HIST_GROW_TRANSP)
histSoftColor   = histogram >= 0 ? color.new(bullColorInput, HIST_FADE_TRANSP) : color.new(bearColorInput, HIST_FADE_TRANSP)
histColor       = histExpanding ? histStrongColor : histSoftColor

plot(showHistInput ? histogram : na, "Histogram", style = plot.style_columns, color = histColor)

zeroPlotId = plot(0, "Zero Line", color = color.new(chart.fg_color, 90), linewidth = 1)

plot(signalLine, "Signal Line", color = signalColorInput, linewidth = 1)

// Impulse line - directional color while active, the dead-zone color while flat at zero
impulseColor  = impulseMacd > 0 ? bullColorInput : impulseMacd < 0 ? bearColorInput : rangeColorInput
impulsePlotId = plot(impulseMacd, "Impulse MACD Line", color = impulseColor, linewidth = 1)

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the impulse value
fillTopColor    = impulseMacd > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_ZERO_TRANSP)
fillBottomColor = impulseMacd > 0 ? color.new(bullColorInput, FILL_ZERO_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(impulsePlotId, zeroPlotId, top_value = math.max(impulseMacd, 0), bottom_value = math.min(impulseMacd, 0), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Zero-line Gradient Fill")

// Dead-zone background - optional tint over the stretches where price holds inside its smoothed range
bgcolor(highlightInput and inDeadZone ? color.new(rangeColorInput, BG_TRANSP) : na, title = "Dead Zone Background")

// Ignition markers - optional dots where the line first leaves the dead zone
plotshape(markersInput and igniteUp ? impulseMacd : na, "Bullish Ignition Marker", shape.circle, location.absolute, color = bullColorInput, size = size.tiny)
plotshape(markersInput and igniteDown ? impulseMacd : na, "Bearish Ignition Marker", shape.circle, location.absolute, color = bearColorInput, size = size.tiny)

// Optional on-chart band - the smoothed high/low range whose interior mutes the oscillator
plot(showBandInput ? upperBand : na, "Smoothed High Band", color = color.new(rangeColorInput, BAND_LINE_TRANSP), linewidth = 1, force_overlay = true)
plot(showBandInput ? lowerBand : na, "Smoothed Low Band", color = color.new(rangeColorInput, BAND_LINE_TRANSP), linewidth = 1, force_overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(igniteUp, "Bullish Ignition", "Impulse MACD pushed above zero on {{ticker}} - price escaping its smoothed high/low range to the upside ({{interval}})")
alertcondition(igniteDown, "Bearish Ignition", "Impulse MACD dropped below zero on {{ticker}} - price escaping its smoothed high/low range to the downside ({{interval}})")
alertcondition(returnToZero, "Return To Zero", "Impulse MACD returned to zero on {{ticker}} - the escape is finished and price is back inside its smoothed range ({{interval}})")
alertcondition(bullCross, "Bullish Signal Cross", "Impulse MACD crossed above its signal line outside the dead zone on {{ticker}} - momentum turning up ({{interval}})")
alertcondition(bearCross, "Bearish Signal Cross", "Impulse MACD crossed below its signal line outside the dead zone on {{ticker}} - momentum turning down ({{interval}})")
alertcondition(histTurnUp, "Histogram Turn Up", "Impulse MACD histogram turned up outside the dead zone on {{ticker}} - the move regaining pace ({{interval}})")
alertcondition(histTurnDown, "Histogram Turn Down", "Impulse MACD histogram turned down outside the dead zone on {{ticker}} - the move losing pace ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
