//@version=6
indicator("SuperTrend", "SuperTrend", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
TREND_UP = 1
TREND_DN = -1

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
atrLengthInput = input.int(10, "ATR Length", minval = 1, group = "Settings", tooltip = "Number of bars used to compute the Wilder ATR.")
factorInput = input.float(3.0, "Factor", minval = 0, step = 0.1, group = "Settings", tooltip = "ATR multiplier setting how far the trailing stop sits from the bar midpoint.")

upColorInput = input.color(#089981, "Uptrend Color", group = "Style", tooltip = "Line color while the trend is up.")
dnColorInput = input.color(#f23645, "Downtrend Color", group = "Style", tooltip = "Line color while the trend is down.")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
atrValue = ta.atr(atrLengthInput)

basicUpper = hl2 + factorInput * atrValue
basicLower = hl2 - factorInput * atrValue

var float finalUpper = na
var float finalLower = na
var int trendDir = TREND_DN

if not na(atrValue)
    prevUpper = nz(finalUpper[1], basicUpper)
    prevLower = nz(finalLower[1], basicLower)
    prevClose = nz(close[1], close)

    // Bands only ratchet while the prior close holds inside them, otherwise they reset to the basic band
    finalUpper := prevClose <= prevUpper ? math.min(basicUpper, prevUpper) : basicUpper
    finalLower := prevClose >= prevLower ? math.max(basicLower, prevLower) : basicLower

    trendDir := close > finalUpper ? TREND_UP : close < finalLower ? TREND_DN : trendDir

superTrend = trendDir == TREND_UP ? finalLower : finalUpper

prevTrendDir = nz(trendDir[1], trendDir)
trendFlipUp = trendDir == TREND_UP and prevTrendDir == TREND_DN
trendFlipDn = trendDir == TREND_DN and prevTrendDir == TREND_UP

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(trendDir == TREND_UP ? superTrend : na, "Uptrend", color = upColorInput, style = plot.style_linebr)
plot(trendDir == TREND_DN ? superTrend : na, "Downtrend", color = dnColorInput, style = plot.style_linebr)

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(trendFlipUp, "Trend Flip Up", "SuperTrend flipped to uptrend")
alertcondition(trendFlipDn, "Trend Flip Down", "SuperTrend flipped to downtrend")

//----------------------------------------------------------------------------------------------------------------------}
