//@version=6
indicator("Midpoint/half-back of Session", shorttitle = "Midpoint/half-back of Session", overlay = true, format = format.price, max_lines_count = 500, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
string GROUP_SESSIONS = "Sessions"
string GROUP_LOGIC    = "Half-Back"
string GROUP_DISPLAY  = "Display"
string GROUP_DASH     = "Dashboard"
string GROUP_STYLE    = "Style"

string TZ_EXCHANGE = "Exchange"

string CARRY_OPEN  = "Until Next Open"
string CARRY_CLOSE = "Until Next Close"

string MODE_SESSION = "Session Color"
string MODE_CONTROL = "Control Side"

string STYLE_SOLID  = "Solid"
string STYLE_DASHED = "Dashed"
string STYLE_DOTTED = "Dotted"

string POS_TR = "Top Right"
string POS_TL = "Top Left"
string POS_BR = "Bottom Right"
string POS_BL = "Bottom Left"

string SIZE_TINY   = "Tiny"
string SIZE_SMALL  = "Small"
string SIZE_NORMAL = "Normal"

color COLOR_BULL = #089981
color COLOR_BEAR = #f23645
color COLOR_GRAY = #787b86
color COLOR_NONE = #00000000

//session identities - the carried Asia mid is the one accent, the other sessions are grey structure
color COLOR_SES1 = #ff9800
color COLOR_SES2 = #787b86
color COLOR_SES3 = #b2b5be

//dashboard palette
color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

int MS_PER_DAY = 86400000

tzInput = input.string("UTC", "Timezone"
  , options = [TZ_EXCHANGE, "UTC", "America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Shanghai", "Asia/Kolkata", "Australia/Sydney"]
  , group   = GROUP_SESSIONS
  , tooltip = "Timezone the session windows are defined in, daylight-saving aware whatever the chart's time zone. The classic forex session map (Asia 00:00-08:00, London 08:00-16:00) is drawn on UTC; 'Exchange' uses the chart symbol's exchange timezone instead.")

ses1EnableInput = input.bool(true, "Session 1"
  , inline  = "ses1"
  , group   = GROUP_SESSIONS
  , tooltip = "Track this window: its running high and low set the developing half-back, (session high + session low) / 2, and the completed level is frozen at the close.")

ses1NameInput = input.string("Asia", ""
  , inline  = "ses1"
  , group   = GROUP_SESSIONS
  , tooltip = "Name shown on this session's labels and dashboard row.")

ses1SessionInput = input.session("0000-0800", ""
  , inline  = "ses1"
  , group   = GROUP_SESSIONS
  , tooltip = "Session window in the selected timezone. The Asia mid is the most commonly carried half-back - the overnight balance London and New York then break or respect. Use 0000-0000 for a full trading day to track the daily half-back instead.")

ses2EnableInput = input.bool(true, "Session 2"
  , inline  = "ses2"
  , group   = GROUP_SESSIONS
  , tooltip = "Track this window: its running high and low set the developing half-back, (session high + session low) / 2, and the completed level is frozen at the close.")

ses2NameInput = input.string("London", ""
  , inline  = "ses2"
  , group   = GROUP_SESSIONS
  , tooltip = "Name shown on this session's labels and dashboard row.")

ses2SessionInput = input.session("0800-1600", ""
  , inline  = "ses2"
  , group   = GROUP_SESSIONS
  , tooltip = "Session window in the selected timezone, 08:00-16:00 UTC by the classic London convention.")

ses3EnableInput = input.bool(true, "Session 3"
  , inline  = "ses3"
  , group   = GROUP_SESSIONS
  , tooltip = "Track this window: its running high and low set the developing half-back, (session high + session low) / 2, and the completed level is frozen at the close.")

ses3NameInput = input.string("New York", ""
  , inline  = "ses3"
  , group   = GROUP_SESSIONS
  , tooltip = "Name shown on this session's labels and dashboard row.")

ses3SessionInput = input.session("1300-2100", ""
  , inline  = "ses3"
  , group   = GROUP_SESSIONS
  , tooltip = "Session window in the selected timezone, 13:00-21:00 UTC spanning the New York trading day. Overlapping windows are fine - each session is tracked independently.")

acceptClosesInput = input.int(2, "Acceptance Closes"
  , minval  = 1
  , maxval  = 10
  , group   = GROUP_LOGIC
  , tooltip = "Consecutive closes on one side of the developing half-back required before that side is read as controlling the session's range. Drives the acceptance-flip alerts, the control-side coloring and the dashboard read - bars closing and holding on one side keep that side in control.")

carryInput = input.bool(true, "Carry Completed Half-Back"
  , inline  = "carry"
  , group   = GROUP_LOGIC
  , tooltip = "At the session close, freeze the half-back alongside the session high and low and extend it to the right as a reference - the completed Asia mid carried into London and New York is the classic use.")

carryModeInput = input.string(CARRY_OPEN, ""
  , inline  = "carry"
  , options = [CARRY_OPEN, CARRY_CLOSE]
  , group   = GROUP_LOGIC
  , tooltip = "How far the frozen level is carried. 'Until Next Open' drops it when the same session next opens; 'Until Next Close' keeps it across that session too, so the prior day's half-back stays in play against today's - the right choice on data feeds that only cover the session itself.")

showHlInput = input.bool(true, "Show Session High / Low"
  , group   = GROUP_DISPLAY
  , tooltip = "Draw the running session high and low around the developing half-back, and carry the frozen extremes forward with it - the completed mid is classically watched alongside that session's high and low.")

showLabelsInput = input.bool(true, "Level Labels"
  , group   = GROUP_DISPLAY
  , tooltip = "Show a name and price tag at the right end of each half-back, with a running count of the tests the level has absorbed.")

markTestsInput = input.bool(false, "Mark Half-Back Tests"
  , group   = GROUP_DISPLAY
  , tooltip = "Place a small circle on the level each time price leaves a half-back and returns to test it. Off by default to keep the chart clean - the test and hold alerts fire either way.")

showBgInput = input.bool(false, "Highlight Session Windows"
  , group   = GROUP_DISPLAY
  , tooltip = "Tint the chart background over each session window with its session color, making the window boundaries readable at a glance.")

showDashInput = input.bool(true, "Show Dashboard"
  , group   = GROUP_DASH
  , tooltip = "Status panel with one row per session: the half-back currently in play (live while the window runs, carried after it closes), which side has acceptance, and how many times the level has been tested.")

dashPositionInput = input.string(POS_TR, "Position"
  , options = [POS_TR, POS_TL, POS_BR, POS_BL]
  , group   = GROUP_DASH
  , tooltip = "Corner of the chart the dashboard is anchored to.")

dashSizeInput = input.string(SIZE_SMALL, "Text Size"
  , options = [SIZE_TINY, SIZE_SMALL, SIZE_NORMAL]
  , group   = GROUP_DASH
  , tooltip = "Text size of the dashboard.")

ses1ColorInput = input.color(COLOR_SES1, "Session 1 Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of session 1's half-back, session high/low, labels, test markers and dashboard row.")

ses2ColorInput = input.color(COLOR_SES2, "Session 2 Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of session 2's half-back, session high/low, labels, test markers and dashboard row.")

ses3ColorInput = input.color(COLOR_SES3, "Session 3 Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of session 3's half-back, session high/low, labels, test markers and dashboard row.")

colorModeInput = input.string(MODE_CONTROL, "Half-Back Coloring"
  , options = [MODE_SESSION, MODE_CONTROL]
  , group   = GROUP_STYLE
  , tooltip = "'Session Color' keeps each developing half-back in its session's identity color. 'Control Side' colors it by the acceptance read instead - buyers' color while closes hold above the level, sellers' while they hold below, gray while undecided.")

bullColorInput = input.color(COLOR_BULL, "Buyers"
  , inline  = "control"
  , group   = GROUP_STYLE
  , tooltip = "Color used when buyers hold acceptance above the half-back - in the control-side coloring mode and on the dashboard.")

bearColorInput = input.color(COLOR_BEAR, "Sellers"
  , inline  = "control"
  , group   = GROUP_STYLE
  , tooltip = "Color used when sellers hold acceptance below the half-back - in the control-side coloring mode and on the dashboard.")

carryStyleInput = input.string(STYLE_DASHED, "Carried Line Style"
  , options = [STYLE_SOLID, STYLE_DASHED, STYLE_DOTTED]
  , group   = GROUP_STYLE
  , tooltip = "Line style of the frozen half-back carried forward after the session close. The developing level is always drawn solid.")

lineWidthInput = input.int(1, "Line Width"
  , minval  = 1
  , maxval  = 5
  , group   = GROUP_STYLE
  , tooltip = "Width of the developing and carried half-back lines. The session high/low frame is always drawn one pixel wide.")

string tzSession = tzInput == TZ_EXCHANGE ? syminfo.timezone : tzInput

string carryLineStyle = switch carryStyleInput
    STYLE_SOLID  => line.style_solid
    STYLE_DOTTED => line.style_dotted
    =>              line.style_dashed

string dashTextSize = switch dashSizeInput
    SIZE_TINY   => size.tiny
    SIZE_NORMAL => size.normal
    =>             size.small

string dashPos = switch dashPositionInput
    POS_TL => position.top_left
    POS_BR => position.bottom_right
    POS_BL => position.bottom_left
    =>        position.top_right

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
//minutes after midnight the session window opens, parsed from the first HHMM of the session string
sessionStartMinutes(string sessionWindow) =>
    float hh = str.length(sessionWindow) >= 4 ? str.tonumber(str.substring(sessionWindow, 0, 2)) : na
    float mm = str.length(sessionWindow) >= 4 ? str.tonumber(str.substring(sessionWindow, 2, 4)) : na
    int(nz(hh, 0) * 60 + nz(mm, 0))

//calendar day (in the session timezone) the current bar's session instance belongs to; bars printing before the
//window's start time are assigned to the previous day, so windows crossing midnight stay one instance while
//data gaps between two same-session days still split them
instanceDay(int startMinutes) =>
    int todMinutes = hour(time, tzSession) * 60 + minute(time, tzSession)
    int keyTime    = todMinutes < startMinutes ? time - MS_PER_DAY : time
    year(keyTime, tzSession) * 10000 + month(keyTime, tzSession) * 100 + dayofmonth(keyTime, tzSession)

//runs one session slot for the current bar: tracks the running range and its developing half-back while the
//window is open, advances the acceptance state and the test counters, freezes and carries the completed level
//at the close, and returns the bar's values and event flags for the plots, dashboard and alerts
processSession(bool enabled, string sessionWindow, int startMinutes, string sesName, color sesColor) =>
    int  sessionTime = time(timeframe.period, sessionWindow, tzSession)
    bool inSession   = enabled and timeframe.isintraday and not na(sessionTime)
    bool wasIn       = na(inSession[1]) ? false : inSession[1]
    int  dayKey      = instanceDay(startMinutes)
    bool keyChanged  = nz(dayKey[1], dayKey) != dayKey
    bool sesStart    = inSession and (not wasIn or keyChanged)
    bool sesEnd      = wasIn and (not inSession or keyChanged)
    bool stopCarry   = sesStart and carryModeInput == CARRY_OPEN

    var float sesHi = na
    var float sesLo = na

    //freeze the completed range before the same bar can start a fresh window (data-gap splits)
    float frozenMid = na
    float frozenHi  = na
    float frozenLo  = na
    if sesEnd and not na(sesHi)
        frozenMid := math.avg(sesHi, sesLo)
        frozenHi  := sesHi
        frozenLo  := sesLo

    if sesStart
        sesHi := high
        sesLo := low
    else if inSession
        sesHi := math.max(nz(sesHi, high), high)
        sesLo := math.min(nz(sesLo, low), low)

    float devMid = inSession and not na(sesHi) ? math.avg(sesHi, sesLo) : na
    float devHi  = inSession ? sesHi : na
    float devLo  = inSession ? sesLo : na

    //acceptance: consecutive closes on one side of the developing half-back hand that side control of the range
    var int acceptSide   = 0
    var int pendingSide  = 0
    var int pendingCount = 0
    bool flipUpEvent = false
    bool flipDnEvent = false
    if sesStart
        acceptSide   := 0
        pendingSide  := 0
        pendingCount := 0
    if inSession and not na(devMid)
        int closeSide = close > devMid ? 1 : close < devMid ? -1 : 0
        if closeSide != 0
            if closeSide == pendingSide
                pendingCount += 1
            else
                pendingSide  := closeSide
                pendingCount := 1
            if pendingCount >= acceptClosesInput and acceptSide != pendingSide
                flipUpEvent := pendingSide == 1 and acceptSide == -1
                flipDnEvent := pendingSide == -1 and acceptSide == 1
                acceptSide  := pendingSide

    //tests of the developing half-back: price left the level and pulled back into it
    var int devTests = 0
    if sesStart
        devTests := 0
    bool  devTouch     = inSession and not na(devMid) and high >= devMid and low <= devMid
    bool  devWasTouch  = na(devTouch[1]) ? false : devTouch[1]
    bool  devTestEvent = devTouch and not devWasTouch and not sesStart
    float refMid       = devMid[1]
    bool  devHoldEvent = devTestEvent and not na(refMid) and ((close[1] > refMid and close > devMid) or (close[1] < refMid and close < devMid))
    if devTestEvent
        devTests += 1

    //carried level: the frozen half-back (and extremes) extended to the right after the session close
    var line  carryLine   = na
    var line  carryHiLine = na
    var line  carryLoLine = na
    var label carryLabel  = na
    var float carryMid    = na
    var bool  carrying    = false
    var int   carryTests  = 0
    bool carryBorn = false

    if sesEnd and carryInput and not na(frozenMid) and not stopCarry
        int anchorBar = math.max(bar_index - 1, 0)
        carryMid    := frozenMid
        carryTests  := 0
        carrying    := true
        carryBorn   := true
        carryLine   := line.new(anchorBar, frozenMid, bar_index, frozenMid, color = sesColor, style = carryLineStyle, width = lineWidthInput)
        carryHiLine := na
        carryLoLine := na
        carryLabel  := na
        if showHlInput
            carryHiLine := line.new(anchorBar, frozenHi, bar_index, frozenHi, color = color.new(sesColor, 55), style = line.style_dotted, width = 1)
            carryLoLine := line.new(anchorBar, frozenLo, bar_index, frozenLo, color = color.new(sesColor, 55), style = line.style_dotted, width = 1)
        if showLabelsInput
            carryLabel := label.new(bar_index, frozenMid, sesName + " HB  " + str.tostring(frozenMid, format.mintick), color = COLOR_NONE, textcolor = sesColor, style = label.style_label_left, size = size.small)
    else if stopCarry
        carrying := false

    //extend the carried level and track fresh tests of it
    bool carryTouch     = false
    bool carryTestEvent = false
    bool carryHoldEvent = false
    if carrying and not na(carryLine)
        line.set_x2(carryLine, bar_index)
        if not na(carryHiLine)
            line.set_x2(carryHiLine, bar_index)
        if not na(carryLoLine)
            line.set_x2(carryLoLine, bar_index)
        carryTouch := high >= carryMid and low <= carryMid
        bool carryWasTouch = na(carryTouch[1]) ? false : carryTouch[1]
        carryTestEvent := carryTouch and not carryWasTouch and not carryBorn
        if carryTestEvent
            carryTests += 1
            carryHoldEvent := (close[1] > carryMid and close > carryMid) or (close[1] < carryMid and close < carryMid)
        if not na(carryLabel)
            label.set_x(carryLabel, bar_index)
            if carryTestEvent
                label.set_text(carryLabel, sesName + " HB  " + str.tostring(carryMid, format.mintick) + "  x" + str.tostring(carryTests))

    //live name/price tag on the developing half-back
    var label liveLabel = na
    if barstate.islast and showLabelsInput and inSession and not na(devMid)
        if na(liveLabel)
            liveLabel := label.new(bar_index, devMid, "", color = COLOR_NONE, textcolor = sesColor, style = label.style_label_left, size = size.small)
        label.set_xy(liveLabel, bar_index, devMid)
        label.set_text(liveLabel, sesName + " HB  " + str.tostring(devMid, format.mintick) + (devTests > 0 ? "  x" + str.tostring(devTests) : ""))
    else if not na(liveLabel)
        label.delete(liveLabel)
        liveLabel := na

    float testedPrice = devTestEvent ? devMid : carryTestEvent ? carryMid : na
    bool  testEvent   = devTestEvent or carryTestEvent
    bool  holdEvent   = devHoldEvent or carryHoldEvent
    [devMid, devHi, devLo, inSession, acceptSide, testEvent, holdEvent, flipUpEvent, flipDnEvent, testedPrice, carrying, carryMid, carryTests, devTests]

//writes one dashboard row: session name, the half-back in play (live while the window runs, carried after it
//closes), the control read against it, and the number of tests the level has absorbed
dashRow(table dashTable, int rowIdx, string sesName, color sesColor, bool inSession, float devMid, int acceptSide, int devTests, bool carrying, float carryMid, int carryTests) =>
    float  shownMid   = inSession ? devMid : carrying ? carryMid : na
    string stateTxt   = inSession ? (acceptSide == 1 ? "Buyers" : acceptSide == -1 ? "Sellers" : "Undecided") : carrying ? (close > carryMid ? "Carried · Above" : close < carryMid ? "Carried · Below" : "Carried · At Level") : "—"
    color  stateCss   = inSession ? (acceptSide == 1 ? bullColorInput : acceptSide == -1 ? bearColorInput : COLOR_GRAY) : carrying ? (close > carryMid ? bullColorInput : close < carryMid ? bearColorInput : COLOR_GRAY) : COLOR_GRAY
    int    shownTests = inSession ? devTests : carrying ? carryTests : na
    table.cell(dashTable, 0, rowIdx, sesName, text_color = sesColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, rowIdx, na(shownMid) ? "—" : str.tostring(shownMid, format.mintick), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 2, rowIdx, stateTxt, text_color = stateCss, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 3, rowIdx, na(shownTests) ? "—" : str.tostring(shownTests), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
var int ses1StartMinutes = sessionStartMinutes(ses1SessionInput)
var int ses2StartMinutes = sessionStartMinutes(ses2SessionInput)
var int ses3StartMinutes = sessionStartMinutes(ses3SessionInput)

[dev1Mid, dev1Hi, dev1Lo, in1Session, acc1Side, test1Evt, hold1Evt, flip1UpEvt, flip1DnEvt, tested1Price, carry1On, carry1Mid, carry1Tests, dev1Tests] = processSession(ses1EnableInput, ses1SessionInput, ses1StartMinutes, ses1NameInput, ses1ColorInput)
[dev2Mid, dev2Hi, dev2Lo, in2Session, acc2Side, test2Evt, hold2Evt, flip2UpEvt, flip2DnEvt, tested2Price, carry2On, carry2Mid, carry2Tests, dev2Tests] = processSession(ses2EnableInput, ses2SessionInput, ses2StartMinutes, ses2NameInput, ses2ColorInput)
[dev3Mid, dev3Hi, dev3Lo, in3Session, acc3Side, test3Evt, hold3Evt, flip3UpEvt, flip3DnEvt, tested3Price, carry3On, carry3Mid, carry3Tests, dev3Tests] = processSession(ses3EnableInput, ses3SessionInput, ses3StartMinutes, ses3NameInput, ses3ColorInput)

bool anyTestEvent   = test1Evt or test2Evt or test3Evt
bool anyHoldEvent   = hold1Evt or hold2Evt or hold3Evt
bool anyFlipUpEvent = flip1UpEvt or flip2UpEvt or flip3UpEvt
bool anyFlipDnEvent = flip1DnEvt or flip2DnEvt or flip3DnEvt

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
color mid1Css = colorModeInput == MODE_CONTROL ? (acc1Side == 1 ? bullColorInput : acc1Side == -1 ? bearColorInput : COLOR_GRAY) : ses1ColorInput
color mid2Css = colorModeInput == MODE_CONTROL ? (acc2Side == 1 ? bullColorInput : acc2Side == -1 ? bearColorInput : COLOR_GRAY) : ses2ColorInput
color mid3Css = colorModeInput == MODE_CONTROL ? (acc3Side == 1 ? bullColorInput : acc3Side == -1 ? bearColorInput : COLOR_GRAY) : ses3ColorInput

plot(dev1Mid, "Session 1 Developing Half-Back", mid1Css, lineWidthInput, plot.style_steplinebr)
plot(dev2Mid, "Session 2 Developing Half-Back", mid2Css, lineWidthInput, plot.style_steplinebr)
plot(dev3Mid, "Session 3 Developing Half-Back", mid3Css, lineWidthInput, plot.style_steplinebr)

plot(showHlInput ? dev1Hi : na, "Session 1 High", color.new(ses1ColorInput, 55), 1, plot.style_steplinebr)
plot(showHlInput ? dev1Lo : na, "Session 1 Low", color.new(ses1ColorInput, 55), 1, plot.style_steplinebr)
plot(showHlInput ? dev2Hi : na, "Session 2 High", color.new(ses2ColorInput, 55), 1, plot.style_steplinebr)
plot(showHlInput ? dev2Lo : na, "Session 2 Low", color.new(ses2ColorInput, 55), 1, plot.style_steplinebr)
plot(showHlInput ? dev3Hi : na, "Session 3 High", color.new(ses3ColorInput, 55), 1, plot.style_steplinebr)
plot(showHlInput ? dev3Lo : na, "Session 3 Low", color.new(ses3ColorInput, 55), 1, plot.style_steplinebr)

plot(markTestsInput ? tested1Price : na, "Session 1 Test Marker", ses1ColorInput, 2, plot.style_circles)
plot(markTestsInput ? tested2Price : na, "Session 2 Test Marker", ses2ColorInput, 2, plot.style_circles)
plot(markTestsInput ? tested3Price : na, "Session 3 Test Marker", ses3ColorInput, 2, plot.style_circles)

plot(carry1On ? carry1Mid : na, "Session 1 Carried Half-Back", ses1ColorInput, 1, display = display.data_window, editable = false)
plot(carry2On ? carry2Mid : na, "Session 2 Carried Half-Back", ses2ColorInput, 1, display = display.data_window, editable = false)
plot(carry3On ? carry3Mid : na, "Session 3 Carried Half-Back", ses3ColorInput, 1, display = display.data_window, editable = false)

bgcolor(showBgInput and in1Session ? color.new(ses1ColorInput, 94) : na, title = "Session 1 Window")
bgcolor(showBgInput and in2Session ? color.new(ses2ColorInput, 94) : na, title = "Session 2 Window")
bgcolor(showBgInput and in3Session ? color.new(ses3ColorInput, 94) : na, title = "Session 3 Window")

//the session windows cannot be resolved on daily and higher charts
if barstate.islast and not timeframe.isintraday
    var table warnTable = table.new(position.top_right, 1, 1, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
    table.cell(warnTable, 0, 0, "Midpoint/half-back of Session requires an intraday chart"
      , text_color = COLOR_BEAR
      , text_size  = size.small)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dash = showDashInput ? table.new(dashPos, 4, 4, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1) : table(na)

if showDashInput and barstate.islast and timeframe.isintraday and not na(dash)
    table.clear(dash, 0, 0, 3, 3)
    color headCss = DASH_HEADER
    table.cell(dash, 0, 0, "Session", text_color = headCss, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dash, 1, 0, "Half-Back", text_color = headCss, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dash, 2, 0, "Control", text_color = headCss, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dash, 3, 0, "Tests", text_color = headCss, text_size = dashTextSize, text_halign = text.align_right)
    int rowIdx = 1
    if ses1EnableInput
        dashRow(dash, rowIdx, ses1NameInput, ses1ColorInput, in1Session, dev1Mid, acc1Side, dev1Tests, carry1On, carry1Mid, carry1Tests)
        rowIdx += 1
    if ses2EnableInput
        dashRow(dash, rowIdx, ses2NameInput, ses2ColorInput, in2Session, dev2Mid, acc2Side, dev2Tests, carry2On, carry2Mid, carry2Tests)
        rowIdx += 1
    if ses3EnableInput
        dashRow(dash, rowIdx, ses3NameInput, ses3ColorInput, in3Session, dev3Mid, acc3Side, dev3Tests, carry3On, carry3Mid, carry3Tests)
        rowIdx += 1

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(anyTestEvent, "Half-Back Tested", "Price pulled back into a session half-back on {{ticker}} - watch how it trades against the level: closing and holding on one side keeps that side in control of the range")
alertcondition(anyHoldEvent, "Half-Back Test Held", "A session half-back was tested and held on {{ticker}} - price came into the level and closed back on the controlling side, a responsive rejection at the midpoint of the range")
alertcondition(anyFlipUpEvent, "Acceptance Flipped Above Half-Back", "Consecutive closes moved above a session half-back on {{ticker}} after holding below it - buyers took the upper half of the range, favoring rotation toward the session high")
alertcondition(anyFlipDnEvent, "Acceptance Flipped Below Half-Back", "Consecutive closes moved below a session half-back on {{ticker}} after holding above it - sellers took the lower half of the range, favoring rotation toward the session low")

//---------------------------------------------------------------------------------------------------------------------}
