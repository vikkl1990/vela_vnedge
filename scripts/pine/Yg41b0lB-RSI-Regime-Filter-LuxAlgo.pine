//@version=6
indicator("RSI Regime Filter", shorttitle="RSI Regime Filter", overlay=false, max_boxes_count=300, max_labels_count=500, max_lines_count=100)

// --- Constants ---
color BULL_COLOR = #089981
color BEAR_COLOR = #f23645
color NEUTRAL_COLOR = #5b9cf6
string REGIME_RSI = "RSI 50 level"
string REGIME_EMA = "EMA trend"
string REGIME_ADX = "ADX direction"
string REGIME_COMPOSITE = "Composite vote"

// --- Inputs ---
groupRsi = "RSI"
rsiLengthInput = input.int(14, "RSI length", minval=2, group=groupRsi, tooltip="Number of bars used to calculate RSI.")
overboughtInput = input.float(70.0, "Overbought level", minval=50.0, maxval=100.0, group=groupRsi, tooltip="RSI level that defines the overbought zone.")
oversoldInput = input.float(30.0, "Oversold level", minval=0.0, maxval=50.0, group=groupRsi, tooltip="RSI level that defines the oversold zone.")
showZoneBackgroundInput = input.bool(true, "Shade RSI zones", group=groupRsi, tooltip="Shades the RSI pane while RSI is overbought or oversold.")

groupDivergence = "Divergences"
pivotLeftInput = input.int(5, "Pivot left bars", minval=1, maxval=25, group=groupDivergence, tooltip="Bars to the left required to confirm a pivot.")
pivotRightInput = input.int(5, "Pivot right bars", minval=1, maxval=25, group=groupDivergence, tooltip="Bars to the right required to confirm a pivot. Signals appear after this confirmation delay.")
requireExtremeInput = input.bool(false, "Require RSI extreme", group=groupDivergence, tooltip="Only accept bullish divergences from oversold RSI and bearish divergences from overbought RSI.")
showDivergenceBoxesInput = input.bool(true, "Show divergence boxes", group=groupDivergence, tooltip="Draws dashed boxes with a translucent background around the two candles used by each divergence.")

groupTrend = "Trend changes"
showTrendColorsInput = input.bool(true, "Color candles by trend strength", group=groupTrend, tooltip="Colors candles according to the distance of RSI from the 50 level.")
showTrendMarkersInput = input.bool(true, "Show 50-level markers", group=groupTrend, tooltip="Plots a marker in the RSI pane when RSI crosses the 50 level.")

groupBubbles = "Volume bubbles"
showBubblesInput = input.bool(true, "Show OB/OS bubbles", group=groupBubbles, tooltip="Plots a bubble on the chart when RSI enters an overbought or oversold zone.")
volumeLengthInput = input.int(20, "Volume average length", minval=1, group=groupBubbles, tooltip="Lookback used to compare the entry candle volume with typical volume.")

groupRegime = "Market regimes"
regimeMethodInput = input.string(REGIME_ADX, "Regime method", options=[REGIME_RSI, REGIME_EMA, REGIME_ADX, REGIME_COMPOSITE], group=groupRegime, tooltip="Selects the method used to classify the market as bullish, bearish, or neutral.")
regimeEmaLengthInput = input.int(50, "EMA length", minval=2, group=groupRegime, tooltip="EMA length used by the EMA and Composite regime methods.")
dmiLengthInput = input.int(14, "DMI length", minval=2, group=groupRegime, tooltip="Directional movement length used by the ADX and Composite methods.")
adxSmoothingInput = input.int(14, "ADX smoothing", minval=2, group=groupRegime, tooltip="Smoothing length used to calculate ADX.")
adxThresholdInput = input.float(20.0, "ADX trend threshold", minval=1.0, group=groupRegime, tooltip="ADX must be at or above this value for the ADX method to declare a directional regime.")
rsiRegimeFilterInput = input.bool(false, "RSI Regime Filter", group=groupRegime, tooltip="When enabled, RSI divergences and overbought or oversold entries are detected only while the selected regime method identifies a neutral or ranging market.")
showRegimeBackgroundInput = input.bool(true, "Color chart by regime", group=groupRegime, tooltip="Colors the main chart background according to the active market regime.")

groupStyle = "Style"
bullColorInput = input.color(BULL_COLOR, "Bullish color", group=groupStyle, tooltip="Primary color for bullish RSI, trend, and divergence visuals.")
bearColorInput = input.color(BEAR_COLOR, "Bearish color", group=groupStyle, tooltip="Primary color for bearish RSI, trend, and divergence visuals.")
neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral color", group=groupStyle, tooltip="Color used for neutral regimes and neutral RSI references.")

// --- Regime helper ---
calculateRegime() =>
    emaValue = ta.ema(close, regimeEmaLengthInput)
    [plusValue, minusValue, adxValue] = ta.dmi(dmiLengthInput, adxSmoothingInput)
    rsiValue = ta.rsi(close, rsiLengthInput)
    rsiState = na(rsiValue) ? 0 : rsiValue >= 50.0 ? 1 : -1
    emaState = close > emaValue and emaValue > emaValue[1] ? 1 : close < emaValue and emaValue < emaValue[1] ? -1 : 0
    adxState = adxValue >= adxThresholdInput ? plusValue > minusValue ? 1 : minusValue > plusValue ? -1 : 0 : 0
    voteScore = rsiState + (close >= emaValue ? 1 : -1) + (plusValue >= minusValue ? 1 : -1)
    voteState = voteScore >= 2 ? 1 : voteScore <= -2 ? -1 : 0
    regimeMethodInput == REGIME_RSI ? rsiState : regimeMethodInput == REGIME_EMA ? emaState : regimeMethodInput == REGIME_ADX ? adxState : voteState

// --- Core calculations ---
rsi = ta.rsi(close, rsiLengthInput)
rsiColor = color.from_gradient(rsi, 0.0, 100.0, bearColorInput, bullColorInput)
trendStrength = math.min(math.abs(rsi - 50.0) / 50.0, 1.0)
trendState = na(rsi) ? 0 : rsi >= 50.0 ? 1 : -1
trendCandleColor = trendState > 0 ? color.from_gradient(trendStrength, 0.0, 1.0, color.new(bullColorInput, 72), bullColorInput) : trendState < 0 ? color.from_gradient(trendStrength, 0.0, 1.0, color.new(bearColorInput, 72), bearColorInput) : na
trendChangeUp = ta.crossover(rsi, 50.0)
trendChangeDown = ta.crossunder(rsi, 50.0)
regimeFilter = calculateRegime()

// --- RSI pane ---
rsiPlot = plot(rsi, "RSI", color=rsiColor, linewidth=1)
centerPlot = plot(50.0, "50 level", color=color.new(neutralColorInput, 45), linewidth=1)
upperLine = hline(100.0, "RSI ceiling", color=color.new(chart.fg_color, 100))
lowerLine = hline(0.0, "RSI floor", color=color.new(chart.fg_color, 100))
overboughtLine = hline(overboughtInput, "Overbought", color=color.new(bearColorInput, 25), linestyle=hline.style_dashed)
oversoldLine = hline(oversoldInput, "Oversold", color=color.new(bullColorInput, 25), linestyle=hline.style_dashed)
centerLine = hline(50.0, "Center", color=color.new(neutralColorInput, 70), linestyle=hline.style_dotted)

fill(centerPlot, rsiPlot, rsi >= 50.0 ? color.new(bullColorInput, 72) : color.new(bearColorInput, 72), title="RSI directional gradient")
fill(overboughtLine, upperLine, color.new(bearColorInput, 90), title="Overbought gradient zone")
fill(lowerLine, oversoldLine, color.new(bullColorInput, 90), title="Oversold gradient zone")
bgcolor(showZoneBackgroundInput ? rsi > overboughtInput ? color.new(bearColorInput, 93) : rsi < oversoldInput ? color.new(bullColorInput, 93) : na : na, title="RSI zone background")
plot(showTrendMarkersInput and trendChangeUp ? 50.0 : na, "Bullish 50 break", color=bullColorInput, style=plot.style_circles, linewidth=5)
plot(showTrendMarkersInput and trendChangeDown ? 50.0 : na, "Bearish 50 break", color=bearColorInput, style=plot.style_circles, linewidth=5)

// --- Divergence detection ---
pivotLowPrice = ta.pivotlow(low, pivotLeftInput, pivotRightInput)
pivotHighPrice = ta.pivothigh(high, pivotLeftInput, pivotRightInput)
var float previousLowPrice = na
var float previousLowRsi = na
var float previousLowHigh = na
var float previousLowLow = na
var int previousLowBar = na
var int previousLowRegime = na
var float previousHighPrice = na
var float previousHighRsi = na
var float previousHighHigh = na
var float previousHighLow = na
var int previousHighBar = na
var int previousHighRegime = na

bool bullishDivergence = false
bool bearishDivergence = false

if barstate.isconfirmed and not na(pivotLowPrice)
    currentLowBar = bar_index - pivotRightInput
    currentLowRsi = rsi[pivotRightInput]
    currentLowRegime = regimeFilter[pivotRightInput]
    bullishDivergence := not na(previousLowPrice) and pivotLowPrice < previousLowPrice and currentLowRsi > previousLowRsi and (not requireExtremeInput or currentLowRsi < oversoldInput) and (not rsiRegimeFilterInput or (previousLowRegime == 0 and currentLowRegime == 0))
    if bullishDivergence
        line.new(x1=previousLowBar, y1=previousLowPrice, x2=currentLowBar, y2=pivotLowPrice, xloc=xloc.bar_index, color=bullColorInput, width=2, force_overlay=true)
        line.new(x1=previousLowBar, y1=previousLowRsi, x2=currentLowBar, y2=currentLowRsi, xloc=xloc.bar_index, color=bullColorInput, width=2)
        if showDivergenceBoxesInput
            box.new(left=previousLowBar - 1, top=math.max(previousLowHigh, high[pivotRightInput]), right=currentLowBar + 1, bottom=math.min(previousLowLow, low[pivotRightInput]), xloc=xloc.bar_index, border_color=bullColorInput, border_width=1, border_style=line.style_dashed, bgcolor=color.new(bullColorInput, 88), force_overlay=true)
    previousLowPrice := pivotLowPrice
    previousLowRsi := currentLowRsi
    previousLowHigh := high[pivotRightInput]
    previousLowLow := low[pivotRightInput]
    previousLowBar := currentLowBar
    previousLowRegime := currentLowRegime

if barstate.isconfirmed and not na(pivotHighPrice)
    currentHighBar = bar_index - pivotRightInput
    currentHighRsi = rsi[pivotRightInput]
    currentHighRegime = regimeFilter[pivotRightInput]
    bearishDivergence := not na(previousHighPrice) and pivotHighPrice > previousHighPrice and currentHighRsi < previousHighRsi and (not requireExtremeInput or currentHighRsi > overboughtInput) and (not rsiRegimeFilterInput or (previousHighRegime == 0 and currentHighRegime == 0))
    if bearishDivergence
        line.new(x1=previousHighBar, y1=previousHighPrice, x2=currentHighBar, y2=pivotHighPrice, xloc=xloc.bar_index, color=bearColorInput, width=2, force_overlay=true)
        line.new(x1=previousHighBar, y1=previousHighRsi, x2=currentHighBar, y2=currentHighRsi, xloc=xloc.bar_index, color=bearColorInput, width=2)
        if showDivergenceBoxesInput
            box.new(left=previousHighBar - 1, top=math.max(previousHighHigh, high[pivotRightInput]), right=currentHighBar + 1, bottom=math.min(previousHighLow, low[pivotRightInput]), xloc=xloc.bar_index, border_color=bearColorInput, border_width=1, border_style=line.style_dashed, bgcolor=color.new(bearColorInput, 88), force_overlay=true)
    previousHighPrice := pivotHighPrice
    previousHighRsi := currentHighRsi
    previousHighHigh := high[pivotRightInput]
    previousHighLow := low[pivotRightInput]
    previousHighBar := currentHighBar
    previousHighRegime := currentHighRegime

// --- Volume-sized overbought and oversold bubbles ---
volumeAvailable = not na(volume) and volume > 0
safeVolume = nz(volume, 0.0)
volumeAverage = ta.sma(safeVolume, volumeLengthInput)
volumeRatio = safeVolume / math.max(nz(volumeAverage, safeVolume), 1.0)
bubbleSize = not volumeAvailable ? size.small : volumeRatio >= 1.75 ? size.large : volumeRatio >= 1.15 ? size.normal : size.small
atr = ta.atr(14)
obEntry = ta.crossover(rsi, overboughtInput) and (not rsiRegimeFilterInput or regimeFilter == 0)
osEntry = ta.crossunder(rsi, oversoldInput) and (not rsiRegimeFilterInput or regimeFilter == 0)
if showBubblesInput and obEntry
    label.new(bar_index, high + nz(atr, high * 0.01) * 0.35, "", yloc=yloc.price, style=label.style_circle, color=color.new(bearColorInput, 78), textcolor=chart.fg_color, size=bubbleSize, tooltip="Overbought entry\nVolume ratio: " + str.tostring(volumeRatio, "#.##"), force_overlay=true)
if showBubblesInput and osEntry
    label.new(bar_index, low - nz(atr, high * 0.01) * 0.35, "", yloc=yloc.price, style=label.style_circle, color=color.new(bullColorInput, 78), textcolor=chart.fg_color, size=bubbleSize, tooltip="Oversold entry\nVolume ratio: " + str.tostring(volumeRatio, "#.##"), force_overlay=true)

// --- Trend candle coloring ---
barcolor(showTrendColorsInput ? trendCandleColor : na, title="RSI trend strength")

// --- Market regime engine ---
regimeEma = ta.ema(close, regimeEmaLengthInput)
[diPlus, diMinus, adx] = ta.dmi(dmiLengthInput, adxSmoothingInput)
rsiRegime = na(rsi) ? 0 : rsi >= 50.0 ? 1 : -1
emaRegime = close > regimeEma and regimeEma > regimeEma[1] ? 1 : close < regimeEma and regimeEma < regimeEma[1] ? -1 : 0
adxRegime = adx >= adxThresholdInput ? diPlus > diMinus ? 1 : diMinus > diPlus ? -1 : 0 : 0
compositeScore = rsiRegime + (close >= regimeEma ? 1 : -1) + (diPlus >= diMinus ? 1 : -1)
compositeRegime = compositeScore >= 2 ? 1 : compositeScore <= -2 ? -1 : 0
regime = regimeMethodInput == REGIME_RSI ? rsiRegime : regimeMethodInput == REGIME_EMA ? emaRegime : regimeMethodInput == REGIME_ADX ? adxRegime : compositeRegime
regimeName = regime > 0 ? "BULLISH REGIME" : regime < 0 ? "BEARISH REGIME" : "NEUTRAL REGIME"
regimeColor = regime > 0 ? bullColorInput : regime < 0 ? bearColorInput : neutralColorInput
bgcolor(showRegimeBackgroundInput ? color.new(regimeColor, 92) : na, title="Market regime background", force_overlay=true)

var table regimeDashboard = table.new(position.top_right, 2, 6, bgcolor=color.new(chart.bg_color, 100), frame_color=color.new(chart.fg_color, 70), frame_width=1, border_color=color.new(chart.fg_color, 85), border_width=1, force_overlay=true)
if barstate.islast
    table.cell(regimeDashboard, 0, 0, "REGIME DASHBOARD", text_color=chart.fg_color, text_size=size.small, bgcolor=color.new(regimeColor, 65))
    table.cell(regimeDashboard, 1, 0, "", text_color=chart.fg_color, text_size=size.small, bgcolor=color.new(regimeColor, 65))
    table.cell(regimeDashboard, 0, 1, "Regime", text_color=chart.fg_color, text_size=size.small)
    table.cell(regimeDashboard, 1, 1, regimeName, text_color=regimeColor, text_size=size.small)
    table.cell(regimeDashboard, 0, 2, "Method", text_color=chart.fg_color, text_size=size.small)
    table.cell(regimeDashboard, 1, 2, regimeMethodInput, text_color=chart.fg_color, text_size=size.small)
    table.cell(regimeDashboard, 0, 3, "RSI", text_color=chart.fg_color, text_size=size.small)
    table.cell(regimeDashboard, 1, 3, str.tostring(rsi, "#.##"), text_color=rsiColor, text_size=size.small)
    table.cell(regimeDashboard, 0, 4, "ADX", text_color=chart.fg_color, text_size=size.small)
    table.cell(regimeDashboard, 1, 4, str.tostring(adx, "#.##"), text_color=adx >= adxThresholdInput ? regimeColor : neutralColorInput, text_size=size.small)
    table.cell(regimeDashboard, 0, 5, "EMA", text_color=chart.fg_color, text_size=size.small)
    table.cell(regimeDashboard, 1, 5, close > regimeEma ? "Above" : "Below", text_color=close > regimeEma ? bullColorInput : bearColorInput, text_size=size.small)

// --- Alerts ---
alertcondition(bullishDivergence, "Bullish RSI divergence", "Bullish RSI divergence confirmed on {{ticker}} {{interval}}")
alertcondition(bearishDivergence, "Bearish RSI divergence", "Bearish RSI divergence confirmed on {{ticker}} {{interval}}")
alertcondition(trendChangeUp, "RSI bullish trend change", "RSI crossed above 50 on {{ticker}} {{interval}}")
alertcondition(trendChangeDown, "RSI bearish trend change", "RSI crossed below 50 on {{ticker}} {{interval}}")
alertcondition(obEntry, "RSI entered overbought", "RSI entered overbought on {{ticker}} {{interval}}")
alertcondition(osEntry, "RSI entered oversold", "RSI entered oversold on {{ticker}} {{interval}}")
