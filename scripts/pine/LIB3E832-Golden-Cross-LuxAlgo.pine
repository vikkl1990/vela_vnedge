//@version=6
indicator("Golden Cross", shorttitle = "Golden Cross", overlay = true, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
CAUTION_COLOR = #ff9800   // the one accent - a golden cross printing against a falling slow MA
INVALID_COLOR = #f23645
FAST_COLOR    = #f23645   // fast MA while it runs below the slow MA - the death-cross side of the pair
NEUTRAL_COLOR = #787b86
HIDDEN_COLOR  = #00000000

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

MA_GROUP    = 'Moving Averages'
CTX_GROUP   = 'Cross Context'
DASH_GROUP  = 'Dashboard'
STYLE_GROUP = 'Style'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
fastLenInput = input.int(50, 'Fast Length', minval = 1, group = MA_GROUP, tooltip = 'Length of the shorter moving average. The classic golden cross uses the 50-period average on the daily chart.')

slowLenInput = input.int(200, 'Slow Length', minval = 1, group = MA_GROUP, tooltip = 'Length of the longer moving average that defines the long-term base. The classic golden cross uses the 200-period average on the daily chart.')

maTypeInput = input.string('SMA', 'MA Type', options = ['SMA', 'EMA'], group = MA_GROUP, tooltip = 'Average family applied to both lengths. The canonical golden cross uses simple averages; exponential averages weight recent bars more and can shift cross dates by days.')

srcInput = input.source(close, 'Source', group = MA_GROUP, tooltip = 'Price source used to compute both moving averages.')

slopeLookbackInput = input.int(20, 'Slow MA Slope Lookback', minval = 1, group = CTX_GROUP, tooltip = 'Bars used to measure the slow MA slope. A slow MA that has flattened or turned up at the cross makes it a cleaner regime statement than one that is still falling.')

whipsawWindowInput = input.int(20, 'Whipsaw Window', minval = 1, group = CTX_GROUP, tooltip = 'A cross back below the slow MA within this many bars of a golden cross is flagged as a whipsaw — the failure mode most common when the averages braid through a sideways market.')

showDashInput = input.bool(true, 'Show Dashboard', group = DASH_GROUP, tooltip = 'Summarizes the moving average pair, the current regime, the slow MA slope, the separation between the averages, and the context recorded at the last golden cross.')

dashPosInput = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = DASH_GROUP, tooltip = 'Chart corner where the dashboard is anchored.')

dashSizeInput = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal'], group = DASH_GROUP, tooltip = 'Dashboard text size.')

showCrossInput = input.bool(true, 'Golden Cross Markers', group = STYLE_GROUP, tooltip = 'Mark each golden cross with a point at the crossing and a label below the bar. The label tooltip reports the slow MA slope at the cross and the advance from the preceding regime low.')

showInvInput = input.bool(true, 'Invalidation Marks', group = STYLE_GROUP, tooltip = 'Mark the bar where the fast MA crosses back below the slow MA, ending the standing golden cross. An immediate re-cross is the whipsaw failure mode.')

showFillInput = input.bool(true, 'Regime Fill', group = STYLE_GROUP, tooltip = 'Shade the area between the averages — bullish while a golden cross is standing, neutral while it is not.')

fastColorInput = input.color(FAST_COLOR, 'Fast MA', group = STYLE_GROUP, inline = 'ma', tooltip = 'Fast moving average color while it runs below the slow MA; the line takes the bullish color while a golden cross is standing.')
slowColorInput = input.color(NEUTRAL_COLOR, 'Slow MA', group = STYLE_GROUP, inline = 'ma', tooltip = 'Slow moving average color, also used for the neutral regime shading.')

bullColorInput = input.color(BULL_COLOR, 'Bullish', group = STYLE_GROUP, inline = 'sig', tooltip = 'Color for golden crosses printing with a flat or rising slow MA, for the standing-cross regime shading, and for bullish dashboard readings.')
cautionColorInput = input.color(CAUTION_COLOR, 'Caution', group = STYLE_GROUP, inline = 'sig', tooltip = 'Color for golden crosses printing while the slow MA is still falling — a weaker regime statement.')

invColorInput = input.color(INVALID_COLOR, 'Invalidation', group = STYLE_GROUP, tooltip = 'Color of the marks where the fast MA crosses back below the slow MA.')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
fmtSignedPct(value) =>
    (value >= 0 ? '+' : '') + str.tostring(value, '#.##') + '%'

//---------------------------------------------------------------------------------------------------------------------}
// Cross Detection
//---------------------------------------------------------------------------------------------------------------------{
fastSma = ta.sma(srcInput, fastLenInput)
fastEma = ta.ema(srcInput, fastLenInput)
slowSma = ta.sma(srcInput, slowLenInput)
slowEma = ta.ema(srcInput, slowLenInput)

fastMa = maTypeInput == 'EMA' ? fastEma : fastSma
slowMa = maTypeInput == 'EMA' ? slowEma : slowSma

bothValid = not na(fastMa) and not na(slowMa)

goldenCross  = ta.crossover(fastMa, slowMa)
invalidation = ta.crossunder(fastMa, slowMa)
goldenState  = bothValid and fastMa > slowMa

gcAge   = ta.barssince(goldenCross)
whipsaw = invalidation and not na(gcAge) and gcAge <= whipsawWindowInput

//---------------------------------------------------------------------------------------------------------------------}
// Cross Context
//---------------------------------------------------------------------------------------------------------------------{
// Slow MA slope — grades how clean a regime statement the cross is
prevSlow    = slowMa[slopeLookbackInput]
slopeKnown  = bothValid and not na(prevSlow)
slowRising  = slopeKnown and slowMa > prevSlow
slowFalling = slopeKnown and slowMa < prevSlow
slopePct    = slopeKnown and prevSlow != 0 ? (slowMa - prevSlow) / prevSlow * 100 : na

// Separation between the averages — distance/momentum of the standing regime
sepPct   = bothValid and slowMa != 0 ? (fastMa - slowMa) / slowMa * 100 : na
sepKnown = not na(sepPct) and not na(sepPct[1])
widening = sepKnown and sepPct > sepPct[1]

crossClean = goldenCross and slopeKnown and not slowFalling

// Advance already consumed before the cross — run from the low of the preceding below-regime
var float regimeLow      = na
var float advanceAtCross = na
var int   lastCrossBar   = na
var int   lastCrossGrade = -1     // 2: slow MA rising · 1: flat · 0: falling · -1: unknown
var bool  lastCrossWhip  = false

if invalidation
    regimeLow := low
    if whipsaw
        lastCrossWhip := true
else if bothValid and fastMa <= slowMa
    regimeLow := math.min(nz(regimeLow, low), low)

if goldenCross
    advanceAtCross := not na(regimeLow) and regimeLow > 0 ? (close - regimeLow) / regimeLow * 100 : na
    lastCrossBar   := bar_index
    lastCrossGrade := slopeKnown ? (slowFalling ? 0 : slowRising ? 2 : 1) : -1
    lastCrossWhip  := false

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
crossGradeColor = slowFalling ? cautionColorInput : bullColorInput

fastPlotId = plot(fastMa, 'Fast MA', goldenState ? bullColorInput : fastColorInput, 1)
slowPlotId = plot(slowMa, 'Slow MA', slowColorInput, 2)

// Regime fill — gradient anchored at the fast MA, fading toward the slow MA
fastOnTop  = bothValid and fastMa >= slowMa
stateColor = goldenState ? bullColorInput : slowColorInput
nearColor  = color.new(stateColor, goldenState ? 65 : 88)
farColor   = color.new(stateColor, 100)

fillTopColor    = showFillInput ? (fastOnTop ? nearColor : farColor) : na
fillBottomColor = showFillInput ? (fastOnTop ? farColor : nearColor) : na

fill(fastPlotId, slowPlotId, top_value = math.max(fastMa, slowMa), bottom_value = math.min(fastMa, slowMa), top_color = fillTopColor, bottom_color = fillBottomColor, title = 'Regime Fill')

// Golden cross markers — the event itself
crossPoint = showCrossInput and goldenCross ? math.avg(fastMa, slowMa) : na
plot(crossPoint, 'Golden Cross Point', crossGradeColor, 3, plot.style_circles)

if goldenCross and showCrossInput
    slopeTxt = slopeKnown ? (slowFalling ? 'falling' : slowRising ? 'rising' : 'flat') : 'n/a'
    advTxt   = na(advanceAtCross) ? 'n/a' : fmtSignedPct(advanceAtCross)
    tipTxt   = str.format('Slow MA {0} at the cross\nAdvance from the regime low: {1}', slopeTxt, advTxt)
    label.new(bar_index, low, 'Golden Cross', yloc = yloc.belowbar, style = label.style_label_up, color = HIDDEN_COLOR, textcolor = crossGradeColor, size = size.small, tooltip = tipTxt)

// Invalidation marks — the re-cross downward that ends the standing golden cross
invPoint = showInvInput and invalidation ? math.avg(fastMa, slowMa) : na
plotshape(invPoint, 'Invalidation Mark', shape.xcross, location.absolute, invColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
dashPos = switch dashPosInput
    'Top Right'    => position.top_right
    'Top Left'     => position.top_left
    'Bottom Right' => position.bottom_right
    => position.bottom_left

dashTxtSize = switch dashSizeInput
    'Tiny'  => size.tiny
    'Small' => size.small
    => size.normal

var table dashTable = na

if showDashInput and barstate.islast
    if na(dashTable)
        dashTable := table.new(dashPos, 2, 6, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

    labelColor = DASH_HEADER
    fadedColor = DASH_HEADER

    classicSetup = fastLenInput == 50 and slowLenInput == 200 and maTypeInput == 'SMA' and timeframe.isdaily and timeframe.multiplier == 1
    pairTxt      = maTypeInput + ' ' + str.tostring(fastLenInput) + '/' + str.tostring(slowLenInput) + (classicSetup ? '' : ' · nonstandard')

    regimeTxt   = goldenState ? 'Golden Cross' + (na(gcAge) ? '' : ' · ' + str.tostring(gcAge) + ' bars') : 'No Golden Cross'
    regimeColor = goldenState ? bullColorInput : fadedColor

    slopeDashTxt = not slopeKnown ? '—' : (slowRising ? 'Rising' : slowFalling ? 'Falling' : 'Flat') + (na(slopePct) ? '' : ' ' + fmtSignedPct(slopePct))
    slopeColor   = slowRising ? bullColorInput : slowFalling ? cautionColorInput : DASH_TEXT

    sepTxt   = na(sepPct) ? '—' : fmtSignedPct(sepPct) + (sepKnown ? (widening ? ' · widening' : ' · narrowing') : '')
    sepColor = goldenState ? bullColorInput : DASH_TEXT

    lastTxt   = na(lastCrossBar) ? 'None' : str.tostring(bar_index - lastCrossBar) + ' bars ago' + (lastCrossWhip ? ' · whipsawed' : lastCrossGrade == 2 ? ' · slow MA rising' : lastCrossGrade == 1 ? ' · slow MA flat' : lastCrossGrade == 0 ? ' · slow MA falling' : '')
    lastColor = na(lastCrossBar) ? fadedColor : lastCrossWhip ? invColorInput : lastCrossGrade == 0 ? cautionColorInput : bullColorInput

    advDashTxt = na(advanceAtCross) ? '—' : fmtSignedPct(advanceAtCross)

    table.cell(dashTable, 0, 0, 'Pair',             text_color = labelColor,     text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, pairTxt,            text_color = DASH_TEXT, text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 1, 'Regime',           text_color = labelColor,     text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, regimeTxt,          text_color = regimeColor,    text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, 'Slow MA Slope',    text_color = labelColor,     text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, slopeDashTxt,       text_color = slopeColor,     text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 3, 'Separation',       text_color = labelColor,     text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, sepTxt,             text_color = sepColor,       text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 4, 'Last Cross',       text_color = labelColor,     text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 4, lastTxt,            text_color = lastColor,      text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 5, 'Advance at Cross', text_color = labelColor,     text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 5, advDashTxt,         text_color = DASH_TEXT, text_size = dashTxtSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(goldenCross, 'Golden Cross', 'Golden cross on {{ticker}} ({{interval}}) — the fast MA closed above the slow MA, long-term regime turning up')

alertcondition(crossClean, 'Clean Golden Cross', 'Golden cross on {{ticker}} ({{interval}}) with the slow MA flat or rising — a cleaner regime statement')

alertcondition(invalidation, 'Golden Cross Invalidated', 'Fast MA crossed back below the slow MA on {{ticker}} ({{interval}}) — the standing golden cross has ended')

alertcondition(whipsaw, 'Golden Cross Whipsaw', 'Golden cross on {{ticker}} ({{interval}}) reversed back below the slow MA within the whipsaw window — whipsaw failure mode')

//---------------------------------------------------------------------------------------------------------------------}
