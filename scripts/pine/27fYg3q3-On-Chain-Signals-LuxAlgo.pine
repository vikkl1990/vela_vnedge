//@version=6
indicator('On-Chain Signals [LuxAlgo]','LuxAlgo - On-Chain Signals', max_bars_back = 5000)
//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
GREEN                   = #089981
RED                     = #F23645
SILVER                  = color.silver
BLUE                    = color.aqua

BULLISH                 = 'BULLISH'
BEARISH                 = 'BEARISH'
NEUTRAL                 = 'NEUTRAL'

GAUGE                   = 'Gauge'
PLOTS                   = 'Historical Data'
AVERAGE                 = 'Average'

SMA                     = 'SMA'
EMA                     = 'EMA'
TMA                     = 'TMA'

TOP_RIGHT               = 'Top Right'
BOTTOM_RIGHT            = 'Bottom Right'
BOTTOM_LEFT             = 'Bottom Left'

TINY                    = 'Tiny'
SMALL                   = 'Small'
NORMAL                  = 'Normal'
LARGE                   = 'Large'
HUGE                    = 'Huge'

THRESHOLDS_GROUP        = 'Thresholds'
DASHBOARD_GROUP         = 'Dashboard'
GAUGE_GROUP             = 'Gauge'
STYLE_GROUP             = 'Style'

EM_SPACE                = ' ' 
EN_SPACE                = ' ' 
FOUR_PER_EM_SPACE       = ' '
SIX_PER_EM_SPACE        = ' ' 
HAIR_SPACE              = ' '

averageSpacing          = EM_SPACE+EM_SPACE+EM_SPACE+SIX_PER_EM_SPACE
inTheMoneySpacing       = EM_SPACE+EM_SPACE+EM_SPACE+FOUR_PER_EM_SPACE+HAIR_SPACE
concentrationSpacing    = EM_SPACE+EM_SPACE+EN_SPACE+FOUR_PER_EM_SPACE+HAIR_SPACE
transactionsSpacing     = EM_SPACE+EM_SPACE+EM_SPACE+FOUR_PER_EM_SPACE+FOUR_PER_EM_SPACE
itmStyleSpacing         = EM_SPACE+EM_SPACE+EM_SPACE+FOUR_PER_EM_SPACE
conStyleSpacing         = EM_SPACE+EM_SPACE+EN_SPACE+FOUR_PER_EM_SPACE+HAIR_SPACE
ltxStyleSpacing         = EM_SPACE+FOUR_PER_EM_SPACE+HAIR_SPACE

displayModeInput                        = input.string( GAUGE,  'Display Mode',             options = [GAUGE,PLOTS,AVERAGE])
averageMethodInput                      = input.string( TMA,    'Average'+averageSpacing,   options = [SMA,EMA,TMA], inline = 'average')
averageLengthInput                      = input.int(    20,     '',                         inline = 'average')

netNetworkGrowthBullishThresholdInput   = input.float(+1.0,'Net Network Growth',                group = THRESHOLDS_GROUP, inline = 'network')
netNetworkGrowthBearishThresholdInput   = input.float(-1.0,'',                                  group = THRESHOLDS_GROUP, inline = 'network')
inTheMoneyBullishThresholdInput         = input.float(+0.1,'In The Money'+inTheMoneySpacing,    group = THRESHOLDS_GROUP, inline = 'itm')
inTheMoneyBearishThresholdInput         = input.float(-0.1,'',                                  group = THRESHOLDS_GROUP, inline = 'itm')
concentrationBullishThresholdInput      = input.float(+0.1,'Concentration'+concentrationSpacing,group = THRESHOLDS_GROUP, inline = 'concentration')
concentrationBearishThresholdInput      = input.float(-0.1,'',                                  group = THRESHOLDS_GROUP, inline = 'concentration')
transactionsBullishThresholdInput       = input.float(+0.1,'Transactions'+transactionsSpacing,  group = THRESHOLDS_GROUP, inline = 'transactions')
transactionsBearishThresholdInput       = input.float(-0.1,'',                                  group = THRESHOLDS_GROUP, inline = 'transactions')

dashboardInput                          = input.bool(   true,       'Dashboard',    group=DASHBOARD_GROUP)
dashboardPositionInput                  = input.string( TOP_RIGHT,  'Position',     group=DASHBOARD_GROUP, options = [TOP_RIGHT,BOTTOM_RIGHT,BOTTOM_LEFT])
dashboardSizeInput                      = input.string( NORMAL,     'Size',         group=DASHBOARD_GROUP, options = [TINY,SMALL,NORMAL,LARGE,HUGE])

scaleInput                              = input.float(  50,         'Scale',        group = GAUGE_GROUP, inline = 'gauge', step = 1, minval = 10, maxval = 100) / 100
curvedInput                             = input.bool(   false,      'Curved',       group = GAUGE_GROUP, inline = 'gauge')
bearishGaugeColorInput                  = input.color(  RED,        'Bearish',      group = GAUGE_GROUP)
neutralhGaugeColorInput                 = input.color(  SILVER,     'Neutral',      group = GAUGE_GROUP)
bullishGaugeColorInput                  = input.color(  GREEN,      'Bullish',      group = GAUGE_GROUP)

netNetworkGrowthInput                   = input.bool(   true,                         'Net Network Growth', group = STYLE_GROUP, inline = 'nng')
netNetworkGrowthColorInput              = input.color(color.new(color.orange,50),   '',                   group = STYLE_GROUP, inline = 'nng')
inTheMoneyInput                         = input.bool(   true,                         'In The Money',       group = STYLE_GROUP, inline = 'itm')
inTheMoneyColorInput                    = input.color(color.new(color.olive,50),    itmStyleSpacing,      group = STYLE_GROUP, inline = 'itm')
concentrationInput                      = input.bool(   true,                         'Concentration',      group = STYLE_GROUP, inline = 'con')
concentrationColorInput                 = input.color(color.new(color.maroon,50),   conStyleSpacing,      group = STYLE_GROUP, inline = 'con')
largeTransacionsInput                   = input.bool(   true,                         'Large Transacions',  group = STYLE_GROUP, inline = 'ltx')
largeTransacionsColorInput              = input.color(color.new(color.purple,50),   ltxStyleSpacing,      group = STYLE_GROUP, inline = 'ltx')

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
type signal
    int bullish
    int bearish
    int neutral    

signal signals                  = signal.new(0,0,0)
var int left_visible_bar_index  = 0
var int right_visible_bar_index = last_bar_index
int visibleWidthInBars          = 0
int circleAnchor                = 0

var parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT       => position.top_right
    BOTTOM_RIGHT    => position.bottom_right
    BOTTOM_LEFT     => position.bottom_left

var parsedDashboardSize = switch dashboardSizeInput
    TINY            => size.tiny
    SMALL           => size.small
    NORMAL          => size.normal
    LARGE           => size.large
    HUGE            => size.huge

var string baseTicker = syminfo.basecurrency != '' ? syminfo.basecurrency : str.replace(syminfo.ticker, str.match(syminfo.ticker, syminfo.currency),  '', 0)
//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
customData(string data) =>
    string customTicker = 'INTOTHEBLOCK:'+baseTicker+data
    request.security(customTicker, '1D', close[1], lookahead = barmerge.lookahead_on)

customSignal(float data, float bullish, float bearish) =>
    switch
        data > bullish => 
            signals.bullish += 1
            BULLISH
        data < bearish =>
            signals.bearish += 1
            BEARISH
        => 
            signals.neutral += 1
            NEUTRAL

coordinates(float position, float radius) =>
    x = math.max(math.min(circleAnchor + int(math.sin(math.toradians(position)) * radius), last_bar_index + 500), last_bar_index - 5000)
    y = math.cos(math.toradians(position)) * radius
    [x, y] 

drawGauge() => 
    var polyline bullishPolyline        = na
    var polyline neutralPolyline        = na
    var polyline bearishPolyline        = na
    var polyline handPolyline           = na
    var polyline handBoltPolyline       = na
    array<chart.point> bullishPoints    = array.new<chart.point>()
    array<chart.point> neutralPoints    = array.new<chart.point>()
    array<chart.point> bearishPoints    = array.new<chart.point>()
    array<chart.point> handPoints       = array.new<chart.point>()
    array<chart.point> handBoltPoints   = array.new<chart.point>()
        
    float radius            = math.round(scaleInput*visibleWidthInBars)/math.pi
    float innerRadius       = 0.95*radius
    float handBoltRadius    = 0.03*radius
    for index = 0 to 360
        [x,y] = coordinates(index,handBoltRadius)
        handBoltPoints.push(chart.point.new(na,x,y))

    [handLocation,biasTag,biasColor] = switch
        signals.bearish > signals.bullish => [-60,'Mostly Bearish',bearishGaugeColorInput]
        signals.bearish < signals.bullish => [+60,'Mostly Bullish',bullishGaugeColorInput]
        => [0,'Mostly Neutral',neutralhGaugeColorInput]

    float tagRadius = 0.20*radius
    [x,y]           = coordinates(180,tagRadius)
    label.new(chart.point.new(na,x,y),biasTag,color = color(na), style = label.style_none, textcolor = biasColor, size = 30)

    float groupRadius   = 0.40*radius
    [xNeutral,yNeutral] = coordinates(180,groupRadius)
    label.new(chart.point.new(na,xNeutral,yNeutral),str.tostring(signals.neutral),color = color(na), style = label.style_none, textcolor = neutralhGaugeColorInput, size = 30)
    label.new(chart.point.new(na,xNeutral,yNeutral - 0.5*(y - yNeutral) ),'NEUTRAL',color = color(na), style = label.style_none, textcolor = chart.fg_color, size = 10)

    float bearishRadius = 0.40*radius
    [xBearish,_]        = coordinates(270,groupRadius)
    label.new(chart.point.new(na,xBearish,yNeutral),str.tostring(signals.bearish),color = color(na), style = label.style_none, textcolor = bearishGaugeColorInput, size = 30)
    label.new(chart.point.new(na,xBearish,yNeutral - 0.5*(y - yNeutral) ),'BEARISH',color = color(na), style = label.style_none, textcolor = chart.fg_color, size = 10)
    line.new(chart.point.new(na,xNeutral + math.round(0.5*(xBearish-xNeutral)),y - 0.25*(y-yNeutral)),chart.point.new(na,xNeutral + math.round(0.5*(xBearish-xNeutral)),yNeutral - 0.50*(y-yNeutral)),color = color.new(neutralhGaugeColorInput,50))

    float bullishRadius = 0.40*radius
    [xBullish,_]        = coordinates(90,groupRadius)
    label.new(chart.point.new(na,xBullish,yNeutral),str.tostring(signals.bullish),color = color(na), style = label.style_none, textcolor = bullishGaugeColorInput, size = 30)
    label.new(chart.point.new(na,xBullish,yNeutral - 0.5*(y - yNeutral) ),'BULLISH',color = color(na), style = label.style_none, textcolor = chart.fg_color, size = 10)
    line.new(chart.point.new(na,xNeutral + math.round(0.5*(xBullish-xNeutral)),y - 0.25*(y-yNeutral)),chart.point.new(na,xNeutral + math.round(0.5*(xBullish-xNeutral)),yNeutral - 0.50*(y-yNeutral)),color = color.new(neutralhGaugeColorInput,50))

    float handRadius    = 0.80*radius
    float handRatio     = math.round(handRadius/handBoltRadius)
    [x1,y1]             = coordinates(handLocation + 1,handRadius)
    [x2,y2]             = coordinates(handLocation - 1,handRadius)
    [x3,y3]             = coordinates(handLocation - handRatio,handBoltRadius)
    [x4,y4]             = coordinates(handLocation + handRatio,handBoltRadius)
    
    handPoints.push(chart.point.new(na,x1,y1))
    handPoints.push(chart.point.new(na,x2,y2))
    handPoints.push(chart.point.new(na,x3,y3))
    handPoints.push(chart.point.new(na,x4,y4))
    
    for index = 15 to 90
        [outerX,outerY] = coordinates(index,radius)
        [innerX,innerY] = coordinates(index,innerRadius)
        bullishPoints.push(chart.point.new(na,outerX,outerY))
        bullishPoints.unshift(chart.point.new(na,innerX,innerY))

        [outerBearX,outerBearY] = coordinates(-index,radius)
        [innerBearX,innerBearY] = coordinates(-index,innerRadius)
        bearishPoints.push(chart.point.new(na,outerBearX,outerBearY))
        bearishPoints.unshift(chart.point.new(na,innerBearX,innerBearY))

    for index = 0 to 28
        [outerX,outerY] = coordinates(index - 14,radius)
        [innerX,innerY] = coordinates(index - 14,innerRadius)
        neutralPoints.push(chart.point.new(na,outerX,outerY))
        neutralPoints.unshift(chart.point.new(na,innerX,innerY))
    
    bullishPolyline     := polyline.new(bullishPoints,curvedInput,true, line_color = bullishGaugeColorInput, fill_color = bullishGaugeColorInput)
    neutralPolyline     := polyline.new(neutralPoints,curvedInput,true, line_color = neutralhGaugeColorInput, fill_color = neutralhGaugeColorInput)
    bearishPolyline     := polyline.new(bearishPoints,curvedInput,true, line_color = bearishGaugeColorInput, fill_color = bearishGaugeColorInput)    
    handPolyline        := polyline.new(handPoints,curvedInput,true,line_color = biasColor, fill_color = biasColor)
    handBoltPolyline    := polyline.new(handBoltPoints,curvedInput,true,line_color = biasColor, fill_color = chart.fg_color)

cell(table t_able, int column, int row, string data, color = color.white, align = text.align_right) => t_able.cell(column,row,data,text_color = color, text_size = parsedDashboardSize, text_halign = align)

dashboard(array<string> data, array<string> signals) =>
    var table t_able = table.new(parsedDashboardPosition,3,4
     , bgcolor      = #1e222d
     , border_color = #373a46
     , border_width = 1
     , frame_color  = #373a46
     , frame_width  = 1)

    cell(t_able,0,0,'Net Network Growth',   align = text.align_left)
    cell(t_able,0,1,'In The Money',         align = text.align_left)
    cell(t_able,0,2,'Concentration',        align = text.align_left)
    cell(t_able,0,3,'Large Transactions',   align = text.align_left)
    
    cell(t_able,1,0,data.get(0), signals.get(0) == NEUTRAL ? neutralhGaugeColorInput : signals.get(0) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)
    cell(t_able,1,1,data.get(1), signals.get(1) == NEUTRAL ? neutralhGaugeColorInput : signals.get(1) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)
    cell(t_able,1,2,data.get(2), signals.get(2) == NEUTRAL ? neutralhGaugeColorInput : signals.get(2) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)
    cell(t_able,1,3,data.get(3), signals.get(3) == NEUTRAL ? neutralhGaugeColorInput : signals.get(3) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)

    cell(t_able,2,0,signals.get(0), signals.get(0) == NEUTRAL ? neutralhGaugeColorInput : signals.get(0) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)
    cell(t_able,2,1,signals.get(1), signals.get(1) == NEUTRAL ? neutralhGaugeColorInput : signals.get(1) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)
    cell(t_able,2,2,signals.get(2), signals.get(2) == NEUTRAL ? neutralhGaugeColorInput : signals.get(2) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)
    cell(t_able,2,3,signals.get(3), signals.get(3) == NEUTRAL ? neutralhGaugeColorInput : signals.get(3) == BEARISH ? bearishGaugeColorInput : bullishGaugeColorInput)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
left_visible_bar_index  := time == chart.left_visible_bar_time  ? bar_index : left_visible_bar_index
right_visible_bar_index := time == chart.right_visible_bar_time ? bar_index : right_visible_bar_index
visibleWidthInBars      := right_visible_bar_index - left_visible_bar_index
circleAnchor            := right_visible_bar_index - math.round(0.5 * visibleWidthInBars)

float netNetworkGrowthData      = customData('_TOTALADDRESSES')
float netNetworkGrowth          = 100*(netNetworkGrowthData[1]/netNetworkGrowthData[8] - 1)
string netNetworkGrowthSignal   = customSignal(netNetworkGrowth,netNetworkGrowthBullishThresholdInput,netNetworkGrowthBearishThresholdInput)

float inTheMoneyData            = customData('_INOUTMONEYIN')
float averageBalance            = customData('_AVGBALANCE')
float inTheMoneyBalance         = inTheMoneyData*averageBalance
float sma                       = ta.sma(inTheMoneyBalance,7)
float inTheMoney                = ta.roc(sma,1)
string inTheMoneySignal         = customSignal(inTheMoney,inTheMoneyBullishThresholdInput,inTheMoneyBearishThresholdInput)

float whalesData                = customData('_WHALESPERCENTAGE')
float inverstorsData            = customData('_INVESTORSPERCENTAGE')
float bigHands                  = whalesData+inverstorsData
float concentration             = ta.change(bigHands[1])*100
string concentrationSignal      = customSignal(concentration,concentrationBullishThresholdInput,concentrationBearishThresholdInput)

float largeTransacionsData      = customData('_LARGETXCOUNT')
float largeTX21                 = ta.ema(largeTransacionsData,21)[1]
float largeTX30                 = ta.ema(largeTransacionsData,30)[1]
float largeTransacions          = ((largeTX21 - largeTX30)/largeTX30)*100
string largeTransacionsSignal   = customSignal(largeTransacions,transactionsBullishThresholdInput,transactionsBearishThresholdInput)

if barstate.islast
    if displayModeInput == GAUGE
        drawGauge()

    if dashboardInput
        array<string> data      = array.from(str.tostring(netNetworkGrowth/100,'0.00%'),str.tostring(inTheMoney/100,'0.00%'),str.tostring(concentration/100,'0.000%'),str.tostring(largeTransacions/100,'0.00%'))
        array<string> signals   = array.from(netNetworkGrowthSignal,inTheMoneySignal,concentrationSignal,largeTransacionsSignal)
        dashboard(data,signals)

showPlots = displayModeInput == PLOTS

plot(showPlots and netNetworkGrowthInput    ? netNetworkGrowth  : na,'netNetworkGrowth',color = netNetworkGrowthColorInput, style = plot.style_area)
plot(showPlots and inTheMoneyInput          ? inTheMoney        : na,'inTheMoney',      color = inTheMoneyColorInput,       style = plot.style_area)
plot(showPlots and concentrationInput       ? concentration     : na,'concentration',   color = concentrationColorInput,    style = plot.style_area)
plot(showPlots and largeTransacionsInput    ? largeTransacions  : na,'largeTransacions',color = largeTransacionsColorInput, style = plot.style_area)

overallBias = switch
    signals.bearish > signals.bullish => -1
    signals.bearish < signals.bullish => 1
    => 0

average = switch averageMethodInput
    SMA => ta.sma(overallBias,averageLengthInput)
    EMA => ta.ema(overallBias,averageLengthInput)
    TMA => ta.sma(ta.sma(overallBias,averageLengthInput),averageLengthInput)

averageColor = switch
    signals.bearish > signals.bullish => bearishGaugeColorInput
    signals.bearish < signals.bullish => bullishGaugeColorInput
    => neutralhGaugeColorInput

showAverage = displayModeInput == AVERAGE
plot(showAverage ? average : na, 'Bias',color = averageColor,linewidth = 5)
hline(showAverage ? 0 : na)

//---------------------------------------------------------------------------------------------------------------------}