// ─────────────────────────────────────────────────────────────────────────────
// STANDARDIZED MATHEMATICAL CONSTANTS & INSTITUTIONAL CALIBRATIONS
// (Automated Mathematical Constants & Engine Calibrations)
// ─────────────────────────────────────────────────────────────────────────────
string ltfOverrideInput        = "Auto"
string tickGroupingMode        = "Auto-Adaptive (Row-Density Invariance)"
int    manualTicksInput        = 4
bool   useTodRvol              = true
bool   ignoreZerosInput        = true
int    imbTicksPerRow          = 0
string priorLevelAnchor        = "Session Framing Only (No Multi-Day Lines)"
string confToleranceMode       = "Auto-Asset Calibrated"
float  confCustomTol           = 12.0
int    confLookbackSess        = 4
string levelLabelPos           = "Right Edge (Inside Box)"
bool   useShieldPill           = true
string profSpanMode            = "Expressive (50% Span)"
int    profOffsetInput         = 2
int    profLabelOverhang       = 2

// Compact volume number formatter (K, M)
f_volCompact(float v) =>
    float av = math.abs(v)
    string s = v < 0 ? "-" : ""
    av >= 1e6 ? s + str.tostring(av / 1e6, "#.00") + "M" : (av >= 1e3 ? s + str.tostring(av / 1e3, "#.0") + "K" : s + str.tostring(av, "#"))

// Viewport & Timeframe Adaptive Right-Margin Profile Width Engine
int tf_sec_prof = timeframe.isseconds ? timeframe.multiplier : (timeframe.isintraday ? timeframe.multiplier * 60 : 86400)
int bar_span_ms_g = tf_sec_prof * 1000
int vis_time_span = not na(chart.left_visible_bar_time) and not na(chart.right_visible_bar_time) ? 
     int(math.max(0, chart.right_visible_bar_time - chart.left_visible_bar_time)) : 0
int vis_bars = (vis_time_span > 0 and bar_span_ms_g > 0) ? 
     math.max(25, int(math.round(vis_time_span / bar_span_ms_g))) : 100

int tf_adaptive_cap = tf_sec_prof <= 30 ? 26 : (tf_sec_prof <= 180 ? 22 : (tf_sec_prof <= 300 ? 18 : (tf_sec_prof <= 900 ? 14 : (tf_sec_prof <= 3600 ? 12 : 8))))

int eff_prof_width = profWidthModeInput == "Fixed Compact (18 Bars)" ? 18 : (profWidthModeInput == "Fixed Balanced (24 Bars)" ? 24 : (profWidthModeInput == "Custom Bars" ? profCustomWidthInput : math.max(10, math.min(tf_adaptive_cap, int(vis_bars * 0.18)))))

int    profWidthInput          = eff_prof_width
int    profOutlineTransp       = 20
bool   profDeltaModulation     = true
bool   profOutlineSyncProfile  = true
color  profOutlineCustomCol    = #00E5FF
string profFontSizeInput       = "Small"
string lvnDisplayMode          = "Inflection Line Only"
string lvnExtendMode           = "Extend Until Mitigated"
float  lvnValleyRatio          = 0.60
string vaCalcMethod            = "Dalton Cumulative Mass (15%-85%)"
string cryptoWeekendMode       = "Day/Night 7-Day (09:30-16:00 EST)"
bool   waitFirstBarClose       = false
string profBinScalingMode      = "Adaptive 5-Primes Scale"
float  bellDivInput            = 3.0
bool   profSmoothKde           = true
int MAX_LOOKBACK = 4500
int prof_bins    = replayOptimized ? 30 : 50

// SECTION 3: DESIGN TOKENS & CANONICAL VARIABLES
// =============================================================================

// --- Master Institutional Effort Resolution Engine (Conformal 1-10 Scale) ---
float s_norm         = (float(effortSensitivity) - 1.0) / 9.0  // Normalized linear parameter 0.0 to 1.0

// 1. Footprint Imbalance Multiplier & Depth (Scalper: 2.2x/2-tier -> CME Standard: 2.9x/3-tier -> Whale: 3.8x/4-tier)
float imbMultInput   = 2.2 + s_norm * 1.6
int   imbDepthInput  = effortSensitivity <= 3 ? 2 : (effortSensitivity <= 8 ? 3 : 4)

// 2. Standard Volume-Spread Absorption Thresholds (Continuous 1-10 Sensitivity Scaling)
float req_rvol_absorb = 1.10 + s_norm * 0.90   // 1 -> 1.10x (Relaxed), 5 -> 1.50x (Standard), 10 -> 2.00x (Strict)
float req_delta_ratio = 0.15 + s_norm * 0.25   // Minimum delta-to-volume absorption intensity

// 3. Directional Momentum Expansion & Reclaim Wick Tuning
float eff_body_drive = 0.55 + s_norm * 0.25   // 1 -> 55%, 5 -> 66%, 10 -> 80%
float agg_wick_mult  = 0.85 + s_norm * 0.30   // 1 -> 0.85x, 5 -> 0.98x, 10 -> 1.15x
float agg_rvol_mult  = 0.85 + s_norm * 0.45   // Scaled momentum volume floor mult

// Canonical Overnight Framing State Defaults
bool showOvernightBox   = false
bool extendToPreMarket  = false
int  overnightBoxTransp = 100

// Canonical Transparencies & Widths (Standardized under the hood)
bool rulerClickThrough = true
int pocTransp          = 0
int vahTransp          = 35
int valTransp          = 35
int hbTransp           = 20
int confTransp         = 15
int lvnFillTransp      = 92
int shieldPillTransp   = 15

int pocLineWidth       = 2
int vahLineWidth       = 1
int valLineWidth       = 1
int hbLineWidth        = 2
int confLineWidth      = 2
string pocLineStyleInput   = "Solid"
string vahLineStyleInput   = "Solid"
string valLineStyleInput   = "Solid"
string hbLineStyleInput    = "Dashed"
string confLineStyleInput  = "Solid"
string lvnLineStyleInput   = "Dotted"
string frameOutlineStyle   = frameOutlineStyleChoice
bool eff_show_frames       = showSessionFrames and (frameGeometryMode != "None (Disabled)")

// Canonical Design Tokens
color COL_GOLD_ABSORB   = colBuyerAbsorb
color COL_PURPLE_DRIVE  = colSellerAbsorb
