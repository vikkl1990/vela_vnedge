indicator("CME Institutional Order Flow & AMT Lens",
     shorttitle       = "CME LENS",
     overlay          = true,
     max_bars_back    = 5000,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500)

import TradingView/ta/14 as tvta

// =============================================================================
// SECTION 1: AUTO-ASSET DETECTION & DYNAMIC ASSET SCALES
// =============================================================================

string root_sym = syminfo.root
string tick_sym = syminfo.ticker

bool is_nq_asset  = str.contains(root_sym, "NQ") or str.contains(tick_sym, "NQ") or str.contains(tick_sym, "QQQ") or str.contains(tick_sym, "NDX") or str.contains(tick_sym, "US100") or str.contains(tick_sym, "NAS100")
bool is_es_asset  = str.contains(root_sym, "ES") or str.contains(tick_sym, "ES") or str.contains(tick_sym, "SPY") or str.contains(tick_sym, "SPX") or str.contains(tick_sym, "US500") or str.contains(tick_sym, "SP500")
bool is_rty_asset = str.contains(root_sym, "RTY") or str.contains(root_sym, "M2K") or str.contains(tick_sym, "RTY") or str.contains(tick_sym, "MRTY") or str.contains(tick_sym, "IWM") or str.contains(tick_sym, "RUT") or str.contains(tick_sym, "US2000")
bool is_mbt_asset = str.contains(root_sym, "MBT") or str.contains(root_sym, "BTC") or str.contains(tick_sym, "MBT") or str.contains(tick_sym, "BTC") or str.contains(tick_sym, "IBIT")
bool is_gc_asset  = str.contains(root_sym, "GC") or str.contains(root_sym, "MGC") or str.contains(tick_sym, "GC") or str.contains(tick_sym, "MGC") or str.contains(tick_sym, "GLD") or str.contains(tick_sym, "XAU")
bool is_ym_asset  = str.contains(root_sym, "YM") or str.contains(root_sym, "MYM") or str.contains(tick_sym, "YM") or str.contains(tick_sym, "MYM") or str.contains(tick_sym, "DIA") or str.contains(tick_sym, "DJI") or str.contains(tick_sym, "US30")
bool is_equity_asset = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
bool is_crypto_asset = syminfo.type == "crypto" or str.contains(tick_sym, "USDT") or str.contains(tick_sym, "USDC") or str.contains(tick_sym, "BUSD") or str.contains(tick_sym, "DOGE") or str.contains(tick_sym, "ETH") or str.contains(tick_sym, "SOL")

string detected_asset_name = is_crypto_asset ? ("Crypto (" + syminfo.ticker + ")") : is_equity_asset ? ("US Equities (" + syminfo.ticker + ")") : is_nq_asset ? "NQ (Nasdaq-100)" : is_es_asset ? "ES (S&P 500)" : is_ym_asset ? "YM (Dow Jones)" : is_rty_asset ? "RTY (Russell 2000)" : is_mbt_asset ? "MBT (Bitcoin)" : is_gc_asset ? "GC (Gold)" : "CME Futures"

// Asset-Specific Scales
float asset_tick_step = is_crypto_asset ? syminfo.mintick : (is_equity_asset ? 0.01 : is_nq_asset ? 0.25 : is_es_asset ? 0.25 : is_ym_asset ? 1.00 : is_rty_asset ? 0.10 : is_mbt_asset ? 5.00 : is_gc_asset ? 0.10 : syminfo.mintick)
float asset_cluster_tol = (is_equity_asset or is_crypto_asset) ? math.max(close * 0.0015, syminfo.mintick * 4) : is_nq_asset ? 12.0 : is_es_asset ? 3.0 : is_ym_asset ? 30.0 : is_rty_asset ? 2.0 : is_mbt_asset ? 100.0 : is_gc_asset ? 4.0 : 12.0

// =============================================================================
// SECTION 2: USER INPUTS - STREAMLINED & INSTITUTIONAL
// =============================================================================

// --- 1. Execution Engine & Performance ---
grp_perf = "1. Execution Engine & Performance"
replayOptimized         = input.bool(true, "Fast Replay / Lightweight Mode (Universal Free & Premium)", group=grp_perf,
     tooltip="UNCHECK THIS BOX TO ACTIVATE TRADINGVIEW PREMIUM DEFAULTS:\n\n• CHECKED (Default): Universal Fast Replay & Free tier mode using calibrated Geometric Proxy delta (zero data lag, zero paywall alerts).\n\n• UNCHECKED (Premium / Ultimate): Instantly activates Native Footprint CME tick-by-tick tape with diagonal ladder matching and continuous Gaussian density profiles.")
engineInput             = input.string("Native Footprint (Tick Precision)", "Order Flow Engine (when Lightweight Disabled)",
     options=["Native Footprint (Tick Precision)", "Geometric Proxy (Zero Lag / Replay)", "Intrabar (1m Low Memory)", "Intrabar (Sub-Minute)"], group=grp_perf,
     tooltip="Volume delta calculation engine active when Lightweight Mode is unchecked. 'Native Footprint' provides CME tick-by-tick precision on TradingView Premium/Ultimate accounts.")

// --- 2. Candlestick Style & Effort Absorption ---
grp_candles = "2. Candlestick Style & Effort Absorption"
candleStyle             = input.string("Native Bar Re-color (Zero Setup / Standard Candles)", "Candle Display Style",
     options=["Native Bar Re-color (Zero Setup / Standard Candles)", "Ghost Glow (Semi-Transparent Body + Solid Wicks)", "Full Solid HD Candlestick", "Hollow (Wicks & Solid Borders Only)", "Disabled"], group=grp_candles,
     tooltip="Selects visual presentation style for price candles:\n\n• Native Bar Re-color (Zero Setup): Seamless out-of-the-box recoloring of existing chart candles via barcolor(). Lowest GPU overhead, 0 plot slots, and requires zero manual chart settings adjustments.\n\n• Ghost Glow: Semi-transparent bodies with solid wicks & borders via plotcandle(). Engineered specifically to overlay cleanly on native Volume Footprints and Volume Profiles without obscuring numbers. (For best clarity, uncheck 'Body' in Chart Settings -> Symbol).\n\n• Full Solid HD: Traditional high-contrast solid candlesticks via plotcandle(). Masks underlying native candles.\n\n• Hollow: Wicks and solid borders only with transparent bodies.\n\n• Disabled: Suppresses candle coloring completely.")
effortSensitivity       = input.int(5, "Institutional Effort Sensitivity (1 - 10)", minval=1, maxval=10, group=grp_candles,
     tooltip="Unified sensitivity scale governing Institutional Order Flow & Absorption detection:\n\n• 1 - 3 (High-Frequency / Scalp): Captures sensitive, fast-moving absorption wicks on 30s-1m charts.\n• 5 - 6 (Standard CME Default): Institutional benchmark calibrated to passive limit order defenses at session extremes.\n• 7 - 8 (Conservative Institutional): Filters out minor order book noise, isolating high-volume institutional walls.\n• 9 - 10 (Macro / Fortress Defense): Ultra-strict threshold capturing major structural inflection points.\n\nSelf-calibrating across all timeframes via rolling volatility and volume distributions.")
showEffortReward        = input.bool(true, "Color Effort vs. Reward Candles", group=grp_candles,
     tooltip="Colors candles based on Auction Market Theory and volume delta absorption (Demand absorption, Supply absorption, Initiative drives, Muted consolidation).")

