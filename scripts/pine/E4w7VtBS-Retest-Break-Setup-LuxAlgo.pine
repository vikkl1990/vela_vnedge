//@version=6
indicator("Retest & Break Setup [LuxAlgo]", "LuxAlgo - R&B Setup", overlay=true, max_lines_count=500, max_labels_count=500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
color DATA              = #DBDBDB
color HEADERS           = #808080
color BACKGROUND        = #161616
color BORDERS           = #2E2E2E

string TOP_RIGHT        = 'Top Right'
string BOTTOM_RIGHT     = 'Bottom Right'
string BOTTOM_LEFT      = 'Bottom Left'

string TINY             = 'Tiny'
string SMALL            = 'Small'
string NORMAL           = 'Normal'
string LARGE            = 'Large'
string HUGE             = 'Huge'

string DASHBOARD_GROUP          = 'Dashboard'
string dashboardTooltip         = 'Enable or disable the dashboard.'
string dashboardPositionTooltip = 'Select the dashboard location.'
string dashboardSizeTooltip     = 'Select the dashboard size.'

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
int length  = input.int(5, "Length", group="Pivot Settings")
int nBars     = input.int(20, "Max Bars for Break (N)", group="Setup Settings", tooltip="Maximum number of bars allowed between the last Retest and the Break.")
int pBars     = input.int(20, "Max Bars between Retests (P)", group="Setup Settings", tooltip="Maximum number of bars allowed between the Swing and the first Retest, or between consecutive Retests.")
int kRetests  = input.int(2, "Required Consecutive Retests (K)", group="Setup Settings", minval=1)
bool showOnlyComplete = input.bool(true, "Only Show Complete Setups", group="Setup Settings")

color bullColor   = input.color(color.new(#089981, 0), "Bullish Setup Color", group="Style")
color bearColor   = input.color(color.new(#f23645, 0), "Bearish Setup Color", group="Style")
color invalidColor= input.color(color.new(color.gray, 50), "Invalidated Color", group="Style")
color textColor   = input.color(color.white, "Label Text Color", group="Style")

bool dashboardInput         = input.bool(true, 'Dashboard', group = DASHBOARD_GROUP, tooltip = dashboardTooltip)
string dashboardPositionInput = input.string(TOP_RIGHT, 'Position', group = DASHBOARD_GROUP, tooltip = dashboardPositionTooltip, options = [TOP_RIGHT,BOTTOM_RIGHT,BOTTOM_LEFT])
string dashboardSizeInput   = input.string(SMALL, 'Size', group = DASHBOARD_GROUP, tooltip = dashboardSizeTooltip, options = [TINY,SMALL,NORMAL,LARGE,HUGE])

//---------------------------------------------------------------------------------------------------------------------}
// Variables
//---------------------------------------------------------------------------------------------------------------------{
var string parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT       => position.top_right
    BOTTOM_RIGHT    => position.bottom_right
    BOTTOM_LEFT     => position.bottom_left

var string parsedDashboardSize     = switch dashboardSizeInput
    TINY            => size.tiny
    SMALL           => size.small
    NORMAL          => size.normal
    LARGE           => size.large
    HUGE            => size.huge

// Bullish Variables
var float current_sh = na
var int   current_sh_bar = na
var float broken_sh  = na
var int   broken_sh_bar = na
var float recent_sh  = na
var int   last_event_bar_bull = na
var int   retest_count_bull = 0
var int   state_bull = 0 

var line  sh_line      = na
var line  recent_line  = na
var array<label> retest_labels_bull = array.new_label()

// Bearish Variables
var float current_sl = na
var int   current_sl_bar = na
var float broken_sl  = na
var int   broken_sl_bar = na
var float recent_sl  = na
var int   last_event_bar_bear = na
var int   retest_count_bear = 0
var int   state_bear = 0 

var line  sl_line           = na
var line  recent_line_bear  = na
var array<label> retest_labels_bear = array.new_label()

// Dashboard Stats
var int totalBullSetups = 0
var int completedBullSetups = 0
var int totalBearSetups = 0
var int completedBearSetups = 0

type PendingEval
    int evalBar
    float breakoutPrice
    int direction

var array<PendingEval> pendingEvals = array.new<PendingEval>()
var int evalBull = 0
var int winBull = 0
var int evalBear = 0
var int winBear = 0

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
cell(table t_able, int column, int row, string data, color txtColor = #FFFFFF, string align = text.align_right, color background = na, float height = 0) => 
    t_able.cell(column, row, data, text_color = txtColor, text_size = parsedDashboardSize, text_halign = align, bgcolor = background, height = height)

divider(table t_able, int row, int lastColumn) =>    
    string rowDivider = '━━━━━━━━━━━━━━'
    t_able.merge_cells(0, row, lastColumn, row)
    cell(t_able, 0, row, rowDivider, txtColor = BORDERS, align = text.align_center, height = 0.5)

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
if pendingEvals.size() > 0
    for i = pendingEvals.size() - 1 to 0
        PendingEval p = pendingEvals.get(i)
        if bar_index >= p.evalBar
            if p.direction == 1
                evalBull += 1
                if close > p.breakoutPrice
                    winBull += 1
            else if p.direction == -1
                evalBear += 1
                if close < p.breakoutPrice
                    winBear += 1
            pendingEvals.remove(i)

float ph = ta.pivothigh(high, length, length)
float pl = ta.pivotlow(low, length, length)

if not na(ph)
    current_sh := ph
    current_sh_bar := bar_index - length

if not na(pl)
    current_sl := pl
    current_sl_bar := bar_index - length

// --- Bullish Setup Logic ---
if state_bull == 0
    if not na(current_sh) and close > current_sh
        broken_sh  := current_sh
        broken_sh_bar := current_sh_bar
        recent_sh  := high
        state_bull := 1
        last_event_bar_bull := broken_sh_bar
        retest_count_bull := 0
        current_sh := na
        
        retest_labels_bull.clear()
        sh_line := line.new(broken_sh_bar, broken_sh, bar_index, broken_sh, color=bullColor, style=line.style_dashed, width=2)

else if state_bull == 1
    int barsSinceLastEvent = bar_index - last_event_bar_bull
    recent_sh := math.max(recent_sh, high)
    sh_line.set_x2(bar_index)
    
    if barsSinceLastEvent <= pBars
        if low <= broken_sh and math.min(open, close) > broken_sh
            retest_count_bull += 1
            last_event_bar_bull := bar_index
            
            sh_line.set_x2(bar_index)
            lbl = label.new(bar_index, low, "R" + (kRetests > 1 ? str.tostring(retest_count_bull) : ""), color=bullColor, style=label.style_label_up, textcolor=textColor, size=size.small)
            retest_labels_bull.push(lbl)
            
            if retest_count_bull == kRetests
                state_bull := 2
                totalBullSetups += 1
                recent_line := line.new(last_event_bar_bull, recent_sh, bar_index, recent_sh, color=bullColor, style=line.style_solid, width=2)
    else
        state_bull := 0
        broken_sh  := na
        recent_sh  := na
        
        if showOnlyComplete
            sh_line.delete()
            for lbl in retest_labels_bull
                lbl.delete()
            retest_labels_bull.clear()
        else
            sh_line.set_color(invalidColor)
            for lbl in retest_labels_bull
                lbl.set_color(invalidColor)

else if state_bull == 2
    int barsSinceLastRetest = bar_index - last_event_bar_bull
    recent_line.set_x2(bar_index)
    
    if close > recent_sh
        if barsSinceLastRetest <= nBars
            completedBullSetups += 1
            pendingEvals.push(PendingEval.new(bar_index + nBars, recent_sh, 1))
            label.new(bar_index, high, "Break", color=bullColor, style=label.style_label_down, textcolor=textColor, size=size.small)
            box.new(broken_sh_bar, recent_sh, bar_index, broken_sh, border_color=na, bgcolor=color.new(bullColor, 85))
            
        state_bull := 0
        broken_sh  := na
        recent_sh  := na
        
    else if barsSinceLastRetest > nBars
        state_bull := 0
        broken_sh  := na
        recent_sh  := na
        
        if showOnlyComplete
            sh_line.delete()
            recent_line.delete()
            for lbl in retest_labels_bull
                lbl.delete()
            retest_labels_bull.clear()
        else
            sh_line.set_color(invalidColor)
            recent_line.set_color(invalidColor)
            for lbl in retest_labels_bull
                lbl.set_color(invalidColor)

// --- Bearish Setup Logic ---
if state_bear == 0
    if not na(current_sl) and close < current_sl
        broken_sl  := current_sl
        broken_sl_bar := current_sl_bar
        recent_sl  := low
        state_bear := 1
        last_event_bar_bear := broken_sl_bar
        retest_count_bear := 0
        current_sl := na
        
        retest_labels_bear.clear()
        sl_line := line.new(broken_sl_bar, broken_sl, bar_index, broken_sl, color=bearColor, style=line.style_dashed, width=2)

else if state_bear == 1
    int barsSinceLastEvent = bar_index - last_event_bar_bear
    recent_sl := math.min(recent_sl, low)
    sl_line.set_x2(bar_index)
    
    if barsSinceLastEvent <= pBars
        if high >= broken_sl and math.max(open, close) < broken_sl
            retest_count_bear += 1
            last_event_bar_bear := bar_index
            
            sl_line.set_x2(bar_index)
            lbl = label.new(bar_index, high, "R" + (kRetests > 1 ? str.tostring(retest_count_bear) : ""), color=bearColor, style=label.style_label_down, textcolor=textColor, size=size.small)
            retest_labels_bear.push(lbl)
            
            if retest_count_bear == kRetests
                state_bear := 2
                totalBearSetups += 1
                recent_line_bear := line.new(last_event_bar_bear, recent_sl, bar_index, recent_sl, color=bearColor, style=line.style_solid, width=2)
    else
        state_bear := 0
        broken_sl  := na
        recent_sl  := na
        
        if showOnlyComplete
            sl_line.delete()
            for lbl in retest_labels_bear
                lbl.delete()
            retest_labels_bear.clear()
        else
            sl_line.set_color(invalidColor)
            for lbl in retest_labels_bear
                lbl.set_color(invalidColor)

else if state_bear == 2
    int barsSinceLastRetestBear = bar_index - last_event_bar_bear
    recent_line_bear.set_x2(bar_index)
    
    if close < recent_sl
        if barsSinceLastRetestBear <= nBars
            completedBearSetups += 1
            pendingEvals.push(PendingEval.new(bar_index + nBars, recent_sl, -1))
            label.new(bar_index, low, "Break", color=bearColor, style=label.style_label_up, textcolor=textColor, size=size.small)
            box.new(broken_sl_bar, recent_sl, bar_index, broken_sl, border_color=na, bgcolor=color.new(bearColor, 85))
            
        state_bear := 0
        broken_sl  := na
        recent_sl  := na
        
    else if barsSinceLastRetestBear > nBars
        state_bear := 0
        broken_sl  := na
        recent_sl  := na
        
        if showOnlyComplete
            sl_line.delete()
            recent_line_bear.delete()
            for lbl in retest_labels_bear
                lbl.delete()
            retest_labels_bear.clear()
        else
            sl_line.set_color(invalidColor)
            recent_line_bear.set_color(invalidColor)
            for lbl in retest_labels_bear
                lbl.set_color(invalidColor)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashTable = table.new(parsedDashboardPosition, 4, 7, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1, force_overlay = false)

if barstate.islast and dashboardInput
    dashTable.merge_cells(0, 0, 3, 0)
    cell(dashTable, 0, 0, 'B&R Setup Stats', txtColor = DATA, align = text.align_center)
    
    divider(dashTable, 1, 3)
    
    cell(dashTable, 0, 2, 'Direction', txtColor = HEADERS, align = text.align_left)
    cell(dashTable, 1, 2, 'Total', txtColor = HEADERS, align = text.align_center)
    cell(dashTable, 2, 2, 'Completion', txtColor = HEADERS, align = text.align_center)
    cell(dashTable, 3, 2, 'Win Rate', txtColor = HEADERS, align = text.align_right)
    
    divider(dashTable, 3, 3)
    
    float bullWinRate = evalBull > 0 ? (winBull / evalBull) * 100 : 0
    cell(dashTable, 0, 4, 'Bullish', txtColor = bullColor, align = text.align_left)
    cell(dashTable, 1, 4, str.tostring(totalBullSetups), txtColor = DATA, align = text.align_center)
    cell(dashTable, 2, 4, str.tostring(completedBullSetups), txtColor = DATA, align = text.align_center)
    cell(dashTable, 3, 4, str.tostring(bullWinRate, '#.##') + '%', txtColor = DATA, align = text.align_right)
    
    divider(dashTable, 5, 3)
    
    float bearWinRate = evalBear > 0 ? (winBear / evalBear) * 100 : 0
    cell(dashTable, 0, 6, 'Bearish', txtColor = bearColor, align = text.align_left)
    cell(dashTable, 1, 6, str.tostring(totalBearSetups), txtColor = DATA, align = text.align_center)
    cell(dashTable, 2, 6, str.tostring(completedBearSetups), txtColor = DATA, align = text.align_center)
    cell(dashTable, 3, 6, str.tostring(bearWinRate, '#.##') + '%', txtColor = DATA, align = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}