//@version=6
strategy(
     "Universal Aggressive Trend MACD v3.3 - Trailing TP",
     overlay = true,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     initial_capital = 1000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     pyramiding = 0
)

// =========================================================================
// 1. INPUTS
// =========================================================================

grp_macd = "MACD Settings"
fastLength   = input.int(14, title = "MACD Fast Length", minval = 1, group = grp_macd)
slowLength   = input.int(39, title = "MACD Slow Length", minval = 1, group = grp_macd)
signalLength = input.int(9, title = "MACD Signal Length", minval = 1, group = grp_macd)

grp_entry = "Entry Timing"
useMacdArming   = input.bool(true, title = "MACD Cross Arming nutzen", group = grp_entry)
macdValidBars   = input.int(10, title = "MACD Cross gültig für X Kerzen", minval = 1, maxval = 50, group = grp_entry)
useContinuation = input.bool(true, title = "Continuation Entries nutzen", group = grp_entry)
continuationLen = input.int(5, title = "Continuation Breakout Lookback", minval = 2, maxval = 50, group = grp_entry)
cooldownBars    = input.int(3, title = "Cooldown nach Entry in Kerzen", minval = 0, maxval = 100, group = grp_entry)
allowLongs      = input.bool(true, title = "Longs erlauben", group = grp_entry)
allowShorts     = input.bool(true, title = "Shorts erlauben", group = grp_entry)

grp_filter = "Trend & Filter Settings"
trendEmaLength = input.int(99, title = "Trend EMA Length", minval = 1, group = grp_filter)
useEmaSlope    = input.bool(true, title = "EMA-Slope Filter nutzen", group = grp_filter)
emaSlopeBars   = input.int(3, title = "EMA-Slope Lookback", minval = 1, maxval = 50, group = grp_filter)

adxLength    = input.int(11, title = "ADX Smoothing", minval = 1, group = grp_filter)
adxThreshold = input.float(20.0, title = "ADX Trend Threshold", step = 0.5, group = grp_filter)
useAdxFilter = input.bool(true, title = "ADX Filter nutzen", group = grp_filter)

grp_vol = "Volume Settings"
useVolumeFilter = input.bool(true, title = "Volumenfilter nutzen", group = grp_vol)
volSmaLength    = input.int(22, title = "Volume SMA Length", minval = 1, group = grp_vol)
volMultiplier   = input.float(0.6, title = "Volume Multiplier", step = 0.1, group = grp_vol)

grp_risk = "Risk Management"
atrLength       = input.int(18, title = "ATR Length", minval = 1, group = grp_risk)
emergencyMult   = input.float(2.5, title = "ATR Emergency Stop Multiplier", step = 0.1, group = grp_risk)
useOppositeExit = input.bool(false, title = "Bei MACD-Gegencross schließen", group = grp_risk)

grp_trailing_tp = "Trailing TP - Peak Profit Close"
useTrailingTp        = input.bool(true, title = "Trailing TP aktivieren", group = grp_trailing_tp)
trailingTpMode       = input.string("Relativ vom Peak", title = "Trailing TP Modus", options = ["Relativ vom Peak", "Prozentpunkte"], group = grp_trailing_tp)
trailingTpGiveback   = input.float(3.0, title = "Rücklauf vom höchsten Profit", step = 0.1, minval = 0.1, group = grp_trailing_tp)
trailingTpMinProfit  = input.float(0.50, title = "Trailing TP aktiv ab Peak-Profit (%)", step = 0.05, minval = 0.0, group = grp_trailing_tp)

grp_visual = "Visualisierung"
showSignals   = input.bool(true, title = "Entry-Signale anzeigen", group = grp_visual)
showDashboard = input.bool(true, title = "Dashboard anzeigen", group = grp_visual)


// =========================================================================
// 2. INDICATORS
// =========================================================================

fastEma    = ta.ema(close, fastLength)
slowEma    = ta.ema(close, slowLength)
macdLine   = fastEma - slowEma
signalLine = ta.ema(macdLine, signalLength)
macdHist   = macdLine - signalLine

trendEma = ta.ema(close, trendEmaLength)

[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

volSma = ta.sma(volume, volSmaLength)
atr    = ta.atr(atrLength)


// =========================================================================
// 3. TREND FILTERS
// =========================================================================

emaSlopeUp = not useEmaSlope or trendEma > trendEma[emaSlopeBars]
emaSlopeDn = not useEmaSlope or trendEma < trendEma[emaSlopeBars]

longTrendOk  = close > trendEma and emaSlopeUp
shortTrendOk = close < trendEma and emaSlopeDn

adxOk = not useAdxFilter or adx > adxThreshold
volumeOk = not useVolumeFilter or volume > volSma * volMultiplier

marketOk = adxOk and volumeOk


// =========================================================================
// 4. MACD CROSS ARMING
// =========================================================================
//
// MACD Cross muss nicht exakt auf derselben Kerze wie ADX/Volume/EMA passen.
// Das Cross aktiviert die Richtung für mehrere Kerzen.

macdBullCross = ta.crossover(macdLine, signalLine)
macdBearCross = ta.crossunder(macdLine, signalLine)

var int lastBullCrossBar = na
var int lastBearCrossBar = na

if barstate.isconfirmed
    if macdBullCross
        lastBullCrossBar := bar_index

    if macdBearCross
        lastBearCrossBar := bar_index

bullCrossFresh = not useMacdArming or (
     not na(lastBullCrossBar) and
     bar_index - lastBullCrossBar <= macdValidBars and
     macdLine > signalLine
)

bearCrossFresh = not useMacdArming or (
     not na(lastBearCrossBar) and
     bar_index - lastBearCrossBar <= macdValidBars and
     macdLine < signalLine
)


// =========================================================================
// 5. CONTINUATION LOGIC
// =========================================================================
//
// Fängt Trends, bei denen das MACD-Cross bereits passiert ist.
// Einstieg kommt dann beim Ausbruch über/unter eine kleine Struktur.

highestBefore = ta.highest(high, continuationLen)[1]
lowestBefore  = ta.lowest(low, continuationLen)[1]

longContinuation = useContinuation and
     macdLine > signalLine and
     macdHist > 0 and
     close > highestBefore

shortContinuation = useContinuation and
     macdLine < signalLine and
     macdHist < 0 and
     close < lowestBefore


// =========================================================================
// 6. SIMPLE COOLDOWN ONLY
// =========================================================================
//
// Kein Trade-pro-Stunde-Counter.
// Nur ein einfacher Cooldown nach Entry.

var int lastEntryBar = na

cooldownOk = na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars
frequencyOk = cooldownOk


// =========================================================================
// 7. POSITION STATE
// =========================================================================

flat    = strategy.position_size == 0
isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0


// =========================================================================
// 8. ENTRY CONDITIONS
// =========================================================================

longTrigger = bullCrossFresh or longContinuation
shortTrigger = bearCrossFresh or shortContinuation

longCond = allowLongs and
     flat and
     frequencyOk and
     marketOk and
     longTrendOk and
     longTrigger

shortCond = allowShorts and
     flat and
     frequencyOk and
     marketOk and
     shortTrendOk and
     shortTrigger


// =========================================================================
// 9. TRAILING TP STATE
// =========================================================================
//
// Trailing TP Definition:
// Die Strategie merkt sich den höchsten offenen Profit auf Kerzenschlussbasis.
// Wenn der aktuelle Close-Profit vom Peak zurückläuft, wird geschlossen.
//
// Modus "Relativ vom Peak":
// Peak-Profit = 10.00 %
// Rücklauf    = 3.00 %
// Exit-Level  = 10.00 % * 0.97 = 9.70 %
//
// Modus "Prozentpunkte":
// Peak-Profit = 10.00 %
// Rücklauf    = 3.00
// Exit-Level  = 10.00 % - 3.00 % = 7.00 %

var float peakProfitPerc = na
var bool trailingTpArmed = false

var float longEmergencyStop = na
var float shortEmergencyStop = na

float currentProfitPerc = 0.0

if isLong and strategy.position_avg_price > 0
    currentProfitPerc := (close - strategy.position_avg_price) / strategy.position_avg_price * 100.0

if isShort and strategy.position_avg_price > 0
    currentProfitPerc := (strategy.position_avg_price - close) / strategy.position_avg_price * 100.0

if barstate.isconfirmed
    if flat
        peakProfitPerc := na
        trailingTpArmed := false
        longEmergencyStop := na
        shortEmergencyStop := na

    if not flat
        peakProfitPerc := na(peakProfitPerc) ? currentProfitPerc : math.max(peakProfitPerc, currentProfitPerc)

        if peakProfitPerc >= trailingTpMinProfit
            trailingTpArmed := true

float trailingTpExitLevel = na

if trailingTpArmed and not na(peakProfitPerc)
    if trailingTpMode == "Relativ vom Peak"
        trailingTpExitLevel := peakProfitPerc * (1.0 - trailingTpGiveback / 100.0)
    else
        trailingTpExitLevel := peakProfitPerc - trailingTpGiveback

bool trailingTpExit = barstate.isconfirmed and
     useTrailingTp and
     trailingTpArmed and
     not na(trailingTpExitLevel) and
     currentProfitPerc <= trailingTpExitLevel

oppositeExitLong = useOppositeExit and isLong and macdBearCross
oppositeExitShort = useOppositeExit and isShort and macdBullCross


// =========================================================================
// 10. ORDERS
// =========================================================================

if barstate.isconfirmed
    // ---------------------------------------------------------------------
    // TRAILING TP EXIT AUF KERZENSCHLUSS
    // ---------------------------------------------------------------------

    if isLong and trailingTpExit
        strategy.close("Long", comment = "Long Trailing TP")

    if isShort and trailingTpExit
        strategy.close("Short", comment = "Short Trailing TP")

    // ---------------------------------------------------------------------
    // OPTIONAL MACD REVERSAL EXIT
    // ---------------------------------------------------------------------

    if oppositeExitLong
        strategy.close("Long", comment = "Long MACD Reverse")

    if oppositeExitShort
        strategy.close("Short", comment = "Short MACD Reverse")

    // ---------------------------------------------------------------------
    // ENTRIES
    // ---------------------------------------------------------------------

    if longCond
        strategy.entry("Long", strategy.long, comment = "Long")

        longEmergencyStop := close - atr * emergencyMult
        shortEmergencyStop := na

        peakProfitPerc := na
        trailingTpArmed := false

        lastEntryBar := bar_index

    if shortCond
        strategy.entry("Short", strategy.short, comment = "Short")

        shortEmergencyStop := close + atr * emergencyMult
        longEmergencyStop := na

        peakProfitPerc := na
        trailingTpArmed := false

        lastEntryBar := bar_index


// =========================================================================
// 11. EMERGENCY ATR STOPS
// =========================================================================
//
// ATR-Stop ist nur die Notbremse.
// Der Haupt-Gewinnexit ist der Trailing TP auf Kerzenschlussbasis.

if isLong and not na(longEmergencyStop)
    strategy.exit(
         id = "Long Emergency SL",
         from_entry = "Long",
         stop = longEmergencyStop
    )

if isShort and not na(shortEmergencyStop)
    strategy.exit(
         id = "Short Emergency SL",
         from_entry = "Short",
         stop = shortEmergencyStop
    )


// =========================================================================
// 12. DASHBOARD
// =========================================================================

var table dash = table.new(
     position.top_right,
     2,
     11,
     bgcolor = color.new(color.black, 75),
     border_width = 1,
     border_color = color.gray
)

if barstate.islast and showDashboard
    totalClosed = strategy.closedtrades
    totalWins = strategy.wintrades

    winRate = totalClosed > 0 ? totalWins / totalClosed * 100.0 : 0.0

    grossProfit = strategy.grossprofit
    grossLoss = strategy.grossloss
    profitFactor = grossLoss > 0 ? grossProfit / grossLoss : grossProfit > 0 ? 99.99 : 0.0

    table.cell(dash, 0, 0, "MACD Trend v3.3", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 0, "Trailing TP", text_color = color.white, text_halign = text.align_right)

    table.cell(dash, 0, 1, "Profit Factor", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 1, str.tostring(profitFactor, "#.###"), text_color = profitFactor >= 2 ? color.green : profitFactor >= 1.2 ? color.orange : color.red, text_halign = text.align_right)

    table.cell(dash, 0, 2, "Win Rate", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 2, str.tostring(winRate, "#.##") + " %", text_color = winRate >= 40 ? color.green : color.orange, text_halign = text.align_right)

    table.cell(dash, 0, 3, "Closed Trades", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 3, str.tostring(totalClosed), text_color = color.white, text_halign = text.align_right)

    table.cell(dash, 0, 4, "Cooldown OK", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 4, cooldownOk ? "Ja" : "Nein", text_color = cooldownOk ? color.green : color.red, text_halign = text.align_right)

    table.cell(dash, 0, 5, "Current Profit", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 5, flat ? "n/a" : str.tostring(currentProfitPerc, "#.###") + " %", text_color = currentProfitPerc >= 0 ? color.green : color.red, text_halign = text.align_right)

    table.cell(dash, 0, 6, "Peak Profit", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 6, na(peakProfitPerc) ? "n/a" : str.tostring(peakProfitPerc, "#.###") + " %", text_color = trailingTpArmed ? color.green : color.gray, text_halign = text.align_right)

    table.cell(dash, 0, 7, "Trailing TP Level", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 7, na(trailingTpExitLevel) ? "n/a" : str.tostring(trailingTpExitLevel, "#.###") + " %", text_color = color.orange, text_halign = text.align_right)

    table.cell(dash, 0, 8, "ADX", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 8, str.tostring(adx, "#.##"), text_color = adxOk ? color.green : color.gray, text_halign = text.align_right)

    table.cell(dash, 0, 9, "Volume OK", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 9, volumeOk ? "Ja" : "Nein", text_color = volumeOk ? color.green : color.gray, text_halign = text.align_right)

    table.cell(dash, 0, 10, "Market OK", text_color = color.white, text_halign = text.align_left)
    table.cell(dash, 1, 10, marketOk ? "Ja" : "Nein", text_color = marketOk ? color.green : color.red, text_halign = text.align_right)


// =========================================================================
// 13. VISUALIZATION
// =========================================================================

plot(
     trendEma,
     color = color.blue,
     title = "Trend EMA",
     linewidth = 2
)

plot(
     isLong and not na(longEmergencyStop) ? longEmergencyStop : na,
     color = color.new(color.red, 0),
     style = plot.style_linebr,
     linewidth = 2,
     title = "Long Emergency Stop"
)

plot(
     isShort and not na(shortEmergencyStop) ? shortEmergencyStop : na,
     color = color.new(color.red, 0),
     style = plot.style_linebr,
     linewidth = 2,
     title = "Short Emergency Stop"
)

plotshape(
     showSignals and longCond,
     title = "Long Signal",
     style = shape.triangleup,
     location = location.belowbar,
     color = color.new(color.green, 0),
     size = size.small,
     text = "LONG"
)

plotshape(
     showSignals and shortCond,
     title = "Short Signal",
     style = shape.triangledown,
     location = location.abovebar,
     color = color.new(color.red, 0),
     size = size.small,
     text = "SHORT"
)

bgcolor(
     not adxOk ? color.new(color.gray, 90) : na,
     title = "ADX Chop Zone"
)