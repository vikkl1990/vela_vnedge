// ============================================================
//  ALERTS
// ============================================================
alertcondition(p1_0d>0 and close>=p1_0d,   "0D:P1",   "GEX 0DTE P1 Resistance hit")
alertcondition(p2_0d>0 and close>=p2_0d,   "0D:P2",   "GEX 0DTE P2 Resistance hit")
alertcondition(ps1_0d>0 and close<=ps1_0d, "0D:PS1",  "GEX 0DTE PS1 Support Floor breached")
alertcondition(ps2_0d>0 and close<=ps2_0d, "0D:PS2",  "GEX 0DTE PS2 Support Floor breached")
alertcondition(n1_0d>0 and close<=n1_0d,   "0D:N1",   "GEX 0DTE N1 Danger Zone")
alertcondition(gf_0d>0 and ta.cross(close,gf_0d), "0D:Flip", "GEX 0DTE Flip crossed")
alertcondition(p1_wk>0 and close>=p1_wk,   "WK:P1",   "GEX Weekly P1 Resistance hit")
alertcondition(n1_wk>0 and close<=n1_wk,   "WK:N1",   "GEX Weekly N1 Support")
alertcondition(p1_mo>0 and close>=p1_mo,   "MO:P1",   "GEX Monthly P1 Resistance hit")
alertcondition(n1_mo>0 and close<=n1_mo,   "MO:N1",   "GEX Monthly N1 Support")
alertcondition(cw_fc>0 and close>=cw_fc,   "CW",      "GEX Call Wall reached")
alertcondition(pw_fc>0 and close<=pw_fc,   "PW",      "GEX Put Wall reached")

// ============================================================
//  STATIC RIGHT-EDGE READOUT  (rebuilt 2026-09-16 11:45 AM ET)
//
//  WHY THIS IS A TABLE AND NOT plot(display=display.price_scale):
//  the 2026-09-16 v2.0 build used 27 price-scale plots. That pushed the
//  script to 66 outputs against Pine's hard cap of 64 and TradingView
//  killed the whole script with RE10140 -- "The script creates too many
//  plots (66). The limit is 64." NOTHING drew: no lines, no labels, no
//  levels. Measured live on SPY 1h, not inferred.
//
//  A table costs ZERO plots. It is also anchored to the PANE, not to the
//  bars, so it holds its position when you scroll and when you change
//  timeframe -- which is what the price-scale tags were reaching for.
//  Same 27 readouts, sorted high to low like a price ladder.
// ============================================================
addlv(arrP, arrT, arrC, p, t, c) =>
    if p != 0
        array.push(arrP, p)
        array.push(arrT, t + " " + str.tostring(p, "#.##"))
        array.push(arrC, c)

var table tbl = table.new(position.middle_right, 1, 28, border_width=0)

if barstate.islast
    lv_p = array.new_float(0)
    lv_t = array.new_string(0)
    lv_c = array.new_color(0)

    if show_lbl
        if s0
            addlv(lv_p, lv_t, lv_c, p1_0d,  "0D:P1",   c0p)
            addlv(lv_p, lv_t, lv_c, p2_0d,  "0D:P2",   c0p)
            addlv(lv_p, lv_t, lv_c, ps1_0d, "0D:PS1",  c0ps)
            addlv(lv_p, lv_t, lv_c, ps2_0d, "0D:PS2",  c0ps)
            addlv(lv_p, lv_t, lv_c, n1_0d,  "0D:N1",   c0n)
            addlv(lv_p, lv_t, lv_c, n2_0d,  "0D:N2",   c0n)
            addlv(lv_p, lv_t, lv_c, ag1_0d, "0D:AG1",  c0a)
            addlv(lv_p, lv_t, lv_c, gf_0d,  "0D:Flip", c0f)
            addlv(lv_p, lv_t, lv_c, mp_0d,  "0D:MP",   c0m)
            addlv(lv_p, lv_t, lv_c, eu_0d,  "0D:EM+",  c0e)
            addlv(lv_p, lv_t, lv_c, ed_0d,  "0D:EM-",  c0e)
        if sw
            addlv(lv_p, lv_t, lv_c, p1_wk,  "WK:P1",   cwp)
            addlv(lv_p, lv_t, lv_c, n1_wk,  "WK:N1",   cwn)
            addlv(lv_p, lv_t, lv_c, ag1_wk, "WK:AG1",  cwa)
            addlv(lv_p, lv_t, lv_c, gf_wk,  "WK:Flip", cwf)
            addlv(lv_p, lv_t, lv_c, eu_wk,  "WK:EM+",  cwe)
            addlv(lv_p, lv_t, lv_c, ed_wk,  "WK:EM-",  cwe)
        if sm
            addlv(lv_p, lv_t, lv_c, p1_mo,  "MO:P1",   cmp)
            addlv(lv_p, lv_t, lv_c, n1_mo,  "MO:N1",   cmn)
            addlv(lv_p, lv_t, lv_c, ag1_mo, "MO:AG1",  cma)
            addlv(lv_p, lv_t, lv_c, gf_mo,  "MO:Flip", cmf)
            addlv(lv_p, lv_t, lv_c, eu_mo,  "MO:EM+",  cme)
            addlv(lv_p, lv_t, lv_c, ed_mo,  "MO:EM-",  cme)
        if sf
            addlv(lv_p, lv_t, lv_c, cw_fc,  "CW",      ccw)
            addlv(lv_p, lv_t, lv_c, pw_fc,  "PW",      cpw)
            addlv(lv_p, lv_t, lv_c, hv_fc,  "HVL",     chv)
            addlv(lv_p, lv_t, lv_c, fc_fc,  "FC",      cff)

    n = array.size(lv_p)
    idx = n > 0 ? array.sort_indices(lv_p, order.descending) : array.new_int(0)
    for r = 0 to 27
        if r < n
            i = array.get(idx, r)
            table.cell(tbl, 0, r, array.get(lv_t, i), text_color=array.get(lv_c, i), text_size=sz, bgcolor=bg, text_halign=text.align_left)
        else
            table.cell(tbl, 0, r, "", bgcolor=color.new(color.black, 100))
