//@version=6
indicator("Embedded Readings"
  , shorttitle        = "Embedded Readings"
  , overlay           = false
  , format            = format.price
  , precision         = 2
  , max_labels_count  = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

string OSC_STOCH = "Stochastic"
string OSC_RSI   = "RSI"
string OSC_WPR   = "Williams %R"

string AUTO_OPTION   = "Auto"
string CUSTOM_OPTION = "Custom"

string TOP_RIGHT_OPTION    = "Top Right"
string TOP_LEFT_OPTION     = "Top Left"
string BOTTOM_RIGHT_OPTION = "Bottom Right"
string BOTTOM_LEFT_OPTION  = "Bottom Left"

string TINY_OPTION   = "Tiny"
string SMALL_OPTION  = "Small"
string NORMAL_OPTION = "Normal"

// Common extreme-zone conventions: 80/20 for stochastics and Williams %R, 70/30 for RSI
float STOCH_UPPER = 80.0
float STOCH_LOWER = 20.0
float RSI_UPPER   = 70.0
float RSI_LOWER   = 30.0
float MID_LEVEL   = 50.0

int FULL_TRANSP   = 100
int HALF_TRANSP   = 50
int REGIME_TRANSP = 88

color TRANSP_COLOR = #00000000

color NEUTRAL_COLOR = #787b86 // neutral dashboard state, levels and the %D signal line

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

string GROUP_OSC   = "Oscillator"
string GROUP_EMBED = "Embedding"
string GROUP_DASH  = "Dashboard"
string GROUP_STYLE = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

oscTypeInput = input.string(OSC_STOCH, "Oscillator"
  , options = [OSC_STOCH, OSC_RSI, OSC_WPR]
  , group   = GROUP_OSC
  , tooltip = "Bounded oscillator watched for embedding. The Stochastic is the classic carrier of the working rule, but any bounded oscillator can pin at its extreme. Williams %R is displayed shifted to the 0-100 scale (+100), so its -20/-80 levels map to 80/20.")

sourceInput = input.source(close, "Source"
  , group   = GROUP_OSC
  , tooltip = "Price series fed to the selected oscillator in place of the close.")

lengthInput = input.int(14, "Length"
  , minval  = 1
  , group   = GROUP_OSC
  , tooltip = "Oscillator lookback: %K length for the Stochastic, RSI length, or Williams %R length. 14 is the common default for all three.")

kSmoothInput = input.int(3, "%K Smoothing"
  , minval  = 1
  , group   = GROUP_OSC
  , tooltip = "Stochastic only: moving average length applied to the raw %K line. 3 gives the classic slow stochastic, 1 the fast version.")

dLengthInput = input.int(3, "%D Length"
  , minval  = 1
  , group   = GROUP_OSC
  , tooltip = "Stochastic only: moving average length of the %D signal line used by the working rule.")

embedBarsInput = input.int(3, "Bars To Embed"
  , minval  = 1
  , group   = GROUP_EMBED
  , tooltip = "Consecutive closes beyond the extreme threshold required before the oscillator is flagged as embedded. Roughly three is the common working rule for stochastics; practitioners vary the count.")

bothLinesInput = input.bool(true, "Require Both %K And %D"
  , group   = GROUP_EMBED
  , tooltip = "Stochastic only: both %K and %D must close beyond the threshold on every bar of the count, matching the classic working rule. Disable to track the %K line alone.")

thresholdModeInput = input.string(AUTO_OPTION, "Extreme Thresholds"
  , options = [AUTO_OPTION, CUSTOM_OPTION]
  , group   = GROUP_EMBED
  , tooltip = "Auto applies the common conventions - 80/20 for the Stochastic and Williams %R, 70/30 for RSI. Custom uses the two levels below instead.")

upperCustomInput = input.float(80, "Custom Upper Threshold"
  , minval  = 50
  , maxval  = 100
  , step    = 1
  , group   = GROUP_EMBED
  , tooltip = "Overbought boundary used when Extreme Thresholds is set to Custom.")

lowerCustomInput = input.float(20, "Custom Lower Threshold"
  , minval  = 0
  , maxval  = 50
  , step    = 1
  , group   = GROUP_EMBED
  , tooltip = "Oversold boundary used when Extreme Thresholds is set to Custom.")

showDashInput = input.bool(true, "Show Dashboard"
  , group   = GROUP_DASH
  , tooltip = "Compact panel with the current embedding status, the length of the active run beyond the zone, the oscillator's range while pinned, and the price change over the run.")

dashLocationInput = input.string(TOP_RIGHT_OPTION, "Location"
  , options = [TOP_RIGHT_OPTION, TOP_LEFT_OPTION, BOTTOM_RIGHT_OPTION, BOTTOM_LEFT_OPTION]
  , group   = GROUP_DASH
  , tooltip = "Corner of the pane holding the dashboard.")

dashSizeInput = input.string(SMALL_OPTION, "Size"
  , options = [TINY_OPTION, SMALL_OPTION, NORMAL_OPTION]
  , group   = GROUP_DASH
  , tooltip = "Text size of the dashboard.")

showLabelsInput = input.bool(true, "Transition Labels"
  , group   = GROUP_STYLE
  , tooltip = "Marks the bar where embedding is confirmed and the bar where it is lost - the first decisive close back inside the normal range.")

regimeBgInput = input.bool(true, "Embedded Regime Background"
  , group   = GROUP_STYLE
  , tooltip = "Tints the pane while the oscillator is embedded, so the stretch where reversal signals are suspended reads at a glance.")

showSignalInput = input.bool(true, "Show %D Line"
  , group   = GROUP_STYLE
  , tooltip = "Stochastic only: draws the %D signal line alongside %K.")

bullColorInput = input.color(#089981, "Bullish Color", group = GROUP_STYLE)

bearColorInput = input.color(#f23645, "Bearish Color", group = GROUP_STYLE)

cautionColorInput = input.color(#ff9800, "Caution Color", group = GROUP_STYLE)

signalColorInput = input.color(NEUTRAL_COLOR, "%D Color", group = GROUP_STYLE)

levelsColorInput = input.color(NEUTRAL_COLOR, "Levels Color", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Oscillator
//---------------------------------------------------------------------------------------------------------------------{

//All candidate oscillators are computed on every bar so the ta.* calls never sit inside a branch
float rawStoch = ta.stoch(sourceInput, high, low, lengthInput)
float stochK   = ta.sma(rawStoch, kSmoothInput)
float stochD   = ta.sma(stochK, dLengthInput)
float rsiValue = ta.rsi(sourceInput, lengthInput)

//Williams %R shifted by +100 equals the raw (unsmoothed) stochastic, keeping every option on a shared 0-100 scale
float osc = oscTypeInput == OSC_STOCH ? stochK : oscTypeInput == OSC_RSI ? rsiValue : rawStoch

//%D signal line only participates in Stochastic mode
float signalValue = oscTypeInput == OSC_STOCH ? stochD : na

//Extreme-zone thresholds, following the selected oscillator's convention in Auto mode
float upperThreshold = thresholdModeInput == AUTO_OPTION ? (oscTypeInput == OSC_RSI ? RSI_UPPER : STOCH_UPPER) : upperCustomInput
float lowerThreshold = thresholdModeInput == AUTO_OPTION ? (oscTypeInput == OSC_RSI ? RSI_LOWER : STOCH_LOWER) : lowerCustomInput

//---------------------------------------------------------------------------------------------------------------------}
// Embedding State
//---------------------------------------------------------------------------------------------------------------------{

bool useBothLines = oscTypeInput == OSC_STOCH and bothLinesInput

//A bar counts toward embedding only when the tracked line(s) close beyond the extreme threshold
bool oscReady   = not na(osc) and (not useBothLines or not na(stochD))
bool beyondHigh = oscReady and (useBothLines ? stochK > upperThreshold and stochD > upperThreshold : osc > upperThreshold)
bool beyondLow  = oscReady and (useBothLines ? stochK < lowerThreshold and stochD < lowerThreshold : osc < lowerThreshold)

//Consecutive closes beyond each extreme zone - a spike that turns back inside resets the count, so
//only a pinned oscillator ever reaches the embedding threshold
var int runHigh = 0
var int runLow  = 0

runHigh := beyondHigh ? runHigh + 1 : 0
runLow  := beyondLow  ? runLow  + 1 : 0

//Embedded once the run reaches the working-rule count, held until the first close back inside the range
bool embeddedHigh = runHigh >= embedBarsInput
bool embeddedLow  = runLow  >= embedBarsInput

bool embedHighStart = runHigh == embedBarsInput
bool embedLowStart  = runLow  == embedBarsInput

//Loss of embedding - the first close back inside the normal range, a caution flag rather than a reversal signal
bool embedHighLost = runHigh == 0 and nz(runHigh[1]) >= embedBarsInput
bool embedLowLost  = runLow  == 0 and nz(runLow[1])  >= embedBarsInput

//Run diagnostics - anchor price and pinned amplitude, surfacing the flat low-amplitude signature and the
//persistent price trend that confirm an embedded reading
int runLength = beyondHigh ? runHigh : beyondLow ? runLow : 0

var float runAnchorPrice = na
var float runOscHigh     = na
var float runOscLow      = na

if runLength == 1
    runAnchorPrice := close
    runOscHigh     := osc
    runOscLow      := osc
else if runLength > 1
    runOscHigh := math.max(runOscHigh, osc)
    runOscLow  := math.min(runOscLow, osc)

float runPinRange    = runLength > 0 and not na(runOscHigh) ? runOscHigh - runOscLow : na
float runPriceChange = runLength > 0 and not na(runAnchorPrice) and runAnchorPrice != 0 ? (close - runAnchorPrice) / runAnchorPrice * 100 : na

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

color oscColor = osc > MID_LEVEL ? bullColorInput : bearColorInput

oscPlotId = plot(osc, "Oscillator", oscColor, 1)

plot(showSignalInput ? signalValue : na, "%D", signalColorInput, 1)

midPlotId = plot(MID_LEVEL, "Mid Anchor", editable = false, display = display.none)

//Vertical gradient fill from the 50 midline to the oscillator value, fully transparent at the midline
fill(oscPlotId, midPlotId
  , top_value    = math.max(osc, MID_LEVEL)
  , bottom_value = math.min(osc, MID_LEVEL)
  , top_color    = osc > MID_LEVEL ? color.new(bullColorInput, HALF_TRANSP) : color.new(bearColorInput, FULL_TRANSP)
  , bottom_color = osc > MID_LEVEL ? color.new(bullColorInput, FULL_TRANSP) : color.new(bearColorInput, HALF_TRANSP)
  , title        = "Gradient Fill")

//Dashed extreme thresholds, drawn as lines because Auto mode derives the level from the selected oscillator
if barstate.isfirst
    line.new(bar_index, upperThreshold, bar_index + 1, upperThreshold, extend = extend.both, color = levelsColorInput, style = line.style_dashed)
    line.new(bar_index, lowerThreshold, bar_index + 1, lowerThreshold, extend = extend.both, color = levelsColorInput, style = line.style_dashed)

hline(MID_LEVEL, "Mid Level", levelsColorInput, hline.style_dotted)

//Regime tint while the oscillator is embedded - the stretch where extreme readings flag strength, not exhaustion
bgcolor(regimeBgInput and embeddedHigh ? color.new(bullColorInput, REGIME_TRANSP) : regimeBgInput and embeddedLow ? color.new(bearColorInput, REGIME_TRANSP) : color(na)
  , title = "Embedded Regime Background")

//Transition labels - embedding confirmed and embedding lost are the concept's two events
if showLabelsInput
    if embedHighStart
        label.new(bar_index, osc, "Embedded", color = TRANSP_COLOR, textcolor = bullColorInput, style = label.style_label_up, size = size.small, tooltip = str.tostring(embedBarsInput) + " consecutive closes beyond the upper threshold. Extreme readings now confirm uptrend strength - reversal signals from this oscillator are suspended.")
    if embedLowStart
        label.new(bar_index, osc, "Embedded", color = TRANSP_COLOR, textcolor = bearColorInput, style = label.style_label_down, size = size.small, tooltip = str.tostring(embedBarsInput) + " consecutive closes beyond the lower threshold. Extreme readings now confirm downtrend strength - reversal signals from this oscillator are suspended.")
    if embedHighLost
        label.new(bar_index, osc, "Lost", color = TRANSP_COLOR, textcolor = cautionColorInput, style = label.style_label_down, size = size.small, tooltip = "First close back inside the normal range after an embedded high - a caution flag to manage risk, not a reversal signal.")
    if embedLowLost
        label.new(bar_index, osc, "Lost", color = TRANSP_COLOR, textcolor = cautionColorInput, style = label.style_label_up, size = size.small, tooltip = "First close back inside the normal range after an embedded low - a caution flag to manage risk, not a reversal signal.")

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{

dashLocation = switch dashLocationInput
    TOP_RIGHT_OPTION    => position.top_right
    TOP_LEFT_OPTION     => position.top_left
    BOTTOM_RIGHT_OPTION => position.bottom_right
    => position.bottom_left

dashTextSize = switch dashSizeInput
    TINY_OPTION  => size.tiny
    SMALL_OPTION => size.small
    => size.normal

var table dashTable = table.new(dashLocation, 2, 4, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if showDashInput and barstate.islast
    string statusText = embeddedHigh ? "Embedded High" : embeddedLow ? "Embedded Low" : beyondHigh ? "Forming High " + str.tostring(runHigh) + "/" + str.tostring(embedBarsInput) : beyondLow ? "Forming Low " + str.tostring(runLow) + "/" + str.tostring(embedBarsInput) : "Neutral"
    color statusColor = embeddedHigh ? bullColorInput : embeddedLow ? bearColorInput : beyondHigh or beyondLow ? DASH_TEXT : NEUTRAL_COLOR

    table.cell(dashTable, 0, 0, "Status", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left, tooltip = "Embedded once the run reaches the required count, Forming while a shorter run is beyond the zone, Neutral otherwise.")
    table.cell(dashTable, 1, 0, statusText, text_color = statusColor, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 1, "Bars Beyond Zone", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left, tooltip = "Consecutive closes beyond the extreme threshold in the active run.")
    table.cell(dashTable, 1, 1, str.tostring(runLength), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, "Pin Range", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left, tooltip = "Oscillator range during the active run - a small value near the extreme is the flat, pinned signature of embedding.")
    table.cell(dashTable, 1, 2, na(runPinRange) ? "-" : str.tostring(runPinRange, "#.##"), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 3, "Price Change", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left, tooltip = "Net price change since the run's first close beyond the threshold - confirms price is trending with the pin.")
    table.cell(dashTable, 1, 3, na(runPriceChange) ? "-" : (runPriceChange > 0 ? "+" : "") + str.tostring(runPriceChange, "#.##") + "%", text_color = na(runPriceChange) ? DASH_TEXT : runPriceChange >= 0 ? bullColorInput : bearColorInput, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(embedHighStart, "Embedded High", "Oscillator embedded above its upper threshold on {{ticker}} ({{interval}}) - extreme readings now confirm trend strength, suspend its reversal signals")

alertcondition(embedLowStart, "Embedded Low", "Oscillator embedded below its lower threshold on {{ticker}} ({{interval}}) - extreme readings now confirm downtrend strength, suspend its reversal signals")

alertcondition(embedHighLost, "Embedding Lost (High)", "Oscillator closed back inside its normal range after an embedded high on {{ticker}} ({{interval}}) - caution flag, not a reversal signal")

alertcondition(embedLowLost, "Embedding Lost (Low)", "Oscillator closed back inside its normal range after an embedded low on {{ticker}} ({{interval}}) - caution flag, not a reversal signal")

//---------------------------------------------------------------------------------------------------------------------}
