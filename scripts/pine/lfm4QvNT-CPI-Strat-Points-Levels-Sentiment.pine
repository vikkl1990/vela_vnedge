//@version=6
indicator("CPI Strat - Points, Levels & Sentiment", overlay=true, max_lines_count=20, max_labels_count=20)

//====================================================
// INPUTS
//====================================================

entryOffset = input.float(
     25.0,
     "Entry Offset (Points)",
     minval=1.0,
     step=0.25,
     group="Strategy"
     )

targetDist = input.float(
     15.0,
     "Target Distance (Points)",
     minval=1.0,
     step=0.25,
     group="Strategy"
     )

lineLength = input.int(
     20,
     "Line Length (Bars)",
     minval=1,
     maxval=100,
     group="Strategy"
     )


//====================================================
// COLORS
//====================================================

longColor = input.color(
     color.lime,
     "Long Color",
     group="Appearance"
     )

shortColor = input.color(
     color.red,
     "Short Color",
     group="Appearance"
     )

longTargetColor = input.color(
     color.new(color.lime, 15),
     "Long Target Color",
     group="Appearance"
     )

shortTargetColor = input.color(
     color.new(color.red, 15),
     "Short Target Color",
     group="Appearance"
     )


//====================================================
// LABEL SETTINGS
//====================================================

showLabels = input.bool(
     true,
     "Show Price Labels",
     group="Labels"
     )

showPoints = input.bool(
     true,
     "Show Point Distance",
     group="Labels"
     )

labelOffset = input.int(
     21,
     "Label Offset (Bars)",
     minval=1,
     maxval=100,
     group="Labels"
     )


//====================================================
// DASHBOARD SETTINGS
//====================================================

showDashboard = input.bool(
     true,
     "Show Market Dashboard",
     group="Dashboard"
     )

dashboardPosition = input.string(
     "Top Right",
     "Dashboard Position",
     options=[
         "Top Right",
         "Top Left",
         "Bottom Right",
         "Bottom Left"
         ],
     group="Dashboard"
     )


//====================================================
// DASHBOARD POSITION
//====================================================

getTablePosition(pos) =>
    switch pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right


//====================================================
// CURRENT MARKET LEVELS
//====================================================

// Long side
longEntry = close + entryOffset
longTarget = longEntry + targetDist

// Short side
shortEntry = close - entryOffset
shortTarget = shortEntry - targetDist


//====================================================
// MARKET SENTIMENT
//====================================================

// Current candle direction determines sentiment.
bullish = close > open
bearish = close < open
neutral = close == open

sentimentText = bullish ? "BULLISH" : bearish ? "BEARISH" : "NEUTRAL"

sentimentColor = bullish ? color.lime : bearish ? color.red : color.gray


//====================================================
// LINES
//====================================================

var line longEntryLine = na
var line longTargetLine = na
var line shortEntryLine = na
var line shortTargetLine = na


//====================================================
// LABELS
//====================================================

var label longEntryLabel = na
var label longTargetLabel = na
var label shortEntryLabel = na
var label shortTargetLabel = na


//====================================================
// UPDATE LEVELS
//====================================================

if barstate.islast

    //================================================
    // DELETE OLD OBJECTS
    //================================================

    if not na(longEntryLine)
        line.delete(longEntryLine)

    if not na(longTargetLine)
        line.delete(longTargetLine)

    if not na(shortEntryLine)
        line.delete(shortEntryLine)

    if not na(shortTargetLine)
        line.delete(shortTargetLine)

    if not na(longEntryLabel)
        label.delete(longEntryLabel)

    if not na(longTargetLabel)
        label.delete(longTargetLabel)

    if not na(shortEntryLabel)
        label.delete(shortEntryLabel)

    if not na(shortTargetLabel)
        label.delete(shortTargetLabel)


    //================================================
    // CREATE LONG ENTRY LINE
    //================================================

    longEntryLine := line.new(
         bar_index,
         longEntry,
         bar_index + lineLength,
         longEntry,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=longColor,
         style=line.style_solid,
         width=3
         )


    //================================================
    // CREATE LONG TARGET LINE
    //================================================

    longTargetLine := line.new(
         bar_index,
         longTarget,
         bar_index + lineLength,
         longTarget,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=longTargetColor,
         style=line.style_solid,
         width=3
         )


    //================================================
    // CREATE SHORT ENTRY LINE
    //================================================

    shortEntryLine := line.new(
         bar_index,
         shortEntry,
         bar_index + lineLength,
         shortEntry,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=shortColor,
         style=line.style_solid,
         width=3
         )


    //================================================
    // CREATE SHORT TARGET LINE
    //================================================

    shortTargetLine := line.new(
         bar_index,
         shortTarget,
         bar_index + lineLength,
         shortTarget,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=shortTargetColor,
         style=line.style_solid,
         width=3
         )


    //================================================
    // PRICE LABELS
    //================================================

    if showLabels

        // Long Entry
        string longEntryText = showPoints ?
             "LONG ENTRY  +" +
             str.tostring(entryOffset, format.mintick) +
             " pts  |  " +
             str.tostring(longEntry, format.mintick) :
             "LONG ENTRY  |  " +
             str.tostring(longEntry, format.mintick)

        longEntryLabel := label.new(
             bar_index + labelOffset,
             longEntry,
             longEntryText,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             color=color.new(color.black, 100),
             textcolor=longColor,
             size=size.small
             )


        // Long Target
        string longTargetText = showPoints ?
             "LONG TP  +" +
             str.tostring(entryOffset + targetDist, format.mintick) +
             " pts  |  " +
             str.tostring(longTarget, format.mintick) :
             "LONG TP  |  " +
             str.tostring(longTarget, format.mintick)

        longTargetLabel := label.new(
             bar_index + labelOffset,
             longTarget,
             longTargetText,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             color=color.new(color.black, 100),
             textcolor=longTargetColor,
             size=size.small
             )


        // Short Entry
        string shortEntryText = showPoints ?
             "SHORT ENTRY  -" +
             str.tostring(entryOffset, format.mintick) +
             " pts  |  " +
             str.tostring(shortEntry, format.mintick) :
             "SHORT ENTRY  |  " +
             str.tostring(shortEntry, format.mintick)

        shortEntryLabel := label.new(
             bar_index + labelOffset,
             shortEntry,
             shortEntryText,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             color=color.new(color.black, 100),
             textcolor=shortColor,
             size=size.small
             )


        // Short Target
        string shortTargetText = showPoints ?
             "SHORT TP  -" +
             str.tostring(entryOffset + targetDist, format.mintick) +
             " pts  |  " +
             str.tostring(shortTarget, format.mintick) :
             "SHORT TP  |  " +
             str.tostring(shortTarget, format.mintick)

        shortTargetLabel := label.new(
             bar_index + labelOffset,
             shortTarget,
             shortTargetText,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             color=color.new(color.black, 100),
             textcolor=shortTargetColor,
             size=size.small
             )


//====================================================
// DASHBOARD
//====================================================

var table dashboard = table.new(
     getTablePosition(dashboardPosition),
     2,
     6,
     border_width=1
     )


if barstate.islast and showDashboard

    // Header
    table.cell(
         dashboard,
         0,
         0,
         "CPI STRAT",
         text_color=color.white,
         bgcolor=color.new(color.gray, 70),
         text_size=size.small
         )

    table.cell(
         dashboard,
         1,
         0,
         "CURRENT LEVELS",
         text_color=color.white,
         bgcolor=color.new(color.gray, 70),
         text_size=size.small
         )


    // Sentiment
    table.cell(
         dashboard,
         0,
         1,
         "SENTIMENT",
         text_color=color.white,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )

    table.cell(
         dashboard,
         1,
         1,
         sentimentText,
         text_color=sentimentColor,
         bgcolor=color.new(sentimentColor, 85),
         text_size=size.small
         )


    // Long Entry
    table.cell(
         dashboard,
         0,
         2,
         "LONG ENTRY",
         text_color=longColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )

    table.cell(
         dashboard,
         1,
         2,
         str.tostring(longEntry, format.mintick),
         text_color=longColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )


    // Long Target
    table.cell(
         dashboard,
         0,
         3,
         "LONG TP",
         text_color=longTargetColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )

    table.cell(
         dashboard,
         1,
         3,
         str.tostring(longTarget, format.mintick),
         text_color=longTargetColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )


    // Short Entry
    table.cell(
         dashboard,
         0,
         4,
         "SHORT ENTRY",
         text_color=shortColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )

    table.cell(
         dashboard,
         1,
         4,
         str.tostring(shortEntry, format.mintick),
         text_color=shortColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )


    // Short Target
    table.cell(
         dashboard,
         0,
         5,
         "SHORT TP",
         text_color=shortTargetColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )

    table.cell(
         dashboard,
         1,
         5,
         str.tostring(shortTarget, format.mintick),
         text_color=shortTargetColor,
         bgcolor=color.new(color.black, 80),
         text_size=size.small
         )