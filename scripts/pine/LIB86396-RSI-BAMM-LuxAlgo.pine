//@version=6
indicator("RSI BAMM"
  , shorttitle       = "RSI BAMM"
  , overlay          = false
  , format           = format.price
  , precision        = 2
  , max_lines_count  = 500
  , max_labels_count = 500
  , max_boxes_count  = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

color TRANSP_COLOR = #00000000

color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86 // threshold levels - structure

color DASH_BG     = #161616
color DASH_FRAME  = #2E2E2E
color DASH_HEADER = #808080
color DASH_TEXT   = #DBDBDB

//RSI midpoint - anchor of the gradient fill and of the bullish/bearish coloring of the oscillator
float CENTER_LEVEL = 50.0

//Stages of Carney's staged sequence: initial extreme, pullback, divergent second test, then management
int STAGE_IDLE   = 0
int STAGE_FIRST  = 1
int STAGE_PULL   = 2
int STAGE_FINAL  = 3
int STAGE_MANAGE = 4

int HALF_TRANSP = 50
int FULL_TRANSP = 100

string GROUP_RSI    = "RSI"
string GROUP_STRUCT = "Structure"
string GROUP_ZONE   = "Harmonic Completion"
string GROUP_DASH   = "Dashboard"
string GROUP_STYLE  = "Style"

string TOP_RIGHT_OPTION    = "Top Right"
string TOP_LEFT_OPTION     = "Top Left"
string BOTTOM_RIGHT_OPTION = "Bottom Right"
string BOTTOM_LEFT_OPTION  = "Bottom Left"

string TINY_OPTION   = "Tiny"
string SMALL_OPTION  = "Small"
string NORMAL_OPTION = "Normal"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

rsiLengthInput = input.int(14, "RSI Length"
  , minval  = 2
  , group   = GROUP_RSI
  , tooltip = "Lookback of the RSI the structure is read on. Carney's presentation uses the standard 14-period RSI - the staged logic matters more than the exact setting.")

sourceInput = input.source(close, "Source"
  , group   = GROUP_RSI
  , tooltip = "Price series fed to the RSI.")

obLevelInput = input.float(70, "Overbought Level"
  , minval  = 50
  , maxval  = 100
  , step    = 1
  , group   = GROUP_RSI
  , tooltip = "Extreme reading opening a bearish (M-shape) sequence: the first RSI push beyond this level registers the initial test.")

osLevelInput = input.float(30, "Oversold Level"
  , minval  = 0
  , maxval  = 50
  , step    = 1
  , group   = GROUP_RSI
  , tooltip = "Extreme reading opening a bullish (W-shape) sequence: the first RSI drop under this level registers the initial test.")

intermediateInput = input.float(50, "Intermediate Level"
  , minval  = 1
  , maxval  = 99
  , step    = 1
  , group   = GROUP_STRUCT
  , tooltip = "Momentum threshold the pullback must hold so the trend is not resolved: an RSI cross of this level before the second test voids a forming bearish structure (mirrored as 100 minus the level for bullish ones). After a reversal signal, the RSI recrossing it fires the exit-management alert, per Carney's momentum-based trade management.")

rolloverInput = input.int(2, "Rollover Confirmation"
  , minval  = 1
  , maxval  = 10
  , group   = GROUP_STRUCT
  , tooltip = "Bars on each side an RSI swing needs to confirm that the failed second test has rolled over. The reversal signal fires this many bars after the actual RSI turn - larger values confirm later but on cleaner swings.")

timeoutInput = input.int(500, "Structure Timeout"
  , minval  = 50
  , maxval  = 5000
  , group   = GROUP_STRUCT
  , tooltip = "Maximum bars a sequence may stay active before it is abandoned, preventing stale structures from lingering on quiet charts.")

retracementInput = input.float(0.886, "Retracement Ratio"
  , minval  = 0.5
  , maxval  = 1
  , step    = 0.001
  , group   = GROUP_ZONE
  , tooltip = "Inner boundary of the completion zone, measured as a retracement of the first test -> pullback price leg. 0.886 is the Bat-family measurement Carney projects the final leg toward.")

extensionInput = input.float(1.13, "Extension Ratio"
  , minval  = 1
  , maxval  = 2
  , step    = 0.01
  , group   = GROUP_ZONE
  , tooltip = "Outer boundary of the completion zone, measured as an extension of the same leg beyond the first price extreme. 1.13 is the Bat-family extension - a confirmed close beyond it invalidates the setup.")

showDashInput = input.bool(true, "Show Dashboard"
  , group   = GROUP_DASH
  , tooltip = "Compact panel tracking each side's progress through the sequence - the first extreme starts the clock well before price reaches the completion area.")

dashLocationInput = input.string(TOP_RIGHT_OPTION, "Location"
  , options = [TOP_RIGHT_OPTION, TOP_LEFT_OPTION, BOTTOM_RIGHT_OPTION, BOTTOM_LEFT_OPTION]
  , group   = GROUP_DASH
  , tooltip = "Corner of the pane holding the dashboard.")

dashSizeInput = input.string(SMALL_OPTION, "Size"
  , options = [TINY_OPTION, SMALL_OPTION, NORMAL_OPTION]
  , group   = GROUP_DASH
  , tooltip = "Text size of the dashboard.")

showZoneInput = input.bool(true, "Completion Zone", group = GROUP_STYLE)

showProjectionInput = input.bool(true, "Projected Levels While Forming", group = GROUP_STYLE)

showStructInput = input.bool(true, "RSI Structure Lines", group = GROUP_STYLE)

showDivInput = input.bool(true, "Price Divergence Line", group = GROUP_STYLE)

showLabelsInput = input.bool(true, "Pattern Labels", group = GROUP_STYLE)

showSignalsInput = input.bool(true, "Reversal Markers", group = GROUP_STYLE)

bullColorInput = input.color(BULL_COLOR, "Bullish Color", group = GROUP_STYLE)

bearColorInput = input.color(BEAR_COLOR, "Bearish Color", group = GROUP_STYLE)

levelsColorInput = input.color(NEUTRAL_COLOR, "Levels Color", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{

//One side of the methodology (bearish M at highs or bullish W at lows) tracked as a small state machine
type SideState
    int   stage
    int   startBar
    float rsiFirst
    int   rsiFirstBar
    float priceFirst
    int   priceFirstBar
    float rsiPull
    int   rsiPullBar
    float pricePull
    int   pricePullBar
    float shoulderRsi
    int   shoulderBar
    float pushPrice
    int   pushBar
    float zoneInner
    float zoneOuter
    box   zoneBox
    label innerLabel
    label outerLabel
    line  innerProjLine
    line  outerProjLine

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

//Return the side to idle. Completed structures keep their zone drawings, voided ones are wiped
resetSide(SideState s, bool keepZone) =>
    if not na(s.innerProjLine)
        line.delete(s.innerProjLine)
    if not na(s.outerProjLine)
        line.delete(s.outerProjLine)
    if not keepZone
        if not na(s.zoneBox)
            box.delete(s.zoneBox)
        if not na(s.innerLabel)
            label.delete(s.innerLabel)
        if not na(s.outerLabel)
            label.delete(s.outerLabel)
    s.innerProjLine := line(na)
    s.outerProjLine := line(na)
    s.zoneBox       := box(na)
    s.innerLabel    := label(na)
    s.outerLabel    := label(na)
    s.stage         := STAGE_IDLE
    s.startBar      := na
    s.rsiFirst      := na
    s.rsiFirstBar   := na
    s.priceFirst    := na
    s.priceFirstBar := na
    s.rsiPull       := na
    s.rsiPullBar    := na
    s.pricePull     := na
    s.pricePullBar  := na
    s.shoulderRsi   := na
    s.shoulderBar   := na
    s.pushPrice     := na
    s.pushBar       := na
    s.zoneInner     := na
    s.zoneOuter     := na

//Open a fresh sequence on an initial extreme reading (stage 1 of the page's staged description)
anchorFirst(SideState s, bool isBear, float rsiValue) =>
    s.stage         := STAGE_FIRST
    s.startBar      := bar_index
    s.rsiFirst      := rsiValue
    s.rsiFirstBar   := bar_index
    s.priceFirst    := isBear ? high : low
    s.priceFirstBar := bar_index

//Reversal signal: draw the M/W structure on the oscillator, its divergence counterpart on price,
//freeze the completion zone and hand the trade to momentum-based management
confirmSignal(SideState s, bool isBear) =>
    color sideColor = isBear ? bearColorInput : bullColorInput
    if showStructInput
        line.new(s.rsiFirstBar, s.rsiFirst, s.rsiPullBar, s.rsiPull, color = sideColor, width = 2)
        line.new(s.rsiPullBar, s.rsiPull, s.shoulderBar, s.shoulderRsi, color = sideColor, width = 2)
        line.new(s.rsiFirstBar, s.rsiFirst, s.shoulderBar, s.shoulderRsi, color = color.new(sideColor, 40), style = line.style_dotted)
    if showDivInput
        line.new(s.priceFirstBar, s.priceFirst, s.pushBar, s.pushPrice, color = sideColor, style = line.style_dotted, width = 2, force_overlay = true)
    if showLabelsInput
        float zoneLo = math.min(s.zoneInner, s.zoneOuter)
        float zoneHi = math.max(s.zoneInner, s.zoneOuter)
        string tipText = (isBear ? "Bearish RSI BAMM (M shape): first test " : "Bullish RSI BAMM (W shape): first test ") + str.tostring(s.rsiFirst, "#.##") + ", failed second test " + str.tostring(s.shoulderRsi, "#.##") + " - price made a new extreme while RSI did not. Completion zone " + str.tostring(zoneLo, format.mintick) + " to " + str.tostring(zoneHi, format.mintick) + "."
        label.new(s.shoulderBar, s.shoulderRsi, isBear ? "M" : "W", style = isBear ? label.style_label_down : label.style_label_up, color = TRANSP_COLOR, textcolor = sideColor, size = size.small, tooltip = tipText)
    if not na(s.zoneBox)
        box.set_right(s.zoneBox, bar_index)
    s.stage := STAGE_MANAGE

//Advance one side of the methodology by one confirmed bar; returns the side's events
processSide(SideState s, bool isBear, float rsiValue, bool intoExtreme, bool outOfExtreme, float pivotValue, int pivotBarIndex) =>
    bool triggeredEvent   = false
    bool signalEvent      = false
    bool manageEvent      = false
    bool invalidatedEvent = false
    if barstate.isconfirmed and not na(rsiValue)
        color sideColor         = isBear ? bearColorInput : bullColorInput
        float intermediateLevel = isBear ? intermediateInput : 100.0 - intermediateInput
        //Stale sequences are abandoned rather than kept alive indefinitely
        if s.stage != STAGE_IDLE and bar_index - s.startBar > timeoutInput
            resetSide(s, s.stage == STAGE_MANAGE)
        if s.stage == STAGE_IDLE
            //Stage 1: RSI registers an initial extreme, establishing that momentum is stretched
            if intoExtreme
                anchorFirst(s, isBear, rsiValue)
        else if s.stage == STAGE_FIRST
            //Track the most extreme RSI reading and price extreme of the first test
            if (isBear ? rsiValue > s.rsiFirst : rsiValue < s.rsiFirst)
                s.rsiFirst    := rsiValue
                s.rsiFirstBar := bar_index
            if (isBear ? high > s.priceFirst : low < s.priceFirst)
                s.priceFirst    := isBear ? high : low
                s.priceFirstBar := bar_index
            //Stage 2 begins when RSI leaves the extreme zone: price and RSI pull back
            if outOfExtreme
                s.stage        := STAGE_PULL
                s.rsiPull      := rsiValue
                s.rsiPullBar   := bar_index
                s.pricePull    := isBear ? low : high
                s.pricePullBar := bar_index
        else if s.stage == STAGE_PULL
            //Track the pullback extremes on both the oscillator and price
            if (isBear ? rsiValue < s.rsiPull : rsiValue > s.rsiPull)
                s.rsiPull     := rsiValue
                s.rsiPullBar  := bar_index
                s.shoulderRsi := na
                s.shoulderBar := na
            if (isBear ? low < s.pricePull : high > s.pricePull)
                s.pricePull    := isBear ? low : high
                s.pricePullBar := bar_index
            //A confirmed RSI swing after the pullback extreme, weaker than the first reading, is the candidate second shoulder
            if not na(pivotValue) and pivotBarIndex > s.rsiPullBar and (isBear ? pivotValue < s.rsiFirst : pivotValue > s.rsiFirst)
                s.shoulderRsi := pivotValue
                s.shoulderBar := pivotBarIndex
            //Completion measurements on the first test -> pullback leg, bracketing the first price extreme
            float legSpan    = isBear ? s.priceFirst - s.pricePull : s.pricePull - s.priceFirst
            float innerLevel = isBear ? s.pricePull + retracementInput * legSpan : s.pricePull - retracementInput * legSpan
            float outerLevel = isBear ? s.pricePull + extensionInput * legSpan : s.pricePull - extensionInput * legSpan
            if (isBear ? rsiValue > s.rsiFirst : rsiValue < s.rsiFirst)
                //Momentum exceeded the first reading - no failed test possible, the visit re-anchors as a fresh first test
                resetSide(s, false)
                anchorFirst(s, isBear, rsiValue)
            else if (isBear ? rsiValue < intermediateLevel : rsiValue > intermediateLevel)
                //The pullback resolved the trend instead of holding it - forming structure void
                resetSide(s, false)
            else if (isBear ? high > s.priceFirst : low < s.priceFirst) and legSpan > 0
                //Stage 3, the trigger: a second push to new price extremes while RSI fails to exceed its first reading
                if (isBear ? close > outerLevel : close < outerLevel)
                    //Arrival bar already closed beyond the outer measurement - nothing left to complete
                    resetSide(s, false)
                else
                    if not na(s.innerProjLine)
                        line.delete(s.innerProjLine)
                        s.innerProjLine := line(na)
                    if not na(s.outerProjLine)
                        line.delete(s.outerProjLine)
                        s.outerProjLine := line(na)
                    s.zoneInner := innerLevel
                    s.zoneOuter := outerLevel
                    s.pushPrice := isBear ? high : low
                    s.pushBar   := bar_index
                    s.stage     := STAGE_FINAL
                    triggeredEvent := true
                    if showZoneInput
                        s.zoneBox    := box.new(bar_index, math.max(innerLevel, outerLevel), bar_index, math.min(innerLevel, outerLevel), border_color = color.new(sideColor, 30), border_style = line.style_dashed, bgcolor = color.new(sideColor, 85), force_overlay = true)
                        s.innerLabel := label.new(bar_index, innerLevel, str.tostring(retracementInput), style = label.style_label_left, color = TRANSP_COLOR, textcolor = color.new(sideColor, 20), size = size.tiny, force_overlay = true)
                        s.outerLabel := label.new(bar_index, outerLevel, str.tostring(extensionInput), style = label.style_label_left, color = TRANSP_COLOR, textcolor = color.new(sideColor, 20), size = size.tiny, force_overlay = true)
                    //The RSI may have rolled over before price printed its new extreme - signal immediately in that case
                    if not na(s.shoulderBar)
                        confirmSignal(s, isBear)
                        signalEvent := true
            else if showProjectionInput and legSpan > 0
                //Early warning: the projected completion area is drawn while the pullback develops, before price arrives
                if not na(s.innerProjLine)
                    line.delete(s.innerProjLine)
                if not na(s.outerProjLine)
                    line.delete(s.outerProjLine)
                s.innerProjLine := line.new(s.pricePullBar, innerLevel, bar_index + 3, innerLevel, color = color.new(sideColor, 30), style = line.style_dotted, force_overlay = true)
                s.outerProjLine := line.new(s.pricePullBar, outerLevel, bar_index + 3, outerLevel, color = color.new(sideColor, 50), style = line.style_dotted, force_overlay = true)
        else if s.stage == STAGE_FINAL
            //The final leg is underway - follow its extreme for the divergence line
            if (isBear ? high > s.pushPrice : low < s.pushPrice)
                s.pushPrice := isBear ? high : low
                s.pushBar   := bar_index
            if not na(s.zoneBox)
                box.set_right(s.zoneBox, bar_index)
            //Late rollover: the second shoulder can also confirm after the trigger while price works through the zone
            bool freshShoulder = false
            if not na(pivotValue) and pivotBarIndex > s.rsiPullBar and (isBear ? pivotValue < s.rsiFirst : pivotValue > s.rsiFirst)
                s.shoulderRsi := pivotValue
                s.shoulderBar := pivotBarIndex
                freshShoulder := true
            if (isBear ? rsiValue > s.rsiFirst : rsiValue < s.rsiFirst)
                //Momentum confirmed the new price extreme after all - divergence voided, fresh first test
                resetSide(s, false)
                anchorFirst(s, isBear, rsiValue)
            else if (isBear ? close > s.zoneOuter : close < s.zoneOuter)
                //Decisive close beyond the outer measurement - completion overrun, setup invalidated
                resetSide(s, false)
                invalidatedEvent := true
            else if freshShoulder
                //Entry timing per the page: price in the harmonic area and RSI rolling over from its failed second test
                confirmSignal(s, isBear)
                signalEvent := true
        else if s.stage == STAGE_MANAGE
            if intoExtreme
                //A brand-new extreme reading restarts the sequence; completed drawings stay on the chart
                resetSide(s, true)
                anchorFirst(s, isBear, rsiValue)
            else if (isBear ? rsiValue < intermediateLevel : rsiValue > intermediateLevel)
                //Exit management: RSI recrossing the intermediate threshold is the momentum-based reason to tighten or exit
                manageEvent := true
                resetSide(s, true)
    [triggeredEvent, signalEvent, manageEvent, invalidatedEvent]

stageText(int stageValue) =>
    switch stageValue
        STAGE_FIRST  => "First test"
        STAGE_PULL   => "Pullback"
        STAGE_FINAL  => "Final leg"
        STAGE_MANAGE => "Managing"
        => "Waiting"

zoneText(SideState s) =>
    s.stage == STAGE_FINAL or s.stage == STAGE_MANAGE ? str.tostring(math.min(s.zoneInner, s.zoneOuter), format.mintick) + " - " + str.tostring(math.max(s.zoneInner, s.zoneOuter), format.mintick) : "—"

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{

float rsiValue = ta.rsi(sourceInput, rsiLengthInput)

bool bearInto = ta.crossover(rsiValue, obLevelInput)
bool bearOut  = ta.crossunder(rsiValue, obLevelInput)
bool bullInto = ta.crossunder(rsiValue, osLevelInput)
bool bullOut  = ta.crossover(rsiValue, osLevelInput)

//Confirmed RSI swings used as the rollover evidence of the failed second test
float rsiPivotHigh = ta.pivothigh(rsiValue, rolloverInput, rolloverInput)
float rsiPivotLow  = ta.pivotlow(rsiValue, rolloverInput, rolloverInput)
int   rsiPivotBar  = bar_index - rolloverInput

var SideState bearSide = SideState.new(STAGE_IDLE)
var SideState bullSide = SideState.new(STAGE_IDLE)

[bearTriggered, bearSignal, bearManage, bearInvalid] = processSide(bearSide, true, rsiValue, bearInto, bearOut, rsiPivotHigh, rsiPivotBar)
[bullTriggered, bullSignal, bullManage, bullInvalid] = processSide(bullSide, false, rsiValue, bullInto, bullOut, rsiPivotLow, rsiPivotBar)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

color oscColor = rsiValue > CENTER_LEVEL ? bullColorInput : bearColorInput

oscPlotId = plot(rsiValue, "RSI", oscColor, 1)

centerPlotId = plot(CENTER_LEVEL, "Center Anchor", editable = false, display = display.none)

//Vertical gradient fill from the midpoint to the RSI value, fully transparent at the midpoint
fill(oscPlotId, centerPlotId
  , top_value    = math.max(rsiValue, CENTER_LEVEL)
  , bottom_value = math.min(rsiValue, CENTER_LEVEL)
  , top_color    = rsiValue > CENTER_LEVEL ? color.new(bullColorInput, HALF_TRANSP) : color.new(bearColorInput, FULL_TRANSP)
  , bottom_color = rsiValue > CENTER_LEVEL ? color.new(bullColorInput, FULL_TRANSP) : color.new(bearColorInput, HALF_TRANSP)
  , title        = "Gradient Fill")

//Dashed extreme thresholds and dotted intermediate reference(s)
if barstate.isfirst
    line.new(bar_index, obLevelInput, bar_index + 1, obLevelInput, extend = extend.both, color = levelsColorInput, style = line.style_dashed)
    line.new(bar_index, osLevelInput, bar_index + 1, osLevelInput, extend = extend.both, color = levelsColorInput, style = line.style_dashed)
    line.new(bar_index, intermediateInput, bar_index + 1, intermediateInput, extend = extend.both, color = color.new(levelsColorInput, HALF_TRANSP), style = line.style_dotted)
    if intermediateInput != 100.0 - intermediateInput
        line.new(bar_index, 100.0 - intermediateInput, bar_index + 1, 100.0 - intermediateInput, extend = extend.both, color = color.new(levelsColorInput, HALF_TRANSP), style = line.style_dotted)

plotshape(showSignalsInput and bearSignal, "Bearish Reversal", shape.triangledown, location.abovebar, bearColorInput, size = size.tiny, force_overlay = true)
plotshape(showSignalsInput and bullSignal, "Bullish Reversal", shape.triangleup, location.belowbar, bullColorInput, size = size.tiny, force_overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{

dashLocation = switch dashLocationInput
    TOP_RIGHT_OPTION    => position.top_right
    TOP_LEFT_OPTION     => position.top_left
    BOTTOM_RIGHT_OPTION => position.bottom_right
    => position.bottom_left

dashTextSize = switch dashSizeInput
    TINY_OPTION  => size.tiny
    SMALL_OPTION => size.small
    => size.normal

var table dashTable = table.new(dashLocation, 3, 3, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if showDashInput and barstate.islast
    table.cell(dashTable, 0, 0, "Side", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, "Stage", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 2, 0, "Completion Zone", text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 1, "Bearish M", text_color = bearColorInput, text_size = dashTextSize, text_halign = text.align_left, tooltip = "Sequence at highs: first RSI test beyond the overbought level, pullback, then a second push to new price highs on weaker RSI.")
    table.cell(dashTable, 1, 1, stageText(bearSide.stage), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 2, 1, zoneText(bearSide), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, "Bullish W", text_color = bullColorInput, text_size = dashTextSize, text_halign = text.align_left, tooltip = "Sequence at lows: first RSI test under the oversold level, pullback, then a second push to new price lows on stronger RSI.")
    table.cell(dashTable, 1, 2, stageText(bullSide.stage), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 2, 2, zoneText(bullSide), text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bearTriggered, "Bearish Second Test", "RSI BAMM bearish trigger on {{ticker}} ({{interval}}) - price pushed to a new high while the RSI second test failed; the final leg toward the completion zone may be underway")

alertcondition(bullTriggered, "Bullish Second Test", "RSI BAMM bullish trigger on {{ticker}} ({{interval}}) - price pushed to a new low while the RSI second test held above its first reading; the final leg toward the completion zone may be underway")

alertcondition(bearSignal, "Bearish Reversal Signal", "RSI BAMM bearish signal on {{ticker}} ({{interval}}) - price is in the harmonic completion area and RSI rolled over from its failed second test")

alertcondition(bullSignal, "Bullish Reversal Signal", "RSI BAMM bullish signal on {{ticker}} ({{interval}}) - price is in the harmonic completion area and RSI turned up from its failed second test")

alertcondition(bearManage, "Bearish Exit Management", "RSI BAMM bearish management on {{ticker}} ({{interval}}) - RSI crossed under the intermediate level after the signal, a momentum-based reason to tighten or exit")

alertcondition(bullManage, "Bullish Exit Management", "RSI BAMM bullish management on {{ticker}} ({{interval}}) - RSI crossed above the intermediate level after the signal, a momentum-based reason to tighten or exit")

alertcondition(bearInvalid, "Bearish Setup Invalidated", "RSI BAMM bearish setup invalidated on {{ticker}} ({{interval}}) - price closed beyond the outer completion measurement before any reversal signal")

alertcondition(bullInvalid, "Bullish Setup Invalidated", "RSI BAMM bullish setup invalidated on {{ticker}} ({{interval}}) - price closed beyond the outer completion measurement before any reversal signal")

//---------------------------------------------------------------------------------------------------------------------}
