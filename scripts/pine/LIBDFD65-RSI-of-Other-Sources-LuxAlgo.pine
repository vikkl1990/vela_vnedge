//@version=6
indicator("RSI of Other Sources", "RSI of Other Sources", overlay = false, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MIDLINE = 50

SRC_CUSTOM = "Custom Source"
SRC_OBV    = "On-Balance Volume"
SRC_VOLUME = "Volume"
SRC_VWAP   = "VWAP Distance"
SRC_MOM    = "Momentum"
SRC_ROC    = "Rate of Change"
SRC_SYMBOL = "Other Symbol"

SMOOTH_NONE = "None"
SMOOTH_SMA  = "SMA"
SMOOTH_EMA  = "EMA"
SMOOTH_WMA  = "WMA"
SMOOTH_RMA  = "RMA"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
appliedToInput = input.string(SRC_OBV, "Applied To"
  , options = [SRC_CUSTOM, SRC_OBV, SRC_VOLUME, SRC_VWAP, SRC_MOM, SRC_ROC, SRC_SYMBOL]
  , group   = "Settings"
  , tooltip = "Series the RSI formula is applied to. Wilder's arithmetic never changes, only the question being asked does. On-Balance Volume asks whether cumulative volume flow is accelerating or stalling, Volume tracks raw participation, VWAP Distance measures how far price is stretched from the session VWAP, Momentum and Rate of Change read acceleration rather than direction, Other Symbol reads a different market, and Custom Source accepts any series, including another indicator's plot.")

lengthInput = input.int(14, "RSI Length", minval = 2
  , group   = "Settings"
  , tooltip = "Number of bars used by Wilder's smoothing when averaging the gains and losses of the selected series. Also used for the price RSI comparison. 14 is Wilder's published default.")

customSourceInput = input.source(close, "Custom Source"
  , group   = "Settings"
  , tooltip = "Series used when 'Applied To' is set to Custom Source, and the base series for the Momentum and Rate of Change options. Select another indicator's plot from the dropdown to run the RSI formula on its output.")

momLengthInput = input.int(10, "Momentum/ROC Length", minval = 1
  , group   = "Settings"
  , tooltip = "Lookback of the Momentum and Rate of Change options, both measured on the Custom Source series.")

symbolInput = input.symbol("", "Other Symbol"
  , group   = "Settings"
  , tooltip = "Symbol used when 'Applied To' is set to Other Symbol. Its closing price is requested on the chart timeframe and fed to the RSI formula. Leave empty to use the chart symbol.")

smoothTypeInput = input.string(SMOOTH_NONE, "Input Smoothing", inline = "smoothing"
  , options = [SMOOTH_NONE, SMOOTH_SMA, SMOOTH_EMA, SMOOTH_WMA, SMOOTH_RMA]
  , group   = "Settings"
  , tooltip = "Optional moving average applied to the selected series before its gain/loss balance is measured. RSI of a smoothed input trades speed for fewer whipsaws, which is not the same as smoothing the RSI output afterward.")

smoothLengthInput = input.int(14, "", minval = 1, inline = "smoothing"
  , group   = "Settings"
  , tooltip = "Length of the input smoothing moving average.")

//---------------------------------------------------------------------------------------------------------------------}
// Thresholds
//---------------------------------------------------------------------------------------------------------------------{
obInput = input.float(70, "Overbought", minval = 0, maxval = 100, step = 1
  , group   = "Thresholds"
  , tooltip = "Level treated as overbought. The 70/30 convention was calibrated on price closes, a derived series can spend far more or far less time at extremes, so scan the derived line across long history and set this from its observed range.")

osInput = input.float(30, "Oversold", minval = 0, maxval = 100, step = 1
  , group   = "Thresholds"
  , tooltip = "Level treated as oversold. Recheck it per source, a cumulative input such as OBV can pin at extremes far longer than price RSI does, while a choppier input may rarely reach them.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(#089981, "Bullish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of the oscillator above the 50 midline.")

bearColorInput = input.color(#f23645, "Bearish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of the oscillator below the 50 midline.")

gradientFillInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between the oscillator and the 50 midline, fully transparent at the midline and more opaque at the oscillator value.")

showPriceRsiInput = input.bool(true, "Price RSI Comparison", inline = "price"
  , group   = "Style"
  , tooltip = "Plot the close-based RSI of the same length alongside the derived line. The derived line earns its place by confirming or contradicting the price-based view, disagreement flags moves that lack support from the selected series.")

priceRsiColorInput = input.color(#787b86, "", inline = "price"
  , group   = "Style"
  , tooltip = "Color of the price RSI comparison line.")

levelsColorInput = input.color(#787b86, "Levels Color"
  , group   = "Style"
  , tooltip = "Color of the dashed overbought/oversold levels and of the dotted midline.")

//---------------------------------------------------------------------------------------------------------------------}
// Source Series
//---------------------------------------------------------------------------------------------------------------------{
// Every candidate series is computed unconditionally on each bar, the selection below only picks one of them
obvSeries    = ta.obv
volumeSeries = volume
vwapSeries   = close - ta.vwap
momSeries    = ta.mom(customSourceInput, momLengthInput)
rocSeries    = ta.roc(customSourceInput, momLengthInput)
symbolSeries = request.security(symbolInput == "" ? syminfo.tickerid : symbolInput, timeframe.period, close)

rawSeries = switch appliedToInput
    SRC_OBV    => obvSeries
    SRC_VOLUME => volumeSeries
    SRC_VWAP   => vwapSeries
    SRC_MOM    => momSeries
    SRC_ROC    => rocSeries
    SRC_SYMBOL => symbolSeries
    => customSourceInput

// Optional pre-smoothing of the input, all averages evaluated unconditionally
smaSeries = ta.sma(rawSeries, smoothLengthInput)
emaSeries = ta.ema(rawSeries, smoothLengthInput)
wmaSeries = ta.wma(rawSeries, smoothLengthInput)
rmaSeries = ta.rma(rawSeries, smoothLengthInput)

smoothedSeries = switch smoothTypeInput
    SMOOTH_SMA => smaSeries
    SMOOTH_EMA => emaSeries
    SMOOTH_WMA => wmaSeries
    SMOOTH_RMA => rmaSeries
    => rawSeries

//---------------------------------------------------------------------------------------------------------------------}
// RSI
//---------------------------------------------------------------------------------------------------------------------{
// Wilder's RSI (RMA based) applied to the selected series, and to close for the comparison line
rsiValue = ta.rsi(smoothedSeries, lengthInput)
priceRsi = ta.rsi(close, lengthInput)

bullishMidCross = ta.crossover(rsiValue, MIDLINE)
bearishMidCross = ta.crossunder(rsiValue, MIDLINE)
overboughtEntry = ta.crossover(rsiValue, obInput)
overboughtExit  = ta.crossunder(rsiValue, obInput)
oversoldEntry   = ta.crossunder(rsiValue, osInput)
oversoldExit    = ta.crossover(rsiValue, osInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
rsiColor = rsiValue > MIDLINE ? bullColorInput : bearColorInput

fillTopColor    = rsiValue > MIDLINE ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)
fillBottomColor = rsiValue > MIDLINE ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)

priceRsiPlotId = plot(showPriceRsiInput ? priceRsi : na, "Price RSI", priceRsiColorInput, 1)
rsiPlotId      = plot(rsiValue, "RSI", rsiColor, 1)
midPlotId      = plot(MIDLINE, "Midline", editable = false, display = display.none)

fill(rsiPlotId, midPlotId
  , math.max(rsiValue, MIDLINE)
  , math.min(rsiValue, MIDLINE)
  , gradientFillInput ? fillTopColor : na
  , gradientFillInput ? fillBottomColor : na)

hline(obInput, "Overbought", levelsColorInput, hline.style_dashed)
hline(osInput, "Oversold", levelsColorInput, hline.style_dashed)
hline(MIDLINE, "Midline", color.new(levelsColorInput, 50), hline.style_dotted)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullishMidCross, "Bullish Midline Cross", "RSI of Other Sources crossed above 50, bar-to-bar changes in the selected series are tilting positive")
alertcondition(bearishMidCross, "Bearish Midline Cross", "RSI of Other Sources crossed below 50, bar-to-bar changes in the selected series are tilting negative")
alertcondition(overboughtEntry, "Overbought Entry", "RSI of Other Sources crossed above its overbought level")
alertcondition(overboughtExit, "Overbought Exit", "RSI of Other Sources crossed back below its overbought level")
alertcondition(oversoldEntry, "Oversold Entry", "RSI of Other Sources crossed below its oversold level")
alertcondition(oversoldExit, "Oversold Exit", "RSI of Other Sources crossed back above its oversold level")

//---------------------------------------------------------------------------------------------------------------------}
