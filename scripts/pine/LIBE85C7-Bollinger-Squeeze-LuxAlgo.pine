//@version=6
indicator("Bollinger Squeeze", shorttitle = "Bollinger Squeeze", overlay = true, max_boxes_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MODE_LOWEST  = "Lowest BandWidth"
MODE_PCTL    = "BandWidth Percentile"
MODE_KELTNER = "Inside Keltner Channels"

NEUTRAL_COLOR = #787b86 // bands while volatility is not compressed - structure
SQUEEZE_COLOR = #ff9800 // bands and squeeze range while the squeeze is on
BULL_COLOR    = #089981 // bullish release
BEAR_COLOR    = #f23645 // bearish release

FILL_EDGE_TRANSP  = 80  // band gradient transparency at the outer bands
FILL_BASIS_TRANSP = 100 // band gradient transparency at the basis
BOX_BG_TRANSP     = 92  // squeeze range background transparency
BOX_FADE_TRANSP   = 96  // background of ranges left without a qualifying release
FADE_TRANSP       = 60  // border and text of ranges left without a qualifying release

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 2
  , group   = "Bollinger Bands"
  , tooltip = "Number of bars for the simple moving average basis and for the standard deviation. John Bollinger's default is 20.")

srcInput = input.source(close, "Source"
  , group   = "Bollinger Bands"
  , tooltip = "Price series used for the basis, the standard deviation and BandWidth. Default close.")

multInput = input.float(2.0, "Multiplier", minval = 0.1, step = 0.1
  , group   = "Bollinger Bands"
  , tooltip = "Standard deviation multiplier for the upper and lower bands. Default 2 standard deviations above and below the basis.")

modeInput = input.string(MODE_LOWEST, "Squeeze Test", options = [MODE_LOWEST, MODE_PCTL, MODE_KELTNER]
  , group   = "Squeeze Detection"
  , tooltip = "Lowest BandWidth - squeeze while BandWidth sits at its lowest level of the lookback, John Bollinger's definition. BandWidth Percentile - squeeze while the BandWidth percentile rank over the lookback is at or below the floor. Inside Keltner Channels - squeeze while both Bollinger Bands sit inside the Keltner Channels, the test popularized by the TTM Squeeze.")

lookbackInput = input.int(125, "Squeeze Lookback", minval = 2
  , group   = "Squeeze Detection"
  , tooltip = "Window used by the Lowest BandWidth and BandWidth Percentile tests. Bollinger's guideline is the lowest reading in about six months, roughly 125 daily bars.")

percentileInput = input.float(10, "Percentile Floor", minval = 0, maxval = 100, step = 1
  , group   = "Squeeze Detection"
  , tooltip = "BandWidth Percentile test only. Flags a squeeze while the percentile rank of BandWidth over the lookback is at or below this value, keeping only readings near the bottom of their historical range.")

kcLengthInput = input.int(20, "Keltner Length", minval = 1
  , group   = "Squeeze Detection"
  , tooltip = "Inside Keltner Channels test only. Basis and ATR length of the Keltner Channels the bands must trade inside.")

kcMultInput = input.float(1.5, "Keltner Multiplier", minval = 0.1, step = 0.1
  , group   = "Squeeze Detection"
  , tooltip = "Inside Keltner Channels test only. ATR multiplier of the Keltner Channels. The popularized default of 1.5 demands the bands compress well inside the channels before the squeeze turns on.")

showRangeInput = input.bool(true, "Show Range"
  , group   = "Squeeze Range"
  , tooltip = "Draws a box around the price range that forms during the squeeze and extends it until price closes beyond it. The release side is read from that break, never from the squeeze itself.")

showLastInput = input.int(10, "Show Last", minval = 1, maxval = 250
  , group   = "Squeeze Range"
  , tooltip = "Number of most recent squeeze ranges kept on the chart.")

showDurationInput = input.bool(true, "Show Duration"
  , group   = "Squeeze Range"
  , tooltip = "Writes the number of squeeze bars inside the range box. A squeeze has no fixed duration - it persists until volatility expands.")

showMarkersInput = input.bool(true, "Release Markers"
  , group   = "Squeeze Range"
  , tooltip = "Plots a triangle on the bar where price closes beyond the squeeze range while the bands expand. Bollinger warned the first break can be a head fake, so treat volume and follow-through as confirmation.")

showBandsInput = input.bool(true, "Show Bollinger Bands"
  , group   = "Style"
  , tooltip = "Displays the basis and the bands with a gradient fill. The bands recolor while a squeeze is active.")

bandColorInput = input.color(NEUTRAL_COLOR, "Bands"
  , group   = "Style"
  , tooltip = "Color of the Bollinger Bands and of their fill while no squeeze is active.")

squeezeColorInput = input.color(SQUEEZE_COLOR, "Squeeze"
  , group   = "Style"
  , tooltip = "Color of the bands and of the range box while the squeeze is on.")

bullColorInput = input.color(BULL_COLOR, "Bullish Release", inline = "release"
  , group   = "Style"
  , tooltip = "Color of bullish release markers and of ranges resolved by a close above them.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "release"
  , group   = "Style"
  , tooltip = "Color of bearish release markers and of ranges resolved by a close below them.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Bollinger Bands - simple moving average basis with bands a multiple of the population standard deviation away
basis = ta.sma(srcInput, lengthInput)
dev   = multInput * ta.stdev(srcInput, lengthInput)

upperBand = basis + dev
lowerBand = basis - dev

// BandWidth - band spread normalized by the middle band, comparable across time and across instruments
bandwidth = basis != 0 ? (upperBand - lowerBand) / basis : na

// Squeeze tests - each test is computed on every bar, the Squeeze Test input selects which one drives the state
lowestBw = ta.lowest(bandwidth, lookbackInput)
bwRank   = ta.percentrank(bandwidth, lookbackInput)

kcBasis = ta.sma(srcInput, kcLengthInput)
kcSpan  = kcMultInput * ta.atr(kcLengthInput)

lowestTest  = not na(bandwidth) and bandwidth <= lowestBw
pctlTest    = not na(bwRank) and bwRank <= percentileInput
keltnerTest = not na(upperBand) and not na(kcSpan) and upperBand < kcBasis + kcSpan and lowerBand > kcBasis - kcSpan

squeezeOn = switch modeInput
    MODE_LOWEST => lowestTest
    MODE_PCTL   => pctlTest
    =>             keltnerTest

// Release filter - bands turning outward, read as BandWidth rising bar over bar
bandsExpanding = not na(bandwidth) and not na(bandwidth[1]) and bandwidth > bandwidth[1]

//---------------------------------------------------------------------------------------------------------------------}
// Squeeze Ranges
//---------------------------------------------------------------------------------------------------------------------{
var box   rangeBox    = na
var float rangeHigh   = na
var float rangeLow    = na
var int   squeezeBars = 0
var bool  episodeOpen = false

var rangeBoxArray = array.new<box>()

bool squeezeStart = squeezeOn and not episodeOpen
bool releaseUp    = false
bool releaseDn    = false

if squeezeStart
    // a new compression begins - anchor the squeeze range on this bar
    episodeOpen := true
    rangeHigh   := high
    rangeLow    := low
    squeezeBars := 1
    if showRangeInput
        rangeBox := box.new(bar_index, rangeHigh, bar_index, rangeLow, border_color = squeezeColorInput, border_width = 1, border_style = line.style_dashed, bgcolor = color.new(squeezeColorInput, BOX_BG_TRANSP), text_size = size.tiny, text_color = squeezeColorInput, text_halign = text.align_left, text_valign = text.align_top)
        array.push(rangeBoxArray, rangeBox)
        if array.size(rangeBoxArray) > showLastInput
            box.delete(array.shift(rangeBoxArray))
else if episodeOpen
    // extend the range while the squeeze condition holds - once it lets go the box keeps waiting for the release
    if squeezeOn
        rangeHigh   := math.max(rangeHigh, high)
        rangeLow    := math.min(rangeLow, low)
        squeezeBars += 1
    releaseUp := bandsExpanding and close > rangeHigh
    releaseDn := bandsExpanding and close < rangeLow
    bool rangeLeft = close > rangeHigh or close < rangeLow
    if not na(rangeBox)
        box.set_right(rangeBox, bar_index)
        box.set_top(rangeBox, rangeHigh)
        box.set_bottom(rangeBox, rangeLow)
        if releaseUp or releaseDn
            color releaseColor = releaseUp ? bullColorInput : bearColorInput
            box.set_border_color(rangeBox, releaseColor)
            box.set_border_style(rangeBox, line.style_solid)
            box.set_bgcolor(rangeBox, color.new(releaseColor, BOX_BG_TRANSP))
            box.set_text_color(rangeBox, releaseColor)
        else if rangeLeft
            // price left the range without expanding bands - no qualifying release, fade the zone
            box.set_border_color(rangeBox, color.new(squeezeColorInput, FADE_TRANSP))
            box.set_bgcolor(rangeBox, color.new(squeezeColorInput, BOX_FADE_TRANSP))
            box.set_text_color(rangeBox, color.new(squeezeColorInput, FADE_TRANSP))
    if rangeLeft
        episodeOpen := false
        rangeBox    := na

if not na(rangeBox) and showDurationInput
    box.set_text(rangeBox, "Squeeze - " + str.tostring(squeezeBars) + (squeezeBars == 1 ? " bar" : " bars"))

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
bandColor     = squeezeOn ? squeezeColorInput : bandColorInput
bandLineColor = showBandsInput ? bandColor : na

upperPlotId = plot(upperBand, "Upper Band", bandLineColor, 1)
basisPlotId = plot(basis, "Basis", bandLineColor, 1)
lowerPlotId = plot(lowerBand, "Lower Band", bandLineColor, 1)

fill(basisPlotId, upperPlotId, top_value = upperBand, bottom_value = basis, top_color = showBandsInput ? color.new(bandColor, FILL_EDGE_TRANSP) : na, bottom_color = showBandsInput ? color.new(bandColor, FILL_BASIS_TRANSP) : na, title = "Upper Band Fill")
fill(basisPlotId, lowerPlotId, top_value = basis, bottom_value = lowerBand, top_color = showBandsInput ? color.new(bandColor, FILL_BASIS_TRANSP) : na, bottom_color = showBandsInput ? color.new(bandColor, FILL_EDGE_TRANSP) : na, title = "Lower Band Fill")

plotshape(showMarkersInput and releaseUp, "Bullish Release", shape.triangleup, location.belowbar, bullColorInput, size = size.tiny)
plotshape(showMarkersInput and releaseDn, "Bearish Release", shape.triangledown, location.abovebar, bearColorInput, size = size.tiny)

plot(bandwidth * 100, "BandWidth %", color = bandColorInput, display = display.data_window, precision = 2)
plot(episodeOpen ? squeezeBars : 0, "Squeeze Bars", color = squeezeColorInput, display = display.data_window, precision = 0)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(squeezeStart, "Squeeze On", "Bollinger Squeeze on {{ticker}}: volatility compressed into a squeeze - direction-neutral, watch for the release ({{interval}})")
alertcondition(releaseUp or releaseDn, "Squeeze Release", "Bollinger Squeeze release on {{ticker}}: price closed beyond the squeeze range as the bands expand ({{interval}})")
alertcondition(releaseUp, "Bullish Squeeze Release", "Bullish Bollinger Squeeze release on {{ticker}}: close above the squeeze range with expanding bands - first breaks can head-fake, confirm before leaning on it ({{interval}})")
alertcondition(releaseDn, "Bearish Squeeze Release", "Bearish Bollinger Squeeze release on {{ticker}}: close below the squeeze range with expanding bands - first breaks can head-fake, confirm before leaning on it ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
