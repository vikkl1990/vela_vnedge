//@version=6
indicator("Connors RSI", "CRSI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // oversold - the mean-reversion buy side, readings at or below the oversold level
BEAR_COLOR    = #f23645 // overbought - the mean-reversion sell side, readings at or above the overbought level
NEUTRAL_COLOR = #787b86 // readings midway between the levels, and the levels themselves

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_MID_TRANSP  = 100 // gradient transparency at the midpoint end of the fill
ZONE_TRANSP      = 92  // transparency of the soft overbought / oversold zone shading

SCALE_TOP    = 100 // bounded scale of the oscillator
SCALE_BOTTOM = 0
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
rsiLengthInput    = input.int(3, "RSI Length", minval = 1, group = "Settings", tooltip = "Length of the Wilder RSI applied to the closing price")
streakLengthInput = input.int(2, "Streak RSI Length", minval = 1, group = "Settings", tooltip = "Length of the Wilder RSI applied to the up/down close streak")
rankLengthInput   = input.int(100, "Percent Rank Length", minval = 1, group = "Settings", tooltip = "Lookback of the percent rank applied to the 1-bar rate of change of the closing price")

obLevelInput = input.float(90, "Overbought Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level above which the Connors RSI is considered overbought")
osLevelInput = input.float(10, "Oversold Level", minval = 0, maxval = 100, step = 1, group = "Settings", tooltip = "Level below which the Connors RSI is considered oversold")

crsiColorInput  = input.color(NEUTRAL_COLOR, "CRSI Line", group = "Style", tooltip = "Color of the Connors RSI line")
bullColorInput  = input.color(BULL_COLOR, "Oversold", inline = "state", group = "Style", tooltip = "Line, fill and zone color toward and below the oversold level - the mean-reversion buy side")
bearColorInput  = input.color(BEAR_COLOR, "Overbought", inline = "state", group = "Style", tooltip = "Line, fill and zone color toward and above the overbought level - the mean-reversion sell side")
levelColorInput = input.color(NEUTRAL_COLOR, "Levels", group = "Style", tooltip = "Color of the overbought and oversold levels")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
var int streak = 0

streak := close > close[1] ? math.max(nz(streak[1]), 0) + 1 : close < close[1] ? math.min(nz(streak[1]), 0) - 1 : 0

roc = ta.roc(close, 1)

crsi = (ta.rsi(close, rsiLengthInput) + ta.rsi(streak, streakLengthInput) + ta.percentrank(roc, rankLengthInput)) / 3
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring across the levels - oversold (buy side) toward the low level, neutral midway, overbought (sell side) toward the high level
midLevel  = (obLevelInput + osLevelInput) / 2
crsiColor = na(crsi) ? crsiColorInput : crsi <= midLevel ? color.from_gradient(crsi, osLevelInput, midLevel, bullColorInput, crsiColorInput) : color.from_gradient(crsi, midLevel, obLevelInput, crsiColorInput, bearColorInput)

crsiPlotId = plot(crsi, "Connors RSI", crsiColor)
midPlotId  = plot(midLevel, "Midpoint Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward the midpoint, following the line color
fill(crsiPlotId, midPlotId, math.max(crsi, midLevel), math.min(crsi, midLevel), crsi > midLevel ? color.new(crsiColor, FILL_LINE_TRANSP) : color.new(crsiColor, FILL_MID_TRANSP), crsi > midLevel ? color.new(crsiColor, FILL_MID_TRANSP) : color.new(crsiColor, FILL_LINE_TRANSP), title = "CRSI Gradient")

hline(obLevelInput, "Overbought", levelColorInput, hline.style_dashed)
hline(osLevelInput, "Oversold", levelColorInput, hline.style_dashed)

// Soft zone shading - overbought band above the upper level, oversold band below the lower level
obZoneId    = plot(obLevelInput, "Overbought Anchor", color(na), editable = false, display = display.none)
osZoneId    = plot(osLevelInput, "Oversold Anchor", color(na), editable = false, display = display.none)
topAnchorId = plot(SCALE_TOP, "Top Anchor", color(na), editable = false, display = display.none)
botAnchorId = plot(SCALE_BOTTOM, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(bearColorInput, ZONE_TRANSP), title = "Overbought Zone")
fill(osZoneId, botAnchorId, color.new(bullColorInput, ZONE_TRANSP), title = "Oversold Zone")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
overboughtEnter = ta.crossover(crsi, obLevelInput)
overboughtExit  = ta.crossunder(crsi, obLevelInput)
oversoldEnter   = ta.crossunder(crsi, osLevelInput)
oversoldExit    = ta.crossover(crsi, osLevelInput)

alertcondition(overboughtEnter, "Overbought", "Connors RSI crossed above the overbought level")
alertcondition(oversoldEnter, "Oversold", "Connors RSI crossed below the oversold level")
alertcondition(overboughtExit, "Overbought Exit", "Connors RSI crossed back below the overbought level")
alertcondition(oversoldExit, "Oversold Exit", "Connors RSI crossed back above the oversold level")
//----------------------------------------------------------------------------------------------------------------------}
