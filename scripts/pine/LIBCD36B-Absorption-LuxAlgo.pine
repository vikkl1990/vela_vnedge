//@version=6
indicator("Absorption", shorttitle = "Absorption", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 100)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR  = #787b86
MAX_CANDIDATES = 8
MAX_TEST_MARKS = 300
GRADE_SPAN     = 4

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
supInput      = input.bool(true, "Support Absorption (Bullish)", group = "Detection", tooltip = "Watch confirmed swing lows for passive buyers soaking up aggressive selling. A floor that refuses to break under heavy volume is a potentially bullish read.")
resInput      = input.bool(true, "Resistance Absorption (Bearish)", group = "Detection", tooltip = "Watch confirmed swing highs for passive sellers soaking up aggressive buying. A ceiling that refuses to break under heavy volume is a potentially bearish read.")
swingInput    = input.int(5, "Swing Length", minval = 2, maxval = 50, group = "Detection", tooltip = "Bars to the left and right of a swing point required to confirm it. Confirmed swings anchor the candidate levels absorption is measured against.")
reqTestsInput = input.int(3, "Required Tests", minval = 2, maxval = 10, group = "Detection", tooltip = "Qualifying tests a level must reject before absorption is flagged. Wyckoff reads ideally look for three or more approaches on clearly elevated volume.")
volLenInput   = input.int(20, "Average Length", minval = 2, maxval = 200, group = "Detection", tooltip = "Lookback of the simple averages used as baselines for volume (effort) and bar range (spread).")
effortInput   = input.float(1.5, "Elevated Volume", minval = 1.0, maxval = 5.0, step = 0.1, group = "Detection", tooltip = "An approach only counts as a test when its heaviest bar reaches this multiple of average volume — the clearly elevated effort poured into the level.")
narrowInput   = input.float(0.75, "Narrow Spread", minval = 0.1, maxval = 1.5, step = 0.05, group = "Detection", tooltip = "A bar counts as narrow when its range stays below this multiple of the average range. Heavy volume on a narrow bar is the classic effort-without-result signature.")
closeOffInput = input.float(50, "Close Off Extreme %", minval = 0, maxval = 90, step = 5, group = "Detection", tooltip = "Alternative signature: the close finishing at least this percentage of the bar range away from the tested extreme — well off the low at support, well off the high at resistance.")

widthInput   = input.float(0.25, "Zone Width", minval = 0.05, maxval = 2.0, step = 0.05, group = "Levels", tooltip = "Height of the level zone in ATR multiples, extended from the swing price into the market. Contact with this zone counts as an approach to the level.")
atrLenInput  = input.int(14, "ATR Length", minval = 1, maxval = 200, group = "Levels", tooltip = "ATR lookback used to scale the zone width, the break margin and the departure distance. The ATR at the level's creation is kept, so the zone does not breathe afterward.")
breakInput   = input.float(0.5, "Break Margin", minval = 0.0, maxval = 3.0, step = 0.1, group = "Levels", tooltip = "A level is decisively broken — absorption refuted — when price closes beyond the zone by this ATR multiple. The margin stands in for follow-through.")
departInput  = input.float(1.0, "Departure Distance", minval = 0.1, maxval = 5.0, step = 0.1, group = "Levels", tooltip = "Absorption is confirmed when price closes away from the zone by this ATR multiple — the easy departure proving the resting side took everything thrown at it.")
timeoutInput = input.int(500, "Zone Timeout", minval = 50, maxval = 5000, group = "Levels", tooltip = "Bars a level stays under watch. Candidates are dropped, and flagged zones are frozen as unresolved, once this age passes without a resolution.")

bullColorInput = input.color(#089981, "Bullish", inline = "colors", group = "Style", tooltip = "Color of support absorption zones, their test markers and statistics.")
bearColorInput = input.color(#f23645, "Bearish", inline = "colors", group = "Style", tooltip = "Color of resistance absorption zones, their test markers and statistics.")
marksInput     = input.bool(true, "Test Markers", group = "Style", tooltip = "Dot on the probe extreme of every qualifying test, drawn once the zone is flagged. Hover a dot for that test's effort.")
statsInput     = input.bool(true, "Zone Statistics", group = "Style", tooltip = "Label with the zone's test count, average effort and probe trend, updated to Level Held or Level Broken on resolution. Hover it for both resolution triggers.")
showLastInput  = input.int(8, "Resolved Zones Kept", minval = 1, maxval = 50, group = "Style", tooltip = "Number of resolved absorption zones kept on the chart before the oldest are removed.")

//---------------------------------------------------------------------------------------------------------------------}
// Types & Variables
//---------------------------------------------------------------------------------------------------------------------{
type Zone
    float level
    float top
    float bottom
    bool  isSup
    int   pivotBar
    int   createdBar
    float atrAtBirth
    int   tests        = 0
    float effortSum    = 0.0
    float probePrev
    float probeLast
    bool  inContact    = false
    float epiPeakVol   = 0.0
    bool  epiSig       = false
    float epiExtreme
    int   epiExtBar
    bool  qualified    = false
    int   qualifiedBar
    array<int>   testBars
    array<float> testPrices
    array<float> testEfforts
    box   bx
    label lb

type Events
    bool bullDet  = false
    bool bearDet  = false
    bool bullTest = false
    bool bearTest = false
    bool bullConf = false
    bool bearConf = false
    bool bullRef  = false
    bool bearRef  = false

var array<Zone>  zoneArray      = array.new<Zone>()
var array<box>   doneBoxArray   = array.new<box>()
var array<label> doneLabelArray = array.new<label>()
var array<label> testMarkArray  = array.new<label>()
var Events       ev             = Events.new()

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
atrValue     = ta.atr(atrLenInput)
volAverage   = ta.sma(nz(volume), volLenInput)
rangeAverage = ta.sma(high - low, volLenInput)

relVolume       = nz(volAverage) > 0 ? nz(volume) / volAverage : 0.0
barSpread       = high - low
narrowSpread    = nz(rangeAverage) > 0 and barSpread <= rangeAverage * narrowInput
closeOffLowPct  = barSpread > 0 ? (close - low) / barSpread * 100 : 50.0
closeOffHighPct = barSpread > 0 ? (high - close) / barSpread * 100 : 50.0

// effort-without-result signature on the bar: narrow spread, or a close well off the tested extreme
supSignal = narrowSpread or closeOffLowPct >= closeOffInput
resSignal = narrowSpread or closeOffHighPct >= closeOffInput

swingLow  = ta.pivotlow(swingInput, swingInput)
swingHigh = ta.pivothigh(swingInput, swingInput)

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// probes reaching less far into the level with each test — the defense holding its ground
isTightening(Zone z) =>
    not na(z.probePrev) and (z.isSup ? z.probeLast > z.probePrev : z.probeLast < z.probePrev)

// zone fill graded by how many tests the level has rejected
zoneFill(Zone z) =>
    color side = z.isSup ? bullColorInput : bearColorInput
    color.from_gradient(z.tests, reqTestsInput, reqTestsInput + GRADE_SPAN, color.new(side, 90), color.new(side, 70))

zoneText(Zone z, string status) =>
    float avgEffort = z.tests > 0 ? z.effortSum / z.tests : 0.0
    "Absorption ×" + str.tostring(z.tests) + " · " + str.tostring(avgEffort, "#.0") + "× vol" + (isTightening(z) ? " · tightening" : "") + (status == "" ? "" : " · " + status)

zoneTip(Zone z) =>
    float confirmAt = z.isSup ? z.top + z.atrAtBirth * departInput : z.bottom - z.atrAtBirth * departInput
    float refuteAt  = z.isSup ? z.bottom - z.atrAtBirth * breakInput : z.top + z.atrAtBirth * breakInput
    float avgEffort = z.tests > 0 ? z.effortSum / z.tests : 0.0
    "Tests rejected: " + str.tostring(z.tests) + " | Avg effort: " + str.tostring(avgEffort, "#.0") + "× average volume | Probes: " + (isTightening(z) ? "tightening" : "—") + "\nConfirmed by close " + (z.isSup ? "above " : "below ") + str.tostring(confirmAt, format.mintick) + " (easy departure)" + "\nRefuted by close " + (z.isSup ? "below " : "above ") + str.tostring(refuteAt, format.mintick) + " (decisive break)"

drawTestMark(Zone z, int idx) =>
    if marksInput and idx >= 0 and idx < array.size(z.testBars)
        color side = z.isSup ? bullColorInput : bearColorInput
        string tip = "Test " + str.tostring(idx + 1) + " — effort " + str.tostring(array.get(z.testEfforts, idx), "#.0") + "× average volume, rejected at the level"
        array.push(testMarkArray, label.new(array.get(z.testBars, idx), array.get(z.testPrices, idx), "", style = label.style_circle, color = color.new(side, 30), size = size.tiny, tooltip = tip))
        while array.size(testMarkArray) > MAX_TEST_MARKS
            label.delete(array.shift(testMarkArray))

// fold the bar at `offsetJ` into the running contact episode (one episode = one approach to the level)
updEpisode(Zone z, int offsetJ) =>
    float effortNow = relVolume[offsetJ]
    bool  sigNow    = z.isSup ? supSignal[offsetJ] : resSignal[offsetJ]
    float extNow    = z.isSup ? low[offsetJ] : high[offsetJ]
    if not z.inContact
        z.inContact  := true
        z.epiPeakVol := effortNow
        z.epiSig     := sigNow
        z.epiExtreme := extNow
        z.epiExtBar  := bar_index - offsetJ
    else
        if effortNow > z.epiPeakVol
            z.epiPeakVol := effortNow
        z.epiSig := z.epiSig or sigNow
        if (z.isSup ? extNow < z.epiExtreme : extNow > z.epiExtreme)
            z.epiExtreme := extNow
            z.epiExtBar  := bar_index - offsetJ

// an approach ends once price leaves the zone: it counts as a test only on elevated effort with the stalled-result signature
endEpisode(Zone z) =>
    if z.inContact
        z.inContact := false
        if z.epiPeakVol >= effortInput and z.epiSig
            z.tests     := z.tests + 1
            z.effortSum := z.effortSum + z.epiPeakVol
            z.probePrev := z.probeLast
            z.probeLast := z.epiExtreme
            array.push(z.testBars,    z.epiExtBar)
            array.push(z.testPrices,  z.epiExtreme)
            array.push(z.testEfforts, z.epiPeakVol)
            if z.qualified
                drawTestMark(z, array.size(z.testBars) - 1)
                if z.isSup
                    ev.bullTest := true
                else
                    ev.bearTest := true

// enough rejected tests: flag the level as absorption and draw it from its anchoring swing
qualifyZone(Zone z) =>
    z.qualified    := true
    z.qualifiedBar := bar_index
    color side = z.isSup ? bullColorInput : bearColorInput
    z.bx := box.new(z.pivotBar, z.top, bar_index, z.bottom, border_color = color.new(side, 40), border_width = 1, bgcolor = zoneFill(z))
    if statsInput
        z.lb := label.new(bar_index, math.avg(z.top, z.bottom), zoneText(z, ""), style = label.style_label_left, color = #00000000, textcolor = side, size = size.small, tooltip = zoneTip(z))
    if marksInput and array.size(z.testBars) > 0
        for i = 0 to array.size(z.testBars) - 1
            drawTestMark(z, i)
    if z.isSup
        ev.bullDet := true
    else
        ev.bearDet := true

finalizeZone(Zone z, string status, bool levelBroke) =>
    if not na(z.bx)
        z.bx.set_right(bar_index)
        if levelBroke
            z.bx.set_border_style(line.style_dashed)
        array.push(doneBoxArray, z.bx)
        while array.size(doneBoxArray) > showLastInput
            box.delete(array.shift(doneBoxArray))
    if not na(z.lb)
        z.lb.set_x(bar_index)
        z.lb.set_text(zoneText(z, status))
        z.lb.set_tooltip(zoneTip(z))
        array.push(doneLabelArray, z.lb)
        while array.size(doneLabelArray) > showLastInput
            label.delete(array.shift(doneLabelArray))

// keep only the newest unqualified candidates per side under watch
pruneCandidates(bool supSide) =>
    int candidates = 0
    for zx in zoneArray
        if zx.isSup == supSide and not zx.qualified
            candidates += 1
    if candidates > MAX_CANDIDATES
        for i = 0 to array.size(zoneArray) - 1
            Zone zc = array.get(zoneArray, i)
            if zc.isSup == supSide and not zc.qualified
                array.remove(zoneArray, i)
                break

// a confirmed swing anchors a candidate level; replay the confirmation window so the anchoring approach counts
createZone(bool supSide, float lvl) =>
    float zoneW = atrValue * widthInput
    bool  nearExisting = false
    for zx in zoneArray
        if zx.isSup == supSide and lvl >= zx.bottom - zoneW and lvl <= zx.top + zoneW
            nearExisting := true
            break
    if not nearExisting
        Zone z = Zone.new(level = lvl, top = supSide ? lvl + zoneW : lvl, bottom = supSide ? lvl : lvl - zoneW, isSup = supSide, pivotBar = bar_index - swingInput, createdBar = bar_index, atrAtBirth = atrValue, testBars = array.new<int>(), testPrices = array.new<float>(), testEfforts = array.new<float>())
        for k = 0 to swingInput
            int  j      = swingInput - k
            bool touchJ = supSide ? low[j] <= z.top : high[j] >= z.bottom
            if touchJ
                updEpisode(z, j)
            else if z.inContact
                endEpisode(z)
        if z.tests >= reqTestsInput
            qualifyZone(z)
        array.push(zoneArray, z)
        pruneCandidates(supSide)

// advance one tracked level a bar: break, approach bookkeeping, qualification, then the confirming departure
processZone(Zone z) =>
    bool  alive        = true
    float breakBuffer  = z.atrAtBirth * breakInput
    float departBuffer = z.atrAtBirth * departInput
    bool  levelBroke   = z.isSup ? close < z.bottom - breakBuffer : close > z.top + breakBuffer
    int   ageRef       = z.qualified ? z.qualifiedBar : z.createdBar
    if bar_index - ageRef > timeoutInput
        if z.qualified
            finalizeZone(z, "unresolved", false)
        alive := false
    else if levelBroke
        if z.qualified
            finalizeZone(z, "level broken", true)
            if z.isSup
                ev.bullRef := true
            else
                ev.bearRef := true
        alive := false
    else
        bool touch     = z.isSup ? low <= z.top : high >= z.bottom
        bool departNow = z.isSup ? close > z.top + departBuffer : close < z.bottom - departBuffer
        if touch
            updEpisode(z, 0)
        if z.inContact and (not touch or (z.qualified and departNow))
            endEpisode(z)
        if not z.qualified and z.tests >= reqTestsInput
            qualifyZone(z)
        if z.qualified and departNow
            finalizeZone(z, "level held", false)
            if z.isSup
                ev.bullConf := true
            else
                ev.bearConf := true
            alive := false
        if alive and z.qualified
            z.bx.set_right(bar_index)
            z.bx.set_bgcolor(zoneFill(z))
            if not na(z.lb)
                z.lb.set_x(bar_index)
                z.lb.set_text(zoneText(z, ""))
                z.lb.set_tooltip(zoneTip(z))
    alive

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// event flags, reset every bar
ev.bullDet  := false
ev.bearDet  := false
ev.bullTest := false
ev.bearTest := false
ev.bullConf := false
ev.bearConf := false
ev.bullRef  := false
ev.bearRef  := false

// advance every tracked level, keeping only the unresolved ones
array<Zone> survivors = array.new<Zone>()
for z in zoneArray
    if processZone(z)
        array.push(survivors, z)
zoneArray := survivors

// new candidate levels on confirmed swings
if not na(atrValue)
    if supInput and not na(swingLow)
        createZone(true, swingLow)
    if resInput and not na(swingHigh)
        createZone(false, swingHigh)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// warn once when the symbol carries no volume — absorption cannot be read without effort data
var label noVolumeLabel = na
if barstate.islast and na(volume)
    if na(noVolumeLabel)
        noVolumeLabel := label.new(bar_index, close, "Absorption requires volume data —\nnot available on this symbol", style = label.style_label_left, color = #00000000, textcolor = chart.fg_color, size = size.small)
    else
        noVolumeLabel.set_x(bar_index)
        noVolumeLabel.set_y(close)

plot(relVolume, "Relative Volume (× average)", color = NEUTRAL_COLOR, display = display.data_window)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
bullDetectedAlert = ev.bullDet
bearDetectedAlert = ev.bearDet
bullTestAlert     = ev.bullTest
bearTestAlert     = ev.bearTest
bullHeldAlert     = ev.bullConf
bearHeldAlert     = ev.bearConf
bullBrokeAlert    = ev.bullRef
bearBrokeAlert    = ev.bearRef

alertcondition(bullDetectedAlert, "Bullish Absorption Detected", "Bullish absorption detected — support has repeatedly absorbed heavy selling without breaking")
alertcondition(bearDetectedAlert, "Bearish Absorption Detected", "Bearish absorption detected — resistance has repeatedly absorbed heavy buying without breaking")
alertcondition(bullTestAlert, "Bullish Absorption Test", "New qualifying test of a bullish absorption zone — elevated selling volume rejected at support")
alertcondition(bearTestAlert, "Bearish Absorption Test", "New qualifying test of a bearish absorption zone — elevated buying volume rejected at resistance")
alertcondition(bullHeldAlert, "Bullish Absorption Confirmed", "Bullish absorption confirmed — price departed upward with ease from the absorbed support level")
alertcondition(bearHeldAlert, "Bearish Absorption Confirmed", "Bearish absorption confirmed — price departed downward with ease from the absorbed resistance level")
alertcondition(bullBrokeAlert, "Bullish Absorption Refuted", "Bullish absorption refuted — support broke decisively, the aggressive sellers won the level")
alertcondition(bearBrokeAlert, "Bearish Absorption Refuted", "Bearish absorption refuted — resistance broke decisively, the aggressive buyers won the level")

//---------------------------------------------------------------------------------------------------------------------}
