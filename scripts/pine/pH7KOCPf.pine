// ══════════════════════════════════════════════════════════════════════
// COMMON APPEARANCE
// ══════════════════════════════════════════════════════════════════════

gCommon = "━━━━━━━━━━━━ COMMON APPEARANCE ━━━━━━━━━━━━"

showFill = input.bool(
     true,
     "Show rectangle fill",
     group=gCommon)

transparency = input.int(
     85,
     "Rectangle transparency",
     minval=0,
     maxval=100,
     group=gCommon)

borderWidth = input.int(
     2,
     "Rectangle border width",
     minval=1,
     maxval=5,
     group=gCommon)

markerTransparency = input.int(
     55,
     "First-hour marker transparency",
     minval=0,
     maxval=100,
     group=gCommon)

historyZones = input.int(
     250,
     "Historical zones",
     minval=1,
     maxval=MAX_HISTORY,
     group=gCommon)

// ══════════════════════════════════════════════════════════════════════
// ALLOWED TIMEFRAMES
//
// Rectangle: <= 1H
// Marker:    < 1H
// ══════════════════════════════════════════════════════════════════════

float chartSeconds =
     timeframe.in_seconds(timeframe.period)

bool timeframeAllowed =
     not na(chartSeconds) and
     chartSeconds <= 60 * 60

bool markerTimeframeAllowed =
     not na(chartSeconds) and
     chartSeconds < 60 * 60

// ══════════════════════════════════════════════════════════════════════
// CURRENT SYMBOL IDENTIFICATION
// ══════════════════════════════════════════════════════════════════════

string currentTicker = syminfo.tickerid

bool isSymbol1 =
     symbol1 != "" and currentTicker == symbol1

bool isSymbol2 =
     symbol2 != "" and currentTicker == symbol2

bool isSymbol3 =
     symbol3 != "" and currentTicker == symbol3

bool isSymbol4 =
     symbol4 != "" and currentTicker == symbol4

bool isSymbol5 =
     symbol5 != "" and currentTicker == symbol5

bool symbolAllowed =
     isSymbol1 or
     isSymbol2 or
     isSymbol3 or
     isSymbol4 or
     isSymbol5

// ══════════════════════════════════════════════════════════════════════
// CURRENT SYMBOL SETTINGS
// ══════════════════════════════════════════════════════════════════════

string selectedTime = H08
string selectedTimezone = TZ_PARIS
color selectedColor = color.blue
float selectedDuration = 24.0
bool showMarker = false

if isSymbol1
    selectedTime := referenceTime1
    selectedTimezone := timezone1
    selectedColor := color1
    selectedDuration := duration1
    showMarker := marker1

else if isSymbol2
    selectedTime := referenceTime2
    selectedTimezone := timezone2
    selectedColor := color2
    selectedDuration := duration2
    showMarker := marker2

else if isSymbol3
    selectedTime := referenceTime3
    selectedTimezone := timezone3
    selectedColor := color3
    selectedDuration := duration3
    showMarker := marker3

else if isSymbol4
    selectedTime := referenceTime4
    selectedTimezone := timezone4
    selectedColor := color4
    selectedDuration := duration4
    showMarker := marker4

else if isSymbol5
    selectedTime := referenceTime5
    selectedTimezone := timezone5
    selectedColor := color5
    selectedDuration := duration5
    showMarker := marker5

int referenceHour =
     f_hour(selectedTime)

int referenceMinute =
     f_minute(selectedTime)

string ianaTimezone =
     f_timezone(selectedTimezone)

// ══════════════════════════════════════════════════════════════════════
// 1H DATA
// ══════════════════════════════════════════════════════════════════════

[time1H, high1H, low1H] = request.security(
     syminfo.tickerid,
     "60",
     [time, high, low],
     lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════════════════════════════════
// XX:30 DATA
// ══════════════════════════════════════════════════════════════════════

[time30, high30, low30] = request.security(
     syminfo.tickerid,
     "30",
     f_zone30(
          referenceHour,
          ianaTimezone),
     lookahead=barmerge.lookahead_off)

// ══════════════════════════════════════════════════════════════════════
// ENGINE SELECTION
//
// XX:00 -> native 1H candle
// XX:30 -> synthetic 1H range built from 2 × 30 min
// ══════════════════════════════════════════════════════════════════════

bool mode30 =
     referenceMinute == 30

int referenceTimestamp =
     mode30 ? time30 : time1H

float referenceHigh =
     mode30 ? high30 : high1H

float referenceLow =
     mode30 ? low30 : low1H

// ══════════════════════════════════════════════════════════════════════
// REFERENCE CANDLE DETECTION
// ══════════════════════════════════════════════════════════════════════

bool referenceCandle = false

if symbolAllowed and timeframeAllowed

    if mode30
        referenceCandle :=
             not na(time30)

    else

        int localHour1H =
             hour(
                  time1H,
                  ianaTimezone)

        int localMinute1H =
             minute(
                  time1H,
                  ianaTimezone)

        referenceCandle :=
             localHour1H == referenceHour and
             localMinute1H == 0

bool newZone =
     timeframeAllowed and
     referenceCandle and
     not na(referenceTimestamp) and
     (
         na(referenceTimestamp[1]) or
         referenceTimestamp != referenceTimestamp[1]
     )

// ══════════════════════════════════════════════════════════════════════
// OBJECTS
// ══════════════════════════════════════════════════════════════════════

var box zone = na
var line marker = na

var array<box> zoneHistory =
     array.new<box>()

var array<line> markerHistory =
     array.new<line>()

// ══════════════════════════════════════════════════════════════════════
// NEW ZONE CREATION
// ══════════════════════════════════════════════════════════════════════

if newZone

    // Actual reference time.
    int zoneStart =
         referenceTimestamp

    // ────────────────────────────────────────────────────────────────
    // XX:30 VISUAL ALIGNMENT ON 1H CHARTS
    //
    // TF < 1H:
    //     XX:30 remains displayed at XX:30.
    //
    // TF = 1H:
    //     the rectangle starts at the opening of the 1H candle
    //     containing the XX:30 reference time.
    //
    // High/Low remain calculated from the actual XX:30 -> XX+1:30 hour.
    // ────────────────────────────────────────────────────────────────

    bool alignXX30 =
         mode30 and
         chartSeconds == 60 * 60

    int displayStart =
         alignXX30 ?
         time :
         zoneStart

    int displayEnd =
         displayStart +
         int(
             selectedDuration *
             60.0 *
             60.0 *
             1000.0)

    // ────────────────────────────────────────────────────────────────
    // MAIN RECTANGLE
    // ────────────────────────────────────────────────────────────────

    color fillColor =
         showFill ?
         color.new(selectedColor, transparency) :
         color.new(selectedColor, 100)

    zone := box.new(
         left=displayStart,
         top=referenceHigh,
         right=displayEnd,
         bottom=referenceLow,
         xloc=xloc.bar_time,
         border_color=selectedColor,
         border_width=borderWidth,
         bgcolor=fillColor)

    array.push(
         zoneHistory,
         zone)

    if array.size(zoneHistory) > historyZones

        box oldZone =
             array.shift(
                  zoneHistory)

        box.delete(
             oldZone)

    // ────────────────────────────────────────────────────────────────
    // FIRST-HOUR MARKER
    //
    // Displayed only on timeframes below 1H.
    // Position is always based on the ACTUAL reference time.
    //
    // 1m  -> XX:59
    // 5m  -> XX:55
    // 15m -> XX:45
    // 30m -> XX:30
    // ────────────────────────────────────────────────────────────────

    if showMarker and
         markerTimeframeAllowed

        int candleDurationMs =
             int(
                 chartSeconds *
                 1000.0)

        int oneHourMs =
             60 *
             60 *
             1000

        int markerTime =
             zoneStart +
             oneHourMs

        if candleDurationMs > 0 and
             candleDurationMs < oneHourMs

            markerTime :=
                 zoneStart +
                 oneHourMs -
                 candleDurationMs

        marker := line.new(
             x1=markerTime,
             y1=referenceLow,
             x2=markerTime,
             y2=referenceHigh,
             xloc=xloc.bar_time,
             extend=extend.none,
             color=color.new(
                  selectedColor,
                  markerTransparency),
             style=line.style_dashed,
             width=MARKER_WIDTH)

        array.push(
             markerHistory,
             marker)

        if array.size(markerHistory) > historyZones

            line oldMarker =
                 array.shift(
                      markerHistory)

            line.delete(
                 oldMarker)

// ══════════════════════════════════════════════════════════════════════
// REAL-TIME UPDATE
// ══════════════════════════════════════════════════════════════════════

if timeframeAllowed and
     symbolAllowed and
     referenceCandle and
     not na(zone)

    box.set_top(
         zone,
         referenceHigh)

    box.set_bottom(
         zone,
         referenceLow)

    if showMarker and
         markerTimeframeAllowed and
         not na(marker)

        line.set_y1(
             marker,
             referenceLow)

        line.set_y2(
             marker,
             referenceHigh)

// ══════════════════════════════════════════════════════════════════════
// RECTANGLE STYLE
// ══════════════════════════════════════════════════════════════════════

if timeframeAllowed and
     symbolAllowed and
     not na(zone)

    color fillColor =
         showFill ?
         color.new(selectedColor, transparency) :
         color.new(selectedColor, 100)

    box.set_border_color(
         zone,
         selectedColor)

    box.set_border_width(
         zone,
         borderWidth)

    box.set_bgcolor(
         zone,
         fillColor)

// ══════════════════════════════════════════════════════════════════════
// MARKER STYLE
// ══════════════════════════════════════════════════════════════════════

if markerTimeframeAllowed and
     symbolAllowed and
     showMarker and
     not na(marker)

    line.set_color(
         marker,
         color.new(
              selectedColor,
              markerTransparency))

    line.set_style(
         marker,
         line.style_dashed)

    line.set_width(
         marker,
         MARKER_WIDTH)