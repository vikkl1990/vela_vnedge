//@version=6
indicator(
     "B8 Ultimate v2",
     shorttitle="B8",
     overlay=true,
     max_boxes_count=300,
     max_lines_count=300)

// ══════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════

const int MARKER_WIDTH = 2
const int MAX_HISTORY = 250

// ══════════════════════════════════════════════════════════════════════
// TIME ZONES
// ══════════════════════════════════════════════════════════════════════

const string TZ_LA         = "GMT-8/-7 — Los Angeles"
const string TZ_CHICAGO    = "GMT-6/-5 — Chicago"
const string TZ_MEXICO     = "GMT-6 — Mexico City"
const string TZ_NEWYORK    = "GMT-5/-4 — New York / Toronto"
const string TZ_SAO        = "GMT-3 — São Paulo"
const string TZ_LONDON     = "GMT+0/+1 — London"
const string TZ_PARIS      = "GMT+1/+2 — Paris / Frankfurt / Zurich"
const string TZ_ATHENS     = "GMT+2/+3 — Athens"
const string TZ_JERUSALEM  = "GMT+2/+3 — Tel Aviv / Jerusalem"
const string TZ_MOSCOW     = "GMT+3 — Moscow"
const string TZ_DUBAI      = "GMT+4 — Dubai"
const string TZ_INDIA      = "GMT+5:30 — Mumbai"
const string TZ_SINGAPORE  = "GMT+8 — Singapore"
const string TZ_HONGKONG   = "GMT+8 — Hong Kong"
const string TZ_SHANGHAI   = "GMT+8 — Shanghai / Shenzhen"
const string TZ_TOKYO      = "GMT+9 — Tokyo"
const string TZ_SEOUL      = "GMT+9 — Seoul"
const string TZ_SYDNEY     = "GMT+10/+11 — Sydney"
const string TZ_AUCKLAND   = "GMT+12/+13 — Auckland"

f_timezone(string choice) =>
    string tz = "Europe/Paris"

    if choice == TZ_LA
        tz := "America/Los_Angeles"
    else if choice == TZ_CHICAGO
        tz := "America/Chicago"
    else if choice == TZ_MEXICO
        tz := "America/Mexico_City"
    else if choice == TZ_NEWYORK
        tz := "America/New_York"
    else if choice == TZ_SAO
        tz := "America/Sao_Paulo"
    else if choice == TZ_LONDON
        tz := "Europe/London"
    else if choice == TZ_PARIS
        tz := "Europe/Paris"
    else if choice == TZ_ATHENS
        tz := "Europe/Athens"
    else if choice == TZ_JERUSALEM
        tz := "Asia/Jerusalem"
    else if choice == TZ_MOSCOW
        tz := "Europe/Moscow"
    else if choice == TZ_DUBAI
        tz := "Asia/Dubai"
    else if choice == TZ_INDIA
        tz := "Asia/Kolkata"
    else if choice == TZ_SINGAPORE
        tz := "Asia/Singapore"
    else if choice == TZ_HONGKONG
        tz := "Asia/Hong_Kong"
    else if choice == TZ_SHANGHAI
        tz := "Asia/Shanghai"
    else if choice == TZ_TOKYO
        tz := "Asia/Tokyo"
    else if choice == TZ_SEOUL
        tz := "Asia/Seoul"
    else if choice == TZ_SYDNEY
        tz := "Australia/Sydney"
    else if choice == TZ_AUCKLAND
        tz := "Pacific/Auckland"

    tz

// ══════════════════════════════════════════════════════════════════════
// HH:MM CONVERSION
// ══════════════════════════════════════════════════════════════════════

f_hour(string referenceTime) =>
    int(str.tonumber(str.substring(referenceTime, 0, 2)))

f_minute(string referenceTime) =>
    int(str.tonumber(str.substring(referenceTime, 3, 5)))

// ══════════════════════════════════════════════════════════════════════
// XX:30 MODE
//
// One full hour is built from 2 × 30-minute candles.
// Existing validated engine remains unchanged.
// ══════════════════════════════════════════════════════════════════════

f_zone30(int referenceHour, string tz) =>

    var int zoneStart = na
    var float zoneHigh = na
    var float zoneLow = na

    int h = hour(time, tz)
    int m = minute(time, tz)

    bool newZoneStart =
         h == referenceHour and m == 30

    if newZoneStart
        zoneStart := time
        zoneHigh := high
        zoneLow := low

    else if not na(zoneStart) and
         time < zoneStart + 60 * 60 * 1000

        zoneHigh := math.max(zoneHigh, high)
        zoneLow := math.min(zoneLow, low)

    [zoneStart, zoneHigh, zoneLow]

// ══════════════════════════════════════════════════════════════════════
// AVAILABLE REFERENCE TIMES
// ══════════════════════════════════════════════════════════════════════

