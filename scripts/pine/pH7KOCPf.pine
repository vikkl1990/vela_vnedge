         H08,H0830,H09,H0930,H10,H1030,H11,H1130,
         H12,H1230,H13,H1330,H14,H1430,H15,H1530,
         H16,H1630,H17,H1730,H18,H1830,H19,H1930,
         H20,H2030,H21,H2130,H22,H2230,H23,H2330
     ],
     group=g1)

