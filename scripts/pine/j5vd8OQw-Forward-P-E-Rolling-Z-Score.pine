//@version=6
indicator("Forward P/E Rolling Z-Score", overlay = false)

// ============================================================================
// INPUTS
// ============================================================================

// Date Filter Inputs
startDate     = input.time(timestamp("01 Jan 2010 00:00 +0000"), "Performance Tracking Start Date", group = "Performance Date Range")

// Z-Score Inputs
lookback      = input.int(60, "Z-Score Lookback Period (Bars)", minval = 2, group = "Z-Score Settings")
zThreshold    = input.float(2.0, "Signal Threshold", group = "Z-Score Settings")
crossMode     = input.string("Cross Over", "Signal Direction", options = ["Cross Under", "Cross Over"], group = "Z-Score Settings")
annualize     = input.bool(true, "Annualize Next-Quarter EPS Estimate (x4)", group = "Forward P/E Calculation")

// Moving Average Inputs
useMA         = input.bool(true, "Plot Moving Average on Z-Score", group = "Moving Average Smoothing")
maType        = input.string("EMA", "MA Type", options = ["EMA", "SMA"], group = "Moving Average Smoothing")
maLength      = input.int(9, "MA Length", minval = 1, group = "Moving Average Smoothing")

// Visual & Shading Inputs
showExtremes  = input.bool(true, "Highlight Extreme Zones", group = "Visuals")
shadeSource   = input.string("Smoothed (MA)", "Shade Background Using", options = ["Smoothed (MA)", "Raw Z-Score"], group = "Visuals")

// Performance Table Inputs
showTable     = input.bool(true, "Display Performance Table on Main Chart", group = "Performance Table")
tableSource   = input.string("Smoothed (MA)", "Track Performance Signals On", options = ["Raw Z-Score", "Smoothed (MA)"], group = "Performance Table")
tablePosInput = input.string("Top Right", "Table Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Performance Table")

// Mapping position options
var string tablePos = tablePosInput == "Top Right" ? position.top_right :
                      tablePosInput == "Top Left" ? position.top_left :
                      tablePosInput == "Bottom Right" ? position.bottom_right : position.bottom_left

// ============================================================================
// FORWARD P/E & Z-SCORE CALCULATION
// ============================================================================

float upcomingEpsEst     = earnings.future_eps
float projectedAnnualEps = annualize ? (upcomingEpsEst * 4.0) : upcomingEpsEst
float forwardPE          = not na(projectedAnnualEps) and projectedAnnualEps > 0 ? (close / projectedAnnualEps) : na

float mean    = ta.sma(forwardPE, lookback)
float stdev   = ta.stdev(forwardPE, lookback)
float zScore  = stdev > 0 ? (forwardPE - mean) / stdev : na

// Moving Average Smoothing
float zMA     = maType == "EMA" ? ta.ema(zScore, maLength) : ta.sma(zScore, maLength)

float activeMetric = tableSource == "Smoothed (MA)" and useMA ? zMA : zScore
float shadeMetric  = shadeSource == "Smoothed (MA)" and useMA ? zMA : zScore

// ============================================================================
// DISCRETE SIGNAL DETECTION & FORWARD HORIZON QUEUES (CHANGED)
// ============================================================================

bool signalCrossUnder = ta.crossunder(activeMetric, zThreshold)
bool signalCrossOver  = ta.crossover(activeMetric, zThreshold)
bool rawSignal        = crossMode == "Cross Over" ? signalCrossOver : signalCrossUnder

// Historical Arrays for finalized returns
var float[] ret1M = array.new_float(0)
var float[] ret3M = array.new_float(0)
var float[] ret6M = array.new_float(0)
var float[] ret1Y = array.new_float(0)

// Active tracking queues (stores [entryPrice, targetBarIndex])
var float[] queue1M_Price = array.new_float(0)
var int[]   queue1M_Bar   = array.new_int(0)

var float[] queue3M_Price = array.new_float(0)
var int[]   queue3M_Bar   = array.new_int(0)

var float[] queue6M_Price = array.new_float(0)
var int[]   queue6M_Bar   = array.new_int(0)

var float[] queue1Y_Price = array.new_float(0)
var int[]   queue1Y_Bar   = array.new_int(0)

// Capture and queue a new signal forward target
if rawSignal and time >= startDate
    array.push(queue1M_Price, close)
    array.push(queue1M_Bar,   bar_index + 21)

    array.push(queue3M_Price, close)
    array.push(queue3M_Bar,   bar_index + 63)

    array.push(queue6M_Price, close)
    array.push(queue6M_Bar,   bar_index + 126)

    array.push(queue1Y_Price, close)
    array.push(queue1Y_Bar,   bar_index + 252)

// Process 1 Month Queue
if array.size(queue1M_Bar) > 0
    for i = array.size(queue1M_Bar) - 1 to 0
        if bar_index >= array.get(queue1M_Bar, i)
            float entry = array.get(queue1M_Price, i)
            array.push(ret1M, (close - entry) / entry * 100.0)
            array.remove(queue1M_Bar, i)
            array.remove(queue1M_Price, i)

// Process 3 Month Queue
if array.size(queue3M_Bar) > 0
    for i = array.size(queue3M_Bar) - 1 to 0
        if bar_index >= array.get(queue3M_Bar, i)
            float entry = array.get(queue3M_Price, i)
            array.push(ret3M, (close - entry) / entry * 100.0)
            array.remove(queue3M_Bar, i)
            array.remove(queue3M_Price, i)

// Process 6 Month Queue
if array.size(queue6M_Bar) > 0
    for i = array.size(queue6M_Bar) - 1 to 0
        if bar_index >= array.get(queue6M_Bar, i)
            float entry = array.get(queue6M_Price, i)
            array.push(ret6M, (close - entry) / entry * 100.0)
            array.remove(queue6M_Bar, i)
            array.remove(queue6M_Price, i)

// Process 1 Year Queue
if array.size(queue1Y_Bar) > 0
    for i = array.size(queue1Y_Bar) - 1 to 0
        if bar_index >= array.get(queue1Y_Bar, i)
            float entry = array.get(queue1Y_Price, i)
            array.push(ret1Y, (close - entry) / entry * 100.0)
            array.remove(queue1Y_Bar, i)
            array.remove(queue1Y_Price, i)

// Metrics Computations
float avg1M = array.size(ret1M) > 0 ? array.avg(ret1M) : na
float avg3M = array.size(ret3M) > 0 ? array.avg(ret3M) : na
float avg6M = array.size(ret6M) > 0 ? array.avg(ret6M) : na
float avg1Y = array.size(ret1Y) > 0 ? array.avg(ret1Y) : na

f_win_rate(float[] arr) =>
    if array.size(arr) == 0
        na
    else
        int wins = 0
        for i = 0 to array.size(arr) - 1
            if array.get(arr, i) > 0
                wins += 1
        (wins / float(array.size(arr))) * 100.0

float win1M = f_win_rate(ret1M)
float win3M = f_win_rate(ret3M)
float win6M = f_win_rate(ret6M)
float win1Y = f_win_rate(ret1Y)

// ============================================================================
// PLOTS & VISUALS (LOWER PANE)
// ============================================================================

color zColor = zScore >= 2.0         ? color.red :
               zScore <= -2.0        ? color.green :
               color.blue

plot(zScore, "Raw Z-Score", color = zColor, linewidth = 1)
plot(useMA ? zMA : na, "Z-Score MA", color = color.orange, linewidth = 2)

hline(0.0, "Mean (0)", color = color.gray, linestyle = hline.style_dashed)
hline(2.0, "+2 Std Dev (Expensive)", color = color.red, linestyle = hline.style_dotted)
hline(zThreshold, "Signal Threshold", color = color.green, linestyle = hline.style_dotted)

bgcolor(showExtremes and shadeMetric >= 2.0 ? color.new(color.red, 90) : na, title = "Expensive Highlight")
bgcolor(showExtremes and shadeMetric <= zThreshold ? color.new(color.green, 90) : na, title = "Cheap Highlight")

// ============================================================================
// OVERLAY PERFORMANCE TABLE (MAIN CHART)
// ============================================================================

var table perfTable = table.new(tablePos, 4, 6, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray, force_overlay = true)

f_format_cell(int col, int row, float val, string suffix = "%") =>
    string txt = na(val) ? "N/A" : str.tostring(math.round(val)) + suffix
    color txtColor = na(val) ? color.gray : val > 0 ? color.lime : val < 0 ? color.red : color.white
    table.cell(perfTable, col, row, txt, text_color = txtColor, text_size = size.small)

if barstate.islast and showTable
    string srcTitle = (tableSource == "Smoothed (MA)" and useMA ? (maType + "(" + str.tostring(maLength) + ")") : "Raw Z") + " " + crossMode + " " + str.tostring(zThreshold, "#.1") + " (Since " + str.format("{0,date,yyyy-MM-dd}", startDate) + ")"
    table.cell(perfTable, 0, 0, srcTitle, text_color = color.orange, text_size = size.small)
    table.merge_cells(perfTable, 0, 0, 3, 0)

    table.cell(perfTable, 0, 1, "Horizon", text_color = color.yellow, text_size = size.small)
    table.cell(perfTable, 1, 1, "Avg Return", text_color = color.yellow, text_size = size.small)
    table.cell(perfTable, 2, 1, "Win Rate", text_color = color.yellow, text_size = size.small)
    table.cell(perfTable, 3, 1, "Triggers", text_color = color.yellow, text_size = size.small)

    table.cell(perfTable, 0, 2, "1 Month", text_color = color.white, text_size = size.small)
    f_format_cell(1, 2, avg1M)
    f_format_cell(2, 2, win1M)
    table.cell(perfTable, 3, 2, str.tostring(array.size(ret1M)), text_color = color.white, text_size = size.small)

    table.cell(perfTable, 0, 3, "3 Months", text_color = color.white, text_size = size.small)
    f_format_cell(1, 3, avg3M)
    f_format_cell(2, 3, win3M)
    table.cell(perfTable, 3, 3, str.tostring(array.size(ret3M)), text_color = color.white, text_size = size.small)

    table.cell(perfTable, 0, 4, "6 Months", text_color = color.white, text_size = size.small)
    f_format_cell(1, 4, avg6M)
    f_format_cell(2, 4, win6M)
    table.cell(perfTable, 3, 4, str.tostring(array.size(ret6M)), text_color = color.white, text_size = size.small)

    table.cell(perfTable, 0, 5, "1 Year", text_color = color.white, text_size = size.small)
    f_format_cell(1, 5, avg1Y)
    f_format_cell(2, 5, win1Y)
