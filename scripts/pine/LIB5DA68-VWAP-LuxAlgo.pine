//@version=6
indicator("VWAP", "VWAP", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
ANCHOR_SESSION = "Session"
ANCHOR_WEEK    = "Week"
ANCHOR_MONTH   = "Month"

BANDS_STDEV   = "Standard Deviation"
BANDS_PERCENT = "Percentage"

SETTINGS_GROUP = "Settings"
STYLE_GROUP    = "Style"

FILL_TRANSPARENCY = 95

BULL_COLOR    = #089981 // price above VWAP, and the lower (support) bands
BEAR_COLOR    = #f23645 // price below VWAP, and the upper (resistance) bands
NEUTRAL_COLOR = #787b86 // band fill

BAND_LINE_TRANSP = 40 // transparency of the band lines

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
anchorInput = input.string(ANCHOR_SESSION, "Anchor Period", options = [ANCHOR_SESSION, ANCHOR_WEEK, ANCHOR_MONTH], group = SETTINGS_GROUP, tooltip = "Period anchoring the average. VWAP and its bands reset on the first bar of each new session (trading day), week, or month.")

srcInput = input.source(hlc3, "Source", group = SETTINGS_GROUP, tooltip = "Price used in the volume weighted average. Typical price (HLC3) is the classic choice.")

bandsModeInput = input.string(BANDS_STDEV, "Bands Mode", options = [BANDS_STDEV, BANDS_PERCENT], group = SETTINGS_GROUP, tooltip = "Bands offset method: multiples of the volume weighted standard deviation of price around VWAP, or a percentage of the VWAP value.")

showBand1Input = input.bool(true, "Band #1", inline = "band1", group = SETTINGS_GROUP, tooltip = "Show the first band pair.")
mult1Input     = input.float(1.0, "", minval = 0, step = 0.5, inline = "band1", group = SETTINGS_GROUP, tooltip = "Multiplier for the first band pair, in standard deviations or percent depending on the bands mode.")

showBand2Input = input.bool(false, "Band #2", inline = "band2", group = SETTINGS_GROUP, tooltip = "Show the second band pair.")
mult2Input     = input.float(2.0, "", minval = 0, step = 0.5, inline = "band2", group = SETTINGS_GROUP, tooltip = "Multiplier for the second band pair, in standard deviations or percent depending on the bands mode.")

showBand3Input = input.bool(false, "Band #3", inline = "band3", group = SETTINGS_GROUP, tooltip = "Show the third band pair.")
mult3Input     = input.float(3.0, "", minval = 0, step = 0.5, inline = "band3", group = SETTINGS_GROUP, tooltip = "Multiplier for the third band pair, in standard deviations or percent depending on the bands mode.")

hideDwmInput = input.bool(true, "Hide VWAP on 1D or Above", group = SETTINGS_GROUP, tooltip = "Hide the VWAP and its bands on daily and higher timeframes, where an intraday anchored VWAP is not meaningful.")

bullColorInput  = input.color(BULL_COLOR, "Bullish", inline = "vwap", group = STYLE_GROUP, tooltip = "VWAP line color while price closes above it, and the color of the lower (support) bands.")
bearColorInput  = input.color(BEAR_COLOR, "Bearish", inline = "vwap", group = STYLE_GROUP, tooltip = "VWAP line color while price closes below it, and the color of the upper (resistance) bands.")
bandsColorInput = input.color(NEUTRAL_COLOR, "Bands", group = STYLE_GROUP, tooltip = "Deviation bands fill color.")
fillInput       = input.bool(true, "Bands Fill", group = STYLE_GROUP, tooltip = "Fill the area between each visible band pair.")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
changeDay   = timeframe.change("1D")
changeWeek  = timeframe.change("1W")
changeMonth = timeframe.change("1M")

isNewAnchor = switch anchorInput
    ANCHOR_WEEK  => changeWeek
    ANCHOR_MONTH => changeMonth
    => changeDay

var float sumPV  = 0.0
var float sumV   = 0.0
var float sumPV2 = 0.0

if isNewAnchor
    sumPV  := 0.0
    sumV   := 0.0
    sumPV2 := 0.0

if not na(srcInput) and not na(volume)
    sumPV  += srcInput * volume
    sumV   += volume
    sumPV2 += srcInput * srcInput * volume

vwapValue = sumV > 0 ? sumPV / sumV : float(na)

// E[x^2] - E[x]^2 with volume weights equals the volume weighted variance of the source around VWAP
variance = sumV > 0 ? math.max(sumPV2 / sumV - vwapValue * vwapValue, 0) : float(na)
sigma    = math.sqrt(variance)

bandOffset = bandsModeInput == BANDS_PERCENT ? vwapValue / 100 : sigma

upperBand1 = vwapValue + bandOffset * mult1Input
lowerBand1 = vwapValue - bandOffset * mult1Input
upperBand2 = vwapValue + bandOffset * mult2Input
lowerBand2 = vwapValue - bandOffset * mult2Input
upperBand3 = vwapValue + bandOffset * mult3Input
lowerBand3 = vwapValue - bandOffset * mult3Input

hideOnDwm = hideDwmInput and timeframe.isdwm

vwapDisplay   = hideOnDwm ? float(na) : vwapValue
upper1Display = hideOnDwm or not showBand1Input ? float(na) : upperBand1
lower1Display = hideOnDwm or not showBand1Input ? float(na) : lowerBand1
upper2Display = hideOnDwm or not showBand2Input ? float(na) : upperBand2
lower2Display = hideOnDwm or not showBand2Input ? float(na) : lowerBand2
upper3Display = hideOnDwm or not showBand3Input ? float(na) : upperBand3
lower3Display = hideOnDwm or not showBand3Input ? float(na) : lowerBand3

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
fillColor = fillInput ? color.new(bandsColorInput, FILL_TRANSPARENCY) : color(na)

// VWAP colored by price position - the upper bands lean resistance, the lower bands lean support
vwapColor  = close >= vwapValue ? bullColorInput : bearColorInput
upperColor = color.new(bearColorInput, BAND_LINE_TRANSP)
lowerColor = color.new(bullColorInput, BAND_LINE_TRANSP)

plot(vwapDisplay, "VWAP", vwapColor, 1, plot.style_linebr)

upper1PlotId = plot(upper1Display, "Upper Band #1", upperColor, 1, plot.style_linebr)
lower1PlotId = plot(lower1Display, "Lower Band #1", lowerColor, 1, plot.style_linebr)
upper2PlotId = plot(upper2Display, "Upper Band #2", upperColor, 1, plot.style_linebr)
lower2PlotId = plot(lower2Display, "Lower Band #2", lowerColor, 1, plot.style_linebr)
upper3PlotId = plot(upper3Display, "Upper Band #3", upperColor, 1, plot.style_linebr)
lower3PlotId = plot(lower3Display, "Lower Band #3", lowerColor, 1, plot.style_linebr)

fill(upper1PlotId, lower1PlotId, fillColor, "Bands Fill #1")
fill(upper2PlotId, lower2PlotId, fillColor, "Bands Fill #2")
fill(upper3PlotId, lower3PlotId, fillColor, "Bands Fill #3")

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossAboveVwap = ta.crossover(close, vwapValue)
crossBelowVwap = ta.crossunder(close, vwapValue)

alertcondition(crossAboveVwap, "Price Crossed Above VWAP", "Price crossed above the VWAP")
alertcondition(crossBelowVwap, "Price Crossed Below VWAP", "Price crossed below the VWAP")

//----------------------------------------------------------------------------------------------------------------------}
