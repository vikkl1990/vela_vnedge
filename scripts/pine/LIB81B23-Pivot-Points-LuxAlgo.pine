//@version=6
indicator("Pivot Points", shorttitle = "Pivot Points", overlay = true, format = format.price, max_lines_count = 500, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

color PP_COLOR  = #787b86 // the central pivot is the midline - structure
color RES_COLOR = #f23645
color SUP_COLOR = #089981
color LABEL_BG  = #00000000
color DASH_BG   = #161616

string SETTINGS_GROUP = 'Settings'
string STYLE_GROUP    = 'Style'

string AUTO_ANCHOR    = 'Auto'
string DAILY_ANCHOR   = 'Daily'
string WEEKLY_ANCHOR  = 'Weekly'
string MONTHLY_ANCHOR = 'Monthly'

string SOLID_STYLE  = 'Solid'
string DASHED_STYLE = 'Dashed'
string DOTTED_STYLE = 'Dotted'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

anchorInput = input.string(AUTO_ANCHOR, 'Anchor Period', options = [AUTO_ANCHOR, DAILY_ANCHOR, WEEKLY_ANCHOR, MONTHLY_ANCHOR], group = SETTINGS_GROUP, tooltip = 'Prior period the ladder is computed from. Auto selects Daily on intraday charts, Weekly on daily charts, and Monthly above that. Longer anchors produce slower-moving levels. Levels are computed from the chart session data, so 24-hour and regular-hours charts can yield different values on futures and forex.')

rungsInput = input.int(3, 'Support/Resistance Rungs', minval = 1, maxval = 3, group = SETTINGS_GROUP, tooltip = 'Number of support and resistance rungs reflected around the central pivot, from R1/S1 out to R3/S3.')

historyInput = input.int(5, 'Periods Shown', minval = 1, maxval = 50, group = SETTINGS_GROUP, tooltip = 'Number of anchor periods, including the current one, whose ladders remain on the chart. Past ladders help judge how price actually reacted to the projected levels.')

showLabelsInput = input.bool(true, 'Show Labels', group = STYLE_GROUP, tooltip = 'Display the level name at the right end of the current ladder.')

showPricesInput = input.bool(true, 'Show Prices in Labels', group = STYLE_GROUP, tooltip = 'Append the level price to each label.')

ppColorInput  = input.color(PP_COLOR, 'Central Pivot', group = STYLE_GROUP)
resColorInput = input.color(RES_COLOR, 'Resistances', group = STYLE_GROUP)
supColorInput = input.color(SUP_COLOR, 'Supports', group = STYLE_GROUP)

ppStyleInput = input.string(SOLID_STYLE, 'Pivot Line Style', options = [SOLID_STYLE, DASHED_STYLE, DOTTED_STYLE], group = STYLE_GROUP, tooltip = 'Line style of the central pivot line.')

srStyleInput = input.string(DASHED_STYLE, 'Rung Line Style', options = [SOLID_STYLE, DASHED_STYLE, DOTTED_STYLE], group = STYLE_GROUP, tooltip = 'Line style of the support and resistance rungs.')

widthInput = input.int(1, 'Line Width', minval = 1, maxval = 4, group = STYLE_GROUP, tooltip = 'Width of every pivot line.')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// Anchor timeframe from the input, Auto picks the next natural period above the chart timeframe
getAnchorTimeframe() =>
    switch anchorInput
        DAILY_ANCHOR   => 'D'
        WEEKLY_ANCHOR  => 'W'
        MONTHLY_ANCHOR => 'M'
        => timeframe.isintraday ? 'D' : timeframe.isdaily ? 'W' : 'M'

// Line style constant from a style option
getLineStyle(string styleName) =>
    switch styleName
        DASHED_STYLE => line.style_dashed
        DOTTED_STYLE => line.style_dotted
        => line.style_solid

// Text displayed in a level label
getLabelText(string levelName, float levelValue) =>
    showPricesInput ? levelName + ' ' + str.tostring(levelValue, format.mintick) : levelName

// True when the current bar trades through the level
isTouched(float levelValue) =>
    not na(levelValue) and high >= levelValue and low <= levelValue

//---------------------------------------------------------------------------------------------------------------------}
// Pivot Levels
//---------------------------------------------------------------------------------------------------------------------{

string anchorTimeframe = getAnchorTimeframe()

// The anchor must sit above the chart timeframe, otherwise no prior period can be tracked
bool anchorValid  = timeframe.in_seconds(anchorTimeframe) > timeframe.in_seconds(timeframe.period)
bool anchorChange = timeframe.change(anchorTimeframe)
bool newPeriod    = anchorChange and anchorValid

// Prior anchor period high, low and close, tracked bar by bar
var float periodHigh = high
var float periodLow  = low
var float prevHigh   = na
var float prevLow    = na
var float prevClose  = na

// First-test flags, reset at the start of each anchor period
var bool ppTested = false
var bool r1Tested = false
var bool s1Tested = false

if newPeriod
    prevHigh   := periodHigh
    prevLow    := periodLow
    prevClose  := close[1]
    periodHigh := high
    periodLow  := low
    ppTested   := false
    r1Tested   := false
    s1Tested   := false
else
    periodHigh := math.max(periodHigh, high)
    periodLow  := math.min(periodLow, low)

// Classic floor-trader ladder projected from the prior period high, low and close
float pp = (prevHigh + prevLow + prevClose) / 3
float r1 = 2 * pp - prevLow
float s1 = 2 * pp - prevHigh
float r2 = pp + (prevHigh - prevLow)
float s2 = pp - (prevHigh - prevLow)
float r3 = prevHigh + 2 * (pp - prevLow)
float s3 = prevLow - 2 * (prevHigh - pp)

// First tests of the central pivot and the inner rungs this period
bool ppFirstTest = not ppTested and isTouched(pp)
bool r1FirstTest = not r1Tested and isTouched(r1)
bool s1FirstTest = not s1Tested and isTouched(s1)

if ppFirstTest
    ppTested := true
if r1FirstTest
    r1Tested := true
if s1FirstTest
    s1Tested := true

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

var array<line>  currentLineArray  = array.new<line>()
var array<line>  historyLineArray  = array.new<line>()
var array<label> currentLabelArray = array.new<label>()

int n = bar_index

if newPeriod and not na(pp)
    // Freeze the elapsed ladder into history and enforce the display limit
    while array.size(currentLineArray) > 0
        array.push(historyLineArray, array.shift(currentLineArray))

    int maxHistory = (historyInput - 1) * (1 + 2 * rungsInput)

    while array.size(historyLineArray) > maxHistory
        line.delete(array.shift(historyLineArray))

    while array.size(currentLabelArray) > 0
        label.delete(array.shift(currentLabelArray))

    // Assemble the new ladder, central pivot first
    array<float>  levelValueArray = array.new<float>()
    array<string> levelNameArray  = array.new<string>()
    array<color>  levelColorArray = array.new<color>()

    array.push(levelValueArray, pp)
    array.push(levelNameArray, 'PP')
    array.push(levelColorArray, ppColorInput)

    if rungsInput >= 1
        array.push(levelValueArray, r1)
        array.push(levelNameArray, 'R1')
        array.push(levelColorArray, resColorInput)
        array.push(levelValueArray, s1)
        array.push(levelNameArray, 'S1')
        array.push(levelColorArray, supColorInput)

    if rungsInput >= 2
        array.push(levelValueArray, r2)
        array.push(levelNameArray, 'R2')
        array.push(levelColorArray, resColorInput)
        array.push(levelValueArray, s2)
        array.push(levelNameArray, 'S2')
        array.push(levelColorArray, supColorInput)

    if rungsInput >= 3
        array.push(levelValueArray, r3)
        array.push(levelNameArray, 'R3')
        array.push(levelColorArray, resColorInput)
        array.push(levelValueArray, s3)
        array.push(levelNameArray, 'S3')
        array.push(levelColorArray, supColorInput)

    for i = 0 to array.size(levelValueArray) - 1
        float levelValue = array.get(levelValueArray, i)
        color levelColor = array.get(levelColorArray, i)

        array.push(currentLineArray, line.new(n, levelValue, n, levelValue, color = levelColor, style = getLineStyle(i == 0 ? ppStyleInput : srStyleInput), width = widthInput))

        if showLabelsInput
            array.push(currentLabelArray, label.new(n, levelValue, getLabelText(array.get(levelNameArray, i), levelValue), color = LABEL_BG, textcolor = levelColor, style = label.style_label_left, size = size.small))

// Extend the current ladder to the latest bar
if array.size(currentLineArray) > 0
    for eachLine in currentLineArray
        line.set_x2(eachLine, n)

if array.size(currentLabelArray) > 0
    for eachLabel in currentLabelArray
        label.set_x(eachLabel, n)

// Data window readout of the active ladder
plot(pp, 'PP', ppColorInput, display = display.data_window)
plot(r1, 'R1', resColorInput, display = display.data_window)
plot(s1, 'S1', supColorInput, display = display.data_window)
plot(rungsInput >= 2 ? r2 : na, 'R2', resColorInput, display = display.data_window)
plot(rungsInput >= 2 ? s2 : na, 'S2', supColorInput, display = display.data_window)
plot(rungsInput >= 3 ? r3 : na, 'R3', resColorInput, display = display.data_window)
plot(rungsInput >= 3 ? s3 : na, 'S3', supColorInput, display = display.data_window)

// Anchor misconfiguration notice
var table warningTable = table.new(position.top_right, 1, 1)

if barstate.islast and not anchorValid
    table.cell(warningTable, 0, 0, 'Pivot Points: the anchor period must be above the chart timeframe', text_color = RES_COLOR, text_size = size.small, bgcolor = DASH_BG)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

bool crossAbovePp = ta.crossover(close, pp)
bool crossBelowPp = ta.crossunder(close, pp)
bool crossAboveR1 = ta.crossover(close, r1)
bool crossBelowS1 = ta.crossunder(close, s1)
bool crossAboveR2 = ta.crossover(close, r2)
bool crossBelowS2 = ta.crossunder(close, s2)
bool crossAboveR3 = ta.crossover(close, r3)
bool crossBelowS3 = ta.crossunder(close, s3)

// Crossings on the re-anchoring bar come from the level jump rather than a price move and are ignored
bool ladderActive = not na(pp) and not newPeriod

alertcondition(ladderActive and crossAbovePp, 'Price Crossed Above PP', 'Price crossed above the central pivot, an intraday bullish lean')
alertcondition(ladderActive and crossBelowPp, 'Price Crossed Below PP', 'Price crossed below the central pivot, an intraday bearish lean')
alertcondition(ladderActive and crossAboveR1, 'Price Crossed Above R1', 'Price crossed above resistance rung R1')
alertcondition(ladderActive and crossBelowS1, 'Price Crossed Below S1', 'Price crossed below support rung S1')
alertcondition(ladderActive and crossAboveR2, 'Price Crossed Above R2', 'Price crossed above resistance rung R2')
alertcondition(ladderActive and crossBelowS2, 'Price Crossed Below S2', 'Price crossed below support rung S2')
alertcondition(ladderActive and crossAboveR3, 'Price Crossed Above R3', 'Price crossed above resistance rung R3')
alertcondition(ladderActive and crossBelowS3, 'Price Crossed Below S3', 'Price crossed below support rung S3')
alertcondition(ppFirstTest, 'First Test of PP', 'First test of the central pivot this period')
alertcondition(r1FirstTest, 'First Test of R1', 'First test of resistance rung R1 this period')
alertcondition(s1FirstTest, 'First Test of S1', 'First test of support rung S1 this period')

//---------------------------------------------------------------------------------------------------------------------}
