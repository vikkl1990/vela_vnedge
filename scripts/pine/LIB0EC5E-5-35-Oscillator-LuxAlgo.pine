//@version=6
indicator("5/35 Oscillator", "5/35 Oscillator", overlay = false, format = format.price, max_lines_count = 500, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR      = #089981
BEAR_COLOR      = #f23645
ZERO_COLOR      = color.new(#787b86, 50)
FADE_TRANSP     = 60
DIV_LINE_WIDTH  = 2

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput        = input.source(close, "Source", group = "Settings",
     tooltip = "Price series averaged by both moving averages. The Elliott tradition commonly uses the close; hl2 (the bar midpoint) gives an Awesome-Oscillator-style construction.")

fastLengthInput = input.int(5, "Fast SMA Length", minval = 1, group = "Settings",
     tooltip = "Length of the short simple moving average, capturing the swing underway. The Elliott standard is 5.")

slowLengthInput = input.int(35, "Slow SMA Length", minval = 1, group = "Settings",
     tooltip = "Length of the long simple moving average, approximating the trend one degree higher. The Elliott standard is 35 — the 5/35 pairing was tuned for impulses spanning roughly 100 to 150 bars, so resize the chart to the wave degree being counted rather than editing the lengths.")

showReadsInput  = input.bool(true, "Show Wave Reads", group = "Wave Context Reads",
     tooltip = "Tags confirmed histogram extremes with the traditional wave-context reads. 3: the push printed a new sequence extreme, so the tradition treats it as (still) wave 3. 5: price reached a new extreme while the histogram posted a smaller peak — the fifth-wave divergence that traditionally flags completion, drawn with a line back to the peak it diverges from. Guidelines with exceptions, not a wave count.")

peakLengthInput = input.int(5, "Peak Confirmation Length", minval = 1, maxval = 50, group = "Wave Context Reads",
     tooltip = "Bars without a more extreme reading required on each side of a histogram extreme before it counts as a confirmed peak or trough. Reads and their alerts fire this many bars after the actual extreme and do not repaint once drawn.")

maxSpacingInput = input.int(150, "Max Bars Between Peaks", minval = 5, maxval = 500, group = "Wave Context Reads",
     tooltip = "Confirmed extremes further apart than this start a new sequence instead of being compared. The default mirrors the traditional guideline that the 5/35 mapping works best on impulses spanning roughly 100 to 150 bars.")

bullGrowInput   = input.color(BULL_COLOR, "Bullish  Growing", inline = "bull", group = "Style")
bullFadeInput   = input.color(color.new(BULL_COLOR, FADE_TRANSP), "Fading", inline = "bull", group = "Style",
     tooltip = "Colors of positive histogram bars: growing bars extend away from zero, fading bars shrink toward it, so the shading carries the acceleration read. The bullish color also marks 3 reads above zero and 5 divergence reads below zero.")

bearGrowInput   = input.color(BEAR_COLOR, "Bearish  Growing", inline = "bear", group = "Style")
bearFadeInput   = input.color(color.new(BEAR_COLOR, FADE_TRANSP), "Fading", inline = "bear", group = "Style",
     tooltip = "Colors of negative histogram bars: growing bars extend away from zero, fading bars shrink toward it. The bearish color also marks 3 reads below zero and 5 divergence reads above zero.")

zeroInput       = input.color(ZERO_COLOR, "Zero Line", group = "Style",
     tooltip = "Color of the zero reference line. The histogram is positive whenever the 5-period average sits above the 35-period one, so a sign flip is exactly the short average crossing the long.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//5/35 spread: the short average of the swing underway minus the long average of the trend one degree higher
fastMa = ta.sma(srcInput, fastLengthInput)
slowMa = ta.sma(srcInput, slowLengthInput)
osc    = fastMa - slowMa

//Bar-to-bar change, na-guarded over the warmup bars
delta = osc - nz(osc[1], osc)

//4-state histogram color: side of zero x growing/fading
oscColor = osc >= 0 ? (delta >= 0 ? bullGrowInput : bullFadeInput) : (delta <= 0 ? bearGrowInput : bearFadeInput)

//Zero crosses — arithmetically, the 5-period average crossing the 35-period one
crossUp   = ta.crossover(osc, 0)
crossDown = ta.crossunder(osc, 0)

//Confirmed histogram extremes, and the price extreme of the push around each one
peakOsc   = ta.pivothigh(osc, peakLengthInput, peakLengthInput)
troughOsc = ta.pivotlow(osc, peakLengthInput, peakLengthInput)
pushHigh  = ta.highest(high, peakLengthInput * 2 + 1)
pushLow   = ta.lowest(low, peakLengthInput * 2 + 1)

//---------------------------------------------------------------------------------------------------------------------}
// Wave Context Reads
//---------------------------------------------------------------------------------------------------------------------{
//Upside sequence state: most extreme positive peak, its bar, the sequence's price extreme, and the last confirmed peak bar.
//A sequence deliberately survives dips to or through zero (typical fourth-wave behavior) and only expires on spacing.
var float upSeqPeakOsc = na
var int   upSeqPeakBar = na
var float upSeqHigh    = na
var int   upSeqLastBar = na

//Downside sequence state
var float dnSeqTroughOsc = na
var int   dnSeqTroughBar = na
var float dnSeqLow       = na
var int   dnSeqLastBar   = na

bool strongerBullPeak   = false
bool strongerBearTrough = false
bool bearishDivergence  = false
bool bullishDivergence  = false

//Positive peaks — reads for an upside impulse
if not na(peakOsc) and peakOsc > 0
    int peakBar = bar_index - peakLengthInput
    if na(upSeqPeakOsc) or peakBar - upSeqLastBar > maxSpacingInput
        //First peak of a fresh sequence — provisional extreme, no read yet
        upSeqPeakOsc := peakOsc
        upSeqPeakBar := peakBar
        upSeqHigh    := pushHigh
    else
        if peakOsc > upSeqPeakOsc
            //Stronger reading than the running extreme — the tradition relabels this push as still part of wave 3
            strongerBullPeak := true
            if showReadsInput
                label.new(peakBar, peakOsc, "3", color = bullGrowInput, textcolor = chart.bg_color, style = label.style_label_down, size = size.small, tooltip = "New sequence extreme — the tradition reads this push as (still) wave 3")
            upSeqPeakOsc := peakOsc
            upSeqPeakBar := peakBar
        else if pushHigh > upSeqHigh and peakOsc < upSeqPeakOsc
            //New price high against a smaller oscillator peak — the traditional fifth-wave completion signal
            bearishDivergence := true
            if showReadsInput
                line.new(upSeqPeakBar, upSeqPeakOsc, peakBar, peakOsc, color = bearGrowInput, width = DIV_LINE_WIDTH)
                label.new(peakBar, peakOsc, "5", color = bearGrowInput, textcolor = chart.bg_color, style = label.style_label_down, size = size.small, tooltip = "New price high on a smaller peak — traditional fifth-wave divergence, completion warning")
        upSeqHigh := math.max(upSeqHigh, pushHigh)
    upSeqLastBar := peakBar

//Negative troughs — reads for a downside impulse
if not na(troughOsc) and troughOsc < 0
    int troughBar = bar_index - peakLengthInput
    if na(dnSeqTroughOsc) or troughBar - dnSeqLastBar > maxSpacingInput
        //First trough of a fresh sequence — provisional extreme, no read yet
        dnSeqTroughOsc := troughOsc
        dnSeqTroughBar := troughBar
        dnSeqLow       := pushLow
    else
        if troughOsc < dnSeqTroughOsc
            //Deeper reading than the running extreme — the tradition relabels this decline as still part of wave 3
            strongerBearTrough := true
            if showReadsInput
                label.new(troughBar, troughOsc, "3", color = bearGrowInput, textcolor = chart.bg_color, style = label.style_label_up, size = size.small, tooltip = "New sequence extreme — the tradition reads this decline as (still) wave 3")
            dnSeqTroughOsc := troughOsc
            dnSeqTroughBar := troughBar
        else if pushLow < dnSeqLow and troughOsc > dnSeqTroughOsc
            //New price low against a shallower oscillator trough — the traditional fifth-wave completion signal
            bullishDivergence := true
            if showReadsInput
                line.new(dnSeqTroughBar, dnSeqTroughOsc, troughBar, troughOsc, color = bullGrowInput, width = DIV_LINE_WIDTH)
                label.new(troughBar, troughOsc, "5", color = bullGrowInput, textcolor = chart.bg_color, style = label.style_label_up, size = size.small, tooltip = "New price low on a shallower trough — traditional fifth-wave divergence, completion warning")
        dnSeqLow := math.min(dnSeqLow, pushLow)
    dnSeqLastBar := troughBar

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
hline(0, "Zero Line", zeroInput, hline.style_dotted)

plot(osc, "5/35 Oscillator", oscColor, 1, plot.style_columns)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp,   "Bullish Zero Cross", "5/35 Oscillator crossed above zero (5-period SMA back above the 35-period SMA) on {{ticker}} - {{interval}}; in a downside count, a return to or through zero is typical fourth-wave behavior")
alertcondition(crossDown, "Bearish Zero Cross", "5/35 Oscillator crossed below zero (5-period SMA back below the 35-period SMA) on {{ticker}} - {{interval}}; in an upside count, a return to or through zero is typical fourth-wave behavior")

alertcondition(strongerBullPeak,   "Stronger Bullish Peak (Wave 3 Tendency)",  "5/35 Oscillator printed a new positive sequence extreme on {{ticker}} - {{interval}} — the tradition reads this push as (still) wave 3")
alertcondition(bearishDivergence,  "Bearish Divergence (Wave 5 Tendency)",     "New price high against a smaller 5/35 Oscillator peak on {{ticker}} - {{interval}} — traditional fifth-wave completion warning")
alertcondition(strongerBearTrough, "Stronger Bearish Trough (Wave 3 Tendency)", "5/35 Oscillator printed a new negative sequence extreme on {{ticker}} - {{interval}} — the tradition reads this decline as (still) wave 3")
alertcondition(bullishDivergence,  "Bullish Divergence (Wave 5 Tendency)",     "New price low against a shallower 5/35 Oscillator trough on {{ticker}} - {{interval}} — traditional fifth-wave completion warning")

//---------------------------------------------------------------------------------------------------------------------}
