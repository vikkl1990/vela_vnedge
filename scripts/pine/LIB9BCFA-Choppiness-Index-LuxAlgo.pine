//@version=6
indicator("Choppiness Index", "CHOP", overlay = false, format = format.price, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // trending market - readings at or below the lower band
BEAR_COLOR    = #f23645 // choppy market - readings at or above the upper band
NEUTRAL_COLOR = #787b86 // readings between the bands, and the bands themselves

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_MID_TRANSP  = 100 // gradient transparency at the midpoint end of the fill
ZONE_TRANSP      = 92  // transparency of the soft choppy / trending zone shading

SCALE_TOP    = 100 // bounded scale of the index
SCALE_BOTTOM = 0
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 2, group = "Settings",
  tooltip = "Number of bars used to sum true ranges and to measure the highest high - lowest low range")

upperBandInput = input.float(61.8, "Upper Band", minval = 0, maxval = 100, step = 0.1, group = "Settings",
  tooltip = "Readings above this level indicate a choppy, range-bound market")

lowerBandInput = input.float(38.2, "Lower Band", minval = 0, maxval = 100, step = 0.1, group = "Settings",
  tooltip = "Readings below this level indicate a strong trend")

chopColorInput = input.color(NEUTRAL_COLOR, "CHOP Line", group = "Style",
  tooltip = "Color of the Choppiness Index line")

trendColorInput = input.color(BULL_COLOR, "Trending", inline = "state", group = "Style",
  tooltip = "Line, fill and zone color toward and below the lower band - a trending market")

choppyColorInput = input.color(BEAR_COLOR, "Choppy", inline = "state", group = "Style",
  tooltip = "Line, fill and zone color toward and above the upper band - a choppy, range-bound market")

fillColorInput = input.color(color.new(NEUTRAL_COLOR, 90), "Band Fill", group = "Style",
  tooltip = "Fill color of the zone between the upper and lower bands")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
sumTrueRange = math.sum(ta.tr(true), lengthInput)
hlRange = ta.highest(high, lengthInput) - ta.lowest(low, lengthInput)

chop = hlRange > 0 ? 100 * math.log10(sumTrueRange / hlRange) / math.log10(lengthInput) : float(na)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring across the bands - trending toward the lower band, neutral midway, choppy toward the upper band
midBand   = (upperBandInput + lowerBandInput) / 2
chopColor = na(chop) ? chopColorInput : chop <= midBand ? color.from_gradient(chop, lowerBandInput, midBand, trendColorInput, chopColorInput) : color.from_gradient(chop, midBand, upperBandInput, chopColorInput, choppyColorInput)

chopPlotId = plot(chop, "CHOP", chopColor)
midPlotId  = plot(midBand, "Midpoint Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward the midpoint of the bands, following the line color
fill(chopPlotId, midPlotId, math.max(chop, midBand), math.min(chop, midBand), chop > midBand ? color.new(chopColor, FILL_LINE_TRANSP) : color.new(chopColor, FILL_MID_TRANSP), chop > midBand ? color.new(chopColor, FILL_MID_TRANSP) : color.new(chopColor, FILL_LINE_TRANSP), title = "CHOP Gradient")

upperBandId = hline(upperBandInput, "Upper Band", NEUTRAL_COLOR, hline.style_dashed)
lowerBandId = hline(lowerBandInput, "Lower Band", NEUTRAL_COLOR, hline.style_dashed)

fill(upperBandId, lowerBandId, fillColorInput, "Band Fill")

// Soft zone shading - choppy band above the upper band, trending band below the lower band
upperZoneId = plot(upperBandInput, "Upper Band Anchor", color(na), editable = false, display = display.none)
lowerZoneId = plot(lowerBandInput, "Lower Band Anchor", color(na), editable = false, display = display.none)
topAnchorId = plot(SCALE_TOP, "Top Anchor", color(na), editable = false, display = display.none)
botAnchorId = plot(SCALE_BOTTOM, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(upperZoneId, topAnchorId, color.new(choppyColorInput, ZONE_TRANSP), title = "Choppy Zone")
fill(lowerZoneId, botAnchorId, color.new(trendColorInput, ZONE_TRANSP), title = "Trending Zone")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
trendingCross = ta.crossunder(chop, lowerBandInput)
choppyCross = ta.crossover(chop, upperBandInput)

alertcondition(trendingCross, "Trending Market", "Choppiness Index crossed below the lower band (trending market)")
alertcondition(choppyCross, "Choppy Market", "Choppiness Index crossed above the upper band (choppy market)")
//----------------------------------------------------------------------------------------------------------------------}
