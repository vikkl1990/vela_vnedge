//@version=6
indicator("Force Index", "FI", overlay = false, format = format.volume, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(13, "Length", minval = 1, group = "Settings", tooltip = "EMA length applied to the raw 1 bar force index, (close - close[1]) * volume. Elder used 13 for the intermediate trend and 2 for short term timing.")

fiColorInput = input.color(BULL_COLOR, "Force Index", inline = "colors", group = "Style", tooltip = "Color of the force index line while above zero (buying pressure).")
bearColorInput = input.color(BEAR_COLOR, "", inline = "colors", group = "Style", tooltip = "Color of the force index line while below zero (selling pressure).")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
rawForceIndex = ta.change(close) * volume
forceIndex    = ta.ema(rawForceIndex, lengthInput)

crossUp   = ta.crossover(forceIndex, 0)
crossDown = ta.crossunder(forceIndex, 0)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
fiColor = forceIndex >= 0 ? fiColorInput : bearColorInput

fiPlot   = plot(forceIndex, "Force Index", fiColor, 2)
zeroPlot = plot(0, "Zero Anchor", display = display.none, editable = false)
fill(fiPlot, zeroPlot, forceIndex, 0, color.new(fiColor, 60), color.new(fiColor, 100))

hline(0, "Zero Line", NEUTRAL_COLOR, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Bullish Zero Cross", "Force Index crossed above 0")
alertcondition(crossDown, "Bearish Zero Cross", "Force Index crossed below 0")
//----------------------------------------------------------------------------------------------------------------------}
