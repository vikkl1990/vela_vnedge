//@version=6
indicator("Positive Volume Index", shorttitle = "Positive Volume Index", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR         = #089981 // directional bullish color
BEAR_COLOR         = #f23645 // directional bearish color
NEUTRAL_COLOR      = #787b86 // non-directional color - used while the signal EMA is still forming
SIGNAL_COLOR       = #787b86 // signal line color - the reference line is structure
FILL_VALUE_TRANSP  = 50      // gradient transparency at the PVI value
FILL_SIGNAL_TRANSP = 100     // gradient transparency at the signal EMA

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
sourceInput       = input.source(close, "Source", group = "Settings",
     tooltip = "Price series whose one-bar percentage change moves PVI on its active sessions. The classic Dysart/Fosback construction uses the close.")

startValueInput   = input.float(1000, "Starting Value", minval = 1, group = "Settings",
     tooltip = "Seed of the cumulative line. The absolute PVI level carries no information - it depends entirely on this seed and on where the data begins - so the reads are the slope and the position against the signal EMA. 1000 is the conventional seed.")

showSignalInput   = input.bool(true, "Signal EMA", inline = "signal", group = "Settings",
     tooltip = "Plots the long EMA of PVI that anchors the classic regime read: PVI above its own average is treated as a bullish environment, below it as bearish. Hiding the line keeps the regime coloring, gradient fill and alerts, which are always measured against it.")

signalLengthInput = input.int(255, "", minval = 1, inline = "signal", group = "Settings",
     tooltip = "Length of the signal EMA. The classic reference is a one-year average - 255 trading days on daily charts. PVI is slow by construction and suits regime filtering better than trade timing.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "regime", group = "Style",
     tooltip = "Color of the PVI line and gradient fill while PVI holds above its signal EMA - the bullish environment read.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "regime", group = "Style",
     tooltip = "Color of the PVI line and gradient fill while PVI holds below its signal EMA - the bearish environment read.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral", group = "Style",
     tooltip = "Color of the PVI line while the signal EMA is still forming - fewer bars on the chart than its length - and no regime read exists yet.")

signalColorInput  = input.color(SIGNAL_COLOR, "Signal Line", group = "Style",
     tooltip = "Color of the signal EMA line.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the gap between PVI and its signal EMA with a vertical gradient - fully transparent at the average, strongest at the PVI value - bullish or bearish by regime.")

//---------------------------------------------------------------------------------------------------------------------}
// Positive Volume Index
//---------------------------------------------------------------------------------------------------------------------{
// The study needs a genuine volume feed - without one every session would read as inactive and the line would never move
float cumulativeVolume = ta.cum(nz(volume))
if barstate.islast and cumulativeVolume == 0
    runtime.error("No volume is provided by the data vendor. Positive Volume Index requires volume data.")

// Dysart/Fosback cumulative line. Sessions where volume rises above the prior session's volume are the crowd-active
// days; on those bars PVI compounds by the bar's percentage price change, on every other bar it holds flat. The line
// therefore isolates what price does when participation is broad and emotional - the mirror premise of the Negative
// Volume Index, which tracks the quiet sessions instead.
// The first bar (no prior volume or close), unreported volume and a zero prior source all count as inactive, keeping
// the line defined from the first bar instead of poisoning the running product with na
bool  activeSession    = not na(volume) and not na(volume[1]) and volume > volume[1]
float previousSource   = sourceInput[1]
float fractionalChange = not na(previousSource) and previousSource != 0 ? (sourceInput - previousSource) / previousSource : na

var float pvi = startValueInput
if activeSession and not na(fractionalChange)
    pvi := pvi * (1 + fractionalChange)

// Regime benchmark - Fosback's long EMA of the index itself, conventionally one year. Above it the crowd-driven
// sessions are trending better than their own norm, the classic bullish environment; below it, the bearish one
float signalEma = ta.ema(pvi, signalLengthInput)

bool bullishRegime = not na(signalEma) and pvi >= signalEma
bool bearishRegime = not na(signalEma) and pvi < signalEma

// Signal grammar - regime flips where PVI crosses its long average, and slope turns on the crowd-active days
// (PVI only moves when volume expands, so a slope turn marks the latest high-participation session changing sides)
bool crossAbove = ta.crossover(pvi, signalEma)
bool crossBelow = ta.crossunder(pvi, signalEma)

bool pviRising  = pvi > nz(pvi[1], pvi)
bool pviFalling = pvi < nz(pvi[1], pvi)

bool turnedRising  = pviRising and not pviRising[1]
bool turnedFalling = pviFalling and not pviFalling[1]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color pviColor = bullishRegime ? bullColorInput : bearishRegime ? bearColorInput : neutralColorInput

signalPlotId = plot(signalEma, "Signal EMA", color = showSignalInput ? signalColorInput : na, linewidth = 1)
pviPlotId    = plot(pvi, "PVI", color = pviColor, linewidth = 2)

// Centered-oscillator gradient with the signal EMA as the center - fully transparent at the average, strongest at PVI
color fillTopColor    = bullishRegime ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_SIGNAL_TRANSP)
color fillBottomColor = bullishRegime ? color.new(bullColorInput, FILL_SIGNAL_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(pviPlotId, signalPlotId, top_value = math.max(pvi, signalEma), bottom_value = math.min(pvi, signalEma), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Regime Gradient Fill")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossAbove, "Bullish Regime Cross", "Positive Volume Index crossed above its signal EMA on {{ticker}} - crowd-active sessions now trend above their long-run norm, the classic bullish environment read; agreement from NVI strengthens it ({{interval}})")
alertcondition(crossBelow, "Bearish Regime Cross", "Positive Volume Index crossed below its signal EMA on {{ticker}} - crowd-active sessions now trend below their long-run norm, the classic bearish environment read; agreement from NVI strengthens it ({{interval}})")
alertcondition(turnedRising, "PVI Turned Rising", "Positive Volume Index turned rising on {{ticker}} - the latest rising-volume session closed higher, so the high-participation days are pushing price up ({{interval}})")
alertcondition(turnedFalling, "PVI Turned Falling", "Positive Volume Index turned falling on {{ticker}} - the latest rising-volume session closed lower, a sign the active days are being sold into ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
