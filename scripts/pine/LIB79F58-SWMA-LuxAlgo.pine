//@version=6
indicator("SWMA", shorttitle = "SWMA", overlay = true, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
int STANDARD_LENGTH = 4

BULL_COLOR    = #089981 // rising SWMA
BEAR_COLOR    = #f23645 // falling SWMA
NEUTRAL_COLOR = #787b86 // flat, or directional coloring disabled
ACCENT_COLOR  = #ff9800 // the one accent - the optional pre-filtered average

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

srcInput = input.source(close, 'Source', group = 'Settings'
  , tooltip = 'Series the symmetric weights are applied to. The standard SWMA smooths the close.')

lengthInput = input.int(STANDARD_LENGTH, 'Window Length', minval = 2, maxval = 500, group = 'Settings'
  , tooltip = 'Number of bars in the symmetric window. The default of 4 is the standard fixed SWMA with weights 1/6, 2/6, 2/6, 1/6 (1-2-2-1). Other values build the generalized symmetric profile [1, 2, ..., 2, 1]: interior bars count double, both edges count single, and the weights sum to 1. Every window delays the smoothed line by a constant (length - 1) / 2 bars.')

preFilterInput = input.bool(false, 'Show Pre-Filtered Average', group = 'Pre-Filter Usage'
  , tooltip = 'Plots a longer moving average computed on the SWMA output instead of the raw source, reproducing the documented role of the SWMA as a pre-smoothing stage: one-bar spikes are removed before the slower average sees them, at a cost of only (length - 1) / 2 bars of delay.')

preTypeInput = input.string('SMA', 'Method', options = ['SMA', 'EMA', 'RMA', 'WMA'], group = 'Pre-Filter Usage'
  , tooltip = 'Moving average type of the longer pre-filtered average.')

preLengthInput = input.int(20, 'Length', minval = 1, maxval = 500, group = 'Pre-Filter Usage'
  , tooltip = 'Length of the longer pre-filtered average.')

showDashboardInput = input.bool(true, 'Show Dashboard', group = 'Dashboard'
  , tooltip = 'Displays the window length and its constant delay of (length - 1) / 2 bars, the linear-phase property that makes the smoothed line a uniformly shifted, undistorted copy of the low-frequency content of price.')

dashLocationInput = input.string('Top Right', 'Location', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = 'Dashboard'
  , tooltip = 'Position of the dashboard on the chart.')

dashSizeInput = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal'], group = 'Dashboard'
  , tooltip = 'Text size of the dashboard.')

directionalInput = input.bool(true, 'Directional Coloring', group = 'Style'
  , tooltip = 'Colors the SWMA by the sign of its bar-to-bar change, mirroring the comparison of consecutive SWMA values used as a gentler price proxy. Disable to use the neutral color only.')

bullColorInput = input.color(BULL_COLOR, 'Rising', group = 'Style', inline = 'dir')
bearColorInput = input.color(BEAR_COLOR, 'Falling', group = 'Style', inline = 'dir')
neutralColorInput = input.color(NEUTRAL_COLOR, 'Neutral', group = 'Style', inline = 'dir')

preColorInput = input.color(ACCENT_COLOR, 'Pre-Filtered Average', group = 'Style')

markersInput = input.bool(false, 'Show Turn Markers', group = 'Style'
  , tooltip = 'Highlights bars where the SWMA slope flips from falling to rising or from rising to falling. Markers are off by default; the matching alert conditions are always available.')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Symmetric weighted moving average with the mirrored weight profile
// [1, 2, ..., 2, 1] / (2 * (length - 1)): interior bars count double, both
// edges count single, and the weights sum to 1. Averaging two adjacent
// simple averages of (length - 1) bars produces exactly that kernel:
//   SWMA_t = (SMA(length - 1)_t + SMA(length - 1)_(t-1)) / 2
// With the default 4-bar window this is the standard fixed form
//   SWMA_t = (1 * C_(t-3) + 2 * C_(t-2) + 2 * C_(t-1) + 1 * C_t) / 6
// Because the kernel is center-symmetric the filter has exactly linear
// phase: every component it passes is delayed by (length - 1) / 2 bars.
symmetricWMA(float source, simple int length) =>
    float halfWindow = ta.sma(source, length - 1)
    math.avg(halfWindow, halfWindow[1])

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
float swmaValue = symmetricWMA(srcInput, lengthInput)

// Comparison of consecutive SWMA values, the gentler stand-in for comparing consecutive closes
float swmaChange = swmaValue - swmaValue[1]

var int slopeDirection = 0
int previousSlopeDirection = slopeDirection
slopeDirection := swmaChange > 0 ? 1 : swmaChange < 0 ? -1 : slopeDirection

bool turnedUp = slopeDirection == 1 and previousSlopeDirection == -1
bool turnedDown = slopeDirection == -1 and previousSlopeDirection == 1

// Longer averages fed with the SWMA instead of the raw source (pre-filter role)
float preSma = ta.sma(swmaValue, preLengthInput)
float preEma = ta.ema(swmaValue, preLengthInput)
float preRma = ta.rma(swmaValue, preLengthInput)
float preWma = ta.wma(swmaValue, preLengthInput)

float preFilteredValue = switch preTypeInput
    'SMA' => preSma
    'EMA' => preEma
    'RMA' => preRma
    => preWma

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color swmaColor = directionalInput ? (slopeDirection == 1 ? bullColorInput : slopeDirection == -1 ? bearColorInput : neutralColorInput) : neutralColorInput

plot(swmaValue, 'SWMA', swmaColor, 2)
plot(preFilterInput ? preFilteredValue : na, 'Pre-Filtered Average', preColorInput)

plotshape(markersInput and turnedUp ? swmaValue : na, 'Turn Up', shape.circle, location.absolute, bullColorInput, size = size.tiny)
plotshape(markersInput and turnedDown ? swmaValue : na, 'Turn Down', shape.circle, location.absolute, bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
string tablePosition = switch dashLocationInput
    'Top Right'    => position.top_right
    'Top Left'     => position.top_left
    'Bottom Right' => position.bottom_right
    => position.bottom_left

string tableTextSize = switch dashSizeInput
    'Tiny'  => size.tiny
    'Small' => size.small
    => size.normal

var table dashboardTable = na

if showDashboardInput and barstate.isfirst
    dashboardTable := table.new(tablePosition, 2, 2, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if showDashboardInput and barstate.islast and not na(dashboardTable)
    string windowText = lengthInput == STANDARD_LENGTH ? '4 bars (1-2-2-1)' : str.tostring(lengthInput) + ' bars (symmetric)'
    string delayText = str.tostring((lengthInput - 1) / 2.0, '#.##') + ' bars'

    table.cell(dashboardTable, 0, 0, 'Window', text_color = DASH_HEADER, text_size = tableTextSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 0, windowText, text_color = DASH_TEXT, text_size = tableTextSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 1, 'Delay', text_color = DASH_HEADER, text_size = tableTextSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 1, delayText, text_color = DASH_TEXT, text_size = tableTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(turnedUp, 'SWMA Turn Up', 'SWMA slope turned upward, consecutive SWMA values started rising')
alertcondition(turnedDown, 'SWMA Turn Down', 'SWMA slope turned downward, consecutive SWMA values started falling')

//---------------------------------------------------------------------------------------------------------------------}
