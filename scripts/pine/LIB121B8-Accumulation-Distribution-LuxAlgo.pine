//@version=6
indicator("Accumulation/Distribution", "A/D", overlay = false, format = format.volume)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // line rising - money flowing in (accumulation)
BEAR_COLOR    = #f23645 // line falling - money flowing out (distribution)
NEUTRAL_COLOR = #787b86 // flat bar, or slope coloring disabled
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
slopeColorInput = input.bool(true, "Slope Coloring", group = "Style", tooltip = "Color the line by its slope - bullish while rising (accumulation), bearish while falling (distribution).")
adColorInput    = input.color(NEUTRAL_COLOR, "A/D Line", group = "Style", tooltip = "Color of the Accumulation/Distribution Line when slope coloring is disabled or the line is flat.")
bullColorInput  = input.color(BULL_COLOR, "Rising", inline = "slope", group = "Style", tooltip = "Line color while the A/D Line rises.")
bearColorInput  = input.color(BEAR_COLOR, "Falling", inline = "slope", group = "Style", tooltip = "Line color while the A/D Line falls.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
// Money flow volume = close location value * volume; per spec a flat bar (high == low) contributes 0
mfv = high == low ? 0.0 : (2 * close - low - high) / (high - low) * volume

var float adl = na
adl := nz(adl[1]) + mfv
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
adColor = slopeColorInput ? (adl > adl[1] ? bullColorInput : adl < adl[1] ? bearColorInput : adColorInput) : adColorInput

plot(adl, "A/D", color = adColor)
//----------------------------------------------------------------------------------------------------------------------}
