//@version=6
indicator("OBV Divergence", shorttitle = "OBV Divergence", overlay = false, format = format.volume, max_lines_count = 500, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR     = #089981
BEAR_COLOR     = #f23645
NEUTRAL_COLOR  = #787b86 // the OBV line itself is structure - the divergences carry the color
DIV_LINE_WIDTH = 2

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
swingLeftInput = input.int(5, "Left Bars", minval = 1, maxval = 50, inline = "swing", group = "Swing Detection",
     tooltip = "Bars that must print to the left of a price swing point without exceeding it.")

swingRightInput = input.int(5, "Right Bars", minval = 1, maxval = 50, inline = "swing", group = "Swing Detection",
     tooltip = "Bars that must print to the right of a price swing point without exceeding it before the swing counts as confirmed. OBV is read at the same swing bar, and a divergence only fires once the second swing is confirmed — signals arrive with this delay but drawn swings do not repaint.")

maxSwingGapInput = input.int(60, "Max Bars Between Swings", minval = 5, maxval = 500, group = "Swing Detection",
     tooltip = "Maximum distance in bars between the two successive swing points being compared. Swings further apart than this are not treated as part of the same move and are not compared.")

hiddenInput = input.bool(false, "Detect Hidden Divergences", group = "Divergences",
     tooltip = "Also detect hidden divergences: price holding a higher low while OBV makes a lower low (bullish), or price printing a lower high while OBV makes a higher high (bearish). Read as trend continuation rather than reversal — the same swing comparison, screened for less often on OBV than on oscillators, so it is disabled by default.")

showObvLinesInput = input.bool(true, "Divergence Lines on OBV", group = "Style",
     tooltip = "Draws the line connecting the two OBV swing points of each divergence in this pane. Regular divergences are solid, hidden divergences dashed.")

showPriceLinesInput = input.bool(true, "Divergence Lines on Price", group = "Style",
     tooltip = "Marks the two successive price swing points of each divergence with a matching line on the main chart.")

showLabelsInput = input.bool(true, "Signal Labels", group = "Style",
     tooltip = "Marks the confirming OBV swing point with a Bull / Bear label in this pane.")

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "colors", group = "Style",
     tooltip = "Color of bullish divergence lines and labels.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = "Style",
     tooltip = "Color of bearish divergence lines and labels.")

obvColorInput = input.color(NEUTRAL_COLOR, "OBV Line", group = "Style",
     tooltip = "Color of the On-Balance Volume line. Its absolute value is meaningless — only the line's swings and slope matter, which is what the divergence comparison reads.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Draws one confirmed divergence: the OBV-swing line in this pane, the price-swing line on the main chart,
// and the label at the confirming OBV swing point
drawDivergence(int x1, float obvY1, int x2, float obvY2, float priceY1, float priceY2, color divColor, string divText, string divTooltip, bool isBull, bool isHidden) =>
    lineStyle = isHidden ? line.style_dashed : line.style_solid
    if showObvLinesInput
        line.new(x1, obvY1, x2, obvY2, color = divColor, width = DIV_LINE_WIDTH, style = lineStyle)
    if showPriceLinesInput
        line.new(x1, priceY1, x2, priceY2, color = divColor, width = DIV_LINE_WIDTH, style = lineStyle, force_overlay = true)
    if showLabelsInput
        label.new(x2, obvY2, divText, color = divColor, textcolor = chart.bg_color, style = isBull ? label.style_label_up : label.style_label_down, size = size.small, tooltip = divTooltip)

//---------------------------------------------------------------------------------------------------------------------}
// On-Balance Volume
//---------------------------------------------------------------------------------------------------------------------{
// Running total adding a bar's entire volume when it closes above the prior close and subtracting it when it closes below
var float obv = 0.0
closeChange = ta.change(close)
obv += math.sign(nz(closeChange)) * nz(volume)

//---------------------------------------------------------------------------------------------------------------------}
// Divergence Detection
//---------------------------------------------------------------------------------------------------------------------{
pivotHighPrice = ta.pivothigh(high, swingLeftInput, swingRightInput)
pivotLowPrice  = ta.pivotlow(low, swingLeftInput, swingRightInput)

// Previous confirmed swings — price, OBV read at the same swing bar, and swing bar index
var float prevHighPrice = na
var float prevHighObv   = na
var int   prevHighBar   = na
var float prevLowPrice  = na
var float prevLowObv    = na
var int   prevLowBar    = na

bool bullishDivergence       = false
bool bearishDivergence       = false
bool hiddenBullishDivergence = false
bool hiddenBearishDivergence = false

// Swing highs — regular bearish: price higher high against OBV lower high, the advance attracting less cumulative volume support
if not na(pivotHighPrice)
    float swingObv  = obv[swingRightInput]
    int   swingBar  = bar_index - swingRightInput
    bool comparable = not na(prevHighPrice) and not na(prevHighObv) and not na(swingObv) and swingBar - prevHighBar <= maxSwingGapInput
    if comparable and pivotHighPrice > prevHighPrice and swingObv < prevHighObv
        bearishDivergence := true
        drawDivergence(prevHighBar, prevHighObv, swingBar, swingObv, prevHighPrice, pivotHighPrice, bearColorInput, "Bear", "Bearish OBV divergence — higher high in price, lower high in OBV", false, false)
    if hiddenInput and comparable and pivotHighPrice < prevHighPrice and swingObv > prevHighObv
        hiddenBearishDivergence := true
        drawDivergence(prevHighBar, prevHighObv, swingBar, swingObv, prevHighPrice, pivotHighPrice, bearColorInput, "Hidden Bear", "Hidden bearish OBV divergence — lower high in price, higher high in OBV", false, true)
    prevHighPrice := pivotHighPrice
    prevHighObv   := swingObv
    prevHighBar   := swingBar

// Swing lows — regular bullish: price lower low against OBV higher low, selling pressure failing to expand
if not na(pivotLowPrice)
    float swingObv  = obv[swingRightInput]
    int   swingBar  = bar_index - swingRightInput
    bool comparable = not na(prevLowPrice) and not na(prevLowObv) and not na(swingObv) and swingBar - prevLowBar <= maxSwingGapInput
    if comparable and pivotLowPrice < prevLowPrice and swingObv > prevLowObv
        bullishDivergence := true
        drawDivergence(prevLowBar, prevLowObv, swingBar, swingObv, prevLowPrice, pivotLowPrice, bullColorInput, "Bull", "Bullish OBV divergence — lower low in price, higher low in OBV", true, false)
    if hiddenInput and comparable and pivotLowPrice > prevLowPrice and swingObv < prevLowObv
        hiddenBullishDivergence := true
        drawDivergence(prevLowBar, prevLowObv, swingBar, swingObv, prevLowPrice, pivotLowPrice, bullColorInput, "Hidden Bull", "Hidden bullish OBV divergence — higher low in price, lower low in OBV", true, true)
    prevLowPrice := pivotLowPrice
    prevLowObv   := swingObv
    prevLowBar   := swingBar

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
plot(obv, "OBV", color = obvColorInput, linewidth = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullishDivergence, "Bullish OBV Divergence", "Bullish OBV divergence confirmed on {{ticker}} ({{interval}}) — price lower low against OBV higher low, selling pressure failing to expand. Await price confirmation before acting.")
alertcondition(bearishDivergence, "Bearish OBV Divergence", "Bearish OBV divergence confirmed on {{ticker}} ({{interval}}) — price higher high against OBV lower high, the advance lacking cumulative volume support. Await price confirmation before acting.")
alertcondition(hiddenBullishDivergence, "Hidden Bullish OBV Divergence", "Hidden bullish OBV divergence confirmed on {{ticker}} ({{interval}}) — price higher low against OBV lower low, read as trend continuation.")
alertcondition(hiddenBearishDivergence, "Hidden Bearish OBV Divergence", "Hidden bearish OBV divergence confirmed on {{ticker}} ({{interval}}) — price lower high against OBV higher high, read as trend continuation.")

//---------------------------------------------------------------------------------------------------------------------}
