//@version=6
indicator("PVO", shorttitle = "PVO", overlay = false, format = format.percent, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

color EXPANSION_COLOR   = #089981
color CONTRACTION_COLOR = #f23645
color SIGNAL_COLOR      = #ff9800 // the one accent - the signal line
color NEUTRAL_COLOR     = #787b86

string OSC_GROUP   = 'Oscillator'
string STYLE_GROUP = 'Style'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

fastLengthInput = input.int(12, 'Fast Length', minval = 1, group = OSC_GROUP, tooltip = 'Period of the fast EMA of volume. The conventional setting is 12. Shorter settings make the PVO a faster but noisier participation gauge.')

slowLengthInput = input.int(26, 'Slow Length', minval = 1, group = OSC_GROUP, tooltip = 'Period of the slow EMA of volume. The conventional setting is 26. The PVO expresses the fast/slow spread as a percentage of this slow average, so it also defines the baseline that volume expansion is judged against.')

signalLengthInput = input.int(9, 'Signal Length', minval = 1, group = OSC_GROUP, tooltip = 'Period of the EMA applied to the PVO to form the signal line. The conventional setting is 9. The histogram plots the difference between the PVO and this signal line.')

expansionColorInput   = input.color(EXPANSION_COLOR, 'Expansion Color', group = STYLE_GROUP)
contractionColorInput = input.color(CONTRACTION_COLOR, 'Contraction Color', group = STYLE_GROUP)
signalColorInput      = input.color(SIGNAL_COLOR, 'Signal Line', group = STYLE_GROUP)
zeroColorInput        = input.color(color.new(NEUTRAL_COLOR, 50), 'Zero Line', group = STYLE_GROUP)

showSignalInput = input.bool(true, 'Show Signal Line', group = STYLE_GROUP, tooltip = 'Plot the signal line, an EMA of the PVO. Signal cross alerts remain available even when the line is hidden.')

showHistogramInput = input.bool(true, 'Show Histogram', group = STYLE_GROUP, tooltip = 'Plot the histogram, the difference between the PVO and its signal line, as columns behind the oscillator.')

zeroCrossMarkersInput = input.bool(false, 'Zero Cross Markers', group = STYLE_GROUP, tooltip = 'Mark bars where the PVO crosses the zero line with a circle. The PVO is direction-blind, volume expands on heavy selling exactly as it does on heavy buying, so pair these crosses with price context. Zero cross alerts remain available even when markers are hidden.')

//---------------------------------------------------------------------------------------------------------------------}
// PVO
//---------------------------------------------------------------------------------------------------------------------{

// Volume guard, the oscillator is undefined on symbols without volume data
float cumulativeVolume = ta.cum(nz(volume))

// PVO = 100 * (EMA_fast(volume) - EMA_slow(volume)) / EMA_slow(volume)
// Volume cannot be negative, so the PVO is bounded below near -100 but has no fixed upper bound during volume spikes
float fastEma = ta.ema(nz(volume), fastLengthInput)
float slowEma = ta.ema(nz(volume), slowLengthInput)
float pvo     = slowEma > 0 ? 100 * (fastEma - slowEma) / slowEma : na

// Signal line, EMA of the PVO; histogram, PVO minus signal
float pvoSignal    = ta.ema(pvo, signalLengthInput)
float pvoHistogram = pvo - pvoSignal

// Zero crosses separate expanding participation from contracting participation
bool zeroCrossUp   = ta.crossover(pvo, 0)
bool zeroCrossDown = ta.crossunder(pvo, 0)

// Signal crosses mark shifts in volume momentum, saying nothing directly about price direction
bool signalCrossUp   = ta.crossover(pvo, pvoSignal)
bool signalCrossDown = ta.crossunder(pvo, pvoSignal)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

color pvoColor       = pvo > 0 ? expansionColorInput : contractionColorInput
color histogramColor = pvoHistogram > 0 ? color.new(expansionColorInput, 60) : color.new(contractionColorInput, 60)

plot(showHistogramInput ? pvoHistogram : na, 'Histogram', histogramColor, 1, plot.style_columns)

pvoPlotId  = plot(pvo, 'PVO', pvoColor, 1)
zeroPlotId = plot(0, 'Zero Line', zeroColorInput, 1)

plot(showSignalInput ? pvoSignal : na, 'Signal', signalColorInput, 1)

// Gradient fill from the zero line to the oscillator, fully transparent at zero
fill(pvoPlotId, zeroPlotId, top_value = math.max(pvo, 0), bottom_value = math.min(pvo, 0), top_color = pvo > 0 ? color.new(expansionColorInput, 50) : color.new(contractionColorInput, 100), bottom_color = pvo > 0 ? color.new(expansionColorInput, 100) : color.new(contractionColorInput, 50), title = 'Oscillator Gradient')

plotshape(zeroCrossMarkersInput and zeroCrossUp ? 0 : na, 'Expansion Zero Cross', shape.circle, location.absolute, expansionColorInput, size = size.tiny)
plotshape(zeroCrossMarkersInput and zeroCrossDown ? 0 : na, 'Contraction Zero Cross', shape.circle, location.absolute, contractionColorInput, size = size.tiny)

if barstate.islast and cumulativeVolume == 0
    runtime.error('The PVO requires volume data, but the data vendor provides none for this symbol.')

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(zeroCrossUp, 'Zero Cross Up (Volume Expansion)', 'PVO crossed above zero, volume expanding relative to its recent baseline')
alertcondition(zeroCrossDown, 'Zero Cross Down (Volume Contraction)', 'PVO crossed below zero, volume contracting relative to its recent baseline')
alertcondition(signalCrossUp, 'Signal Cross Up', 'PVO crossed above its signal line, volume momentum turned up')
alertcondition(signalCrossDown, 'Signal Cross Down', 'PVO crossed below its signal line, volume momentum turned down')

//---------------------------------------------------------------------------------------------------------------------}
