//@version=6
indicator("EMA + RSI + VWAP Targets", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────

// EMA
emaLength = input.int(200, "EMA Length", minval=1)

// RSI
rsiLength = input.int(14, "RSI Length", minval=1)
rsiBuyLevel = input.float(50, "RSI Buy Level", minval=0, maxval=100)
rsiSellLevel = input.float(50, "RSI Sell Level", minval=0, maxval=100)

// Targets
target1Percent = input.float(1.0, "Target 1 %", minval=0.1, step=0.1)
target2Percent = input.float(2.0, "Target 2 %", minval=0.1, step=0.1)
target3Percent = input.float(3.0, "Target 3 %", minval=0.1, step=0.1)

// Stop Loss
useStopLoss = input.bool(true, "Show Stop Loss")
stopLossPercent = input.float(1.0, "Stop Loss %", minval=0.1, step=0.1)

// Display
showTargets = input.bool(true, "Show Target Lines")
showVWAP = input.bool(true, "Show VWAP")
showEMA = input.bool(true, "Show EMA")

// ─────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────

ema = ta.ema(close, emaLength)
rsi = ta.rsi(close, rsiLength)
vwap = ta.vwap(hlc3)

// ─────────────────────────────────────────────
// BUY / SELL CONDITIONS
// ─────────────────────────────────────────────

// Trend conditions
bullishTrend = close > ema and close > vwap
bearishTrend = close < ema and close < vwap

// RSI conditions
bullishRSI = rsi > rsiBuyLevel
bearishRSI = rsi < rsiSellLevel

// Final signals
buyCondition = bullishTrend and bullishRSI
sellCondition = bearishTrend and bearishRSI

// Only signal when condition changes from false → true
buySignal = buyCondition and not buyCondition[1]
sellSignal = sellCondition and not sellCondition[1]

// ─────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────

plot(showEMA ? ema : na, "EMA", color=color.orange, linewidth=2)
plot(showVWAP ? vwap : na, "VWAP", color=color.blue, linewidth=2)

// Signal markers
plotshape(
     buySignal,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY",
     textcolor=color.white,
     size=size.small
)

plotshape(
     sellSignal,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.small
)

// ─────────────────────────────────────────────
// TARGET VARIABLES
// ─────────────────────────────────────────────

var float entryPrice = na
var float target1 = na
var float target2 = na
var float target3 = na
var float stopLoss = na
var int tradeDirection = 0

// ─────────────────────────────────────────────
// BUY SETUP
// ─────────────────────────────────────────────

if buySignal
    entryPrice := close
    target1 := entryPrice * (1 + target1Percent / 100)
    target2 := entryPrice * (1 + target2Percent / 100)
    target3 := entryPrice * (1 + target3Percent / 100)
    stopLoss := entryPrice * (1 - stopLossPercent / 100)
    tradeDirection := 1

    label.new(
         bar_index,
         low,
         "BUY\nEntry: " + str.tostring(entryPrice, format.mintick) +
         "\nT1: " + str.tostring(target1, format.mintick) +
         "\nT2: " + str.tostring(target2, format.mintick) +
         "\nT3: " + str.tostring(target3, format.mintick) +
         (useStopLoss ? "\nSL: " + str.tostring(stopLoss, format.mintick) : ""),
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white
    )

// ─────────────────────────────────────────────
// SELL SETUP
// ─────────────────────────────────────────────

if sellSignal
    entryPrice := close
    target1 := entryPrice * (1 - target1Percent / 100)
    target2 := entryPrice * (1 - target2Percent / 100)
    target3 := entryPrice * (1 - target3Percent / 100)
    stopLoss := entryPrice * (1 + stopLossPercent / 100)
    tradeDirection := -1

    label.new(
         bar_index,
         high,
         "SELL\nEntry: " + str.tostring(entryPrice, format.mintick) +
         "\nT1: " + str.tostring(target1, format.mintick) +
         "\nT2: " + str.tostring(target2, format.mintick) +
         "\nT3: " + str.tostring(target3, format.mintick) +
         (useStopLoss ? "\nSL: " + str.tostring(stopLoss, format.mintick) : ""),
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white
    )

// ─────────────────────────────────────────────
// TARGET LINES
// ─────────────────────────────────────────────

plot(
     showTargets and tradeDirection != 0 ? target1 : na,
     "Target 1",
     color=color.lime,
     linewidth=1,
     style=plot.style_linebr
)

plot(
     showTargets and tradeDirection != 0 ? target2 : na,
     "Target 2",
     color=color.green,
     linewidth=1,
     style=plot.style_linebr
)

plot(
     showTargets and tradeDirection != 0 ? target3 : na,
     "Target 3",
     color=color.teal,
     linewidth=2,
     style=plot.style_linebr
)

plot(
     showTargets and useStopLoss and tradeDirection != 0 ? stopLoss : na,
     "Stop Loss",
     color=color.red,
     linewidth=1,
     style=plot.style_linebr
)

// ─────────────────────────────────────────────
// TARGET HIT MARKERS
// ─────────────────────────────────────────────

buyT1Hit = tradeDirection == 1 and not na(target1) and high >= target1
buyT2Hit = tradeDirection == 1 and not na(target2) and high >= target2
buyT3Hit = tradeDirection == 1 and not na(target3) and high >= target3

sellT1Hit = tradeDirection == -1 and not na(target1) and low <= target1
sellT2Hit = tradeDirection == -1 and not na(target2) and low <= target2
sellT3Hit = tradeDirection == -1 and not na(target3) and low <= target3

plotshape(buyT1Hit, title="BUY T1 Hit", style=shape.circle,
     location=location.abovebar, color=color.lime, size=size.tiny, text="T1")

plotshape(buyT2Hit, title="BUY T2 Hit", style=shape.circle,
     location=location.abovebar, color=color.green, size=size.tiny, text="T2")

plotshape(buyT3Hit, title="BUY T3 Hit", style=shape.circle,
     location=location.abovebar, color=color.teal, size=size.tiny, text="T3")

plotshape(sellT1Hit, title="SELL T1 Hit", style=shape.circle,
     location=location.belowbar, color=color.lime, size=size.tiny, text="T1")

plotshape(sellT2Hit, title="SELL T2 Hit", style=shape.circle,
     location=location.belowbar, color=color.green, size=size.tiny, text="T2")

plotshape(sellT3Hit, title="SELL T3 Hit", style=shape.circle,
     location=location.belowbar, color=color.teal, size=size.tiny, text="T3")

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────

alertcondition(
     buySignal,
     title="BUY Signal",
     message="EMA + RSI + VWAP BUY signal"
)

alertcondition(
     sellSignal,
     title="SELL Signal",
     message="EMA + RSI + VWAP SELL signal"
)

