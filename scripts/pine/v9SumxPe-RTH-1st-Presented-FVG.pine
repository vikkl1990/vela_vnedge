indicator(title="RTH 1st Presented FVG", shorttitle="RTH 1st FVG", overlay=true, max_lines_count=500, max_boxes_count=200, max_labels_count=500, dynamic_requests=true)

var string G_GENERAL = "General Settings"
max_tf = input.string("15", "Max Timeframe (minutes)", options=["1", "3", "5", "15", "30", "60", "120", "240", "D"], group=G_GENERAL)
use_chart_tf = input.bool(false, "Use Chart Timeframe for 1st Presented", group=G_GENERAL, tooltip="Off (default): use 1-minute bars when the chart is higher than 1m. On a 1-minute chart, native 1m bars are always used so Market Replay can see older days. On: detect on the chart's own timeframe.")
rth_session = input.session("0930-1615", "RTH Session", group=G_GENERAL)
tz = input.string("America/New_York", "Timezone", group=G_GENERAL)

get_tf_minutes(string tf) =>
    switch tf
        "1" => 1
        "3" => 3
        "5" => 5
        "15" => 15
        "30" => 30
        "60" => 60
        "120" => 120
        "240" => 240
        "D" => 1440
        => 0

show_indicator = timeframe.in_seconds() / 60 <= get_tf_minutes(max_tf)

var string G_FVG = "FVG Settings"
show_fvg = input.bool(true, "Show 1st Presented RTH FVG", group=G_FVG)
minFvgSize = input.int(5, "Min FVG Size (Ticks)", minval=0, group=G_FVG)
boxesToShow = input.int(5, "Historical FVGs to show", minval=0, maxval=50, group=G_FVG, tooltip="One history window for every FVG type (standard, displacement, reflection). 0 hides rolling history including today. Prior-week Mon/Fri and Current Week Days are independent of this count.")
col_FVG_bull = input.color(color.new(#2962ff, 95), "Bull box", inline="C", group=G_FVG)
col_FVG_bear = input.color(color.new(#2962ff, 95), "Bear box", inline="C", group=G_FVG)
show_midline = input.bool(true, "Show midline", inline="M", group=G_FVG)
col_FVG_mid = input.color(color.new(color.blue, 0), "", inline="M", group=G_FVG)
midline_style = input.string("Dashed", "Mid style", options=["Solid", "Dashed", "Dotted"], inline="M", group=G_FVG)
show_edges = input.bool(true, "Show high/low lines", inline="E", group=G_FVG)
edgeCol = input.color(color.new(color.blue, 10), "", inline="E", group=G_FVG)
edgeStyle = input.string(line.style_solid, "| style:", options=[line.style_solid, line.style_dotted, line.style_dashed], inline="E", group=G_FVG)
edgeWidth = input.int(1, "| width", minval=1, maxval=4, inline="E", group=G_FVG)
showQuart = input.bool(false, "Show quartile lines", inline="Q", group=G_FVG)
quartCol = input.color(color.new(color.blue, 50), "", inline="Q", group=G_FVG)
quartStyle = input.string(line.style_dotted, "| style:", options=[line.style_solid, line.style_dotted, line.style_dashed], inline="Q", group=G_FVG)
quartWidth = input.int(1, "| width", minval=1, maxval=4, inline="Q", group=G_FVG)
showEighth = input.bool(false, "Show 1/8th lines", inline="8", group=G_FVG)
eighthCol = input.color(color.new(color.blue, 70), "", inline="8", group=G_FVG)
eighthStyle = input.string(line.style_dotted, "| style:", options=[line.style_solid, line.style_dotted, line.style_dashed], inline="8", group=G_FVG)
eighthWidth = input.int(1, "| width", minval=1, maxval=4, inline="8", group=G_FVG)
extendBoxRight = input.bool(true, "Extend boxes & lines right", inline="X", group=G_FVG)
bufferBars = input.int(5, "| buffer bars", minval=0, inline="X", group=G_FVG)
showTxt = input.bool(false, "Box text", inline="T", group=G_FVG)
boxTxtCol = input.color(color.new(color.gray, 100), "", inline="T", group=G_FVG)
showSpecialMF = input.bool(false, "Show Monday and Friday FVGs", inline="MF", group=G_FVG, tooltip="ICT: plot Mondays and Fridays from the last N completed weeks BEFORE the week you are trading. Default 2 = two prior weeks' Mon+Fri. Does not include the current week.")
specialMFCount = input.int(2, "Prior weeks", minval=1, maxval=20, inline="MF", group=G_FVG, tooltip="Completed NY calendar weeks immediately before the cursor's week. Trading week of Sep 8 with Weeks=2 shows Mon/Fri of the Aug 25 and Sep 1 weeks — not this week's Mon/Fri.")
excludeCurrentDaySpecial = input.bool(false, "Don't include current day in Mon/Fri calc", group=G_FVG, tooltip="Rarely needed now that prior weeks exclude the current week. If a prior-week Monday/Friday is still the live session (replay), skip it until 16:15 NY.")
includeHolidayWeeks = input.bool(true, "Force holiday RTH (clock 09:30–16:15 NY)", group=G_FVG, tooltip="On holidays TradingView often treats RTH as closed even when futures still print after 09:30 NY. On: treat 09:30–16:15 NY clock as RTH so those 1st Presented FVGs are detected. Mon/Fri lookback still uses only PRIOR completed weeks from the replay cursor — the week you are in is never included.")
var string G_WEEKDAYS = "Current Week Days"
showCurMon = input.bool(false, "Monday", inline="CW1", group=G_WEEKDAYS, tooltip="Plot this week's Monday 1st FVG (standard, displacement, reflection). Separate from prior-weeks Mon/Fri.")
showCurTue = input.bool(false, "Tuesday", inline="CW1", group=G_WEEKDAYS)
showCurWed = input.bool(false, "Wednesday", inline="CW1", group=G_WEEKDAYS)
showCurThu = input.bool(false, "Thursday", inline="CW2", group=G_WEEKDAYS)
showCurFri = input.bool(false, "Friday", inline="CW2", group=G_WEEKDAYS, tooltip="This week's Friday only unless Isolation mode is on.")
isolateWeekdays = input.bool(false, "Isolation mode", inline="ISO", group=G_WEEKDAYS, tooltip="On: plot the last N weeks of each checked weekday (e.g. last 4 Wednesdays). Off: only this calendar week.")
isolateWeeks = input.int(2, "Isolation weeks", minval=1, maxval=20, inline="ISO", group=G_WEEKDAYS, tooltip="NY weeks of each checked weekday, including this week. Only 1-minute first FVGs are plotted. Dates before your 1m history (subscription limit) cannot be reconstructed.")
excludeCurrentDayWeekday = input.bool(false, "Don't include current session until RTH close", group=G_WEEKDAYS, tooltip="If checked, today's selected weekday is hidden until 16:15 NY so Market Replay matches a completed session.")

var string G_DISP = "1st FVG with Displacement"
show_disp_fvg = input.bool(true, "Show 1st Presented FVG w/ Displacement", group=G_DISP, tooltip="Separate from the standard 1st FVG. Plots the first RTH FVG whose 3-candle move displaces above a recent swing high (bull) or below a recent swing low (bear).")
onlyFirstDispPerSession = input.bool(true, "Only first Displacement FVG per session", group=G_DISP, tooltip="On (default): one displacement FVG per RTH session. Off: later displacing FVGs can also plot.")
noDispAfterRefl = input.bool(true, "No Displacement FVGs after Reflection", group=G_DISP, tooltip="On (default): once the 1st Reflection FVG is set, do not plot any further displacement gaps.")
swingLookback = input.int(8, "Swing lookback (bars)", minval=3, maxval=50, group=G_DISP, tooltip="How far back a swing may sit. Any 3-bar swing in that window qualifies — it does not need to be a major swing.")
requireCloseBeyond = input.bool(true, "Require close beyond swing", group=G_DISP, tooltip="On: the 2nd (middle) candle of the FVG must CLOSE through the nearest swing still in front of the move. Candle 1 or 3 closing through it is not enough. Off: the 2nd candle wick through the swing is enough.")
minDispBodyTicks = input.int(40, "Min displacement body (ticks)", minval=0, group=G_DISP, tooltip="0 = off. Optional energy filter on the middle (displacement) candle body.")
col_DISP_bull = input.color(color.new(#00c853, 88), "Disp bull box", inline="DC", group=G_DISP)
col_DISP_bear = input.color(color.new(#ff1744, 88), "Disp bear box", inline="DC", group=G_DISP)
show_disp_mid = input.bool(true, "Disp midline", inline="DM", group=G_DISP)
col_DISP_mid = input.color(color.new(#00c853, 0), "", inline="DM", group=G_DISP)
show_disp_edges = input.bool(true, "Disp high/low lines", inline="DE", group=G_DISP)
dispEdgeCol = input.color(color.new(#00c853, 10), "", inline="DE", group=G_DISP)
show_disp_labels = input.bool(true, "Disp labels", group=G_DISP)

var string G_REFL = "1st Presented Reflection FVG"
show_refl_fvg = input.bool(true, "Show 1st Presented Reflection FVG", group=G_REFL, tooltip="First opposite-side FVG after the 1st displacement FVG (BISI↔SIBI). If no displacement FVG exists, uses the regular 1st Presented FVG as the reference.")
col_REFL_bull = input.color(color.new(#00c853, 88), "Refl bull box (BISI)", inline="RC", group=G_REFL)
col_REFL_bear = input.color(color.new(#ff1744, 88), "Refl bear box (SIBI)", inline="RC", group=G_REFL)
show_refl_mid = input.bool(true, "Refl midline", inline="RM", group=G_REFL)
col_REFL_mid = input.color(color.new(#00c853, 0), "", inline="RM", group=G_REFL)
show_refl_edges = input.bool(true, "Refl high/low lines", inline="RE", group=G_REFL)
reflEdgeCol = input.color(color.new(#00c853, 10), "", inline="RE", group=G_REFL)
show_refl_labels = input.bool(true, "Refl labels", group=G_REFL)
onlyShowDispRefl = input.bool(false, "Only Show Displacement & Reflection FVGs", group=G_REFL, tooltip="Hides the standard 1st Presented FVG, Mon/Fri 1st FVGs, overlapping FVGs. Displacement and Reflection boxes still plot. PD table stays and uses visible gaps.")
showStdIfNoDisp = input.bool(true, "Show 1st Presented FVG if no Displacement", group=G_REFL, tooltip="Used with Only Show Displacement & Reflection. If the session has no displacement FVG, the regular 1st Presented FVG is shown. It is removed if a displacement FVG appears later.")

var string G_DAY = "Day Specific Features"
useDayColors = input.bool(false, "Use Day-Specific Colors", group=G_DAY)
monColor = input.color(color.blue, "Monday Color", group=G_DAY)
tueColor = input.color(color.orange, "Tuesday Color", group=G_DAY)
wedColor = input.color(color.red, "Wednesday Color", group=G_DAY)
thuColor = input.color(color.green, "Thursday Color", group=G_DAY)
friColor = input.color(color.purple, "Friday Color", group=G_DAY)

var string G_LABELS = "Label Settings"
showLabels = input.bool(true, "Show Labels", group=G_LABELS)
showDayInLabel = input.bool(true, "Show Abbreviated Day in Labels", group=G_LABELS)
useDayColorsForLabels = input.bool(false, "Use Day-Specific Colors for Labels", group=G_LABELS)
labelColor = input.color(color.black, "Label Color", group=G_LABELS)
labelSizeIn = input.string("Tiny", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=G_LABELS)

var string G_OV = "Overlapping FVGs"
show_ov_fvg = input.bool(false, "Show FVGs Overlapping 1st FVG Gradients", group=G_OV)
ov_visible_only = input.bool(true, "Only visible 1st / Disp / Refl FVGs", group=G_OV, tooltip="On: overlapping FVGs must touch a plotted 1st Presented, Displacement, or Reflection FVG. Off: any stored 1st/disp/refl gradient can trigger an overlap.")
ov_first_only = input.bool(false, "First Overlapping FVG Only", group=G_OV, tooltip="On: each visible 1st Presented FVG gets only the first later FVG that overlaps its gradients. A later 1st P.FVG can still get its own first overlap. Off: every overlapping FVG plots.")
ov_macros_only = input.bool(false, "Only during macros", group=G_OV, tooltip="On: plot overlapping FVGs only if the gap forms in a macro window: any hour xx:50–xx:10 NY, plus 15:15–15:45 NY.")
ov_min = input.int(2, "Min FVG Size (Ticks)", minval=0, group=G_OV)
ov_bull = input.color(color.new(#673ab7, 85), "Bull", inline="OV", group=G_OV)
ov_bear = input.color(color.new(#673ab7, 85), "Bear", inline="OV", group=G_OV)
ov_ext = input.int(20, "Box Right Extension (bars)", minval=0, maxval=200, group=G_OV)
ov_mid = input.bool(true, "Mid Line", inline="OVM", group=G_OV)
ov_mid_col = input.color(color.new(color.black, 0), "", inline="OVM", group=G_OV)
ov_mid_style = input.string("Dotted", "Mid style", options=["Solid", "Dashed", "Dotted"], inline="OVM", group=G_OV)
onlyShowOvFVG = input.bool(false, "Only Show Overlapping FVGs", group=G_OV)

var string G_PD = "Premium/Discount"
showPDTable = input.bool(true, "Show Premium/Discount Table", group=G_PD)
useHistoricalCount = input.bool(true, "Use Historical Days for PD", group=G_PD, tooltip="On: PD high/low uses the same session-day count as Historical FVGs to show. Off: PD uses Number of session days for PD below. Neither setting hides or shows FVG boxes.")
pdGaps = input.int(5, "Number of session days for PD", minval=1, group=G_PD, tooltip="Session days used only for Premium/Discount high/low. Does not control which FVG boxes plot.")
pdDisplayMode = input.string("Both", "PD Display Mode", options=["Status", "Percentage", "Both"], group=G_PD)
showPDGradients = input.bool(false, "Show PD Gradient Levels", group=G_PD)
pdEighthCol = input.color(color.new(color.black, 10), "", group=G_PD)
pdEighthStyle = input.string(line.style_solid, "| style:", options=[line.style_solid, line.style_dotted, line.style_dashed], group=G_PD)
pdEighthWidth = input.int(1, "| width", minval=1, maxval=4, group=G_PD)
showPDEighthLabels = input.bool(true, "Show PD Labels", group=G_PD)
onlyShowPD = input.bool(false, "Only Show PD Gradients & Table", group=G_PD)
pdTableSize = input.string("Small", "PD Table Size", options=["Tiny", "Small", "Normal", "Large"], group=G_PD)
pdTablePosition = input.string("Bottom Right", "PD Table Position", options=["Bottom Right", "Top Right", "Bottom Left", "Bottom Center", "Top Left", "Top Center"], group=G_PD)

getLabelSize(size) =>
    size == "Tiny" ? size.tiny : size == "Small" ? size.small : size == "Large" ? size.large : size.normal

getTablePosition(pos) =>
    pos == "Bottom Right" ? position.bottom_right : pos == "Top Right" ? position.top_right : pos == "Bottom Left" ? position.bottom_left : pos == "Bottom Center" ? position.bottom_center : pos == "Top Left" ? position.top_left : position.top_center

formatDateFromTime(int t) =>
    mon = month(t, tz)
    d = dayofmonth(t, tz)
    str.format("{0}/{1}", mon < 10 ? "0" + str.tostring(mon) : str.tostring(mon), d < 10 ? "0" + str.tostring(d) : str.tostring(d))

nyNoon(int t) =>
    timestamp(tz, year(t, tz), month(t, tz), dayofmonth(t, tz), 12, 0, 0)

nyDow(int t) =>
    dayofweek(t, tz)

isNyMonday(int t) =>
    nyDow(t) == dayofweek.monday

isNyFriday(int t) =>
    nyDow(t) == dayofweek.friday

isNyMonFri(int t) =>
    isNyMonday(t) or isNyFriday(t)

ny_ymd(int t) =>
    year(t, tz) * 10000 + month(t, tz) * 100 + dayofmonth(t, tz)

session_still_open(int orgT, int cursorT) =>
    ny_ymd(orgT) == ny_ymd(cursorT) and cursorT < timestamp(tz, year(cursorT, tz), month(cursorT, tz), dayofmonth(cursorT, tz), 16, 15, 0)

dayColorOf(int t) =>
    int dow = nyDow(t)
    switch dow
        dayofweek.monday => monColor
        dayofweek.tuesday => tueColor
        dayofweek.wednesday => wedColor
        dayofweek.thursday => thuColor
        dayofweek.friday => friColor
        => color.gray

dayStrOf(int t) =>
    int dow = nyDow(t)
    switch dow
        dayofweek.monday => "Mon"
        dayofweek.tuesday => "Tue"
        dayofweek.wednesday => "Wed"
        dayofweek.thursday => "Thu"
        dayofweek.friday => "Fri"
        => ""

midStyle() =>
    midline_style == "Dashed" ? line.style_dashed : midline_style == "Dotted" ? line.style_dotted : line.style_solid

barTime = timeframe.in_seconds(timeframe.period) * 1000
extended_time = time + bufferBars * barTime
showOrgVisuals = not onlyShowPD and not onlyShowOvFVG and not onlyShowDispRefl
showDispReflVisuals = not onlyShowPD and not onlyShowOvFVG
showStdFvgVisuals = showOrgVisuals and boxesToShow > 0
useNativeBars = use_chart_tf or timeframe.in_seconds() == 60

clockInRth(int t) =>
    int m = hour(t, tz) * 60 + minute(t, tz)
    m >= 9 * 60 + 30 and m < 16 * 60 + 15

inMacroWindow(int t) =>
    int mins = hour(t, tz) * 60 + minute(t, tz)
    int mm = minute(t, tz)
    bool crossHour = mm >= 50 or mm <= 10
    bool lateDay = mins >= 15 * 60 + 15 and mins <= 15 * 60 + 45
    crossHour or lateDay

bool sessRth = not na(time(timeframe.period, rth_session, tz))
inRTH = sessRth or (includeHolidayWeeks and clockInRth(time))
rthStart = inRTH and not inRTH[1]

detectFvg() =>
    float minGap = minFvgSize * syminfo.mintick
    bool bullGap = low > high[2] and (low - high[2]) >= minGap
    bool bearGap = high < low[2] and (low[2] - high) >= minGap
    float fvgTop = na
    float fvgBot = na
    bool isBull = false
    if bullGap
        fvgTop := low
        fvgBot := high[2]
        if math.max(close[2], open[2]) < math.min(close[1], open[1])
            fvgBot := math.max(close[2], open[2])
        if math.max(close[1], open[1]) < math.min(close, open)
            fvgTop := math.min(close, open)
        isBull := true
    else if bearGap
        fvgTop := low[2]
        fvgBot := high
        if math.min(close[2], open[2]) > math.max(close[1], open[1])
            fvgTop := math.min(close[2], open[2])
        if math.min(close[1], open[1]) > math.max(close, open)
            fvgBot := math.max(close, open)
        isBull := false
    [bullGap or bearGap, isBull, fvgTop, fvgBot]

[boolFVG, isBullFVG, fTop, fBot] = detectFvg()

inRthTs(int t) =>
    clockInRth(t)

fvgFrom(float h0, float l0, float o0, float c0, float h1, float l1, float o1, float c1, float h2, float l2, float o2, float c2) =>
    float minGap = minFvgSize * syminfo.mintick
    bool bullGap = l0 > h2 and (l0 - h2) >= minGap
    bool bearGap = h0 < l2 and (l2 - h0) >= minGap
    float fvgTop = na
    float fvgBot = na
    bool isBull = false
    if bullGap
        fvgTop := l0
        fvgBot := h2
        if math.max(c2, o2) < math.min(c1, o1)
            fvgBot := math.max(c2, o2)
        if math.max(c1, o1) < math.min(c0, o0)
            fvgTop := math.min(c0, o0)
        isBull := true
    else if bearGap
        fvgTop := l2
        fvgBot := h0
        if math.min(c2, o2) > math.max(c1, o1)
            fvgTop := math.min(c2, o2)
        if math.min(c1, o1) > math.max(c0, o0)
            fvgBot := math.max(c0, o0)
        isBull := false
    [bullGap or bearGap, isBull, fvgTop, fvgBot]

// Displacement: take out the nearest swing still in front of the 3-candle FVG run.
// requireCloseBeyond: a candle in the run must CLOSE through that swing (wick-only fails).
priorExtreme(float[] arr, bool wantMax) =>
    float out = float(na)
    int n = arr.size()
    if n > 2
        int fromIdx = math.max(0, n - 2 - swingLookback)
        int endIdx = n - 3
        if endIdx >= fromIdx
            out := arr.get(fromIdx)
            if endIdx > fromIdx
                for i = fromIdx + 1 to endIdx
                    out := wantMax ? math.max(out, arr.get(i)) : math.min(out, arr.get(i))
    out

hasDispOC(bool isBull, float midOpen, float midClose, float midHigh, float midLow, float priorHigh, float priorLow) =>
    float minBody = minDispBodyTicks * syminfo.mintick
    bool energyOk = minDispBodyTicks == 0 or math.abs(midClose - midOpen) >= minBody
    bool ok = false
    if energyOk and not na(priorHigh) and not na(priorLow)
        if isBull
            ok := requireCloseBeyond ? midClose > priorHigh : midHigh > priorHigh
        else
            ok := requireCloseBeyond ? midClose < priorLow : midLow < priorLow
    ok

pushSwingWindow(float[] arr, float v, int maxN) =>
    arr.push(v)
    while arr.size() > maxN
        arr.shift()

var bool waiting = true
var bool found1mDay = false
var int found1mDate = int(na)
var float pH1 = float(na)
var float pL1 = float(na)
var float pO1 = float(na)
var float pC1 = float(na)
var float pH2 = float(na)
var float pL2 = float(na)
var float pO2 = float(na)
var float pC2 = float(na)
var int pT1 = int(na)
var int pT2 = int(na)
var bool hit1m = false
var bool bull1m = false
var float top1m = float(na)
var float bot1m = float(na)
var int t1m = int(na)

// 1m displacement state (independent of standard 1st FVG)
var bool found1mDispDay = false
var int found1mDispDate = int(na)
var bool hit1mDisp = false
var bool bull1mDisp = false
var float top1mDisp = float(na)
var float bot1mDisp = float(na)
var int t1mDisp = int(na)
var float[] swHi1m = array.new_float()
var float[] swLo1m = array.new_float()
var float[] winH1m = array.new_float()
var float[] winL1m = array.new_float()
var float ppH = float(na)
var float ppL = float(na)
var float pppH = float(na)
var float pppL = float(na)

// 1m reflection state
var bool found1mReflDay = false
var int found1mReflDate = int(na)
var bool hit1mRefl = false
var bool bull1mRefl = false
var float top1mRefl = float(na)
var float bot1mRefl = float(na)
var int t1mRefl = int(na)
var bool have1mRef = false
var bool ref1mBull = false
var int ref1mT = int(na)
var bool ref1mIsDisp = false

if rthStart
    waiting := true

hit1m := false
hit1mDisp := false
hit1mRefl := false
bool ov1mHit = false
bool ov1mBull = false
float ov1mTop = float(na)
float ov1mBot = float(na)
int ov1mT = int(na)
if not useNativeBars and show_indicator
    [hs, ls, os, cs, ts] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, open, close, time])
    if not na(ts) and ts.size() > 0
        int d0 = year(ts.get(ts.size() - 1), tz) * 10000 + month(ts.get(ts.size() - 1), tz) * 100 + dayofmonth(ts.get(ts.size() - 1), tz)
        if na(found1mDate) or found1mDate != d0
            found1mDate := d0
            found1mDay := false
            pH1 := na
            pL1 := na
            pO1 := na
            pC1 := na
            pH2 := na
            pL2 := na
            pO2 := na
            pC2 := na
            pT1 := int(na)
            pT2 := int(na)
        if na(found1mDispDate) or found1mDispDate != d0
            found1mDispDate := d0
            found1mDispDay := false
            swHi1m.clear()
            swLo1m.clear()
            winH1m.clear()
            winL1m.clear()
            ppH := na
            ppL := na
            pppH := na
            pppL := na
        if na(found1mReflDate) or found1mReflDate != d0
            found1mReflDate := d0
            found1mReflDay := false
            have1mRef := false
            ref1mIsDisp := false
            ref1mT := int(na)
        if hs.size() > 0
            for i = 0 to hs.size() - 1
                float h0 = hs.get(i)
                float l0 = ls.get(i)
                float o0 = os.get(i)
                float c0 = cs.get(i)
                int t0 = ts.get(i)
                bool midOk = not na(pT1) and (hour(pT1, tz) * 60 + minute(pT1, tz)) >= 9 * 60 + 31
                if not na(pH1) and not na(pH2) and inRthTs(t0) and midOk
                    [ok, isB, tp, bt] = fvgFrom(h0, l0, o0, c0, pH1, pL1, pO1, pC1, pH2, pL2, pO2, pC2)
                    if ok
                        bool hadFirstAlready = found1mDay
                        if hadFirstAlready and (show_ov_fvg or onlyShowOvFVG) and not onlyShowPD
                            ov1mHit := true
                            ov1mBull := isB
                            ov1mTop := math.max(tp, bt)
                            ov1mBot := math.min(tp, bt)
                            ov1mT := pT2
                        if not found1mDay
                            found1mDay := true
                            hit1m := true
                            bull1m := isB
                            top1m := tp
                            bot1m := bt
                            t1m := pT2
                            if not have1mRef
                                have1mRef := true
                                ref1mBull := isB
                                ref1mT := pT2
                                ref1mIsDisp := false
                        bool allowMoreDisp = not onlyFirstDispPerSession or not found1mDispDay
                        bool blockAfterRefl = noDispAfterRefl and found1mReflDay
                        float ph1m = priorExtreme(winH1m, true)
                        float pl1m = priorExtreme(winL1m, false)
                        if allowMoreDisp and not blockAfterRefl and hasDispOC(isB, pO1, pC1, pH1, pL1, ph1m, pl1m)
                            found1mDispDay := true
                            hit1mDisp := true
                            bull1mDisp := isB
                            top1mDisp := tp
                            bot1mDisp := bt
                            t1mDisp := pT2
                            have1mRef := true
                            ref1mBull := isB
                            ref1mT := pT2
                            ref1mIsDisp := true
                            found1mReflDay := false
                            hit1mRefl := false
                        if show_refl_fvg and have1mRef and not found1mReflDay and isB != ref1mBull and not na(pT2) and pT2 > ref1mT
                            found1mReflDay := true
                            hit1mRefl := true
                            bull1mRefl := isB
                            top1mRefl := tp
                            bot1mRefl := bt
                            t1mRefl := pT2
                // Confirm swings after the FVG test so the pattern cannot use its own mid-bar as the swing it "takes out".
                if not na(ppH) and not na(pppH) and inRthTs(t0)
                    if ppH > pppH and ppH > h0
                        pushSwingWindow(swHi1m, ppH, swingLookback)
                    if ppL < pppL and ppL < l0
                        pushSwingWindow(swLo1m, ppL, swingLookback)
                pppH := ppH
                pppL := ppL
                ppH := h0
                ppL := l0
                pH2 := pH1
                pL2 := pL1
                pO2 := pO1
                pC2 := pC1
                pT2 := pT1
                pH1 := h0
                pL1 := l0
                pO1 := o0
                pC1 := c0
                pT1 := t0
                winH1m.push(h0)
                winL1m.push(l0)
                while winH1m.size() > swingLookback + 8
                    winH1m.shift()
                    winL1m.shift()

var box[] boxArr = array.new_box()
