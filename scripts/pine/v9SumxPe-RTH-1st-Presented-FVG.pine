pushMf(MfFvg[] arr, int t, float top, float bot, bool bull) =>
    MfFvg rec = MfFvg.new()
    rec.t := t
    rec.top := top
    rec.bot := bot
    rec.bull := bull
    arr.push(rec)
    while arr.size() > math.max(specialMFCount * 2 + 6, 12)
        arr.shift()

pushRoll(MfFvg[] arr, int t, float top, float bot, bool bull) =>
    MfFvg rec = MfFvg.new()
    rec.t := t
    rec.top := top
    rec.bot := bot
    rec.bull := bull
    arr.push(rec)
    while arr.size() > math.max(80, isolateWeeks * 12, specialMFCount * 12)
        arr.shift()

ymdIn(int[] ys, int y) =>
    bool hit = false
    if ys.size() > 0
        for i = 0 to ys.size() - 1
            if ys.get(i) == y
                hit := true
    hit

lastYmds(MfFvg[] src, int cursorT, int n) =>
    int[] ys = array.new_int()
    if src.size() > 0 and n > 0
        int cap = ny_ymd(cursorT)
        for i = src.size() - 1 to 0
            int y = ny_ymd(src.get(i).t)
            if y <= cap and not ymdIn(ys, y)
                ys.unshift(y)
                if ys.size() >= n
                    break
    ys

collectYmds(MfFvg[] src, int cap, int[] ys) =>
    if src.size() > 0
        for i = 0 to src.size() - 1
            int y = ny_ymd(src.get(i).t)
            if y <= cap and not ymdIn(ys, y)
                ys.push(y)

lastSessionDays(MfFvg[] a, MfFvg[] b, MfFvg[] c, int cursorT, int n) =>
    int[] ys = array.new_int()
    int cap = ny_ymd(cursorT)
    collectYmds(a, cap, ys)
    collectYmds(b, cap, ys)
    collectYmds(c, cap, ys)
    if ys.size() > 1
        ys.sort()
    while n >= 0 and ys.size() > n
        ys.shift()
    ys

dayHasType(MfFvg[] src, int y) =>
    bool hit = false
    if src.size() > 0
        for i = 0 to src.size() - 1
            if ny_ymd(src.get(i).t) == y
                hit := true
    hit

mergeYmds(int[] a, int[] b) =>
    int[] out = array.new_int()
    if a.size() > 0
        for i = 0 to a.size() - 1
            int y = a.get(i)
            if not ymdIn(out, y)
                out.push(y)
    if b.size() > 0
        for i = 0 to b.size() - 1
            int y = b.get(i)
            if not ymdIn(out, y)
                out.push(y)
    out

scanRollOv(int ft, float loF, float hiF, MfFvg[] arr) =>
    bool hit = false
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            MfFvg o = arr.get(i)
            if o.t < ft
                float mid = (o.top + o.bot) / 2.0
                float rng = o.top - o.bot
                bool lvlIn = (o.top >= loF and o.top <= hiF) or (o.bot >= loF and o.bot <= hiF) or (mid >= loF and mid <= hiF) or (o.bot + 0.25 * rng >= loF and o.bot + 0.25 * rng <= hiF) or (o.bot + 0.75 * rng >= loF and o.bot + 0.75 * rng <= hiF)
                bool rngOv = o.top >= loF and o.bot <= hiF
                if lvlIn or rngOv
                    hit := true
                    break
    hit

nyMidnight(int t) =>
    timestamp(tz, year(t, tz), month(t, tz), dayofmonth(t, tz), 0, 0, 0)

// DST-safe Monday 00:00 NY of the week containing t.
nyWeekStart(int t) =>
    int t0 = nyMidnight(t)
    int dow = nyDow(t)
    int daysFromMon = dow == dayofweek.sunday ? 6 : dow - dayofweek.monday
    if daysFromMon > 0
        for i = 1 to daysFromMon
            t0 := nyMidnight(t0 - 12 * 3600 * 1000)
    t0

nyWeekId(int t) =>
    // Days from a fixed Monday epoch, divided by 7. Rounded so DST hour slips do not collapse two weeks.
    int diffDays = int(math.round((nyWeekStart(t) - timestamp(tz, 1970, 1, 5, 0, 0, 0)) / 86400000.0))
    int(math.floor(diffDays / 7.0))

weeksBeforeCursor(int gapT, int cursorT) =>
    int diffDays = int(math.round((nyWeekStart(cursorT) - nyWeekStart(gapT)) / 86400000.0))
    int(math.round(diffDays / 7.0))

weekStartBack(int t, int nWeeks) =>
    int t0 = nyWeekStart(t)
    if nWeeks > 0
        for w = 1 to nWeeks
            for d = 1 to 7
                t0 := nyMidnight(t0 - 12 * 3600 * 1000)
    t0

weekStartForward(int t, int nWeeks) =>
    int t0 = nyWeekStart(t)
    if nWeeks > 0
        for w = 1 to nWeeks
            t0 := nyMidnight(t0 + 7 * 86400000 + 12 * 3600 * 1000)
    t0

// Week is complete after Friday 16:15 NY (or any Saturday/Sunday). Then you are "on" next week.
rthWeekClosed(int t) =>
    int dow = nyDow(t)
    int rthEnd = timestamp(tz, year(t, tz), month(t, tz), dayofmonth(t, tz), 16, 15, 0)
    int ref = (barstate.islast and ny_ymd(t) == ny_ymd(time)) ? time_close : t
    dow == dayofweek.saturday or dow == dayofweek.sunday or (dow == dayofweek.friday and ref >= rthEnd)

// Monday of the week you are trading on. After Friday close, that is NEXT Monday.
tradingWeekStart(int cursorT) =>
    rthWeekClosed(cursorT) ? weekStartForward(cursorT, 1) : nyWeekStart(cursorT)

// ICT: last N weeks previous to the week you are trading on.
// After Friday close (Sat morning), the week that just closed is week 1 of that lookback.
inMfWeekWindow(int gapT, int cursorT) =>
    int curWs = tradingWeekStart(cursorT)
    int gapWs = nyWeekStart(gapT)
    int oldest = weekStartBack(curWs, specialMFCount)
    gapWs < curWs and gapWs >= oldest

sameNyWeek(int a, int b) =>
    nyWeekId(a) == nyWeekId(b)

wantCurrentWeekday(int t) =>
    int dow = nyDow(t)
    dow == dayofweek.monday ? showCurMon : dow == dayofweek.tuesday ? showCurTue : dow == dayofweek.wednesday ? showCurWed : dow == dayofweek.thursday ? showCurThu : dow == dayofweek.friday ? showCurFri : false

filterMf(MfFvg[] src, int cursorT) =>
    MfFvg[] out = array.new<MfFvg>()
    if src.size() > 0
        for i = 0 to src.size() - 1
            MfFvg o = src.get(i)
            bool skipCur = excludeCurrentDaySpecial and session_still_open(o.t, cursorT)
            if not skipCur and inMfWeekWindow(o.t, cursorT) and isNyMonFri(o.t)
                out.push(o)
    out

inIsolateWeekWindow(int gapT, int cursorT) =>
    int d = weeksBeforeCursor(gapT, cursorT)
    d >= 0 and d < isolateWeeks

filterCurWeek(MfFvg[] src, int cursorT) =>
    MfFvg[] out = array.new<MfFvg>()
    bool anyDay = showCurMon or showCurTue or showCurWed or showCurThu or showCurFri
    if anyDay and src.size() > 0
        for i = 0 to src.size() - 1
            MfFvg o = src.get(i)
            bool skipCur = excludeCurrentDayWeekday and session_still_open(o.t, cursorT)
            bool weekOk = isolateWeekdays ? inIsolateWeekWindow(o.t, cursorT) : sameNyWeek(o.t, cursorT)
            if not skipCur and weekOk and wantCurrentWeekday(o.t)
                out.push(o)
    out

shownStdFirst(MfFvg o, int cursorT) =>
    int y = ny_ymd(o.t)
    bool tooNew = y > ny_ymd(cursorT)
    bool byIso = false
    bool byMf = false
    bool byHist = false
    if not tooNew
        bool anyDay = showCurMon or showCurTue or showCurWed or showCurThu or showCurFri
        bool weekOk = isolateWeekdays ? inIsolateWeekWindow(o.t, cursorT) : sameNyWeek(o.t, cursorT)
        byIso := anyDay and wantCurrentWeekday(o.t) and weekOk
        byMf := showSpecialMF and isNyMonFri(o.t) and inMfWeekWindow(o.t, cursorT)
        if boxesToShow > 0
            int[] ys = lastSessionDays(rollStdAll, rollDispAll, rollReflAll, cursorT, boxesToShow)
            bool hideDup = showSpecialMF and isNyMonFri(o.t) and (sameNyWeek(o.t, cursorT) or inMfWeekWindow(o.t, cursorT))
            byHist := ymdIn(ys, y) and not hideDup
    byIso or byMf or byHist

sameTInRoll(MfFvg[] arr, int t) =>
    bool hit = false
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if arr.get(i).t == t
                hit := true
    hit

shownDispFirst(MfFvg o, int cursorT) =>
    show_disp_fvg and not sameTInRoll(rollStdAll, o.t) and shownStdFirst(o, cursorT)

shownReflFirst(MfFvg o, int cursorT) =>
    show_refl_fvg and shownStdFirst(o, cursorT)

scanVisibleStdOv(int ft, float loF, float hiF, int cursorT) =>
    bool hit = false
    if rollStdAll.size() > 0
        for i = 0 to rollStdAll.size() - 1
            MfFvg o = rollStdAll.get(i)
            if o.t < ft and shownStdFirst(o, cursorT)
                float mid = (o.top + o.bot) / 2.0
                float rng = o.top - o.bot
                bool lvlIn = (o.top >= loF and o.top <= hiF) or (o.bot >= loF and o.bot <= hiF) or (mid >= loF and mid <= hiF) or (o.bot + 0.25 * rng >= loF and o.bot + 0.25 * rng <= hiF) or (o.bot + 0.75 * rng >= loF and o.bot + 0.75 * rng <= hiF) or (o.bot + 0.125 * rng >= loF and o.bot + 0.125 * rng <= hiF) or (o.bot + 0.375 * rng >= loF and o.bot + 0.375 * rng <= hiF) or (o.bot + 0.625 * rng >= loF and o.bot + 0.625 * rng <= hiF) or (o.bot + 0.875 * rng >= loF and o.bot + 0.875 * rng <= hiF)
                bool rngOv = o.top >= loF and o.bot <= hiF
                if lvlIn or rngOv
                    hit := true
                    break
    hit

fvgTouchesHist(int ft, float loF, float hiF) =>
    bool hit = false
    float minOv = ov_min * syminfo.mintick
    if (hiF - loF) >= minOv
        if ov_visible_only
            hit := scanVisibleStdOv(ft, loF, hiF, time)
        else
            if histLv.size() > 0
                for lv in histLv
                    if lv.t < ft
                        bool lvlIn = (lv.hi >= loF and lv.hi <= hiF) or (lv.lo >= loF and lv.lo <= hiF) or (lv.mid >= loF and lv.mid <= hiF) or (lv.q25 >= loF and lv.q25 <= hiF) or (lv.q75 >= loF and lv.q75 <= hiF) or (lv.e125 >= loF and lv.e125 <= hiF) or (lv.e375 >= loF and lv.e375 <= hiF) or (lv.e625 >= loF and lv.e625 <= hiF) or (lv.e875 >= loF and lv.e875 <= hiF)
                        bool rngOv = lv.hi >= loF and lv.lo <= hiF
                        if lvlIn or rngOv
                            hit := true
                            break
            if not hit
                hit := scanRollOv(ft, loF, hiF, rollStdAll) or scanRollOv(ft, loF, hiF, rollDispAll) or scanRollOv(ft, loF, hiF, rollReflAll)
    hit

ovClaimedHas(int t) =>
    bool hit = false
    if ovClaimed.size() > 0
        for i = 0 to ovClaimed.size() - 1
            if ovClaimed.get(i) == t
                hit := true
    hit

levelsOverlap(float top, float bot, float loF, float hiF) =>
    float mid = (top + bot) / 2.0
    float rng = top - bot
    bool lvlIn = (top >= loF and top <= hiF) or (bot >= loF and bot <= hiF) or (mid >= loF and mid <= hiF) or (bot + 0.25 * rng >= loF and bot + 0.25 * rng <= hiF) or (bot + 0.75 * rng >= loF and bot + 0.75 * rng <= hiF) or (bot + 0.125 * rng >= loF and bot + 0.125 * rng <= hiF) or (bot + 0.375 * rng >= loF and bot + 0.375 * rng <= hiF) or (bot + 0.625 * rng >= loF and bot + 0.625 * rng <= hiF) or (bot + 0.875 * rng >= loF and bot + 0.875 * rng <= hiF)
    lvlIn or (top >= loF and bot <= hiF)

// True if this FVG is the first overlap for at least one visible 1st Presented FVG.
// Claims those 1st P.FVGs so later overlaps of the same box are skipped.
firstOverlapForAnyStd(int ft, float loF, float hiF) =>
    bool ok = false
    float minOv = ov_min * syminfo.mintick
    if (hiF - loF) >= minOv
        if rollStdAll.size() > 0
            for i = 0 to rollStdAll.size() - 1
                MfFvg o = rollStdAll.get(i)
                bool tgtOk = ov_visible_only ? shownStdFirst(o, time) : true
                if o.t < ft and tgtOk and levelsOverlap(o.top, o.bot, loF, hiF)
                    if not ov_first_only or not ovClaimedHas(o.t)
                        ok := true
                        if ov_first_only and not ovClaimedHas(o.t)
                            ovClaimed.push(o.t)
        if show_disp_fvg and rollDispAll.size() > 0
            for i = 0 to rollDispAll.size() - 1
                MfFvg o = rollDispAll.get(i)
                bool tgtOk = ov_visible_only ? shownDispFirst(o, time) : not sameTInRoll(rollStdAll, o.t)
                if o.t < ft and tgtOk and levelsOverlap(o.top, o.bot, loF, hiF)
                    if not ov_first_only or not ovClaimedHas(o.t)
                        ok := true
                        if ov_first_only and not ovClaimedHas(o.t)
                            ovClaimed.push(o.t)
        if show_refl_fvg and rollReflAll.size() > 0
            for i = 0 to rollReflAll.size() - 1
                MfFvg o = rollReflAll.get(i)
                bool tgtOk = ov_visible_only ? shownReflFirst(o, time) : true
                if o.t < ft and tgtOk and levelsOverlap(o.top, o.bot, loF, hiF)
                    if not ov_first_only or not ovClaimedHas(o.t)
                        ok := true
                        if ov_first_only and not ovClaimedHas(o.t)
                            ovClaimed.push(o.t)
    ok


weekIdInArr(MfFvg[] arr, int wid) =>
    bool hit = false
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if nyWeekId(arr.get(i).t) == wid
                hit := true
    hit

pickWeekStandIn(MfFvg[] src, int wid, int cursorT, bool wantFirst) =>
    bool found = false
    int bestT = wantFirst ? 2147483647 : 0
    float pTop = float(na)
    float pBot = float(na)
    bool pBull = false
    int pT = int(na)
    if src.size() > 0
        for i = 0 to src.size() - 1
            MfFvg o = src.get(i)
            bool skipCur = excludeCurrentDaySpecial and session_still_open(o.t, cursorT)
            if not skipCur and nyWeekId(o.t) == wid
                bool better = wantFirst ? o.t < bestT : o.t >= bestT
                if better
                    found := true
                    bestT := o.t
                    pT := o.t
                    pTop := o.top
                    pBot := o.bot
                    pBull := o.bull
    MfFvg picked = MfFvg.new()
    if found
        picked.t := pT
        picked.top := pTop
        picked.bot := pBot
        picked.bull := pBull
    else
        picked.t := int(na)
    picked

fillHolidayMf(MfFvg[] existing, MfFvg[] rollSrc, int cursorT, bool mondaySide) =>
    MfFvg[] out = array.new<MfFvg>()
    if existing.size() > 0
        for i = 0 to existing.size() - 1
            out.push(existing.get(i))
    if includeHolidayWeeks
        int curW = nyWeekId(tradingWeekStart(cursorT))
        for w = 1 to specialMFCount
            int wid = curW - w
            if not weekIdInArr(out, wid)
                MfFvg sub = pickWeekStandIn(rollSrc, wid, cursorT, mondaySide)
                bool sideOk = mondaySide ? isNyMonday(sub.t) : isNyFriday(sub.t)
                if not na(sub.t) and sideOk
                    out.push(sub)
    out

fillHolidayCurWeek(MfFvg[] existing, MfFvg[] rollSrc, int cursorT) =>
    MfFvg[] out = array.new<MfFvg>()
    if existing.size() > 0
        for i = 0 to existing.size() - 1
            out.push(existing.get(i))
    if includeHolidayWeeks and showCurMon
        int wid = nyWeekId(cursorT)
        if not weekIdInArr(out, wid)
            MfFvg sub = pickWeekStandIn(rollSrc, wid, cursorT, true)
            if not na(sub.t) and isNyMonday(sub.t)
                bool skipCur = excludeCurrentDayWeekday and session_still_open(sub.t, cursorT)
                if not skipCur
                    out.push(sub)
    out

mfHasT(MfFvg[] arr, int t) =>
    bool hit = false
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if arr.get(i).t == t
                hit := true
    hit

trimLines(line[] arr, int n) =>
    while arr.size() > n
        line.delete(arr.shift())

clearLines(line[] arr) =>
    while arr.size() > 0
        line.delete(arr.shift())

clearBoxes(box[] arr) =>
    while arr.size() > 0
        box.delete(arr.shift())

clearLabels(label[] arr) =>
    while arr.size() > 0
        label.delete(arr.shift())

clearSet(box[] bx, line[] md, line[] hi, line[] lo, label[] lb, line[] q, line[] e) =>
    clearBoxes(bx)
    clearLines(md)
    clearLines(hi)
    clearLines(lo)
    clearLabels(lb)
    clearLines(q)
    clearLines(e)

trimArr(box[] bx, line[] md, line[] hi, line[] lo, label[] lb, line[] q, line[] e, int n) =>
    while bx.size() > n
        box.delete(bx.shift())
        if md.size() > 0
            line.delete(md.shift())
        if hi.size() > 0
            line.delete(hi.shift())
        if lo.size() > 0
            line.delete(lo.shift())
        if lb.size() > 0
            label.delete(lb.shift())
    trimLines(q, n * 2)
    trimLines(e, n * 4)

popLastSet(box[] bx, line[] md, line[] hi, line[] lo, label[] lb, line[] q, line[] e) =>
    if bx.size() > 0
        box.delete(bx.pop())
    if md.size() > 0
        line.delete(md.pop())
    if hi.size() > 0
        line.delete(hi.pop())
    if lo.size() > 0
        line.delete(lo.pop())
    if lb.size() > 0
        label.delete(lb.pop())
    if q.size() > 1
        line.delete(q.pop())
        line.delete(q.pop())
    else if q.size() > 0
        line.delete(q.pop())
    if e.size() > 3
        line.delete(e.pop())
        line.delete(e.pop())
        line.delete(e.pop())
        line.delete(e.pop())

drawFvg(box[] bx, line[] md, line[] hi, line[] lo, label[] lb, line[] q, line[] e, float top, float bot, bool isBull, int keep, int xStart, bool forceDraw = false) =>
    color dCol = dayColorOf(xStart)
    color boxCol = isBull ? col_FVG_bull : col_FVG_bear
    if useDayColors
        boxCol := color.new(dCol, 85)
    float mid = (top + bot) / 2.0
    int x1 = xStart
    int x2 = extendBoxRight ? extended_time : time
    string dStr = formatDateFromTime(xStart)
    string dayAdd = showDayInLabel ? dayStrOf(xStart) + " " : ""
    string side = isBull ? "BULL" : "BEAR"
    color labCol = useDayColorsForLabels ? dCol : labelColor
    if showOrgVisuals or forceDraw
        bx.push(box.new(x1, top, x2, bot, xloc=xloc.bar_time, bgcolor=boxCol, border_color=color.new(color.white, 70), text=showTxt ? "1st FVG " + side + " " + dStr : "", text_color=boxTxtCol, text_size=size.small))
        if show_edges
            hi.push(line.new(x1, top, x2, top, xloc=xloc.bar_time, color=useDayColors ? dCol : edgeCol, style=edgeStyle, width=edgeWidth))
            lo.push(line.new(x1, bot, x2, bot, xloc=xloc.bar_time, color=useDayColors ? dCol : edgeCol, style=edgeStyle, width=edgeWidth))
        if show_midline
            md.push(line.new(x1, mid, x2, mid, xloc=xloc.bar_time, color=col_FVG_mid, style=midStyle()))
        float rng = top - bot
        color qC = useDayColors ? color.new(dCol, 50) : quartCol
        color eC = useDayColors ? color.new(dCol, 70) : eighthCol
        if showQuart
            q.push(line.new(x1, bot + 0.25 * rng, x2, bot + 0.25 * rng, xloc=xloc.bar_time, color=qC, style=quartStyle, width=quartWidth))
            q.push(line.new(x1, bot + 0.75 * rng, x2, bot + 0.75 * rng, xloc=xloc.bar_time, color=qC, style=quartStyle, width=quartWidth))
        if showEighth
            q125 = bot + 0.125 * rng
            q375 = bot + 0.375 * rng
            q625 = bot + 0.625 * rng
            q875 = bot + 0.875 * rng
            e.push(line.new(x1, q125, x2, q125, xloc=xloc.bar_time, color=eC, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, q375, x2, q375, xloc=xloc.bar_time, color=eC, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, q625, x2, q625, xloc=xloc.bar_time, color=eC, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, q875, x2, q875, xloc=xloc.bar_time, color=eC, style=eighthStyle, width=eighthWidth))
        if showLabels
            lb.push(label.new(x2, mid, "1st FVG " + dayAdd + dStr, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=labCol, style=label.style_label_left, size=getLabelSize(labelSizeIn)))
    trimArr(bx, md, hi, lo, lb, q, e, keep)

drawDispFvg(box[] bx, line[] md, line[] hi, line[] lo, label[] lb, line[] q, line[] e, float top, float bot, bool isBull, int keep, int xStart) =>
    color boxCol = isBull ? col_DISP_bull : col_DISP_bear
    color lineCol = isBull ? dispEdgeCol : color.new(#ff1744, 10)
    float mid = (top + bot) / 2.0
    int x1 = xStart
    int x2 = extendBoxRight ? extended_time : time
    string dStr = formatDateFromTime(xStart)
    string dayAdd = showDayInLabel ? dayStrOf(xStart) + " " : ""
    string side = isBull ? "BULL" : "BEAR"
    if showDispReflVisuals
        bx.push(box.new(x1, top, x2, bot, xloc=xloc.bar_time, bgcolor=boxCol, border_color=color.new(color.white, 60), text=showTxt ? "1st FVG DISP " + side + " " + dStr : "", text_color=boxTxtCol, text_size=size.small))
        if show_disp_edges
            hi.push(line.new(x1, top, x2, top, xloc=xloc.bar_time, color=lineCol, style=edgeStyle, width=edgeWidth))
            lo.push(line.new(x1, bot, x2, bot, xloc=xloc.bar_time, color=lineCol, style=edgeStyle, width=edgeWidth))
        if show_disp_mid
            md.push(line.new(x1, mid, x2, mid, xloc=xloc.bar_time, color=col_DISP_mid, style=midStyle()))
        float rng = top - bot
        if showQuart
            q.push(line.new(x1, bot + 0.25 * rng, x2, bot + 0.25 * rng, xloc=xloc.bar_time, color=quartCol, style=quartStyle, width=quartWidth))
            q.push(line.new(x1, bot + 0.75 * rng, x2, bot + 0.75 * rng, xloc=xloc.bar_time, color=quartCol, style=quartStyle, width=quartWidth))
        if showEighth
            e.push(line.new(x1, bot + 0.125 * rng, x2, bot + 0.125 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, bot + 0.375 * rng, x2, bot + 0.375 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, bot + 0.625 * rng, x2, bot + 0.625 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, bot + 0.875 * rng, x2, bot + 0.875 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
        if show_disp_labels
            lb.push(label.new(x2, mid, "1st FVG DISP " + dayAdd + dStr, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=isBull ? color.new(#00c853, 0) : color.new(#ff1744, 0), style=label.style_label_left, size=getLabelSize(labelSizeIn)))
    trimArr(bx, md, hi, lo, lb, q, e, keep)

drawReflFvg(box[] bx, line[] md, line[] hi, line[] lo, label[] lb, line[] q, line[] e, float top, float bot, bool isBull, int keep, int xStart) =>
    color boxCol = isBull ? col_REFL_bull : col_REFL_bear
    color lineCol = isBull ? color.new(#00c853, 10) : color.new(#ff1744, 10)
    float mid = (top + bot) / 2.0
    int x1 = xStart
    int x2 = extendBoxRight ? extended_time : time
    string dStr = formatDateFromTime(xStart)
    string dayAdd = showDayInLabel ? dayStrOf(xStart) + " " : ""
    string kind = isBull ? "BISI" : "SIBI"
    if showDispReflVisuals
        bx.push(box.new(x1, top, x2, bot, xloc=xloc.bar_time, bgcolor=boxCol, border_color=color.new(color.white, 60), text=showTxt ? "1st REFL " + kind + " " + dStr : "", text_color=boxTxtCol, text_size=size.small))
        if show_refl_edges
            hi.push(line.new(x1, top, x2, top, xloc=xloc.bar_time, color=lineCol, style=edgeStyle, width=edgeWidth))
            lo.push(line.new(x1, bot, x2, bot, xloc=xloc.bar_time, color=lineCol, style=edgeStyle, width=edgeWidth))
        if show_refl_mid
            md.push(line.new(x1, mid, x2, mid, xloc=xloc.bar_time, color=col_REFL_mid, style=midStyle()))
        float rng = top - bot
        if showQuart
            q.push(line.new(x1, bot + 0.25 * rng, x2, bot + 0.25 * rng, xloc=xloc.bar_time, color=quartCol, style=quartStyle, width=quartWidth))
            q.push(line.new(x1, bot + 0.75 * rng, x2, bot + 0.75 * rng, xloc=xloc.bar_time, color=quartCol, style=quartStyle, width=quartWidth))
        if showEighth
            e.push(line.new(x1, bot + 0.125 * rng, x2, bot + 0.125 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, bot + 0.375 * rng, x2, bot + 0.375 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, bot + 0.625 * rng, x2, bot + 0.625 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
            e.push(line.new(x1, bot + 0.875 * rng, x2, bot + 0.875 * rng, xloc=xloc.bar_time, color=eighthCol, style=eighthStyle, width=eighthWidth))
        if show_refl_labels
            lb.push(label.new(x2, mid, "1st REFL " + kind + " " + dayAdd + dStr, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=isBull ? color.new(#00c853, 0) : color.new(#ff1744, 0), style=label.style_label_left, size=getLabelSize(labelSizeIn)))
    trimArr(bx, md, hi, lo, lb, q, e, keep)

bool fire = false
bool fireBull = false
float fireTop = na
float fireBot = na
int fireT = na
if useNativeBars
    int midMin = hour(time[1], tz) * 60 + minute(time[1], tz)
    bool midOkChart = midMin >= 9 * 60 + 31
    if show_indicator and show_fvg and waiting and inRTH and boolFVG and midOkChart
        waiting := false
        fire := true
        fireBull := isBullFVG
        fireTop := fTop
        fireBot := fBot
        fireT := time[2]
else
    if show_indicator and show_fvg and hit1m
        fire := true
        fireBull := bull1m
        fireTop := top1m
        fireBot := bot1m
        fireT := t1m

if fire
    float top = math.max(fireTop, fireBot)
    float bot = math.min(fireTop, fireBot)
    bool firstIsAlsoDisp = not useNativeBars and found1mDispDay and not na(t1m) and not na(t1mDisp) and t1m == t1mDisp
    bool fallbackStd = onlyShowDispRefl and showStdIfNoDisp and (not found1mDispDay or firstIsAlsoDisp)
    int dow = nyDow(fireT)
    bool mfDay = showSpecialMF and isNyMonFri(fireT)
    pushRoll(rollStdAll, fireT, top, bot, fireBull)
    if showSpecialMF and isNyMonFri(fireT)
        MfFvg rec = MfFvg.new()
        rec.t := fireT
        rec.top := top
        rec.bot := bot
        rec.bull := fireBull
        if isNyMonday(fireT)
            monFvgsAll.push(rec)
            while monFvgsAll.size() > math.max(specialMFCount * 2 + 6, 12)
                monFvgsAll.shift()
        else if isNyFriday(fireT)
            friFvgsAll.push(rec)
            while friFvgsAll.size() > math.max(specialMFCount * 2 + 6, 12)
                friFvgsAll.shift()
    if not onlyShowDispRefl or (showStdIfNoDisp and not found1mDispDay)
        int pdN = useHistoricalCount ? math.max(boxesToShow, 1) : pdGaps
        recentHi.push(top)
        recentLo.push(bot)
        recentT.push(fireT)
        if recentHi.size() > pdN
            recentHi.shift()
            recentLo.shift()
            recentT.shift()
    float rng = top - bot
    histLv.push(RthLv.new(fireT, top, bot, (top+bot)/2, bot+0.25*rng, bot+0.75*rng, bot+0.125*rng, bot+0.375*rng, bot+0.625*rng, bot+0.875*rng))
    if histLv.size() > math.max(boxesToShow, 1)
        histLv.shift()

// Chart-TF swing tracking for displacement filter
var bool waitingDisp = true
var bool waitingRefl = true
var bool fireDisp = false
var bool fireDispBull = false
var float fireDispTop = na
var float fireDispBot = na
var int fireDispT = na

if rthStart
    waitingDisp := true

var int winNatYmd = int(na)
if useNativeBars
    int yNow = ny_ymd(time)
    if na(winNatYmd) or winNatYmd != yNow
        winNatYmd := yNow
        winH1m.clear()
        winL1m.clear()

fireDisp := false
if useNativeBars
    int midMinD = hour(time[1], tz) * 60 + minute(time[1], tz)
    bool midOkChartD = midMinD >= 9 * 60 + 31
    bool allowChartDisp = not onlyFirstDispPerSession or waitingDisp
    bool blockChartDispRefl = noDispAfterRefl and not waitingRefl
    if show_indicator and show_disp_fvg and allowChartDisp and not blockChartDispRefl and inRTH and boolFVG and midOkChartD
        float priorHighC = priorExtreme(winH1m, true)
        float priorLowC = priorExtreme(winL1m, false)
        if hasDispOC(isBullFVG, open[1], close[1], high[1], low[1], priorHighC, priorLowC)
            waitingDisp := false
            fireDisp := true
            fireDispBull := isBullFVG
            fireDispTop := fTop
            fireDispBot := fBot
            fireDispT := time[2]
    winH1m.push(high)
    winL1m.push(low)
    while winH1m.size() > swingLookback + 8
        winH1m.shift()
        winL1m.shift()

if not useNativeBars
    if show_indicator and show_disp_fvg and hit1mDisp
        fireDisp := true
        fireDispBull := bull1mDisp
        fireDispTop := top1mDisp
        fireDispBot := bot1mDisp
        fireDispT := t1mDisp

var int dispDrawnYmd = int(na)
var int dispDrawnN = 0
if fireDisp
    int dYmd = ny_ymd(fireDispT)
    if na(dispDrawnYmd) or dispDrawnYmd != dYmd
        dispDrawnYmd := dYmd
        dispDrawnN := 0
    if onlyFirstDispPerSession and dispDrawnN >= 1
        fireDisp := false

if fireDisp
    dispDrawnN += 1
    float dTop = math.max(fireDispTop, fireDispBot)
    float dBot = math.min(fireDispTop, fireDispBot)
    bool sameAsFirst = fire and not na(fireT) and fireT == fireDispT
    bool dMfDay = showSpecialMF and isNyMonFri(fireDispT)
    if not sameAsFirst
        pushRoll(rollDispAll, fireDispT, dTop, dBot, fireDispBull)
    if dMfDay and not sameAsFirst
        if isNyMonday(fireDispT)
            pushMf(monDispAll, fireDispT, dTop, dBot, fireDispBull)
        else if isNyFriday(fireDispT)
            pushMf(friDispAll, fireDispT, dTop, dBot, fireDispBull)
    if onlyShowDispRefl
        int pdNd = useHistoricalCount ? math.max(boxesToShow, 1) : pdGaps
        recentHi.push(dTop)
        recentLo.push(dBot)
        recentT.push(fireDispT)
        if recentHi.size() > pdNd
            recentHi.shift()
            recentLo.shift()
            recentT.shift()

var bool haveChartRef = false
var bool chartRefBull = false
var int chartRefT = int(na)
var bool fireRefl = false
var bool fireReflBull = false
var float fireReflTop = na
var float fireReflBot = na
var int fireReflT = na

if rthStart
    waitingRefl := true
    haveChartRef := false
    chartRefT := int(na)

fireRefl := false
if useNativeBars
    int midMinR = hour(time[1], tz) * 60 + minute(time[1], tz)
    bool midOkChartR = midMinR >= 9 * 60 + 31
    if show_indicator and inRTH and boolFVG and midOkChartR
        if fire
            haveChartRef := true
            chartRefBull := fireBull
            chartRefT := fireT
        if fireDisp
            haveChartRef := true
            chartRefBull := fireDispBull
            chartRefT := fireDispT
            waitingRefl := true
        if show_refl_fvg and waitingRefl and haveChartRef and isBullFVG != chartRefBull and time[2] > chartRefT
            waitingRefl := false
            fireRefl := true
            fireReflBull := isBullFVG
            fireReflTop := fTop
            fireReflBot := fBot
            fireReflT := time[2]
else
    if show_indicator and show_refl_fvg and hit1mRefl
        fireRefl := true
        fireReflBull := bull1mRefl
        fireReflTop := top1mRefl
        fireReflBot := bot1mRefl
        fireReflT := t1mRefl

if fireRefl
    float rTop = math.max(fireReflTop, fireReflBot)
    float rBot = math.min(fireReflTop, fireReflBot)
    bool rMfDay = showSpecialMF and isNyMonFri(fireReflT)
    pushRoll(rollReflAll, fireReflT, rTop, rBot, fireReflBull)
    if rMfDay
        if isNyMonday(fireReflT)
            pushMf(monReflAll, fireReflT, rTop, rBot, fireReflBull)
        else if isNyFriday(fireReflT)
            pushMf(friReflAll, fireReflT, rTop, rBot, fireReflBull)
    if onlyShowDispRefl
        int pdNr = useHistoricalCount ? math.max(boxesToShow, 1) : pdGaps
        recentHi.push(rTop)
        recentLo.push(rBot)
        recentT.push(fireReflT)
        if recentHi.size() > pdNr
            recentHi.shift()
            recentLo.shift()
            recentT.shift()

if barstate.islast and show_indicator
    int cursorRoll = time
    int[] yVis = lastSessionDays(rollStdAll, rollDispAll, rollReflAll, cursorRoll, boxesToShow)
    int pdDays = useHistoricalCount ? math.max(boxesToShow, 1) : pdGaps
    int[] yPd = lastSessionDays(rollStdAll, rollDispAll, rollReflAll, cursorRoll, pdDays)
    int capY = ny_ymd(cursorRoll)
    visPdHi := float(na)
    visPdLo := float(na)
    visPdT := int(na)
    if boxesToShow > 0 and not onlyShowPD
        clearSet(boxArr, midArr, hiArr, loArr, labArr, qArr, eArr)
        clearSet(dBoxArr, dMidArr, dHiArr, dLoArr, dLabArr, dQArr, dEArr)
        clearSet(rBoxArr, rMidArr, rHiArr, rLoArr, rLabArr, rQArr, rEArr)
    if rollStdAll.size() > 0
        for i = 0 to rollStdAll.size() - 1
            MfFvg o = rollStdAll.get(i)
            int y = ny_ymd(o.t)
            if y <= capY
                bool dayHasDisp = dayHasType(rollDispAll, y)
                bool showStd = not onlyShowDispRefl or showStdIfNoDisp or not dayHasDisp
                if showStd and ymdIn(yPd, y)
                    visPdHi := na(visPdHi) ? o.top : math.max(visPdHi, o.top)
                    visPdLo := na(visPdLo) ? o.bot : math.min(visPdLo, o.bot)
                    visPdT := na(visPdT) ? o.t : int(math.min(visPdT, o.t))
                bool hideMfDup = showSpecialMF and isNyMonFri(o.t) and (sameNyWeek(o.t, cursorRoll) or inMfWeekWindow(o.t, cursorRoll))
                if showStd and ymdIn(yVis, y) and boxesToShow > 0 and not onlyShowPD and not hideMfDup
                    drawFvg(boxArr, midArr, hiArr, loArr, labArr, qArr, eArr, o.top, o.bot, o.bull, 50, o.t, onlyShowDispRefl)
    if show_disp_fvg and rollDispAll.size() > 0
        for i = 0 to rollDispAll.size() - 1
            MfFvg o = rollDispAll.get(i)
            int y = ny_ymd(o.t)
            if y <= capY
                if ymdIn(yPd, y)
                    visPdHi := na(visPdHi) ? o.top : math.max(visPdHi, o.top)
                    visPdLo := na(visPdLo) ? o.bot : math.min(visPdLo, o.bot)
                    visPdT := na(visPdT) ? o.t : int(math.min(visPdT, o.t))
                bool hideMfDupD = showSpecialMF and isNyMonFri(o.t) and (sameNyWeek(o.t, cursorRoll) or inMfWeekWindow(o.t, cursorRoll))
                if ymdIn(yVis, y) and boxesToShow > 0 and not onlyShowPD and not hideMfDupD and not mfHasT(rollStdAll, o.t)
                    drawDispFvg(dBoxArr, dMidArr, dHiArr, dLoArr, dLabArr, dQArr, dEArr, o.top, o.bot, o.bull, 50, o.t)
    if show_refl_fvg and rollReflAll.size() > 0
        for i = 0 to rollReflAll.size() - 1
            MfFvg o = rollReflAll.get(i)
            int y = ny_ymd(o.t)
            if y <= capY
                if ymdIn(yPd, y)
                    visPdHi := na(visPdHi) ? o.top : math.max(visPdHi, o.top)
                    visPdLo := na(visPdLo) ? o.bot : math.min(visPdLo, o.bot)
                    visPdT := na(visPdT) ? o.t : int(math.min(visPdT, o.t))
                bool hideMfDupR = showSpecialMF and isNyMonFri(o.t) and (sameNyWeek(o.t, cursorRoll) or inMfWeekWindow(o.t, cursorRoll))
                if ymdIn(yVis, y) and boxesToShow > 0 and not onlyShowPD and not hideMfDupR
                    drawReflFvg(rBoxArr, rMidArr, rHiArr, rLoArr, rLabArr, rQArr, rEArr, o.top, o.bot, o.bull, 50, o.t)

if barstate.islast and not showSpecialMF and show_indicator
    clearSet(monBox, monMid, monHi, monLo, monLab, monQ, monE)
    clearSet(friBox, friMid, friHi, friLo, friLab, friQ, friE)
    clearSet(monDBox, monDMid, monDHi, monDLo, monDLab, monDQ, monDE)
    clearSet(friDBox, friDMid, friDHi, friDLo, friDLab, friDQ, friDE)
    clearSet(monRBox, monRMid, monRHi, monRLo, monRLab, monRQ, monRE)
    clearSet(friRBox, friRMid, friRHi, friRLo, friRLab, friRQ, friRE)

// Replay-safe Mon/Fri redraw on the last bar (replay cursor or live last bar)
if barstate.islast and showSpecialMF and show_indicator and not onlyShowPD
    int cursorT = time
    clearSet(monBox, monMid, monHi, monLo, monLab, monQ, monE)
    clearSet(friBox, friMid, friHi, friLo, friLab, friQ, friE)
    MfFvg[] monDraw = fillHolidayMf(filterMf(monFvgsAll, cursorT), rollStdAll, cursorT, true)
    MfFvg[] friDraw = fillHolidayMf(filterMf(friFvgsAll, cursorT), rollStdAll, cursorT, false)
    if monDraw.size() > 0
        for i = 0 to monDraw.size() - 1
            MfFvg o = monDraw.get(i)
            drawFvg(monBox, monMid, monHi, monLo, monLab, monQ, monE, o.top, o.bot, o.bull, specialMFCount * 3 + 4, o.t, onlyShowDispRefl)
    if friDraw.size() > 0
        for i = 0 to friDraw.size() - 1
            MfFvg o = friDraw.get(i)
            drawFvg(friBox, friMid, friHi, friLo, friLab, friQ, friE, o.top, o.bot, o.bull, specialMFCount * 3 + 4, o.t, onlyShowDispRefl)
    clearSet(monDBox, monDMid, monDHi, monDLo, monDLab, monDQ, monDE)
    clearSet(friDBox, friDMid, friDHi, friDLo, friDLab, friDQ, friDE)
    clearSet(monRBox, monRMid, monRHi, monRLo, monRLab, monRQ, monRE)
    clearSet(friRBox, friRMid, friRHi, friRLo, friRLab, friRQ, friRE)
    MfFvg[] monDDraw = fillHolidayMf(filterMf(monDispAll, cursorT), rollDispAll, cursorT, true)
    MfFvg[] friDDraw = fillHolidayMf(filterMf(friDispAll, cursorT), rollDispAll, cursorT, false)
    MfFvg[] monRDraw = fillHolidayMf(filterMf(monReflAll, cursorT), rollReflAll, cursorT, true)
    MfFvg[] friRDraw = fillHolidayMf(filterMf(friReflAll, cursorT), rollReflAll, cursorT, false)
    if monDDraw.size() > 0
        for i = 0 to monDDraw.size() - 1
            MfFvg o = monDDraw.get(i)
            if not mfHasT(monDraw, o.t)
                drawDispFvg(monDBox, monDMid, monDHi, monDLo, monDLab, monDQ, monDE, o.top, o.bot, o.bull, specialMFCount * 3 + 4, o.t)
    if friDDraw.size() > 0
        for i = 0 to friDDraw.size() - 1
            MfFvg o = friDDraw.get(i)
            if not mfHasT(friDraw, o.t)
                drawDispFvg(friDBox, friDMid, friDHi, friDLo, friDLab, friDQ, friDE, o.top, o.bot, o.bull, specialMFCount * 3 + 4, o.t)
    if monRDraw.size() > 0
        for i = 0 to monRDraw.size() - 1
            MfFvg o = monRDraw.get(i)
            drawReflFvg(monRBox, monRMid, monRHi, monRLo, monRLab, monRQ, monRE, o.top, o.bot, o.bull, specialMFCount * 3 + 4, o.t)
    if friRDraw.size() > 0
        for i = 0 to friRDraw.size() - 1
            MfFvg o = friRDraw.get(i)
            drawReflFvg(friRBox, friRMid, friRHi, friRLo, friRLab, friRQ, friRE, o.top, o.bot, o.bull, specialMFCount * 3 + 4, o.t)
    mfPdHi := float(na)
    mfPdLo := float(na)
    mfPdT := int(na)
    if not onlyShowDispRefl or showStdIfNoDisp
        if monDraw.size() > 0
            for i = 0 to monDraw.size() - 1
                MfFvg o = monDraw.get(i)
                mfPdHi := na(mfPdHi) ? o.top : math.max(mfPdHi, o.top)
                mfPdLo := na(mfPdLo) ? o.bot : math.min(mfPdLo, o.bot)
                mfPdT := na(mfPdT) ? o.t : int(math.min(mfPdT, o.t))
        if friDraw.size() > 0
            for i = 0 to friDraw.size() - 1
                MfFvg o = friDraw.get(i)
                mfPdHi := na(mfPdHi) ? o.top : math.max(mfPdHi, o.top)
                mfPdLo := na(mfPdLo) ? o.bot : math.min(mfPdLo, o.bot)
                mfPdT := na(mfPdT) ? o.t : int(math.min(mfPdT, o.t))
    if show_disp_fvg
        if monDDraw.size() > 0
            for i = 0 to monDDraw.size() - 1
                MfFvg o = monDDraw.get(i)
                mfPdHi := na(mfPdHi) ? o.top : math.max(mfPdHi, o.top)
                mfPdLo := na(mfPdLo) ? o.bot : math.min(mfPdLo, o.bot)
                mfPdT := na(mfPdT) ? o.t : int(math.min(mfPdT, o.t))
        if friDDraw.size() > 0
            for i = 0 to friDDraw.size() - 1
                MfFvg o = friDDraw.get(i)
                mfPdHi := na(mfPdHi) ? o.top : math.max(mfPdHi, o.top)
                mfPdLo := na(mfPdLo) ? o.bot : math.min(mfPdLo, o.bot)
                mfPdT := na(mfPdT) ? o.t : int(math.min(mfPdT, o.t))
    if show_refl_fvg
        if monRDraw.size() > 0
            for i = 0 to monRDraw.size() - 1
                MfFvg o = monRDraw.get(i)
                mfPdHi := na(mfPdHi) ? o.top : math.max(mfPdHi, o.top)
                mfPdLo := na(mfPdLo) ? o.bot : math.min(mfPdLo, o.bot)
                mfPdT := na(mfPdT) ? o.t : int(math.min(mfPdT, o.t))
        if friRDraw.size() > 0
            for i = 0 to friRDraw.size() - 1
                MfFvg o = friRDraw.get(i)
                mfPdHi := na(mfPdHi) ? o.top : math.max(mfPdHi, o.top)
                mfPdLo := na(mfPdLo) ? o.bot : math.min(mfPdLo, o.bot)
                mfPdT := na(mfPdT) ? o.t : int(math.min(mfPdT, o.t))
    if not na(mfPdHi)
        visPdHi := na(visPdHi) ? mfPdHi : math.max(visPdHi, mfPdHi)
        visPdLo := na(visPdLo) ? mfPdLo : math.min(visPdLo, mfPdLo)
        visPdT := na(visPdT) ? mfPdT : int(math.min(visPdT, mfPdT))

bool anyCurWeekDay = showCurMon or showCurTue or showCurWed or showCurThu or showCurFri
if barstate.islast and show_indicator
    clearSet(curBox, curMid, curHi, curLo, curLab, curQ, curE)
    clearSet(curDBox, curDMid, curDHi, curDLo, curDLab, curDQ, curDE)
    clearSet(curRBox, curRMid, curRHi, curRLo, curRLab, curRQ, curRE)
    if anyCurWeekDay
        int cursorCw = time
        MfFvg[] rawStd = filterCurWeek(rollStdAll, cursorCw)
        MfFvg[] rawDisp = filterCurWeek(rollDispAll, cursorCw)
        MfFvg[] rawRefl = filterCurWeek(rollReflAll, cursorCw)
        MfFvg[] cwStd = isolateWeekdays ? rawStd : fillHolidayCurWeek(rawStd, rollStdAll, cursorCw)
        MfFvg[] cwDisp = isolateWeekdays ? rawDisp : fillHolidayCurWeek(rawDisp, rollDispAll, cursorCw)
        MfFvg[] cwRefl = isolateWeekdays ? rawRefl : fillHolidayCurWeek(rawRefl, rollReflAll, cursorCw)
        if cwStd.size() > 0
            for i = 0 to cwStd.size() - 1
                MfFvg o = cwStd.get(i)
                bool dayHasDispCw = dayHasType(rollDispAll, ny_ymd(o.t))
                bool showStdCw = not onlyShowDispRefl or showStdIfNoDisp or not dayHasDispCw
                if showStdCw
                    visPdHi := na(visPdHi) ? o.top : math.max(visPdHi, o.top)
                    visPdLo := na(visPdLo) ? o.bot : math.min(visPdLo, o.bot)
                    visPdT := na(visPdT) ? o.t : int(math.min(visPdT, o.t))
                    if not onlyShowPD
                        drawFvg(curBox, curMid, curHi, curLo, curLab, curQ, curE, o.top, o.bot, o.bull, math.max(isolateWeeks * 3, 8), o.t, onlyShowDispRefl)
        if show_disp_fvg and cwDisp.size() > 0
            for i = 0 to cwDisp.size() - 1
                MfFvg o = cwDisp.get(i)
                if not mfHasT(cwStd, o.t)
                    visPdHi := na(visPdHi) ? o.top : math.max(visPdHi, o.top)
                    visPdLo := na(visPdLo) ? o.bot : math.min(visPdLo, o.bot)
                    visPdT := na(visPdT) ? o.t : int(math.min(visPdT, o.t))
                    if not onlyShowPD
                        drawDispFvg(curDBox, curDMid, curDHi, curDLo, curDLab, curDQ, curDE, o.top, o.bot, o.bull, math.max(isolateWeeks * 3, 8), o.t)
        if show_refl_fvg and cwRefl.size() > 0
            for i = 0 to cwRefl.size() - 1
                MfFvg o = cwRefl.get(i)
                visPdHi := na(visPdHi) ? o.top : math.max(visPdHi, o.top)
                visPdLo := na(visPdLo) ? o.bot : math.min(visPdLo, o.bot)
                visPdT := na(visPdT) ? o.t : int(math.min(visPdT, o.t))
                if not onlyShowPD
                    drawReflFvg(curRBox, curRMid, curRHi, curRLo, curRLab, curRQ, curRE, o.top, o.bot, o.bull, math.max(isolateWeeks * 3, 8), o.t)

extLines(line[] arr, int xt) =>
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            line.set_x2(arr.get(i), xt)

extendSet(box[] bx, line[] md, line[] hi, line[] lo, label[] lb, line[] q, line[] e, int xt) =>
    if bx.size() > 0
        for i = 0 to bx.size() - 1
            box.set_right(bx.get(i), xt)
    extLines(md, xt)
    extLines(hi, xt)
    extLines(lo, xt)
    extLines(q, xt)
    extLines(e, xt)
    if lb.size() > 0
        for i = 0 to lb.size() - 1
            label.set_x(lb.get(i), xt)

if extendBoxRight and show_indicator
    extendSet(boxArr, midArr, hiArr, loArr, labArr, qArr, eArr, extended_time)
    extendSet(monBox, monMid, monHi, monLo, monLab, monQ, monE, extended_time)
    extendSet(friBox, friMid, friHi, friLo, friLab, friQ, friE, extended_time)
    extendSet(dBoxArr, dMidArr, dHiArr, dLoArr, dLabArr, dQArr, dEArr, extended_time)
    extendSet(rBoxArr, rMidArr, rHiArr, rLoArr, rLabArr, rQArr, rEArr, extended_time)
    extendSet(monDBox, monDMid, monDHi, monDLo, monDLab, monDQ, monDE, extended_time)
    extendSet(friDBox, friDMid, friDHi, friDLo, friDLab, friDQ, friDE, extended_time)
    extendSet(monRBox, monRMid, monRHi, monRLo, monRLab, monRQ, monRE, extended_time)
    extendSet(friRBox, friRMid, friRHi, friRLo, friRLab, friRQ, friRE, extended_time)
    extendSet(curBox, curMid, curHi, curLo, curLab, curQ, curE, extended_time)
    extendSet(curDBox, curDMid, curDHi, curDLo, curDLab, curDQ, curDE, extended_time)
    extendSet(curRBox, curRMid, curRHi, curRLo, curRLab, curRQ, curRE, extended_time)


drawOvBox(int x1, float tp, float bt, bool isBull) =>
    color bg = isBull ? ov_bull : ov_bear
    int x2 = x1 + ov_ext
    box.new(x1, tp, x2, bt, bgcolor=bg, border_color=color.new(color.white, 70), xloc=xloc.bar_index)
    if ov_mid
        string st = ov_mid_style == "Dashed" ? line.style_dashed : ov_mid_style == "Dotted" ? line.style_dotted : line.style_solid
        line.new(x1, (tp + bt) / 2, x2, (tp + bt) / 2, color=ov_mid_col, style=st, xloc=xloc.bar_index)

if rthStart
    ov_armed := true
    ovClaimed.clear()

ov_hit = false
bool ovOn = (show_ov_fvg or onlyShowOvFVG) and not onlyShowPD and show_indicator
if ovOn and useNativeBars and boolFVG and rollStdAll.size() > 0
    bool macOkN = not ov_macros_only or inMacroWindow(time[2])
    if macOkN
        ov_hit := firstOverlapForAnyStd(time[2], math.min(fTop, fBot), math.max(fTop, fBot))

if ovOn and useNativeBars and boolFVG and ov_hit
    drawOvBox(bar_index - 2, math.max(fTop, fBot), math.min(fTop, fBot), isBullFVG)

if ovOn and not useNativeBars and ov1mHit and (not ov_macros_only or inMacroWindow(ov1mT)) and firstOverlapForAnyStd(ov1mT, ov1mBot, ov1mTop)
    drawOvBox(bar_index - 2, ov1mTop, ov1mBot, ov1mBull)

var table pdTable = table.new(getTablePosition(pdTablePosition), 1, 1, bgcolor=color.gray, border_width=1, border_color=color.black)
bool useVisPd = not na(visPdHi) and not na(visPdLo)
if (showPDTable or onlyShowPD) and (useVisPd or recentHi.size() > 0) and show_indicator
    float pdHH = useVisPd ? visPdHi : recentHi.max()
    float pdLL = useVisPd ? visPdLo : recentLo.min()
    float pdRange = pdHH - pdLL
    float pdMidv = pdLL + pdRange * 0.5
    float pdPercent = pdRange != 0 ? (close - pdMidv) / (pdRange / 2) * 100 : na
    string pdStatus = pdPercent > 0 ? "Premium" : "Discount"
    color pdBg = pdPercent > 0 ? color.green : color.red
    string pdDisplay = switch pdDisplayMode
        "Status" => pdStatus
        "Percentage" => str.tostring(math.abs(pdPercent), "#.#") + "%"
        "Both" => pdStatus + " (" + str.tostring(math.abs(pdPercent), "#.#") + "%)"
        => pdStatus
    table.cell(pdTable, 0, 0, pdDisplay, text_color=color.white, bgcolor=pdBg, text_size=getLabelSize(pdTableSize))

var line pdLnHigh = na
var line pdLnLow = na
var line pdLnMid = na
var line pdLn25 = na
var line pdLn75 = na
var line pdLn125 = na
var line pdLn375 = na
var line pdLn625 = na
var line pdLn875 = na
var label pdLabHigh = na
var label pdLabLow = na
var label pdLabMid = na
var label pdLab25 = na
var label pdLab75 = na
var label pdLab125 = na
var label pdLab375 = na
var label pdLab625 = na
var label pdLab875 = na

setLn(line ln, int x1, float y, int x2, color col, string st, int w) =>
    line out = ln
    if na(out)
        out := line.new(x1, y, x2, y, xloc=xloc.bar_time, color=col, style=st, width=w)
    else
        line.set_xy1(out, x1, y)
        line.set_xy2(out, x2, y)
    out

setLb(label lb, int x, float y, string txt) =>
    label out = lb
    if na(out)
        out := label.new(x, y, txt, xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=pdEighthCol, style=label.style_label_left, size=getLabelSize(labelSizeIn))
    else
        label.set_xy(out, x, y)
        label.set_text(out, txt)
    out

if (useVisPd or recentHi.size() > 0) and (showPDGradients or onlyShowPD) and show_indicator
    float pdHH = useVisPd ? visPdHi : recentHi.max()
    float pdLL = useVisPd ? visPdLo : recentLo.min()
    float pdR = pdHH - pdLL
    int x1 = useVisPd ? visPdT : recentT.get(0)
    int x2 = extended_time
    pdLnHigh := setLn(pdLnHigh, x1, pdHH, x2, pdEighthCol, pdEighthStyle, pdEighthWidth + 1)
    pdLnLow := setLn(pdLnLow, x1, pdLL, x2, pdEighthCol, pdEighthStyle, pdEighthWidth + 1)
    pdLnMid := setLn(pdLnMid, x1, pdLL + 0.5 * pdR, x2, pdEighthCol, line.style_dashed, pdEighthWidth)
    pdLn25 := setLn(pdLn25, x1, pdLL + 0.25 * pdR, x2, pdEighthCol, pdEighthStyle, pdEighthWidth)
    pdLn75 := setLn(pdLn75, x1, pdLL + 0.75 * pdR, x2, pdEighthCol, pdEighthStyle, pdEighthWidth)
    pdLn125 := setLn(pdLn125, x1, pdLL + 0.125 * pdR, x2, pdEighthCol, pdEighthStyle, pdEighthWidth)
    pdLn375 := setLn(pdLn375, x1, pdLL + 0.375 * pdR, x2, pdEighthCol, pdEighthStyle, pdEighthWidth)
    pdLn625 := setLn(pdLn625, x1, pdLL + 0.625 * pdR, x2, pdEighthCol, pdEighthStyle, pdEighthWidth)
    pdLn875 := setLn(pdLn875, x1, pdLL + 0.875 * pdR, x2, pdEighthCol, pdEighthStyle, pdEighthWidth)
    if showPDEighthLabels
        pdLabHigh := setLb(pdLabHigh, x2, pdHH, "PD HIGH")
        pdLabLow := setLb(pdLabLow, x2, pdLL, "PD LOW")
        pdLabMid := setLb(pdLabMid, x2, pdLL + 0.5 * pdR, "PD C.E.")
        pdLab25 := setLb(pdLab25, x2, pdLL + 0.25 * pdR, "PD .25")
        pdLab75 := setLb(pdLab75, x2, pdLL + 0.75 * pdR, "PD .75")
        pdLab125 := setLb(pdLab125, x2, pdLL + 0.125 * pdR, "PD .125")
        pdLab375 := setLb(pdLab375, x2, pdLL + 0.375 * pdR, "PD .375")
        pdLab625 := setLb(pdLab625, x2, pdLL + 0.625 * pdR, "PD .625")
        pdLab875 := setLb(pdLab875, x2, pdLL + 0.875 * pdR, "PD .875")