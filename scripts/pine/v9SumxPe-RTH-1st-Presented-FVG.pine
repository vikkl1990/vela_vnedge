    int t
    float top
    float bot
    bool bull
var MfFvg[] monFvgsAll = array.new<MfFvg>()
var MfFvg[] friFvgsAll = array.new<MfFvg>()
var MfFvg[] monDispAll = array.new<MfFvg>()
var MfFvg[] friDispAll = array.new<MfFvg>()
var MfFvg[] monReflAll = array.new<MfFvg>()
var MfFvg[] friReflAll = array.new<MfFvg>()
var MfFvg[] rollStdAll = array.new<MfFvg>()
var MfFvg[] rollDispAll = array.new<MfFvg>()
var MfFvg[] rollReflAll = array.new<MfFvg>()
var float mfPdHi = float(na)
