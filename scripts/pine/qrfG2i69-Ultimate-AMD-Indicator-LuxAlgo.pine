//@version=6
indicator("Ultimate AMD Indicator", overlay = true, max_boxes_count = 500)

// --- Inputs ---
grp_amd = "AMD Settings"
accLen = input.int(50, "Accumulation Length", minval = 5, group = grp_amd)
accMaxRange = input.float(0.5, "Accumulation Max Range (%)", minval = 0.1, group = grp_amd, tooltip = "Maximum price range (in %) to be considered accumulation.")
brkType = input.string("Both", "Breakout Type", options = ["Wicks", "Bodies", "Both"], group = grp_amd)
maxManBars = input.int(20, "Max Manipulation Length (Bars)", minval = 1, group = grp_amd, tooltip = "If price does not reverse and break the opposite side of the accumulation range within this many bars, the manipulation is invalidated.")
maxAmd = input.int(5, "Max AMD Cycles Shown", minval = 1, group = grp_amd)

grp_fvg = "FVG Settings"
showFvg = input.bool(true, "Show FVGs", group = grp_fvg)
showIfvg = input.bool(false, "Show IFVGs", group = grp_fvg)
fvgMinAtr = input.float(0.5, "FVG Min ATR Multiplier", minval = 0.0, step = 0.1, group = grp_fvg)
maxFvgs = input.int(15, "Max Active FVGs/IFVGs", minval = 1, maxval = 100, group = grp_fvg)
filterOverlap = input.bool(true, "Filter Overlapping FVGs/IFVGs", group = grp_fvg, tooltip = "Prevents new FVGs or IFVGs from forming if they overlap with an existing active one of the same direction.")

grp_alerts = "Alert Settings"
alertAcc = input.bool(true, "Alert on Accumulation", group = grp_alerts)
alertMan = input.bool(true, "Alert on Manipulation", group = grp_alerts)

grp_colors = "Colors"
colorAcc = input.color(color.new(color.gray, 80), "Accumulation", group = grp_colors)
colorMan = input.color(color.new(color.yellow, 80), "Manipulation", group = grp_colors)
colorFvgBull = input.color(color.new(color.green, 80), "Bullish FVG", group = grp_colors)
colorFvgBear = input.color(color.new(color.red, 80), "Bearish FVG", group = grp_colors)
colorIfvgBull = input.color(color.new(color.green, 80), "Bullish IFVG", group = grp_colors)
colorIfvgBear = input.color(color.new(color.red, 80), "Bearish IFVG", group = grp_colors)
textColor = input.color(color.new(color.white, 50), "Box Text Color", group = grp_colors)
lblTextColor = input.color(color.white, "Label Text Color", group = grp_colors)

// --- State Variables ---
var int state = 0 // 0 = Searching Acc, 1 = Acc Active, 2 = Man Active, 3 = Dist Active
var float accTop = na
var float accBot = na
var int accStartBar = na

var float manTop = na
var float manBot = na
var int manStartBar = na

var int distStartBar = na
var int manDir = 0 // 1 for upward manip, -1 for downward

var box accBox = na
var box manBox = na
var label manLabel = na

var accBoxes = array.new<box>()
var manBoxes = array.new<box>()
var manLabels = array.new<label>()

// --- Helper Functions ---
get_high(type) =>
    switch type
        "Wicks" => high
        "Bodies" => math.max(open, close)
        => high

get_low(type) =>
    switch type
        "Wicks" => low
        "Bodies" => math.min(open, close)
        => low

// --- AMD Logic ---
h_val = get_high("Wicks")
l_val = get_low("Wicks")
brk_high = get_high(brkType)
brk_low = get_low(brkType)

highest_h = ta.highest(h_val, accLen)
lowest_l = ta.lowest(l_val, accLen)
range_pct = (highest_h - lowest_l) / lowest_l * 100

is_acc = range_pct <= accMaxRange

if state == 0
    if is_acc
        bool skipAcc = false
        if array.size(accBoxes) > 0
            box lastAcc = array.get(accBoxes, array.size(accBoxes) - 1)
            int proposedStart = bar_index - accLen + 1
            if proposedStart <= box.get_right(lastAcc)
                skipAcc := true
                
        if not skipAcc
            state := 1
            accTop := highest_h
            accBot := lowest_l
            accStartBar := bar_index - accLen + 1
            accBox := box.new(accStartBar, accTop, bar_index, accBot, border_color = color.new(colorAcc, 50), bgcolor = colorAcc)
            array.push(accBoxes, accBox)
            if alertAcc
                alert("AMD: Accumulation Phase Started", alert.freq_once_per_bar_close)
else if state == 1
    // Check if accumulation continues or breaks out
    if brk_high > accTop
        // Upward manipulation
        state := 2
        manDir := 1
        manStartBar := bar_index
        manTop := high
        manBot := accTop
        manBox := box.new(manStartBar, manTop, bar_index + 5, manBot, border_color = color.new(colorMan, 50), bgcolor = colorMan)
        manLabel := label.new(bar_index + 5, (manTop + manBot) / 2, "Manipulation", color = color.new(colorMan, 50), textcolor = lblTextColor, style = label.style_label_left, size = size.small)
        array.push(manBoxes, manBox)
        array.push(manLabels, manLabel)
        if alertMan
            alert("AMD: Bullish Manipulation Started", alert.freq_once_per_bar_close)
    else if brk_low < accBot
        // Downward manipulation
        state := 2
        manDir := -1
        manStartBar := bar_index
        manTop := accBot
        manBot := low
        manBox := box.new(manStartBar, manTop, bar_index + 5, manBot, border_color = color.new(colorMan, 50), bgcolor = colorMan)
        manLabel := label.new(bar_index + 5, (manTop + manBot) / 2, "Manipulation", color = color.new(colorMan, 50), textcolor = lblTextColor, style = label.style_label_left, size = size.small)
        array.push(manBoxes, manBox)
        array.push(manLabels, manLabel)
        if alertMan
            alert("AMD: Bearish Manipulation Started", alert.freq_once_per_bar_close)
    else
        // Accumulation continues
        accTop := math.max(accTop, highest_h)
        accBot := math.min(accBot, lowest_l)
        box.set_right(accBox, bar_index)
        box.set_top(accBox, accTop)
        box.set_bottom(accBox, accBot)

else if state == 2
    // Inside manipulation, looking for reversal to distribution
    box.set_right(manBox, bar_index + 5)
    label.set_x(manLabel, bar_index + 5)
    if manDir == 1
        manTop := math.max(manTop, high)
        box.set_top(manBox, manTop)
        label.set_y(manLabel, (manTop + manBot) / 2)
        if brk_low < accTop
            // Re-entered accumulation range -> Distribution Phase starts
            state := 3
            distStartBar := bar_index
    else
        manBot := math.min(manBot, low)
        box.set_bottom(manBox, manBot)
        label.set_y(manLabel, (manTop + manBot) / 2)
        if brk_high > accBot
            // Re-entered accumulation range -> Distribution Phase starts
            state := 3
            distStartBar := bar_index
            
    // Invalidate if manipulation takes too long without triggering distribution
    if state == 2 and bar_index - manStartBar > maxManBars
        state := 0
        box.delete(manBox)
        label.delete(manLabel)
        if array.size(manBoxes) > 0
            array.pop(manBoxes) // Remove the invalidated box from array
        if array.size(manLabels) > 0
            array.pop(manLabels) // Remove label from array

else if state == 3
    // Inside distribution
    // Reset condition to find new AMD cycle
    if bar_index - distStartBar > accLen
        state := 0

// Cleanup old AMD boxes
if array.size(accBoxes) > maxAmd
    bx = array.shift(accBoxes)
    box.delete(bx)
    
if array.size(manBoxes) > maxAmd
    bx = array.shift(manBoxes)
    box.delete(bx)
    lbl = array.shift(manLabels)
    label.delete(lbl)


// --- FVG Logic ---
atr = ta.atr(14)

type FVG
    box b
    bool isBull
    bool active
    float top
    float bot

var fvgArray = array.new<FVG>()

if showFvg or showIfvg
    // Detect FVG
    bullFvg = low > high[2] and (low - high[2]) > (atr * fvgMinAtr)
    bearFvg = high < low[2] and (low[2] - high) > (atr * fvgMinAtr)
    
    bool skipBull = false
    bool skipBear = false
    
    if filterOverlap and array.size(fvgArray) > 0
        for i = 0 to array.size(fvgArray) - 1
            f = array.get(fvgArray, i)
            if f.active
                if bullFvg and f.isBull
                    if low <= f.top and high[2] >= f.bot
                        skipBull := true
                if bearFvg and not f.isBull
                    if high >= f.bot and low[2] <= f.top
                        skipBear := true

    if bullFvg and not skipBull
        b = box.new(bar_index - 2, low, bar_index, high[2], border_color = showFvg ? color.new(colorFvgBull, 50) : na, bgcolor = showFvg ? colorFvgBull : na, text = showFvg ? "FVG" : "", text_color = textColor, text_halign = text.align_center, text_valign = text.align_center, text_size = size.small)
        array.push(fvgArray, FVG.new(b, true, true, low, high[2]))
        
    if bearFvg and not skipBear
        b = box.new(bar_index - 2, low[2], bar_index, high, border_color = showFvg ? color.new(colorFvgBear, 50) : na, bgcolor = showFvg ? colorFvgBear : na, text = showFvg ? "FVG" : "", text_color = textColor, text_halign = text.align_center, text_valign = text.align_center, text_size = size.small)
        array.push(fvgArray, FVG.new(b, false, true, low[2], high))
        
    // Manage array size
    if array.size(fvgArray) > maxFvgs
        removedFvg = array.shift(fvgArray)
        box.delete(removedFvg.b)
        
    // Update FVGs and check for invalidation (IFVG)
    if array.size(fvgArray) > 0
        for i = array.size(fvgArray) - 1 to 0
            f = array.get(fvgArray, i)
            if f.active
                box.set_right(f.b, bar_index + 5)
                
                // Check invalidation
                invalidated = false
                if f.isBull and close < f.bot
                    invalidated := true
                else if not f.isBull and close > f.top
                    invalidated := true
                    
                if invalidated
                    f.active := false
                    
                    bool skipIfvg = false
                    if filterOverlap
                        for j = 0 to array.size(fvgArray) - 1
                            if j != i
                                other = array.get(fvgArray, j)
                                if not other.active and other.isBull == f.isBull
                                    if f.bot <= other.top and f.top >= other.bot
                                        skipIfvg := true
                                        
                    if showIfvg and not skipIfvg
                        box.set_bgcolor(f.b, f.isBull ? colorIfvgBear : colorIfvgBull)
                        box.set_border_color(f.b, color.new(f.isBull ? colorIfvgBear : colorIfvgBull, 50))
                        box.set_text(f.b, "IFVG")
                    else
                        box.delete(f.b)
                        array.remove(fvgArray, i)
            else
                // It's an IFVG, keep extending if desired, or remove after some time
                if showIfvg
                    box.set_right(f.b, bar_index + 5)
                    
                    bool mitigated = false
                    if f.isBull and close > f.top
                        mitigated := true
                    else if not f.isBull and close < f.bot
                        mitigated := true
                        
                    if mitigated
                        box.delete(f.b)
                        array.remove(fvgArray, i)
