study("Cryptocurrency Strength", overlay=false, precision=2, max_bars_back=180)


// === INPUTS ===
BROKER = input(title = "Brokers", defval = "Binance")
fast= input(12, minval=1, maxval=50, title="TSI slow MA period")
slow=input(26, minval=2, maxval=100, title="TSI slow MA period")
src = input(ohlc4, title="Index Source")
int linewidth = input(title="Line Width", defval=3, minval=1)
labelStyle = label.style_label_left
show_labels = input(title="Labels", defval=true)
labelsize = input(title="Label Size", defval=size.small)


// === SERIES ===
float v01=security(BROKER + ":BTCUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v02=security(BROKER + ":ETHUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v03=security(BROKER + ":BNBUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v04=security(BROKER + ":DOTUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v05=security(BROKER + ":ADAUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v06=security(BROKER + ":UNIUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v07=security(BROKER + ":CHZUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v08=security(BROKER + ":MATICUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v09=security(BROKER + ":NEARUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v10=security(BROKER + ":SKLUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v11=security(BROKER + ":ANKRUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v12=security(BROKER + ":RUNEUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v13=security(BROKER + ":SOLUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v14=security(BROKER + ":ZILUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v15=security(BROKER + ":LUNAUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v16=security(BROKER + ":SFPUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v17=security(BROKER + ":SANDUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v18=security(BROKER + ":LITUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v19=security(BROKER + ":AXSUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v20=security(BROKER + ":LTCUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v21=security(BROKER + ":BCHUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v22=security(BROKER + ":MANAUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v23=security(BROKER + ":DOGEUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v24=security(BROKER + ":CAKEUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)
float v25=security(BROKER + ":BELUSDT", timeframe.period, src, barmerge.gaps_off, barmerge.lookahead_on)


// === SWITCHS === 
// true=ON, false=OFF
bool show_v01 = input(title="BTC", defval=true)
bool show_v02 = input(title="ETH", defval=false)
bool show_v03 = input(title="BNB", defval=true)
bool show_v04 = input(title="DOT", defval=false)
bool show_v05 = input(title="ADA", defval=true)
bool show_v06 = input(title="UNI", defval=false)
bool show_v07 = input(title="CHZ", defval=true)
bool show_v08 = input(title="MATIC", defval=true)
bool show_v09 = input(title="NEAR", defval=false)
bool show_v10 = input(title="SKL", defval=false)
bool show_v11 = input(title="ANKR", defval=true)
bool show_v12 = input(title="RUNE", defval=false)
bool show_v13 = input(title="SOL", defval=true)
bool show_v14 = input(title="ZIL", defval=false)
bool show_v15 = input(title="LUNA", defval=true)
bool show_v16 = input(title="SFP", defval=true)
bool show_v17 = input(title="SAND", defval=false)
bool show_v18 = input(title="LIT", defval=true)
bool show_v19 = input(title="AXS", defval=false)
bool show_v20 = input(title="LTC", defval=false)
bool show_v21 = input(title="BCH", defval=false)
bool show_v22 = input(title="MANA", defval=true)
bool show_v23 = input(title="DOGE", defval=false)
bool show_v24 = input(title="CAKE", defval=true)
bool show_v25 = input(title="BEL", defval=true)


// === COLOR ===
var color c_btc = input(title="Color BTC", defval=#ffc300, type = input.color)
var color c_eth = input(title="Color ETH", defval=#234dbc, type=input.color)
var color c_bnb = input(title="Color BNB", defval=#f2df1c, type=input.color)
var color c_dot = input(title="Color DOT", defval=#66541f, type=input.color)
var color c_ada = input(title="Color ADA", defval=#6ccbde, type=input.color)
var color c_uni = input(title="Color UNI", defval=#de6cde, type=input.color)
var color c_chz = input(title="Color CHZ", defval=#9b1515, type=input.color)
var color c_matic = input(title="Color MATIC", defval=#eee2e2, type=input.color)
var color c_near = input(title="Color NEAR", defval=#95a3a4, type=input.color)
var color c_skl = input(title="Color SKL", defval=#111111, type=input.color)
var color c_ankr = input(title="Color ANKR", defval=#58afcd, type=input.color)
var color c_rune = input(title="Color RUNE", defval=#2bf0f0, type=input.color)
var color c_sol = input(title="Color SOLL", defval=#26a69a, type=input.color)
var color c_zil = input(title="Color ZIL", defval=#95e645, type=input.color)
var color c_luna = input(title="Color LUNA", defval=#9245e6, type=input.color)
var color c_sfp = input(title="Color SFP", defval=#187fa1, type=input.color)
var color c_sand = input(title="Color SAND", defval=#ed537b, type=input.color)
var color c_lit = input(title="Color LIT", defval=#3bc1ed, type=input.color)
var color c_axs = input(title="Color AXS", defval=#a19820, type=input.color)
var color c_ltc = input(title="Color LTC", defval=#5c6970, type=input.color)
var color c_bch = input(title="Color BCH", defval=#21d65b, type=input.color)
var color c_mana = input(title="Color MANA", defval=#ed4A3b, type=input.color)
var color c_doge = input(title="Color DOGE", defval=#d67336, type=input.color)
var color c_cake = input(title="Color CAKE", defval=#21d65b, type=input.color)
var color c_bel = input(title="Color BEL", defval=#d67336, type=input.color)



// === TSI ===
btc = tsi(v01, fast, slow)
eth = tsi(v02, fast, slow)
bnb = tsi(v03, fast, slow)
dot = tsi(v04, fast, slow)
ada = tsi(v05, fast, slow)
uni = tsi(v06, fast, slow)
chz = tsi(v07, fast, slow)
matic = tsi(v08, fast, slow)
near = tsi(v09, fast, slow)
skl = tsi(v10, fast, slow)
ankr = tsi(v11, fast, slow)
rune = tsi(v12, fast, slow)
sol = tsi(v13, fast, slow)
zil = tsi(v14, fast, slow)
luna = tsi(v15, fast, slow)
sfp = tsi(v16, fast, slow)
sand = tsi(v17, fast, slow)
lit = tsi(v18, fast, slow)
axs = tsi(v19, fast, slow)
ltc = tsi(v20, fast, slow)
bch = tsi(v21, fast, slow)
mana = tsi(v22, fast, slow)
doge = tsi(v23, fast, slow)
cake = tsi(v24, fast, slow)
bel = tsi(v25, fast, slow)


// === PLOT ===
plot(iff(show_v01, btc, na), title="BTC", color=c_btc, linewidth=linewidth, editable=false)
plot(iff(show_v02, eth, na), title="ETH", color=c_eth, linewidth=linewidth, editable=false)
plot(iff(show_v03, bnb, na), title="BNB", color=c_bnb, linewidth=linewidth, editable=false)
plot(iff(show_v04, dot, na), title="DOT", color=c_dot, linewidth=linewidth, editable=false)
plot(iff(show_v05, ada, na), title="ADA", color=c_ada, linewidth=linewidth, editable=false)
plot(iff(show_v06, uni, na), title="UNI", color=c_uni, linewidth=linewidth, editable=false)
plot(iff(show_v07, chz, na), title="CHZ", color=c_chz, linewidth=linewidth, editable=false)
plot(iff(show_v08, matic, na), title="MATIC", color=c_matic, linewidth=linewidth, editable=false)
plot(iff(show_v09, near, na), title="NEAR", color=c_near, linewidth=linewidth, editable=false)
plot(iff(show_v10, skl, na), title="SKL", color=c_skl, linewidth=linewidth, editable=false)
plot(iff(show_v11, ankr, na), title="ANKR", color=c_ankr, linewidth=linewidth, editable=false)
plot(iff(show_v12, rune, na), title="RUNE", color=c_rune, linewidth=linewidth, editable=false)
plot(iff(show_v13, sol, na), title="SOL", color=c_sol, linewidth=linewidth, editable=false)
plot(iff(show_v14, zil, na), title="ZIL", color=c_zil, linewidth=linewidth, editable=false)
plot(iff(show_v15, luna, na), title="LUNA", color=c_luna, linewidth=linewidth, editable=false)
plot(iff(show_v16, sfp, na), title="SFP", color=c_sfp, linewidth=linewidth, editable=false)
plot(iff(show_v17, sand, na), title="SAND", color=c_sand, linewidth=linewidth, editable=false)
plot(iff(show_v18, lit, na), title="LIT", color=c_lit, linewidth=linewidth, editable=false)
plot(iff(show_v19, axs, na), title="AXS", color=c_axs, linewidth=linewidth, editable=false)
plot(iff(show_v20, ltc, na), title="LTC", color=c_ltc, linewidth=linewidth, editable=false)
plot(iff(show_v21, bch, na), title="BCH", color=c_bch, linewidth=linewidth, editable=false)
plot(iff(show_v22, mana, na), title="MANA", color=c_mana, linewidth=linewidth, editable=false)
plot(iff(show_v23, doge, na), title="DOGE", color=c_doge, linewidth=linewidth, editable=false)
plot(iff(show_v24, cake, na), title="CAKE", color=c_cake, linewidth=linewidth, editable=false)
plot(iff(show_v25, bel, na), title="BEL", color=c_bel, linewidth=linewidth, editable=false)



// === LABELS ===
if (show_labels)
    labelStyle := label.style_label_left

    if (show_v01)
        label BTC_LABEL = label.new(bar_index, btc, "BTC",color=c_btc, textcolor=color.white, style=labelStyle), label.delete(BTC_LABEL[1])
    if (show_v02)
        label ETH_LABEL = label.new(bar_index, eth, "ETH", color=c_eth, textcolor=color.white, style=labelStyle), label.delete(ETH_LABEL[1])
    if (show_v03)
        label BNB_LABEL = label.new(bar_index, bnb, "BNB", color=c_bnb, textcolor=color.black, style=labelStyle), label.delete(BNB_LABEL[1])
    if (show_v04)
        label DOT_LABEL = label.new(bar_index, dot, "DOT", color=c_dot, textcolor=color.white, style=labelStyle), label.delete(DOT_LABEL[1])
    if (show_v05)
        label ADA_LABEL = label.new(bar_index, ada, "ADA", color=c_ada, textcolor=color.white, style=labelStyle), label.delete(ADA_LABEL[1])
    if (show_v06)
        label UNI_LABEL = label.new(bar_index, uni, "UNI", color=c_uni, textcolor=color.white, style=labelStyle), label.delete(UNI_LABEL[1])
    if (show_v07)
        label CHZ_LABEL = label.new(bar_index, chz, "CHZ", color=c_chz, textcolor=color.white, style=labelStyle), label.delete(CHZ_LABEL[1])
    if (show_v08)
        label MATIC_LABEL = label.new(bar_index, matic, "MATIC", color=c_matic, textcolor=color.black, style=labelStyle), label.delete(MATIC_LABEL[1])
    if (show_v09)
        label NEAR_LABEL = label.new(bar_index, near, "NEAR", color=c_near, textcolor=color.white, style=labelStyle), label.delete(NEAR_LABEL[1])
    if (show_v10)
        label SKL_LABEL = label.new(bar_index, skl, "SKL", color=c_skl, textcolor=color.white, style=labelStyle), label.delete(SKL_LABEL[1])
    if (show_v11)
        label ANKR_LABEL = label.new(bar_index, ankr, "ANKR", color=c_ankr, textcolor=color.black, style=labelStyle), label.delete(ANKR_LABEL[1])
    if (show_v12)
        label RUNE_LABEL = label.new(bar_index, rune, "RUNE", color=c_rune, textcolor=color.white, style=labelStyle), label.delete(RUNE_LABEL[1])
    if (show_v13)
        label SOL_LABEL = label.new(bar_index, sol, "SOL", color=c_sol, textcolor=color.white, style=labelStyle), label.delete(SOL_LABEL[1])
    if (show_v14)
        label ZIL_LABEL = label.new(bar_index, zil, "ZIL", color=c_zil, textcolor=color.white, style=labelStyle), label.delete(ZIL_LABEL[1])
    if (show_v15)
        label LUNA_LABEL = label.new(bar_index, luna, "LUNA", color=c_luna, textcolor=color.white, style=labelStyle), label.delete(LUNA_LABEL[1])
    if (show_v16)
        label SFP_LABEL = label.new(bar_index, sfp, "SFP", color=c_sfp, textcolor=color.white, style=labelStyle), label.delete(SFP_LABEL[1])
    if (show_v17)
        label SAND_LABEL = label.new(bar_index, sand, "SAND", color=c_sand, textcolor=color.white, style=labelStyle), label.delete(SAND_LABEL[1])
    if (show_v18)
        label LIT_LABEL = label.new(bar_index, lit, "LIT", color=c_lit, textcolor=color.white, style=labelStyle), label.delete(LIT_LABEL[1])
    if (show_v19)
        label AXS_LABEL = label.new(bar_index, axs, "AXS", color=c_axs, textcolor=color.white, style=labelStyle), label.delete(AXS_LABEL[1])
    if (show_v20)
        label LTC_LABEL = label.new(bar_index, ltc, "LTC", color=c_ltc, textcolor=color.white, style=labelStyle), label.delete(LTC_LABEL[1])
    if (show_v21)
        label BCH_LABEL = label.new(bar_index, bch, "BCH", color=c_bch, textcolor=color.white, style=labelStyle), label.delete(BCH_LABEL[1])
    if (show_v22)
        label MANA_LABEL = label.new(bar_index, mana, "MANA", color=c_mana, textcolor=color.white, style=labelStyle), label.delete(MANA_LABEL[1])
    if (show_v23)
        label DOGE_LABEL = label.new(bar_index, doge, "DOGE", color=c_doge, textcolor=color.white, style=labelStyle), label.delete(DOGE_LABEL[1])
    if (show_v24)
        label CAKE_LABEL = label.new(bar_index, cake, "CAKE", color=c_cake, textcolor=color.black, style=labelStyle), label.delete(CAKE_LABEL[1])
    if (show_v25)
        label BEL_LABEL = label.new(bar_index, bel, "BEL", color=c_bel, textcolor=color.black, style=labelStyle), label.delete(BEL_LABEL[1])
       

// === LINE ===
hline(0,"Zero", color=#3c616e, linewidth=2)
hline(0.25,"Upper Line", color=#45454d, linewidth=1)
hline(-0.25,"Lower Line", color=#45454d, linewidth=1)