//@version=6
indicator("Multi-Pool Liquidity Confluence Scorer [MarkitTick]", overlay=true, max_lines_count=50, max_boxes_count=50, max_labels_count=50)

// =================================================================================================
// INPUT GROUPS
// =================================================================================================

string G_LEVELS  = "Liquidity Levels"
string G_SWEEP   = "Sweep Detection"
string G_SCORE   = "Confluence Scoring"
string G_SIGNAL  = "Signal & Trade"
string G_PREDICT = "Predictive Zones"
string G_VISUALS = "Visual Settings"
string G_DASH    = "Dashboard"

bool  inShowPDHL    = input.bool(true,  "Show Previous Day H/L (PDH/PDL)",    group=G_LEVELS)
bool  inShowPWHL    = input.bool(true,  "Show Previous Week H/L (PWH/PWL)",   group=G_LEVELS)
bool  inShowSwings  = input.bool(true,  "Show Swing Pivot Lines",             group=G_LEVELS)
int   inSwingLen    = input.int(5,      "Swing Detection Length", minval=2, maxval=20, group=G_LEVELS)
int   inSwingMemory = input.int(3,      "Swing Memory (How Many to Track)",   minval=1, maxval=5, group=G_LEVELS)

float inClusterPct  = input.float(0.25, "Cluster Range (ATR multiplier)", minval=0.05, maxval=2.0, step=0.05, group=G_SWEEP)
int   inCisdBars    = input.int(10,     "CISD Window (Bars After Sweep)",     minval=1,  maxval=30, group=G_SWEEP)
bool  inRequireMss  = input.bool(true,  "Require MSS Displacement", group=G_SWEEP)
float inMssFactor   = input.float(1.5,  "MSS Body Factor", minval=1.0, step=0.1, group=G_SWEEP)

int   inMinScore    = input.int(4, "Minimum Score to Generate Signal", minval=1, maxval=15, group=G_SCORE)
bool  inVolBonus    = input.bool(true,  "Volume Bonus (+2 pts when RVOL is high)",         group=G_SCORE)
int   inVolLen      = input.int(20,     "Volume SMA Length",          minval=1,             group=G_SCORE)
float inRvolThresh  = input.float(1.5,  "High-Volume RVOL Threshold", minval=1.0, step=0.1, group=G_SCORE)
bool  inSessBonus   = input.bool(true,  "Session Bonus (+1 pt during London / NY)",         group=G_SCORE)
bool  inFvgBonus    = input.bool(true,  "FVG Displacement Bonus (+1 pt)",                   group=G_SCORE)

float inRR1         = input.float(1.0, "Target 1 (R:R)", minval=0.5, step=0.5, group=G_SIGNAL)
float inRR2         = input.float(2.0, "Target 2 (R:R)", minval=1.0, step=0.5, group=G_SIGNAL)
float inRR3         = input.float(3.0, "Target 3 (R:R)", minval=1.5, step=0.5, group=G_SIGNAL)
bool  inShowSL      = input.bool(true,  "Show Stop Loss",  group=G_SIGNAL)
bool  inShowTP1     = input.bool(true,  "Show TP 1",       group=G_SIGNAL)
bool  inShowTP2     = input.bool(false, "Show TP 2",       group=G_SIGNAL)
bool  inShowTP3     = input.bool(false, "Show TP 3",       group=G_SIGNAL)
bool  inUseTrend    = input.bool(false, "Enable Trend Filter (EMA)",   group=G_SIGNAL)
int   inTrendLen    = input.int(200,    "Trend EMA Length", minval=1,   group=G_SIGNAL)
bool  inUseFvgEntry = input.bool(false, "Use FVG Limit Entry",          group=G_SIGNAL)
int   inMaxPos      = input.int(1,      "Max Position Boxes", minval=1, maxval=10, group=G_SIGNAL)

bool  inShowPredict = input.bool(true, "Show Predictive Target Zones", group=G_PREDICT)
int   inPredCount   = input.int(2,     "Zones to Show Above + Below", minval=1, maxval=4, group=G_PREDICT)

color colScore1     = input.color(color.new(#ffd54f, 0),  "Score 1-3 (Basic)",   group=G_VISUALS)
color colScore2     = input.color(color.new(#ff9800, 0),  "Score 4-6 (Good)",    group=G_VISUALS)
color colScore3     = input.color(color.new(#e91e63, 0),  "Score 7+ (Premium)",  group=G_VISUALS)
color colPDH        = input.color(color.new(#ff9800, 20), "PDH Line Color",      group=G_VISUALS)
color colPDL        = input.color(color.new(#2196f3, 20), "PDL Line Color",      group=G_VISUALS)
color colPWH        = input.color(color.new(#ff5722, 20), "PWH Line Color",      group=G_VISUALS)
color colPWL        = input.color(color.new(#00bcd4, 20), "PWL Line Color",      group=G_VISUALS)
color colSwing      = input.color(color.new(#9e9e9e, 40), "Swing Level Color",   group=G_VISUALS)
color colTP         = input.color(color.new(#00bcd4, 0),  "Target Color",        group=G_VISUALS)
color colSL         = input.color(color.new(#e91e63, 0),  "Stop Loss Color",     group=G_VISUALS)
color colDataTxt    = input.color(color.new(#9e9e9e, 0),  "Data Block Text",     group=G_VISUALS)

bool   inShowDash   = input.bool(true, "Show Score Dashboard", group=G_DASH)
string inDashPos    = input.string("Top Right", "Dashboard Position", options=["Top Right","Bottom Right","Top Left","Bottom Left"], group=G_DASH)

// =================================================================================================
// TYPE DEFINITIONS
// =================================================================================================

type PositionBox
    bool  active
    bool  isLong
    float entry
    float sl
    float tp1
    float tp2
    float tp3
    int   score
    box   riskBox
    line  lnEntry
    line  lnSL
    line  lnTP1
    line  lnTP2
    line  lnTP3
    label lbData
    label lbSignal

// =================================================================================================
// GLOBAL STATE
// =================================================================================================

var array<PositionBox> posBoxes   = array.new<PositionBox>()
var array<box>         predBoxes  = array.new<box>()
var array<label>       predLabels = array.new<label>()
var array<float>       swingHighs = array.new<float>()
var array<float>       swingLows  = array.new<float>()
var array<line>        swingLines = array.new<line>()

var table  dash   = na
var line   lnPDH  = na,  var line  lnPDL = na
var line   lnPWH  = na,  var line  lnPWL = na
var label  lbPDH  = na,  var label lbPDL = na
var label  lbPWH  = na,  var label lbPWL = na

var box    lastSweepBox   = na
var label  lastSweepLabel = na
var box    lastFvgBox     = na

var bool  buySweepOn   = false
var bool  sellSweepOn  = false
var int   sweepBarIdx  = na
var float sweepLevel   = na
var float sweepStopRef = na
var bool  fvgDrawn     = false

var int   lastBuyBar   = na
var int   lastSellBar  = na

// =================================================================================================
// CORE CALCULATIONS
// =================================================================================================

float atr        = ta.atr(14)
float avgVol     = ta.sma(volume, inVolLen)
float trendEma   = ta.ema(close, inTrendLen)
float bodySize   = math.abs(close - open)
float avgBody    = ta.sma(bodySize, 20)
bool  isBigBody  = bodySize > avgBody * inMssFactor
bool  hasBullFvg = low > high[2]
bool  hasBearFvg = high < low[2]
float cluster    = atr * inClusterPct

bool isLondon  = not na(time(timeframe.period, "0800-1600:1234567"))
bool isNY      = not na(time(timeframe.period, "1330-2200:1234567"))
bool isHighLiq = isLondon or isNY

[dHigh, dLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[wHigh, wLow] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)

float pdh = dHigh,  float pdl = dLow
float pwh = wHigh,  float pwl = wLow

bool pdhOk = not na(pdh),  bool pdlOk = not na(pdl)
bool pwhOk = not na(pwh),  bool pwlOk = not na(pwl)

float pivH = ta.pivothigh(high, inSwingLen, inSwingLen)
float pivL = ta.pivotlow(low,   inSwingLen, inSwingLen)

if not na(pivH)
    array.unshift(swingHighs, pivH)
    if array.size(swingHighs) > inSwingMemory
        array.pop(swingHighs)

if not na(pivL)
    array.unshift(swingLows, pivL)
    if array.size(swingLows) > inSwingMemory
        array.pop(swingLows)

float lastSH = array.size(swingHighs) > 0 ? array.get(swingHighs, 0) : na
float lastSL = array.size(swingLows)  > 0 ? array.get(swingLows,  0) : na

bool bullCisd = not na(lastSH) and close > lastSH and close[1] <= lastSH
bool bearCisd = not na(lastSL) and close < lastSL and close[1] >= lastSL

// =================================================================================================
// HELPER FUNCTIONS
// =================================================================================================

f_scoreColor(int s) =>
    s >= 7 ? colScore3 : s >= 4 ? colScore2 : colScore1

f_scoreStars(int s) =>
    s >= 7 ? "PREMIUM" : s >= 4 ? "GOOD" : "BASIC"

f_dashPos() =>
    switch inDashPos
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        =>                position.top_right

cleanup_pos(PositionBox p) =>
    box.delete(p.riskBox)
    line.delete(p.lnEntry)
    line.delete(p.lnSL)
    line.delete(p.lnTP1)
    line.delete(p.lnTP2)
    line.delete(p.lnTP3)
    label.delete(p.lbData)
    label.delete(p.lbSignal)

f_calcScore(float targetPrice, bool sweepIsHigh) =>
    int s = 0
    if pwhOk and math.abs(targetPrice - pwh) <= cluster
        s += 3
    if pwlOk and math.abs(targetPrice - pwl) <= cluster
        s += 3
    if pdhOk and math.abs(targetPrice - pdh) <= cluster
        s += 2
    if pdlOk and math.abs(targetPrice - pdl) <= cluster
        s += 2

    int shSz = array.size(swingHighs)
    if shSz > 0
        for i = 0 to shSz - 1
            float sh = array.get(swingHighs, i)
            if not na(sh) and math.abs(targetPrice - sh) <= cluster
                s += 1

    int slSz = array.size(swingLows)
    if slSz > 0
        for i = 0 to slSz - 1
            float sl_v = array.get(swingLows, i)
            if not na(sl_v) and math.abs(targetPrice - sl_v) <= cluster
                s += 1

    if inVolBonus and not na(avgVol) and avgVol > 0
        if volume / avgVol >= inRvolThresh
            s += 2
    if inSessBonus and isHighLiq
        s += 1
    if inFvgBonus
        if sweepIsHigh and hasBearFvg
            s += 1
        if not sweepIsHigh and hasBullFvg
            s += 1
    s

// =================================================================================================
// DRAW STATIC REFERENCE LEVELS (De-collision & Data Binding Architecture)
// =================================================================================================

bool dChange = timeframe.change("D")
bool wChange = timeframe.change("W")

bool eqH = pwhOk and pdhOk and math.abs(pwh - pdh) <= (syminfo.mintick * 0.5)
bool eqL = pwlOk and pdlOk and math.abs(pwl - pdl) <= (syminfo.mintick * 0.5)

if wChange and inShowPWHL
    line.delete(lnPWH), label.delete(lbPWH)
    line.delete(lnPWL), label.delete(lbPWL)
    if pwhOk
        string tH = (eqH and inShowPDHL) ? "PWH / PDH" : "PWH"
        lnPWH := line.new(bar_index, pwh, bar_index + 1, pwh, color=colPWH, width=2, style=line.style_solid, extend=extend.right)
        lbPWH := label.new(bar_index, pwh, tH + "\n" + str.tostring(pwh, format.mintick), style=label.style_label_right, color=color.new(colPWH, 80), textcolor=color.white, size=size.normal)
    if pwlOk
        string tL = (eqL and inShowPDHL) ? "PWL / PDL" : "PWL"
        lnPWL := line.new(bar_index, pwl, bar_index + 1, pwl, color=colPWL, width=2, style=line.style_solid, extend=extend.right)
        lbPWL := label.new(bar_index, pwl, tL + "\n" + str.tostring(pwl, format.mintick), style=label.style_label_right, color=color.new(colPWL, 80), textcolor=color.white, size=size.normal)

if dChange and inShowPDHL
    line.delete(lnPDH), label.delete(lbPDH)
    line.delete(lnPDL), label.delete(lbPDL)
    if pdhOk
        if eqH and inShowPWHL
            if not na(lbPWH)
                label.set_text(lbPWH, "PWH / PDH\n" + str.tostring(pwh, format.mintick))
        else
            if not na(lbPWH) and not wChange
                label.set_text(lbPWH, "PWH\n" + str.tostring(pwh, format.mintick))
            lnPDH := line.new(bar_index, pdh, bar_index + 1, pdh, color=colPDH, width=1, style=line.style_dashed, extend=extend.right)
            lbPDH := label.new(bar_index, pdh, "PDH\n" + str.tostring(pdh, format.mintick), style=label.style_label_right, color=color.new(colPDH, 80), textcolor=color.white, size=size.normal)
    if pdlOk
        if eqL and inShowPWHL
            if not na(lbPWL)
                label.set_text(lbPWL, "PWL / PDL\n" + str.tostring(pwl, format.mintick))
        else
            if not na(lbPWL) and not wChange
                label.set_text(lbPWL, "PWL\n" + str.tostring(pwl, format.mintick))
            lnPDL := line.new(bar_index, pdl, bar_index + 1, pdl, color=colPDL, width=1, style=line.style_dashed, extend=extend.right)
            lbPDL := label.new(bar_index, pdl, "PDL\n" + str.tostring(pdl, format.mintick), style=label.style_label_right, color=color.new(colPDL, 80), textcolor=color.white, size=size.normal)

if inShowSwings and not na(pivH)
    line swL = line.new(bar_index - inSwingLen, pivH, bar_index + 5, pivH, color=colSwing, width=1, style=line.style_dotted)
    array.push(swingLines, swL)
    if array.size(swingLines) > inSwingMemory * 2
        line.delete(array.shift(swingLines))

if inShowSwings and not na(pivL)
    line swL = line.new(bar_index - inSwingLen, pivL, bar_index + 5, pivL, color=colSwing, width=1, style=line.style_dotted)
    array.push(swingLines, swL)
    if array.size(swingLines) > inSwingMemory * 2
        line.delete(array.shift(swingLines))

// =================================================================================================
// SWEEP DETECTION (Left-Anchored Architecture, Bottom Edge)
// =================================================================================================

float sweepedLevel_buy  = pwhOk and high > pwh and close < pwh ? pwh : pdhOk and high > pdh and close < pdh ? pdh : na
float sweepedLevel_sell = pwlOk and low < pwl and close > pwl ? pwl : pdlOk and low < pdl and close > pdl ? pdl : na

bool newBuySweep  = not na(sweepedLevel_buy)
bool newSellSweep = not na(sweepedLevel_sell)

if newBuySweep and not buySweepOn
    int    sc = f_calcScore(sweepedLevel_buy, true)
    color  zc = f_scoreColor(sc)

    buySweepOn   := true
    sellSweepOn  := false
    sweepBarIdx  := bar_index
    sweepLevel   := sweepedLevel_buy
    sweepStopRef := high
    fvgDrawn     := false
    
    if not na(lastSweepBox)
        box.delete(lastSweepBox)
    if not na(lastSweepLabel)
        label.delete(lastSweepLabel)

    lastSweepBox   := box.new(sweepBarIdx - 1, high, sweepBarIdx + 1, sweepedLevel_buy, border_color=color.new(zc, 50), border_style=line.style_dashed, bgcolor=color.new(zc, 85))
    lastSweepLabel := label.new(sweepBarIdx - 1, sweepedLevel_buy, "Buy Sweep\nScore: " + str.tostring(sc), style=label.style_label_right, color=color.new(zc, 85), textcolor=color.white, size=size.small)

if newSellSweep and not sellSweepOn
    int    sc = f_calcScore(sweepedLevel_sell, false)
    color  zc = f_scoreColor(sc)

    sellSweepOn  := true
    buySweepOn   := false
    sweepBarIdx  := bar_index
    sweepLevel   := sweepedLevel_sell
    sweepStopRef := low
    fvgDrawn     := false
    
    if not na(lastSweepBox)
        box.delete(lastSweepBox)
    if not na(lastSweepLabel)
        label.delete(lastSweepLabel)

    lastSweepBox   := box.new(sweepBarIdx - 1, sweepedLevel_sell, sweepBarIdx + 1, low, border_color=color.new(zc, 50), border_style=line.style_dashed, bgcolor=color.new(zc, 85))
    lastSweepLabel := label.new(sweepBarIdx - 1, low, "Sell Sweep\nScore: " + str.tostring(sc), style=label.style_label_right, color=color.new(zc, 85), textcolor=color.white, size=size.small)

bool sweepActive = buySweepOn or sellSweepOn
if sweepActive and not na(sweepBarIdx)
    if not na(lastSweepBox)
        box.set_right(lastSweepBox, bar_index + 1)
        
    if bar_index - sweepBarIdx > inCisdBars * 2
        buySweepOn  := false
        sellSweepOn := false
        if not na(lastSweepBox)
            box.delete(lastSweepBox)
        if not na(lastSweepLabel)
            label.delete(lastSweepLabel)
        if not na(lastFvgBox)
            box.delete(lastFvgBox)

// =================================================================================================
// CISD (Change In State of Delivery) CONFIRMATION
// =================================================================================================

bool cisd_buy_ok  = false
bool cisd_sell_ok = false

if buySweepOn and not na(sweepBarIdx)
    int bars = bar_index - sweepBarIdx
    if bars > 0 and bars <= inCisdBars
        if not fvgDrawn and hasBearFvg
            if not na(lastFvgBox)
                box.delete(lastFvgBox)
            lastFvgBox := box.new(bar_index - 2, low[2], bar_index + 2, high, border_color=na, bgcolor=color.new(color.yellow, 82))
            fvgDrawn := true
        if bearCisd and (not inRequireMss or isBigBody or hasBearFvg)
            cisd_sell_ok := true

if sellSweepOn and not na(sweepBarIdx)
    int bars = bar_index - sweepBarIdx
    if bars > 0 and bars <= inCisdBars
        if not fvgDrawn and hasBullFvg
            if not na(lastFvgBox)
                box.delete(lastFvgBox)
            lastFvgBox := box.new(bar_index - 2, high[2], bar_index + 2, low, border_color=na, bgcolor=color.new(color.yellow, 82))
            fvgDrawn := true
        if bullCisd and (not inRequireMss or isBigBody or hasBullFvg)
            cisd_buy_ok := true

// =================================================================================================
// FINAL SIGNAL VALIDATION
// =================================================================================================

int scoreBuy  = sellSweepOn and not na(sweepLevel) ? f_calcScore(sweepLevel, false) : 0
int scoreSell = buySweepOn  and not na(sweepLevel) ? f_calcScore(sweepLevel, true)  : 0

bool trendBuy  = not inUseTrend or close > trendEma
bool trendSell = not inUseTrend or close < trendEma

bool rawBuy  = cisd_buy_ok  and scoreBuy  >= inMinScore and trendBuy
bool rawSell = cisd_sell_ok and scoreSell >= inMinScore and trendSell

bool validBuy  = rawBuy  and barstate.isconfirmed and (na(lastBuyBar)  or bar_index > lastBuyBar  + 5)
bool validSell = rawSell and barstate.isconfirmed and (na(lastSellBar) or bar_index > lastSellBar + 5)

// =================================================================================================
// SIGNAL EXECUTION — BUY
// =================================================================================================

if validBuy
    float entry = close
    bool  ok    = true

    if inUseFvgEntry
        if low > high[2]
            entry := high[2]
        else
            ok := false

    if ok
        float sl   = sweepStopRef
        float risk = math.abs(entry - sl)

        if risk > 0
            float tp1 = entry + risk * inRR1
            float tp2 = entry + risk * inRR2
            float tp3 = entry + risk * inRR3

            color sc = f_scoreColor(scoreBuy)
            label sig = label.new(bar_index, low - atr * 0.7, "BUY\n" + f_scoreStars(scoreBuy), style=label.style_label_up, color=sc, textcolor=color.white, size=size.normal)

            line lnE  = line.new(bar_index, entry, bar_index+1, entry, color=color.gray,  width=2, extend=extend.right)
            line lnS  = inShowSL  ? line.new(bar_index, sl,  bar_index+1, sl,  color=colSL, width=1, extend=extend.right) : na
            line lnT1 = inShowTP1 ? line.new(bar_index, tp1, bar_index+1, tp1, color=colTP, style=line.style_dashed, extend=extend.right) : na
            line lnT2 = inShowTP2 ? line.new(bar_index, tp2, bar_index+1, tp2, color=colTP, style=line.style_dashed, extend=extend.right) : na
            line lnT3 = inShowTP3 ? line.new(bar_index, tp3, bar_index+1, tp3, color=colTP, style=line.style_dashed, extend=extend.right) : na

            string posText = "Long Executed\n"
            posText += "E:   " + str.tostring(entry, format.mintick) + "\n"
            if inShowSL
                posText += "SL:  " + str.tostring(sl, format.mintick) + "\n"
            if inShowTP1
                posText += "TP1: " + str.tostring(tp1, format.mintick) + "\n"
            if inShowTP2
                posText += "TP2: " + str.tostring(tp2, format.mintick) + "\n"
            if inShowTP3
                posText += "TP3: " + str.tostring(tp3, format.mintick)
                
            label lbData = label.new(bar_index + 3, entry, posText, style=label.style_label_left, color=color.new(sc, 90), textcolor=colDataTxt, text_font_family=font.family_monospace, textalign=text.align_left)

            box rb = box.new(bar_index, sl, bar_index+30, entry, border_color=na, bgcolor=color.new(colSL, 90))
            PositionBox np = PositionBox.new(true, true, entry, sl, tp1, tp2, tp3, scoreBuy, rb, lnE, lnS, lnT1, lnT2, lnT3, lbData, sig)

            if array.size(posBoxes) >= inMaxPos
                cleanup_pos(array.shift(posBoxes))
            array.push(posBoxes, np)

            lastBuyBar  := bar_index
            sellSweepOn := false
            
            if not na(lastSweepBox)
                box.delete(lastSweepBox)
            if not na(lastSweepLabel)
                label.delete(lastSweepLabel)
            if not na(lastFvgBox)
                box.delete(lastFvgBox)

            string alertMsg = '{"action": "BUY", "Entry Price": "' + str.tostring(entry, format.mintick) + '", "Take Profit": "' + str.tostring(tp1, format.mintick) + '", "Stop Loss": "' + str.tostring(sl, format.mintick) + '"}'
            alert(alertMsg, alert.freq_once_per_bar_close)

// =================================================================================================
// SIGNAL EXECUTION — SELL
// =================================================================================================

if validSell
    float entry = close
    bool  ok    = true

    if inUseFvgEntry
        if high < low[2]
            entry := low[2]
        else
            ok := false

    if ok
        float sl   = sweepStopRef
        float risk = math.abs(sl - entry)

        if risk > 0
            float tp1 = entry - risk * inRR1
            float tp2 = entry - risk * inRR2
            float tp3 = entry - risk * inRR3

            color sc = f_scoreColor(scoreSell)
            label sig = label.new(bar_index, high + atr * 0.7, "SELL\n" + f_scoreStars(scoreSell), style=label.style_label_down, color=sc, textcolor=color.white, size=size.normal)

            line lnE  = line.new(bar_index, entry, bar_index+1, entry, color=color.gray,  width=2, extend=extend.right)
            line lnS  = inShowSL  ? line.new(bar_index, sl,  bar_index+1, sl,  color=colSL, width=1, extend=extend.right) : na
            line lnT1 = inShowTP1 ? line.new(bar_index, tp1, bar_index+1, tp1, color=colTP, style=line.style_dashed, extend=extend.right) : na
            line lnT2 = inShowTP2 ? line.new(bar_index, tp2, bar_index+1, tp2, color=colTP, style=line.style_dashed, extend=extend.right) : na
            line lnT3 = inShowTP3 ? line.new(bar_index, tp3, bar_index+1, tp3, color=colTP, style=line.style_dashed, extend=extend.right) : na

            string posText = "Short Executed\n"
            posText += "E:   " + str.tostring(entry, format.mintick) + "\n"
            if inShowSL
                posText += "SL:  " + str.tostring(sl, format.mintick) + "\n"
            if inShowTP1
                posText += "TP1: " + str.tostring(tp1, format.mintick) + "\n"
            if inShowTP2
                posText += "TP2: " + str.tostring(tp2, format.mintick) + "\n"
            if inShowTP3
                posText += "TP3: " + str.tostring(tp3, format.mintick)
                
            label lbData = label.new(bar_index + 3, entry, posText, style=label.style_label_left, color=color.new(sc, 90), textcolor=colDataTxt, text_font_family=font.family_monospace, textalign=text.align_left)

            box rb = box.new(bar_index, entry, bar_index+30, sl, border_color=na, bgcolor=color.new(colSL, 90))
            PositionBox np = PositionBox.new(true, false, entry, sl, tp1, tp2, tp3, scoreSell, rb, lnE, lnS, lnT1, lnT2, lnT3, lbData, sig)

            if array.size(posBoxes) >= inMaxPos
                cleanup_pos(array.shift(posBoxes))
            array.push(posBoxes, np)

            lastSellBar := bar_index
            buySweepOn  := false
            
            if not na(lastSweepBox)
                box.delete(lastSweepBox)
            if not na(lastSweepLabel)
                label.delete(lastSweepLabel)
            if not na(lastFvgBox)
                box.delete(lastFvgBox)

            string alertMsg = '{"action": "SELL", "Entry Price": "' + str.tostring(entry, format.mintick) + '", "Take Profit": "' + str.tostring(tp1, format.mintick) + '", "Stop Loss": "' + str.tostring(sl, format.mintick) + '"}'
            alert(alertMsg, alert.freq_once_per_bar_close)

// =================================================================================================
// ACTIVE TRADE MANAGEMENT
// =================================================================================================

int pSz = array.size(posBoxes)
if pSz > 0
    for i = pSz - 1 to 0
        PositionBox pos = array.get(posBoxes, i)

        bool hitSL = pos.isLong ? close < pos.sl : close > pos.sl
        bool hitTP = pos.isLong ? high >= pos.tp3 : low <= pos.tp3

        if hitSL
            cleanup_pos(pos)
            array.remove(posBoxes, i)
        else if hitTP and pos.active
            line.set_extend(pos.lnEntry, extend.none)
            if not na(pos.lnSL)  
                line.set_extend(pos.lnSL,  extend.none)
            if not na(pos.lnTP1) 
                line.set_extend(pos.lnTP1, extend.none)
            if not na(pos.lnTP2) 
                line.set_extend(pos.lnTP2, extend.none)
            if not na(pos.lnTP3) 
                line.set_extend(pos.lnTP3, extend.none)
            pos.active := false
            array.set(posBoxes, i, pos)

// =================================================================================================
// PREDICTIVE ZONES (Price Injection Architecture)
// =================================================================================================

if inShowPredict and barstate.islast
    int psz = array.size(predBoxes)
    if psz > 0
        for i = 0 to psz - 1
            box.delete(array.get(predBoxes, i))
    array.clear(predBoxes)
    
    int lsz = array.size(predLabels)
    if lsz > 0
        for i = 0 to lsz - 1
            label.delete(array.get(predLabels, i))
    array.clear(predLabels)

    array<float> above = array.new<float>()
    array<float> below = array.new<float>()

    if pdhOk
        if pdh > close
            array.push(above, pdh)
        else
            array.push(below, pdh)

    if pdlOk
        if pdl > close
            array.push(above, pdl)
        else
            array.push(below, pdl)

    if pwhOk and pwh > close
        array.push(above, pwh)

    if pwlOk and pwl < close
        array.push(below, pwl)

    int shSz2 = array.size(swingHighs)
    if shSz2 > 0
        for i = 0 to shSz2 - 1
            float v = array.get(swingHighs, i)
            if not na(v) and v > close
                array.push(above, v)

    int slSz2 = array.size(swingLows)
    if slSz2 > 0
        for i = 0 to slSz2 - 1
            float v = array.get(swingLows, i)
            if not na(v) and v < close
                array.push(below, v)

    if array.size(above) > 0
        array.sort(above, order.ascending)
        int n = math.min(inPredCount, array.size(above))
        float lastLvl = na
        for i = 0 to n - 1
            float lv = array.get(above, i)
            if na(lastLvl) or math.abs(lv - lastLvl) > (atr * 0.2)
                int    est = f_calcScore(lv, true)
                color  pc  = f_scoreColor(est)
                string px  = str.tostring(lv, format.mintick)
                string txt = "Zone: " + f_scoreStars(est) + " | Score: " + str.tostring(est)
                
                // Text inside the box showing the exact price
                box pb = box.new(bar_index + 4, lv + cluster * 0.55, bar_index + 8, lv - cluster * 0.55, border_color=pc, border_width=1, bgcolor=color.new(pc, 78), text=px, text_color=color.white, text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
                array.push(predBoxes, pb)
                
                // Pointing Label Outside the Box showing the metadata
                label pl = label.new(bar_index + 8, lv, txt, style=label.style_label_left, color=color.new(pc, 85), textcolor=color.white, size=size.small)
                array.push(predLabels, pl)
                
                lastLvl := lv

    if array.size(below) > 0
        array.sort(below, order.descending)
        int n = math.min(inPredCount, array.size(below))
        float lastLvl = na
        for i = 0 to n - 1
            float lv = array.get(below, i)
            if na(lastLvl) or math.abs(lv - lastLvl) > (atr * 0.2)
                int    est = f_calcScore(lv, false)
                color  pc  = f_scoreColor(est)
                string px  = str.tostring(lv, format.mintick)
                string txt = "Zone: " + f_scoreStars(est) + " | Score: " + str.tostring(est)
                
                // Text inside the box showing the exact price
                box pb = box.new(bar_index + 4, lv + cluster * 0.55, bar_index + 8, lv - cluster * 0.55, border_color=pc, border_width=1, bgcolor=color.new(pc, 78), text=px, text_color=color.white, text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
                array.push(predBoxes, pb)
                
                // Pointing Label Outside the Box showing the metadata
                label pl = label.new(bar_index + 8, lv, txt, style=label.style_label_left, color=color.new(pc, 85), textcolor=color.white, size=size.small)
                array.push(predLabels, pl)
                
                lastLvl := lv

// =================================================================================================
// SCORE DASHBOARD
// =================================================================================================

int liveScore = 0
if sweepActive and not na(sweepLevel)
    liveScore := f_calcScore(sweepLevel, buySweepOn)

if inShowDash and barstate.islast
    if na(dash)
        dash := table.new(f_dashPos(), 3, 10, bgcolor=color.new(color.black, 42), border_color=color.new(color.white, 55), border_width=1, frame_color=color.white, frame_width=1)

    table.cell(dash, 0, 0, "MPL SCORER",  text_color=color.white, bgcolor=color.new(#0d47a1, 10), text_size=size.normal)
    table.cell(dash, 1, 0, "Level",       text_color=color.white, bgcolor=color.new(#0d47a1, 10), text_size=size.normal)
    table.cell(dash, 2, 0, "Status",      text_color=color.white, bgcolor=color.new(#0d47a1, 10), text_size=size.normal)

    bool pdhSwept = pdhOk and high > pdh and close < pdh
    bool pdlSwept = pdlOk and low < pdl  and close > pdl
    bool pwhSwept = pwhOk and high > pwh and close < pwh
    bool pwlSwept = pwlOk and low < pwl  and close > pwl

    table.cell(dash, 0, 1, "PDH", text_color=color.new(colPDH, 0), text_size=size.normal)
    table.cell(dash, 1, 1, pdhOk ? str.tostring(pdh, format.mintick) : "N/A", text_color=color.white, text_size=size.normal)
    table.cell(dash, 2, 1, pdhSwept ? "Swept" : "Intact", text_color=pdhSwept ? color.red : color.green, text_size=size.normal)

    table.cell(dash, 0, 2, "PDL", text_color=color.new(colPDL, 0), text_size=size.normal)
    table.cell(dash, 1, 2, pdlOk ? str.tostring(pdl, format.mintick) : "N/A", text_color=color.white, text_size=size.normal)
    table.cell(dash, 2, 2, pdlSwept ? "Swept" : "Intact", text_color=pdlSwept ? color.red : color.green, text_size=size.normal)

    table.cell(dash, 0, 3, "PWH", text_color=color.new(colPWH, 0), text_size=size.normal)
    table.cell(dash, 1, 3, pwhOk ? str.tostring(pwh, format.mintick) : "N/A", text_color=color.white, text_size=size.normal)
    table.cell(dash, 2, 3, pwhSwept ? "Swept" : "Intact", text_color=pwhSwept ? color.red : color.green, text_size=size.normal)

    table.cell(dash, 0, 4, "PWL", text_color=color.new(colPWL, 0), text_size=size.normal)
    table.cell(dash, 1, 4, pwlOk ? str.tostring(pwl, format.mintick) : "N/A", text_color=color.white, text_size=size.normal)
    table.cell(dash, 2, 4, pwlSwept ? "Swept" : "Intact", text_color=pwlSwept ? color.red : color.green, text_size=size.normal)

    string sweepTxt = buySweepOn ? "Buy-Side Active" : sellSweepOn ? "Sell-Side Active" : "None"
    color  sweepCol = buySweepOn ? color.red : sellSweepOn ? color.green : color.gray
    table.cell(dash, 0, 5, "Sweep",  text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 5, sweepTxt, text_color=sweepCol,    text_size=size.normal)
    table.cell(dash, 2, 5, sweepActive and not na(sweepBarIdx) ? str.tostring(bar_index - sweepBarIdx) + " bars ago" : "-", text_color=color.gray, text_size=size.normal)

    color lsc = liveScore > 0 ? f_scoreColor(liveScore) : color.gray

    table.cell(dash, 0, 6, "Live Score", text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 6, liveScore > 0 ? str.tostring(liveScore) + " / 10+" : "-", text_color=lsc, bgcolor=color.new(lsc, 60), text_size=size.normal)
    table.cell(dash, 2, 6, liveScore > 0 ? f_scoreStars(liveScore) : "Waiting...", text_color=lsc, text_size=size.normal)

    bool threshOk = liveScore >= inMinScore and liveScore > 0
    table.cell(dash, 0, 7, "Threshold",   text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 7, "Min: " + str.tostring(inMinScore), text_color=color.gray, text_size=size.normal)
    table.cell(dash, 2, 7, threshOk ? "READY" : "Not Met", text_color=threshOk ? color.green : color.red, text_size=size.normal)

    string sesTxt = isNY ? "New York" : isLondon ? "London" : "Other"
    table.cell(dash, 0, 8, "Session",  text_color=color.white,   text_size=size.normal)
    table.cell(dash, 1, 8, sesTxt,     text_color=color.yellow,  text_size=size.normal)
    table.cell(dash, 2, 8, isHighLiq ? "High Liq" : "Low Liq", text_color=isHighLiq ? color.green : color.gray, text_size=size.normal)

    bool aboveTrend = close > trendEma
    table.cell(dash, 0, 9, "Trend EMA", text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 9, inUseTrend ? (aboveTrend ? "BULL" : "BEAR") : "OFF", text_color=inUseTrend ? (aboveTrend ? color.green : color.red) : color.gray, text_size=size.normal)
    table.cell(dash, 2, 9, inUseTrend ? str.tostring(trendEma, format.mintick) : "Disabled", text_color=color.gray, text_size=size.normal)
