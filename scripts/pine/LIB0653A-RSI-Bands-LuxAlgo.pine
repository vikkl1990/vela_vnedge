//@version=6
indicator("RSI Bands", shorttitle = "RSI Bands", overlay = true, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MID_LEVEL = 50.0 // RSI midline solved into price, the de facto trend divider

BEARISH_COLOR = #f23645
BULLISH_COLOR = #089981
NEUTRAL_COLOR = #787b86 // the RSI 50 midline - structure, not a side

FILL_BAND_TRANSP = 80  // gradient transparency at the band extremities
FILL_MID_TRANSP  = 100 // gradient transparency at the band average (midline)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "RSI Length", minval = 2
  , group   = "Settings"
  , tooltip = "Lookback of Wilder's RSI that the bands invert. The same smoothed gain and loss averages drive both the oscillator and the solved price levels, so the bands always agree with a standard RSI of this length. Longer lookbacks give smoother, slower bands. 14 is Wilder's published default.")

srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Series the RSI is computed on and the space the bands are solved in. With the default close, a close landing exactly on a band coincides with RSI printing the matching threshold. Because the algebra only needs the input series, the inversion also works for other sources, solving for that series' value instead.")

obLevelInput = input.float(70, "Overbought Level", minval = 50, maxval = 99, step = 1
  , group   = "Settings"
  , tooltip = "RSI level solved into price for the upper band - the exact price at which this bar's RSI would print the level. 70 is the classic overbought threshold, 80 gives a stricter band. In strong uptrends price can ride this band for extended stretches, exactly as raw RSI can stay pinned overbought.")

osLevelInput = input.float(30, "Oversold Level", minval = 1, maxval = 50, step = 1
  , group   = "Settings"
  , tooltip = "RSI level solved into price for the lower band - the exact price at which this bar's RSI would print the level. 30 is the classic oversold threshold, 20 gives a stricter band. In an uptrend, tags of this band mark pullbacks deep enough to push RSI to oversold.")

showMidInput = input.bool(true, "RSI 50 Midline"
  , group   = "Settings"
  , tooltip = "Plots the price at which RSI would print exactly 50, a de facto trend divider - price holding above the midline keeps RSI in its bullish half, price holding below it keeps RSI in its bearish half.")

upperColorInput = input.color(BEARISH_COLOR, "Upper Band"
  , group   = "Style"
  , tooltip = "Color of the upper (overbought) band, of its gradient fill and of its optional tag marker.")

lowerColorInput = input.color(BULLISH_COLOR, "Lower Band"
  , group   = "Style"
  , tooltip = "Color of the lower (oversold) band, of its gradient fill and of its optional tag marker.")

midColorInput = input.color(NEUTRAL_COLOR, "Midline"
  , group   = "Style"
  , tooltip = "Color of the RSI 50 midline.")

gradientInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between the midline and each band, fully transparent at the midline and strongest at the band. The shaded span is the ground price would have to cover before RSI reaches an extreme - wide bands mean a large move is needed, tight bands mean a small push tips RSI into one.")

showMarkersInput = input.bool(false, "Band Tag Markers"
  , group   = "Style"
  , tooltip = "Displays a small circle on a band at the moment price crosses beyond it, which is by construction the moment RSI reaches the matching threshold. Off by default to keep the chart clean - the band alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// @function            Solves Wilder's RSI formula backward for price (Siligardos' 'Reverse Engineering RSI', TASC 2003,
//                      plotted as an envelope in Bertrand's 'RSI Bands', TASC 2008). Because Wilder's smoothing is
//                      recursive, the averages entering the current bar are already known, leaving the source value as
//                      the only unknown - RSI = level can then be solved with exact algebra, not an estimate.
// @param smoothedGain  (float) Wilder-smoothed average gain entering the current bar
// @param smoothedLoss  (float) Wilder-smoothed average loss entering the current bar
// @param previousSrc   (float) source value of the previous bar
// @param length        (int)   RSI lookback used by the smoothing
// @param level         (float) target RSI level, exclusive 0-100 range
// @returns             (float) source value at which this bar's RSI would print exactly `level`
reverseRsi(float smoothedGain, float smoothedLoss, float previousSrc, int length, float level) =>
    // ratio of average gain to average loss that makes RSI equal the target level
    targetRs = level / (100 - level)
    // required advance if positive: the next averages become ((length-1)*gain + delta)/length and (length-1)*loss/length,
    // so delta is the exact up-move making their ratio equal targetRs; a negative delta belongs on the down-day branch,
    // where the move loads the loss average instead and the algebra rescales by targetRs
    delta = (length - 1) * (smoothedLoss * targetRs - smoothedGain)
    na(delta) ? float(na) : delta >= 0 ? previousSrc + delta : previousSrc + delta / targetRs

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Wilder's smoothed gain and loss averages - the same RMA state that drives a standard RSI
srcChange = ta.change(srcInput)
avgGain   = ta.rma(math.max(srcChange, 0), lengthInput)
avgLoss   = ta.rma(math.max(-srcChange, 0), lengthInput)

// Each band re-solves RSI = level for price bar by bar from the previous bar's state, so the bands drift with the
// smoothed gain-loss balance rather than sitting at fixed offsets from price like a percentage envelope
upperBand = reverseRsi(avgGain[1], avgLoss[1], srcInput[1], lengthInput, obLevelInput)
lowerBand = reverseRsi(avgGain[1], avgLoss[1], srcInput[1], lengthInput, osLevelInput)
midBand   = reverseRsi(avgGain[1], avgLoss[1], srcInput[1], lengthInput, MID_LEVEL)

// Band events - the source reaching a band is, by construction, RSI reaching the matching threshold
crossAboveUpper = ta.crossover(srcInput, upperBand)
crossBelowUpper = ta.crossunder(srcInput, upperBand)
crossBelowLower = ta.crossunder(srcInput, lowerBand)
crossAboveLower = ta.crossover(srcInput, lowerBand)
crossAboveMid   = ta.crossover(srcInput, midBand)
crossBelowMid   = ta.crossunder(srcInput, midBand)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
upperPlotId = plot(upperBand, "Upper Band", color = upperColorInput, linewidth = 1)
lowerPlotId = plot(lowerBand, "Lower Band", color = lowerColorInput, linewidth = 1)
midPlotId   = plot(midBand, "RSI 50 Midline", color = showMidInput ? midColorInput : na, linewidth = 1)

fill(midPlotId, upperPlotId
  , top_value    = upperBand
  , bottom_value = midBand
  , top_color    = gradientInput ? color.new(upperColorInput, FILL_BAND_TRANSP) : na
  , bottom_color = gradientInput ? color.new(upperColorInput, FILL_MID_TRANSP) : na
  , title        = "Upper Band Gradient Fill")

fill(midPlotId, lowerPlotId
  , top_value    = midBand
  , bottom_value = lowerBand
  , top_color    = gradientInput ? color.new(lowerColorInput, FILL_MID_TRANSP) : na
  , bottom_color = gradientInput ? color.new(lowerColorInput, FILL_BAND_TRANSP) : na
  , title        = "Lower Band Gradient Fill")

plotshape(showMarkersInput and crossAboveUpper ? upperBand : na, "Overbought Tag", style = shape.circle, location = location.absolute, color = upperColorInput, size = size.tiny)
plotshape(showMarkersInput and crossBelowLower ? lowerBand : na, "Oversold Tag", style = shape.circle, location = location.absolute, color = lowerColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossAboveUpper, "Overbought Band Tagged", "RSI Bands: price crossed above the upper band on {{ticker}} - RSI is at/above its overbought threshold ({{interval}})")
alertcondition(crossBelowUpper, "Overbought Band Released", "RSI Bands: price crossed back below the upper band on {{ticker}} - RSI left its overbought threshold ({{interval}})")
alertcondition(crossBelowLower, "Oversold Band Tagged", "RSI Bands: price crossed below the lower band on {{ticker}} - RSI is at/below its oversold threshold ({{interval}})")
alertcondition(crossAboveLower, "Oversold Band Released", "RSI Bands: price crossed back above the lower band on {{ticker}} - RSI left its oversold threshold ({{interval}})")
alertcondition(crossAboveMid, "Bullish Midline Cross", "RSI Bands: price crossed above the RSI 50 midline on {{ticker}} - momentum tilted bullish ({{interval}})")
alertcondition(crossBelowMid, "Bearish Midline Cross", "RSI Bands: price crossed below the RSI 50 midline on {{ticker}} - momentum tilted bearish ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
