//@version=5
indicator("Thrax - QuickStrike 5-Mins Scalping", overlay=true)

// Inputs for Candle Highlighting
threshold = input.float(0.5, title="Price Change Threshold (%)", minval=0.0)
zoneThreshold = input.float(1.0, title="Percentage Change for Zones (%)", minval=0.0)
breakThreshold = input.float(0.1, title="Break Threshold for Zones (%)", minval=0.0)
upper_retracementLevel = input.float(25.0, title="Buy Zone Retracement Level (%)", minval=0.0)
lower_retracementLevel = input.float(75.0, title="Sell Zone Retracement Level (%)", minval=0.0)

// Time range for 10:30 AM to 2:30 PM
startHour = 10
startMinute = 30
endHour = 14
endMinute = 30

// Current time in hours and minutes
currentHour = hour
currentMinute = minute

// Calculate price change percentage
priceChange = (math.abs(close - open) / open) * 100

// Check if the current candle is within the time range (10:30 AM to 2:30 PM)
inTimeRange = (currentHour == startHour and currentMinute >= startMinute) or 
              (currentHour > startHour and currentHour < endHour) or 
              (currentHour == endHour and currentMinute <= endMinute)

// Determine if the price change exceeds the thresholds
priceChangeExceeds = priceChange > threshold
priceChangeForZone = priceChange > zoneThreshold

// Determine if the candle is bullish or bearish
isBullish = close > open
isBearish = close < open

// Arrays to store support and resistance boxes and lines
var box[] supportBoxes = array.new_box()
var line[] supportLineTops = array.new_line()
var line[] supportLineBottoms = array.new_line()
var box[] resistanceBoxes = array.new_box()
var line[] resistanceLineTops = array.new_line()
var line[] resistanceLineBottoms = array.new_line()
var box[] innerSupportBox = array.new_box()
var box[] innerResistanceBox = array.new_box()

// Check for overlap before adding a new zone
var bool overlap = false

// Create support zone if bullish candle exceeds zoneThreshold
if priceChangeForZone and isBullish and inTimeRange
    overlap := false
    if array.size(supportBoxes) > 0
        for i = 0 to array.size(supportBoxes) - 1
            existingSupportBox = array.get(supportBoxes, i)
            if open >= box.get_bottom(existingSupportBox) and close <= box.get_top(existingSupportBox)
                overlap := true
                break
    if not overlap
        // Create the support zone box for shading
        newSupportBox = box.new(left=bar_index, bottom=open, right=bar_index + 100, top=close, border_color=color.new(color.blue, 0), bgcolor=color.new(color.blue, 90))
        array.push(supportBoxes, newSupportBox)
        
        // Draw the top and bottom lines of the support zone
        newSupportLineTop = line.new(x1=bar_index, y1=close, x2=bar_index + 100, y2=close, color=color.blue, width=3)
        newSupportLineBottom = line.new(x1=bar_index, y1=open, x2=bar_index + 100, y2=open, color=color.blue, width=3)
        // Create inner support zone covering the bottom X%
        newInnerSupportBox = box.new(left=bar_index, bottom=open, right=bar_index + 100, top=open + (close - open) * (upper_retracementLevel / 100), border_color=color.new(color.white, 0), border_style=line.style_dashed, bgcolor=color.new(color.blue, 100))
        array.push(innerSupportBox, newInnerSupportBox)
        array.push(supportLineTops, newSupportLineTop)
        array.push(supportLineBottoms, newSupportLineBottom)

// Create resistance zone if bearish candle exceeds zoneThreshold
if priceChangeForZone and isBearish and inTimeRange
    overlap := false
    if array.size(resistanceBoxes) > 0
        for i = 0 to array.size(resistanceBoxes) - 1
            existingResistanceBox = array.get(resistanceBoxes, i)
            if close >= box.get_bottom(existingResistanceBox) and open <= box.get_top(existingResistanceBox)
                overlap := true
                break
    if not overlap
        // Create the resistance zone box for shading
        newResistanceBox = box.new(left=bar_index, bottom=close, right=bar_index + 100, top=open, border_color=color.new(color.red, 0), bgcolor=color.new(color.red, 90))
        array.push(resistanceBoxes, newResistanceBox)
        
        // Draw the top and bottom lines of the resistance zone
        newResistanceLineTop = line.new(x1=bar_index, y1=open, x2=bar_index + 100, y2=open, color=color.red, width=3)
        newResistanceLineBottom = line.new(x1=bar_index, y1=close, x2=bar_index + 100, y2=close, color=color.red, width=3)
        // Create inner resistance zone covering the top Y%
        newInnerResistanceBox = box.new(left=bar_index, bottom=close + (open - close) * (lower_retracementLevel / 100), right=bar_index + 100, top=open, border_color=color.new(color.white, 0), border_style=line.style_dashed, bgcolor=color.new(color.red, 100))
        array.push(innerResistanceBox, newInnerResistanceBox)
        array.push(resistanceLineTops, newResistanceLineTop)
        array.push(resistanceLineBottoms, newResistanceLineBottom)

// Remove support zones if price breaks below by breakThreshold
if array.size(supportBoxes) > 0
    for i = array.size(supportBoxes) - 1 to 0
        currentSupportBox = array.get(supportBoxes, i)
        innerS = array.get(innerSupportBox, i)
        if close < box.get_bottom(currentSupportBox) * (1 - breakThreshold / 100)
            box.delete(currentSupportBox)
            box.delete(innerS)
            line.delete(array.get(supportLineTops, i))
            line.delete(array.get(supportLineBottoms, i))
            array.remove(supportBoxes, i)
            array.remove(supportLineTops, i)
            array.remove(supportLineBottoms, i)
            array.remove(innerSupportBox, i)

// Remove resistance zones if price breaks above by breakThreshold
if array.size(resistanceBoxes) > 0
    for i = array.size(resistanceBoxes) - 1 to 0
        currentResistanceBox = array.get(resistanceBoxes, i)
        innerR = array.get(innerResistanceBox, i)
        if close > box.get_top(currentResistanceBox) * (1 + breakThreshold / 100)
            box.delete(currentResistanceBox)
            box.delete(innerR)
            line.delete(array.get(resistanceLineTops, i))
            line.delete(array.get(resistanceLineBottoms, i))
            array.remove(resistanceBoxes, i)
            array.remove(resistanceLineTops, i)
            array.remove(resistanceLineBottoms, i)
            array.remove(innerResistanceBox, i)

// Enhanced Candle Highlighting
bgcolor(inTimeRange and priceChangeExceeds and isBullish ? color.new(color.blue, 80) : na, title="Bullish Highlight")
bgcolor(inTimeRange and priceChangeExceeds and isBearish ? color.new(color.yellow, 80) : na, title="Bearish Highlight")
plotshape(series=inTimeRange and priceChangeExceeds and isBullish, title="Bullish Candle", location=location.belowbar, color=color.blue, style=shape.triangleup, size=size.small)
plotshape(series=inTimeRange and priceChangeExceeds and isBearish, title="Bearish Candle", location=location.abovebar, color=color.yellow, style=shape.triangledown, size=size.small)

// Bar Coloring
barcolor(inTimeRange and priceChangeExceeds and isBullish ? color.blue : na) 
barcolor(inTimeRange and priceChangeExceeds and isBearish ? color.yellow : na)
