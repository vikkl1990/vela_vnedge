//@version=6
indicator("Trend Intensity Index"
  , shorttitle = "Trend Intensity Index"
  , overlay    = false
  , format     = format.price
  , precision  = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

float MID_LEVEL   = 50.0  // Neutral reading: deviations balanced on both sides of the average
float UPPER_BOUND = 100.0 // Reading when every recent deviation landed above the average
float LOWER_BOUND = 0.0   // Reading when every recent deviation landed below the average

int FULL_TRANSP = 100
int HALF_TRANSP = 50
int BG_TRANSP   = 90

string METHOD_MAGNITUDES = "Deviation Magnitudes"
string METHOD_COUNT      = "Bar Count"

string GROUP_OSC    = "Oscillator"
string GROUP_LEVELS = "Levels"
string GROUP_STYLE  = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

sourceInput = input.source(close, "Source"
  , group   = GROUP_OSC
  , tooltip = "Price series measured against its own moving average. Pee's original specification uses the close.")

maLengthInput = input.int(60, "MA Length"
  , minval  = 2
  , maxval  = 500
  , group   = GROUP_OSC
  , tooltip = "Number of bars in the simple moving average that deviations are measured against. M.H. Pee's original specification uses a 60-bar average.")

windowInput = input.int(30, "Deviation Window"
  , minval  = 1
  , maxval  = 500
  , group   = GROUP_OSC
  , tooltip = "Number of recent bars whose deviations from the average are accumulated, conventionally half the moving average length (30 for the original 60-bar average). Shorter pairs such as 30/15 react faster at the cost of more false regime flips.")

methodInput = input.string(METHOD_MAGNITUDES, "Method"
  , options = [METHOD_MAGNITUDES, METHOD_COUNT]
  , group   = GROUP_OSC
  , tooltip = "'Deviation Magnitudes' sums the size of the deviations on each side of the average (the original design), so a market hugging its average from above grades as trending even when individual bars are small. 'Bar Count' counts bars above and below the average instead; readings differ modestly but the interpretation is the same.")

upperLevelInput = input.float(80, "Upper Level"
  , minval  = 50
  , maxval  = 100
  , step    = 1
  , group   = GROUP_LEVELS
  , tooltip = "Readings above this level are commonly treated as an established uptrend, gating a trend system to the long side. The 80/20 levels are conventions, not optimized values.")

lowerLevelInput = input.float(20, "Lower Level"
  , minval  = 0
  , maxval  = 50
  , step    = 1
  , group   = GROUP_LEVELS
  , tooltip = "Readings below this level are commonly treated as an established downtrend, gating a trend system to the short side. The 80/20 levels are conventions, not optimized values.")

regimeBgInput = input.bool(false, "Established Trend Background"
  , group   = GROUP_STYLE
  , tooltip = "Tints the pane background while the reading holds beyond a trend level, marking the stretches graded as an established trend. Extreme readings signal persistence, not exhaustion.")

showCrossMarkersInput = input.bool(false, "Midline Cross Markers"
  , group   = GROUP_STYLE
  , tooltip = "Shows circles on the midline where the dominant side of the average flips. The alerts cover these events even when markers are hidden.")

bullColorInput = input.color(#089981, "Bullish Color", group = GROUP_STYLE)

bearColorInput = input.color(#f23645, "Bearish Color", group = GROUP_STYLE)

levelsColorInput = input.color(#787b86, "Levels Color", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{

// Deviation of the source from its own simple moving average
float maValue   = ta.sma(sourceInput, maLengthInput)
float deviation = sourceInput - maValue

// Deviations split by sign, preserving na through the average warmup so no early reading is fabricated
float upMagnitude    = na(deviation) ? na : deviation > 0 ? deviation : 0.0
float downMagnitude  = na(deviation) ? na : deviation < 0 ? -deviation : 0.0
float upOccurrence   = na(deviation) ? na : deviation > 0 ? 1.0 : 0.0
float downOccurrence = na(deviation) ? na : deviation < 0 ? 1.0 : 0.0

// Both accumulation variants run every bar; the method input only selects between them
float upMagnitudeSum   = math.sum(upMagnitude, windowInput)
float downMagnitudeSum = math.sum(downMagnitude, windowInput)
float upCountSum       = math.sum(upOccurrence, windowInput)
float downCountSum     = math.sum(downOccurrence, windowInput)

bool useMagnitudes = methodInput == METHOD_MAGNITUDES

float upsideSum   = useMagnitudes ? upMagnitudeSum : upCountSum
float downsideSum = useMagnitudes ? downMagnitudeSum : downCountSum
float totalSum    = upsideSum + downsideSum

// Trend Intensity Index: upside share of recent deviations, 0 to 100; a window with no deviations reads neutral
float tii = na(totalSum) ? na : totalSum > 0 ? 100 * upsideSum / totalSum : MID_LEVEL

// Midline crosses: the dominant side of the average flips
bool bullMidCross = ta.crossover(tii, MID_LEVEL)
bool bearMidCross = ta.crossunder(tii, MID_LEVEL)

// Established-trend transitions around the upper/lower levels
bool uptrendStart   = ta.crossover(tii, upperLevelInput)
bool downtrendStart = ta.crossunder(tii, lowerLevelInput)
bool uptrendFade    = ta.crossunder(tii, upperLevelInput)
bool downtrendFade  = ta.crossover(tii, lowerLevelInput)

// Current regime grading
bool establishedUptrend   = tii > upperLevelInput
bool establishedDowntrend = tii < lowerLevelInput

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

color oscColor = tii > MID_LEVEL ? bullColorInput : bearColorInput

oscPlotId = plot(tii, "Trend Intensity Index", oscColor, 1)
midPlotId = plot(MID_LEVEL, "Midline Anchor", editable = false, display = display.none)

fill(oscPlotId, midPlotId
  , top_value    = math.max(tii, MID_LEVEL)
  , bottom_value = math.min(tii, MID_LEVEL)
  , top_color    = tii > MID_LEVEL ? color.new(bullColorInput, HALF_TRANSP) : color.new(bearColorInput, FULL_TRANSP)
  , bottom_color = tii > MID_LEVEL ? color.new(bullColorInput, FULL_TRANSP) : color.new(bearColorInput, HALF_TRANSP)
  , title        = "Gradient Fill")

hline(UPPER_BOUND, "Upper Bound", levelsColorInput, hline.style_dotted)
hline(upperLevelInput, "Upper Level", levelsColorInput, hline.style_dashed)
hline(MID_LEVEL, "Midline", levelsColorInput, hline.style_dotted)
hline(lowerLevelInput, "Lower Level", levelsColorInput, hline.style_dashed)
hline(LOWER_BOUND, "Lower Bound", levelsColorInput, hline.style_dotted)

bgcolor(regimeBgInput and establishedUptrend ? color.new(bullColorInput, BG_TRANSP)
  : regimeBgInput and establishedDowntrend   ? color.new(bearColorInput, BG_TRANSP)
  : na
  , title = "Established Trend Background")

plot(showCrossMarkersInput and bullMidCross ? MID_LEVEL : na, "Bullish Midline Cross", bullColorInput, 3, plot.style_circles)
plot(showCrossMarkersInput and bearMidCross ? MID_LEVEL : na, "Bearish Midline Cross", bearColorInput, 3, plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(uptrendStart, "Established Uptrend", "Trend Intensity Index crossed above its upper level on {{ticker}} ({{interval}})")
alertcondition(downtrendStart, "Established Downtrend", "Trend Intensity Index crossed below its lower level on {{ticker}} ({{interval}})")
alertcondition(bullMidCross, "Bullish Midline Cross", "Trend Intensity Index crossed above 50 on {{ticker}} ({{interval}})")
alertcondition(bearMidCross, "Bearish Midline Cross", "Trend Intensity Index crossed below 50 on {{ticker}} ({{interval}})")
alertcondition(uptrendFade, "Uptrend Intensity Fading", "Trend Intensity Index rolled back below its upper level on {{ticker}} ({{interval}})")
alertcondition(downtrendFade, "Downtrend Intensity Fading", "Trend Intensity Index recovered above its lower level on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
