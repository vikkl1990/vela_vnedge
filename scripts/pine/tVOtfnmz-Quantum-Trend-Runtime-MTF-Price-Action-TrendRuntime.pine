        bgcolor = C_PANEL,
        text_size = size.tiny
    )

    table.cell(
        dashboard,
        4,
        9,
        "MTF",
        text_color = C_NEUTRAL,
        bgcolor = C_PANEL,
        text_size = size.tiny
    )

    table.cell(
        dashboard,
        5,
        9,
        chartTimeframeSupported ? "CONFIRMED" : "WARNING",
        text_color = chartTimeframeSupported ? C_CYAN : C_VIOLET,
        bgcolor = C_PANEL,
        text_size = size.tiny
    )

//------------------------------------------------------------------------------
// Hide Dashboard
//------------------------------------------------------------------------------
if barstate.islast and not showDashboard
    table.clear(
        dashboard,
        0,
        0,
        5,
        9
    )

//------------------------------------------------------------------------------
// Alerts
//------------------------------------------------------------------------------
alertcondition(
    newLongOpportunity,
    "QTR Long Opportunity",
    "QTR LONG OPPORTUNITY | {{ticker}} | price={{close}}"
)

alertcondition(
    newShortOpportunity,
    "QTR Short Opportunity",
    "QTR SHORT OPPORTUNITY | {{ticker}} | price={{close}}"
)

alertcondition(
    newLongOpportunity and setupQuality >= 70.0,
    "QTR High-Quality Long",
    "QTR HIGH-QUALITY LONG OPPORTUNITY | {{ticker}} | price={{close}}"
)

alertcondition(
    newShortOpportunity and setupQuality >= 70.0,
    "QTR High-Quality Short",
    "QTR HIGH-QUALITY SHORT OPPORTUNITY | {{ticker}} | price={{close}}"
)

alertcondition(
    quietMarket and not quietMarket[1],
    "QTR Quiet Market",
    "QTR QUIET MARKET | {{ticker}} | Consider scanning another market."
)