//@version=6
indicator("Probabilistic Breakout Forecaster [LuxAlgo]", "LuxAlgo - Probabilistic Breakout Forecaster", overlay = false)

//---------------------------------------------------------------------------------------------------------------------}
// CONSTANTS
//---------------------------------------------------------------------------------------------------------------------{
color BULL_COLOR      = #089981
color BEAR_COLOR      = #f23645
color NEUTRAL_COLOR   = #787b86

string GROUP_CALC     = "Calculation Settings"
string GROUP_VIS      = "Visualization"
string DASHBOARD_GROUP = 'Dashboard'

// Dashboard Constants
color DATA            = #DBDBDB
color HEADERS         = #808080
color BACKGROUND      = #161616
color BORDERS         = #2E2E2E

string TOP_RIGHT      = 'Top Right'
string BOTTOM_RIGHT   = 'Bottom Right'
string BOTTOM_LEFT    = 'Bottom LEFT'

string TINY           = 'Tiny'
string SMALL          = 'Small'
string NORMAL         = 'Normal'
string LARGE          = 'Large'
string HUGE           = 'Huge'

//---------------------------------------------------------------------------------------------------------------------}
// INPUTS
//---------------------------------------------------------------------------------------------------------------------{
// Calculation Inputs
int   lengthInput      = input.int(20, "Range Length", minval = 5, group = GROUP_CALC, tooltip = "Lookback period to define the consolidation range (High/Low).")
int   horizonInput     = input.int(10, "Forecast Horizon (Bars)", minval = 1, group = GROUP_CALC, tooltip = "The number of bars into the future for which the breakout probability is calculated.")
float volLookbackInput = input.int(50, "Volatility Lookback", minval = 10, group = GROUP_CALC, tooltip = "Period used to calculate the standard deviation for the probability model.")

// Visualization Inputs
color bullColorInput   = input.color(BULL_COLOR, "Bullish Color", group = GROUP_VIS, inline = "colors")
color bearColorInput   = input.color(BEAR_COLOR, "Bearish Color", group = GROUP_VIS, inline = "colors")
int   transparencyInput= input.int(70, "Fill Transparency", minval = 0, maxval = 100, group = GROUP_VIS)

// Dashboard Inputs
bool   dashboardInput         = input.bool(true, 'Enable Dashboard', group = DASHBOARD_GROUP)
string dashboardPositionInput = input.string(TOP_RIGHT, 'Position', group = DASHBOARD_GROUP, options = [TOP_RIGHT, BOTTOM_RIGHT, BOTTOM_LEFT])
string dashboardSizeInput     = input.string(SMALL, 'Size', group = DASHBOARD_GROUP, options = [TINY, SMALL, NORMAL, LARGE, HUGE])

//---------------------------------------------------------------------------------------------------------------------}
// USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
// Normal Cumulative Distribution Function (CDF) approximation
// Based on the Abramowitz and Stegun approximation
nCdf(float x) =>
    float t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    float d = 0.3989423 * math.exp(-x * x / 2.0)
    float p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.7814779 + t * (-1.821256 + t * 1.3302744))))
    x > 0 ? 1.0 - p : p

// Table Helper Functions
var parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT       => position.top_right
    BOTTOM_RIGHT    => position.bottom_right
    BOTTOM_LEFT     => position.bottom_left

var parsedDashboardSize     = switch dashboardSizeInput
    TINY            => size.tiny
    SMALL           => size.small
    NORMAL          => size.normal
    LARGE           => size.large
    HUGE            => size.huge

cell(table t_able, int column, int row, string data, color = #FFFFFF, align = text.align_right, color background = na, float height = 0) => 
    t_able.cell(column, row, data, text_color = color, text_size = parsedDashboardSize, text_halign = align, bgcolor = background, height = height)

divider(table t_able, int row, int lastColumn) =>    
    string rowDivider = '━━━━━━━━━━━━━━'
    t_able.merge_cells(0, row, lastColumn, row)
    cell(t_able, 0, row, rowDivider, align = text.align_center, height = 0.5, color = BORDERS)

//---------------------------------------------------------------------------------------------------------------------}
// CALCULATIONS
//---------------------------------------------------------------------------------------------------------------------{
// Range Boundaries
float upperRange = ta.highest(high, lengthInput)
float lowerRange = ta.lowest(low, lengthInput)

// Volatility (Standard Deviation of log returns for better statistical accuracy)
float logReturns = math.log(close / nz(close[1], close))
float sigma      = ta.stdev(logReturns, int(volLookbackInput))

// Forecasting Logic
// We calculate the probability that the price will exceed the upper or lower boundary
// within the specified horizon T.
// Using a simple random walk model: Price_T = Price_0 * exp(sigma * sqrt(T) * Z)
// Z = (ln(Target / Price_0)) / (sigma * sqrt(T))

float horizonSqrt = math.sqrt(horizonInput)
float denominator = sigma * horizonSqrt

// Probabilities
float bullProb = 0.0
float bearProb = 0.0

if denominator > 0
    float zUpper = math.log(upperRange / close) / denominator
    float zLower = math.log(lowerRange / close) / denominator
    
    // P(Price_T > Upper) = 1 - CDF(zUpper)
    bullProb := (1.0 - nCdf(zUpper)) * 100
    // P(Price_T < Lower) = CDF(zLower)
    bearProb := nCdf(zLower) * 100

// Volatility Squeeze Factor
// Compares current volatility to historical average to indicate breakout potential
float currentAtr = ta.atr(14)
float avgAtr     = ta.sma(currentAtr, 100)
float squeeze    = math.max(0, 1 - currentAtr / avgAtr) * 100

//---------------------------------------------------------------------------------------------------------------------}
// VISUALIZATION
//---------------------------------------------------------------------------------------------------------------------{
// Probability Plots
pBull = plot(bullProb, "Bullish Breakout Probability", color = bullColorInput, linewidth = 2)
pBear = plot(-bearProb, "Bearish Breakout Probability", color = bearColorInput, linewidth = 2)
plot0 = plot(0, display = display.none, editable = false)

// Zero Line and Thresholds
hline(0, "Zero Line", color = NEUTRAL_COLOR, linestyle = hline.style_dotted)
hline(50, "High Probability Upper", color = color.new(bullColorInput, 50), linestyle = hline.style_dashed)
hline(-50, "High Probability Lower", color = color.new(bearColorInput, 50), linestyle = hline.style_dashed)

// Fills
fill(pBull, plot0, bullProb, 0, color.new(bullColorInput, transparencyInput), color.new(bullColorInput, 100), "Bullish Fill")
fill(pBear, plot0, 0, -bearProb, color.new(bearColorInput, 100), color.new(bearColorInput, transparencyInput), "Bearish Fill")

// DC Fill
upperDc = plot(upperRange, "Upper Range", color(na), force_overlay = true)
lowerDc = plot(lowerRange, "Lower Range", color(na), force_overlay = true)
fill(upperDc, lowerDc, top_value = upperRange, bottom_value = lowerRange, top_color = color.new(bullColorInput, transparencyInput), bottom_color = color.new(bearColorInput, transparencyInput))

// Dashboard Logic
var table t_able = table.new(parsedDashboardPosition, 2, 7, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1, force_overlay = true)

if dashboardInput and barstate.islast
    t_able.merge_cells(0, 0, 1, 0)
    cell(t_able, 0, 0, 'Breakout Forecast', color = DATA, align = text.align_center)
    
    divider(t_able, 1, 1)
    
    cell(t_able, 0, 2, 'Bullish Prob.', color = HEADERS, align = text.align_left)
    cell(t_able, 1, 2, str.format("{0,number,#.##}%", bullProb), color = bullProb > 50 ? bullColorInput : DATA)
    
    cell(t_able, 0, 3, 'Bearish Prob.', color = HEADERS, align = text.align_left)
    cell(t_able, 1, 3, str.format("{0,number,#.##}%", bearProb), color = bearProb > 50 ? bearColorInput : DATA)
    
    divider(t_able, 4, 1)
    
    cell(t_able, 0, 5, 'Squeeze Intensity', color = HEADERS, align = text.align_left)
    cell(t_able, 1, 5, str.format("{0,number,#.##}%", squeeze), color = squeeze > 50 ? color.orange : DATA)
    
    cell(t_able, 0, 6, 'Horizon', color = HEADERS, align = text.align_left)
    cell(t_able, 1, 6, str.tostring(horizonInput) + " Bars", color = DATA)

//---------------------------------------------------------------------------------------------------------------------}
