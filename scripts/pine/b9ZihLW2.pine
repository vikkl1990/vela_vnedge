//@version=6
indicator("ATK/DEF — Temporal Equilibrium Hierarchy", overlay=true)

// ================= Inputs =================
n    = input.int(20, "LMA Period", minval=2)
mode = input.string("TR", "Volatility Definition", options=["TR", "HL", "RET"])

// ================= Single LMA + slope =================
lma_func() =>
    tr  = ta.tr(true)
    hl  = high - low
    ret = math.abs(close - close[1])
    vol = switch mode
        "TR"  => tr
        "HL"  => hl
        "RET" => ret
        => tr
    liq = vol * volume
    lma = ta.sma(close * liq, n) / ta.sma(liq, n)
    slp = lma - lma[1]
    [lma, slp]

// ================= Multi-Timeframe LMA + slope =================
[lmaW, slopeW] = request.security(syminfo.tickerid, "W",   lma_func(), lookahead=barmerge.lookahead_off)
[lmaD, slopeD] = request.security(syminfo.tickerid, "D",   lma_func(), lookahead=barmerge.lookahead_off)
[lma4, slope4] = request.security(syminfo.tickerid, "240", lma_func(), lookahead=barmerge.lookahead_off)
[lma1, slope1] = request.security(syminfo.tickerid, "60",  lma_func(), lookahead=barmerge.lookahead_off)

// ================= Plot =================
plot(lmaW, "Weekly LMA", color=color.new(color.red, 0),    linewidth=2)
plot(lmaD, "Daily LMA",  color=color.new(color.orange, 0), linewidth=2)
plot(lma4, "4H LMA",     color=color.new(color.blue, 0),   linewidth=2)
plot(lma1, "1H LMA",     color=color.new(color.green, 0),  linewidth=2)

// ================= All Calculations Based on LMA =================

// ---- 1. Direction ----
dirTxt(s) => s > 0 ? "Up" : s < 0 ? "Down" : "Flat"

// ---- 2. Structure ----
structTxt(p, l) => p > l ? "Above" : p < l ? "Below" : "At"

// ---- 3. Turn ----
turnTxt(s) => s > 0 and s[1] <= 0 ? "Turn Up" : s < 0 and s[1] >= 0 ? "Turn Down" : "None"

turnW = turnTxt(slopeW)
turnD = turnTxt(slopeD)
turn4 = turnTxt(slope4)
turn1 = turnTxt(slope1)

// ---- 4. Pressure: relative position of the four LMAs ----
p1_4 = lma1 < lma4 ? "1H below 4H" : lma1 > lma4 ? "1H above 4H" : "1H=4H"
p4_D = lma4 < lmaD ? "4H below D"  : lma4 > lmaD ? "4H above D"  : "4H=D"
pD_W = lmaD < lmaW ? "D below W"   : lmaD > lmaW ? "D above W"   : "D=W"

fullBear = lma1 < lma4 and lma4 < lmaD and lmaD < lmaW
fullBull = lma1 > lma4 and lma4 > lmaD and lmaD > lmaW
partBear = lma1 < lma4 or lma4 < lmaD or lmaD < lmaW
partBull = lma1 > lma4 or lma4 > lmaD or lmaD > lmaW

pressTxt = fullBear ? "Full Bearish Pressure ✅" : fullBull ? "Full Bullish Support ✅" : partBear ? "Partial Bearish Pressure ✅" : partBull ? "Partial Bullish Support ✅" : "None"

// ---- 5. Compression: convergence of the four LMAs ----
lmaMax = math.max(math.max(lmaW, lmaD), math.max(lma4, lma1))
lmaMin = math.min(math.min(lmaW, lmaD), math.min(lma4, lma1))
lmaAvg = (lmaW + lmaD + lma4 + lma1) / 4
spread = (lmaMax - lmaMin) / lmaAvg

compressTxt = spread < 0.005 ? "Compression ✅" : spread > 0.02 ? "Expansion" : "Neutral"

// ---- 6. Push Validation ----
bullPush  = close > lma1 and slope1 > 0
bearPush  = close < lma1 and slope1 < 0
pushTxt   = bullPush ? "Bull ✅" : bearPush ? "Bear ✅" : "None"

// ---- 7. Trend ----
trendTxt  = slope1 > 0 ? "Uptrend" : slope1 < 0 ? "Downtrend" : "Sideways"

// ================= Left Table: LMA Layers =================
var table t1 = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast
    table.cell(t1, 0, 0, "LMA Layer",  bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(t1, 1, 0, "Status",     bgcolor=color.new(color.gray, 80), text_color=color.white)

    table.cell(t1, 0, 1, "Weekly",     bgcolor=color.new(color.red, 80), text_color=color.white)
    table.cell(t1, 1, 1, dirTxt(slopeW) + " / " + structTxt(close, lmaW) + " / " + turnW, bgcolor=color.new(color.red, 80), text_color=color.white)

    table.cell(t1, 0, 2, "Daily",      bgcolor=color.new(color.orange, 80), text_color=color.white)
    table.cell(t1, 1, 2, dirTxt(slopeD) + " / " + structTxt(close, lmaD) + " / " + turnD, bgcolor=color.new(color.orange, 80), text_color=color.white)

    table.cell(t1, 0, 3, "4H",         bgcolor=color.new(color.blue, 80), text_color=color.white)
    table.cell(t1, 1, 3, dirTxt(slope4) + " / " + structTxt(close, lma4) + " / " + turn4, bgcolor=color.new(color.blue, 80), text_color=color.white)

    table.cell(t1, 0, 4, "1H",         bgcolor=color.new(color.green, 80), text_color=color.white)
    table.cell(t1, 1, 4, dirTxt(slope1) + " / " + structTxt(close, lma1) + " / " + turn1, bgcolor=color.new(color.green, 80), text_color=color.white)

    table.cell(t1, 0, 5, "1H vs 4H",  bgcolor=color.new(color.purple, 80), text_color=color.white)
    table.cell(t1, 1, 5, p1_4,        bgcolor=color.new(color.purple, 80), text_color=color.white)

    table.cell(t1, 0, 6, "4H vs D",   bgcolor=color.new(color.purple, 80), text_color=color.white)
    table.cell(t1, 1, 6, p4_D,        bgcolor=color.new(color.purple, 80), text_color=color.white)

    table.cell(t1, 0, 7, "D vs W",    bgcolor=color.new(color.purple, 80), text_color=color.white)
    table.cell(t1, 1, 7, pD_W,        bgcolor=color.new(color.purple, 80), text_color=color.white)

// ================= Bottom-Right Table: Session Status =================
tz = "Asia/Shanghai"
hourNow = hour(time, tz)

inAsia    = (hourNow >= 8  and hourNow < 17)
inEurope  = (hourNow >= 15 and hourNow < 23)
inAmerica = (hourNow >= 21 or  hourNow < 4)

var table t2 = table.new(position.bottom_right, 4, 4, border_width=1)

if barstate.islast
    table.cell(t2, 0, 0, "Session", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(t2, 1, 0, "Time", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(t2, 2, 0, "Push Validation", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(t2, 3, 0, "Trend / Pressure / Compression", bgcolor=color.new(color.gray, 80), text_color=color.white)

    table.cell(t2, 0, 1, "Asia", bgcolor=color.new(color.blue, 85), text_color=color.white)
    table.cell(t2, 1, 1, "8:00-17:00", bgcolor=color.new(color.blue, 85), text_color=color.white)
    table.cell(t2, 2, 1, pushTxt, bgcolor=color.new(color.blue, 85), text_color=color.white)
    table.cell(t2, 3, 1, trendTxt + " / " + pressTxt + " / " + compressTxt, bgcolor=color.new(color.blue, 85), text_color=color.white)

    table.cell(t2, 0, 2, "Europe", bgcolor=color.new(color.orange, 85), text_color=color.white)
    table.cell(t2, 1, 2, "15:00-23:00", bgcolor=color.new(color.orange, 85), text_color=color.white)
    table.cell(t2, 2, 2, pushTxt, bgcolor=color.new(color.orange, 85), text_color=color.white)
    table.cell(t2, 3, 2, trendTxt + " / " + pressTxt + " / " + compressTxt, bgcolor=color.new(color.orange, 85), text_color=color.white)

    table.cell(t2, 0, 3, "America", bgcolor=color.new(color.green, 85), text_color=color.white)
    table.cell(t2, 1, 3, "21:00-4:00", bgcolor=color.new(color.green, 85), text_color=color.white)
    table.cell(t2, 2, 3, pushTxt, bgcolor=color.new(color.green, 85), text_color=color.white)
    table.cell(t2, 3, 3, trendTxt + " / " + pressTxt + " / " + compressTxt, bgcolor=color.new(color.green, 85), text_color=color.white)

// Highlight current session
bgcolor(inAmerica ? color.new(color.green, 90) : inEurope ? color.new(color.orange, 90) : inAsia ? color.new(color.blue, 90) : na, title="Current Session")