//@version=6
indicator('Relative Momentum Index', 'Relative Momentum Index', overlay = false, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

MIDLINE = 50.0

BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

momentumLengthInput  = input.int(5, 'Momentum Length', minval = 1, group = 'Settings', tooltip = 'Number of bars back each up or down change is measured against (the momentum step). A step of 1 makes the index identical to RSI; larger steps capture multi-bar momentum for a smoother line with wider, more decisive swings, at the cost of added lag.')
smoothingLengthInput = input.int(14, 'Smoothing Length', minval = 1, group = 'Settings', tooltip = 'Length of the Wilder smoothing applied to the up and down momentum components before they are scaled to the 0-100 range, the same averaging RSI uses.')
sourceInput          = input.source(close, 'Source', group = 'Settings', tooltip = 'Price series the momentum changes are measured on.')

overboughtInput = input.float(80, 'Overbought', minval = 0, maxval = 100, step = 1, group = 'Levels', tooltip = 'Level above which the index is considered overbought. RMI visits extremes more readily than RSI, so bands wider than 70/30, such as 80/20, are a common starting point; calibrate them to the instrument. An extreme reading is a condition to monitor, not a reversal signal by itself.')
oversoldInput   = input.float(20, 'Oversold', minval = 0, maxval = 100, step = 1, group = 'Levels', tooltip = 'Level below which the index is considered oversold. RMI visits extremes more readily than RSI, so bands wider than 70/30, such as 80/20, are a common starting point; calibrate them to the instrument.')

bullColorInput   = input.color(BULL_COLOR, 'Bullish Color', group = 'Style', tooltip = 'Color of the oscillator line and gradient fill when the index is above the 50 midline.')
bearColorInput   = input.color(BEAR_COLOR, 'Bearish Color', group = 'Style', tooltip = 'Color of the oscillator line and gradient fill when the index is below the 50 midline.')
levelColorInput  = input.color(NEUTRAL_COLOR, 'Levels Color', group = 'Style', tooltip = 'Color of the overbought, oversold, and midline levels.')
showMarkersInput = input.bool(false, 'Show Zone Exit Markers', group = 'Style', tooltip = 'Plot a circle on the oscillator when it crosses back below the overbought level or back above the oversold level, the classic threshold timing events. Disabled by default to keep the pane clean; matching alert conditions cover the same events.')

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{

//Up and down changes measured over the momentum step rather than bar to bar
upChange   = math.max(sourceInput - sourceInput[momentumLengthInput], 0)
downChange = math.max(sourceInput[momentumLengthInput] - sourceInput, 0)

//Wilder smoothing of both components, identical to the RSI averaging
avgUp   = ta.rma(upChange, smoothingLengthInput)
avgDown = ta.rma(downChange, smoothingLengthInput)

//Scale to the 0-100 range, resolving the flat-market edge case to the midline
totalMomentum = avgUp + avgDown
rmi = na(totalMomentum) ? na : totalMomentum == 0 ? MIDLINE : 100 * avgUp / totalMomentum

//Threshold and midline events
crossIntoOverbought = ta.crossover(rmi, overboughtInput)
crossOutOverbought  = ta.crossunder(rmi, overboughtInput)
crossIntoOversold   = ta.crossunder(rmi, oversoldInput)
crossOutOversold    = ta.crossover(rmi, oversoldInput)
crossUpMidline      = ta.crossover(rmi, MIDLINE)
crossDownMidline    = ta.crossunder(rmi, MIDLINE)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

rmiIsBullish = rmi > MIDLINE

rmiPlotId = plot(rmi, 'RMI', rmiIsBullish ? bullColorInput : bearColorInput, 2)
midPlotId = plot(MIDLINE, 'Midline Anchor', color = na, editable = false, display = display.none)

//Gradient fill from the midline to the oscillator value, fully transparent at the center
fill(rmiPlotId, midPlotId
  , top_value    = math.max(rmi, MIDLINE)
  , bottom_value = math.min(rmi, MIDLINE)
  , top_color    = rmiIsBullish ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100)
  , bottom_color = rmiIsBullish ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50)
  , title        = 'Momentum Gradient')

hline(overboughtInput, 'Overbought Level', levelColorInput, hline.style_dashed)
hline(oversoldInput, 'Oversold Level', levelColorInput, hline.style_dashed)
hline(MIDLINE, 'Midline', color.new(levelColorInput, 50), hline.style_dotted)

//Optional zone exit markers, disabled by default
plot(showMarkersInput and crossOutOversold ? rmi : na, 'Oversold Exit Marker', bullColorInput, 3, plot.style_circles)
plot(showMarkersInput and crossOutOverbought ? rmi : na, 'Overbought Exit Marker', bearColorInput, 3, plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(crossIntoOverbought, 'Overbought Zone Entry', 'Relative Momentum Index crossed above the overbought level on {{ticker}} ({{interval}})')
alertcondition(crossOutOverbought, 'Overbought Zone Exit', 'Relative Momentum Index crossed back below the overbought level on {{ticker}} ({{interval}})')
alertcondition(crossIntoOversold, 'Oversold Zone Entry', 'Relative Momentum Index crossed below the oversold level on {{ticker}} ({{interval}})')
alertcondition(crossOutOversold, 'Oversold Zone Exit', 'Relative Momentum Index crossed back above the oversold level on {{ticker}} ({{interval}})')
alertcondition(crossUpMidline, 'Midline Cross Up', 'Relative Momentum Index crossed above its 50 midline on {{ticker}} ({{interval}})')
alertcondition(crossDownMidline, 'Midline Cross Down', 'Relative Momentum Index crossed below its 50 midline on {{ticker}} ({{interval}})')

//---------------------------------------------------------------------------------------------------------------------}
