macdHistPosRise=input.color(color.rgb(15, 176, 166), "Pos rising", inline="macd-pos", group=gMACDS,tooltip=ttHist)
macdHistPosFall=input.color(color.rgb(126, 206, 206), "Pos falling", inline="macd-pos", group=gMACDS)
macdHistNegFall=input.color(color.rgb(229, 78, 100), "Neg falling", inline="macd-neg", group=gMACDS,tooltip=ttHist)
macdHistNegRise=input.color(color.rgb(241, 158, 172), "Neg rising", inline="macd-neg", group=gMACDS)
