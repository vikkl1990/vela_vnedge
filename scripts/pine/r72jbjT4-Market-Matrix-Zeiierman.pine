rsiOsLineCol=input.color(color.new(color.rgb(235, 65, 80), 10), "OS dashed", inline="rsi-lines", group=gRSIS,active=guidesOn)
rsiMidLineCol=input.color(color.new(color.rgb(139, 163, 188), 75), "50 midline", inline="rsi-other", group=gRSIS,active=guidesOn)
rsiValueCol=input.color(color.rgb(247, 211, 42), "Header values", inline="rsi-other", group=gRSIS,active=valuesOn)
rsiObFillCol=input.color(color.new(color.rgb(0, 177, 142), 64), "OB fill", inline="rsi-fill", group=gRSIS,active=fillsOn)
rsiOsFillCol=input.color(color.new(color.rgb(235, 65, 80), 64), "OS fill", inline="rsi-fill", group=gRSIS,active=fillsOn)
rsiObZoneCol=input.color(color.new(color.rgb(0, 177, 142), 95), "OB zone", inline="rsi-zone", group=gRSIS,active=zonesOn)
rsiOsZoneCol=input.color(color.new(color.rgb(235, 65, 80), 95), "OS zone", inline="rsi-zone", group=gRSIS,active=zonesOn)

// MACD
macdFast=input.int(12, "MACD Fast", minval=2, group=gMACD,inline="macd1",tooltip=ttMACD)
macdSlow=input.int(26, "MACD Slow", minval=3, group=gMACD,inline="macd1",tooltip=ttMACD)
macdSignal=input.int(9, "MACD Signal", minval=2, group=gMACD,inline="macd1",tooltip=ttMACD)

// MACD Style
macdCol=input.color(color.rgb(246, 151, 21), "MACD line", inline="macd-curves", group=gMACDS)
