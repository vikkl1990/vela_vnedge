rangeObLineCol=input.color(color.new(color.rgb(0, 177, 142), 10), "+100 dashed", inline="rng-levels", group=gRNGS,active=guidesOn)
rangeOsLineCol=input.color(color.new(color.rgb(235, 65, 80), 10), "-100 dashed", inline="rng-levels", group=gRNGS,active=guidesOn)
