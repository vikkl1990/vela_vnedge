asiOb=input.float(8.0, "Overbought", minval=-20, maxval=20, group=gASI,inline="asi4",tooltip=ttLimits)
asiOs=input.float(-8.0, "Oversold", minval=-20, maxval=20, group=gASI,inline="asi4",tooltip=ttLimits)

