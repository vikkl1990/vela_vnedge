asiOsZoneCol=input.color(color.new(color.rgb(235, 65, 80), 95), "OS zone", inline="asi-zone", group=gASIS,active=zonesOn)

// Range Oscillator
rangeLen=input.int(50, "Minimum Range Length", minval=1, group=gRNG,inline="rng1",tooltip=ttRange)
rangeMult=input.float(2.0, "Range Width Multiplier", minval=0.1, step=0.1, group=gRNG,inline="rng1",tooltip=ttRangeMult)
heatLevels=input.int(2, "Heat Levels", minval=2, maxval=100, group=gRNG,inline="rng2",tooltip=ttHeat)
heatThresh=input.int(1, "Minimum Touches / Level", minval=1, group=gRNG,inline="rng2",tooltip=ttHeat)
heatOn=input.bool(true, "Use original heatmap line colors", group=gRNG,inline="rng3",tooltip=ttHeatOn)

// Range Oscillator Style
rngBull=input.color(#09ff00, "Strong bull", inline="rng-strong", group=gRNGS)
rngBear=input.color(color.rgb(255, 0, 0), "Strong bear", inline="rng-strong", group=gRNGS)
rngWeakUp=input.color(color.green, "Weak bull", inline="rng-weak", group=gRNGS,active=heatOn)
rngWeakDn=input.color(color.maroon, "Weak bear", inline="rng-weak", group=gRNGS,active=heatOn)
rngTransition=input.color(color.blue, "Transition", inline="rng-curves", group=gRNGS,active=heatOn)
