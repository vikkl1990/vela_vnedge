indicator("Market Matrix (Zeiierman)", overlay=true, max_lines_count=500, max_boxes_count=500, max_polylines_count=100, max_labels_count=150, max_bars_back=2600)
//}

// ~~ Tooltips {
const string ttTf="Higher timeframe for all six mini-panels. Must be equal to or above the main chart timeframe."
const string ttBars="Historical bars displayed in each panel, limited by the 500-future-bar drawing boundary."
const string ttGap="Horizontal separation between the latest chart candle and the first mini-panel."
const string ttStep="Horizontal bar spacing. Larger values spread out the history but may reduce how much fits."
const string ttCol="Spacing between the two mini-panel columns."
const string ttHeight="Scales panel heights without changing the underlying indicator values."
const string ttAnchor="Price lookback used to position the panel rows vertically."
const string ttScale="Reserve space for all three panel rows in the TradingView price scale."
const string ttMetrics="Show latest indicator values directly under each panel title."
const string ttGuides="Draw center guides and dashed overbought/oversold reference lines."
const string ttBackdrop="Show the panel background and header-strip colors."
const string ttZones="Show the faint background zones beyond overbought and oversold thresholds."
const string ttFills="Show RSI/RTI/ASI extreme fills and Range Oscillator zero-centered layers."
const string ttMA="Master switch for the three HTF moving averages. Each moving average can also be disabled separately."
const string ttMaRow="Each moving average has its own visibility, period, and native Solid / Dashed / Dotted stroke."
const string ttVW="Draw swing-anchored VWAP segments over the HTF candle panel."
const string ttSwing="Swing detection lookback used to reconstruct the HTF anchored VWAP."
const string ttApt="VWAP adaptive price-tracking period. Higher values track changes more slowly."
const string ttAdapt="Adapt VWAP tracking speed using the ATR-to-average-ATR ratio."
const string ttBias="Strength of the ATR adaptation. Available only while adaptive tracking is enabled."
const string ttVWStyle="Independent native Solid / Dashed / Dotted styles for up and down VWAP segments."
const string ttWidth="Thickness of both VWAP directional strokes."
const string ttMarks="Mark confirmed VWAP swing anchors as HH/LH/HL/LL. Classification compares with the previous confirmed anchor of the same type. Labels are placed on earlier pivot candles only AFTER a swing direction flip confirms them."
const string ttRSI="Standard relative-strength index, calculated inside the selected higher-timeframe context."
const string ttRSIMa="Simple moving average of the higher-timeframe RSI."
const string ttLimits="Dashed reference boundaries; the overbought level must exceed the oversold level."
const string ttMACD="Classic MACD fast, slow, and signal periods; histogram uses four independently colored states."
const string ttHist="Four histogram states: positive rising/falling and negative falling/rising."
const string ttRTI="Relative Trend Index lookback, using nearest-rank percentile upper/lower populations."
const string ttSensitivity="Percentile sensitivity of the Relative Trend Index."
const string ttRTISig="EMA smoothing applied to the Relative Trend Index."
const string ttASI="ASI normalization uses historical bar returns and upper/lower percentile benchmarks."
const string ttASISig="Signal moving average type and length for the Absolute Strength Index."
const string ttRange="Window for the weighted-center Range Oscillator calculation."
const string ttRangeMult="ATR multiplier for Range Oscillator normalization."
const string ttHeat="Number of heat buckets and minimum count required to highlight a bucket."
const string ttHeatOn="Color the Range Oscillator by the original Zeiierman heatmap instead of using one fixed stroke."
const string ttEMA="Main-chart EMA and its translucent glow band."
const string ttVol="Show main-chart volume bars under the price history, bottom-aligned with the lowest panels. Bar heights do not change."
const string ttFib="Optional automatic Fibonacci guides from recent highest high and lowest low."
const string ttReg="Optional linear-regression channel around the current chart prices."
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Groups {
gLAY="Layout"
gPST="Panel Style"
gHTF="HTF Candles"
gHTFS="HTF Candles Style"
gVW="Swing VWAP"
gVWS="Swing VWAP Style"
gRSI="RSI"
gRSIS="RSI Style"
gMACD="MACD"
gMACDS="MACD Style"
gRTI="Relative Trend Index"
gRTIS="RTI Style"
gASI="Absolute Strength Index"
gASIS="ASI Style"
gRNG="Range Oscillator"
gRNGS="Range Oscillator Style"
gMAIN="Main Chart"
gMS="Main Chart Style"
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs {
// Layout
panelTf=input.timeframe("D", "Mini-chart timeframe", group=gLAY,tooltip=ttTf)
histBars=input.int(150, "History points per panel", minval=20, maxval=245, group=gLAY,tooltip=ttBars)
xGap=input.int(6, "Gap after latest price bar", minval=1, maxval=60, group=gLAY,tooltip=ttGap)
xStep=input.int(1, "Horizontal spacing", minval=1, maxval=4, group=gLAY,tooltip=ttStep)
colGap=input.int(8, "Space between columns", minval=2, maxval=50, group=gLAY,tooltip=ttCol)
panelSize=input.float(1.22, "Panel height multiplier", minval=0.7, maxval=2.0, step=0.05, group=gLAY,tooltip=ttHeight)
anchorLen=input.int(160, "Vertical anchor lookback", minval=40, maxval=600, group=gLAY,tooltip=ttAnchor)
extendScale=input.bool(true, "Reserve vertical chart space", group=gLAY,tooltip=ttScale)
valuesOn=input.bool(true, "Show values in panel headers", group=gLAY,tooltip=ttMetrics)
guidesOn=input.bool(true, "Show level / reference lines", group=gLAY,tooltip=ttGuides)
bgOn=input.bool(false, "Show panel backgrounds", group=gLAY,tooltip=ttBackdrop)
zonesOn=input.bool(true, "Show shaded OB/OS zones", group=gLAY,tooltip=ttZones)
fillsOn=input.bool(true, "Show oscillator / OB/OS fills", group=gLAY,tooltip=ttFills)

// Panel Style
panelBg=input.color(color.new(color.rgb(10, 27, 56), 36), "Background", inline="panel-bg", group=gPST,active=bgOn)
panelHeadBg=input.color(color.new(color.rgb(35, 52, 81), 47), "Header strip", inline="panel-bg", group=gPST,active=bgOn)
panelEdge=input.color(color.new(color.rgb(54, 83, 108), 81), "Frame border", inline="panel-txt", group=gPST,active=bgOn)
panelTitle=input.color(color.rgb(225, 237, 244), "Header title", inline="panel-txt", group=gPST)

// HTF Candles
maOn=input.bool(true, "Show HTF moving averages", group=gHTF,inline="maMaster",tooltip=ttMA)
maFastOn=input.bool(true, "Fast MA", inline="ma1", group=gHTF,active=maOn,tooltip=ttMaRow)
maFastLen=input.int(20, "Length", minval=2, maxval=400, inline="ma1", group=gHTF,active=maOn and maFastOn)
maFastSty=input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], inline="ma1", group=gHTF,active=maOn and maFastOn)
maMidOn=input.bool(true, "Mid MA", inline="ma2", group=gHTF,active=maOn,tooltip=ttMaRow)
maMidLen=input.int(50, "Length", minval=2, maxval=400, inline="ma2", group=gHTF,active=maOn and maMidOn)
maMidSty=input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], inline="ma2", group=gHTF,active=maOn and maMidOn)
maSlowOn=input.bool(true, "Slow MA", inline="ma3", group=gHTF,active=maOn,tooltip=ttMaRow)
maSlowLen=input.int(200, "Length", minval=2, maxval=400, inline="ma3", group=gHTF,active=maOn and maSlowOn)
maSlowSty=input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], inline="ma3", group=gHTF,active=maOn and maSlowOn)

// HTF Candles Style
candleUpCol=input.color(color.new(color.rgb(0, 177, 142), 15), "Up body", inline="candle-body", group=gHTFS)
candleDownCol=input.color(color.new(color.rgb(235, 65, 80), 15), "Down body", inline="candle-body", group=gHTFS)
candleUpWick=input.color(color.rgb(0, 177, 142), "Up wick", inline="candle-wick", group=gHTFS)
candleDownWick=input.color(color.rgb(235, 65, 80), "Down wick", inline="candle-wick", group=gHTFS)
candleUpBorder=input.color(color.rgb(0, 177, 142), "Up border", inline="candle-border", group=gHTFS)
candleDownBorder=input.color(color.rgb(235, 65, 80), "Down border", inline="candle-border", group=gHTFS)
maFastCol=input.color(color.rgb(247, 211, 42), "Fast MA", inline="htf-ma", group=gHTFS,active=maOn and maFastOn)
maMidCol=input.color(color.rgb(72, 132, 255), "Mid MA", inline="htf-ma", group=gHTFS,active=maOn and maMidOn)
maSlowCol=input.color(color.rgb(240, 240, 240), "Slow MA", inline="htf-ma2", group=gHTFS,active=maOn and maSlowOn)
htfValueCol=input.color(color.rgb(0, 177, 142), "Header values", inline="htf-ma2", group=gHTFS,active=valuesOn)

// Swing VWAP
vwOn=input.bool(true, "Show Swing Anchored VWAP", group=gVW,inline="vwMaster",tooltip=ttVW)
swLen=input.int(50, "Swing Period", minval=2, maxval=250, group=gVW,inline="vw1",active=vwOn,tooltip=ttSwing)
vwApt=input.float(20.0, "Adaptive Price Tracking", minval=1, step=1, group=gVW,inline="vw2",active=vwOn,tooltip=ttApt)
vwAdapt=input.bool(false, "Adapt APT by ATR ratio", group=gVW,inline="vw3",active=vwOn,tooltip=ttAdapt)
vwBias=input.float(10.0, "Volatility Bias", minval=0.1, step=0.1, group=gVW,inline="vw3",active=vwOn and vwAdapt,tooltip=ttBias)
vwWidth=input.int(2, "VWAP line width", minval=1, maxval=4, group=gVW,inline="vwWidth",active=vwOn,tooltip=ttWidth)
vwMarks=input.bool(true, "Show HH / LH / HL / LL", group=gVW,inline="vwMarks",active=vwOn,tooltip=ttMarks)

// Swing VWAP Style
vwUpCol=input.color(color.lime, "Up-swing", inline="vwap-up", group=gVWS,active=vwOn)
vwUpSty=input.string("Solid", "Line style", options=["Solid", "Dashed", "Dotted"], inline="vwap-up", group=gVWS,active=vwOn,tooltip=ttVWStyle)
vwDnCol=input.color(color.red, "Down-swing", inline="vwap-down", group=gVWS,active=vwOn)
vwDnSty=input.string("Solid", "Line style", options=["Solid", "Dashed", "Dotted"], inline="vwap-down", group=gVWS,active=vwOn,tooltip=ttVWStyle)
vwMarkCol=input.color(color.new(#00a2ff, 20), "Swing marker text", group=gVWS,active=vwOn and vwMarks)

// RSI
rsiLen=input.int(14, "RSI Period", minval=2, group=gRSI,inline="rsi1",tooltip=ttRSI)
rsiMaLen=input.int(9, "RSI MA Period", minval=2, group=gRSI,inline="rsi1",tooltip=ttRSIMa)
rsiOb=input.float(70.0, "Overbought", minval=1, maxval=100, group=gRSI,inline="rsi2",tooltip=ttLimits)
rsiOs=input.float(30.0, "Oversold", minval=0, maxval=99, group=gRSI,inline="rsi2",tooltip=ttLimits)

// RSI Style
rsiCol=input.color(color.rgb(158, 123, 240), "RSI line", inline="rsi-curves", group=gRSIS)
rsiMaCol=input.color(color.rgb(247, 211, 42), "RSI MA", inline="rsi-curves", group=gRSIS)
