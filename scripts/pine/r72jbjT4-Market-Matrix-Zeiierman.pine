rtiOsZoneCol=input.color(color.new(color.rgb(235, 65, 80), 95), "OS zone", inline="rti-zone", group=gRTIS,active=zonesOn)

// Absolute Strength Index
asiLookback=input.int(15, "Returns Lookback", minval=3, maxval=100, group=gASI,inline="asi1",tooltip=ttASI)
