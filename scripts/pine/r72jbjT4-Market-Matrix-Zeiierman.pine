rtiOs=input.float(20, "Oversold", minval=0, maxval=100, group=gRTI,inline="rti3",tooltip=ttLimits)

// RTI Style
rtiCol=input.color(color.rgb(12, 194, 174), "RTI line", inline="rti-curves", group=gRTIS)
