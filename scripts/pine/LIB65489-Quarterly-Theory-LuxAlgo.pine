//@version=6
indicator("Quarterly Theory", shorttitle = "Quarterly Theory", overlay = true, format = format.price, max_lines_count = 500, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
string DEG_YEARLY  = "Yearly"
string DEG_MONTHLY = "Monthly"
string DEG_WEEKLY  = "Weekly"
string DEG_DAILY   = "Daily"
string DEG_SESSION = "Session (90m)"
string DEG_NONE    = "None"

string SEQ_AMDX = "AMDX (accumulation first)"
string SEQ_XAMD = "XAMD (delivery first)"

string GROUP_CYCLE  = "Cycle"
string GROUP_LEVELS = "True Open & Q1 Range"
string GROUP_DASH   = "Dashboard"
string GROUP_STYLE  = "Style"

BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86 // cycle structure - boundaries, labels, the Q1 range
ACCENT_COLOR  = #ff9800 // the true open - the level the framework trades against
DASH_BG       = #161616
DASH_FRAME    = #2E2E2E
DASH_HEADER   = #808080
DASH_TEXT     = #DBDBDB

cycleInput = input.string(DEG_DAILY, "Cycle Degree"
  , options = [DEG_YEARLY, DEG_MONTHLY, DEG_WEEKLY, DEG_DAILY, DEG_SESSION]
  , group   = GROUP_CYCLE
  , tooltip = "The cycle divided into quarters Q1-Q4. Yearly: three-month quarters anchored to the first Mondays of January, April, July and October. Monthly: the month's Monday-anchored weeks. Weekly: the trading days - Q1 Monday through Q4 Thursday, with Friday extending Q4. Daily: the four 6-hour sessions - Asia 18:00, London 00:00, New York 06:00 and the afternoon 12:00. Session (90m): each 6-hour session as its own cycle of four 90-minute quarters. Trading days start at 18:00 New York time throughout.")

subCycleInput = input.string(DEG_NONE, "Sub-Quarters"
  , options = [DEG_NONE, DEG_MONTHLY, DEG_WEEKLY, DEG_DAILY, DEG_SESSION]
  , group   = GROUP_CYCLE
  , tooltip = "Optional finer degree drawn as faint dotted boundaries inside the main cycle - the framework's recursion. Pair the Daily cycle with Session (90m) to split each session into its four 90-minute quarters. Pick a degree finer than the main cycle; boundaries that coincide with a main quarter start are not redrawn.")

phaseSequenceInput = input.string(SEQ_AMDX, "Phase Sequence"
  , options = [SEQ_AMDX, SEQ_XAMD]
  , group   = GROUP_CYCLE
  , tooltip = "Phase expected in each quarter, used for the labels and the dashboard. AMDX (default): Q1 accumulation, Q2 manipulation, Q3 distribution, Q4 continuation or reversal (X). XAMD: the transposed ordering used when delivery front-runs the cycle - Q1 is already the X leg and accumulation, manipulation and distribution shift one quarter later.")

timezoneInput = input.string("America/New_York", "Time Zone"
  , options = ["America/New_York", "Exchange", "UTC", "Europe/London", "Asia/Tokyo", "Australia/Sydney"]
  , group   = GROUP_CYCLE
  , tooltip = "Quarterly Theory defines every boundary on the New York clock, so exchange-local or UTC references misplace the quarters - keep the default unless you deliberately want another anchor. 'Exchange' uses the chart symbol's time zone.")

showTrueOpenInput = input.bool(true, "True Open"
  , group   = GROUP_LEVELS
  , tooltip = "Open of the cycle's second quarter, plotted through the rest of the cycle - midnight New York for the daily cycle, Monday 18:00 for the weekly, the second Monday-week for the monthly, the first Monday of April for the yearly. Price above the true open is read as premium, below as discount. If no bar prints at the exact quarter open, the first available open after it is used.")

showQ1RangeInput = input.bool(true, "Q1 Range"
  , group   = GROUP_LEVELS
  , tooltip = "High and low of the cycle's first quarter, extended through the cycle with a faint fill. Manipulation is expected to run one side of this range near the true open before the directional leg delivers.")

markManipInput = input.bool(false, "Mark Manipulation Signatures"
  , group   = GROUP_LEVELS
  , tooltip = "Flags Q2 and Q3 bars that raid Q1's high or low but close back inside the range - the sweep-and-fail signature of the manipulation phase. Off by default to keep the chart clean; the matching alerts fire either way.")

showDashInput = input.bool(true, "Show Dashboard"
  , group   = GROUP_DASH
  , tooltip = "Answers the framework's working question - which quarter am I in and what phase should this be - along with the true open level and the premium or discount read against it.")

showStackInput = input.bool(true, "Quarters Across Degrees"
  , group   = GROUP_DASH
  , tooltip = "Adds one dashboard row per degree, yearly down to the 90-minute quarters, so higher-degree quarters can color the read on lower ones.")

dashLocationInput = input.string("Top Right", "Location"
  , options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"]
  , group   = GROUP_DASH
  , tooltip = "Chart corner the dashboard is anchored to.")

dashSizeInput = input.string("Small", "Size"
  , options = ["Tiny", "Small", "Normal"]
  , group   = GROUP_DASH
  , tooltip = "Dashboard text size.")

showLabelsInput = input.bool(true, "Quarter Labels"
  , group   = GROUP_STYLE
  , tooltip = "Prints Q1-Q4 with the expected phase letter above the first bar of each quarter; hover a label for the phase description.")

labelSizeInput = input.string("Tiny", "Label Size"
  , options = ["Tiny", "Small", "Normal"]
  , group   = GROUP_STYLE
  , tooltip = "Text size of the quarter labels.")

labelColorInput = input.color(NEUTRAL_COLOR, "Label Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of the quarter labels.")

cycleLineColorInput = input.color(NEUTRAL_COLOR, "Cycle Start"
  , group   = GROUP_STYLE
  , tooltip = "Solid vertical line where a new cycle begins (Q1).")

quarterLineColorInput = input.color(color.new(NEUTRAL_COLOR, 50), "Quarter Start"
  , group   = GROUP_STYLE
  , tooltip = "Dotted vertical lines where Q2, Q3 and Q4 begin.")

subLineColorInput = input.color(color.new(NEUTRAL_COLOR, 75), "Sub-Quarter"
  , group   = GROUP_STYLE
  , tooltip = "Faint dotted vertical lines for the optional sub-quarter degree.")

trueOpenColorInput = input.color(ACCENT_COLOR, "True Open"
  , group   = GROUP_STYLE
  , tooltip = "Color of the true open level.")

q1RangeColorInput = input.color(NEUTRAL_COLOR, "Q1 Range"
  , group   = GROUP_STYLE
  , tooltip = "Color of the Q1 high and low levels and of the fill between them.")

bullColorInput = input.color(BULL_COLOR, "Bullish"
  , inline  = "bias"
  , group   = GROUP_STYLE)

bearColorInput = input.color(BEAR_COLOR, "Bearish"
  , inline  = "bias"
  , group   = GROUP_STYLE
  , tooltip = "Colors of the manipulation-signature marks and of the premium / discount dashboard read.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
//Days elapsed since 1970-01-01 for a calendar date (standard civil-date arithmetic, leap-year exact)
daysFromCivil(int yearNum, int monthNum, int dayNum) =>
    int yy  = monthNum <= 2 ? yearNum - 1 : yearNum
    int era = math.floor(yy / 400.0)
    int yoe = yy - era * 400
    int doy = math.floor((153 * (monthNum + (monthNum > 2 ? -3 : 9)) + 2) / 5.0) + dayNum - 1
    int doe = yoe * 365 + math.floor(yoe / 4.0) - math.floor(yoe / 100.0) + doy
    era * 146097 + doe - 719468

//Calendar date for a day number since 1970-01-01 (inverse of daysFromCivil)
civilFromDays(int dayNumber) =>
    int z   = dayNumber + 719468
    int era = math.floor(z / 146097.0)
    int doe = z - era * 146097
    int yoe = math.floor((doe - math.floor(doe / 1460.0) + math.floor(doe / 36524.0) - math.floor(doe / 146096.0)) / 365.0)
    int yy  = yoe + era * 400
    int doy = doe - (365 * yoe + math.floor(yoe / 4.0) - math.floor(yoe / 100.0))
    int mp  = math.floor((5 * doy + 2) / 153.0)
    int dd  = doy - math.floor((153 * mp + 2) / 5.0) + 1
    int mm  = mp < 10 ? mp + 3 : mp - 9
    [mm <= 2 ? yy + 1 : yy, mm, dd]

//Day number of the first Monday of a calendar month
firstMondayEpoch(int yearNum, int monthNum) =>
    int firstDayEpoch = daysFromCivil(yearNum, monthNum, 1)
    int mondayOffset  = ((firstDayEpoch - 4) % 7 + 7) % 7
    firstDayEpoch + (7 - mondayOffset) % 7

//Built-in text size for a size option string
textSizeOf(string sizeText) =>
    sizeText == "Tiny" ? size.tiny : sizeText == "Small" ? size.small : size.normal

//Phase letter, name and description expected in a quarter under the selected ordering
phaseOf(int qIdx) =>
    int phasePos = phaseSequenceInput == SEQ_AMDX ? qIdx : qIdx == 1 ? 4 : qIdx - 1
    string phaseLetter = phasePos == 1 ? "A" : phasePos == 2 ? "M" : phasePos == 3 ? "D" : "X"
    string phaseWord   = phasePos == 1 ? "Accumulation" : phasePos == 2 ? "Manipulation" : phasePos == 3 ? "Distribution" : "Continuation / Reversal"
    string phaseDesc   = phasePos == 1 ? "the quarter builds the range the rest of the cycle works against"
      : phasePos == 2 ? "a run on one side of the accumulation range, anticipated around the true open, expected to fail before delivery"
      : phasePos == 3 ? "the directional delivery leg away from the manipulation"
      : "the closing quarter extends the delivery or unwinds it into the next cycle"
    [phaseLetter, phaseWord, phaseDesc]

//One dashboard row of the cross-degree stack: degree name and its current quarter with the expected phase
dashDegreeRow(table tableId, int rowIndex, string degreeName, int qIdx, string sizeText, bool isActive) =>
    [phaseLetter, phaseWord, phaseDesc] = phaseOf(qIdx)
    color rowBg = DASH_BG
    table.cell(tableId, 0, rowIndex, degreeName, text_color = DASH_HEADER, text_halign = text.align_left, text_size = sizeText, bgcolor = rowBg)
    table.cell(tableId, 1, rowIndex, "Q" + str.tostring(qIdx) + " (" + phaseLetter + ")", text_color = isActive ? DASH_TEXT : DASH_HEADER, text_halign = text.align_right, text_size = sizeText, bgcolor = rowBg, tooltip = phaseWord + " - " + phaseDesc)

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Every boundary is clocked on the reference time zone (New York by default). Trading days run 18:00 to 18:00,
//so the day of a bar is shifted forward one calendar day from 18:00 onward, matching the Asia-first session grid.
//Bars are classified by their midpoint time so daily and higher bars land in the trading day they mostly cover.
string refTimezone = timezoneInput == "Exchange" ? syminfo.timezone : timezoneInput

int midTime  = na(time_close) ? time : (time + time_close) / 2
int hourNy   = hour(midTime, refTimezone)
int minuteNy = minute(midTime, refTimezone)
int epochDay = daysFromCivil(year(midTime, refTimezone), month(midTime, refTimezone), dayofmonth(midTime, refTimezone)) + (hourNy >= 18 ? 1 : 0)
int shiftHour = (hourNy + 6) % 24

[shiftYear, shiftMonth, shiftDay] = civilFromDays(epochDay)

int dayInWeek = ((epochDay - 4) % 7 + 7) % 7
int weekIndex = math.floor((epochDay - 4) / 7.0)

//Session (90m) degree: each 6-hour session is a cycle of four 90-minute quarters
int sessionIdx = math.floor(shiftHour / 6.0)
int sesKey     = epochDay * 4 + sessionIdx
int sesQ       = 1 + math.floor(((shiftHour % 6) * 60 + minuteNy) / 90.0)

//Daily degree: the four 6-hour session quarters - Asia, London, New York, afternoon
int dayKey = epochDay
int dayQ   = 1 + sessionIdx

//Weekly degree: Q1 Monday through Q4 Thursday; Friday and the weekend extend Q4
int wkKey = weekIndex
int wkQ   = dayInWeek <= 2 ? dayInWeek + 1 : 4

//Monthly degree: Monday-anchored weeks; days before the month's first Monday extend the prior cycle's Q4
int firstMondayMonth = firstMondayEpoch(shiftYear, shiftMonth)
int moKey = shiftYear * 12 + shiftMonth - (epochDay < firstMondayMonth ? 2 : 1)
int moQ   = epochDay < firstMondayMonth ? 4 : math.min(4, 1 + math.floor((epochDay - firstMondayMonth) / 7.0))

//Yearly degree: three-month quarters anchored to the first Mondays of January, April, July and October,
//so the yearly true open lands on the first Monday of April
int anchorMonth     = shiftMonth <= 3 ? 1 : shiftMonth <= 6 ? 4 : shiftMonth <= 9 ? 7 : 10
int firstMondayQtr  = firstMondayEpoch(shiftYear, anchorMonth)
int yrQRaw          = math.floor((anchorMonth + 2) / 3.0)
int yrQ             = epochDay < firstMondayQtr ? (yrQRaw == 1 ? 4 : yrQRaw - 1) : yrQRaw
int yrKey           = epochDay < firstMondayQtr and yrQRaw == 1 ? shiftYear - 1 : shiftYear

//Selected degrees
[cycleKey, quarterIdx] = switch cycleInput
    DEG_SESSION => [sesKey, sesQ]
    DEG_DAILY   => [dayKey, dayQ]
    DEG_WEEKLY  => [wkKey, wkQ]
    DEG_MONTHLY => [moKey, moQ]
    =>             [yrKey, yrQ]

[subKey, subQ] = switch subCycleInput
    DEG_SESSION => [sesKey, sesQ]
    DEG_DAILY   => [dayKey, dayQ]
    DEG_WEEKLY  => [wkKey, wkQ]
    DEG_MONTHLY => [moKey, moQ]
    =>             [0, 0]

bool newCycle      = na(cycleKey[1]) or cycleKey != cycleKey[1]
bool newQuarter    = newCycle or quarterIdx != quarterIdx[1]
bool newSubQuarter = subCycleInput != DEG_NONE and (na(subKey[1]) or subKey != subKey[1] or subQ != subQ[1])

//Q1 range and true open of the running cycle. The true open is the open of the first bar at or after the
//second quarter's start - the calendar open of Q1 is deliberately not used as the reference.
var float q1High      = na
var float q1Low       = na
var float trueOpen    = na
var bool  trueOpenSet = false

if newCycle
    q1High      := na
    q1Low       := na
    trueOpen    := na
    trueOpenSet := false
if quarterIdx == 1
    q1High := na(q1High) ? high : math.max(q1High, high)
    q1Low  := na(q1Low)  ? low  : math.min(q1Low, low)
else if not trueOpenSet
    trueOpen    := open
    trueOpenSet := true

//Manipulation signature: a Q2 or Q3 raid through a Q1 extreme that closes back inside the range
bool manipWindow      = quarterIdx == 2 or quarterIdx == 3
bool bearishSweepFail = manipWindow and not na(q1High) and high > q1High and close < q1High
bool bullishSweepFail = manipWindow and not na(q1Low) and low < q1Low and close > q1Low

//Premium / discount transitions against the running cycle's true open
bool crossAboveTrueOpen = trueOpenSet and not na(close[1]) and close > trueOpen and close[1] <= trueOpen
bool crossBelowTrueOpen = trueOpenSet and not na(close[1]) and close < trueOpen and close[1] >= trueOpen

//A quarter must be at least one chart bar to resolve on the chart
int quarterSeconds = switch cycleInput
    DEG_SESSION => 5400
    DEG_DAILY   => 21600
    DEG_WEEKLY  => 86400
    DEG_MONTHLY => 604800
    =>             7776000
bool timeframeTooHigh = timeframe.in_seconds() > quarterSeconds

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
string labelTextSize = textSizeOf(labelSizeInput)

//Vertical boundaries and quarter labels - solid line at each cycle start, dotted lines at quarter starts
if newQuarter and not barstate.isfirst
    float topAnchor = high == low ? high + syminfo.mintick : high
    line.new(bar_index, low, bar_index, topAnchor, extend = extend.both, width = 1
      , color = newCycle ? cycleLineColorInput : quarterLineColorInput
      , style = newCycle ? line.style_solid : line.style_dotted)
    if showLabelsInput
        [phaseLetter, phaseWord, phaseDesc] = phaseOf(quarterIdx)
        string sessionName = sessionIdx == 0 ? "Asia (18:00-00:00 NY)" : sessionIdx == 1 ? "London (00:00-06:00 NY)" : sessionIdx == 2 ? "New York (06:00-12:00 NY)" : "Afternoon (12:00-18:00 NY)"
        string labelTooltip = phaseWord + " - " + phaseDesc + (cycleInput == DEG_DAILY ? "\nSession: " + sessionName : cycleInput == DEG_SESSION ? "\nInside session: " + sessionName : "")
        label.new(bar_index, high, "Q" + str.tostring(quarterIdx) + " (" + phaseLetter + ")"
          , yloc      = yloc.abovebar
          , style     = label.style_none
          , textcolor = labelColorInput
          , size      = labelTextSize
          , tooltip   = labelTooltip)

//Sub-quarter boundaries of the optional finer degree
if newSubQuarter and not newQuarter and not barstate.isfirst
    line.new(bar_index, low, bar_index, high == low ? high + syminfo.mintick : high, extend = extend.both, width = 1
      , color = subLineColorInput
      , style = line.style_dotted)

q1HighPlotId = plot(showQ1RangeInput and not newCycle ? q1High : na, "Q1 High", q1RangeColorInput, 1, plot.style_linebr)
q1LowPlotId = plot(showQ1RangeInput and not newCycle ? q1Low : na, "Q1 Low", q1RangeColorInput, 1, plot.style_linebr)
fill(q1HighPlotId, q1LowPlotId, color.new(q1RangeColorInput, 94), "Q1 Range Fill")

plot(showTrueOpenInput ? trueOpen : na, "True Open", trueOpenColorInput, 1, plot.style_linebr)

plot(quarterIdx, "Quarter Index", NEUTRAL_COLOR, 1, display = display.data_window, editable = false)

plotshape(markManipInput and bearishSweepFail, "Bearish Manipulation Signature", shape.triangledown, location.abovebar, bearColorInput, size = size.tiny)
plotshape(markManipInput and bullishSweepFail, "Bullish Manipulation Signature", shape.triangleup, location.belowbar, bullColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
string dashPosition = dashLocationInput == "Top Right" ? position.top_right : dashLocationInput == "Top Left" ? position.top_left : dashLocationInput == "Bottom Right" ? position.bottom_right : position.bottom_left
string dashTextSize = textSizeOf(dashSizeInput)

var table dashboardTable = na

if barstate.islast and (showDashInput or timeframeTooHigh)
    if na(dashboardTable)
        dashboardTable := table.new(dashPosition, 2, 10
          , bgcolor      = DASH_BG
          , frame_color  = DASH_FRAME
          , frame_width  = 1
          , border_width = 0)
    color headCss  = DASH_HEADER
    color valueCss = DASH_TEXT
    if showDashInput
        [phaseLetter, phaseWord, phaseDesc] = phaseOf(quarterIdx)
        table.cell(dashboardTable, 0, 0, "Cycle", text_color = headCss, text_halign = text.align_left, text_size = dashTextSize)
        table.cell(dashboardTable, 1, 0, cycleInput, text_color = valueCss, text_halign = text.align_right, text_size = dashTextSize)
        table.cell(dashboardTable, 0, 1, "Quarter", text_color = headCss, text_halign = text.align_left, text_size = dashTextSize)
        table.cell(dashboardTable, 1, 1, "Q" + str.tostring(quarterIdx) + " (" + phaseLetter + ") - " + phaseWord, text_color = valueCss, text_halign = text.align_right, text_size = dashTextSize, tooltip = phaseDesc)
        table.cell(dashboardTable, 0, 2, "True Open", text_color = headCss, text_halign = text.align_left, text_size = dashTextSize)
        table.cell(dashboardTable, 1, 2, trueOpenSet ? str.tostring(trueOpen, format.mintick) : "pending", text_color = trueOpenSet ? trueOpenColorInput : valueCss, text_halign = text.align_right, text_size = dashTextSize)
        float biasPct = trueOpenSet ? (close / trueOpen - 1) * 100 : na
        string biasText = trueOpenSet ? (biasPct >= 0 ? "Premium +" : "Discount -") + str.tostring(math.abs(biasPct), "#.##") + "%" : "-"
        table.cell(dashboardTable, 0, 3, "Bias", text_color = headCss, text_halign = text.align_left, text_size = dashTextSize)
        table.cell(dashboardTable, 1, 3, biasText, text_color = trueOpenSet ? (biasPct >= 0 ? bullColorInput : bearColorInput) : valueCss, text_halign = text.align_right, text_size = dashTextSize)
        if showStackInput
            dashDegreeRow(dashboardTable, 4, DEG_YEARLY, yrQ, dashTextSize, cycleInput == DEG_YEARLY)
            dashDegreeRow(dashboardTable, 5, DEG_MONTHLY, moQ, dashTextSize, cycleInput == DEG_MONTHLY)
            dashDegreeRow(dashboardTable, 6, DEG_WEEKLY, wkQ, dashTextSize, cycleInput == DEG_WEEKLY)
            dashDegreeRow(dashboardTable, 7, DEG_DAILY, dayQ, dashTextSize, cycleInput == DEG_DAILY)
            dashDegreeRow(dashboardTable, 8, DEG_SESSION, sesQ, dashTextSize, cycleInput == DEG_SESSION)
    if timeframeTooHigh
        table.cell(dashboardTable, 0, 9, "Warning", text_color = BEAR_COLOR, text_halign = text.align_left, text_size = dashTextSize)
        table.cell(dashboardTable, 1, 9, "chart TF exceeds one quarter", text_color = BEAR_COLOR, text_halign = text.align_right, text_size = dashTextSize)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(newCycle,                        "New Cycle (Q1 Start)",             "Quarterly Theory on {{ticker}}: a new cycle has begun - Q1 underway")
alertcondition(newQuarter,                      "Quarter Transition",               "Quarterly Theory on {{ticker}}: a new quarter of the cycle has begun")
alertcondition(newQuarter and quarterIdx == 2,  "Q2 Start (True Open Set)",         "Quarterly Theory on {{ticker}}: Q2 has begun and set the cycle's true open - watch for manipulation around it")
alertcondition(newQuarter and quarterIdx == 3,  "Q3 Start",                         "Quarterly Theory on {{ticker}}: Q3 has begun - the distribution leg is anticipated under the default AMDX ordering")
alertcondition(newQuarter and quarterIdx == 4,  "Q4 Start",                         "Quarterly Theory on {{ticker}}: Q4 has begun - continuation or reversal of the delivery")
alertcondition(crossAboveTrueOpen,              "Cross Above True Open",            "Quarterly Theory on {{ticker}}: price closed above the cycle's true open - premium side")
alertcondition(crossBelowTrueOpen,              "Cross Below True Open",            "Quarterly Theory on {{ticker}}: price closed below the cycle's true open - discount side")
alertcondition(bearishSweepFail,                "Bearish Manipulation Signature",   "Quarterly Theory on {{ticker}}: raid above the Q1 high closed back inside the range - distribution lower anticipated")
alertcondition(bullishSweepFail,                "Bullish Manipulation Signature",   "Quarterly Theory on {{ticker}}: raid below the Q1 low closed back inside the range - distribution higher anticipated")

//---------------------------------------------------------------------------------------------------------------------}
