//@version=6
indicator("Donchian Trend Rules", shorttitle = "Donchian Trend Rules", overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86

TRIG_CLOSE = "Close"
TRIG_TOUCH = "Intrabar Touch"

DIR_BOTH  = "Long & Short"
DIR_LONG  = "Long Only"
DIR_SHORT = "Short Only"

RULES_GROUP = "Trend Rules"
STYLE_GROUP = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
entryLenInput = input.int(20, "Entry Length", minval = 1, group = RULES_GROUP, tooltip = "Entry lookback n: the entry channel is the highest high and lowest low of the prior n bars, and a breakout beyond a band opens a position in that direction. The documented pairs are 20/10 (Turtle System 1) and 55/20 (Turtle System 2).")

exitLenInput = input.int(10, "Exit Length", minval = 1, group = RULES_GROUP, tooltip = "Exit lookback m: a long closes on a break of the m-bar low, a short on a break of the m-bar high. A shorter exit window surrenders less open profit when the trend ends. Set it equal to the entry length for an always-in, stop-and-reverse system such as Donchian's four-week rule.")

trigInput = input.string(TRIG_CLOSE, "Breakout Trigger", options = [TRIG_CLOSE, TRIG_TOUCH], group = RULES_GROUP, tooltip = "Event that counts as a breakout. 'Close' requires the bar to close beyond the band, 'Intrabar Touch' triggers as soon as the bar high or low penetrates it. Both channels are built from prior bars only, so a breakout is never measured against a level the current bar is itself creating.")

dirInput = input.string(DIR_BOTH, "Trade Direction", options = [DIR_BOTH, DIR_LONG, DIR_SHORT], group = RULES_GROUP, tooltip = "Sides of the rules that are taken. 'Long & Short' reverses directly when the opposite entry rule fires while a position is open; the one-sided modes ignore opposite entries and simply go flat on the exit rule.")

showChannelInput = input.bool(true, "Show Entry Channel", group = STYLE_GROUP, tooltip = "Plot the entry channel: the highest high, lowest low and midline of the prior entry-length bars, with a gradient fill fading from the midline toward each band.")

showExitInput = input.bool(true, "Show Trailing Exit Level", group = STYLE_GROUP, tooltip = "While a position is open, plot the opposite extreme of the exit channel — the level whose break closes the trade. It trails below price during longs and above price during shorts, and can be read as a standalone trailing stop.")

showMarkersInput = input.bool(true, "Show Signal Markers", group = STYLE_GROUP, tooltip = "Draw entry triangles and exit crosses. Markers follow the position state, so a single entry prints per trade and nothing reprints until its exit — matching the mechanical sequence of the rules.")

colorBarsInput = input.bool(false, "Color Bars by Regime", group = STYLE_GROUP, tooltip = "Tint candles with the active regime — bullish while the rules hold a long, bearish while they hold a short, unchanged while flat. Useful when the rules act as a trend filter gating entries from other tools.")

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "colors", group = STYLE_GROUP, tooltip = "Color of the upper band and of long entries, exits and regime elements.")
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = STYLE_GROUP, tooltip = "Color of the lower band and of short entries, exits and regime elements.")

midColorInput = input.color(NEUTRAL_COLOR, "Midline", group = STYLE_GROUP, tooltip = "Color of the channel midline, the average of the two entry bands.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Channels are built on the prior bars only, so a breakout is well defined
upperEntry = ta.highest(high, entryLenInput)[1]
lowerEntry = ta.lowest(low, entryLenInput)[1]
midEntry   = math.avg(upperEntry, lowerEntry)

upperExit = ta.highest(high, exitLenInput)[1]
lowerExit = ta.lowest(low, exitLenInput)[1]

// Breakout trigger source
useCloseTrigger = trigInput == TRIG_CLOSE
upTrigger = useCloseTrigger ? close : high
dnTrigger = useCloseTrigger ? close : low

// Rule events
longEntryBreak  = not na(upperEntry) and upTrigger > upperEntry
shortEntryBreak = not na(lowerEntry) and dnTrigger < lowerEntry
longExitBreak   = not na(lowerExit)  and dnTrigger < lowerExit
shortExitBreak  = not na(upperExit)  and upTrigger > upperExit

longEnabled  = dirInput != DIR_SHORT
shortEnabled = dirInput != DIR_LONG

// Position state: +1 long, 0 flat, -1 short — one entry stands until its exit
var int pos = 0
int prevPos = pos

if prevPos == 1
    if shortEntryBreak and shortEnabled
        pos := -1
    else if longExitBreak
        pos := 0
else if prevPos == -1
    if longEntryBreak and longEnabled
        pos := 1
    else if shortExitBreak
        pos := 0
else
    if longEntryBreak and longEnabled
        pos := 1
    else if shortEntryBreak and shortEnabled
        pos := -1

// Sequenced signals from the state transitions
longEntry  = pos == 1  and prevPos != 1
shortEntry = pos == -1 and prevPos != -1
longExit   = prevPos == 1  and pos != 1
shortExit  = prevPos == -1 and pos != -1

// Trailing exit level of the open position
float exitLevel = pos == 1 ? lowerExit : pos == -1 ? upperExit : na

//---------------------------------------------------------------------------------------------------------------------}
// Entry Channel
//---------------------------------------------------------------------------------------------------------------------{
upperPlotId = plot(showChannelInput ? upperEntry : na, "Upper Band", bullColorInput, 1)
lowerPlotId = plot(showChannelInput ? lowerEntry : na, "Lower Band", bearColorInput, 1)
midPlotId   = plot(showChannelInput ? midEntry : na, "Midline", midColorInput, 1)

fill(midPlotId, upperPlotId, top_value = upperEntry, bottom_value = midEntry, top_color = color.new(bullColorInput, 80), bottom_color = color.new(bullColorInput, 100), title = "Upper Band Fill")
fill(midPlotId, lowerPlotId, top_value = midEntry, bottom_value = lowerEntry, top_color = color.new(bearColorInput, 100), bottom_color = color.new(bearColorInput, 80), title = "Lower Band Fill")

//---------------------------------------------------------------------------------------------------------------------}
// Trailing Exit & Signals
//---------------------------------------------------------------------------------------------------------------------{
// Hide the connecting segment on entries and reversals so each trade's exit trail starts clean
color exitColor = pos != prevPos ? na : pos == 1 ? bullColorInput : bearColorInput

plot(showExitInput ? exitLevel : na, "Trailing Exit Level", exitColor, 1, plot.style_linebr)

plotshape(showMarkersInput and longEntry, "Long Entry", shape.triangleup, location.belowbar, bullColorInput, size = size.small)
plotshape(showMarkersInput and shortEntry, "Short Entry", shape.triangledown, location.abovebar, bearColorInput, size = size.small)
plotshape(showMarkersInput and longExit ? lowerExit : na, "Long Exit", shape.xcross, location.absolute, bullColorInput, size = size.tiny)
plotshape(showMarkersInput and shortExit ? upperExit : na, "Short Exit", shape.xcross, location.absolute, bearColorInput, size = size.tiny)

color regimeColor = pos == 1 ? bullColorInput : pos == -1 ? bearColorInput : na
barcolor(colorBarsInput ? regimeColor : na, title = "Regime Bar Color")

plot(pos, "Trend Regime (+1 long, 0 flat, -1 short)", chart.fg_color, display = display.data_window)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(longEntry, "Long Entry", "Donchian trend rules on {{ticker}} ({{interval}}) — breakout above the entry channel high, long opened")

alertcondition(longExit, "Long Exit", "Donchian trend rules on {{ticker}} ({{interval}}) — break of the exit channel low, long closed")

alertcondition(shortEntry, "Short Entry", "Donchian trend rules on {{ticker}} ({{interval}}) — breakdown below the entry channel low, short opened")

alertcondition(shortExit, "Short Exit", "Donchian trend rules on {{ticker}} ({{interval}}) — break of the exit channel high, short closed")

//---------------------------------------------------------------------------------------------------------------------}
