//@version=6
indicator("Coppock Curve", "Coppock", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // readings above zero
BEAR_COLOR    = #f23645 // readings below zero
NEUTRAL_COLOR = #787b86 // exact zero / warm-up readings and the zero line

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
wmaLengthInput      = input.int(10, "WMA Length", minval = 1, group = "Settings", tooltip = "Length of the weighted moving average applied to the sum of the two rates of change.")
longRocLengthInput  = input.int(14, "Long RoC Length", minval = 1, group = "Settings", tooltip = "Lookback of the long rate of change, in bars. The original definition uses 14 monthly closes.")
shortRocLengthInput = input.int(11, "Short RoC Length", minval = 1, group = "Settings", tooltip = "Lookback of the short rate of change, in bars. The original definition uses 11 monthly closes.")
srcInput            = input.source(close, "Source", group = "Settings", tooltip = "Price series used for the rate of change calculations.")

curveColorInput = input.color(NEUTRAL_COLOR, "Coppock Curve", group = "Style", tooltip = "Color of the Coppock Curve line.")
bullColorInput  = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style", tooltip = "Line and fill color while the curve reads above zero.")
bearColorInput  = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style", tooltip = "Line and fill color while the curve reads below zero.")
zeroColorInput  = input.color(NEUTRAL_COLOR, "Zero Line", group = "Style", tooltip = "Color of the zero reference line.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
longRoc  = ta.roc(srcInput, longRocLengthInput)
shortRoc = ta.roc(srcInput, shortRocLengthInput)
coppock  = ta.wma(longRoc + shortRoc, wmaLengthInput)

crossUp   = ta.crossover(coppock, 0)
crossDown = ta.crossunder(coppock, 0)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish above zero, bearish below, neutral at zero
curveColor = coppock > 0 ? bullColorInput : coppock < 0 ? bearColorInput : curveColorInput

curvePlotId = plot(coppock, "Coppock Curve", curveColor)
zeroPlotId  = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward the zero line, following the line color
fill(curvePlotId, zeroPlotId, math.max(coppock, 0), math.min(coppock, 0), coppock > 0 ? color.new(curveColor, FILL_LINE_TRANSP) : color.new(curveColor, FILL_ZERO_TRANSP), coppock > 0 ? color.new(curveColor, FILL_ZERO_TRANSP) : color.new(curveColor, FILL_LINE_TRANSP), title = "Coppock Gradient")

hline(0, "Zero Line", zeroColorInput, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Zero Cross Up", "Coppock Curve crossed above zero")
alertcondition(crossDown, "Zero Cross Down", "Coppock Curve crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
