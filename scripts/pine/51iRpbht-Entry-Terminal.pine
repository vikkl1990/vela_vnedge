// --- Inputs ---
fractalLengthInput = input.int(12, "Fractal Length", minval = 3, maxval = 51, group = STRUCTURE_GROUP, tooltip = "BLVL fractal length. To preserve the supplied BLVL method, even values are internally increased by one before calculating the half-length pivots.")
requireBodyInput = input.bool(true, "Break With Close", group = STRUCTURE_GROUP, tooltip = "When enabled, a close beyond the BLVL level confirms the break. Otherwise, a wick beyond the level is sufficient.")
showBosInput = input.bool(true, "Show Directional BOS", group = STRUCTURE_GROUP, tooltip = "Shows only BOS events occurring after the latest CHoCH and in that CHoCH direction.")
maxStructureInput = input.int(100, "Maximum Current-Regime Breaks", minval = 10, maxval = 200, group = STRUCTURE_GROUP, tooltip = "Safety limit for CHoCH and BOS drawings kept inside the current regime.")

showCandidatesInput = input.bool(true, "Show Candidate Engine", group = CANDIDATE_GROUP, tooltip = "Displays live, unbroken BLVL levels after a CHoCH. Same-direction candidates are Trend Continuation; opposite-direction candidates are Potential CHoCH.")
