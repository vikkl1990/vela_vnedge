candidateTransparencyInput = input.int(25, "Candidate Transparency", minval = 0, maxval = 90, group = CANDIDATE_GROUP, tooltip = "Transparency applied to directional candidate lines and text.")

rbPivotLengthInput = input.int(12, "Pivot Length", minval = 1, maxval = 100, group = REJECTION_GROUP, tooltip = "Bars on each side used to confirm the rejected-block pivot. Default is 12.")
minWickPercentInput = input.float(50.0, "Minimum Wick %", minval = 0.0, maxval = 100.0, step = 5.0, group = REJECTION_GROUP, tooltip = "The rejection candle wick must occupy at least this percentage of its full range.")
minWickAtrInput = input.float(0.5, "Minimum Wick × ATR", minval = 0.0, step = 0.1, group = REJECTION_GROUP, tooltip = "Minimum rejection wick size measured in ATR. Set to zero to disable this filter.")
atrLengthInput = input.int(14, "ATR Length", minval = 1, group = REJECTION_GROUP, tooltip = "ATR length used by the rejected-block wick-size filter.")
