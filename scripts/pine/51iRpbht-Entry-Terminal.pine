fvgBosWindowInput = input.int(3, "FVG/BOS Association Window", minval = 0, maxval = 20, group = FVG_GROUP, tooltip = "Maximum bars allowed between the directional BOS and its FVG. Zero requires both on the same bar; the default allows displacement to complete over three bars.")
showEntryLabelsInput = input.bool(true, "Show BUY/SELL Entry", group = FVG_GROUP, tooltip = "Marks the first valid retest of the final FVG after the complete sequence.")
fvgEnableInput = input.bool(true, "Enable Engine", inline = "fvg1", group = FVG_GROUP, tooltip = "Enables the supplied FVG/Breaker engine and allows FVG sequence confirmation.")
fvgModeInput = input.string("Breakers", "Mode", options = ["FVG", "Breakers"], inline = "fvg1", group = FVG_GROUP, tooltip = "FVG removes mitigated gaps. Breakers converts mitigated gaps into inverse FVG (IFVG) zones. Breakers is the default mode.")
fvgShowLastInput = input.int(1, "Show Last", minval = 0, maxval = 50, group = FVG_GROUP, tooltip = "Maximum number of bullish and bearish engine zones displayed.")
fvgMitigationInput = input.string("Close", "Mitigation", options = ["Close", "Wick", "Avg"], group = FVG_GROUP, tooltip = "Close uses the body extreme, Wick uses the candle extreme, and Avg uses the FVG midpoint as the mitigation trigger.")
fvgThresholdInput = input.float(0.0, "Threshold", minval = 0.0, maxval = 2.0, step = 0.1, group = FVG_GROUP, tooltip = "Filters insignificant FVG displacement using ATR(200), as in the supplied engine.")
fvgHideOverlapInput = input.bool(true, "Hide Overlap", group = FVG_GROUP, tooltip = "Removes overlapping FVG records using the supplied overlap rules.")
fvgShowMidlineInput = input.bool(true, "Show Mid-Line", group = FVG_GROUP, tooltip = "Displays the midpoint of each FVG or breaker zone.")
