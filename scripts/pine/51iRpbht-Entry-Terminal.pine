showAtrBoundariesInput = input.bool(true, "Show ATR High/Low", group = ATR_BOUNDARY_GROUP, tooltip = "Creates ATR High and ATR Low boundaries from each CHoCH candle and reports whether the first boundary break agrees with the CHoCH direction.")
atrBoundaryLengthInput = input.int(14, "ATR Length", minval = 1, group = ATR_BOUNDARY_GROUP, tooltip = "ATR length used for CHoCH boundaries and HH/LL target boxes.")
