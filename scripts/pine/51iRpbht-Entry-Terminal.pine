// --- Latest Integrated Build ---
indicator("Entry Terminal", shorttitle = "Entry Terminal", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 10, calc_bars_count = 50000)

// --- Constants ---
const color BULL_COLOR = #089981
const color BEAR_COLOR = #f23645
const color BLUE_COLOR = #5b9cf6
const int ZONE_FILL_TRANSPARENCY = 84
const int ZONE_BORDER_TRANSPARENCY = 35
const int MIDLINE_TRANSPARENCY = 25
