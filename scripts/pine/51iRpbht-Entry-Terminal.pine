atrBoundaryBarsRightInput = input.int(5, "Bars to Right", minval = 1, maxval = 50, group = ATR_BOUNDARY_GROUP, tooltip = "Projects active ATR boundaries this many chart bars to the right. The lines freeze at the first confirmed boundary break.")
showAtrBoundaryLabelsInput = input.bool(true, "Show Boundary Labels", group = ATR_BOUNDARY_GROUP, tooltip = "Shows normal-size ATR High/Low labels and the MATCH or COUNTER result after a break.")
showAtrTargetBoxesInput = input.bool(false, "Show HH/LL ATR Target Boxes", group = ATR_BOUNDARY_GROUP, tooltip = "Projects optional ATR target boxes above HH Liquidity and below LL Liquidity.")
