//@version=6
indicator("52 Week High/Low", "52W H/L", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
showAllTimeInput = input.bool(false, "Show All-Time High/Low", group = "Settings", tooltip = "Additionally display the all-time high and all-time low, tracked over the symbol's full available history.")

high52ColorInput  = input.color(#089981, "52 Week High", group = "Style", tooltip = "Color of the 52 week high level.")
low52ColorInput   = input.color(#f23645, "52 Week Low", group = "Style", tooltip = "Color of the 52 week low level.")
allTimeColorInput = input.color(#787b86, "All-Time High/Low", group = "Style", tooltip = "Color of the all-time high and all-time low levels.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
[hi52, lo52] = request.security(syminfo.tickerid, "1W", [ta.highest(high, 52), ta.lowest(low, 52)])

var float ath = na
var float atl = na
ath := math.max(nz(ath, high), high)
atl := math.min(nz(atl, low), low)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(hi52, "52 Week High", high52ColorInput, 2, plot.style_stepline)
plot(lo52, "52 Week Low", low52ColorInput, 2, plot.style_stepline)

plot(showAllTimeInput ? ath : na, "All-Time High", allTimeColorInput, 1, plot.style_steplinebr)
plot(showAllTimeInput ? atl : na, "All-Time Low", allTimeColorInput, 1, plot.style_steplinebr)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
// Crossings are evaluated against the previous bar levels, the realtime 52 week window contains the current bar extremes by construction
newHigh = ta.crossover(close, hi52[1])
newLow  = ta.crossunder(close, lo52[1])

alertcondition(newHigh, "New 52 Week High", "Close crossed above the 52 week high")
alertcondition(newLow, "New 52 Week Low", "Close crossed below the 52 week low")
//----------------------------------------------------------------------------------------------------------------------}
