//@version=6
indicator("Rolling Beta Drift Monitor [Pineify]", shorttitle = "Beta Drift [Pineify]", overlay = false, precision = 3)

string GROUP_MODEL = "Relationship Model"
string GROUP_STATE = "State Thresholds"
string GROUP_VISUALS = "Visual System"

string benchmarkSymbol = input.symbol("AMEX:SPY", "Benchmark", group = GROUP_MODEL)
int regressionLength = input.int(60, "Relationship window", minval = 20, maxval = 300, group = GROUP_MODEL)
int driftLength = input.int(80, "Drift reference", minval = 30, maxval = 400, group = GROUP_MODEL)
float minimumCoverage = input.float(85.0, "Minimum paired coverage (%)", minval = 60.0, maxval = 100.0, step = 1.0, group = GROUP_MODEL)

float driftEnter = input.float(2.0, "Beta drift entry Z", minval = 1.0, maxval = 5.0, step = 0.1, group = GROUP_STATE)
float driftRelease = input.float(1.2, "Beta drift release Z", minval = 0.5, maxval = 4.0, step = 0.1, group = GROUP_STATE)
float minimumCorrelation = input.float(0.35, "Relationship correlation floor", minval = 0.05, maxval = 0.90, step = 0.05, group = GROUP_STATE)
float residualShockEnter = input.float(1.5, "Residual shock entry Z", minval = 0.5, maxval = 5.0, step = 0.1, group = GROUP_STATE)
float residualShockRelease = input.float(0.7, "Residual shock release Z", minval = -1.0, maxval = 4.0, step = 0.1, group = GROUP_STATE)

bool showBetaCorridor = input.bool(true, "Show beta reference corridor", group = GROUP_VISUALS)
bool showCorrelation = input.bool(true, "Show correlation line", group = GROUP_VISUALS)
bool showResidualPulse = input.bool(true, "Show normalized residual shock", group = GROUP_VISUALS)
bool showBackground = input.bool(true, "Show state background", group = GROUP_VISUALS)
bool showMarkers = input.bool(true, "Show transition markers", group = GROUP_VISUALS)
bool showDashboard = input.bool(true, "Show relationship dashboard", group = GROUP_VISUALS)

color positiveColor = input.color(color.rgb(20, 201, 190), "Positive beta drift", group = GROUP_VISUALS)
color negativeColor = input.color(color.rgb(255, 92, 122), "Negative beta drift", group = GROUP_VISUALS)
color correlationColor = input.color(color.rgb(247, 195, 72), "Correlation", group = GROUP_VISUALS)
color decouplingColor = input.color(color.rgb(179, 136, 255), "Decoupling", group = GROUP_VISUALS)
color neutralColor = input.color(color.rgb(190, 203, 219), "Stable / unavailable", group = GROUP_VISUALS)

f_number(float value) =>
    na(value) ? "--" : str.tostring(value, "#.###")

f_percent(float value) =>
    na(value) ? "--" : str.tostring(value, "#.0") + "%"

f_state(int state) =>
    switch state
        1 => "STABLE"
        2 => "BETA UP"
        3 => "BETA DOWN"
        4 => "DECOUPLING"
        => "WARMUP"

f_state_color(int state) =>
    switch state
        2 => positiveColor
        3 => negativeColor
        4 => decouplingColor
        => neutralColor

float benchmarkReturn = request.security(benchmarkSymbol, timeframe.period, close > 0 and close[1] > 0 ? math.log(close / close[1]) : na, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
float assetReturn = close > 0 and close[1] > 0 ? math.log(close / close[1]) : na
bool validPair = not na(assetReturn) and not na(benchmarkReturn)

float pairWeight = validPair ? 1.0 : 0.0
float weightedAsset = validPair ? assetReturn : 0.0
float weightedBenchmark = validPair ? benchmarkReturn : 0.0
float pairCount = math.sum(pairWeight, regressionLength)
float assetSum = math.sum(weightedAsset, regressionLength)
float benchmarkSum = math.sum(weightedBenchmark, regressionLength)
float assetSquareSum = math.sum(validPair ? assetReturn * assetReturn : 0.0, regressionLength)
float benchmarkSquareSum = math.sum(validPair ? benchmarkReturn * benchmarkReturn : 0.0, regressionLength)
float crossSum = math.sum(validPair ? assetReturn * benchmarkReturn : 0.0, regressionLength)
float requiredPairs = math.ceil(float(regressionLength) * minimumCoverage * 0.01)
bool relationshipWindowReady = not na(pairCount) and pairCount >= requiredPairs

float assetMean = relationshipWindowReady ? assetSum / pairCount : na
float benchmarkMean = relationshipWindowReady ? benchmarkSum / pairCount : na
float assetSecondMoment = relationshipWindowReady ? assetSquareSum / pairCount : na
float benchmarkSecondMoment = relationshipWindowReady ? benchmarkSquareSum / pairCount : na
float crossMoment = relationshipWindowReady ? crossSum / pairCount : na

float assetVariance = relationshipWindowReady ? math.max(assetSecondMoment - assetMean * assetMean, 0.0) : na
float benchmarkVariance = relationshipWindowReady ? math.max(benchmarkSecondMoment - benchmarkMean * benchmarkMean, 0.0) : na
float covariance = relationshipWindowReady ? crossMoment - assetMean * benchmarkMean : na
float varianceFloor = 1e-14
bool regressionReady = relationshipWindowReady and assetVariance > varianceFloor and benchmarkVariance > varianceFloor and validPair
float beta = regressionReady ? covariance / benchmarkVariance : na
float correlation = regressionReady ? math.max(-1.0, math.min(1.0, covariance / math.sqrt(assetVariance * benchmarkVariance))) : na
float residualVariance = regressionReady ? math.max(assetVariance - covariance * covariance / benchmarkVariance, 0.0) : na
float residualBps = regressionReady ? 10000.0 * math.sqrt(residualVariance) : na
float pairedCoverage = not na(pairCount) ? 100.0 * pairCount / float(regressionLength) : na

bool priorBetaValid = not na(beta[1])
float priorBeta = priorBetaValid ? beta[1] : 0.0
float betaHistoryCount = math.sum(priorBetaValid ? 1.0 : 0.0, driftLength)
float betaHistorySum = math.sum(priorBeta, driftLength)
float betaHistorySquareSum = math.sum(priorBeta * priorBeta, driftLength)
float requiredHistory = math.ceil(float(driftLength) * minimumCoverage * 0.01)
bool betaHistoryReady = not na(betaHistoryCount) and betaHistoryCount >= requiredHistory
float betaHistoryMean = betaHistoryReady ? betaHistorySum / betaHistoryCount : na
float betaHistorySecondMoment = betaHistoryReady ? betaHistorySquareSum / betaHistoryCount : na
float betaHistoryVariance = betaHistoryReady ? math.max(betaHistorySecondMoment - betaHistoryMean * betaHistoryMean, 0.0) : na
float betaHistorySigma = betaHistoryReady ? math.sqrt(betaHistoryVariance) : na

bool priorResidualValid = not na(residualBps[1])
float priorResidual = priorResidualValid ? residualBps[1] : 0.0
float residualHistoryCount = math.sum(priorResidualValid ? 1.0 : 0.0, driftLength)
float residualHistorySum = math.sum(priorResidual, driftLength)
float residualHistorySquareSum = math.sum(priorResidual * priorResidual, driftLength)
bool residualHistoryReady = not na(residualHistoryCount) and residualHistoryCount >= requiredHistory
float residualHistoryMean = residualHistoryReady ? residualHistorySum / residualHistoryCount : na
float residualHistorySecondMoment = residualHistoryReady ? residualHistorySquareSum / residualHistoryCount : na
float residualHistoryVariance = residualHistoryReady ? math.max(residualHistorySecondMoment - residualHistoryMean * residualHistoryMean, 0.0) : na
float residualHistorySigma = residualHistoryReady ? math.sqrt(residualHistoryVariance) : na

bool priorCorrelationValid = not na(correlation[1])
float priorCorrelation = priorCorrelationValid ? correlation[1] : 0.0
float correlationHistoryCount = math.sum(priorCorrelationValid ? 1.0 : 0.0, driftLength)
float correlationHistorySum = math.sum(priorCorrelation, driftLength)
bool correlationHistoryReady = not na(correlationHistoryCount) and correlationHistoryCount >= requiredHistory
float correlationHistoryMean = correlationHistoryReady ? correlationHistorySum / correlationHistoryCount : na

float betaScaleFloor = 1e-6
float residualScaleFloor = 1e-6
float betaDriftZ = betaHistoryReady and betaHistorySigma > betaScaleFloor ? (beta - betaHistoryMean) / betaHistorySigma : na
float residualShockZ = residualHistoryReady and residualHistorySigma > residualScaleFloor ? (residualBps - residualHistoryMean) / residualHistorySigma : na
float historyCoverage = betaHistoryReady and residualHistoryReady and correlationHistoryReady ? 100.0 * math.min(betaHistoryCount, math.min(residualHistoryCount, correlationHistoryCount)) / float(driftLength) : na
bool modelReady = regressionReady and betaHistoryReady and residualHistoryReady and correlationHistoryReady and not na(betaDriftZ) and not na(residualShockZ)
bool correlationFlip = modelReady and math.abs(correlation) >= minimumCorrelation and math.abs(correlationHistoryMean) >= minimumCorrelation and math.sign(correlation) != math.sign(correlationHistoryMean)
bool residualDecoupling = modelReady and math.abs(correlation) < minimumCorrelation and residualShockZ >= residualShockEnter

if driftRelease >= driftEnter
    runtime.error("Beta drift release Z must be below entry Z.")
if residualShockRelease >= residualShockEnter
    runtime.error("Residual shock release Z must be below entry Z.")

var int relationshipState = 0
if barstate.isconfirmed
    if not modelReady
        relationshipState := 0
    else if relationshipState == 4
        bool recoupled = math.abs(correlation) >= minimumCorrelation * 1.15 and residualShockZ < residualShockRelease and not correlationFlip
        relationshipState := recoupled ? (betaDriftZ >= driftEnter ? 2 : betaDriftZ <= -driftEnter ? 3 : 1) : 4
    else if correlationFlip or residualDecoupling
        relationshipState := 4
    else if relationshipState == 2
        relationshipState := betaDriftZ >= driftRelease ? 2 : betaDriftZ <= -driftEnter ? 3 : 1
    else if relationshipState == 3
        relationshipState := betaDriftZ <= -driftRelease ? 3 : betaDriftZ >= driftEnter ? 2 : 1
    else
        relationshipState := betaDriftZ >= driftEnter ? 2 : betaDriftZ <= -driftEnter ? 3 : 1

color stateColor = f_state_color(relationshipState)
int corridorTransparency = modelReady ? int(math.max(82.0, 94.0 - 12.0 * math.min(pairedCoverage, historyCoverage) * 0.01)) : 95
float corridorUpper = betaHistoryReady ? betaHistoryMean + betaHistorySigma : na
float corridorLower = betaHistoryReady ? betaHistoryMean - betaHistorySigma : na
float normalizedResidualPulse = modelReady ? math.min(math.max(residualShockZ, 0.0) / residualShockEnter, 1.5) : na

bool enteredPositiveDrift = barstate.isconfirmed and relationshipState == 2 and relationshipState[1] != 2
bool enteredNegativeDrift = barstate.isconfirmed and relationshipState == 3 and relationshipState[1] != 3
bool correlationDirectionChanged = barstate.isconfirmed and correlationFlip and not correlationFlip[1]

pUpper = plot(showBetaCorridor ? corridorUpper : na, "Prior Beta Mean + Sigma", color = color.new(neutralColor, 70), linewidth = 1)
pLower = plot(showBetaCorridor ? corridorLower : na, "Prior Beta Mean - Sigma", color = color.new(neutralColor, 70), linewidth = 1)
plot(showBetaCorridor ? betaHistoryMean : na, "Prior Beta Mean", color = color.new(neutralColor, 30), linewidth = 1)
fill(pUpper, pLower, color = showBetaCorridor ? color.new(stateColor, corridorTransparency) : na, title = "Beta Drift Corridor")
plot(modelReady ? beta : na, "Rolling Beta", color = stateColor, linewidth = 3)
plot(showCorrelation and regressionReady ? correlation : na, "Rolling Correlation", color = correlationColor, linewidth = 2)
plot(showResidualPulse ? normalizedResidualPulse : na, "Normalized Residual Shock", color = color.new(decouplingColor, 28), style = plot.style_columns)
hline(0.0, "Zero", color = color.new(neutralColor, 78))
hline(1.0, "Reference One", color = color.new(neutralColor, 88), linestyle = hline.style_dotted)
bgcolor(showBackground and relationshipState != 0 ? color.new(stateColor, 93) : na, title = "Relationship State")
plotshape(showMarkers and enteredPositiveDrift ? beta : na, title = "Positive Beta Drift Entry", style = shape.triangleup, location = location.absolute, color = positiveColor, size = size.tiny)
plotshape(showMarkers and enteredNegativeDrift ? beta : na, title = "Negative Beta Drift Entry", style = shape.triangledown, location = location.absolute, color = negativeColor, size = size.tiny)
plotshape(showMarkers and correlationDirectionChanged ? beta : na, title = "Correlation Direction Change", style = shape.diamond, location = location.absolute, color = decouplingColor, size = size.tiny)

plot(modelReady ? betaDriftZ : na, "Beta Drift Z", color = color.new(stateColor, 100), display = display.data_window)
plot(modelReady ? residualBps : na, "Residual Volatility (bps per bar)", color = color.new(decouplingColor, 100), display = display.data_window)
plot(modelReady ? residualShockZ : na, "Residual Volatility Z", color = color.new(decouplingColor, 100), display = display.data_window)
plot(pairedCoverage, "Paired Coverage (%)", color = color.new(neutralColor, 100), display = display.data_window)
plot(historyCoverage, "Drift History Coverage (%)", color = color.new(neutralColor, 100), display = display.data_window)

alertcondition(enteredPositiveDrift or enteredNegativeDrift, "Confirmed Beta Drift Extreme", "Rolling Beta Drift Monitor confirmed a beta drift extreme versus its prior rolling history.")
alertcondition(correlationDirectionChanged, "Confirmed Correlation Direction Change", "Rolling Beta Drift Monitor confirmed that correlation changed direction relative to its prior rolling mean.")

var table dashboard = table.new(position.top_right, 2, 8, bgcolor = color.new(color.rgb(16, 23, 34), 10), frame_color = color.new(neutralColor, 65), frame_width = 1)
if barstate.islast
    if showDashboard
        table.cell(dashboard, 0, 0, "RELATIONSHIP", text_color = color.white, bgcolor = color.new(stateColor, 68), text_size = size.small)
        table.cell(dashboard, 1, 0, f_state(relationshipState), text_color = stateColor, bgcolor = color.new(stateColor, 88), text_size = size.small)
        table.cell(dashboard, 0, 1, "Benchmark", text_color = neutralColor, text_size = size.small)
        table.cell(dashboard, 1, 1, benchmarkSymbol, text_color = color.white, text_size = size.small)
        table.cell(dashboard, 0, 2, "Beta", text_color = neutralColor, text_size = size.small)
        table.cell(dashboard, 1, 2, f_number(beta), text_color = stateColor, text_size = size.small)
        table.cell(dashboard, 0, 3, "Drift Z", text_color = neutralColor, text_size = size.small)
        table.cell(dashboard, 1, 3, f_number(betaDriftZ), text_color = stateColor, text_size = size.small)
        table.cell(dashboard, 0, 4, "Correlation", text_color = neutralColor, text_size = size.small)
        table.cell(dashboard, 1, 4, f_number(correlation), text_color = correlationColor, text_size = size.small)
        table.cell(dashboard, 0, 5, "Residual", text_color = neutralColor, text_size = size.small)
        table.cell(dashboard, 1, 5, f_number(residualBps) + " bps", text_color = decouplingColor, text_size = size.small)
        table.cell(dashboard, 0, 6, "Pair coverage", text_color = neutralColor, text_size = size.small)
        table.cell(dashboard, 1, 6, f_percent(pairedCoverage), text_color = color.white, text_size = size.small)
        table.cell(dashboard, 0, 7, "History", text_color = neutralColor, text_size = size.small)
        table.cell(dashboard, 1, 7, f_percent(historyCoverage), text_color = color.white, text_size = size.small)
    else
        table.clear(dashboard, 0, 0, 1, 7)
