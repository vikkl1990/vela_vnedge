//@version=6
indicator("Wave Degree Hierarchy", "Wave Degree Hierarchy", overlay = true, max_lines_count = 500, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

int MAX_BASE_PIVOTS = 400
int DRAW_BARS_LIMIT = 9500
int LADDER_TOP_IDX  = 8

string STRUCTURE_GROUP  = 'Degree Structure'
string DISCIPLINE_GROUP = 'Degree Discipline'
string DASHBOARD_GROUP  = 'Dashboard'
string STYLE_GROUP      = 'Style'

string MODE_NOTATION = 'Notation'
string MODE_NAME     = 'Degree Name'
string MODE_NONE     = 'None'

string SIZE_TINY   = 'Tiny'
string SIZE_SMALL  = 'Small'
string SIZE_NORMAL = 'Normal'

color BULL_COLOR        = #089981
color BEAR_COLOR        = #f23645
color TRANSPARENT_COLOR = #00000000

// R.N. Elliott's nine named degrees, ordered from the smallest to the largest scale
var array<string> degreeNamesArray = array.from('Subminuette', 'Minuette', 'Minute', 'Minor', 'Intermediate', 'Primary', 'Cycle', 'Supercycle', 'Grand Supercycle')

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{

lengthInput = input.int(8, 'Base Pivot Length', minval = 2, maxval = 50, group = STRUCTURE_GROUP, tooltip = 'Pivot half-length used to detect the swings of the lowest displayed degree. Every higher degree is derived recursively from the pivots one degree below it, so each wave is simultaneously a structure at its own degree and a component of the wave one degree higher.')

degreesInput = input.int(3, 'Degrees Displayed', minval = 2, maxval = 4, group = STRUCTURE_GROUP, tooltip = 'Number of nested degrees built on top of the base swings. Higher degrees confirm later since they are derived from completed lower-degree structure.')

baseNameInput = input.string('Minute', 'Lowest Degree Name', options = ['Subminuette', 'Minuette', 'Minute', 'Minor', 'Intermediate', 'Primary', 'Cycle', 'Supercycle', 'Grand Supercycle'], group = STRUCTURE_GROUP, tooltip = 'Elliott ladder name assigned to the lowest displayed degree. Degrees above it walk up the ladder (Subminuette, Minuette, Minute, Minor, Intermediate, Primary, Cycle, Supercycle, Grand Supercycle) and the selection is clamped so the highest displayed degree never exceeds Grand Supercycle. Degree is structural, not chronological, so pick the name matching your own top-down count.')

minPropInput = input.float(0.236, 'Min Correction Proportion (Price)', minval = 0, maxval = 0.9, step = 0.01, group = DISCIPLINE_GROUP, tooltip = 'A correction should be roughly proportional to the wave it corrects at the same degree. Corrections retracing less than this fraction of the prior wave are flagged as too small for their assigned degree (they may belong one degree lower). Set to 0 to disable.')

maxPricePropInput = input.float(1, 'Max Correction Proportion (Price)', minval = 0.5, maxval = 10, step = 0.05, group = DISCIPLINE_GROUP, tooltip = 'A correction traveling further in price than the entire wave it corrects at the same degree is flagged as a degree violation, grounds to reject the degree assignment under stricter approaches.')

maxTimePropInput = input.float(1, 'Max Correction Proportion (Time)', minval = 0.5, maxval = 10, step = 0.05, group = DISCIPLINE_GROUP, tooltip = 'A correction lasting longer than the entire wave it corrects at the same degree is flagged as a degree violation. Raise this bound to only flag extreme duration disproportion.')

degreesAboveInput = input.int(1, 'Trend Reference (Degrees Above)', minval = 1, maxval = 3, group = DISCIPLINE_GROUP, tooltip = 'With-trend / counter-trend context compares the lowest (execution) degree leg with the leg this many degrees above it, following the practice of trading in the direction of the wave one or two degrees above the execution timeframe.')

tintBgInput = input.bool(false, 'Tint Counter-Trend Background', inline = 'tint', group = DISCIPLINE_GROUP, tooltip = 'Shades the chart background while the execution degree leg points against the reference degree leg.')
tintBgColorInput = input.color(color.new(#f23645, 92), '', inline = 'tint', group = DISCIPLINE_GROUP)

showDashInput = input.bool(true, 'Show Dashboard', group = DASHBOARD_GROUP, tooltip = 'Dashboard listing each displayed degree from the highest down: ladder name, labeling notation, current leg direction, last correction proportions with its degree-discipline status, and the invalidation level whose break kills the current-leg count at that degree, plus the trend context row.')

dashPosInput = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left', 'Middle Right'], group = DASHBOARD_GROUP, tooltip = 'Dashboard location on the chart.')

dashSizeInput = input.string(SIZE_SMALL, 'Size', options = [SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group = DASHBOARD_GROUP, tooltip = 'Dashboard text size.')

labelModeInput = input.string(MODE_NOTATION, 'Pivot Labels', options = [MODE_NOTATION, MODE_NAME, MODE_NONE], group = STYLE_GROUP, tooltip = 'Notation labels each pivot with its structural position inside the parent leg, written in the degree\'s own Elliott notation (e.g. [i] [ii] at Minute, 1 2 at Minor, (1) (2) at Intermediate); it is positional bookkeeping, not an impulse count. The highest displayed degree has no parent on the chart and shows its degree name instead. Degree Name tags every pivot with its ladder name.')

labelSizeInput = input.string(SIZE_TINY, 'Label Size', options = [SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group = STYLE_GROUP, tooltip = 'Text size of the pivot labels.')

flagDisproInput = input.bool(true, 'Flag Disproportion On Labels', group = STYLE_GROUP, tooltip = 'Appends … to corrections too small for their assigned degree and ⚠ to degree violations (corrections traveling further or lasting longer than the wave they correct at the same degree).')

showDevInput = input.bool(true, 'Developing Legs', group = STYLE_GROUP, tooltip = 'Dotted projection from each degree\'s last confirmed pivot to the current price, marking the leg still under construction at that degree.')

showInvInput = input.bool(true, 'Invalidation Levels', group = STYLE_GROUP, tooltip = 'Dashed level at each degree\'s prior pivot extreme. The hard rules apply within a single degree, so this is exactly the extreme that, if broken, kills the current-leg count at that degree.')

maxDrawnInput = input.int(50, 'Drawn Swings Per Degree', minval = 10, maxval = 120, group = STYLE_GROUP, tooltip = 'Most recent swings drawn for each degree. Lower degrees cover less chart time with the same number of swings, keeping older sections clean.')

deg1ColorInput = input.color(#787b86, 'Degree Colors', inline = 'degcolors', group = STYLE_GROUP)
deg2ColorInput = input.color(#5b9cf6, '', inline = 'degcolors', group = STYLE_GROUP)
deg3ColorInput = input.color(#ff9800, '', inline = 'degcolors', group = STYLE_GROUP)
deg4ColorInput = input.color(#e91e63, '', inline = 'degcolors', group = STYLE_GROUP)

violationColorInput = input.color(#f23645, 'Violation', inline = 'flagcolors', group = STYLE_GROUP)

// derived settings
string labelSizeValue = labelSizeInput == SIZE_TINY ? size.tiny : labelSizeInput == SIZE_SMALL ? size.small : size.normal
string dashSizeValue  = dashSizeInput  == SIZE_TINY ? size.tiny : dashSizeInput  == SIZE_SMALL ? size.small : size.normal

string dashPositionValue = switch dashPosInput
    'Top Right'    => position.top_right
    'Top Left'     => position.top_left
    'Bottom Right' => position.bottom_right
    'Bottom Left'  => position.bottom_left
    => position.middle_right

int baseNameIdx = array.indexof(degreeNamesArray, baseNameInput)
int effBaseIdx  = math.max(0, math.min(baseNameIdx, LADDER_TOP_IDX + 1 - degreesInput))

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// lowercase roman numeral of a positive integer (sufficient for structural position indices)
f_roman(int numberValue) =>
    string result = ''
    int remaining = math.max(1, numberValue)
    while remaining >= 10
        result := result + 'x'
        remaining -= 10
    if remaining >= 9
        result := result + 'ix'
        remaining -= 9
    if remaining >= 5
        result := result + 'v'
        remaining -= 5
    if remaining >= 4
        result := result + 'iv'
        remaining -= 4
    while remaining >= 1
        result := result + 'i'
        remaining -= 1
    result

// renders an index in the labeling convention of a ladder degree:
// Subminuette i, Minuette (i), Minute [i], Minor 1, Intermediate (1), Primary [1], Cycle I, Supercycle (I), Grand Supercycle [I]
f_notation(int ladderIdx, int numberValue) =>
    int band = ladderIdx / 3
    int wrap = ladderIdx % 3
    string coreText = band == 0 ? f_roman(numberValue) : band == 1 ? str.tostring(numberValue) : str.upper(f_roman(numberValue))
    wrap == 1 ? '(' + coreText + ')' : wrap == 2 ? '[' + coreText + ']' : coreText

// registers a confirmed pivot into a zigzag, returns 0 = no change, 1 = new swing point, 2 = last swing point extended
f_addPivot(array<int> barArr, array<float> priceArr, array<bool> highArr, int pivotBar, float pivotPrice, bool isHigh, int maxSize) =>
    int changeType = 0
    int n = array.size(barArr)
    if n == 0
        array.push(barArr, pivotBar)
        array.push(priceArr, pivotPrice)
        array.push(highArr, isHigh)
        changeType := 1
    else
        bool lastHigh = array.get(highArr, n - 1)
        if isHigh == lastHigh
            float lastPrice = array.get(priceArr, n - 1)
            if (isHigh and pivotPrice >= lastPrice) or (not isHigh and pivotPrice <= lastPrice)
                array.set(barArr, n - 1, pivotBar)
                array.set(priceArr, n - 1, pivotPrice)
                changeType := 2
        else if pivotBar != array.get(barArr, n - 1)
            array.push(barArr, pivotBar)
            array.push(priceArr, pivotPrice)
            array.push(highArr, isHigh)
            changeType := 1
            if array.size(barArr) > maxSize
                array.shift(barArr)
                array.shift(priceArr)
                array.shift(highArr)
    changeType

// derives the next degree up: a pivot survives to the parent degree when it is more extreme than
// its same-type neighbors one degree below, with alternation kept by extreme replacement, so every
// parent pivot is literally one of its component-degree pivots
f_buildHigher(array<int> srcBarArr, array<float> srcPriceArr, array<bool> srcHighArr, array<int> dstBarArr, array<float> dstPriceArr, array<bool> dstHighArr) =>
    array.clear(dstBarArr)
    array.clear(dstPriceArr)
    array.clear(dstHighArr)
    int n = array.size(srcBarArr)
    if n >= 5
        for i = 2 to n - 3
            float p = array.get(srcPriceArr, i)
            bool isHigh = array.get(srcHighArr, i)
            float prevSame = array.get(srcPriceArr, i - 2)
            float nextSame = array.get(srcPriceArr, i + 2)
            bool candidate = isHigh ? p >= prevSame and p > nextSame : p <= prevSame and p < nextSame
            if candidate
                int m = array.size(dstBarArr)
                if m == 0
                    array.push(dstBarArr, array.get(srcBarArr, i))
                    array.push(dstPriceArr, p)
                    array.push(dstHighArr, isHigh)
                else if array.get(dstHighArr, m - 1) != isHigh
                    array.push(dstBarArr, array.get(srcBarArr, i))
                    array.push(dstPriceArr, p)
                    array.push(dstHighArr, isHigh)
                else if (isHigh and p > array.get(dstPriceArr, m - 1)) or (not isHigh and p < array.get(dstPriceArr, m - 1))
                    array.set(dstBarArr, m - 1, array.get(srcBarArr, i))
                    array.set(dstPriceArr, m - 1, p)

// proportion discipline: each counter-trend swing (a correction relative to the parent-degree leg)
// is compared in price and time with the same-degree wave it corrects; flags 0 = none, 1 = too small, 2 = violation
// returns the price ratio, time ratio, flag and pivot bar of the most recent evaluated correction
f_computeFlags(array<int> barArr, array<float> priceArr, array<bool> highArr, array<int> parentBarArr, array<bool> parentHighArr, array<int> flagArr) =>
    array.clear(flagArr)
    float lastRatioP = na
    float lastRatioT = na
    int lastFlag = 0
    int lastFlagBar = -1
    int n = array.size(barArr)
    int parentSize = array.size(parentBarArr)
    int parentPtr = -1
    if n > 0
        for k = 0 to n - 1
            int flagValue = 0
            if k >= 2
                int startBar = array.get(barArr, k - 1)
                bool advance = true
                while advance
                    int nextPtr = parentPtr + 1
                    if nextPtr >= parentSize
                        advance := false
                    else if array.get(parentBarArr, nextPtr) <= startBar
                        parentPtr := nextPtr
                    else
                        advance := false
                if parentPtr >= 0
                    bool parentLegUp = not array.get(parentHighArr, parentPtr)
                    bool swingUp = array.get(highArr, k)
                    if swingUp != parentLegUp
                        float rangeSwing = math.abs(array.get(priceArr, k) - array.get(priceArr, k - 1))
                        float rangePrior = math.abs(array.get(priceArr, k - 1) - array.get(priceArr, k - 2))
                        int barsSwing = array.get(barArr, k) - array.get(barArr, k - 1)
                        int barsPrior = array.get(barArr, k - 1) - array.get(barArr, k - 2)
                        if rangePrior > 0 and barsPrior > 0
                            float priceRatio = rangeSwing / rangePrior
                            float timeRatio = barsSwing / (barsPrior * 1.0)
                            flagValue := priceRatio > maxPricePropInput or timeRatio > maxTimePropInput ? 2 : minPropInput > 0 and priceRatio < minPropInput ? 1 : 0
                            lastRatioP := priceRatio
                            lastRatioT := timeRatio
                            lastFlag := flagValue
                            lastFlagBar := array.get(barArr, k)
            array.push(flagArr, flagValue)
    [lastRatioP, lastRatioT, lastFlag, lastFlagBar]

// true once per genuinely new swing pivot at a degree (appends flip the alternation, extensions do not)
f_newPivotEvent(array<bool> highArr, int slot, array<bool> seenHighArr, array<bool> seenAnyArr) =>
    bool eventFired = false
    int n = array.size(highArr)
    if n > 0
        bool lastHigh = array.get(highArr, n - 1)
        if not array.get(seenAnyArr, slot)
            eventFired := true
        else if array.get(seenHighArr, slot) != lastHigh
            eventFired := true
        array.set(seenHighArr, slot, lastHigh)
        array.set(seenAnyArr, slot, true)
    eventFired

// current leg direction of a degree: 1 = up (last pivot was a low), -1 = down, 0 = unknown
f_legDir(array<bool> highArr) =>
    int dirValue = 0
    int n = array.size(highArr)
    if n > 0
        dirValue := array.get(highArr, n - 1) ? -1 : 1
    dirValue

// dotted projection from the last confirmed pivot of a degree to the current price
f_devLine(array<int> barArr, array<float> priceArr, line existing, color lineColor, bool active) =>
    line result = existing
    int n = array.size(barArr)
    if not active or n == 0
        if not na(result)
            line.delete(result)
            result := na
    else
        int x1 = math.max(array.get(barArr, n - 1), bar_index - DRAW_BARS_LIMIT)
        float y1 = array.get(priceArr, n - 1)
        if na(result)
            result := line.new(x1, y1, bar_index, close, color = lineColor, style = line.style_dotted)
        else
            line.set_xy1(result, x1, y1)
            line.set_xy2(result, bar_index, close)
    result

// dashed horizontal level at a degree's prior pivot extreme, the price whose break invalidates the current-leg count at that degree
f_invLine(array<int> barArr, array<float> priceArr, line existing, color lineColor, bool active) =>
    line result = existing
    int n = array.size(barArr)
    if not active or n == 0
        if not na(result)
            line.delete(result)
            result := na
    else
        int x1 = math.max(array.get(barArr, n - 1), bar_index - DRAW_BARS_LIMIT)
        float levelPrice = array.get(priceArr, n - 1)
        if na(result)
            result := line.new(x1, levelPrice, bar_index, levelPrice, color = lineColor, style = line.style_dashed)
        else
            line.set_xy1(result, x1, levelPrice)
            line.set_xy2(result, bar_index, levelPrice)
    result

// invalidation state of a degree: the prior pivot extreme and whether the current price has broken it against the leg
f_invState(array<float> priceArr, array<bool> highArr) =>
    float levelPrice = na
    bool brokenNow = false
    int n = array.size(priceArr)
    if n > 0
        levelPrice := array.get(priceArr, n - 1)
        brokenNow := array.get(highArr, n - 1) ? close > levelPrice : close < levelPrice
    [levelPrice, brokenNow]

// draws one degree of the hierarchy: zigzag segments, notation / name labels and disproportion marks
f_drawDegree(array<int> barArr, array<float> priceArr, array<bool> highArr, array<int> flagArr, array<int> parentBarArr, bool isTop, int ladderIdx, string degreeName, color degreeColor, int widthValue, array<line> lineStore, array<label> labelStore) =>
    int n = array.size(barArr)
    if n >= 2
        int oldestAllowed = bar_index - DRAW_BARS_LIMIT
        int startK = math.max(1, n - maxDrawnInput)
        // structural position of each pivot inside its parent leg (resets when a parent pivot is reached)
        array<int> numArray = array.new<int>()
        int parentPtr = -1
        int childCount = 0
        int parentSize = array.size(parentBarArr)
        for k = 0 to n - 1
            childCount += 1
            array.push(numArray, childCount)
            int childBar = array.get(barArr, k)
            int nextPtr = parentPtr + 1
            if nextPtr < parentSize
                if array.get(parentBarArr, nextPtr) <= childBar
                    parentPtr := nextPtr
                    childCount := 0
        for k = startK to n - 1
            int x1 = array.get(barArr, k - 1)
            if x1 >= oldestAllowed
                array.push(lineStore, line.new(x1, array.get(priceArr, k - 1), array.get(barArr, k), array.get(priceArr, k), color = degreeColor, width = widthValue))
        if labelModeInput != MODE_NONE or flagDisproInput
            for k = math.max(0, startK - 1) to n - 1
                int x = array.get(barArr, k)
                if x >= oldestAllowed
                    bool isHigh = array.get(highArr, k)
                    int flagValue = 0
                    if array.size(flagArr) > k
                        flagValue := array.get(flagArr, k)
                    string baseText = labelModeInput == MODE_NOTATION ? (isTop ? degreeName : f_notation(ladderIdx, array.get(numArray, k))) : labelModeInput == MODE_NAME ? degreeName : ''
                    string suffixText = flagDisproInput ? (flagValue == 2 ? '⚠' : flagValue == 1 ? '…' : '') : ''
                    string labelText = baseText == '' ? suffixText : suffixText == '' ? baseText : baseText + ' ' + suffixText
                    if labelText != ''
                        color textColorValue = flagValue == 2 and flagDisproInput ? violationColorInput : degreeColor
                        array.push(labelStore, label.new(x, array.get(priceArr, k), labelText, color = TRANSPARENT_COLOR, textcolor = textColorValue, style = isHigh ? label.style_label_down : label.style_label_up, size = labelSizeValue))

//---------------------------------------------------------------------------------------------------------------------}
// Swing Detection & Degree Hierarchy
//---------------------------------------------------------------------------------------------------------------------{

// degree 1 (lowest) is the base zigzag, degrees 2..4 are derived recursively from the degree below
var array<int>   bar1Array   = array.new<int>()
var array<float> price1Array = array.new<float>()
var array<bool>  high1Array  = array.new<bool>()
var array<int>   bar2Array   = array.new<int>()
var array<float> price2Array = array.new<float>()
var array<bool>  high2Array  = array.new<bool>()
var array<int>   bar3Array   = array.new<int>()
var array<float> price3Array = array.new<float>()
var array<bool>  high3Array  = array.new<bool>()
var array<int>   bar4Array   = array.new<int>()
var array<float> price4Array = array.new<float>()
var array<bool>  high4Array  = array.new<bool>()

var array<int> flag1Array = array.new<int>()
var array<int> flag2Array = array.new<int>()
var array<int> flag3Array = array.new<int>()
var array<int> flag4Array = array.new<int>()

// per-degree alert bookkeeping and latest correction statistics (slot = degree - 1)
var array<bool>  seenHighArray    = array.new<bool>(4, false)
var array<bool>  seenAnyArray     = array.new<bool>(4, false)
var array<int>   violSeenArray    = array.new<int>(4, -1)
var array<int>   smallSeenArray   = array.new<int>(4, -1)
var array<float> lastRatioPArray  = array.new<float>(4, na)
var array<float> lastRatioTArray  = array.new<float>(4, na)
var array<int>   lastFlagArray    = array.new<int>(4, 0)
var array<int>   lastFlagBarArray = array.new<int>(4, -1)

var bool structureDirty = false
var bool everDrawn      = false

float pivotHighPrice = ta.pivothigh(lengthInput, lengthInput)
float pivotLowPrice  = ta.pivotlow(lengthInput, lengthInput)

int baseChange = 0
if not na(pivotHighPrice)
    int changeType = f_addPivot(bar1Array, price1Array, high1Array, bar_index - lengthInput, pivotHighPrice, true, MAX_BASE_PIVOTS)
    if changeType != 0
        baseChange := changeType
if not na(pivotLowPrice)
    int changeType = f_addPivot(bar1Array, price1Array, high1Array, bar_index - lengthInput, pivotLowPrice, false, MAX_BASE_PIVOTS)
    if changeType != 0
        baseChange := changeType

bool newPivot1Alert     = false
bool newPivot2Alert     = false
bool newPivot3Alert     = false
bool newPivot4Alert     = false
bool violationAlert     = false
bool tooSmallAlert      = false

if baseChange != 0
    f_buildHigher(bar1Array, price1Array, high1Array, bar2Array, price2Array, high2Array)
    if degreesInput >= 3
        f_buildHigher(bar2Array, price2Array, high2Array, bar3Array, price3Array, high3Array)
    if degreesInput >= 4
        f_buildHigher(bar3Array, price3Array, high3Array, bar4Array, price4Array, high4Array)

    // proportion discipline for every degree that has a parent on the chart
    [ratioP1, ratioT1, flagValue1, flagBar1] = f_computeFlags(bar1Array, price1Array, high1Array, bar2Array, high2Array, flag1Array)
    array.set(lastRatioPArray, 0, ratioP1)
    array.set(lastRatioTArray, 0, ratioT1)
    array.set(lastFlagArray, 0, flagValue1)
    array.set(lastFlagBarArray, 0, flagBar1)
    if degreesInput >= 3
        [ratioP2, ratioT2, flagValue2, flagBar2] = f_computeFlags(bar2Array, price2Array, high2Array, bar3Array, high3Array, flag2Array)
        array.set(lastRatioPArray, 1, ratioP2)
        array.set(lastRatioTArray, 1, ratioT2)
        array.set(lastFlagArray, 1, flagValue2)
        array.set(lastFlagBarArray, 1, flagBar2)
    if degreesInput >= 4
        [ratioP3, ratioT3, flagValue3, flagBar3] = f_computeFlags(bar3Array, price3Array, high3Array, bar4Array, high4Array, flag3Array)
        array.set(lastRatioPArray, 2, ratioP3)
        array.set(lastRatioTArray, 2, ratioT3)
        array.set(lastFlagArray, 2, flagValue3)
        array.set(lastFlagBarArray, 2, flagBar3)

    newPivot1Alert := f_newPivotEvent(high1Array, 0, seenHighArray, seenAnyArray)
    newPivot2Alert := f_newPivotEvent(high2Array, 1, seenHighArray, seenAnyArray)
    if degreesInput >= 3
        newPivot3Alert := f_newPivotEvent(high3Array, 2, seenHighArray, seenAnyArray)
    if degreesInput >= 4
        newPivot4Alert := f_newPivotEvent(high4Array, 3, seenHighArray, seenAnyArray)

    for d = 0 to degreesInput - 2
        int flagValue = array.get(lastFlagArray, d)
        int flagBar = array.get(lastFlagBarArray, d)
        if flagValue == 2 and flagBar != array.get(violSeenArray, d)
            violationAlert := true
            array.set(violSeenArray, d, flagBar)
        if flagValue == 1 and flagBar != array.get(smallSeenArray, d)
            tooSmallAlert := true
            array.set(smallSeenArray, d, flagBar)

    structureDirty := true

//---------------------------------------------------------------------------------------------------------------------}
// Trend Context
//---------------------------------------------------------------------------------------------------------------------{

var int prevContextState = -1

int execDir   = f_legDir(high1Array)
int refDegree = math.min(1 + degreesAboveInput, degreesInput)
int refDir    = refDegree == 2 ? f_legDir(high2Array) : refDegree == 3 ? f_legDir(high3Array) : f_legDir(high4Array)

bool contextKnown    = execDir != 0 and refDir != 0
bool counterTrendNow = contextKnown and execDir != refDir

int contextState = contextKnown ? (counterTrendNow ? 0 : 1) : -1
bool contextChangeAlert = contextState != -1 and prevContextState != -1 and contextState != prevContextState
prevContextState := contextState

bgcolor(tintBgInput and counterTrendNow ? tintBgColorInput : na, title = 'Counter-Trend Tint')

//---------------------------------------------------------------------------------------------------------------------}
// Invalidation Levels
//---------------------------------------------------------------------------------------------------------------------{

// the hard rules apply within a single degree: each degree's prior pivot extreme is the exact level whose break kills its current-leg count
[invLevel1, invBroken1] = f_invState(price1Array, high1Array)
[invLevel2, invBroken2] = f_invState(price2Array, high2Array)
[invLevel3, invBroken3] = f_invState(price3Array, high3Array)
[invLevel4, invBroken4] = f_invState(price4Array, high4Array)

bool invBreak1Alert = invBroken1 and not invBroken1[1]
bool invBreak2Alert = invBroken2 and not invBroken2[1]
bool invBreak3Alert = invBroken3 and not invBroken3[1]
bool invBreak4Alert = invBroken4 and not invBroken4[1]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

var array<line>  drawnLineArray  = array.new<line>()
var array<label> drawnLabelArray = array.new<label>()

var line devLine1 = na
var line devLine2 = na
var line devLine3 = na
var line devLine4 = na

var line invLine1 = na
var line invLine2 = na
var line invLine3 = na
var line invLine4 = na

var table dashTable = na

if barstate.islast and (structureDirty or not everDrawn)
    int lineCount = array.size(drawnLineArray)
    if lineCount > 0
        for i = 0 to lineCount - 1
            line.delete(array.get(drawnLineArray, i))
    array.clear(drawnLineArray)
    int labelCount = array.size(drawnLabelArray)
    if labelCount > 0
        for i = 0 to labelCount - 1
            label.delete(array.get(drawnLabelArray, i))
    array.clear(drawnLabelArray)

    f_drawDegree(bar1Array, price1Array, high1Array, flag1Array, bar2Array, false, effBaseIdx, array.get(degreeNamesArray, effBaseIdx), deg1ColorInput, 1, drawnLineArray, drawnLabelArray)
    f_drawDegree(bar2Array, price2Array, high2Array, flag2Array, degreesInput >= 3 ? bar3Array : bar2Array, degreesInput == 2, effBaseIdx + 1, array.get(degreeNamesArray, effBaseIdx + 1), deg2ColorInput, 2, drawnLineArray, drawnLabelArray)
    if degreesInput >= 3
        f_drawDegree(bar3Array, price3Array, high3Array, flag3Array, degreesInput >= 4 ? bar4Array : bar3Array, degreesInput == 3, effBaseIdx + 2, array.get(degreeNamesArray, effBaseIdx + 2), deg3ColorInput, 3, drawnLineArray, drawnLabelArray)
    if degreesInput >= 4
        f_drawDegree(bar4Array, price4Array, high4Array, flag4Array, bar4Array, true, effBaseIdx + 3, array.get(degreeNamesArray, effBaseIdx + 3), deg4ColorInput, 4, drawnLineArray, drawnLabelArray)

    structureDirty := false
    everDrawn      := true

if barstate.islast
    devLine1 := f_devLine(bar1Array, price1Array, devLine1, color.new(deg1ColorInput, 30), showDevInput)
    devLine2 := f_devLine(bar2Array, price2Array, devLine2, color.new(deg2ColorInput, 30), showDevInput)
    devLine3 := f_devLine(bar3Array, price3Array, devLine3, color.new(deg3ColorInput, 30), showDevInput and degreesInput >= 3)
    devLine4 := f_devLine(bar4Array, price4Array, devLine4, color.new(deg4ColorInput, 30), showDevInput and degreesInput >= 4)
    invLine1 := f_invLine(bar1Array, price1Array, invLine1, color.new(deg1ColorInput, 40), showInvInput)
    invLine2 := f_invLine(bar2Array, price2Array, invLine2, color.new(deg2ColorInput, 40), showInvInput)
    invLine3 := f_invLine(bar3Array, price3Array, invLine3, color.new(deg3ColorInput, 40), showInvInput and degreesInput >= 3)
    invLine4 := f_invLine(bar4Array, price4Array, invLine4, color.new(deg4ColorInput, 40), showInvInput and degreesInput >= 4)

if barstate.islast and showDashInput
    if na(dashTable)
        dashTable := table.new(dashPositionValue, 6, degreesInput + 2, bgcolor = color.new(chart.bg_color, 30), frame_color = color.new(chart.fg_color, 80), frame_width = 1, border_color = color.new(chart.fg_color, 90), border_width = 1)
        table.merge_cells(dashTable, 0, degreesInput + 1, 5, degreesInput + 1)

    color headerColor = color.new(chart.fg_color, 20)
    table.cell(dashTable, 0, 0, 'Degree', text_color = headerColor, text_size = dashSizeValue)
    table.cell(dashTable, 1, 0, 'Notation', text_color = headerColor, text_size = dashSizeValue)
    table.cell(dashTable, 2, 0, 'Leg', text_color = headerColor, text_size = dashSizeValue)
    table.cell(dashTable, 3, 0, 'Last Correction', text_color = headerColor, text_size = dashSizeValue)
    table.cell(dashTable, 4, 0, 'Status', text_color = headerColor, text_size = dashSizeValue)
    table.cell(dashTable, 5, 0, 'Invalidation', text_color = headerColor, text_size = dashSizeValue)

    for row = 1 to degreesInput
        int d = degreesInput + 1 - row
        int ladderIdx = effBaseIdx + d - 1
        color degreeColor = d == 1 ? deg1ColorInput : d == 2 ? deg2ColorInput : d == 3 ? deg3ColorInput : deg4ColorInput
        int legDir = d == 1 ? f_legDir(high1Array) : d == 2 ? f_legDir(high2Array) : d == 3 ? f_legDir(high3Array) : f_legDir(high4Array)
        float ratioP = array.get(lastRatioPArray, d - 1)
        float ratioT = array.get(lastRatioTArray, d - 1)
        int flagValue = array.get(lastFlagArray, d - 1)

        float invLevel = d == 1 ? invLevel1 : d == 2 ? invLevel2 : d == 3 ? invLevel3 : invLevel4
        bool invBroken = d == 1 ? invBroken1 : d == 2 ? invBroken2 : d == 3 ? invBroken3 : invBroken4

        string notationSample = f_notation(ladderIdx, 1) + ' ' + f_notation(ladderIdx, 2) + ' ' + f_notation(ladderIdx, 3)
        string legText = legDir > 0 ? '▲' : legDir < 0 ? '▼' : '—'
        color legColor = legDir > 0 ? BULL_COLOR : legDir < 0 ? BEAR_COLOR : color.new(chart.fg_color, 50)
        string correctionText = na(ratioP) ? '—' : str.tostring(ratioP, '0.00') + '× P · ' + str.tostring(ratioT, '0.00') + '× T'
        string statusText = na(ratioP) ? '—' : flagValue == 2 ? 'Violation' : flagValue == 1 ? 'Too small' : 'OK'
        color statusColor = na(ratioP) ? color.new(chart.fg_color, 50) : flagValue == 2 ? violationColorInput : flagValue == 1 ? color.new(chart.fg_color, 30) : color.new(chart.fg_color, 40)
        string invText = na(invLevel) ? '—' : str.tostring(invLevel, format.mintick) + (invBroken ? ' ✗' : '')
        color invColor = invBroken ? violationColorInput : color.new(chart.fg_color, 30)

        table.cell(dashTable, 0, row, array.get(degreeNamesArray, ladderIdx), text_color = degreeColor, text_size = dashSizeValue)
        table.cell(dashTable, 1, row, notationSample, text_color = color.new(chart.fg_color, 30), text_size = dashSizeValue)
        table.cell(dashTable, 2, row, legText, text_color = legColor, text_size = dashSizeValue)
        table.cell(dashTable, 3, row, correctionText, text_color = color.new(chart.fg_color, 30), text_size = dashSizeValue)
        table.cell(dashTable, 4, row, statusText, text_color = statusColor, text_size = dashSizeValue)
        table.cell(dashTable, 5, row, invText, text_color = invColor, text_size = dashSizeValue)

    string execName = array.get(degreeNamesArray, effBaseIdx)
    string refName = array.get(degreeNamesArray, effBaseIdx + refDegree - 1)
    string contextText = contextKnown ? execName + (execDir > 0 ? ' ▲' : ' ▼') + '  vs  ' + refName + (refDir > 0 ? ' ▲' : ' ▼') + '  :  ' + (counterTrendNow ? 'counter-trend' : 'with trend') : 'Context: awaiting reference degree swings'
    color contextColor = contextKnown ? (counterTrendNow ? BEAR_COLOR : BULL_COLOR) : color.new(chart.fg_color, 40)
    table.cell(dashTable, 0, degreesInput + 1, contextText, text_color = contextColor, text_size = dashSizeValue)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(newPivot1Alert, 'New Swing — Degree 1 (Lowest)', 'wave degree hierarchy: new swing pivot at the lowest displayed degree (the latest pivot may extend until the next opposite pivot locks it)')
alertcondition(newPivot2Alert, 'New Swing — Degree 2', 'wave degree hierarchy: new swing pivot at degree 2, one degree above execution')
alertcondition(newPivot3Alert, 'New Swing — Degree 3', 'wave degree hierarchy: new swing pivot at degree 3')
alertcondition(newPivot4Alert, 'New Swing — Degree 4 (Highest)', 'wave degree hierarchy: new swing pivot at the highest displayed degree')
alertcondition(violationAlert, 'Degree Violation', 'wave degree hierarchy: a correction traveled further or lasted longer than the wave it corrects at the same degree — disproportionate for its assigned degree')
alertcondition(tooSmallAlert, 'Correction Too Small', 'wave degree hierarchy: a correction retraced less than the minimum proportion of the wave it corrects — it may belong one degree lower')
alertcondition(contextChangeAlert, 'Trend Context Change', 'wave degree hierarchy: the execution degree leg flipped between with-trend and counter-trend relative to the reference degree')
alertcondition(invBreak1Alert, 'Invalidation Break — Degree 1 (Lowest)', 'wave degree hierarchy: price broke the prior pivot extreme of the lowest displayed degree — the current-leg count at that degree is invalidated')
alertcondition(invBreak2Alert, 'Invalidation Break — Degree 2', 'wave degree hierarchy: price broke the prior pivot extreme of degree 2 — the current-leg count at that degree is invalidated')
alertcondition(invBreak3Alert, 'Invalidation Break — Degree 3', 'wave degree hierarchy: price broke the prior pivot extreme of degree 3 — the current-leg count at that degree is invalidated')
alertcondition(invBreak4Alert, 'Invalidation Break — Degree 4 (Highest)', 'wave degree hierarchy: price broke the prior pivot extreme of the highest displayed degree — the current-leg count at that degree is invalidated')

//---------------------------------------------------------------------------------------------------------------------}
