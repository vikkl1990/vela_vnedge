//@version=6
indicator("Rejection Radar PRO  Hariss 369", overlay=true,
     max_boxes_count=200, max_labels_count=200)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupHTF = "01. HTF KAMA FILTER"
useHTFKAMA = input.bool(true, "Use 1H KAMA Filter", group=groupHTF)
htfTF      = input.timeframe("60", "HTF Timeframe", group=groupHTF)
kamaLen    = input.int(21, "KAMA Length", minval=1, group=groupHTF)
kamaFast   = input.int(2, "KAMA Fast", minval=1, group=groupHTF)
kamaSlow   = input.int(30, "KAMA Slow", minval=2, group=groupHTF)

groupPivot = "02. REJECTION ZONES"
pivotLen   = input.int(5, "Pivot Length", minval=2, group=groupPivot)
atrLen     = input.int(14, "ATR Length", minval=1, group=groupPivot)
zoneATR    = input.float(0.35, "Zone Width ATR", minval=0.05, step=0.05, group=groupPivot)
minTouches = input.int(1, "Minimum Zone Touches", minval=1, group=groupPivot)

groupReject = "03. REJECTION CANDLE"
wickRatio  = input.float(1.5, "Minimum Wick / Body", minval=0.5, step=0.1, group=groupReject)
closePct   = input.float(0.35, "Close Location Threshold", minval=0.05, maxval=0.50, step=0.05, group=groupReject)
useEngulf  = input.bool(false, "Allow Engulfing Rejection", group=groupReject)

groupExit = "04. EXIT SIGNALS"
showExitLabels = input.bool(true, "Show Exit Labels", group=groupExit)
confirmClose   = input.bool(true, "Confirm On Candle Close", group=groupExit)

groupDisplay = "05. DISPLAY"
showKAMA      = input.bool(true, "Show 1H KAMA", group=groupDisplay)
showZones     = input.bool(true, "Show Rejection Zones", group=groupDisplay)
showPivot     = input.bool(false, "Show Pivot Levels", group=groupDisplay)
showSignals   = input.bool(true, "Show Rejection Markers", group=groupDisplay)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. KAMA FUNCTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

kamaFunc(src, length, fastLength, slowLength) =>
    change = math.abs(src - src[length])
    volatility = 0.0

    for i = 0 to length - 1
        volatility += math.abs(src[i] - src[i + 1])

    er = volatility != 0.0 ? change / volatility : 0.0

    fastSC = 2.0 / (fastLength + 1.0)
    slowSC = 2.0 / (slowLength + 1.0)

    sc = math.pow(er * (fastSC - slowSC) + slowSC, 2)

    var float kama = na
    kama := na(kama[1]) ? src : kama[1] + sc * (src - kama[1])

    kama

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. NON-REPAINTING 1H KAMA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_htfKama() =>
    k = kamaFunc(close, kamaLen, kamaFast, kamaSlow)
    k[1]

htfKama = request.security(
     syminfo.tickerid,
     htfTF,
     f_htfKama(),
     lookahead=barmerge.lookahead_on)

// HTF trend
htfBull = close > htfKama
htfBear = close < htfKama

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. ATR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

atr = ta.atr(atrLen)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5. CONFIRMED PIVOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivotLow  = ta.pivotlow(low, pivotLen, pivotLen)

newResistance = not na(pivotHigh)
newSupport    = not na(pivotLow)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. CURRENT REJECTION LEVELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float resistance = na
var float support    = na

if newResistance
    resistance := pivotHigh

if newSupport
    support := pivotLow

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. REJECTION ZONE WIDTH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

zoneWidth = atr * zoneATR

resUpper = resistance + zoneWidth
resLower = resistance - zoneWidth

supUpper = support + zoneWidth
supLower = support - zoneWidth

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8. CANDLE STRUCTURE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

body = math.abs(close - open)
safeBody = math.max(body, syminfo.mintick)

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

candleRange = math.max(high - low, syminfo.mintick)

// Bearish rejection:
// Large upper wick + close near lower part of candle
bearishWick =
     upperWick >= safeBody * wickRatio and
     close <= low + candleRange * closePct

// Bullish rejection:
// Large lower wick + close near upper part of candle
bullishWick =
     lowerWick >= safeBody * wickRatio and
     close >= high - candleRange * closePct

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9. ENGULFING REJECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bearishEngulf =
     useEngulf and
     close < open and
     close < low[1] and
     open >= close[1]

bullishEngulf =
     useEngulf and
     close > open and
     close > high[1] and
     open <= close[1]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 10. PRICE INSIDE REJECTION ZONE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

insideResistance =
     not na(resistance) and
     high >= resLower and
     low <= resUpper

insideSupport =
     not na(support) and
     high >= supLower and
     low <= supUpper

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 11. REJECTION CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Long trade exits at resistance
longRejection =
     insideResistance and
     (bearishWick or bearishEngulf)

// Short trade exits at support
shortRejection =
     insideSupport and
     (bullishWick or bullishEngulf)

// Optional HTF directional filter
exitLongSignal =
     longRejection and
     (not useHTFKAMA or htfBull)

exitShortSignal =
     shortRejection and
     (not useHTFKAMA or htfBear)

// Candle-close confirmation
exitLong =
     confirmClose ? exitLongSignal and barstate.isconfirmed : exitLongSignal

exitShort =
     confirmClose ? exitShortSignal and barstate.isconfirmed : exitShortSignal

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 12. ZONE PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pResUpper = plot(
     showZones ? resUpper : na,
     title="Resistance Zone Upper",
     color=color.new(color.red, 70),
     linewidth=1)

pResLower = plot(
     showZones ? resLower : na,
     title="Resistance Zone Lower",
     color=color.new(color.red, 70),
     linewidth=1)

fill(
     pResUpper,
     pResLower,
     color=color.new(color.red, 88),
     title="Probable Resistance Rejection Zone")

pSupUpper = plot(
     showZones ? supUpper : na,
     title="Support Zone Upper",
     color=color.new(color.green, 70),
     linewidth=1)

pSupLower = plot(
     showZones ? supLower : na,
     title="Support Zone Lower",
     color=color.new(color.green, 70),
     linewidth=1)

fill(
     pSupUpper,
     pSupLower,
     color=color.new(color.green, 88),
     title="Probable Support Rejection Zone")

// Pivot levels
plot(
     showPivot ? resistance : na,
     title="Resistance Pivot",
     color=color.red,
     linewidth=1,
     style=plot.style_linebr)

plot(
     showPivot ? support : na,
     title="Support Pivot",
     color=color.green,
     linewidth=1,
     style=plot.style_linebr)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 13. HTF KAMA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plot(
     showKAMA ? htfKama : na,
     title="1H HTF KAMA",
     color=color.fuchsia,
     linewidth=2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 14. REJECTION MARKERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plotshape(
     showSignals and longRejection,
     title="Bearish Price Rejection",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.tiny,
     text="R")

plotshape(
     showSignals and shortRejection,
     title="Bullish Price Rejection",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.green,
     size=size.tiny,
     text="R")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 15. EXIT LABELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if showExitLabels and exitLong
    label.new(
         bar_index,
         high,
         "EXIT LONG\nREJECTION",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.small)

if showExitLabels and exitShort
    label.new(
         bar_index,
         low,
         "EXIT SHORT\nREJECTION",
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.small)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 16. ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(
     exitLong,
     title="EXIT LONG - Price Rejection",
     message="5M bearish price rejection detected at probable resistance area.")

alertcondition(
     exitShort,
     title="EXIT SHORT - Price Rejection",
     message="5M bullish price rejection detected at probable support area.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 17. TREND STATUS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table dash = table.new(position.top_right, 2, 4)

if barstate.islast
    table.cell(dash, 0, 0, "5M REJECTION EXIT", text_color=color.white)
    table.cell(dash, 1, 0, "PRO", text_color=color.white)

    table.cell(dash, 0, 1, "1H KAMA", text_color=color.white)
    table.cell(
         dash,
         1,
         1,
         htfBull ? "BULLISH" : htfBear ? "BEARISH" : "NEUTRAL",
         text_color=color.white)

    table.cell(dash, 0, 2, "Resistance", text_color=color.white)
    table.cell(
         dash,
         1,
         2,
         na(resistance) ? "—" : str.tostring(resistance, format.mintick),
         text_color=color.white)

    table.cell(dash, 0, 3, "Support", text_color=color.white)
    table.cell(
         dash,
         1,
         3,
         na(support) ? "—" : str.tostring(support, format.mintick),
         text_color=color.white)