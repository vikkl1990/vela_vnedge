//@version=6
indicator('HTF CISD Projections','HTF CISD Projections', overlay = true, max_lines_count = 500, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
GREEN                   = #089981
RED                     = #F23645

BULLISH                 = 1
BEARISH                 = 0

DOTTED                  = 'Dotted'
DASHED                  = 'Dashed'
SOLID                   = 'Solid'

LEVELS_GROUP            = 'Projections'
STYLE_GROUP             = 'Style'
FILTER_GROUP            = 'HTF Filter'

runBarsThresholdTooltip = 'Minimum number of bars of each setup.'
cisdFilterTooltip       = 'Enable or disable the filter and select the length. This filter identifies setups at the top or bottom of the range over the last X bars.'
invalidateCISDTooltip   = 'Stop the level extension on ChoCH against CISD. This occurs when there is a close below the bottom on bullish setups and a close above the top on bearish setups.'
baseLevelTooltip        = 'Enable or disable CISD price level and select style.'

runBarsThresholdInput   = input.int(    2,      'Bars Threshold',           tooltip = runBarsThresholdTooltip,  minval = 1 )
cisdFilterInput         = input.bool(   true,   'CISD Filter',              tooltip = '',                       inline = 'filter')
cisdFilterLengthInput   = input.int(    20,     '',                         tooltip = cisdFilterTooltip,        inline = 'filter')
invalidateCISDInput     = input.bool(   true,   'Invalidate CISDs on CHoCH',tooltip = invalidateCISDTooltip)

htfFilterInput          = input.bool(   true,   'Enable HTF Trend Filter (1H & 4H)', group = FILTER_GROUP, tooltip = 'Only show CISDs when price aligns with the 1H and 4H EMA trend.')
emaLengthInput          = input.int(    200,    'Trend EMA Length', group = FILTER_GROUP)

level1Input             = input.bool(   true,   '', group = LEVELS_GROUP, inline = '1')
level1MultiplierInput   = input.float(  1.0,    '', group = LEVELS_GROUP, inline = '1')
level1StyleInput        = input.string( SOLID,  '', group = LEVELS_GROUP, inline = '1', options = [DOTTED,DASHED,SOLID])
level2Input             = input.bool(   true,   '', group = LEVELS_GROUP, inline = '2')
level2MultiplierInput   = input.float(  2.0,    '', group = LEVELS_GROUP, inline = '2')
level2StyleInput        = input.string( SOLID,  '', group = LEVELS_GROUP, inline = '2', options = [DOTTED,DASHED,SOLID])
level3Input             = input.bool(   true,   '', group = LEVELS_GROUP, inline = '3')
level3MultiplierInput   = input.float(  2.5,    '', group = LEVELS_GROUP, inline = '3')
level3StyleInput        = input.string( SOLID,  '', group = LEVELS_GROUP, inline = '3', options = [DOTTED,DASHED,SOLID])
level4Input             = input.bool(   true,   '', group = LEVELS_GROUP, inline = '4')
level4MultiplierInput   = input.float(  4.0,    '', group = LEVELS_GROUP, inline = '4')
level4StyleInput        = input.string( SOLID,  '', group = LEVELS_GROUP, inline = '4', options = [DOTTED,DASHED,SOLID])
level5Input             = input.bool(   true,   '', group = LEVELS_GROUP, inline = '5')
level5MultiplierInput   = input.float(  4.5,    '', group = LEVELS_GROUP, inline = '5')
level5StyleInput        = input.string( SOLID,  '', group = LEVELS_GROUP, inline = '5', options = [DOTTED,DASHED,SOLID])

baseLevelInput          = input.bool(   true,   'CISD Level',       group = STYLE_GROUP, tooltip = '',              inline = '0')
baseLevelStyleInput     = input.string( DOTTED, '',                 group = STYLE_GROUP, tooltip = baseLevelTooltip,inline = '0', options = [DOTTED,DASHED,SOLID])
labelsSizeInput         = input.int(    7,      'Labels size',      group = STYLE_GROUP)
bullishColorInput       = input.color(  GREEN,  'Bullish Color',    group = STYLE_GROUP)
bearishColorInput       = input.color(  RED,    'Bearish Color',    group = STYLE_GROUP)
backgroundFillInput     = input.bool(   true,   'Background Fill',  group = STYLE_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
type run
    float openPrice
    float top
    float bottom
    int bias
    bool triggered
    int startTime
    int endTime
    int bars
    array<line> levels
    array<label> tags
    array<int> reached
    float highest
    float lowest
    bool invalid = false
    
type level
    float multiplier    
    string levelStyle

type background
    float base      = na
    float extension = na
    color fillColor = na

var background customBackground = background.new()
var array<run> runs             = array.new<run>()
var array<run> cisds            = array.new<run>()
var array<level> customLevels   = array.new<level>()
var array<float> customLevelsRaw= array.new<float>()

if barstate.isfirst
    if level1Input
        customLevels.push(level.new(level1MultiplierInput,level1StyleInput))
        customLevelsRaw.push(level1MultiplierInput)
    if level2Input
        customLevels.push(level.new(level2MultiplierInput,level2StyleInput))
        customLevelsRaw.push(level2MultiplierInput)
    if level3Input
        customLevels.push(level.new(level3MultiplierInput,level3StyleInput))
        customLevelsRaw.push(level3MultiplierInput)
    if level4Input
        customLevels.push(level.new(level4MultiplierInput,level4StyleInput))
        customLevelsRaw.push(level4MultiplierInput)
    if level5Input
        customLevels.push(level.new(level5MultiplierInput,level5StyleInput)) 
        customLevelsRaw.push(level5MultiplierInput)

bool bullishBar     = close >= close[1]
bool bearishBar     = close < close[1]
float lowestPrice   = ta.lowest(cisdFilterLengthInput)
float highestPrice  = ta.highest(cisdFilterLengthInput)
float volatility    = 0.3*ta.atr(200)

// HTF Trend
htf1_ema = request.security(syminfo.tickerid, "60", ta.ema(close, emaLengthInput))
htf2_ema = request.security(syminfo.tickerid, "240", ta.ema(close, emaLengthInput))

bool isBullishTrend = not htfFilterInput or (close > htf1_ema and close > htf2_ema)
bool isBearishTrend = not htfFilterInput or (close < htf1_ema and close < htf2_ema)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
debugRun(run currentRun) =>
    log.info('{0}\n{1} {2} {3} {4} {5} {6} {7}\n{8} {9}',bar_index,currentRun.openPrice,currentRun.top,currentRun.bottom,currentRun.highest,currentRun.lowest,currentRun.bias,currentRun.bars,str.format_time(currentRun.startTime, 'yyyy-MM-dd HH:mm', 'Europe/Madrid'),str.format_time(currentRun.endTime, 'yyyy-MM-dd HH:mm', 'Europe/Madrid'))

flushBackground() =>
    customBackground.base       := na
    customBackground.extension  := na
    customBackground.fillColor  := color(na)

invalidateCISD(run currentRun) =>
    if not currentRun.invalid and invalidateCISDInput
        bool invalid        = (currentRun.bias == BEARISH and close < currentRun.bottom) or (currentRun.bias == BULLISH and close > currentRun.top)
        currentRun.invalid  := invalid
        if invalid
            flushBackground()

checkCISD(run currentRun) =>
    bool thresholdOK    = currentRun.bars >= runBarsThresholdInput    
    bool topFilterOk    = currentRun.bias == BEARISH and currentRun.bottom == currentRun.lowest
    bool bottomFilterOk = currentRun.bias == BULLISH and currentRun.top == currentRun.highest
    bool filterOK       = not cisdFilterInput or (cisdFilterInput and (topFilterOk or bottomFilterOk))
    
    if not currentRun.triggered and thresholdOK and filterOK
        bool bullishTrigger = currentRun.bias == BEARISH and bullishBar and close > currentRun.openPrice and close[1] <= currentRun.openPrice and isBullishTrend
        bool bearishTrigger = currentRun.bias == BULLISH and bearishBar and close < currentRun.openPrice and close[1] >= currentRun.openPrice and isBearishTrend

        if bullishTrigger or bearishTrigger
            currentRun.endTime      := time
            currentRun.triggered    := true                    

            if currentRun.bias == BULLISH
                currentRun.top := math.max(runs.last().top,currentRun.top)
            if currentRun.bias == BEARISH
                currentRun.bottom := math.min(runs.last().bottom,currentRun.bottom)

            cisds.push(currentRun)

fetchData() =>
    bool newRun     = (bullishBar and bearishBar[1]) or (bearishBar and bullishBar[1])

    if newRun
        if runs.size() > 0
            run currentRun = runs.last()
            currentRun.highest := highestPrice[1]
            currentRun.lowest := lowestPrice[1]
            checkCISD(currentRun)

        runs.push(run.new(open,high,low,bullishBar ? BULLISH : BEARISH,false,time,time,1,array.new<line>(),array.new<label>(),array.new<int>()))
    else        
        if runs.size() > 0
            run currentRun = runs.last()
            if not currentRun.triggered
                currentRun.endTime  := time
                currentRun.bars     += 1
                currentRun.top      := math.max(high,currentRun.top)
                currentRun.bottom   := math.min(low,currentRun.bottom)        

            if runs.size() >= 2
                checkCISD(runs.get(-2))
    
    if cisds.size() > 0
        invalidateCISD(cisds.last())
            
style(string style) =>
    switch style
        DOTTED  => line.style_dotted
        DASHED  => line.style_dashed
        SOLID   => line.style_solid

level(run currentRun, float levelPrice, color levelColor, string levelStyle) => line.new(chart.point.new(currentRun.startTime,na,levelPrice),chart.point.new(currentRun.endTime,na,levelPrice),xloc.bar_time,color = levelColor, style = style(levelStyle))

tag(run currentRun, float levelPrice, color levelColor, float multiplier) => label.new(chart.point.new(currentRun.startTime,na,levelPrice),multiplier == 0 ? '0' : str.format('{0,number,    #.0}',multiplier),xloc.bar_time,color = color(na), textcolor = levelColor, style = label.style_none,tooltip = str.tostring(levelPrice,format.mintick), size = labelsSizeInput)

drawCISD(run currentRun) =>
    float runRange          = currentRun.top - currentRun.bottom
    color currentRunColor   = currentRun.bias == BULLISH ? bearishColorInput : bullishColorInput    
    float basePrice         = currentRun.bias == BULLISH ? currentRun.bottom : currentRun.top
    int priceBias           = currentRun.bias == BULLISH ? -1 : 1

    if baseLevelInput
        level(currentRun,currentRun.openPrice,currentRunColor,baseLevelStyleInput)
        tag(currentRun,currentRun.openPrice,currentRunColor,0)

    if backgroundFillInput
        customBackground.base       := basePrice
        customBackground.extension  := basePrice + priceBias * math.round_to_mintick(customLevelsRaw.max() * runRange)
        customBackground.fillColor  := color.new(currentRunColor,80)
        
    for currentLevel in customLevels        
        float levelPrice    = basePrice + priceBias * math.round_to_mintick(currentLevel.multiplier * runRange)
        float tagLevelFix   = currentRun.bias == BULLISH ? math.round_to_mintick(0.25*runRange) : 0
        currentRun.levels.push(level(currentRun,levelPrice,currentRunColor,currentLevel.levelStyle))
        currentRun.tags.push(tag(currentRun,levelPrice - tagLevelFix,currentRunColor,currentLevel.multiplier))

updateUnreachedLevels() =>
    if cisds.size() >= 2
        run lastOne     = cisds.get(-2)
        run currentOne  = cisds.get(-1)

        if not lastOne.invalid
            for [index,eachLevel] in lastOne.levels        
                float priceLevel    = eachLevel.get_y1()
                bool unreached      = not lastOne.reached.includes(index)
                if unreached                
                    eachLevel.set_second_point(chart.point.new(currentOne.startTime - (timeframe.in_seconds()*1000),na,priceLevel))
                    if priceLevel == customBackground.extension
                        flushBackground()
                       
updateCISD(run currentRun) =>
    if not currentRun.invalid

        for [index,eachLevel] in currentRun.levels        
            float priceLevel    = eachLevel.get_y1()
            bool unreached      = not currentRun.reached.includes(index)

            if unreached
                eachLevel.set_second_point(chart.point.now(priceLevel))
                
                if (currentRun.bias == BULLISH and low <= priceLevel) or (currentRun.bias == BEARISH and high >= priceLevel)
                    currentRun.reached.push(index)
                    if priceLevel == customBackground.extension
                        flushBackground()
                     
//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
bool newCisdFormed = false
int cisdBias = na

if barstate.isconfirmed
    fetchData()

    if cisds.size() != cisds.size()[1]
        newCisdFormed := true
        cisdBias := cisds.last().bias
        updateUnreachedLevels()
        drawCISD(cisds.last())

    if cisds.size() != 0
        updateCISD(cisds.last())

if not na(customBackground.base)    
    customBackground.base := cisds.last().bias == BULLISH ? low : high

basePlot    = plot(customBackground.base,       '', color(na), style = plot.style_steplinebr, display = display.none)
extendPlot  = plot(customBackground.extension,  '', color(na), style = plot.style_steplinebr, display = display.none)
fill(basePlot,extendPlot,cisds.size() != cisds.size()[1] ? na : customBackground.fillColor)

// Plot Signals
plotshape(newCisdFormed and cisdBias == BEARISH and isBullishTrend, 'Bullish CISD Signal', shape.triangleup, location.belowbar, bullishColorInput, size=size.small)
plotshape(newCisdFormed and cisdBias == BULLISH and isBearishTrend, 'Bearish CISD Signal', shape.triangledown, location.abovebar, bearishColorInput, size=size.small)

// Dashboard
var table dash = table.new(position.bottom_right, 2, 3, border_width = 1)
if barstate.islast
    table.cell(dash, 0, 0, "HTF Trend Alignment", text_color = color.white, bgcolor = color.gray, text_size = size.small)
    table.cell(dash, 1, 0, "Status", text_color = color.white, bgcolor = color.gray, text_size = size.small)
    
    table.cell(dash, 0, 1, "1H", text_color = color.white, bgcolor = color.gray, text_size = size.small)
    color htf1Color = close > htf1_ema ? bullishColorInput : bearishColorInput
    table.cell(dash, 1, 1, close > htf1_ema ? "Bullish" : "Bearish", text_color = color.white, bgcolor = htf1Color, text_size = size.small)
    
    table.cell(dash, 0, 2, "4H", text_color = color.white, bgcolor = color.gray, text_size = size.small)
    color htf2Color = close > htf2_ema ? bullishColorInput : bearishColorInput
    table.cell(dash, 1, 2, close > htf2_ema ? "Bullish" : "Bearish", text_color = color.white, bgcolor = htf2Color, text_size = size.small)

// Previous 1H and 4H High/Low
max_bars_back(time, 4000)
max_bars_back(high, 4000)
max_bars_back(low, 4000)

[h1_h, h1_l, h1_time] = request.security(syminfo.tickerid, "60", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[h4_h, h4_l, h4_time] = request.security(syminfo.tickerid, "240", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)

var line1H_h = line.new(na, na, na, na, color=color.gray, style=line.style_dashed)
var line1H_l = line.new(na, na, na, na, color=color.gray, style=line.style_dashed)
var line4H_h = line.new(na, na, na, na, color=color.white, style=line.style_dashed)
var line4H_l = line.new(na, na, na, na, color=color.white, style=line.style_dashed)

var label1H_h = label.new(na, na, "Prev 1H High", color=color(na), textcolor=color.gray, style=label.style_label_left, size=size.small)
var label1H_l = label.new(na, na, "Prev 1H Low", color=color(na), textcolor=color.gray, style=label.style_label_left, size=size.small)
var label4H_h = label.new(na, na, "Prev 4H High", color=color(na), textcolor=color.white, style=label.style_label_left, size=size.small)
var label4H_l = label.new(na, na, "Prev 4H Low", color=color(na), textcolor=color.white, style=label.style_label_left, size=size.small)

if barstate.islast
    int h1_h_idx = bar_index
    int h1_l_idx = bar_index
    for i = 0 to 2000
        if time[i] >= h1_time
            if high[i] == h1_h
                h1_h_idx := bar_index - i
            if low[i] == h1_l
                h1_l_idx := bar_index - i
        else
            break
            
    int h4_h_idx = bar_index
    int h4_l_idx = bar_index
    for i = 0 to 4000
        if time[i] >= h4_time
            if high[i] == h4_h
                h4_h_idx := bar_index - i
            if low[i] == h4_l
                h4_l_idx := bar_index - i
        else
            break

    line.set_xy1(line1H_h, h1_h_idx, h1_h)
    line.set_xy2(line1H_h, bar_index + 10, h1_h)
    label.set_xy(label1H_h, bar_index + 10, h1_h)

    line.set_xy1(line1H_l, h1_l_idx, h1_l)
    line.set_xy2(line1H_l, bar_index + 10, h1_l)
    label.set_xy(label1H_l, bar_index + 10, h1_l)
    
    line.set_xy1(line4H_h, h4_h_idx, h4_h)
    line.set_xy2(line4H_h, bar_index + 10, h4_h)
    label.set_xy(label4H_h, bar_index + 10, h4_h)

    line.set_xy1(line4H_l, h4_l_idx, h4_l)
    line.set_xy2(line4H_l, bar_index + 10, h4_l)
    label.set_xy(label4H_l, bar_index + 10, h4_l)

//---------------------------------------------------------------------------------------------------------------------}