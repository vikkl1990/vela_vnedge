//@version=6
indicator("Price Oscillator", "PPO", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
MODE_PERCENTAGE = "Percentage"
MODE_ABSOLUTE   = "Absolute"

BULL_COLOR    = #089981 // oscillator above zero - fast EMA over slow EMA
BEAR_COLOR    = #f23645 // oscillator below zero
NEUTRAL_COLOR = #787b86 // zero line and a reading exactly at zero

FILL_LINE_TRANSP = 50  // gradient transparency at the oscillator end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
fastLengthInput = input.int(12, "Fast Length", minval = 1, group = "Settings", tooltip = "Length of the fast EMA.")
slowLengthInput = input.int(26, "Slow Length", minval = 1, group = "Settings", tooltip = "Length of the slow EMA.")
srcInput        = input.source(close, "Source", group = "Settings", tooltip = "Price series both EMAs are calculated on.")
modeInput       = input.string(MODE_PERCENTAGE, "Mode", options = [MODE_PERCENTAGE, MODE_ABSOLUTE], group = "Settings", tooltip = "Percentage (PPO) plots 100 * (fast EMA - slow EMA) / slow EMA; Absolute (APO) plots fast EMA - slow EMA in price units.")

oscColorInput  = input.color(NEUTRAL_COLOR, "Oscillator", group = "Style", tooltip = "Color of the oscillator line when the reading sits exactly at zero.")
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style", tooltip = "Color of the line and fill while the oscillator is above zero.")
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style", tooltip = "Color of the line and fill while the oscillator is below zero.")
zeroColorInput = input.color(NEUTRAL_COLOR, "Zero Line", group = "Style", tooltip = "Color of the zero reference line.")
showFillInput  = input.bool(true, "Gradient Fill", group = "Style", tooltip = "Fills the area between the oscillator and zero, following the line color.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
fastEma = ta.ema(srcInput, fastLengthInput)
slowEma = ta.ema(srcInput, slowLengthInput)

apo = fastEma - slowEma
ppo = slowEma != 0 ? 100 * apo / slowEma : float(na)

osc = switch modeInput
    MODE_PERCENTAGE => ppo
    MODE_ABSOLUTE   => apo
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
oscColor = na(osc) ? oscColorInput : osc > 0 ? bullColorInput : osc < 0 ? bearColorInput : oscColorInput

oscPlotId  = plot(osc, "Price Oscillator", oscColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

fill(oscPlotId, zeroPlotId, top_value = osc, bottom_value = 0, top_color = showFillInput ? color.new(oscColor, FILL_LINE_TRANSP) : color(na), bottom_color = showFillInput ? color.new(oscColor, FILL_ZERO_TRANSP) : color(na), title = "Oscillator Gradient")

hline(0, "Zero Line", zeroColorInput, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossUp   = ta.crossover(osc, 0)
crossDown = ta.crossunder(osc, 0)

alertcondition(crossUp, "Zero Cross Up", "Price Oscillator crossed above zero")
alertcondition(crossDown, "Zero Cross Down", "Price Oscillator crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
