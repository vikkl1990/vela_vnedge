//@version=6
indicator("Liquidity Dynamics Structure Engine", "LDSE v1.7", overlay=true, max_boxes_count=80, max_lines_count=100, max_labels_count=120)

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------
g1 = "Structure"
pivotLen = input.int(5, "Pivot Strength", minval=2, maxval=20, group=g1)
atrLen = input.int(14, "ATR Length", minval=5, maxval=100, group=g1)
liqTol = input.float(0.18, "Equal High/Low Tolerance (ATR)", minval=0.05, maxval=0.60, step=0.01, group=g1)
zoneATR = input.float(0.22, "Liquidity Zone Depth (ATR)", minval=0.05, maxval=0.80, step=0.01, group=g1)
extendBars = input.int(55, "Zone Projection Bars", minval=10, maxval=200, group=g1)

g2 = "Fair Value Gaps"
showFVG = input.bool(true, "Show Active FVG", group=g2)
minFvgATR = input.float(0.20, "Minimum FVG Size (ATR)", minval=0.05, maxval=1.50, step=0.05, group=g2)
maxFVG = input.int(4, "Maximum Active FVGs", minval=1, maxval=10, group=g2)

g3 = "Visual System"
showLiquidity = input.bool(true, "Show Liquidity Zones", group=g3)
showSweeps = input.bool(true, "Show Liquidity Sweeps", group=g3)
showDouble = input.bool(true, "Show Equal High/Low Structures", group=g3)
showPath = input.bool(true, "Show Context Path", group=g3)
showDashboard = input.bool(true, "Show Dashboard", group=g3)
showLabels = input.bool(true, "Show Context Labels", group=g3)
showLatestEvent = input.bool(true, "Show Latest Relevant Event", group=g3)
heroZoneATR = input.float(0.38, "Hero Zone Minimum Depth (ATR)", minval=0.15, maxval=1.00, step=0.01, group=g3)

//------------------------------------------------------------------------------
// Core measurements
//------------------------------------------------------------------------------
atr = ta.atr(atrLen)
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
pAtr = atr[pivotLen]

var float prevHigh = na
var int prevHighBar = na
var float prevLow = na
var int prevLowBar = na

var float buyLiq = na
var float sellLiq = na
var int buyBar = na
var int sellBar = na
var box buyBox = na
var box sellBox = na

var int lastSweepDir = 0
var string liquidityState = "NONE"
var string structureState = "NEUTRAL"

//------------------------------------------------------------------------------
// Liquidity formation: repeated structural highs/lows
//------------------------------------------------------------------------------
if not na(ph)
    pb = bar_index - pivotLen
    if not na(prevHigh) and math.abs(ph - prevHigh) <= math.max(pAtr * liqTol, syminfo.mintick * 3)
        buyLiq := math.max(ph, prevHigh)
        buyBar := math.min(pb, prevHighBar)
        if not na(buyBox)
            box.delete(buyBox)
        if showLiquidity
            buyBox := box.new(buyBar, buyLiq + pAtr * zoneATR * 0.55, bar_index + extendBars, buyLiq - pAtr * zoneATR * 0.20,
                 border_color=color.new(color.red, 42), bgcolor=color.new(color.red, 93))
        if showDouble and showLabels
            label.new(pb, ph, "BUY-SIDE LIQ.", style=label.style_label_down, color=color.new(color.red, 22), textcolor=color.white, size=size.tiny)
    prevHigh := ph
    prevHighBar := pb

if not na(pl)
    pb = bar_index - pivotLen
    if not na(prevLow) and math.abs(pl - prevLow) <= math.max(pAtr * liqTol, syminfo.mintick * 3)
        sellLiq := math.min(pl, prevLow)
        sellBar := math.min(pb, prevLowBar)
        if not na(sellBox)
            box.delete(sellBox)
        if showLiquidity
            sellBox := box.new(sellBar, sellLiq + pAtr * zoneATR * 0.20, bar_index + extendBars, sellLiq - pAtr * zoneATR * 0.55,
                 border_color=color.new(color.teal, 42), bgcolor=color.new(color.teal, 93))
        if showDouble and showLabels
            label.new(pb, pl, "SELL-SIDE LIQ.", style=label.style_label_up, color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)
    prevLow := pl
    prevLowBar := pb

if not na(buyBox)
    box.set_right(buyBox, bar_index + extendBars)
if not na(sellBox)
    box.set_right(sellBox, bar_index + extendBars)

//------------------------------------------------------------------------------
// Confirmed sweep logic: excursion through liquidity + close back through level
//------------------------------------------------------------------------------
buySweep = barstate.isconfirmed and not na(buyLiq) and high > buyLiq and close < buyLiq
sellSweep = barstate.isconfirmed and not na(sellLiq) and low < sellLiq and close > sellLiq

if buySweep
    lastSweepDir := -1
    liquidityState := "BUY SIDE SWEPT"
    structureState := "BEARISH REJECTION"
    if showSweeps and showLabels
        label.new(bar_index, high, "BUY SIDE\nLIQUIDITY SWEEP", style=label.style_label_down,
             color=color.new(color.red, 10), textcolor=color.white, size=size.small)

if sellSweep
    lastSweepDir := 1
    liquidityState := "SELL SIDE SWEPT"
    structureState := "BULLISH REJECTION"
    if showSweeps and showLabels
        label.new(bar_index, low, "SELL SIDE\nLIQUIDITY SWEEP", style=label.style_label_up,
             color=color.new(color.teal, 8), textcolor=color.white, size=size.small)

//------------------------------------------------------------------------------
// Fair Value Gaps (three-candle imbalance proxy)
//------------------------------------------------------------------------------
var box[] fvgBoxes = array.new_box()
var int[] fvgDir = array.new_int()

bullFVG = barstate.isconfirmed and low > high[2] and (low - high[2]) >= atr * minFvgATR
bearFVG = barstate.isconfirmed and high < low[2] and (low[2] - high) >= atr * minFvgATR

addFvg(float top, float bottom, int dir) =>
    if showFVG
        // Newest qualifying FVG becomes the hero object; older gaps are subdued below.
        b = box.new(bar_index - 2, top, bar_index + extendBars, bottom,
             border_color=color.new(color.orange, 28),
             bgcolor=color.new(color.orange, 84))
        array.push(fvgBoxes, b)
        array.push(fvgDir, dir)
        if array.size(fvgBoxes) > maxFVG
            box.delete(array.shift(fvgBoxes))
            array.shift(fvgDir)

if bullFVG
    addFvg(low, high[2], 1)
if bearFVG
    addFvg(low[2], high, -1)

// Mitigation: remove once price trades through far edge.
if array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        b = array.get(fvgBoxes, i)
        d = array.get(fvgDir, i)
        box.set_right(b, bar_index + extendBars)
        top = box.get_top(b)
        bot = box.get_bottom(b)
        mitigated = d == 1 ? low <= bot : high >= top
        if mitigated
            box.delete(b)
            array.remove(fvgBoxes, i)
            array.remove(fvgDir, i)

// FVG hierarchy: keep one visually dominant context gap and fade older gaps.
if array.size(fvgBoxes) > 0
    for i = 0 to array.size(fvgBoxes) - 1
        b = array.get(fvgBoxes, i)
        newest = i == array.size(fvgBoxes) - 1
        box.set_border_color(b, color.new(color.orange, newest ? 28 : 72))
        box.set_bgcolor(b, color.new(color.orange, newest ? 84 : 93))

// Nearest active FVG
float nearFvgTop = na
float nearFvgBot = na
int nearFvgDir = 0
float bestDist = 1e20
if array.size(fvgBoxes) > 0
    for i = 0 to array.size(fvgBoxes) - 1
        b = array.get(fvgBoxes, i)
        mid = (box.get_top(b) + box.get_bottom(b)) * 0.5
        dist = math.abs(close - mid)
        if dist < bestDist
            bestDist := dist
            nearFvgTop := box.get_top(b)
            nearFvgBot := box.get_bottom(b)
            nearFvgDir := array.get(fvgDir, i)

// Nearest active FVG is the single hero zone. Secondary gaps remain in the
// engine for mitigation/state logic but are visually suppressed.
if array.size(fvgBoxes) > 0 and not na(nearFvgTop)
    for i = 0 to array.size(fvgBoxes) - 1
        b = array.get(fvgBoxes, i)
        isHero = math.abs(box.get_top(b) - nearFvgTop) <= syminfo.mintick and math.abs(box.get_bottom(b) - nearFvgBot) <= syminfo.mintick
        box.set_border_color(b, color.new(color.orange, 100))
        box.set_bgcolor(b, color.new(color.orange, 100))

//------------------------------------------------------------------------------
// Context engine: liquidity event + FVG + opposing liquidity objective
// This is a scenario map, not a price forecast.
//------------------------------------------------------------------------------
bullContext = lastSweepDir == 1
bearContext = lastSweepDir == -1
biasText = bullContext ? "BULLISH" : bearContext ? "BEARISH" : "NEUTRAL"
fvgText = na(nearFvgTop) ? "NONE" : nearFvgDir == 1 ? "BULLISH ACTIVE" : "BEARISH ACTIVE"

// Directional objective gate:
// bullish context may only reference buy-side liquidity ABOVE current price;
// bearish context may only reference sell-side liquidity BELOW current price.
bool validBullObjective = bullContext and not na(buyLiq) and buyLiq > close
bool validBearObjective = bearContext and not na(sellLiq) and sellLiq < close
float nextZone = validBullObjective ? buyLiq : validBearObjective ? sellLiq : na
nextText = na(nextZone) ? "NO ACTIVE OBJECTIVE" : str.tostring(nextZone, format.mintick)

//------------------------------------------------------------------------------
// Premium live-view architecture.
// The engine logic is unchanged; these are presentation objects derived from validated state.
var line path1 = na
var line path2 = na
var line path3 = na
var box heroFvg = na
var box heroObjective = na
var box heroReaction = na
var label fvgLabel = na
var label reactionLabel = na
var label objectiveLabel = na
var label latestEventLabel = na

if barstate.islast
    if not na(path1)
        line.delete(path1)
    if not na(path2)
        line.delete(path2)
    if not na(path3)
        line.delete(path3)
    if not na(heroFvg)
        box.delete(heroFvg)
    if not na(heroObjective)
        box.delete(heroObjective)
    if not na(heroReaction)
        box.delete(heroReaction)
    if not na(fvgLabel)
        label.delete(fvgLabel)
    if not na(reactionLabel)
        label.delete(reactionLabel)
    if not na(objectiveLabel)
        label.delete(objectiveLabel)
    if not na(latestEventLabel)
        label.delete(latestEventLabel)

    // One managed event annotation only. It represents the latest confirmed
    // liquidity event and is recreated on the last bar, so old event labels
    // cannot accumulate across the chart.
    if showLatestEvent and showLabels and lastSweepDir != 0
        eventY = lastSweepDir == 1 ? low - atr * 0.55 : high + atr * 0.55
        latestEventLabel := label.new(bar_index, eventY,
             lastSweepDir == 1 ? "SELL-SIDE SWEEP" : "BUY-SIDE SWEEP",
             style=lastSweepDir == 1 ? label.style_label_up : label.style_label_down,
             color=color.new(lastSweepDir == 1 ? color.teal : color.red, 36),
             textcolor=color.white, size=size.tiny)

    if showPath and not na(nextZone)
        x1 = bar_index
        x2 = bar_index + math.max(8, int(extendBars * 0.22))
        x3 = bar_index + math.max(17, int(extendBars * 0.46))
        x4 = bar_index + math.max(29, int(extendBars * 0.78))

        hasFvg = not na(nearFvgTop)
        fvgMid = hasFvg ? (nearFvgTop + nearFvgBot) * 0.5 : close + (bullContext ? atr * 0.70 : -atr * 0.70)
        reaction = fvgMid + (bullContext ? -atr * 0.80 : atr * 0.80)
        objective = nextZone

        // 1) Hero FVG: preserve actual detected boundaries, but ensure readable depth.
        if hasFvg
            rawDepth = math.abs(nearFvgTop - nearFvgBot)
            minDepth = atr * heroZoneATR
            halfDepth = math.max(rawDepth, minDepth) * 0.5
            fvgTopV = fvgMid + halfDepth
            fvgBotV = fvgMid - halfDepth
            heroFvg := box.new(bar_index, fvgTopV, x3, fvgBotV,
                 border_color=color.new(color.orange, 28),
                 bgcolor=color.new(color.orange, 86))
            fvgLabel := label.new(x2, fvgMid,
                 nearFvgDir == -1 ? "FVG RESISTANCE" : "FVG SUPPORT",
                 style=nearFvgDir == -1 ? label.style_label_down : label.style_label_up,
                 color=color.new(color.orange, 32), textcolor=color.black, size=size.small)

        // 2) Reaction region: contextual structural interaction, not an order-book claim.
        reactHalf = atr * 0.18
        heroReaction := box.new(x2, reaction + reactHalf, x3, reaction - reactHalf,
             border_color=color.new(bullContext ? color.teal : color.red, 55),
             bgcolor=color.new(bullContext ? color.teal : color.red, 91))
        reactionLabel := label.new(x3, reaction,
             bullContext ? "REACTION CONTEXT" : "REACTION CONTEXT",
             style=bullContext ? label.style_label_up : label.style_label_down,
             color=color.new(bullContext ? color.teal : color.red, 72),
             textcolor=color.black, size=size.tiny)

        // 3) Objective band: only exists because v1.3 objective gate validated direction.
        objHalf = atr * 0.16
        heroObjective := box.new(x3, objective + objHalf, x4, objective - objHalf,
             border_color=color.new(bullContext ? color.red : color.teal, 38),
             bgcolor=color.new(bullContext ? color.red : color.teal, 90))
        objectiveLabel := label.new(x4, objective,
             bullContext ? "BUY-SIDE LIQUIDITY\nCONTEXT" : "SELL-SIDE LIQUIDITY\nCONTEXT",
             style=bullContext ? label.style_label_down : label.style_label_up,
             color=color.new(bullContext ? color.red : color.teal, 72),
             textcolor=color.black, size=size.small)

        // 4) Three-stage scenario geometry.
        path1 := line.new(x1, close, x2, fvgMid, color=color.new(color.gray, 22), width=2, style=line.style_dashed)
        path2 := line.new(x2, fvgMid, x3, reaction, color=color.new(color.gray, 22), width=2, style=line.style_dashed)
        path3 := line.new(x3, reaction, x4, objective, color=color.new(color.gray, 18), width=2, style=line.style_dashed)

//------------------------------------------------------------------------------
// Dashboard
//------------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    if showDashboard
        table.cell(dash, 0, 0, "LIQUIDITY DYNAMICS", text_color=color.white, bgcolor=color.rgb(43,47,56), text_size=size.small)
        table.cell(dash, 1, 0, "v1.7", text_color=color.silver, bgcolor=color.rgb(43,47,56), text_size=size.small)

        table.cell(dash, 0, 1, "BIAS", text_color=color.silver, bgcolor=color.rgb(80,83,92), text_size=size.tiny)
        table.cell(dash, 1, 1, biasText, text_color=bullContext?color.teal:bearContext?color.red:color.silver, bgcolor=color.rgb(80,83,92), text_size=size.tiny)

        table.cell(dash, 0, 2, "EVENT", text_color=color.silver, bgcolor=color.rgb(80,83,92), text_size=size.tiny)
        table.cell(dash, 1, 2, liquidityState, text_color=color.white, bgcolor=color.rgb(80,83,92), text_size=size.tiny)

        table.cell(dash, 0, 3, "FVG", text_color=color.silver, bgcolor=color.rgb(80,83,92), text_size=size.tiny)
        table.cell(dash, 1, 3, fvgText, text_color=na(nearFvgTop)?color.silver:color.orange, bgcolor=color.rgb(80,83,92), text_size=size.tiny)

        table.cell(dash, 0, 4, "OBJECTIVE", text_color=color.silver, bgcolor=color.rgb(80,83,92), text_size=size.tiny)
        table.cell(dash, 1, 4, nextText, text_color=color.white, bgcolor=color.rgb(80,83,92), text_size=size.tiny)
    else
        table.clear(dash, 0, 0, 1, 4)

//------------------------------------------------------------------------------
// Alerts
//------------------------------------------------------------------------------
alertcondition(buySweep, "Buy-side Liquidity Sweep", "Confirmed excursion above mapped buy-side liquidity followed by a close back below the level.")
alertcondition(sellSweep, "Sell-side Liquidity Sweep", "Confirmed excursion below mapped sell-side liquidity followed by a close back above the level.")
alertcondition(bullFVG, "Bullish FVG Formed", "A qualifying bullish three-candle imbalance has formed.")
alertcondition(bearFVG, "Bearish FVG Formed", "A qualifying bearish three-candle imbalance has formed.")
