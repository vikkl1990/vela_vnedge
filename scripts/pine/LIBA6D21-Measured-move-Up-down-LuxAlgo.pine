//@version=6
indicator("Measured-move Up/down", "Measured-move Up/down", overlay = true, max_lines_count = 500, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

int MAX_SWINGS           = 10
int ATR_LENGTH           = 14
int MAX_PROJECTION_AHEAD = 480

int STATUS_NONE    = -1
int STATUS_ACTIVE  = 0
int STATUS_TARGET  = 1
int STATUS_INVALID = 2

string DETECTION_GROUP = 'Swing Detection'
string RULES_GROUP     = 'Measured Move Rules'
string TARGETS_GROUP   = 'Targets'
string STYLE_GROUP     = 'Style'

color TRANSPARENT_COLOR = #00000000

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{

swingLengthInput = input.int(10, 'Swing Length', minval = 2, maxval = 50, group = DETECTION_GROUP, tooltip = 'Pivot length used to detect the swing points that start and end each leg. Larger values return larger, slower measured-move structures; smaller values pick up intraday-scale patterns.')

showBullInput = input.bool(true, 'Measured Moves Up', group = DETECTION_GROUP, tooltip = 'Detect bullish measured moves: an advance, an orderly correction, then a second advance projected to be about the size of the first.')
showBearInput = input.bool(true, 'Measured Moves Down', group = DETECTION_GROUP, tooltip = 'Detect bearish measured moves: a decline, an orderly correction, then a second decline projected to be about the size of the first.')

minLegAtrInput = input.float(0, 'Min First Leg Height (ATR)', minval = 0, step = 0.25, group = DETECTION_GROUP, tooltip = 'Minimum height of the first leg, in ATR(14) multiples measured at the leg origin, required to qualify as a clean trending leg. 0 disables the filter.')

minRetraceInput = input.float(33, 'Correction Retracement %', inline = 'retrace', minval = 5, maxval = 90, group = RULES_GROUP, tooltip = 'Lower bound of the corrective phase as a percentage of the first leg. Orderly corrections in the broad one-third to two-thirds region are typical.')
maxRetraceInput = input.float(67, '', inline = 'retrace', minval = 10, maxval = 95, group = RULES_GROUP, tooltip = 'Upper bound of the corrective phase. A correction that retraces most of the first leg puts the trend itself in doubt and disqualifies the projection.')

showPartialInput = input.bool(true, 'Partial Target', inline = 'partial', group = TARGETS_GROUP, tooltip = 'Plot a conservative partial objective at a fraction of the projected leg. Full-target completion is far from certain, so fractions of the projection are commonly used to scale out ahead of the full measured target.')
partialPctInput  = input.float(50, '', inline = 'partial', minval = 10, maxval = 100, step = 5, group = TARGETS_GROUP, tooltip = 'Partial objective as a percentage of the first leg projected from the correction end.')

bullColorInput    = input.color(#089981, 'Bullish Patterns', group = STYLE_GROUP, inline = 'colors')
bearColorInput    = input.color(#f23645, 'Bearish Patterns', group = STYLE_GROUP, inline = 'colors')
invalidColorInput = input.color(#787b86, 'Invalidated', group = STYLE_GROUP)

showLabelsInput      = input.bool(true, 'Point Labels', group = STYLE_GROUP)
showRetraceInput     = input.bool(true, 'Retracement Label', group = STYLE_GROUP)
showLevelLabelsInput = input.bool(true, 'Level Labels', group = STYLE_GROUP)
showStopInput        = input.bool(true, 'Stop Line', group = STYLE_GROUP)

showSwingsInput = input.bool(true, 'Show Swings', group = STYLE_GROUP, inline = 'swings')
swingColorInput = input.color(color.new(#787b86, 50), '', group = STYLE_GROUP, inline = 'swings')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// registers a confirmed pivot into the swing zigzag, returns 0 = no change, 1 = new swing point, 2 = last swing point extended
f_addPivot(array<float> priceArray, array<int> barArray, array<int> dirArray, array<float> atrArray, float pivotPrice, int pivotBar, int pivotDir, float pivotAtr, int maxSize) =>
    int changeType = 0
    int n = array.size(priceArray)
    if n == 0
        array.push(priceArray, pivotPrice)
        array.push(barArray, pivotBar)
        array.push(dirArray, pivotDir)
        array.push(atrArray, pivotAtr)
        changeType := 1
    else if pivotDir == array.get(dirArray, n - 1)
        float lastPrice = array.get(priceArray, n - 1)
        if (pivotDir == 1 and pivotPrice >= lastPrice) or (pivotDir == -1 and pivotPrice <= lastPrice)
            array.set(priceArray, n - 1, pivotPrice)
            array.set(barArray, n - 1, pivotBar)
            array.set(atrArray, n - 1, pivotAtr)
            changeType := 2
    else
        array.push(priceArray, pivotPrice)
        array.push(barArray, pivotBar)
        array.push(dirArray, pivotDir)
        array.push(atrArray, pivotAtr)
        changeType := 1
        if array.size(priceArray) > maxSize
            array.shift(priceArray)
            array.shift(barArray)
            array.shift(dirArray)
            array.shift(atrArray)
    changeType

// draws or extends the faint zigzag segment joining the two most recent swing points
f_swingSegment(array<float> priceArray, array<int> barArray, int changeType, line previousSegment) =>
    line segment = previousSegment
    if showSwingsInput
        int n = array.size(priceArray)
        if changeType == 1 and n >= 2
            segment := line.new(array.get(barArray, n - 2), array.get(priceArray, n - 2), array.get(barArray, n - 1), array.get(priceArray, n - 1), color = swingColorInput, style = line.style_dotted)
        else if changeType == 2 and not na(previousSegment)
            line.set_xy2(previousSegment, array.get(barArray, n - 1), array.get(priceArray, n - 1))
    segment

// removes every drawing belonging to a pattern whose correction end was revised by a deeper pivot
f_deleteDrawings(array<line> staticLineArray, array<label> staticLabelArray, array<line> levelLineArray, array<label> levelLabelArray) =>
    int staticLineCount = array.size(staticLineArray)
    if staticLineCount > 0
        for i = 0 to staticLineCount - 1
            line.delete(array.get(staticLineArray, i))
    int staticLabelCount = array.size(staticLabelArray)
    if staticLabelCount > 0
        for i = 0 to staticLabelCount - 1
            label.delete(array.get(staticLabelArray, i))
    int levelLineCount = array.size(levelLineArray)
    if levelLineCount > 0
        for i = 0 to levelLineCount - 1
            line.delete(array.get(levelLineArray, i))
    int levelLabelCount = array.size(levelLabelArray)
    if levelLabelCount > 0
        for i = 0 to levelLabelCount - 1
            label.delete(array.get(levelLabelArray, i))
    array.clear(staticLineArray)
    array.clear(staticLabelArray)
    array.clear(levelLineArray)
    array.clear(levelLabelArray)

// keeps the target, partial target and stop lines anchored to the latest bar while the second leg is being tracked
f_extendLevels(array<line> levelLineArray, array<label> levelLabelArray) =>
    int levelLineCount = array.size(levelLineArray)
    if levelLineCount > 0
        for i = 0 to levelLineCount - 1
            line.set_x2(array.get(levelLineArray, i), bar_index)
    int levelLabelCount = array.size(levelLabelArray)
    if levelLabelCount > 0
        for i = 0 to levelLabelCount - 1
            label.set_x(array.get(levelLabelArray, i), bar_index)

// fades the projection levels once price breaks the correction extreme, the stop that disqualifies the pattern
f_markInvalid(array<line> levelLineArray, array<label> levelLabelArray, color invalidColor) =>
    int levelLineCount = array.size(levelLineArray)
    if levelLineCount > 0
        for i = 0 to levelLineCount - 1
            line levelLine = array.get(levelLineArray, i)
            line.set_color(levelLine, color.new(invalidColor, 30))
            line.set_style(levelLine, line.style_dashed)
    int levelLabelCount = array.size(levelLabelArray)
    if levelLabelCount > 0
        for i = 0 to levelLabelCount - 1
            label.set_textcolor(array.get(levelLabelArray, i), color.new(invalidColor, 20))

// draws the three-part structure: first leg, corrective phase, projected second leg, plus the target, partial and stop levels
f_drawPattern(array<line> staticLineArray, array<label> staticLabelArray, array<line> levelLineArray, array<label> levelLabelArray, int barA, float priceA, int barB, float priceB, int barC, float priceC, float targetPrice, float partialPrice, float retraceFraction, bool isBull, color patternColor) =>
    // realized structure: the first trending leg and the orderly correction
    array.push(staticLineArray, line.new(barA, priceA, barB, priceB, color = patternColor, width = 2))
    array.push(staticLineArray, line.new(barB, priceB, barC, priceC, color = patternColor, width = 2))
    // expected second leg: the first leg translated to the correction end, ending at the measured objective
    int projectionBar = math.min(barC + (barB - barA), bar_index + MAX_PROJECTION_AHEAD)
    array.push(staticLineArray, line.new(barC, priceC, projectionBar, targetPrice, color = patternColor, style = line.style_dotted))
    if showLabelsInput
        string startSideStyle = isBull ? label.style_label_up : label.style_label_down
        string endSideStyle   = isBull ? label.style_label_down : label.style_label_up
        array.push(staticLabelArray, label.new(barA, priceA, 'A', color = TRANSPARENT_COLOR, textcolor = patternColor, style = startSideStyle, size = size.small))
        array.push(staticLabelArray, label.new(barB, priceB, 'B', color = TRANSPARENT_COLOR, textcolor = patternColor, style = endSideStyle, size = size.small))
        array.push(staticLabelArray, label.new(barC, priceC, 'C', color = TRANSPARENT_COLOR, textcolor = patternColor, style = startSideStyle, size = size.small))
    // the measured correction depth, so the label can be checked instead of trusted
    if showRetraceInput
        array.push(staticLabelArray, label.new(math.round(math.avg(barB, barC)), math.avg(priceB, priceC), str.tostring(retraceFraction * 100, '#') + '% retrace', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_center, size = size.tiny))
    array.push(levelLineArray, line.new(barC, targetPrice, bar_index, targetPrice, color = color.new(patternColor, 30), style = line.style_dotted))
    if showLevelLabelsInput
        array.push(levelLabelArray, label.new(bar_index, targetPrice, 'Target', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 20), style = label.style_label_left, size = size.tiny))
    if showPartialInput
        array.push(levelLineArray, line.new(barC, partialPrice, bar_index, partialPrice, color = color.new(patternColor, 55), style = line.style_dotted))
        if showLevelLabelsInput
            array.push(levelLabelArray, label.new(bar_index, partialPrice, str.tostring(partialPctInput, '#.#') + '% target', color = TRANSPARENT_COLOR, textcolor = color.new(patternColor, 40), style = label.style_label_left, size = size.tiny))
    if showStopInput
        array.push(levelLineArray, line.new(barC, priceC, bar_index, priceC, color = color.new(invalidColorInput, 30), style = line.style_dashed))
        if showLevelLabelsInput
            array.push(levelLabelArray, label.new(bar_index, priceC, 'Stop', color = TRANSPARENT_COLOR, textcolor = color.new(invalidColorInput, 20), style = label.style_label_left, size = size.tiny))

// stamps a pattern outcome on the chart: full measured target reached, or projection invalidated at the stop
f_outcomeLabel(array<label> staticLabelArray, int outcomeBar, float outcomePrice, string outcomeText, string outcomeStyle, color outcomeColor) =>
    array.push(staticLabelArray, label.new(outcomeBar, outcomePrice, outcomeText, color = TRANSPARENT_COLOR, textcolor = outcomeColor, style = outcomeStyle, size = size.tiny))

//---------------------------------------------------------------------------------------------------------------------}
// Swing Detection
//---------------------------------------------------------------------------------------------------------------------{

var array<float> swingPriceArray = array.new<float>()
var array<int>   swingBarArray   = array.new<int>()
var array<int>   swingDirArray   = array.new<int>()
var array<float> swingAtrArray   = array.new<float>()

var line lastSwingSegment = na

float atrValue = ta.atr(ATR_LENGTH)

float pivotHigh = ta.pivothigh(swingLengthInput, swingLengthInput)
float pivotLow  = ta.pivotlow(swingLengthInput, swingLengthInput)

int swingChange = 0
if not na(pivotHigh)
    int changeType = f_addPivot(swingPriceArray, swingBarArray, swingDirArray, swingAtrArray, pivotHigh, bar_index - swingLengthInput, 1, atrValue[swingLengthInput], MAX_SWINGS)
    if changeType != 0
        swingChange := changeType
        lastSwingSegment := f_swingSegment(swingPriceArray, swingBarArray, changeType, lastSwingSegment)
if not na(pivotLow)
    int changeType = f_addPivot(swingPriceArray, swingBarArray, swingDirArray, swingAtrArray, pivotLow, bar_index - swingLengthInput, -1, atrValue[swingLengthInput], MAX_SWINGS)
    if changeType != 0
        swingChange := changeType
        lastSwingSegment := f_swingSegment(swingPriceArray, swingBarArray, changeType, lastSwingSegment)

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{

var int   bullStatus     = STATUS_NONE
var int   bullKey        = -1
var float bullTarget     = na
var float bullPartial    = na
var float bullStop       = na
var bool  bullPartialHit = false

var int   bearStatus     = STATUS_NONE
var int   bearKey        = -1
var float bearTarget     = na
var float bearPartial    = na
var float bearStop       = na
var bool  bearPartialHit = false

var array<line>  bullStaticLineArray  = array.new<line>()
var array<label> bullStaticLabelArray = array.new<label>()
var array<line>  bullLevelLineArray   = array.new<line>()
var array<label> bullLevelLabelArray  = array.new<label>()

var array<line>  bearStaticLineArray  = array.new<line>()
var array<label> bearStaticLabelArray = array.new<label>()
var array<line>  bearLevelLineArray   = array.new<line>()
var array<label> bearLevelLabelArray  = array.new<label>()

bool bullDetectedAlert = false
bool bearDetectedAlert = false
bool bullPartialAlert  = false
bool bearPartialAlert  = false
bool bullTargetAlert   = false
bool bearTargetAlert   = false
bool bullInvalidAlert  = false
bool bearInvalidAlert  = false

if swingChange != 0 and array.size(swingPriceArray) >= 3
    int n = array.size(swingPriceArray)
    // a correction ending at a swing low completes the bullish structure, at a swing high the bearish one
    bool isBull = array.get(swingDirArray, n - 1) == -1
    float s = isBull ? 1 : -1

    float pA = array.get(swingPriceArray, n - 3)
    float pB = array.get(swingPriceArray, n - 2)
    float pC = array.get(swingPriceArray, n - 1)
    int   bA = array.get(swingBarArray, n - 3)
    int   bB = array.get(swingBarArray, n - 2)
    int   bC = array.get(swingBarArray, n - 1)
    float atrA = array.get(swingAtrArray, n - 3)

    // the first leg and its correction, both as positive distances whatever the direction
    float legHeight       = s * (pB - pA)
    float retraceFraction = legHeight > 0 ? s * (pB - pC) / legHeight : na

    bool trendOk   = legHeight > 0
    bool retraceOk = not na(retraceFraction) and retraceFraction >= minRetraceInput / 100 and retraceFraction <= maxRetraceInput / 100
    bool sizeOk    = minLegAtrInput <= 0 or (not na(atrA) and legHeight >= minLegAtrInput * atrA)
    bool wantedOk  = isBull ? showBullInput : showBearInput

    if trendOk and retraceOk and sizeOk and wantedOk
        // the first leg's length projected from the correction end supplies the price objective
        float targetPrice  = pC + s * legHeight
        float partialPrice = pC + s * legHeight * partialPctInput / 100
        color patternColor = isBull ? bullColorInput : bearColorInput

        // second-leg progress that already played out inside the pivot confirmation lag
        bool scanPartial   = false
        bool scanTarget    = false
        int  scanTargetBar = na
        for j = 1 to swingLengthInput - 1
            int off = swingLengthInput - j
            if not scanTarget
                float reach = isBull ? high[off] : low[off]
                if not scanPartial and s * (reach - partialPrice) >= 0
                    scanPartial := true
                if s * (reach - targetPrice) >= 0
                    scanTarget := true
                    scanTargetBar := bar_index - off

        if isBull
            if not (bullKey == bB and bullStatus == STATUS_ACTIVE)
                if bullKey == bB
                    // same first leg, deeper correction end: the earlier read was premature, replace it
                    f_deleteDrawings(bullStaticLineArray, bullStaticLabelArray, bullLevelLineArray, bullLevelLabelArray)
                else
                    // a newer structure supersedes the previous one, whose drawings stay frozen on the chart
                    array.clear(bullStaticLineArray)
                    array.clear(bullStaticLabelArray)
                    array.clear(bullLevelLineArray)
                    array.clear(bullLevelLabelArray)
                bullKey        := bB
                bullStatus     := STATUS_ACTIVE
                bullTarget     := targetPrice
                bullPartial    := partialPrice
                bullStop       := pC
                bullPartialHit := false
                f_drawPattern(bullStaticLineArray, bullStaticLabelArray, bullLevelLineArray, bullLevelLabelArray, bA, pA, bB, pB, bC, pC, targetPrice, partialPrice, retraceFraction, true, patternColor)
                bullDetectedAlert := true
                if scanPartial and showPartialInput
                    bullPartialHit  := true
                    bullPartialAlert := true
                if scanTarget
                    bullStatus := STATUS_TARGET
                    f_outcomeLabel(bullStaticLabelArray, scanTargetBar, targetPrice, 'Target reached', label.style_label_down, bullColorInput)
                    bullTargetAlert := true
        else
            if not (bearKey == bB and bearStatus == STATUS_ACTIVE)
                if bearKey == bB
                    // same first leg, higher correction end: the earlier read was premature, replace it
                    f_deleteDrawings(bearStaticLineArray, bearStaticLabelArray, bearLevelLineArray, bearLevelLabelArray)
                else
                    // a newer structure supersedes the previous one, whose drawings stay frozen on the chart
                    array.clear(bearStaticLineArray)
                    array.clear(bearStaticLabelArray)
                    array.clear(bearLevelLineArray)
                    array.clear(bearLevelLabelArray)
                bearKey        := bB
                bearStatus     := STATUS_ACTIVE
                bearTarget     := targetPrice
                bearPartial    := partialPrice
                bearStop       := pC
                bearPartialHit := false
                f_drawPattern(bearStaticLineArray, bearStaticLabelArray, bearLevelLineArray, bearLevelLabelArray, bA, pA, bB, pB, bC, pC, targetPrice, partialPrice, retraceFraction, false, patternColor)
                bearDetectedAlert := true
                if scanPartial and showPartialInput
                    bearPartialHit  := true
                    bearPartialAlert := true
                if scanTarget
                    bearStatus := STATUS_TARGET
                    f_outcomeLabel(bearStaticLabelArray, scanTargetBar, targetPrice, 'Target reached', label.style_label_up, bearColorInput)
                    bearTargetAlert := true

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Monitoring
//---------------------------------------------------------------------------------------------------------------------{

// the second leg is tracked against the projection: the correction extreme is the stop, the projected leg the objective;
// when one bar spans both, the stop break is preferred, keeping position management ahead of the projection
if bullStatus == STATUS_ACTIVE
    f_extendLevels(bullLevelLineArray, bullLevelLabelArray)
    if low < bullStop
        bullStatus := STATUS_INVALID
        f_markInvalid(bullLevelLineArray, bullLevelLabelArray, invalidColorInput)
        f_outcomeLabel(bullStaticLabelArray, bar_index, bullStop, 'Invalidated', label.style_label_down, color.new(invalidColorInput, 20))
        bullInvalidAlert := true
    else
        if showPartialInput and not bullPartialHit and high >= bullPartial
            bullPartialHit  := true
            bullPartialAlert := true
        if high >= bullTarget
            bullStatus := STATUS_TARGET
            f_outcomeLabel(bullStaticLabelArray, bar_index, bullTarget, 'Target reached', label.style_label_down, bullColorInput)
            bullTargetAlert := true

if bearStatus == STATUS_ACTIVE
    f_extendLevels(bearLevelLineArray, bearLevelLabelArray)
    if high > bearStop
        bearStatus := STATUS_INVALID
        f_markInvalid(bearLevelLineArray, bearLevelLabelArray, invalidColorInput)
        f_outcomeLabel(bearStaticLabelArray, bar_index, bearStop, 'Invalidated', label.style_label_up, color.new(invalidColorInput, 20))
        bearInvalidAlert := true
    else
        if showPartialInput and not bearPartialHit and low <= bearPartial
            bearPartialHit  := true
            bearPartialAlert := true
        if low <= bearTarget
            bearStatus := STATUS_TARGET
            f_outcomeLabel(bearStaticLabelArray, bar_index, bearTarget, 'Target reached', label.style_label_up, bearColorInput)
            bearTargetAlert := true

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bullDetectedAlert, 'Bullish Measured Move', 'Measured move up: first leg and orderly correction in place, correction end confirmed, second leg projected to match the first')
alertcondition(bearDetectedAlert, 'Bearish Measured Move', 'Measured move down: first leg and orderly correction in place, correction end confirmed, second leg projected to match the first')
alertcondition(bullPartialAlert, 'Bullish Measured Move Partial Target', 'Measured move up reached its partial objective, the configured fraction of the projected second leg')
alertcondition(bearPartialAlert, 'Bearish Measured Move Partial Target', 'Measured move down reached its partial objective, the configured fraction of the projected second leg')
alertcondition(bullTargetAlert, 'Bullish Measured Move Completed', 'Measured move up completed: the second leg matched the first leg projected from the correction end, continuation is statistically less generous from here')
alertcondition(bearTargetAlert, 'Bearish Measured Move Completed', 'Measured move down completed: the second leg matched the first leg projected from the correction end, continuation is statistically less generous from here')
alertcondition(bullInvalidAlert, 'Bullish Measured Move Invalidated', 'Measured move up invalidated: price broke below the correction extreme that serves as the pattern stop')
alertcondition(bearInvalidAlert, 'Bearish Measured Move Invalidated', 'Measured move down invalidated: price broke above the correction extreme that serves as the pattern stop')

//---------------------------------------------------------------------------------------------------------------------}
