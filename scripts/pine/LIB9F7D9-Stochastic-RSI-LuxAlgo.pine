//@version=6
indicator("Stochastic RSI", "Stoch RSI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SETTINGS_GROUP = "Settings"
STYLE_GROUP    = "Style"
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
srcInput         = input.source(close, "RSI Source", group = SETTINGS_GROUP, tooltip = "Price series the RSI is computed on")
rsiLengthInput   = input.int(14, "RSI Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Lookback length of the Wilder RSI")
stochLengthInput = input.int(14, "Stochastic Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Lookback over which the highest and lowest RSI values are taken")
kSmoothInput     = input.int(3, "%K Smoothing", minval = 1, group = SETTINGS_GROUP, tooltip = "Simple moving average length applied to the stochastic of RSI to form %K")
dSmoothInput     = input.int(3, "%D Smoothing", minval = 1, group = SETTINGS_GROUP, tooltip = "Simple moving average length applied to %K to form the %D signal line")
obLevelInput     = input.float(80, "Overbought Level", minval = 0, maxval = 100, step = 1, group = SETTINGS_GROUP, tooltip = "Level above which the oscillator is considered overbought")
osLevelInput     = input.float(20, "Oversold Level", minval = 0, maxval = 100, step = 1, group = SETTINGS_GROUP, tooltip = "Level below which the oscillator is considered oversold")

kColorInput    = input.color(#5b9cf6, "%K Color", group = STYLE_GROUP, tooltip = "Color of the %K line")
dColorInput    = input.color(#ff9800, "%D Color", group = STYLE_GROUP, tooltip = "Color of the %D signal line")
fillColorInput = input.color(color.new(#5b9cf6, 90), "Zone Fill", group = STYLE_GROUP, tooltip = "Fill color of the area between the overbought and oversold levels")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
rsiValue   = ta.rsi(srcInput, rsiLengthInput)
lowestRsi  = ta.lowest(rsiValue, stochLengthInput)
highestRsi = ta.highest(rsiValue, stochLengthInput)
rsiRange   = highestRsi - lowestRsi

// Flat RSI window (highest == lowest) outputs 0 by convention
stochRsi = na(rsiValue) or na(rsiRange) ? float(na) : rsiRange == 0 ? 0 : 100 * (rsiValue - lowestRsi) / rsiRange

kLine = ta.sma(stochRsi, kSmoothInput)
dLine = ta.sma(kLine, dSmoothInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(kLine, "%K", kColorInput)
plot(dLine, "%D", dColorInput)

obHlineId = hline(obLevelInput, "Overbought Level", color = #787b86, linestyle = hline.style_dashed)
osHlineId = hline(osLevelInput, "Oversold Level", color = #787b86, linestyle = hline.style_dashed)

fill(obHlineId, osHlineId, color = fillColorInput, title = "Overbought/Oversold Zone Fill")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
bullCross = ta.crossover(kLine, dLine)
bearCross = ta.crossunder(kLine, dLine)
obEnter   = ta.crossover(kLine, obLevelInput)
obExit    = ta.crossunder(kLine, obLevelInput)
osEnter   = ta.crossunder(kLine, osLevelInput)
osExit    = ta.crossover(kLine, osLevelInput)

alertcondition(bullCross, "Bullish %K/%D Cross", "Stochastic RSI %K crossed above %D")
alertcondition(bearCross, "Bearish %K/%D Cross", "Stochastic RSI %K crossed below %D")
alertcondition(obEnter, "Overbought Zone Entered", "Stochastic RSI %K crossed above the overbought level")
alertcondition(obExit, "Overbought Zone Exited", "Stochastic RSI %K crossed below the overbought level")
alertcondition(osEnter, "Oversold Zone Entered", "Stochastic RSI %K crossed below the oversold level")
alertcondition(osExit, "Oversold Zone Exited", "Stochastic RSI %K crossed above the oversold level")
//----------------------------------------------------------------------------------------------------------------------}
