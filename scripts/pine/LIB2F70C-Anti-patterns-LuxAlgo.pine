//@version=6
indicator("Anti-patterns", "Anti-patterns", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
// Anti-patterns mirror the classic XABCD harmonics by replacing the parent's defining ratios with their reciprocals:
// the anti B window is the reciprocal of the parent's BC projection, the anti D completion is the reciprocal of the
// parent's completion ratio (1/0.786 = 1.272, 1/0.886 = 1.128, 1/1.272 = 0.786, 1/1.618 = 0.618), and the parent's B
// window mirrors into the anti BC projection anchor. Published anti ratio tables vary between sources; this table is
// one reciprocal-derived implementation, with a tolerance input to absorb the differences.

int MAX_PIVOTS    = 60
int PATTERN_COUNT = 5

float BC_PROJ_MIN = 1.128
float BC_PROJ_MAX = 4.236

string DETECTION_GROUP = 'Pattern Detection'
string PATTERNS_GROUP  = 'Anti-Patterns'
string STYLE_GROUP     = 'Style'

color TRANSPARENT_COLOR = #00000000

// pattern ratio tables, index order: anti-Gartley, anti-Bat, anti-Butterfly, anti-Crab, anti-Cypher
var array<string> patternNameArray = array.from('Anti-Gartley', 'Anti-Bat', 'Anti-Butterfly', 'Anti-Crab', 'Anti-Cypher')
var array<float>  bLowArray        = array.from(0.618, 0.382, 0.382, 0.276, 0.382)
var array<float>  bHighArray       = array.from(0.786, 0.618, 0.618, 0.382, 0.618)
var array<float>  cLowArray        = array.from(0.382, 0.382, 0.382, 0.382, 0.707)
var array<float>  cHighArray       = array.from(0.886, 0.886, 0.886, 0.886, 0.786)
var array<float>  dIdealArray      = array.from(1.272, 1.128, 0.786, 0.618, 1.272)
var array<float>  bcAnchorArray    = array.from(1.618, 2.24, 1.272, 2.0, 2.0)
var array<bool>   dFromXcArray     = array.from(false, false, false, false, true)

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{

lengthInput = input.int(10, 'Swing Length', minval = 2, group = DETECTION_GROUP, tooltip = 'Pivot length used to detect the X, A, B, C and D swing points. Larger values search for anti-patterns built from larger swings; each point confirms this many bars after its extreme.')

toleranceInput = input.float(5, 'Ratio Tolerance %', minval = 0, maxval = 25, step = 0.5, group = DETECTION_GROUP, tooltip = 'Allowed deviation around each Fibonacci ratio window, as a percentage of the ratio itself. Anti-pattern ratio tables differ slightly between sources, so a moderate tolerance keeps detection practical.')

bcFilterInput = input.bool(true, 'BC Projection Cross-Check', group = DETECTION_GROUP, tooltip = 'Requires the CD leg, expressed as a projection of BC, to land inside a plausible harmonic band (1.128 to 4.236) before a completion is accepted, mirroring the BC cross-check applied to the parent patterns.')

showGartleyInput = input.bool(true, 'Anti-Gartley', group = PATTERNS_GROUP, tooltip = 'Reciprocal Gartley: B retraces deep, 0.618 to 0.786 of XA, and D completes near the 1.272 extension of XA, the reciprocal of the parent 0.786 completion.')

showBatInput = input.bool(true, 'Anti-Bat', group = PATTERNS_GROUP, tooltip = 'Reciprocal Bat: B retraces 0.382 to 0.618 of XA and D completes near the 1.128 extension of XA, the reciprocal of the parent 0.886 completion.')

showButterflyInput = input.bool(true, 'Anti-Butterfly', group = PATTERNS_GROUP, tooltip = 'Reciprocal Butterfly: B retraces 0.382 to 0.618 of XA and D completes inside XA near the 0.786 retracement, the reciprocal of the parent 1.272 extension.')

showCrabInput = input.bool(true, 'Anti-Crab', group = PATTERNS_GROUP, tooltip = 'Reciprocal Crab: shallow B, 0.276 to 0.382 of XA, with D completing inside XA near the 0.618 retracement, the reciprocal of the parent 1.618 extension.')

showCypherInput = input.bool(true, 'Anti-Cypher', group = PATTERNS_GROUP, tooltip = 'Reciprocal Cypher: B retraces 0.382 to 0.618 of XA, C holds inside XA at 0.707 to 0.786 of the XA leg, and D completes near the 1.272 extension of XC, the reciprocal of the parent 0.786 XC completion.')

bullColorInput = input.color(#089981, 'Bullish Patterns', group = STYLE_GROUP, inline = 'colors')
bearColorInput = input.color(#f23645, 'Bearish Patterns', group = STYLE_GROUP, inline = 'colors')

showPointLabelsInput = input.bool(true, 'Point Labels', group = STYLE_GROUP, tooltip = 'Marks the X, A, B, C and D swing points of each detected anti-pattern.')

showRatiosInput = input.bool(true, 'Measured Ratios', group = STYLE_GROUP, tooltip = 'Appends the measured B retracement, D completion and BC projection to the pattern name label, so the tool can be verified against other ratio tables.')

showTrianglesInput = input.bool(true, 'Triangle Lines', group = STYLE_GROUP, tooltip = 'Draws the dashed X-B and B-D lines outlining the two triangles of the XABCD structure.')

showPrzInput = input.bool(true, 'Completion Zone', group = STYLE_GROUP, tooltip = 'Draws the potential reversal zone at D, spanning the XA-based (or XC-based) completion level and the reciprocal BC projection level, and extends it until a reaction swing confirms.')

showSwingsInput = input.bool(true, 'Show Swings', group = STYLE_GROUP, inline = 'swings')
swingColorInput = input.color(color.new(#787b86, 50), '', group = STYLE_GROUP, inline = 'swings')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// registers a confirmed pivot into the zigzag, returns 0 = no change, 1 = new swing point, 2 = last swing point extended
f_addPivot(array<float> priceArray, array<int> barArray, array<int> dirArray, float pivotPrice, int pivotBar, int pivotDir) =>
    int changeType = 0
    int n = array.size(priceArray)
    if n == 0
        array.push(priceArray, pivotPrice)
        array.push(barArray, pivotBar)
        array.push(dirArray, pivotDir)
        changeType := 1
    else
        if pivotDir == array.get(dirArray, n - 1)
            float lastPrice = array.get(priceArray, n - 1)
            if (pivotDir == 1 and pivotPrice >= lastPrice) or (pivotDir == -1 and pivotPrice <= lastPrice)
                array.set(priceArray, n - 1, pivotPrice)
                array.set(barArray, n - 1, pivotBar)
                changeType := 2
        else
            array.push(priceArray, pivotPrice)
            array.push(barArray, pivotBar)
            array.push(dirArray, pivotDir)
            changeType := 1
            if array.size(priceArray) > MAX_PIVOTS
                array.shift(priceArray)
                array.shift(barArray)
                array.shift(dirArray)
    changeType

// draws or extends the faint zigzag segment joining the two most recent swing points
f_swingSegment(array<float> priceArray, array<int> barArray, int changeType, line previousSegment) =>
    line segment = previousSegment
    if showSwingsInput
        int n = array.size(priceArray)
        if changeType == 1 and n >= 2
            segment := line.new(array.get(barArray, n - 2), array.get(priceArray, n - 2), array.get(barArray, n - 1), array.get(priceArray, n - 1), color = swingColorInput, style = line.style_dotted)
        else if changeType == 2 and not na(previousSegment)
            line.set_xy2(previousSegment, array.get(barArray, n - 1), array.get(priceArray, n - 1))
    segment

// ratio window test with the tolerance factor applied to both bounds
f_inWindow(float value, float low, float high) =>
    float tolFactor = toleranceInput / 100
    value >= low * (1 - tolFactor) and value <= high * (1 + tolFactor)

//---------------------------------------------------------------------------------------------------------------------}
// Swing Detection
//---------------------------------------------------------------------------------------------------------------------{

var array<float> zzPriceArray = array.new<float>()
var array<int>   zzBarArray   = array.new<int>()
var array<int>   zzDirArray   = array.new<int>()

var line lastSwingSegment = na

float pivotHigh = ta.pivothigh(lengthInput, lengthInput)
float pivotLow  = ta.pivotlow(lengthInput, lengthInput)

int zigzagChange = 0
if not na(pivotHigh)
    int changeType = f_addPivot(zzPriceArray, zzBarArray, zzDirArray, pivotHigh, bar_index - lengthInput, 1)
    if changeType != 0
        zigzagChange := changeType
        lastSwingSegment := f_swingSegment(zzPriceArray, zzBarArray, changeType, lastSwingSegment)
if not na(pivotLow)
    int changeType = f_addPivot(zzPriceArray, zzBarArray, zzDirArray, pivotLow, bar_index - lengthInput, -1)
    if changeType != 0
        zigzagChange := changeType
        lastSwingSegment := f_swingSegment(zzPriceArray, zzBarArray, changeType, lastSwingSegment)

//---------------------------------------------------------------------------------------------------------------------}
// Anti-Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{

var array<bool> enabledArray = array.from(showGartleyInput, showBatInput, showButterflyInput, showCrabInput, showCypherInput)

var int currentKey   = -1
var int currentIndex = -1
var int currentDBar  = na

var array<line>  patternLineArray  = array.new<line>()
var array<label> patternLabelArray = array.new<label>()

var box przBoxId = na

bool bullGartleyAlert   = false
bool bearGartleyAlert   = false
bool bullBatAlert       = false
bool bearBatAlert       = false
bool bullButterflyAlert = false
bool bearButterflyAlert = false
bool bullCrabAlert      = false
bool bearCrabAlert      = false
bool bullCypherAlert    = false
bool bearCypherAlert    = false
bool bullAnyAlert       = false
bool bearAnyAlert       = false

if zigzagChange != 0 and array.size(zzPriceArray) >= 5
    int n = array.size(zzPriceArray)

    float pX = array.get(zzPriceArray, n - 5)
    float pA = array.get(zzPriceArray, n - 4)
    float pB = array.get(zzPriceArray, n - 3)
    float pC = array.get(zzPriceArray, n - 2)
    float pD = array.get(zzPriceArray, n - 1)
    int   bX = array.get(zzBarArray, n - 5)
    int   bA = array.get(zzBarArray, n - 4)
    int   bB = array.get(zzBarArray, n - 3)
    int   bC = array.get(zzBarArray, n - 2)
    int   bD = array.get(zzBarArray, n - 1)

    // a trough at D is a candidate bullish completion, a peak at D a bearish one
    bool  isBull = array.get(zzDirArray, n - 1) == -1
    float s = isBull ? 1.0 : -1.0

    // signed prices so the bullish geometry applies to both directions
    float vX = s * pX
    float vA = s * pA
    float vB = s * pB
    float vC = s * pC
    float vD = s * pD

    float xaLeg = vA - vX
    float abLeg = vA - vB
    float bcLeg = vC - vB
    float cdLeg = vC - vD
    float xcLeg = vC - vX

    // valid XABCD skeleton: B inside XA, C between B and A, D beyond B
    bool structureOk = xaLeg > 0 and abLeg > 0 and bcLeg > 0 and cdLeg > 0 and vB > vX and vC < vA and vD < vB

    float bRatio       = na
    float cRatio       = na
    float cPosRatio    = na
    float dXaRatio     = na
    float dXcRatio     = na
    float bcProjection = na

    int   bestIndex = -1
    float bestScore = 0.0

    if structureOk
        bRatio       := abLeg / xaLeg
        cRatio       := bcLeg / abLeg
        cPosRatio    := xcLeg / xaLeg
        dXaRatio     := (vA - vD) / xaLeg
        dXcRatio     := cdLeg / xcLeg
        bcProjection := cdLeg / bcLeg

        bool bcBandOk = not bcFilterInput or (bcProjection >= BC_PROJ_MIN and bcProjection <= BC_PROJ_MAX)
        if bcBandOk
            for i = 0 to PATTERN_COUNT - 1
                if array.get(enabledArray, i)
                    bool  dFromXc   = array.get(dFromXcArray, i)
                    float dIdeal    = array.get(dIdealArray, i)
                    float dMeasured = dFromXc ? dXcRatio : dXaRatio
                    float cMeasured = dFromXc ? cPosRatio : cRatio
                    bool  bOk = f_inWindow(bRatio, array.get(bLowArray, i), array.get(bHighArray, i))
                    bool  cOk = f_inWindow(cMeasured, array.get(cLowArray, i), array.get(cHighArray, i))
                    bool  dOk = f_inWindow(dMeasured, dIdeal, dIdeal)
                    if bOk and cOk and dOk
                        float score = math.abs(dMeasured - dIdeal) / dIdeal
                        if bestIndex == -1 or score < bestScore
                            bestIndex := i
                            bestScore := score

    // the C bar identifies the structure: it is stable while the D swing keeps extending
    int patternKey = bC

    if bestIndex >= 0
        bool sameKey = patternKey == currentKey

        // an extended D redraws the same structure, a new structure leaves the previous drawings in place
        if sameKey
            int lineCount = array.size(patternLineArray)
            if lineCount > 0
                for i = 0 to lineCount - 1
                    line.delete(array.get(patternLineArray, i))
            int labelCount = array.size(patternLabelArray)
            if labelCount > 0
                for i = 0 to labelCount - 1
                    label.delete(array.get(patternLabelArray, i))
            box.delete(przBoxId)
        array.clear(patternLineArray)
        array.clear(patternLabelArray)
        przBoxId := na

        color patternColor = isBull ? bullColorInput : bearColorInput

        array.push(patternLineArray, line.new(bX, pX, bA, pA, color = patternColor, width = 2))
        array.push(patternLineArray, line.new(bA, pA, bB, pB, color = patternColor, width = 2))
        array.push(patternLineArray, line.new(bB, pB, bC, pC, color = patternColor, width = 2))
        array.push(patternLineArray, line.new(bC, pC, bD, pD, color = patternColor, width = 2))
        if showTrianglesInput
            array.push(patternLineArray, line.new(bX, pX, bB, pB, color = color.new(patternColor, 50), style = line.style_dashed))
            array.push(patternLineArray, line.new(bB, pB, bD, pD, color = color.new(patternColor, 50), style = line.style_dashed))

        string troughStyle = label.style_label_up
        string peakStyle   = label.style_label_down
        string styleXbd    = isBull ? troughStyle : peakStyle
        string styleAc     = isBull ? peakStyle : troughStyle
        if showPointLabelsInput
            array.push(patternLabelArray, label.new(bX, pX, 'X', color = TRANSPARENT_COLOR, textcolor = patternColor, style = styleXbd, size = size.tiny))
            array.push(patternLabelArray, label.new(bA, pA, 'A', color = TRANSPARENT_COLOR, textcolor = patternColor, style = styleAc, size = size.tiny))
            array.push(patternLabelArray, label.new(bB, pB, 'B', color = TRANSPARENT_COLOR, textcolor = patternColor, style = styleXbd, size = size.tiny))
            array.push(patternLabelArray, label.new(bC, pC, 'C', color = TRANSPARENT_COLOR, textcolor = patternColor, style = styleAc, size = size.tiny))
            array.push(patternLabelArray, label.new(bD, pD, 'D', color = TRANSPARENT_COLOR, textcolor = patternColor, style = styleXbd, size = size.tiny))

        bool  bestFromXc     = array.get(dFromXcArray, bestIndex)
        float bestDMeasured  = bestFromXc ? dXcRatio : dXaRatio
        string titleText = array.get(patternNameArray, bestIndex)
        if showRatiosInput
            titleText += '\nB ≈ ' + str.tostring(bRatio, '#.###') + ' · D ≈ ' + str.tostring(bestDMeasured, '#.###') + ' · BC ≈ ' + str.tostring(bcProjection, '#.##')
        int   midBar   = math.round(math.avg(bX, bD))
        float extremeY = isBull ? math.max(pA, pC) : math.min(pA, pC)
        array.push(patternLabelArray, label.new(midBar, extremeY, titleText, color = TRANSPARENT_COLOR, textcolor = patternColor, style = isBull ? peakStyle : troughStyle, size = size.small))

        // completion zone: the two measurements of the identify checklist, XA (or XC) based level and BC projection
        if showPrzInput
            float dIdealBest   = array.get(dIdealArray, bestIndex)
            float bcAnchorBest = array.get(bcAnchorArray, bestIndex)
            float przPrimary   = s * (bestFromXc ? vC - dIdealBest * xcLeg : vA - dIdealBest * xaLeg)
            float przSecondary = s * (vC - bcAnchorBest * bcLeg)
            przBoxId := box.new(bD, math.max(przPrimary, przSecondary), bar_index, math.min(przPrimary, przSecondary), border_color = color.new(patternColor, 50), border_style = line.style_dashed, bgcolor = color.new(patternColor, 85))

        if not sameKey or bestIndex != currentIndex
            if bestIndex == 0
                if isBull
                    bullGartleyAlert := true
                else
                    bearGartleyAlert := true
            else if bestIndex == 1
                if isBull
                    bullBatAlert := true
                else
                    bearBatAlert := true
            else if bestIndex == 2
                if isBull
                    bullButterflyAlert := true
                else
                    bearButterflyAlert := true
            else if bestIndex == 3
                if isBull
                    bullCrabAlert := true
                else
                    bearCrabAlert := true
            else
                if isBull
                    bullCypherAlert := true
                else
                    bearCypherAlert := true
        if not sameKey
            if isBull
                bullAnyAlert := true
            else
                bearAnyAlert := true

        currentKey   := patternKey
        currentIndex := bestIndex
        currentDBar  := bD
    else if patternKey == currentKey and currentKey != -1
        // the D swing extended beyond every ratio window, the structure is no longer an anti-pattern
        int lineCount = array.size(patternLineArray)
        if lineCount > 0
            for i = 0 to lineCount - 1
                line.delete(array.get(patternLineArray, i))
        int labelCount = array.size(patternLabelArray)
        if labelCount > 0
            for i = 0 to labelCount - 1
                label.delete(array.get(patternLabelArray, i))
        array.clear(patternLineArray)
        array.clear(patternLabelArray)
        box.delete(przBoxId)
        przBoxId     := na
        currentKey   := -1
        currentIndex := -1
        currentDBar  := na

//---------------------------------------------------------------------------------------------------------------------}
// Completion Zone Tracking
//---------------------------------------------------------------------------------------------------------------------{

// the zone stays anchored to the latest bar until a reaction swing confirms beyond D
if not na(przBoxId)
    int zzCount = array.size(zzBarArray)
    int lastZzBar = zzCount > 0 ? array.get(zzBarArray, zzCount - 1) : -1
    if not na(currentDBar) and lastZzBar == currentDBar
        box.set_right(przBoxId, bar_index)
    else
        przBoxId := na

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bullGartleyAlert, 'Bullish Anti-Gartley', 'Bullish anti-Gartley completed: D near the 1.272 extension of XA, watch for an upside reaction inside the completion zone')
alertcondition(bearGartleyAlert, 'Bearish Anti-Gartley', 'Bearish anti-Gartley completed: D near the 1.272 extension of XA, watch for a downside reaction inside the completion zone')
alertcondition(bullBatAlert, 'Bullish Anti-Bat', 'Bullish anti-Bat completed: D near the 1.128 extension of XA, watch for an upside reaction inside the completion zone')
alertcondition(bearBatAlert, 'Bearish Anti-Bat', 'Bearish anti-Bat completed: D near the 1.128 extension of XA, watch for a downside reaction inside the completion zone')
alertcondition(bullButterflyAlert, 'Bullish Anti-Butterfly', 'Bullish anti-Butterfly completed: D inside XA near the 0.786 retracement, watch for an upside reaction inside the completion zone')
alertcondition(bearButterflyAlert, 'Bearish Anti-Butterfly', 'Bearish anti-Butterfly completed: D inside XA near the 0.786 retracement, watch for a downside reaction inside the completion zone')
alertcondition(bullCrabAlert, 'Bullish Anti-Crab', 'Bullish anti-Crab completed: D inside XA near the 0.618 retracement, watch for an upside reaction inside the completion zone')
alertcondition(bearCrabAlert, 'Bearish Anti-Crab', 'Bearish anti-Crab completed: D inside XA near the 0.618 retracement, watch for a downside reaction inside the completion zone')
alertcondition(bullCypherAlert, 'Bullish Anti-Cypher', 'Bullish anti-Cypher completed: D near the 1.272 extension of XC, watch for an upside reaction inside the completion zone')
alertcondition(bearCypherAlert, 'Bearish Anti-Cypher', 'Bearish anti-Cypher completed: D near the 1.272 extension of XC, watch for a downside reaction inside the completion zone')
alertcondition(bullAnyAlert, 'Bullish Anti-Pattern', 'An anti-pattern completed with a bullish D point, expected resolution runs with the newer up move')
alertcondition(bearAnyAlert, 'Bearish Anti-Pattern', 'An anti-pattern completed with a bearish D point, expected resolution runs with the newer down move')

//---------------------------------------------------------------------------------------------------------------------}
