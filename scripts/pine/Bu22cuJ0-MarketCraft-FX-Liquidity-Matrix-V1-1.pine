//@version=6

indicator("MarketCraft FX - Liquidity Matrix V1.2", "MCFX Liquidity Matrix V1.2", overlay = true,
     max_boxes_count = 200, max_lines_count = 200, max_labels_count = 300)

//=============================================================================
// INPUTS
//=============================================================================

string GROUP_ENGINE  = "Liquidity Engine"
string GROUP_ZONE    = "Zone Construction"
string GROUP_DISPLAY = "Display"
string GROUP_COLOUR  = "MarketCraft Colours"
string GROUP_STYLE   = "Zones & Levels"
string GROUP_PANEL   = "Panel Appearance"
string GROUP_ALERTS  = "Alerts"

int swingLeft = input.int(10, "Swing Length", minval = 2, maxval = 100, group = GROUP_ENGINE,
     tooltip = "Bars used to confirm each liquidity-bearing swing.")
int swingRight = input.int(8, "Confirmation Bars", minval = 1, maxval = 50, group = GROUP_ENGINE)
string strengthFilter = input.string("Strong", "Minimum Zone Grade",
     options = ["Primary", "Strong", "Major"], group = GROUP_ENGINE)
float minVolumeRatio = input.float(1.10, "Relative Volume Threshold", minval = 0.10,
     step = 0.05, group = GROUP_ENGINE)
float minDepartureAtr = input.float(0.80, "Departure Threshold (ATR)", minval = 0.10,
     step = 0.05, group = GROUP_ENGINE)
bool useVolume = input.bool(true, "Use Volume In Scoring", group = GROUP_ENGINE)
bool dualQualification = input.bool(true, "Dual Structural + Volume Detection", group = GROUP_ENGINE,
     tooltip = "Allows a meaningful pivot to qualify through either strong displacement or relative volume. Disable to require volume confirmation on every zone.")

int atrLength = input.int(200, "ATR Length", minval = 10, group = GROUP_ZONE)
float fixedDepthAtr = input.float(0.30, "Base Zone Depth (ATR)", minval = 0.02,
     step = 0.01, group = GROUP_ZONE)
bool dynamicDepth = input.bool(true, "Dynamic Strength-Based Depth", group = GROUP_ZONE)
float maximumDepthAtr = input.float(0.80, "Maximum Zone Depth (ATR)", minval = 0.05,
     step = 0.05, group = GROUP_ZONE)
float mergeDistanceAtr = input.float(0.20, "Merge Nearby Levels (ATR)", minval = 0.0,
     step = 0.05, group = GROUP_ZONE)
int zonesPerSide = input.int(10, "Zones Per Side", minval = 1, maxval = 40, group = GROUP_ZONE)
int extendBars = input.int(20, "Extend Past Current Price", minval = 1, maxval = 100,
     group = GROUP_ZONE)

bool showPrimary = input.bool(true, "Show PRIMARY Text", group = GROUP_DISPLAY)
bool showPrices = input.bool(true, "Show Zone Prices", group = GROUP_DISPLAY)
bool showVolume = input.bool(false, "Show Relative Volume", group = GROUP_DISPLAY)
bool showSwingMarkers = input.bool(true, "Show Origin Markers", group = GROUP_DISPLAY)
bool retainSwept = input.bool(true, "Retain Swept Zones", group = GROUP_DISPLAY)
bool showPanel = input.bool(true, "Show Compact Panel", group = GROUP_DISPLAY)

color bslColour = input.color(#4D9DE0, "BSL", inline = "c1", group = GROUP_COLOUR)
color sslColour = input.color(#18A875, "SSL", inline = "c1", group = GROUP_COLOUR)
color sweptColour = input.color(#7C8796, "Swept", inline = "c2", group = GROUP_COLOUR)
color closeThroughColour = input.color(#E05252, "Close Through", inline = "c2", group = GROUP_COLOUR)
int zoneTransparency = input.int(82, "Zone Transparency", minval = 0, maxval = 100,
     group = GROUP_COLOUR)
int sweptTransparency = input.int(92, "Swept Transparency", minval = 0, maxval = 100,
     group = GROUP_COLOUR)

string activeLineStyleInput = input.string("Solid", "Active Level Style",
     options = ["Solid", "Dashed", "Dotted"], group = GROUP_STYLE)
string completedLineStyleInput = input.string("Dashed", "Completed Level Style",
     options = ["Solid", "Dashed", "Dotted"], group = GROUP_STYLE)
int activeLineWidth = input.int(2, "Active Level Width", minval = 1, maxval = 4, group = GROUP_STYLE)
int completedLineWidth = input.int(1, "Completed Level Width", minval = 1, maxval = 4, group = GROUP_STYLE)
int zoneBorderWidth = input.int(1, "Zone Border Width", minval = 0, maxval = 4, group = GROUP_STYLE)
string zoneLabelSizeInput = input.string("Tiny", "Zone Label Size",
     options = ["Tiny", "Small", "Normal", "Large"], group = GROUP_STYLE)
color bslLabelTextColour = input.color(color.white, "BSL Label Text", inline = "zt", group = GROUP_STYLE)
color sslLabelTextColour = input.color(color.white, "SSL Label Text", inline = "zt", group = GROUP_STYLE)
color completedLabelTextColour = input.color(color.white, "Completed Label Text", group = GROUP_STYLE)
bool showBoundaryLevel = input.bool(true, "Show Outer Boundary Level", group = GROUP_STYLE)
bool showZoneFill = input.bool(true, "Show Zone Fill", group = GROUP_STYLE)

string panelPosition = input.string("Top Right", "Position",
     options = ["Top Left", "Top Centre", "Top Right", "Middle Left", "Middle Centre",
          "Middle Right", "Bottom Left", "Bottom Centre", "Bottom Right"], group = GROUP_PANEL)
string panelTextSizeInput = input.string("Tiny", "Text Size",
     options = ["Tiny", "Small", "Normal", "Large"], group = GROUP_PANEL)
color panelTextColour = input.color(color.black, "Row Text", inline = "pt", group = GROUP_PANEL)
color panelValueTextColour = input.color(color.black, "Value Text", inline = "pt", group = GROUP_PANEL)
color panelBSLValueColour = input.color(#2370A3, "BSL Value", inline = "pv", group = GROUP_PANEL)
color panelSSLValueColour = input.color(#DF1C1C, "SSL Value", inline = "pv", group = GROUP_PANEL)
color panelTitleTextColour = input.color(color.black, "Title Text", inline = "ph", group = GROUP_PANEL)
color panelTitleRightTextColour = input.color(color.black, "Title 2 Text", inline = "ph", group = GROUP_PANEL)
color panelBackgroundColour = input.color(#D8D8D8, "Background", inline = "pb", group = GROUP_PANEL)
color panelBorderColour = input.color(#777777, "Border", inline = "pb", group = GROUP_PANEL)
color panelTitleLeftColour = input.color(#8ECDF3, "Title Left", inline = "pc", group = GROUP_PANEL)
color panelTitleRightColour = input.color(#18A875, "Title Right", inline = "pc", group = GROUP_PANEL)
int panelTransparency = input.int(5, "Background Transparency", minval = 0, maxval = 100, group = GROUP_PANEL)
int panelBorderWidth = input.int(1, "Border Width", minval = 0, maxval = 4, group = GROUP_PANEL)
bool directionalPanelValues = input.bool(true, "Directional Value Colours", group = GROUP_PANEL,
     tooltip = "Uses blue for BSL and red for SSL values. Disable for the selected general value-text colour.")

bool enableSweepAlerts = input.bool(true, "Liquidity Sweep Alerts", group = GROUP_ALERTS)
bool enableCloseAlerts = input.bool(true, "Close-Through Alerts", group = GROUP_ALERTS)
bool enableApproachAlerts = input.bool(false, "Zone Approach Alerts", group = GROUP_ALERTS)
float approachAtr = input.float(0.25, "Approach Distance (ATR)", minval = 0.05,
     step = 0.05, group = GROUP_ALERTS)

//=============================================================================
// DATA MODEL
//=============================================================================

type LiquidityZone
    box zoneBox
    line boundaryLine
    label zoneLabel
    float innerPrice
    float outerPrice
    float volumeRatio
    int gradeScore
    int originBar
    bool isBSL
    bool isSwept
    bool isCloseThrough
    bool approachAlerted

var array<LiquidityZone> liquidityZones = array.new<LiquidityZone>()

float atr = ta.atr(atrLength)
float averageVolume = ta.sma(volume, 50)
float pivotHigh = ta.pivothigh(high, swingLeft, swingRight)
float pivotLow = ta.pivotlow(low, swingLeft, swingRight)

int requiredScore = strengthFilter == "Major" ? 4 : strengthFilter == "Strong" ? 3 : 2

f_panelPosition(string selected) =>
    selected == "Top Left" ? position.top_left :
     selected == "Top Centre" ? position.top_center :
     selected == "Middle Left" ? position.middle_left :
     selected == "Middle Centre" ? position.middle_center :
     selected == "Middle Right" ? position.middle_right :
     selected == "Bottom Right" ? position.bottom_right :
     selected == "Bottom Centre" ? position.bottom_center :
     selected == "Bottom Left" ? position.bottom_left : position.top_right

f_lineStyle(string selected) =>
    selected == "Dashed" ? line.style_dashed : selected == "Dotted" ? line.style_dotted : line.style_solid

f_textSize(string selected) =>
    selected == "Small" ? size.small : selected == "Normal" ? size.normal :
     selected == "Large" ? size.large : size.tiny

f_grade(int score) =>
    score >= 4 ? "MAJOR" : score >= 3 ? "STRONG" : "PRIMARY"

f_zoneText(bool isBSL, int score, float outerPrice, float volumeRatio, string state) =>
    string side = isBSL ? "BSL" : "SSL"
    string grade = f_grade(score)
    string gradePart = grade == "PRIMARY" and not showPrimary ? "" : " " + grade
    string pricePart = showPrices ? "\n" + str.tostring(outerPrice, format.mintick) : ""
    string volumePart = showVolume ? "\nRVOL " + str.tostring(volumeRatio, "#.##") + "x" : ""
    side + gradePart + "\n" + state + pricePart + volumePart

f_score(bool isBSL, int offset, float pivotPrice, float pivotAtr, float volumeRatio) =>
    int score = 2
    float departure = isBSL ? pivotPrice - ta.lowest(low, swingRight + 1) : ta.highest(high, swingRight + 1) - pivotPrice
    float departureRatio = pivotAtr > 0 ? departure / pivotAtr : 0.0
    if departureRatio >= minDepartureAtr
        score += 1
    if useVolume and volumeRatio >= minVolumeRatio
        score += 1
    bool decisiveCandle = isBSL ? close < open and math.abs(close - open) > pivotAtr * 0.25 : close > open and math.abs(close - open) > pivotAtr * 0.25
    if decisiveCandle
        score += 1
    math.min(score, 5)

f_hasNearby(float outerPrice, bool isBSL, float tolerance) =>
    bool found = false
    int count = array.size(liquidityZones)
    if count > 0
        for i = 0 to count - 1
            LiquidityZone existing = array.get(liquidityZones, i)
            if existing.isBSL == isBSL and not existing.isSwept and math.abs(existing.outerPrice - outerPrice) <= tolerance
                found := true
    found

f_trimSide(bool isBSL) =>
    int sideCount = 0
    int oldestIndex = na
    int oldestBar = bar_index
    int count = array.size(liquidityZones)
    if count > 0
        for i = 0 to count - 1
            LiquidityZone candidate = array.get(liquidityZones, i)
            if candidate.isBSL == isBSL
                sideCount += 1
                if candidate.originBar <= oldestBar
                    oldestBar := candidate.originBar
                    oldestIndex := i
    if sideCount >= zonesPerSide and not na(oldestIndex)
        LiquidityZone oldest = array.get(liquidityZones, oldestIndex)
        box.delete(oldest.zoneBox)
        line.delete(oldest.boundaryLine)
        label.delete(oldest.zoneLabel)
        array.remove(liquidityZones, oldestIndex)

f_createZone(bool isBSL, float pivotPrice, int offset) =>
    float pivotAtr = atr[offset]
    float pivotAverageVolume = averageVolume[offset]
    float volumeRatio = pivotAverageVolume > 0 ? volume[offset] / pivotAverageVolume : 1.0
    int score = f_score(isBSL, offset, pivotPrice, pivotAtr, volumeRatio)
    float strengthMultiplier = dynamicDepth ? math.min(1.0 + math.max(volumeRatio - 1.0, 0.0) * 0.25, 2.0) : 1.0
    float depth = math.min(pivotAtr * fixedDepthAtr * strengthMultiplier, pivotAtr * maximumDepthAtr)
    float innerPrice = pivotPrice
    float outerPrice = isBSL ? pivotPrice + depth : pivotPrice - depth
    float topPrice = math.max(innerPrice, outerPrice)
    float bottomPrice = math.min(innerPrice, outerPrice)
    int origin = bar_index - offset
    color baseColour = isBSL ? bslColour : sslColour
    float departure = isBSL ? pivotPrice - ta.lowest(low, swingRight + 1) : ta.highest(high, swingRight + 1) - pivotPrice
    float departureRatio = pivotAtr > 0 ? departure / pivotAtr : 0.0
    bool structuralPass = departureRatio >= minDepartureAtr
    bool volumePass = not useVolume or volumeRatio >= minVolumeRatio
    // MarketCraft dual detection: displacement and relative volume are independent
    // qualification paths. This preserves significant levels when tick volume is
    // muted, while the selected grade still controls overall quality.
    bool routePass = dualQualification ? (structuralPass or volumePass) : volumePass
    bool accepted = score >= requiredScore and routePass and not f_hasNearby(outerPrice, isBSL, atr * mergeDistanceAtr)
    if accepted
        f_trimSide(isBSL)
        box newBox = box.new(left = origin, top = topPrice, right = bar_index + extendBars,
             bottom = bottomPrice, xloc = xloc.bar_index, border_color = baseColour,
             border_width = score >= 4 ? math.max(zoneBorderWidth, 2) : zoneBorderWidth,
             bgcolor = showZoneFill ? color.new(baseColour, zoneTransparency) : na)
        line newLine = line.new(x1 = origin, y1 = outerPrice, x2 = bar_index + extendBars,
             y2 = outerPrice, xloc = xloc.bar_index, color = showBoundaryLevel ? baseColour : na,
             width = activeLineWidth, style = f_lineStyle(activeLineStyleInput))
        label newLabel = label.new(x = bar_index + extendBars, y = outerPrice,
             text = f_zoneText(isBSL, score, outerPrice, volumeRatio, "FRESH"),
             xloc = xloc.bar_index, style = isBSL ? label.style_label_lower_left : label.style_label_upper_left,
             color = baseColour, textcolor = isBSL ? bslLabelTextColour : sslLabelTextColour,
             size = f_textSize(zoneLabelSizeInput))
        array.push(liquidityZones, LiquidityZone.new(newBox, newLine, newLabel, innerPrice,
             outerPrice, volumeRatio, score, origin, isBSL, false, false, false))

//=============================================================================
// CREATE NEW LIQUIDITY ZONES
//=============================================================================

bool newBSL = not na(pivotHigh) and not na(atr[swingRight])
bool newSSL = not na(pivotLow) and not na(atr[swingRight])

if newBSL
    f_createZone(true, pivotHigh, swingRight)

if newSSL
    f_createZone(false, pivotLow, swingRight)

plotshape(showSwingMarkers and newBSL, title = "BSL Origin", style = shape.circle,
     location = location.abovebar, offset = -swingRight, color = color.new(bslColour, 10),
     size = size.tiny)
plotshape(showSwingMarkers and newSSL, title = "SSL Origin", style = shape.circle,
     location = location.belowbar, offset = -swingRight, color = color.new(sslColour, 10),
     size = size.tiny)

//=============================================================================
// LIVE ZONE MANAGEMENT
//=============================================================================

bool bslSweptThisBar = false
bool sslSweptThisBar = false
bool bslClosedThisBar = false
bool sslClosedThisBar = false
bool zoneApproachedThisBar = false

float nearestBSL = na
float nearestSSL = na
string nearestBSLGrade = "NONE"
string nearestSSLGrade = "NONE"
string latestEvent = "MONITORING"

int zoneCount = array.size(liquidityZones)
if zoneCount > 0
    for i = zoneCount - 1 to 0
        LiquidityZone zone = array.get(liquidityZones, i)
        color activeColour = zone.isBSL ? bslColour : sslColour

        if not zone.isSwept
            int liveRight = bar_index + extendBars
            box.set_right(zone.zoneBox, liveRight)
            line.set_x2(zone.boundaryLine, liveRight)
            label.set_x(zone.zoneLabel, liveRight)

            bool sweptNow = bar_index > zone.originBar and (zone.isBSL ? high >= zone.outerPrice : low <= zone.outerPrice)
            bool closedNow = zone.isBSL ? close > zone.outerPrice : close < zone.outerPrice
            float distance = zone.isBSL ? zone.innerPrice - high : low - zone.innerPrice
            bool approachingNow = distance >= 0 and distance <= atr * approachAtr

            if approachingNow and not zone.approachAlerted
                zone.approachAlerted := true
                zoneApproachedThisBar := true
                label.set_text(zone.zoneLabel, f_zoneText(zone.isBSL, zone.gradeScore,
                     zone.outerPrice, zone.volumeRatio, "APPROACHING"))

            if sweptNow
                zone.isSwept := true
                zone.isCloseThrough := closedNow
                color finalColour = closedNow ? closeThroughColour : sweptColour
                string finalState = closedNow ? "CLOSE-THROUGH" : "LIQUIDITY SWEPT"
                box.set_right(zone.zoneBox, bar_index)
                box.set_border_color(zone.zoneBox, finalColour)
                box.set_bgcolor(zone.zoneBox, color.new(finalColour, sweptTransparency))
                line.set_x2(zone.boundaryLine, bar_index)
                line.set_color(zone.boundaryLine, showBoundaryLevel ? finalColour : na)
                line.set_style(zone.boundaryLine, f_lineStyle(completedLineStyleInput))
                line.set_width(zone.boundaryLine, completedLineWidth)
                label.set_x(zone.zoneLabel, bar_index)
                label.set_color(zone.zoneLabel, finalColour)
                label.set_textcolor(zone.zoneLabel, completedLabelTextColour)
                label.set_text(zone.zoneLabel, f_zoneText(zone.isBSL, zone.gradeScore,
                     zone.outerPrice, zone.volumeRatio, finalState))
                label.new(bar_index, zone.outerPrice, closedNow ? "×" : "◉", xloc = xloc.bar_index,
                     style = label.style_label_center, color = color.new(finalColour, 100),
                     textcolor = finalColour, size = size.small,
                     tooltip = zone.isBSL ? "Buy-side liquidity event" : "Sell-side liquidity event")

                if zone.isBSL
                    bslSweptThisBar := not closedNow
                    bslClosedThisBar := closedNow
                else
                    sslSweptThisBar := not closedNow
                    sslClosedThisBar := closedNow

                latestEvent := (zone.isBSL ? "BSL " : "SSL ") + finalState

                if not retainSwept
                    box.delete(zone.zoneBox)
                    line.delete(zone.boundaryLine)
                    label.delete(zone.zoneLabel)
                    array.remove(liquidityZones, i)
                else
                    array.set(liquidityZones, i, zone)
            else
                array.set(liquidityZones, i, zone)

        if not zone.isSwept
            if zone.isBSL and zone.innerPrice > close
                if na(nearestBSL) or zone.innerPrice < nearestBSL
                    nearestBSL := zone.innerPrice
                    nearestBSLGrade := f_grade(zone.gradeScore)
            if not zone.isBSL and zone.innerPrice < close
                if na(nearestSSL) or zone.innerPrice > nearestSSL
                    nearestSSL := zone.innerPrice
                    nearestSSLGrade := f_grade(zone.gradeScore)

//=============================================================================
// MARKETCRAFT COMPACT PANEL
//=============================================================================

var table panel = table.new(f_panelPosition(panelPosition), 2, 6,
     frame_color = panelBorderColour, frame_width = panelBorderWidth,
     border_color = panelBorderColour, border_width = panelBorderWidth)

f_panelRow(int row, string heading, string value, color valueColour) =>
    color displayedValueColour = directionalPanelValues ? valueColour : panelValueTextColour
    table.cell(panel, 0, row, heading, bgcolor = color.new(panelBackgroundColour, panelTransparency),
         text_color = panelTextColour, text_size = f_textSize(panelTextSizeInput),
         text_halign = text.align_left)
    table.cell(panel, 1, row, value, bgcolor = color.new(panelBackgroundColour, panelTransparency),
         text_color = displayedValueColour, text_size = f_textSize(panelTextSizeInput), text_halign = text.align_right)

if barstate.islast
    if showPanel
        table.cell(panel, 0, 0, "MARKETCRAFT FX", bgcolor = panelTitleLeftColour,
             text_color = panelTitleTextColour, text_size = f_textSize(panelTextSizeInput), text_halign = text.align_left)
        table.cell(panel, 1, 0, "LIQUIDITY MATRIX", bgcolor = panelTitleRightColour,
             text_color = panelTitleRightTextColour, text_size = f_textSize(panelTextSizeInput), text_halign = text.align_right)
        f_panelRow(1, "DRAW", na(nearestBSL) and na(nearestSSL) ? "NONE" :
             na(nearestSSL) ? "BSL" : na(nearestBSL) ? "SSL" :
             math.abs(nearestBSL - close) <= math.abs(close - nearestSSL) ? "BSL" : "SSL",
             na(nearestSSL) ? panelBSLValueColour : na(nearestBSL) ? panelSSLValueColour :
             math.abs(nearestBSL - close) <= math.abs(close - nearestSSL) ? panelBSLValueColour : panelSSLValueColour)
        f_panelRow(2, "NEAREST BSL", na(nearestBSL) ? "NONE" :
             str.tostring(nearestBSL, format.mintick) + "  " + nearestBSLGrade, panelBSLValueColour)
        f_panelRow(3, "NEAREST SSL", na(nearestSSL) ? "NONE" :
             str.tostring(nearestSSL, format.mintick) + "  " + nearestSSLGrade, panelSSLValueColour)
        f_panelRow(4, "LIVE ZONES", str.tostring(array.size(liquidityZones)), chart.fg_color)
        f_panelRow(5, "STATUS", latestEvent, latestEvent == "MONITORING" ? chart.fg_color : sweptColour)
    else
        table.clear(panel, 0, 0, 1, 5)

//=============================================================================
// ALERTS
//=============================================================================

alertcondition(enableSweepAlerts and bslSweptThisBar, "MCFX BSL Swept",
     "MarketCraft FX: Buy-side liquidity swept on {{ticker}} {{interval}}.")
alertcondition(enableSweepAlerts and sslSweptThisBar, "MCFX SSL Swept",
     "MarketCraft FX: Sell-side liquidity swept on {{ticker}} {{interval}}.")
alertcondition(enableCloseAlerts and bslClosedThisBar, "MCFX BSL Close-Through",
     "MarketCraft FX: Price closed through BSL on {{ticker}} {{interval}}.")
alertcondition(enableCloseAlerts and sslClosedThisBar, "MCFX SSL Close-Through",
     "MarketCraft FX: Price closed through SSL on {{ticker}} {{interval}}.")
alertcondition(enableApproachAlerts and zoneApproachedThisBar, "MCFX Liquidity Approaching",
     "MarketCraft FX: Price is approaching an active liquidity zone on {{ticker}} {{interval}}.")
