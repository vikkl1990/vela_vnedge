//@version=6
indicator("Keltner Channels", "KC", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // lower band (support) and the basis while price holds above it
BEAR_COLOR    = #f23645 // upper band (resistance) and the basis while price sits below it
NEUTRAL_COLOR = #787b86

BAND_TRANSP = 30 // band line transparency
FILL_TRANSP = 90 // channel interior transparency
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
emaLengthInput  = input.int(20, "EMA Length", minval = 1, group = "Settings", tooltip = "Number of bars used to compute the exponential moving average basis line")
atrLengthInput  = input.int(10, "ATR Length", minval = 1, group = "Settings", tooltip = "Number of bars used to compute the Average True Range (Wilder smoothing)")
multiplierInput = input.float(2.0, "Multiplier", minval = 0, step = 0.1, group = "Settings", tooltip = "ATR multiple used to offset the upper and lower bands from the basis line")
sourceInput     = input.source(close, "Source", group = "Settings", tooltip = "Price series used to compute the basis line")

bullColorInput  = input.color(BULL_COLOR, "Bullish", inline = "colors", group = "Style", tooltip = "Color of the lower band and of the basis while price holds above it")
bearColorInput  = input.color(BEAR_COLOR, "Bearish", inline = "colors", group = "Style", tooltip = "Color of the upper band and of the basis while price sits below it")
basisColorInput = input.color(NEUTRAL_COLOR, "Basis Color", group = "Style", tooltip = "Color of the channel basis line while price sits exactly on it")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
basis    = ta.ema(sourceInput, emaLengthInput)
atrValue = ta.atr(atrLengthInput)

upper = basis + multiplierInput * atrValue
lower = basis - multiplierInput * atrValue
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
basisColor = close > basis ? bullColorInput : close < basis ? bearColorInput : basisColorInput

basisPlotId = plot(basis, "Basis", basisColor)
upperPlotId = plot(upper, "Upper", color.new(bearColorInput, BAND_TRANSP))
lowerPlotId = plot(lower, "Lower", color.new(bullColorInput, BAND_TRANSP))

fill(upperPlotId, lowerPlotId, top_value = upper, bottom_value = lower, top_color = color.new(bearColorInput, FILL_TRANSP), bottom_color = color.new(bullColorInput, FILL_TRANSP), title = "Channel Fill")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
upperCross = ta.crossover(close, upper)
lowerCross = ta.crossunder(close, lower)

alertcondition(upperCross, "Upper Band Crossover", "Close crossed above the Keltner Channel upper band")
alertcondition(lowerCross, "Lower Band Crossunder", "Close crossed below the Keltner Channel lower band")
//----------------------------------------------------------------------------------------------------------------------}
