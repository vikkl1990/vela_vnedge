//@version=6
indicator("RSI-2", shorttitle = "RSI-2", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MID_LEVEL         = 50      // RSI midline separating bullish from bearish two-bar pressure
BULL_COLOR        = #089981
BEAR_COLOR        = #f23645
NEUTRAL_COLOR     = #787b86 // the exit average - structure
LEVELS_COLOR      = #787b86
FILL_VALUE_TRANSP = 50      // gradient transparency at the oscillator value
FILL_MID_TRANSP   = 100     // gradient transparency at the midline
ZONE_TRANSP       = 92      // transparency of the soft stretch-band shading

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
rsiLengthInput = input.int(2, "RSI Length", minval = 1
  , group   = "Settings"
  , tooltip = "Lookback of the Wilder RSI. 2 is the Connors setting that turns the oscillator into a two-bar stretch meter, tagging its extremes far more often than the standard 14-period line does.")

srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Price series the RSI is computed from. The published rules apply it to the close.")

//---------------------------------------------------------------------------------------------------------------------}
// Setup
//---------------------------------------------------------------------------------------------------------------------{
obInput = input.float(90, "Overbought Level", minval = 50, maxval = 100, step = 1
  , group   = "Setup"
  , tooltip = "Upper band marking a stretched two-bar rally. At a 2-period length the standard 70 band is crossed too often to select anything, so the meaningful level moves out to 90 - raise it to 95 for stricter short setups.")

osInput = input.float(10, "Oversold Level", minval = 0, maxval = 50, step = 1
  , group   = "Setup"
  , tooltip = "Lower band marking a stretched two-bar pullback. At a 2-period length the standard 30 band is crossed too often to select anything, so the meaningful level moves out to 10 - lower it to 5 for stricter long setups.")

confirmInput = input.int(1, "Consecutive Readings", minval = 1, maxval = 5
  , group   = "Setup"
  , tooltip = "Closes beyond the band required before a setup qualifies. 1 matches the classic single-reading trigger; 2 reproduces the stricter variant demanding two consecutive extreme closes, selecting more persistent stretches at the cost of fewer signals.")

trendLengthInput = input.int(200, "Trend Filter Length", minval = 1
  , group   = "Setup"
  , tooltip = "Length of the simple moving average regime filter on the price chart. Long setups only fire with price above it and short setups only with price below it - the filter exists because sometimes the pullback does not end. 200 is the classic daily-chart setting.")

exitLengthInput = input.int(5, "Exit Average Length", minval = 1
  , group   = "Setup"
  , tooltip = "Length of the short simple moving average tracked for exits. A long setup resolves on the first close back above it and a short setup on the first close back below it; the published default is 5. The entry says nothing about when the bounce ends, so the exit is tracked separately.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of RSI-2 above the 50 midline, of the long setup markers, and of the trend filter while price holds above it.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of RSI-2 below the 50 midline, of the short setup markers, and of the trend filter while price holds below it.")

gradientFillInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between RSI-2 and the 50 midline, fully transparent at the midline and more opaque at the oscillator value.")

levelsColorInput = input.color(LEVELS_COLOR, "Levels Color"
  , group   = "Style"
  , tooltip = "Color of the dashed overbought/oversold bands and of the dotted midline.")

showTrendInput = input.bool(true, "Trend Filter on Chart"
  , group   = "Style"
  , tooltip = "Draws the regime moving average on the price chart, colored by which side price holds - the side that decides whether qualifying stretches are read as dip-buys or fades.")

showExitAvgInput = input.bool(true, "Exit Average on Chart", inline = "exit"
  , group   = "Style"
  , tooltip = "Draws the short exit average on the price chart so the resolving close can be tracked where it happens.")

exitColorInput = input.color(NEUTRAL_COLOR, "", inline = "exit"
  , group   = "Style"
  , tooltip = "Color of the exit average line.")

showSetupsInput = input.bool(true, "Setup Markers"
  , group   = "Style"
  , tooltip = "Marks qualifying setups on the price chart: a triangle below the bar when RSI-2 stretches under the oversold band with price above the trend filter, and above the bar for the mirrored fade below the filter. A new setup is only marked once the previous one has resolved through the exit average.")

showExitMarkersInput = input.bool(false, "Exit Markers"
  , group   = "Style"
  , tooltip = "Marks the resolving close with a small cross when price closes back through the exit average after a setup. Off by default to keep the chart clean - the exit alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Standard Wilder RSI run with a two-period lookback, plus the two price-chart averages the published
// rules pair it with: a slow regime filter and a short exit average
rsiValue = ta.rsi(srcInput, rsiLengthInput)
trendMa  = ta.sma(close, trendLengthInput)
exitMa   = ta.sma(close, exitLengthInput)

// Regime - which side of the slow average price holds decides the tradable direction.
// No setups fire until the filter has enough history
bullRegime = not na(trendMa) and close > trendMa
bearRegime = not na(trendMa) and close < trendMa

// Stretch - consecutive closes beyond a band. With the default of 1 this is the classic
// single-reading trigger; higher values demand a more persistent stretch
var int oversoldRun   = 0
var int overboughtRun = 0

oversoldRun   := not na(rsiValue) and rsiValue < osInput ? oversoldRun + 1 : 0
overboughtRun := not na(rsiValue) and rsiValue > obInput ? overboughtRun + 1 : 0

longStretch  = oversoldRun   >= confirmInput
shortStretch = overboughtRun >= confirmInput

// Raw band crossings, kept regardless of the regime filter - the stretch read is also used on its own,
// e.g. scaling out of longs into a spike above the upper band
overboughtCross = ta.crossover(rsiValue, obInput)
oversoldCross   = ta.crossunder(rsiValue, osInput)

// Setup state - a qualifying stretch inside the right regime opens a setup; it resolves on the first
// close back through the exit average. Exits are evaluated on the state carried into the bar, then new
// setups may open, so repeated extreme readings inside one episode are not re-marked
var bool longActive  = false
var bool shortActive = false

longExit  = longActive  and not na(exitMa) and close > exitMa
shortExit = shortActive and not na(exitMa) and close < exitMa

if longExit
    longActive := false
if shortExit
    shortActive := false

longSetup  = longStretch  and bullRegime and not longActive
shortSetup = shortStretch and bearRegime and not shortActive

if longSetup
    longActive := true
if shortSetup
    shortActive := true

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
rsiColor = rsiValue > MID_LEVEL ? bullColorInput : bearColorInput

fillTopColor    = rsiValue > MID_LEVEL ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_MID_TRANSP)
fillBottomColor = rsiValue > MID_LEVEL ? color.new(bullColorInput, FILL_MID_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

rsiPlotId = plot(rsiValue, "RSI-2", rsiColor, 2)
midPlotId = plot(MID_LEVEL, "Midline", editable = false, display = display.none)

fill(rsiPlotId, midPlotId
  , math.max(rsiValue, MID_LEVEL)
  , math.min(rsiValue, MID_LEVEL)
  , gradientFillInput ? fillTopColor : na
  , gradientFillInput ? fillBottomColor : na
  , title = "RSI-2 Gradient Fill")

hline(obInput, "Overbought", levelsColorInput, hline.style_dashed)
hline(osInput, "Oversold", levelsColorInput, hline.style_dashed)
hline(MID_LEVEL, "Midline", color.new(levelsColorInput, 50), hline.style_dotted)

// Soft shading of the stretch bands anchored on hidden plots - the oversold band is where long setups
// come from, the overbought band where short setups come from
obZoneId       = plot(obInput, "Overbought Zone Anchor", color(na), editable = false, display = display.none)
osZoneId       = plot(osInput, "Oversold Zone Anchor", color(na), editable = false, display = display.none)
topAnchorId    = plot(100, "Top Anchor", color(na), editable = false, display = display.none)
bottomAnchorId = plot(0, "Bottom Anchor", color(na), editable = false, display = display.none)

fill(obZoneId, topAnchorId, color.new(bearColorInput, ZONE_TRANSP), title = "Overbought Zone")
fill(osZoneId, bottomAnchorId, color.new(bullColorInput, ZONE_TRANSP), title = "Oversold Zone")

// Price-chart companions - the regime filter colored by the side price holds, and the exit average
trendColor = bullRegime ? bullColorInput : bearColorInput

plot(showTrendInput ? trendMa : na, "Trend Filter", trendColor, 1, force_overlay = true)
plot(showExitAvgInput ? exitMa : na, "Exit Average", exitColorInput, 1, force_overlay = true)

// Setup and exit marks on the price chart
plotshape(showSetupsInput and longSetup, "Long Setup", shape.triangleup, location.belowbar, bullColorInput, size = size.tiny, force_overlay = true)
plotshape(showSetupsInput and shortSetup, "Short Setup", shape.triangledown, location.abovebar, bearColorInput, size = size.tiny, force_overlay = true)
plotshape(showExitMarkersInput and longExit, "Long Exit", shape.xcross, location.abovebar, bullColorInput, size = size.tiny, force_overlay = true)
plotshape(showExitMarkersInput and shortExit, "Short Exit", shape.xcross, location.belowbar, bearColorInput, size = size.tiny, force_overlay = true)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(longSetup, "Long Setup", "RSI-2 long setup on {{ticker}}: RSI-2 stretched below its oversold level with price above the trend filter ({{interval}})")
alertcondition(shortSetup, "Short Setup", "RSI-2 short setup on {{ticker}}: RSI-2 stretched above its overbought level with price below the trend filter ({{interval}})")
alertcondition(longExit, "Long Exit", "RSI-2 long exit on {{ticker}}: price closed back above the exit average following a long setup ({{interval}})")
alertcondition(shortExit, "Short Exit", "RSI-2 short exit on {{ticker}}: price closed back below the exit average following a short setup ({{interval}})")
alertcondition(overboughtCross, "Overbought Stretch", "RSI-2 crossed above its overbought level on {{ticker}} - two-bar rally stretched, regardless of regime ({{interval}})")
alertcondition(oversoldCross, "Oversold Stretch", "RSI-2 crossed below its oversold level on {{ticker}} - two-bar pullback stretched, regardless of regime ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
