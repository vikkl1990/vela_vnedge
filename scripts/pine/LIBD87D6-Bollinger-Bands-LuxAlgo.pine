//@version=6
indicator("Bollinger Bands", "BB", overlay = true, format = format.price, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SETTINGS_GROUP = "Settings"
STYLE_GROUP = "Style"
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Number of bars used to calculate the basis SMA and the standard deviation.")
srcInput = input.source(close, "Source", group = SETTINGS_GROUP, tooltip = "Price series the bands are calculated on.")
multInput = input.float(2.0, "Multiplier", minval = 0, step = 0.1, group = SETTINGS_GROUP, tooltip = "Number of standard deviations added above and below the basis to form the bands.")

basisColorInput = input.color(#ff9800, "Basis", group = STYLE_GROUP, tooltip = "Color of the basis (middle band) moving average.")
bandColorInput = input.color(#5b9cf6, "Bands", group = STYLE_GROUP, tooltip = "Color of the upper and lower bands.")
fillColorInput = input.color(color.new(#5b9cf6, 92), "Fill", group = STYLE_GROUP, tooltip = "Fill color of the area between the upper and lower bands.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
basis = ta.sma(srcInput, lengthInput)
dev = multInput * ta.stdev(srcInput, lengthInput)

upperBand = basis + dev
lowerBand = basis - dev
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(basis, "Basis", basisColorInput)
upperPlotId = plot(upperBand, "Upper", bandColorInput)
lowerPlotId = plot(lowerBand, "Lower", bandColorInput)
fill(upperPlotId, lowerPlotId, fillColorInput, "Band Fill")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossAboveUpper = ta.crossover(close, upperBand)
crossBelowLower = ta.crossunder(close, lowerBand)

alertcondition(crossAboveUpper, "Cross Above Upper Band", "Close crossed above the upper Bollinger Band")
alertcondition(crossBelowLower, "Cross Below Lower Band", "Close crossed below the lower Bollinger Band")
//----------------------------------------------------------------------------------------------------------------------}