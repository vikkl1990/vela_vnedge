// ICTlibrary v2 by Trading-IQ (MPL-2.0), inlined: PineTS cannot import TradingView libraries
type labelLine 

    line  lin 
    label lab 

// @type UDT for order block calculations
// @field orderBlockData array containing order block x and y points   
// @field orderBlockBox   optional order block box
// @field vioCount = 0    violation count of the order block. 0 = Order Block, 1 = Breaker Block
// @field bool        traded = false  False = OB hasn't been traded. True = OB has been traded. This is to limit the number of trades at the order block.
// @field status = "OB"   status == "OB" => Level is order block. status == "BB" => Level is breaker block.
// @field orderBlockLab   options label for the order block / breaker block.

type orderBlock

    array<float> orderBlockData
    box    orderBlockBox
    int    vioCount = 0
    bool   traded = false
    string status = "OB"
    label  orderBlockLab

// @type UDT for strong highs and strong lows
// @field price             price of the strong high or strong low 
// @field timeAtprice       time of the strong high or strong low
// @field strongPointLabel  optional label for strong point         
// @field strongPointLine   optional line for strong point              
// @field overlayLine       optional lines for strong point to enhance visibility     
// @field overlayLine2      optional lines for strong point to enhance visibility

type rejectionBlocks 

    chart.point rejectionPoint 
    float       bodyPrice 
    box         rejectionBox 
    label       rejectionLabel 
    
// @type UDT for data storage and drawings associated with equal highs / equal lows
// @field connector     single line placed at the first high or low, y = avgerage of distinguished equal highs/lows
// @field connectorLab  optional label to be placed at the highs or lows      
// @field levels        array containing the equal highs or lows prices        
// @field times         array containing the equal highs or lows individual times    
// @field startTime     the time of the first high or low that forms a sequence of equal highs or lows                              
// @field radiate       options label to "radiate" the label in connector lab. Can be used for anything

type necessaryData

    array<float> highArr
    array<float> lowArr
    array<int>   timeArr
    array<float> logArr 
    array<float> signArr 
    array<float> closeArr 
    array<int>   binaryTimeArr 
    array<float> binaryCloseArr 
    array<float> binaryOpenArr
    array<float> atrTFarr 
    array<float> openArr

// @enum enum for user selection of Unicorn Model Trade Exits
// @field sL    swing low exit, whether for profit (short) or loss (long)         	
// @field sH    swing high exit, whether for profit (long) or loss (short)                   
// @field bFVG  long entry stop loss of math.min(FVGbottom/BBbottom)                     
// @field tFVG  short entry stop loss of math.max(FVGtop/BBtop)                       
// @field zero5 fib TP of -0.5            
// @field one5  fib TP of -1                
// @field two5  fib TP of -2

necessaryData(float atrTF) =>

    var historicalData = necessaryData.new(array.new<float>(), array.new<float>(), array.new<int>  (), 
                                           array.new<float>(), array.new<float>(), array.new<float>(), 
                                           array.new<int>  (), array.new<float>(), array.new<float>(), 
                                           array.new<float>(), array.new<float>()
                                             )

    historicalData.highArr      .unshift(high) ,                   historicalData.lowArr        .unshift(low), 
    historicalData.timeArr      .unshift(time) ,                   historicalData.binaryTimeArr .push   (time),                
    historicalData.closeArr     .unshift(close),                   historicalData.logArr        .push   (math.log(close / close[1]))
    historicalData.signArr      .unshift(math.sign(close - open)), historicalData.binaryCloseArr.push   (close), 
    historicalData.binaryOpenArr.push   (open), historicalData.atrTFarr.unshift(atrTF), historicalData.openArr.unshift(open)

    logZ           = (historicalData.logArr  .last() - historicalData.logArr  .avg()) / historicalData.logArr  .stdev()

    if historicalData.logArr.size() > 200 
        historicalData.logArr  .shift()


    [historicalData, logZ]


    
// @function creates neon like effect for box drawings 
// @param gradientBoxes an array.new<box>() to store the gradient boxes 
// @param idcolor color for the neon effect 
// @param timeStart left point of box
// @param bottom bottom of box price point 
// @param top top of box price point
// @param rightCoordinate right point of box
// @returns void

isLastBar(simple int userTF) =>

    userTF <= timeframe.in_seconds(timeframe.period) ? true : time_close >= time_close(timeframe.from_seconds(userTF))


// @function returns necessaryData UDT for historical data access 
// @param atrTF user-selected timeframe ATR value. 
// @returns necessaryData UDT. Example declarationhistoricalData = necessaryData(ta.atr(14))//
// To access the "highArr" would then call "historicalData.highArr"
// @returns logZ. log return Z score, used for calculating order blocks.

method drawBos(array<labelLine> id, chart.point startPoint, int getKeyPointTime, float getKeyPointPrice, color col, bool showBOS, bool isUp, bool forceOverlay) => 

    avg = math.round(math.avg(getKeyPointTime, time))

    if showBOS

        position = switch isUp 

            true => label.style_label_up 
            =>      label.style_label_down


        switch forceOverlay

            true => id.push(
                 labelLine.new(
                     line.new(startPoint, chart.point.from_time(time, getKeyPointPrice),
                                         color = col, 
                                         xloc  = xloc.bar_time,
                                         style = line.style_dotted, 
                                         force_overlay = true 
                                         ),

                     label.new(avg, getKeyPointPrice, xloc = xloc.bar_time, 
                                         color     = #00000000, 
                                         textcolor = col,
                                         text      = "BoS", 
                                         size      = size.tiny, 
                                         style     = position, 
                                         force_overlay = true
                                         )))

            =>  id.push(
                 labelLine.new(
                     line.new(startPoint, chart.point.from_time(time, getKeyPointPrice),
                                         color = col, 
                                         xloc  = xloc.bar_time,
                                         style = line.style_dotted, 
                                         force_overlay = false
                                         ),

                     label.new(avg, getKeyPointPrice, xloc = xloc.bar_time, 
                                         color     = #00000000, 
                                         textcolor = col,
                                         text      = "BoS", 
                                         size      = size.tiny, 
                                         style     = position, 
                                         force_overlay = false
                                         )))
// @function calculates and draws Market Structure Shift. This data is also used to calculate Rejection Blocks.
// @param array<labelLine> id      uses labelLine UDT explained above to pair line of MSS with label of MSS  
// @param chart.point startPoint   the chart point of the start time of the broken level         
// @param getKeyPointTime      the actual time of startPoint, simplystartPoint.time               
// @param getKeyPointPrice   the actual time of startPoint, simplystartPoint.price                
// @param col                color of the MSS line / label  
// @param showMSS             whether to show label/line. This function still calculates internally for other ICT related concepts even if not drawn.                   
// @param isUp                whether MSS happened during price increase or price decrease.    
// @param array<rejectionBlocks> upRejections  array containing upside rejection block data, array must be declared as array<rejectionBlocks>()
// @param array<rejectionBlocks> dnRejections  array containing downside rejection block data, array must be declared as array<rejectionBlocks>()
// @param highArr  array containing historical highs, should be taken from the UDT "necessaryData" defined above
// @param lowArr   array containing historical lows, should be taken from the UDT "necessaryData" defined above
// @param timeArr  array containing historical times, should be taken from the UDT "necessaryData" defined above
// @param closeArr  array containing historical closes, should be taken from the UDT "necessaryData" defined above
// @param openArr  array containing historical opens, should be taken from the UDT "necessaryData" defined above
// @param atrTFarr   array containing historical atr values (of user-selected TF), should be taken from the UDT "necessaryData" defined above
// @param upRejectionsPrices   array containing up rejections prices. Is sorted and used to determine selective looping for invalidations.
// @param dnRejectionsPrices   array containing down rejections prices. Is sorted and used to determine selective looping for invalidations.
// @returnsvoid

method drawMSS(array<labelLine> id, chart.point startPoint, int getKeyPointTime, float getKeyPointPrice, color col,  bool showMSS, bool isUp,
                 array<rejectionBlocks> upRejections, array<rejectionBlocks> dnRejections, array<float> highArr, array<float> lowArr, 
                     array<int> timeArr, array<float> closeArr, array<float> openArr, array<float> atrTFarr,
                         array<float> upRejectionsPrices, array<float> dnRejectionsPrices, bool forceOverlay) => 




    avg = math.round(math.avg(getKeyPointTime, time))

    if isUp 

        max = 0., maxTime = 0, isRejection = false, var bodyPrice = 0.

        for [i, data] in highArr 

            if data >= getKeyPointPrice

                max := math.max(max, data)

                if data == max 

                    maxTime := timeArr.get(i)

                    bodyPrice := math.max(closeArr.get(i), openArr.get(i))

                    isRejection := (math.abs(data - bodyPrice) >= atrTFarr.get(i) / 3)

            else 

                break 

        if max != 0 and isRejection 

            upRejections      .unshift(rejectionBlocks.new(chart.point.from_time(maxTime, max), bodyPrice))
            upRejectionsPrices.insert(upRejectionsPrices.binary_search_rightmost(max), max)


    else 

        min = 20e20, minTime = 0, isRejection = false, var bodyPrice = 0.

        for [i, data] in lowArr 

            if data <= getKeyPointPrice

                min := math.min(min, data)

                if data == min

                    minTime := timeArr.get(i)

                    bodyPrice := math.min(closeArr.get(i), openArr.get(i))

                    isRejection := (math.abs(data - bodyPrice) >= atrTFarr.get(i) / 3)

            else 

                break 

        if min != 20e20 and isRejection 

            dnRejections      .unshift(rejectionBlocks.new(chart.point.from_time(minTime, min), bodyPrice))
            dnRejectionsPrices.insert(dnRejectionsPrices.binary_search_rightmost(min), min)

    if showMSS

        position = switch isUp 

            true => label.style_label_up 
            =>      label.style_label_down

        switch forceOverlay

            true => id.push(
              labelLine.new(
                 line.new(startPoint, chart.point.from_time(time, getKeyPointPrice),
                                     color = col, 
                                     xloc  = xloc.bar_time, 
                                     force_overlay = true
                                     ),

                 label.new(avg, getKeyPointPrice, xloc = xloc.bar_time, 
                                     color     = #00000000, 
                                     textcolor = col,
                                     text      = "MSS", 
                                     size      = size.tiny, 
                                     style     = position, 
                                     force_overlay = true
                                     )))

            => id.push(
              labelLine.new(
                 line.new(startPoint, chart.point.from_time(time, getKeyPointPrice),
                                     color = col, 
                                     xloc  = xloc.bar_time, 
                                     force_overlay = false
                                     ),

                 label.new(avg, getKeyPointPrice, xloc = xloc.bar_time, 
                                     color     = #00000000, 
                                     textcolor = col,
                                     text      = "MSS", 
                                     size      = size.tiny, 
                                     style     = position, 
                                     force_overlay = false
                                     )))

// @function gets time of inputted price (compare) in an array of data 
// this is useful when the user-selected timeframe for ICT concepts is greater than the chart's timeframe 
// @param id the array of data to search through, to find which index has the same value as "compare"
// @param compare the target data point to find in the array
// @param timeArr array of historical times
// @returns the time that the data point in the array was recorded

method OB(array<orderBlock> id, array<float> highArr, array<float> signArr, array<float> lowArr, array<int> timeArr, int sign) =>

    for i = 1 to highArr.size() - 1
        if signArr.get(i) == sign

            getHigh = highArr.get(i)
            getLow  = lowArr .get(i)

            id.unshift(orderBlock.new(array.from(timeArr.get(i), getHigh, last_bar_time, getLow)))

            break



