//@version=6
indicator("Volume Oscillator", "Vol Osc", overlay = false, format = format.percent, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // fast volume EMA above the slow one - volume expanding
BEAR_COLOR    = #f23645 // fast volume EMA below the slow one - volume contracting
NEUTRAL_COLOR = #787b86 // zero line

FILL_VALUE_TRANSP = 60  // gradient transparency at the oscillator value
FILL_ZERO_TRANSP  = 100 // gradient transparency at the zero line

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
fastLengthInput = input.int(5, "Fast Length", minval = 1, group = "Settings", tooltip = "Length of the fast EMA of volume.")
slowLengthInput = input.int(10, "Slow Length", minval = 1, group = "Settings", tooltip = "Length of the slow EMA of volume.")

bullColorInput = input.color(BULL_COLOR, "Above Zero", inline = "osc", group = "Style", tooltip = "Color of the volume oscillator line and fill while it holds above zero - volume expanding.")
bearColorInput = input.color(BEAR_COLOR, "Below Zero", inline = "osc", group = "Style", tooltip = "Color of the volume oscillator line and fill while it holds below zero - volume contracting.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
fastMa = ta.ema(volume, fastLengthInput)
slowMa = ta.ema(volume, slowLengthInput)

osc = slowMa == 0 ? 0.0 : 100 * (fastMa - slowMa) / slowMa
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
oscColor = osc >= 0 ? bullColorInput : bearColorInput

oscPlotId  = plot(osc, "Volume Oscillator", oscColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

fill(oscPlotId, zeroPlotId, top_value = math.max(osc, 0), bottom_value = math.min(osc, 0), top_color = osc >= 0 ? color.new(oscColor, FILL_VALUE_TRANSP) : color.new(oscColor, FILL_ZERO_TRANSP), bottom_color = osc >= 0 ? color.new(oscColor, FILL_ZERO_TRANSP) : color.new(oscColor, FILL_VALUE_TRANSP), title = "Oscillator Gradient")

hline(0, "Zero Line", NEUTRAL_COLOR, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossUp = ta.crossover(osc, 0)
crossDown = ta.crossunder(osc, 0)

alertcondition(crossUp, "Zero Cross Up", "Volume Oscillator crossed above zero")
alertcondition(crossDown, "Zero Cross Down", "Volume Oscillator crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
