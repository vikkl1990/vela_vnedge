//@version=6
// =============================================================================
//  SMC Confluence Suite — MTF Structure • Order Blocks • FVG • OTE • Score
// -----------------------------------------------------------------------------
//  R1  Repaint guard, object pruning, memory-leak fix, timeframe validation
//  R2  Unified inputs, Zone UDT, deduplicated drawing helpers, shared utilities
//  R3  Swing merging, ghost-BOS fix, seen-state tracking, OB anchored to BOS
//  R4  Retro BOS, birth-time guard, FVG size filter, mitigation modes, OTE confluence
//  R5  Alert engine with per-event toggles, cooldown and rich dynamic messages
//  R6  Premium/Discount range, liquidity sweeps, EQH/EQL equal-level detection
//  R7  Confluence Score 0-100 with letter grade and factor breakdown table
//  R8  Panel layout cleanup: debug panel removed, compact signal dashboard
//  R9  Alert reliability fix, alertcondition() support, full English localisation
// =============================================================================

indicator("SMC Confluence Suite", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ========================================================================== //
// 0. STATUS-LINE VISIBILITY
// ========================================================================== //
// DSP_OFF  : hidden from the chart status line, still visible in the Data Window
// DSP_ON   : the only input allowed to appear next to the indicator name
DSP_OFF = display.data_window
DSP_ON  = display.status_line + display.data_window

