int target_seconds_gold = input.int(30, "GOLD daily Target seconds to lock", minval=3, maxval=300, step=5, group="Timer Settings Gold")
string selected_level_gold = input.string("All Levels", "GOLD daily", options = ["All Levels", "5.0", "4.5", "4.0", "3.5", "3.0", "2.5", "2.0", "1.5", "1.0", "0.5", "0.0", "-0.5", "-1.0", "-1.5", "-2.0", "-2.5", "-3.0", "-3.5", "-4.0", "-4.5", "-5.0"], group="Alert Settings Gold")
int target_seconds2_gold = input.int(30, "COMEX-MCX Target seconds to lock (Gold)", minval=3, maxval=300, step=5, group="Timer Settings Gold")
string selected_level2_gold = input.string("All Levels", "COMEX-MCX (Gold)", options = ["All Levels","-1.5", "-2.0", "-2.5", "-3.0", "-3.5", "-4.0", "-4.5", "-5.0","-5.5", "-6.0", "-6.5", "-7.0", "-7.5", "-8.0", "-8.5", "-9.0","-9.5", "-10.0", "-10.5", "-11.0", "-11.5", "-12.0", "-12.5","-13.0", "-13.5", "-14.0", "-14.5", "-15.0"], group="Alert Settings_2 Gold")
float g_mcx_gold   = request.security(gold_mcx,   timeframe.period, close, lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
float g_comex_gold = request.security(gold_comex, timeframe.period, close, lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
float usdinr_close_gold = request.security(usdinr, timeframe.period, close, lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
bool newDay_gold = ta.change(time("D")) != 0
var float gr_gold  = na
var float gcr_gold = na
var float usdr_gold = na
if newDay_gold
    gr_gold  := nz(g_mcx_gold[1])
    gcr_gold := nz(g_comex_gold[1])
    usdr_gold := nz(usdinr_close_gold[1])
float gold_mcx_pct_gold   = not na(gr_gold)  ? (g_mcx_gold   - gr_gold)  / gr_gold  * 100 : na
float gold_comex_pct_gold = not na(gcr_gold) ? (g_comex_gold - gcr_gold) / gcr_gold * 100 : na
float gold_div_gold       = gold_comex_pct_gold - gold_mcx_pct_gold
float usdinr_pct_gold = not na(usdr_gold) ? (usdinr_close_gold - usdr_gold) / usdr_gold * 100 : na
string comex_sym_gold = "COMEX:GC1!"
string mcx_sym_gold   = "MCX:GOLD1!"
string usd_inr_sym_gold = "VANTAGE:USDINR"
float duty_percent_gold = input.float(15.0, "Import Duty % (Gold)", minval=0.0, maxval=100.0, step=0.5, group="Deviation Settings (Gold)")
int lot_size_comex_gold = 100
float mcx_grams_gold    = 311
float A_gold = (g_comex_gold * usdinr_close_gold * lot_size_comex_gold)/mcx_grams_gold * (1.0 + duty_percent_gold / 100.0)
float B_gold = (g_mcx_gold   * mcx_grams_gold)/mcx_grams_gold
float diff_AB_gold = A_gold - B_gold
float diff_percent_gold = diff_AB_gold / B_gold * 100
float change_A_pct_gold = ta.change(A_gold) / A_gold[1] * 100

// ---- ₹ row Diff (C-M) alerts - touch/shoot-and-forget, Gold ----
goldDiffEntryUp = input.float(0.0, "Gold ₹ Diff - Entry Upside Level", step=1.0, group="₹ Diff Alerts (Gold)")
goldDiffExit = input.float(0.0, "Gold ₹ Diff - Exit Level", step=1.0, group="₹ Diff Alerts (Gold)")
goldDiffEntryDown = input.float(0.0, "Gold ₹ Diff - Entry Downside Level", step=1.0, group="₹ Diff Alerts (Gold)")
goldDiffEntryUpHit = ta.crossover(diff_AB_gold, goldDiffEntryUp)
goldDiffExitHit = ta.cross(diff_AB_gold, goldDiffExit)
goldDiffEntryDownHit = ta.crossunder(diff_AB_gold, goldDiffEntryDown)
alertcondition(goldDiffEntryUpHit, title="Gold ₹ Diff Entry Upside", message="Gold ₹ Diff (C-M) touched your Entry Upside level")
alertcondition(goldDiffExitHit, title="Gold ₹ Diff Exit", message="Gold ₹ Diff (C-M) touched your Exit level")
alertcondition(goldDiffEntryDownHit, title="Gold ₹ Diff Entry Downside", message="Gold ₹ Diff (C-M) touched your Entry Downside level")
float change_B_pct_gold = ta.change(B_gold) / B_gold[1] * 100
var float[] range_low_gold = array.from(4.900, 4.400, 3.900, 3.400, 2.900, 2.400, 1.900, 1.400, 0.900, 0.400, -0.100, -0.600, -1.100, -1.600, -2.100, -2.600, -3.100, -3.600, -4.100, -4.600, -5.100)
