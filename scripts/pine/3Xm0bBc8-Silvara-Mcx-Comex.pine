varip int[] first_entry_ms_gold = array.new_int(21, 0)
varip int[] max_seen_ms_gold    = array.new_int(21, 0)
var int[]   update_counter_gold = array.new_int(21, 0)
int TARGET_MS_gold  = target_seconds_gold  * 1000
int BUFFER_MS_gold  = 1000
varip int[] first_entry_ms_2_gold = array.new_int(28, 0)
varip int[] max_seen_ms_2_gold    = array.new_int(28, 0)
var int[]   update_counter_2_gold = array.new_int(28, 0)
int TARGET_MS_2_gold = target_seconds2_gold * 1000
int BUFFER_MS_2_gold = 1000
if barstate.isrealtime and not na(gold_div_gold)
    for i = 0 to 20
        bool inside = gold_div_gold >= array.get(range_low_gold, i) and gold_div_gold <= array.get(range_high_gold, i)
        if inside
            if array.get(first_entry_ms_gold, i) == 0
                array.set(first_entry_ms_gold, i, timenow)
            int elapsed_now = timenow - array.get(first_entry_ms_gold, i)
            array.set(max_seen_ms_gold, i, math.max(array.get(max_seen_ms_gold, i), elapsed_now))
            array.set(update_counter_gold, i, array.get(update_counter_gold, i) + 1)
            if elapsed_now >= TARGET_MS_gold + BUFFER_MS_gold
                array.set(first_entry_ms_gold, i, timenow)
                array.set(max_seen_ms_gold, i, 0)
                array.set(update_counter_gold, i, 0)
        else
            array.set(first_entry_ms_gold, i, 0)
            array.set(max_seen_ms_gold, i, 0)
            array.set(update_counter_gold, i, 0)
if barstate.isrealtime and not na(diff_percent_gold)
    for i = 0 to 27
        bool inside_2 = diff_percent_gold >= array.get(range_low_2_gold, i) and diff_percent_gold <= array.get(range_high_2_gold, i)
        if inside_2
            if array.get(first_entry_ms_2_gold, i) == 0
                array.set(first_entry_ms_2_gold, i, timenow)
            int elapsed_now_2 = timenow - array.get(first_entry_ms_2_gold, i)
            array.set(max_seen_ms_2_gold, i, math.max(array.get(max_seen_ms_2_gold, i), elapsed_now_2))
            array.set(update_counter_2_gold, i, array.get(update_counter_2_gold, i) + 1)
            if elapsed_now_2 >= TARGET_MS_2_gold + BUFFER_MS_2_gold
                array.set(first_entry_ms_2_gold, i, timenow)
                array.set(max_seen_ms_2_gold, i, 0)
                array.set(update_counter_2_gold, i, 0)
        else
            array.set(first_entry_ms_2_gold, i, 0)
            array.set(max_seen_ms_2_gold, i, 0)
            array.set(update_counter_2_gold, i, 0)
var bool[] alerted_this_stay_gold  = array.new_bool(21, false)
var bool[] alerted_this_stay2_gold = array.new_bool(28, false)
bool gold_just_locked     = false
bool comex_mcx_just_locked_gold = false
if barstate.isrealtime and not na(gold_div_gold)
    for i = 0 to 20
        bool inside = gold_div_gold >= array.get(range_low_gold, i) and gold_div_gold <= array.get(range_high_gold, i)
        if inside
            int entry = array.get(first_entry_ms_gold, i)
            if entry > 0
                int elapsed = timenow - entry
                bool just_locked = elapsed >= TARGET_MS_gold and nz(array.get(max_seen_ms_gold, i)[1], 0) < TARGET_MS_gold
                bool allowed = false
                if selected_level_gold == "All Levels"
                    allowed := true
                else if selected_level_gold == "5.0" and (i == 1)
                    allowed := true
                else if selected_level_gold == "4.5" and (i == 0 or i == 2)
                    allowed := true
                else if selected_level_gold == "4.0" and (i == 1 or i == 3)
                    allowed := true
                else if selected_level_gold == "3.5" and (i == 2 or i == 4)
                    allowed := true
