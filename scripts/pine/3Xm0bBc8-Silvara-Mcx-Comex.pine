        table.cell(combinedTbl, 27, 36, str.tostring(diff_AB_gold, "#,##0"), text_color=text_white, text_size=tblTextSize)
        table.cell(combinedTbl, 25, 37, str.tostring(g_comex_gold, "#.#####"), text_color=text_white, text_size=tblTextSize)
        table.cell(combinedTbl, 26, 37, str.tostring(g_mcx_gold, "#.##"), text_color=text_white, text_size=tblTextSize)
        table.cell(combinedTbl, 27, 37, str.tostring(diff_percent_gold, "#.##") + "%", text_color = diff_percent_gold >= 0 ? color.new(#16A34A,0) : color.new(#DC2626,0), text_size=tblTextSize)

//====================================================
// RATIO DASHBOARD (G/S, G/P, P/S) - rows 12-16 of the combined table
//====================================================
gsBuyLevel = input.float(0.0, "G/S - Buy Level", step=0.01, group="Ratio Alerts")
gsSellLevel = input.float(0.0, "G/S - Sell Level", step=0.01, group="Ratio Alerts")
gsFreeLevel = input.float(0.0, "G/S - Free Level", step=0.01, group="Ratio Alerts")

gpBuyLevel = input.float(0.0, "G/P - Buy Level", step=0.01, group="Ratio Alerts")
gpSellLevel = input.float(0.0, "G/P - Sell Level", step=0.01, group="Ratio Alerts")
gpFreeLevel = input.float(0.0, "G/P - Free Level", step=0.01, group="Ratio Alerts")

psBuyLevel = input.float(0.0, "P/S - Buy Level", step=0.01, group="Ratio Alerts")
psSellLevel = input.float(0.0, "P/S - Sell Level", step=0.01, group="Ratio Alerts")
psFreeLevel = input.float(0.0, "P/S - Free Level", step=0.01, group="Ratio Alerts")

ratioSym1 = "TVC:GOLD/TVC:SILVER"
ratioSym2 = "TVC:GOLD/TVC:PLATINUM"
ratioSym3 = "TVC:PLATINUM/TVC:SILVER"

ratioName1 = "G/S"
ratioName2 = "G/P"
ratioName3 = "P/S"

[ro1, rh1, rl1, rc1] = request.security(ratioSym1, "D", [open, high, low, close], lookahead=barmerge.lookahead_on)
[ro2, rh2, rl2, rc2] = request.security(ratioSym2, "D", [open, high, low, close], lookahead=barmerge.lookahead_on)
[ro3, rh3, rl3, rc3] = request.security(ratioSym3, "D", [open, high, low, close], lookahead=barmerge.lookahead_on)

gsBuyHit = ta.crossunder(rc1, gsBuyLevel)
gsSellHit = ta.crossover(rc1, gsSellLevel)
gsFreeHit = ta.cross(rc1, gsFreeLevel)
alertcondition(gsBuyHit, title="G/S Buy Level", message="G/S ratio touched your Buy level")
alertcondition(gsSellHit, title="G/S Sell Level", message="G/S ratio touched your Sell level")
alertcondition(gsFreeHit, title="G/S Free Level", message="G/S ratio touched your Free level")

gpBuyHit = ta.crossunder(rc2, gpBuyLevel)
gpSellHit = ta.crossover(rc2, gpSellLevel)
gpFreeHit = ta.cross(rc2, gpFreeLevel)
alertcondition(gpBuyHit, title="G/P Buy Level", message="G/P ratio touched your Buy level")
alertcondition(gpSellHit, title="G/P Sell Level", message="G/P ratio touched your Sell level")
alertcondition(gpFreeHit, title="G/P Free Level", message="G/P ratio touched your Free level")

psBuyHit = ta.crossunder(rc3, psBuyLevel)
psSellHit = ta.crossover(rc3, psSellLevel)
psFreeHit = ta.cross(rc3, psFreeLevel)
alertcondition(psBuyHit, title="P/S Buy Level", message="P/S ratio touched your Buy level")
alertcondition(psSellHit, title="P/S Sell Level", message="P/S ratio touched your Sell level")
alertcondition(psFreeHit, title="P/S Free Level", message="P/S ratio touched your Free level")

ratioBgHeader = color.rgb(246, 233, 232)
ratioBullRow = color.rgb(230, 247, 237)
ratioBearRow = color.rgb(247, 227, 229)
ratioTxtPrimary = color.rgb(32, 17, 19)
ratioHeaderAccent = color.rgb(32, 17, 19)

if barstate.isrealtime
    table.cell(combinedTbl, 24, 38, "RATIO DASHBOARD", text_color=#7A1B2B, bgcolor=#F7E3E5, text_halign=text.align_center, text_size=tblTextSize)
    table.merge_cells(combinedTbl, 24, 38, 28, 38)

if barstate.isfirst
    table.cell(combinedTbl, 24, 39, " R ", bgcolor=ratioBgHeader, text_color=ratioHeaderAccent, text_size=tblTextSize)
    table.cell(combinedTbl, 25, 39, " O ", bgcolor=ratioBgHeader, text_color=ratioHeaderAccent, text_size=tblTextSize)
    table.cell(combinedTbl, 26, 39, " H ", bgcolor=ratioBgHeader, text_color=ratioHeaderAccent, text_size=tblTextSize)
    table.cell(combinedTbl, 27, 39, " L ", bgcolor=ratioBgHeader, text_color=ratioHeaderAccent, text_size=tblTextSize)
    table.cell(combinedTbl, 28, 39, " C ", bgcolor=ratioBgHeader, text_color=ratioHeaderAccent, text_size=tblTextSize)

ratioNamesArr = array.from(ratioName1, ratioName2, ratioName3)
ratioOpensArr = array.from(ro1, ro2, ro3)
ratioHighsArr = array.from(rh1, rh2, rh3)
ratioLowsArr = array.from(rl1, rl2, rl3)
ratioClosesArr = array.from(rc1, rc2, rc3)

if barstate.islast
    for i = 0 to 2
        ro = array.get(ratioOpensArr, i)
        rh = array.get(ratioHighsArr, i)
        rl = array.get(ratioLowsArr, i)
        rc = array.get(ratioClosesArr, i)

        bool ratioBull = rc >= ro

        ratioRowBg = ratioBull ? ratioBullRow : ratioBearRow

        table.cell(combinedTbl, 24, i + 40, array.get(ratioNamesArr, i), bgcolor=ratioRowBg, text_color=ratioTxtPrimary, text_size=tblTextSize)

        table.cell(combinedTbl, 25, i + 40, str.tostring(ro, "#.###"), bgcolor=ratioRowBg, text_color=ratioTxtPrimary, text_size=tblTextSize)

        table.cell(combinedTbl, 26, i + 40, str.tostring(rh, "#.###"), bgcolor=ratioRowBg, text_color=ratioTxtPrimary, text_size=tblTextSize)

        table.cell(combinedTbl, 27, i + 40, str.tostring(rl, "#.###"), bgcolor=ratioRowBg, text_color=ratioTxtPrimary, text_size=tblTextSize)

        table.cell(combinedTbl, 28, i + 40, str.tostring(rc, "#.###"), bgcolor=ratioRowBg, text_color=ratioTxtPrimary, text_size=tblTextSize)
