    table.cell(combinedTbl, 28, 31, "", text_color=text_white, text_size=tblTextSize)
    table.cell(combinedTbl, 28, 32, "", text_color=text_white, text_size=tblTextSize)
    if not na(silver_comex_pct)
        table.cell(combinedTbl, 25, 30, str.tostring(silver_comex_pct, "#.####"), text_color = silver_comex_pct >= 0 ? color.new(#16A34A,0) : color.new(#DC2626,0), text_size=tblTextSize)
        table.cell(combinedTbl, 26, 30, str.tostring(silver_mcx_pct, "#.####"), text_color = silver_mcx_pct >= 0 ? color.new(#16A34A,0) : color.new(#DC2626,0), text_size=tblTextSize)
        table.cell(combinedTbl, 27, 30, str.tostring(silver_div, "#.####"), text_color = silver_div >= 0 ? color.new(#16A34A,0) : color.new(#DC2626,0), text_size=tblTextSize)
    if not na(usdinr_close)
        table.cell(combinedTbl, 25, 31, str.tostring(A, "#,##0"), text_color=text_white, text_size=tblTextSize)
        table.cell(combinedTbl, 26, 31, str.tostring(B, "#,##0"), text_color=text_white, text_size=tblTextSize)
