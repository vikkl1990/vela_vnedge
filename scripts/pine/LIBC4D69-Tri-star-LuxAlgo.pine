//@version=6
indicator("Tri-star", "Tri-star", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
STATE_NONE      = 0
STATE_PENDING   = 1
STATE_CONFIRMED = 2

GAP_BODY = 'Real Bodies'
GAP_FULL = 'Full Candles (incl. Wicks)'

PATTERN_TXT = 'Tri-Star'
LOOSE_TXT   = 'Tri-Star (loose)'

BEAR_TIP = 'Bearish tri-star: three consecutive doji with the middle doji gapping above its neighbors after an advance. Directional conviction has drained out of the uptrend - wait for a decisive close below the third doji. The middle doji high is the natural stop.'
BULL_TIP = 'Bullish tri-star: three consecutive doji with the middle doji gapping below its neighbors after a decline. Directional conviction has drained out of the downtrend - wait for a decisive close above the third doji. The middle doji low is the natural stop.'

LOOSE_BEAR_TIP = 'Loose tri-star: three consecutive doji stalling at the highs without a clean gap on the middle doji. A milder exhaustion note - combine with support, resistance or momentum divergence rather than trading it alone.'
LOOSE_BULL_TIP = 'Loose tri-star: three consecutive doji stalling at the lows without a clean gap on the middle doji. A milder exhaustion note - combine with support, resistance or momentum divergence rather than trading it alone.'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
bodyPctInput     = input.float(5., 'Maximum Doji Body %', minval = 0, maxval = 25, step = 0.5, group = 'Pattern', tooltip = 'Maximum real body height as a percentage of the bar range for a candle to qualify as a doji. Open and close must finish essentially equal - anything larger is a spinning top, not a doji, and weakens the pattern.')
bodyAvgMultInput = input.float(0.25, 'Maximum Body vs Average', minval = 0, step = 0.05, inline = 'avg', group = 'Pattern', tooltip = 'Multiple of the average real body each doji must stay below.')
bodyAvgLenInput  = input.int(14, 'x SMA', minval = 1, inline = 'avg', group = 'Pattern', tooltip = 'Each doji body must also stay below this multiple of the average real body over the selected length, keeping the three bodies far smaller than recent bars rather than only small relative to their own range.')
gapBasisInput    = input.string(GAP_BODY, 'Gap Basis', options = [GAP_BODY, GAP_FULL], group = 'Pattern', tooltip = 'How the middle doji gap is measured. Real Bodies follows the classical star definition: the middle doji body gaps beyond the bodies of the first and third doji, even if only by a small margin. Full Candles is stricter and requires a shadow-inclusive gap that strands the middle doji like a one-bar island.')
looseInput       = input.bool(false, 'Detect Loose Tri-Stars', group = 'Pattern', tooltip = 'Additionally flag three consecutive doji whose middle doji sits at the extreme without a clean gap - the milder exhaustion note some traders combine with support, resistance or momentum divergence. Shown with lighter labels and no stop tracking.')

trendLenInput    = input.int(50, 'Trend SMA Length', minval = 2, group = 'Context', tooltip = 'Simple moving average length used to establish the preceding trend. The last candle before the three doji must close above it for a bearish tri-star (prior advance) or below it for a bullish tri-star (prior decline). Three doji inside a sideways range are ignored.')

confirmBarsInput = input.int(3, 'Confirmation Window (Bars)', minval = 1, maxval = 50, group = 'Confirmation', tooltip = 'Number of bars allowed for a decisive close beyond the third doji to confirm the reversal. A close accepted beyond the middle doji extreme instead reinstates the prior trend and invalidates the pattern - before or after confirmation.')

showBoxInput  = input.bool(true, 'Highlight Pattern Candles', group = 'Style', tooltip = 'Shade a box around the three doji when a strict tri-star completes.')
showStopInput = input.bool(true, 'Stop / Invalidation Level', group = 'Style', tooltip = 'Draw a dashed line at the middle doji extreme - the natural stop for the pattern - extended until the pattern expires, is invalidated, or the stop is hit after confirmation.')
bullColorInput = input.color(#089981, 'Bullish', inline = 'colors', group = 'Style')
bearColorInput = input.color(#f23645, 'Bearish', inline = 'colors', group = 'Style')

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{
barRange = high - low
body     = math.abs(close - open)
bodyHi   = math.max(close, open)
bodyLo   = math.min(close, open)
bodyMid  = (bodyHi + bodyLo) / 2

bodySma  = ta.sma(body, bodyAvgLenInput)
trendSma = ta.sma(close, trendLenInput)

// Doji: open and close essentially equal, with a real body far smaller than recent bars
isDoji = barRange > 0 and body <= barRange * bodyPctInput / 100 and not na(bodySma) and body <= bodySma * bodyAvgMultInput

threeDoji = isDoji and isDoji[1] and isDoji[2]

// Preceding trend, measured on the last candle before the first doji
advancePrior = not na(trendSma[3]) and close[3] > trendSma[3]
declinePrior = not na(trendSma[3]) and close[3] < trendSma[3]

// Middle doji gapping away from the first and third doji - even a small margin satisfies the definition
useBodyGap = gapBasisInput == GAP_BODY
gapAbove   = useBodyGap ? bodyLo[1] > bodyHi[2] and bodyLo[1] > bodyHi : low[1] > high[2] and low[1] > high
gapBelow   = useBodyGap ? bodyHi[1] < bodyLo[2] and bodyHi[1] < bodyLo : high[1] < low[2] and high[1] < low

bearSignal = threeDoji and advancePrior and gapAbove
bullSignal = threeDoji and declinePrior and gapBelow

// Loose variant: middle doji stranded at the extreme, but without a clean gap
midAtHigh = bodyMid[1] > bodyMid[2] and bodyMid[1] > bodyMid and high[1] >= high[2] and high[1] >= high
midAtLow  = bodyMid[1] < bodyMid[2] and bodyMid[1] < bodyMid and low[1] <= low[2] and low[1] <= low

bearLoose = looseInput and threeDoji and advancePrior and midAtHigh and not bearSignal
bullLoose = looseInput and threeDoji and declinePrior and midAtLow and not bullSignal

patternHigh = math.max(high, math.max(high[1], high[2]))
patternLow  = math.min(low, math.min(low[1], low[2]))

//---------------------------------------------------------------------------------------------------------------------}
// Confirmation Tracking
//---------------------------------------------------------------------------------------------------------------------{
var int   bearState = STATE_NONE
var float bearStop  = na
var float bearTrig  = na
var int   bearBar   = na
var line  bearLine  = na

var int   bullState = STATE_NONE
var float bullStop  = na
var float bullTrig  = na
var int   bullBar   = na
var line  bullLine  = na

bearConfirmEvent = false
bearInvalidEvent = false
bullConfirmEvent = false
bullInvalidEvent = false

// Resolve bearish tracking with this bar's close
if bearState != STATE_NONE and bar_index > bearBar
    if not na(bearLine)
        line.set_x2(bearLine, bar_index)

    if close > bearStop
        bearInvalidEvent := true
    else if bearState == STATE_PENDING and close < bearTrig
        bearConfirmEvent := true
        bearState        := STATE_CONFIRMED

    if bearInvalidEvent or (bearState == STATE_PENDING and bar_index - bearBar >= confirmBarsInput)
        bearState := STATE_NONE
        bearStop  := na
        bearTrig  := na
        bearBar   := na
        bearLine  := na

// Resolve bullish tracking with this bar's close
if bullState != STATE_NONE and bar_index > bullBar
    if not na(bullLine)
        line.set_x2(bullLine, bar_index)

    if close < bullStop
        bullInvalidEvent := true
    else if bullState == STATE_PENDING and close > bullTrig
        bullConfirmEvent := true
        bullState        := STATE_CONFIRMED

    if bullInvalidEvent or (bullState == STATE_PENDING and bar_index - bullBar >= confirmBarsInput)
        bullState := STATE_NONE
        bullStop  := na
        bullTrig  := na
        bullBar   := na
        bullLine  := na

// A new strict tri-star starts (or replaces) the tracked pattern in its direction
if bearSignal
    bearState := STATE_PENDING
    bearStop  := high[1]
    bearTrig  := low
    bearBar   := bar_index

    if showStopInput
        bearLine := line.new(bar_index - 1, bearStop, bar_index + 1, bearStop, color = bearColorInput, style = line.style_dashed)
    else
        bearLine := na

if bullSignal
    bullState := STATE_PENDING
    bullStop  := low[1]
    bullTrig  := high
    bullBar   := bar_index

    if showStopInput
        bullLine := line.new(bar_index - 1, bullStop, bar_index + 1, bullStop, color = bullColorInput, style = line.style_dashed)
    else
        bullLine := na

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
if bearSignal
    label.new(bar_index - 1, patternHigh, PATTERN_TXT, style = label.style_label_down, color = #00000000, textcolor = bearColorInput, size = size.small, tooltip = BEAR_TIP)

    if showBoxInput
        box.new(bar_index - 2, patternHigh, bar_index, patternLow, border_color = color.new(bearColorInput, 50), bgcolor = color.new(bearColorInput, 90))

if bullSignal
    label.new(bar_index - 1, patternLow, PATTERN_TXT, style = label.style_label_up, color = #00000000, textcolor = bullColorInput, size = size.small, tooltip = BULL_TIP)

    if showBoxInput
        box.new(bar_index - 2, patternHigh, bar_index, patternLow, border_color = color.new(bullColorInput, 50), bgcolor = color.new(bullColorInput, 90))

if bearLoose
    label.new(bar_index - 1, patternHigh, LOOSE_TXT, style = label.style_label_down, color = #00000000, textcolor = color.new(bearColorInput, 40), size = size.tiny, tooltip = LOOSE_BEAR_TIP)

if bullLoose
    label.new(bar_index - 1, patternLow, LOOSE_TXT, style = label.style_label_up, color = #00000000, textcolor = color.new(bullColorInput, 40), size = size.tiny, tooltip = LOOSE_BULL_TIP)

plotshape(bearConfirmEvent, 'Bearish Confirmation', shape.triangledown, location.abovebar, color = bearColorInput, size = size.tiny)
plotshape(bullConfirmEvent, 'Bullish Confirmation', shape.triangleup, location.belowbar, color = bullColorInput, size = size.tiny)
plotshape(bearInvalidEvent, 'Bearish Invalidation', shape.xcross, location.abovebar, color = color.new(chart.fg_color, 30), size = size.tiny)
plotshape(bullInvalidEvent, 'Bullish Invalidation', shape.xcross, location.belowbar, color = color.new(chart.fg_color, 30), size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bearSignal, 'Bearish Tri-Star', 'Bearish tri-star detected - three consecutive doji with the middle doji gapping above after an advance. Wait for a confirming close below the third doji.')
alertcondition(bullSignal, 'Bullish Tri-Star', 'Bullish tri-star detected - three consecutive doji with the middle doji gapping below after a decline. Wait for a confirming close above the third doji.')
alertcondition(bearConfirmEvent, 'Bearish Tri-Star Confirmed', 'Bearish tri-star confirmed - decisive close below the third doji. The middle doji high is the natural stop.')
alertcondition(bullConfirmEvent, 'Bullish Tri-Star Confirmed', 'Bullish tri-star confirmed - decisive close above the third doji. The middle doji low is the natural stop.')
alertcondition(bearInvalidEvent, 'Bearish Tri-Star Invalidated', 'Bearish tri-star invalidated - close accepted above the middle doji high, prior uptrend reinstated.')
alertcondition(bullInvalidEvent, 'Bullish Tri-Star Invalidated', 'Bullish tri-star invalidated - close accepted below the middle doji low, prior downtrend reinstated.')
alertcondition(bearLoose, 'Loose Bearish Tri-Star', 'Loose bearish tri-star - three consecutive doji stalling at the highs without clean gaps. Milder exhaustion note, look for confluence.')
alertcondition(bullLoose, 'Loose Bullish Tri-Star', 'Loose bullish tri-star - three consecutive doji stalling at the lows without clean gaps. Milder exhaustion note, look for confluence.')

//---------------------------------------------------------------------------------------------------------------------}
