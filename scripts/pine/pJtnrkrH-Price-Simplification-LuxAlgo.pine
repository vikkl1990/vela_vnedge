//@version=6
indicator("Price Simplification [LuxAlgo]", "LuxAlgo - Price Simplification", overlay = true, max_polylines_count = 100)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput     = input.int(500, "Window Size", minval = 10, maxval = 5000, tooltip = "Number of recent bars to apply the RDP algorithm to.")
multInput       = input.float(2.0, "ATR Multiplier", minval = 0.1, step = 0.1, tooltip = "The threshold distance for point simplification. Higher values result in more simplification.")
atrLengthInput  = input.int(14, "ATR Length", minval = 1)

STYLE_GROUP     = "Style"
lineColorInput  = input.color(#ff5d00, "Line Color", group = STYLE_GROUP)
lineWidthInput  = input.int(2, "Line Width", minval = 1, group = STYLE_GROUP)
extendLastInput = input.bool(false, "Extend Last Segment", group = STYLE_GROUP, tooltip = "Extend the last segment of the simplification to the right using a dashed line.")

//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{
// @type Internal point for RDP calculations with normalized coordinates
type Point
    float x
    float y

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// @function Calculates the perpendicular distance from a point to a line segment
// @param p1 The start point of the segment
// @param p2 The end point of the segment
// @param p0 The point to measure the distance for
// @returns The perpendicular distance
get_distance(Point p1, Point p2, Point p0) =>
    float x1 = p1.x
    float y1 = p1.y
    float x2 = p2.x
    float y2 = p2.y
    float x0 = p0.x
    float y0 = p0.y
    
    float numerator = math.abs((y2 - y1) * x0 - (x2 - x1) * y0 + x2 * y1 - y2 * x1)
    float denominator = math.sqrt(math.pow(y2 - y1, 2) + math.pow(x2 - x1, 2))
    
    denominator == 0 ? 0 : numerator / denominator

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Calculate ATR for normalization
float atr = ta.atr(atrLengthInput)
// Threshold is now just the multiplier because price is normalized by ATR
float threshold = multInput

var polyline rdpPolyline = na

if barstate.islast and not na(atr) and atr > 0
    // 1. Gather points and normalize Y by ATR
    Point[] normPoints = array.new<Point>()
    chart.point[] origPoints = array.new<chart.point>()
    
    for i = lengthInput - 1 to 0
        float price = close[i]
        origPoints.push(chart.point.from_index(bar_index[i], price))
        normPoints.push(Point.new(bar_index[i], price / atr))
    
    int n = normPoints.size()
    bool[] keep = array.new_bool(n, false)
    keep.set(0, true)
    keep.set(n - 1, true)
    
    // 2. Iterative RDP using a stack for indices [start, end]
    int[] stack = array.new_int()
    stack.push(0)
    stack.push(n - 1)
    
    while stack.size() > 0
        int lastIdx = stack.pop()
        int firstIdx = stack.pop()
        
        float max_dist = 0.0
        int index = firstIdx
        
        // Find the point with the maximum distance in normalized space
        for i = firstIdx + 1 to lastIdx - 1
            float d = get_distance(normPoints.get(firstIdx), normPoints.get(lastIdx), normPoints.get(i))
            if d > max_dist
                max_dist := d
                index := i
        
        // If max distance is greater than threshold, split the segment
        if max_dist > threshold
            keep.set(index, true)
            
            // Push right segment
            stack.push(index)
            stack.push(lastIdx)
            
            // Push left segment
            stack.push(firstIdx)
            stack.push(index)
            
    // 3. Filter original points to keep
    chart.point[] finalPoints = array.new<chart.point>()
    for i = 0 to n - 1
        if keep.get(i)
            finalPoints.push(origPoints.get(i))
            
    // 4. Update or Create Polyline
    if not na(rdpPolyline)
        rdpPolyline.delete()
        
    rdpPolyline := polyline.new(finalPoints, line_color = lineColorInput, line_width = lineWidthInput)

    // 5. Extension Line
    var line extensionLine = na
    if extendLastInput and finalPoints.size() >= 2
        chart.point p2 = finalPoints.get(finalPoints.size() - 1)
        chart.point p1 = finalPoints.get(finalPoints.size() - 2)
        
        float slope = (p2.price - p1.price) / (p2.index - p1.index)
        int x1      = int(p2.index + 1)
        float y1    = p2.price + slope
        int x2      = int(p2.index + 2)
        float y2    = p2.price + 2 * slope

        if na(extensionLine)
            extensionLine := line.new(x1, y1, x2, y2, extend = extend.right, color = lineColorInput, style = line.style_dashed, width = lineWidthInput)
        else
            extensionLine.set_xy1(x1, y1)
            extensionLine.set_xy2(x2, y2)
            extensionLine.set_color(lineColorInput)
            extensionLine.set_width(lineWidthInput)
    else
        extensionLine.delete()
        extensionLine := na

//---------------------------------------------------------------------------------------------------------------------}
