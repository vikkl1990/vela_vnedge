//@version=6
indicator("Pocket Pivot", shorttitle = "Pocket Pivot", overlay = true, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
FAST_COLOR    = #ff9800 // the one accent - the fast line constructive signals ride
NEUTRAL_COLOR = #787b86
HIDDEN_COLOR  = #00000000

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

PP_GROUP    = "Pocket Pivot"
CTX_GROUP   = "Constructive Context"
DASH_GROUP  = "Dashboard"
STYLE_GROUP = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lookbackInput = input.int(10, "Down-Day Volume Lookback", minval = 1, group = PP_GROUP,
  tooltip = "Prior sessions scanned for their single largest down-day volume. A pocket pivot is an up close whose volume exceeds that figure — beating only the down days is what lets the signal fire inside a quiet base before an obvious breakout develops. Ten sessions is the canonical setting.")

showStopInput = input.bool(true, "Pivot Day Low Stop", group = PP_GROUP,
  tooltip = "Track each signal day's low as a stop reference — the classical exit sits just under the pocket pivot day's low. The line stops extending once a close undercuts it (marked with a cross) or a newer signal replaces it.")

fastLenInput = input.int(10, "Fast SMA Length", minval = 1, group = CTX_GROUP,
  tooltip = "Length of the fast simple moving average — the ten-day line of the original daily-chart definition. Constructive signals ride or reclaim this average, and continuation pocket pivots off it serve as add points.")

slowLenInput = input.int(50, "Slow SMA Length", minval = 1, group = CTX_GROUP,
  tooltip = "Length of the slow simple moving average — the fifty-day line of the original definition. It defines the uptrend for the trend filter and acts as the outer support of a proper base.")

trendFilterInput = input.bool(true, "Uptrend Filter", group = CTX_GROUP,
  tooltip = "Require the signal to close above the slow moving average. Pocket pivots that fire inside downtrends are improper under the original definition and are skipped while this is enabled.")

supportFilterInput = input.bool(true, "MA Support Filter", group = CTX_GROUP,
  tooltip = "Require the signal day's low to print within the proximity band of the fast or slow moving average while the close holds above that average — the constructive, non-extended context the definition demands. Disable this and the uptrend filter to screen for the raw volume rule alone.")

proximityInput = input.float(2.0, "Support Proximity %", minval = 0, step = 0.25, group = CTX_GROUP,
  tooltip = "Width of the support band, as a percentage above each moving average, that the signal day's low must reach. Zero demands an intraday touch of the average; larger values accept signals basing slightly above their averages. This is also the extension guard — up days whose lows never come this close to an average are treated as extended to the upside and skipped.")

showDashInput = input.bool(true, "Show Dashboard", group = DASH_GROUP,
  tooltip = "Summarize the current bar against the volume rule, the largest down-day volume of the window, the trend and support context, the most recent signal, and the standing pivot-low stop.")

dashPosInput = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = DASH_GROUP,
  tooltip = "Chart corner where the dashboard is anchored.")

dashSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = DASH_GROUP,
  tooltip = "Dashboard text size.")

showSignalsInput = input.bool(true, "Signal Markers", inline = "sig", group = STYLE_GROUP,
  tooltip = "Mark each pocket pivot with a label under the signal bar. The label tooltip reports the volume multiple achieved over the window's largest down day, the average providing support, and the pivot low used as the stop reference.")
signalColorInput = input.color(BULL_COLOR, "", inline = "sig", group = STYLE_GROUP,
  tooltip = "Pocket pivot marker color, also used for bullish dashboard readings.")

showFastInput = input.bool(true, "Fast SMA", inline = "fast", group = STYLE_GROUP,
  tooltip = "Plot the fast simple moving average.")
fastColorInput = input.color(FAST_COLOR, "", inline = "fast", group = STYLE_GROUP,
  tooltip = "Fast moving average color.")

showSlowInput = input.bool(true, "Slow SMA", inline = "slow", group = STYLE_GROUP,
  tooltip = "Plot the slow simple moving average.")
slowColorInput = input.color(NEUTRAL_COLOR, "", inline = "slow", group = STYLE_GROUP,
  tooltip = "Slow moving average color.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", group = STYLE_GROUP,
  tooltip = "Color of the pivot-low stop line, its breach mark, and bearish dashboard readings.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
fmtSignedPct(float value) =>
    (value >= 0 ? "+" : "") + str.tostring(value, "#.##") + "%"

//---------------------------------------------------------------------------------------------------------------------}
// Pocket Pivot Detection
//---------------------------------------------------------------------------------------------------------------------{
float cumulativeVolume = ta.cum(nz(volume))

if barstate.islast and cumulativeVolume == 0
    runtime.error("No volume is available for this symbol. Pocket pivot detection requires volume data.")

bool hasVolume = not na(volume) and volume > 0

bool upClose   = close > nz(close[1], close)
bool downClose = close < nz(close[1], close)

//Volume printed by down sessions only - the reference figure an up day must beat
float downVolume    = downClose ? nz(volume) : 0
float maxDownVolume = ta.highest(downVolume, lookbackInput)[1]

//The core rule - an up close on volume above every down day of the prior window
bool volumeSignature = upClose and hasVolume and not na(maxDownVolume) and volume > maxDownVolume

float volumeRatio = hasVolume and not na(maxDownVolume) and maxDownVolume > 0 ? volume / maxDownVolume : na

//Constructive context - the averages the signal should be acting around
float fastMa = ta.sma(close, fastLenInput)
float slowMa = ta.sma(close, slowLenInput)

bool masValid = not na(fastMa) and not na(slowMa)

//Support prints when the day's low reaches the proximity band of an average while the close holds above it
float proximityFactor = 1 + proximityInput / 100
bool  atFastMa = masValid and low <= fastMa * proximityFactor and close >= fastMa
bool  atSlowMa = masValid and low <= slowMa * proximityFactor and close >= slowMa

bool trendOk   = not trendFilterInput or (masValid and close > slowMa)
bool supportOk = not supportFilterInput or atFastMa or atSlowMa

bool pocketPivot       = volumeSignature and trendOk and supportOk
bool continuationPivot = pocketPivot and atFastMa

var int lastSignalBar = na
if pocketPivot
    lastSignalBar := bar_index

//---------------------------------------------------------------------------------------------------------------------}
// Pivot Low Stop
//---------------------------------------------------------------------------------------------------------------------{
var float activeStop = na
var line  stopLine   = na

//Breach is measured against the level carried into this bar - a close under the standing pivot day low
bool  stopHit     = not na(activeStop) and not pocketPivot and close < activeStop
float breachLevel = stopHit and showStopInput ? activeStop : na

if not na(activeStop) and not pocketPivot and not na(stopLine)
    line.set_x2(stopLine, bar_index)

if stopHit
    activeStop := na
    stopLine   := line(na)

if pocketPivot
    activeStop := low
    stopLine   := line(na)
    if showStopInput
        stopLine := line.new(bar_index, low, bar_index, low, color = bearColorInput, style = line.style_dashed, width = 1)

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
plot(showFastInput ? fastMa : na, "Fast SMA", fastColorInput, 1)
plot(showSlowInput ? slowMa : na, "Slow SMA", slowColorInput, 2)

//Breach marks - the bar closing under the standing pivot low stop
plotshape(breachLevel, "Stop Breach", shape.xcross, location.absolute, bearColorInput, size = size.tiny)

if pocketPivot and showSignalsInput
    string ratioTxt = na(volumeRatio) ? "no down days in the window" : str.tostring(volumeRatio, "#.##") + "× the largest down-day volume"
    string maTxt    = atFastMa and atSlowMa ? "fast & slow SMA" : atFastMa ? "fast SMA" : atSlowMa ? "slow SMA" : "none within proximity"
    string tipTxt   = "Volume: " + ratioTxt + " (" + str.tostring(lookbackInput) + " sessions)\nSupport: " + maTxt + "\nPivot low: " + str.tostring(low, format.mintick)
    label.new(bar_index, low, "PP", yloc = yloc.belowbar, style = label.style_label_up, color = HIDDEN_COLOR, textcolor = signalColorInput, size = size.small, tooltip = tipTxt)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
dashPos = switch dashPosInput
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

dashTxtSize = switch dashSizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    => size.normal

var table dashTable = na

if showDashInput and barstate.islast
    if na(dashTable)
        dashTable := table.new(dashPos, 2, 6, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

    labelColor = DASH_HEADER
    fadedColor = DASH_HEADER

    ruleTxt = not hasVolume ? "No volume" :
      na(maxDownVolume) ? "Warming up" :
      downClose ? "Down close" :
      not upClose ? "Unchanged close" :
      maxDownVolume == 0 ? "Up close · no down days to beat" :
      "Up close · " + str.tostring(volumeRatio, "#.##") + "× down max"
    ruleColor = volumeSignature ? signalColorInput : fadedColor

    downMaxTxt = na(maxDownVolume) ? "—" : maxDownVolume == 0 ? "None" : str.tostring(maxDownVolume, format.volume)

    trendPct   = masValid and slowMa != 0 ? (close - slowMa) / slowMa * 100 : na
    trendTxt   = not masValid ? "—" : (close > slowMa ? "Above slow SMA" : close < slowMa ? "Below slow SMA" : "At slow SMA") +
      (na(trendPct) ? "" : " (" + fmtSignedPct(trendPct) + ")") + (trendFilterInput ? "" : " · filter off")
    trendColor = not masValid ? fadedColor : close < slowMa ? bearColorInput : signalColorInput

    supTxt   = not masValid ? "—" : (atFastMa and atSlowMa ? "Fast & slow SMA" : atFastMa ? "Fast SMA" : atSlowMa ? "Slow SMA" : "None in range") +
      (supportFilterInput ? "" : " · filter off")
    supColor = masValid and (atFastMa or atSlowMa) ? signalColorInput : fadedColor

    lastAge   = bar_index - lastSignalBar
    lastTxt   = na(lastSignalBar) ? "None" : lastAge == 0 ? "This bar" : str.tostring(lastAge) + (lastAge == 1 ? " bar ago" : " bars ago")
    lastColor = na(lastSignalBar) ? fadedColor : lastAge == 0 ? signalColorInput : DASH_TEXT

    stopTxt   = na(activeStop) ? "—" : str.tostring(activeStop, format.mintick)
    stopColor = na(activeStop) ? fadedColor : bearColorInput

    table.cell(dashTable, 0, 0, "Volume Rule",                                          text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, ruleTxt,                                                text_color = ruleColor,  text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 1, "Down-Day Max (" + str.tostring(lookbackInput) + ")",   text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, downMaxTxt,                                             text_color = DASH_TEXT, text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, "Trend",                                                text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, trendTxt,                                               text_color = trendColor, text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 3, "Support",                                              text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, supTxt,                                                 text_color = supColor,   text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 4, "Last Signal",                                          text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 4, lastTxt,                                                text_color = lastColor,  text_size = dashTxtSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 5, "Pivot Low Stop",                                       text_color = labelColor, text_size = dashTxtSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 5, stopTxt,                                                text_color = stopColor,  text_size = dashTxtSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(pocketPivot, "Pocket Pivot", "Pocket pivot on {{ticker}} ({{interval}}) — up close on volume above the largest down-day volume of the prior window, in constructive context")

alertcondition(continuationPivot, "Continuation Pocket Pivot", "Continuation pocket pivot on {{ticker}} ({{interval}}) — the signal is finding support at the fast moving average, the classical add point")

alertcondition(volumeSignature, "Volume Rule Met", "Up close on {{ticker}} ({{interval}}) with volume above the largest down-day volume of the prior window — the raw pocket pivot volume rule, before context filters")

alertcondition(stopHit, "Pivot Low Stop Breached", "{{ticker}} ({{interval}}) closed below the latest pocket pivot day's low — the classical stop for the signal is hit")

//---------------------------------------------------------------------------------------------------------------------}
