//@version=6
indicator("Traders Dynamic Index", shorttitle = "Traders Dynamic Index", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MID_LINE = 50.0 // RSI midline, the bull/bear divider every TDI read is filtered against

BULLISH_COLOR = #089981
BEARISH_COLOR = #f23645
BASE_COLOR    = #ffb300 // classic TDI market base line yellow
NEUTRAL_COLOR = #787b86
LEVELS_COLOR  = #787b86

CROSS_FILL_VALUE_TRANSP  = 50  // crossover gradient transparency at the price line
CROSS_FILL_SIGNAL_TRANSP = 100 // crossover gradient transparency at the signal line
BAND_FILL_EDGE_TRANSP    = 80  // band gradient transparency at the band extremities
BAND_FILL_BASE_TRANSP    = 100 // band gradient transparency at the market base line

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
rsiLengthInput = input.int(13, "RSI Length", minval = 2
  , group   = "Settings"
  , tooltip = "Lookback of the RSI every TDI component is derived from - the price line, signal line, market base line and volatility bands are all smoothed versions of this single momentum series. 13 is the classic TDI basis.")

srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Price series the underlying RSI is computed on. The whole panel is built from that one series, so the source choice propagates to every line.")

priceLineLengthInput = input.int(2, "Price Line Length", minval = 1
  , group   = "Settings"
  , tooltip = "Bars used to smooth the RSI into the fast price line. At the classic setting of 2 it hugs the raw RSI closely and supplies the timing side of every crossover.")

signalLineLengthInput = input.int(7, "Signal Line Length", minval = 1
  , group   = "Settings"
  , tooltip = "Bars used to smooth the RSI into the slower signal line the price line is compared against. The price line crossing this line is the classic TDI entry cue. 7 is the classic setting.")

bandsLengthInput = input.int(34, "Bands Length", minval = 2
  , group   = "Settings"
  , tooltip = "Basis length of the Bollinger Bands computed on the RSI. Their moving-average midline is the market base line, whose position and slope relative to 50 acts as the regime filter. 34 is the classic setting.")

bandsMultInput = input.float(1.6185, "Bands Multiplier", minval = 0.001, step = 0.05
  , group   = "Settings"
  , tooltip = "Standard deviations between the market base line and each volatility band. Because the bands wrap the RSI rather than price, they form a volatility envelope for the momentum reading itself. 1.6185 is the classic TDI setting.")

//---------------------------------------------------------------------------------------------------------------------}
// Levels
//---------------------------------------------------------------------------------------------------------------------{
obLevelInput = input.float(68, "Overbought", minval = 50, maxval = 100, step = 1
  , group   = "Levels"
  , tooltip = "Upper zone line of the panel. The price line trading above it marks stretched bullish momentum. 68 is the classic TDI zone level.")

osLevelInput = input.float(32, "Oversold", minval = 0, maxval = 50, step = 1
  , group   = "Levels"
  , tooltip = "Lower zone line of the panel. The price line trading below it marks stretched bearish momentum. 32 is the classic TDI zone level.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
priceColorInput = input.color(BULLISH_COLOR, "Price Line"
  , group   = "Style"
  , tooltip = "Color of the fast price line, of the crossover gradient while the price line is on top, and of bullish crossover markers.")

signalColorInput = input.color(BEARISH_COLOR, "Signal Line"
  , group   = "Style"
  , tooltip = "Color of the slow signal line, of the crossover gradient while the price line is below it, and of bearish crossover markers.")

baseColorInput = input.color(BASE_COLOR, "Base Line"
  , group   = "Style"
  , tooltip = "Color of the market base line, the moving-average midline of the volatility bands. Classic TDI draws it yellow.")

bandsColorInput = input.color(NEUTRAL_COLOR, "Volatility Bands"
  , group   = "Style"
  , tooltip = "Color of the upper and lower volatility bands and of their gradient fill toward the market base line.")

levelsColorInput = input.color(LEVELS_COLOR, "Zone Lines"
  , group   = "Style"
  , tooltip = "Color of the dashed overbought/oversold zone lines and of the dotted 50 midline.")

crossFillInput = input.bool(true, "Crossover Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between the price line and the signal line - fully transparent at the signal line and strongest at the price line, bullish-colored while the price line is on top and bearish-colored while it is below.")

bandsFillInput = input.bool(true, "Bands Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between the market base line and each volatility band, fully transparent at the base line and strongest at the band. A wide envelope means volatile momentum; a pinching one marks the contraction that often precedes a stronger directional move.")

showMarkersInput = input.bool(false, "Crossover Markers"
  , group   = "Style"
  , tooltip = "Displays a small circle at each price line / signal line crossover. Off by default to keep the pane clean - the crossover alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Base momentum series - every TDI line below is a smoothed derivative of this one RSI
rsiValue = ta.rsi(srcInput, rsiLengthInput)

// Fast price line and slower signal line - the crossover-timing pair
priceLine  = ta.sma(rsiValue, priceLineLengthInput)
signalLine = ta.sma(rsiValue, signalLineLengthInput)

// Bollinger Bands on the RSI - the market base line is their moving-average midline and the
// bands are a standard-deviation envelope around it, wrapping momentum instead of price
baseLine    = ta.sma(rsiValue, bandsLengthInput)
bandsOffset = bandsMultInput * ta.stdev(rsiValue, bandsLengthInput)

upperBand = baseLine + bandsOffset
lowerBand = baseLine - bandsOffset

priceAboveSignal = priceLine > signalLine

// Crossover events - the classic TDI trigger, plus the midline-filtered variants where both
// moving averages sit on the same side of 50
crossoverBull = ta.crossover(priceLine, signalLine)
crossoverBear = ta.crossunder(priceLine, signalLine)

filteredBull = crossoverBull and priceLine > MID_LINE and signalLine > MID_LINE
filteredBear = crossoverBear and priceLine < MID_LINE and signalLine < MID_LINE

// Midline events - momentum tilt for the price line, regime filter for the market base line
priceMidCrossUp = ta.crossover(priceLine, MID_LINE)
priceMidCrossDn = ta.crossunder(priceLine, MID_LINE)
baseMidCrossUp  = ta.crossover(baseLine, MID_LINE)
baseMidCrossDn  = ta.crossunder(baseLine, MID_LINE)

// Band events - the price line pressing an outer band marks stretched momentum
upperBandCross = ta.crossover(priceLine, upperBand)
lowerBandCross = ta.crossunder(priceLine, lowerBand)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
upperBandPlotId = plot(upperBand, "Upper Band", color = bandsColorInput, linewidth = 1)
lowerBandPlotId = plot(lowerBand, "Lower Band", color = bandsColorInput, linewidth = 1)
baseLinePlotId  = plot(baseLine, "Market Base Line", color = baseColorInput, linewidth = 2)

signalLinePlotId = plot(signalLine, "Signal Line", color = signalColorInput, linewidth = 1)
priceLinePlotId  = plot(priceLine, "Price Line", color = priceColorInput, linewidth = 2)

fill(baseLinePlotId, upperBandPlotId
  , top_value    = upperBand
  , bottom_value = baseLine
  , top_color    = bandsFillInput ? color.new(bandsColorInput, BAND_FILL_EDGE_TRANSP) : na
  , bottom_color = bandsFillInput ? color.new(bandsColorInput, BAND_FILL_BASE_TRANSP) : na
  , title        = "Upper Band Gradient Fill")

fill(baseLinePlotId, lowerBandPlotId
  , top_value    = baseLine
  , bottom_value = lowerBand
  , top_color    = bandsFillInput ? color.new(bandsColorInput, BAND_FILL_BASE_TRANSP) : na
  , bottom_color = bandsFillInput ? color.new(bandsColorInput, BAND_FILL_EDGE_TRANSP) : na
  , title        = "Lower Band Gradient Fill")

// Crossover gradient - anchored to the signal line, strongest at the price line, colored by
// which of the pair is on top
crossFillTopColor    = priceAboveSignal ? color.new(priceColorInput, CROSS_FILL_VALUE_TRANSP) : color.new(signalColorInput, CROSS_FILL_SIGNAL_TRANSP)
crossFillBottomColor = priceAboveSignal ? color.new(priceColorInput, CROSS_FILL_SIGNAL_TRANSP) : color.new(signalColorInput, CROSS_FILL_VALUE_TRANSP)

fill(priceLinePlotId, signalLinePlotId
  , top_value    = math.max(priceLine, signalLine)
  , bottom_value = math.min(priceLine, signalLine)
  , top_color    = crossFillInput ? crossFillTopColor : na
  , bottom_color = crossFillInput ? crossFillBottomColor : na
  , title        = "Crossover Gradient Fill")

hline(obLevelInput, "Overbought", levelsColorInput, hline.style_dashed)
hline(osLevelInput, "Oversold", levelsColorInput, hline.style_dashed)
hline(MID_LINE, "Midline", color.new(levelsColorInput, 50), hline.style_dotted)

plotshape(showMarkersInput and crossoverBull ? signalLine : na, "Bullish Crossover Marker", style = shape.circle, location = location.absolute, color = priceColorInput, size = size.tiny)
plotshape(showMarkersInput and crossoverBear ? signalLine : na, "Bearish Crossover Marker", style = shape.circle, location = location.absolute, color = signalColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossoverBull, "Bullish Crossover", "Traders Dynamic Index: price line crossed above the signal line on {{ticker}} - the classic bullish TDI cue ({{interval}})")
alertcondition(crossoverBear, "Bearish Crossover", "Traders Dynamic Index: price line crossed below the signal line on {{ticker}} - the classic bearish TDI cue ({{interval}})")
alertcondition(filteredBull, "Bullish Crossover Above Midline", "Traders Dynamic Index: bullish crossover with both moving averages above the 50 midline on {{ticker}} - midline-filtered long cue ({{interval}})")
alertcondition(filteredBear, "Bearish Crossover Below Midline", "Traders Dynamic Index: bearish crossover with both moving averages below the 50 midline on {{ticker}} - midline-filtered short cue ({{interval}})")
alertcondition(priceMidCrossUp, "Bullish Midline Cross", "Traders Dynamic Index: price line crossed above the 50 midline on {{ticker}} - momentum tilted bullish ({{interval}})")
alertcondition(priceMidCrossDn, "Bearish Midline Cross", "Traders Dynamic Index: price line crossed below the 50 midline on {{ticker}} - momentum tilted bearish ({{interval}})")
alertcondition(baseMidCrossUp, "Bullish Regime Shift", "Traders Dynamic Index: market base line crossed above the 50 midline on {{ticker}} - regime filter now permits longs ({{interval}})")
alertcondition(baseMidCrossDn, "Bearish Regime Shift", "Traders Dynamic Index: market base line crossed below the 50 midline on {{ticker}} - regime filter now permits shorts ({{interval}})")
alertcondition(upperBandCross, "Upper Band Pressed", "Traders Dynamic Index: price line crossed above the upper volatility band on {{ticker}} - stretched bullish momentum ({{interval}})")
alertcondition(lowerBandCross, "Lower Band Pressed", "Traders Dynamic Index: price line crossed below the lower volatility band on {{ticker}} - stretched bearish momentum ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
