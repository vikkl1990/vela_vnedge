//@version=6
indicator("Price Map Profile [BigBeluga]", overlay = true, max_boxes_count = 500)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
length = input.int(200)
bins = input.int(100)
vol_freq = input.string("Volume", "Data", ["Volume", "Frequency"]) == "Volume"
pivot_level = input.bool(true, "Pivot Levels", inline = "pl")
col_upper = input.color(color.yellow, "", inline = "pl")
col_lower = input.color(color.aqua, "", inline = "pl")

col_low = input.color(color.rgb(33, 149, 243, 98), "", inline = "colors")
col_mid1 = input.color(color.rgb(0, 187, 212, 95), "", inline = "colors")
col_up  = input.color(color.rgb(224, 39, 39, 50), "", inline = "colors")

var pivot_levels = array.new<float>()
var pivot_bars = array.new<int>() // Store bar indices where pivots occur
var pivot_lbl = array.new<label>()
var pivot_side = array.new<bool>()

values = array.new<float>()
vol_bins = array.new<float>(bins)

max_val = float(na)
min_val = float(na)
step = float(na)
// }


// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
ph = ta.pivothigh(15,15)
pl = ta.pivotlow(15,15)

atr = ta.atr(200)*0.7

if last_bar_index-bar_index < length 

    if not na(ph)
        pivot_levels.push(ph)
        pivot_bars.push(bar_index - 15)
        pivot_lbl.push(label.new(bar_index - 15, ph, style = label.style_label_down, color = color.new(color.yellow, 100), size = size.tiny))
        pivot_side.push(false)

    if not na(pl)
        pivot_levels.push(pl)
        pivot_bars.push(bar_index- 15) 
        pivot_lbl.push(label.new(bar_index - 15, pl, style = label.style_label_up, color = color.new(color.aqua, 100), size = size.tiny))
        pivot_side.push(true)

if not pivot_level
    if pivot_lbl.size() > 0
        for i = 0 to pivot_lbl.size() - 1
            label.delete(pivot_lbl.get(i))

// Remove nearby duplicate pivot levels (after pushing new ones)
if pivot_levels.size() > 1
    i = pivot_levels.size() - 1
    while i > 0
        level_i = pivot_levels.get(i)
        j = i - 1
        while j >= 0
            level_j = pivot_levels.get(j)
            too_close = math.abs(level_i - level_j) < atr
            if too_close
                // Delete the older one: index j
                array.remove(pivot_levels, j)
                array.remove(pivot_bars, j)
                label.delete(array.get(pivot_lbl, j))
                array.remove(pivot_lbl, j)
                array.remove(pivot_side, j)
                i := i - 1  // Because array shifted left
            j := j - 1
        i := i - 1

if barstate.islast
    for i = pivot_bars.size() - 1 to 0
        
        if last_bar_index - pivot_bars.get(i) >= length
            pivot_levels.remove(i)
            pivot_bars.remove(i)
            pivot_side.remove(i)
            label.delete(pivot_lbl.shift())


if barstate.islast
    for i = 0 to length - 1
        values.push(high[i])
        values.push(low[i])

    max_val := values.max()
    min_val := values.min()

    step := (max_val-min_val)/bins

    
if barstate.islast
    for i = 0 to bins - 1
        vol_bins.set(i, 0)

    for i = 0 to length - 1

        c_top   = math.max(close[i], open[i])
        c_low   = math.min(close[i], open[i])
        c = close[i]
        vol     = volume[i]

        for j = 0 to bins - 1

            lower = min_val + step * j 
            upper = lower + step 
            mid = math.avg(lower, upper)

            if c <= upper + step*1.5 and c >= lower - step*1.5
                vol_bins.set(j, vol_bins.get(j) + (vol_freq?vol:1))

var bin_boxes = array.new<box>()
var bin_levels = array.new<line>()
var bin_labels = array.new<label>()
var bin_max = array.new<label>()

if barstate.islast

    if bin_boxes.size()>0
        for k = 0 to bin_boxes.size() - 1
            box.delete(bin_boxes.get(k))

    if bin_levels.size() > 0
        for k = 0 to bin_levels.size() - 1
            line.delete(bin_levels.get(k))
            label.delete(bin_labels.get(k))

    if bin_max.size() > 0
        for k = 0 to bin_max.size() - 1
            label.delete(bin_max.get(k))

    for i = 0 to bins - 1

        lower = min_val + step * i
        upper = lower + step 
        mid = math.avg(upper, lower)

        vol = int(vol_bins.get(i) / vol_bins.max() * 25)

        start = bar_index - length + vol
        end = bar_index + vol

        var midd = float(na)

        color_ = vol_bins.get(i) >= vol_bins.avg() 
                     ? color.from_gradient(vol_bins.get(i), vol_bins.avg(), vol_bins.max(), col_mid1, col_up) 
                     : color.from_gradient(vol_bins.get(i), 0, vol_bins.avg(), col_low, col_mid1) 

        bin_boxes.push(box.new(start, upper, end, lower, na, bgcolor = color_))


        if vol_bins.get(i) == vol_bins.max()
            bin_max.push(label.new(end, mid, str.tostring(vol_bins.get(i), format.volume), style = label.style_label_left, color = color.new(col_up, 25)))

        if pivot_levels.size() > 0

            for j = 0 to pivot_levels.size() - 1

                pivot_l = pivot_levels.get(j)

                if pivot_l >= lower and pivot_l <= upper and pivot_level and vol_bins.get(i) < vol_bins.avg()
                    midd := mid 
                    col = pivot_side.get(j) ? color.new(col_lower, 25) : color.new(col_upper, 25)

                    bin_levels.push(line.new(start, mid, end, mid, color = col, style = line.style_dashed))
                    bin_labels.push(label.new(bar_index - length, mid, vol_bins.get(i) == 0 ? ">" : str.tostring(vol_bins.get(i), format.volume), style = label.style_label_right, color = color.new(chart.bg_color, 50), textcolor = col))
                    
                    pivot_lbl.get(j).set_color(col)
// }


