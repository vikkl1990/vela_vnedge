//@version=6
indicator("Laguerre Filter", shorttitle = "Laguerre Filter", overlay = true)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981
BEAR_COLOR        = #f23645
NEUTRAL_COLOR     = #787b86
FILL_PRICE_TRANSP = 60  // gradient transparency at the price end of the fill
FILL_FILT_TRANSP  = 100 // gradient transparency at the filter end of the fill

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput   = input.source(close, "Source", group = "Settings",
     tooltip = "Price series the filter smooths. Ehlers' published Time Warp example feeds the bar midpoint (hl2); the close is the common charting default.")

gammaInput = input.float(0.8, "Gamma", minval = 0, maxval = 0.99, step = 0.01, group = "Settings",
     tooltip = "Damping factor shared by the four cascaded stages — the filter's only knob, standing in for a bar-count length. At 0 the cascade collapses to a fixed 1-2-2-1 smoother of the last four bars; raising it stretches the warped memory, so the line gets smoother and lag grows. Because gamma feeds every stage its effect compounds — adjust gradually. 0.8 is Ehlers' published example setting.")

trendColorInput   = input.bool(true, "Slope Trend Coloring", group = "Style",
     tooltip = "Colors the Laguerre filter by its slope — bullish while the line is rising, bearish while it is falling. Disable to draw the line in the neutral color.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Bullish color, used while the filter slope is rising and for bullish crossings/fill.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Bearish color, used while the filter slope is falling and for bearish crossings/fill.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral", group = "Style",
     tooltip = "Line color used when slope trend coloring is disabled, or when the slope is flat.")

showFillInput     = input.bool(true, "Price / Filter Gradient Fill", group = "Style",
     tooltip = "Fills the area between the source and the filter with a vertical gradient — bullish while price holds above the Laguerre filter, bearish while below — fading to fully transparent at the filter line. Visualizes how pullbacks in a trend repeatedly test the line as dynamic support or resistance.")

showSignalsInput  = input.bool(false, "Price Crossing Markers", group = "Style",
     tooltip = "Displays small triangle markers when the source crosses over or under the Laguerre filter. Off by default to keep the chart clean — the crossing alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Four-stage Laguerre filter — John Ehlers' published recipe (Time Warp, Without Space Travel):
// L0 = (1 - gamma)*price + gamma*L0[1]                      — one-pole smoother of price
// Ln = -gamma*L(n-1) + L(n-1)[1] + gamma*Ln[1] for n = 1..3 — all-pass sections delaying the stage above in the warped time base
// Filt = (L0 + 2*L1 + 2*L2 + L3) / 6                        — fixed 1-2-2-1 weighted blend of the four stage outputs
// Every stage is seeded with the source itself so the cascade starts on real data instead of ramping from zero
laguerreFilter(float src, float gamma) =>
    float l0 = na
    float l1 = na
    float l2 = na
    float l3 = na
    l0Prev = nz(l0[1], src)
    l1Prev = nz(l1[1], src)
    l2Prev = nz(l2[1], src)
    l3Prev = nz(l3[1], src)
    l0 := (1 - gamma) * src + gamma * l0Prev
    l1 := -gamma * l0 + l0Prev + gamma * l1Prev
    l2 := -gamma * l1 + l1Prev + gamma * l2Prev
    l3 := -gamma * l2 + l2Prev + gamma * l3Prev
    (l0 + 2 * l1 + 2 * l2 + l3) / 6

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
filt = laguerreFilter(srcInput, gammaInput)

// Slope of the filter — the trend read of the smoother: price above a rising line is the bullish bias,
// and a flat line with price whipping across it marks the chop where trend entries tend to fail
slope = filt - nz(filt[1], filt)

// Price crossings — traded the way EMA crosses are
crossUp   = ta.crossover(srcInput, filt)
crossDown = ta.crossunder(srcInput, filt)

// Slope reversals of the filter — direction changes of the smoothed line
slopeTurnUp   = slope > 0 and nz(slope[1]) <= 0
slopeTurnDown = slope < 0 and nz(slope[1]) >= 0

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
filtColor = trendColorInput ? (slope > 0 ? bullColorInput : slope < 0 ? bearColorInput : neutralColorInput) : neutralColorInput

priceAbove      = srcInput > filt
fillTopColor    = showFillInput ? (priceAbove ? color.new(bullColorInput, FILL_PRICE_TRANSP) : color.new(bearColorInput, FILL_FILT_TRANSP)) : na
fillBottomColor = showFillInput ? (priceAbove ? color.new(bullColorInput, FILL_FILT_TRANSP) : color.new(bearColorInput, FILL_PRICE_TRANSP)) : na

srcPlotId  = plot(srcInput, "Source", color = na, editable = false, display = display.none)
filtPlotId = plot(filt, "Laguerre Filter", color = filtColor, linewidth = 2)

fill(srcPlotId, filtPlotId, top_value = math.max(srcInput, filt), bottom_value = math.min(srcInput, filt), top_color = fillTopColor, bottom_color = fillBottomColor, title = "Price / Filter Gradient Fill")

plotshape(showSignalsInput and crossUp, "Bullish Cross", shape.triangleup, location.belowbar, color = bullColorInput, size = size.tiny)
plotshape(showSignalsInput and crossDown, "Bearish Cross", shape.triangledown, location.abovebar, color = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Bullish Price Cross", "Price crossed above the Laguerre Filter on {{ticker}} ({{interval}})")
alertcondition(crossDown, "Bearish Price Cross", "Price crossed below the Laguerre Filter on {{ticker}} ({{interval}})")
alertcondition(slopeTurnUp, "Laguerre Filter Slope Up", "Laguerre Filter slope turned upward on {{ticker}} ({{interval}})")
alertcondition(slopeTurnDown, "Laguerre Filter Slope Down", "Laguerre Filter slope turned downward on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
