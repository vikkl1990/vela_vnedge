//@version=5
indicator("MACD All In One Screener [ChartPrime]", max_labels_count = 500)

// DECLERATIONS {
type settings
    string view = "Overview"
    string indi = "MACD"
    int history_length = 500
    bool show_symbol = true
    bool show_price_line = true
    bool confirm = true
    string osc_type = "EMA"
    string sig_type = "EMA"
    int fast = 12
    int slow = 26
    int sig = 9
    color macd_color = #2962FF
    color signal_color = #FF6D00
    color bullish_up = #26A69A
    color bullish_down = #B2DFDB
    color bearish_down = #FF5252
    color bearish_up = #FFCDD2
    color candle_bullish = #089981
    color candle_bearish = #F23645
    int right = 10
    int left = 15
    int upper_range = 100
    int lower_range = 5
    string divergence_label = "Line and Label"
    bool enable_regular_bullish = true
    bool enable_regular_bearish = true
    color regular_bullish_color = #46C47A
    color regular_bearish_color = #F82E2E
    bool enable_table = true
    string tb_location = "Bottom Right"
    color tb_txt_col = #FFFFFF
    color tb_bg_col = #202236e6
    color tb_frame_col = #000000
    color label_color = #FFFFFF
    bool cross_over_0 = false
    bool cross_under_0 = false
    bool macd_cross_bullish = false
    bool macd_cross_bearish = false
    bool hist_bullish_turn = false
    bool hist_bearish_turn = false
    bool hist_bullish_continue = false
    bool hist_bearish_continue = false
    bool bullish_divergence = false
    bool bearish_divergence = false
    string char_set = "Symbol"

type macd_data
    float macd = na
    float sig = na
    float hist = na
    color colour = na
    string symbol = na
    string timeframe = na
    float o = na
    float h = na
    float l = na
    float c = na
    color polarity = na

type signal
    bool cross_over_0 = false
    bool cross_under_0 = false
    bool macd_cross_bullish = false
    bool macd_cross_bearish = false
    bool hist_bullish_turn = false
    bool hist_bearish_turn = false
    bool hist_bullish_continue = false
    bool hist_bearish_continue = false
    string symbol = na

type symbol_data
    bool flag = false
    string symbol = na
    string tooltip = na

type divergence_data
    bool print = false
    int t = na
    int back_t = na
    float level = na
    float back_level = na
    float tr = na
    bool polarity = na
    string tooltip = na
    color colour = na
    string symbol = na

method safe(signal self)=>
    if na(self)
        signal.new()
    else
        self

method safe(macd_data self)=>
    if na(self)
        macd_data.new()
    else
        self

method safe(symbol_data self)=>
    if na(self)
        symbol_data.new()
    else
        self

method safe(divergence_data self)=>
    if na(self)
        divergence_data.new()
    else
        self

method once(bool self)=>
    self and not nz(self[1], false)

method cell_config(table tb, int row, macd_data m_data, symbol_data s_data, settings s)=>
    tb.cell_set_text(0, row, m_data.symbol)
    tb.cell_set_text_color(0, row, s.tb_txt_col)
    tb.cell_set_text(1, row, m_data.timeframe)
    tb.cell_set_text_color(1, row, s.tb_txt_col)
    tb.cell_set_text_color(2, row, s.tb_txt_col)
    tb.cell_set_text(2, row, s_data.tooltip)
    tb.cell_set_bgcolor(3, row, m_data.colour)

location(settings s)=> 
    switch s.tb_location
        "Bottom Left" => position.bottom_left
        "Bottom Middle" => position.bottom_center
        "Bottom Right" => position.bottom_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Top Left" => position.top_left
        "Top Middle" => position.top_center
        "Top Right" => position.top_right

timeframe_type()=> 
    switch
        timeframe.isminutes => "M"
        timeframe.isseconds => "S"

symbol_size(string size)=>
    switch size
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        "Auto" => size.auto

is_same_chart_type(string chart_type)=>
    string current_type = syminfo.type
    bool same = str.contains(current_type, chart_type)
    same

timeframe_multiplier_and_period(string timeframe)=>
    int multiplier = na
    int period = na

    if timeframe == ""
        multiplier := -1
        period := -1

    else
        string[] seconds = str.split(timeframe, "S")
        string[] days = str.split(timeframe, "D")
        string[] weeks = str.split(timeframe, "W")
        string[] months = str.split(timeframe, "M")

        bool is_seconds = seconds.size() > 1
        bool is_days = days.size() > 1
        bool is_weeks = weeks.size() > 1
        bool is_months = months.size() > 1
        bool is_minutes = not is_seconds and not is_days and not is_weeks and not is_months

        if is_minutes
            multiplier := int(str.tonumber(timeframe))
            period := 1
        else if is_seconds
            multiplier := int(str.tonumber(seconds.first()))
            period := 0
        else if is_days
            multiplier := int(str.tonumber(days.first()))
            period := 2
        else if is_weeks
            multiplier := int(str.tonumber(weeks.first()))
            period := 3
        else if is_months
            multiplier := int(str.tonumber(months.first()))
            period := 4

    [multiplier, period]

chart_time_period()=>
    int period = -1
    if timeframe.isseconds
        period := 0
    else if timeframe.isminutes
        period := 1
    else if timeframe.isdaily
        period := 2
    else if timeframe.isweekly
        period := 3
    else if timeframe.ismonthly
        period := 4

    period

generate_error(string timeframe, string chart_type)=>
    bool is_same_chart_type = is_same_chart_type(chart_type)

    const string error_1 = "Timeframe multiplier must be the same or greather than chart timeframe. "
    const string error_2 = "Symbol type must match."

    bool throw_error = true
    string error_message = ""

    if not is_same_chart_type
        throw_error := true
        error_message := error_2 + " Chart Type: " + str.upper(syminfo.type) + ". " + "Symbol Type: " + str.upper(chart_type) + ". "
        [throw_error, error_message]

    else
        if timeframe == ""
            throw_error := false
            [throw_error, error_message]

        else
            int chart_time_multiplier = timeframe.multiplier
            int chart_time_period = chart_time_period()
            [multiplier, period] = timeframe_multiplier_and_period(timeframe)

            if chart_time_period < period
                throw_error := false
                [throw_error, error_message]

            else if chart_time_period > period
                throw_error := true
                error_message := error_1
                [throw_error, error_message]

            else if chart_time_period == period and chart_time_multiplier > multiplier
                throw_error := true
                error_message := error_1
                [throw_error, error_message]

            else if chart_time_period == period and chart_time_multiplier < multiplier
                throw_error := false
                [throw_error, error_message]

            else if chart_time_period == period and chart_time_multiplier == multiplier
                throw_error := false
                [throw_error, error_message]

            else if multiplier == -1
                throw_error := false
                [throw_error, error_message]

handle_errors(string[] symbol_times, string[] symbol_types)=>
    for i = 0 to 10
        string symbol_number_error_base = "Error with Symbol: "
        string symbol_number_error = ""

        if i == 0
            symbol_number_error := symbol_number_error_base + "Current"
        else
            symbol_number_error := symbol_number_error_base + str.tostring(i)

        string symbol_time = symbol_times.get(i)
        string symbol_type = symbol_types.get(i)
        [throw_error, error_message] = generate_error(symbol_time, symbol_type)

        if throw_error
            runtime.error(error_message + symbol_number_error)
            break

clwma(float source)=>
    var float sum = 0
    var int count = 0
    count += 1
    sum += source * count
    sum/count/count

in_range(bool cond, int lower_range, int upper_range) =>
    int bars = ta.barssince(cond == true)
    lower_range <= bars and bars <= upper_range

find_divergence(float macd, float hist, float h, float l, string symbol, settings s)=>
    float source_atr = clwma(math.abs(hist * 3))

    bool pl = na(ta.pivotlow(macd, s.left, s.right)) ? false : true
    bool ph = na(ta.pivothigh(macd, s.left, s.right)) ? false : true

    bool source_hl = macd[s.right] > ta.valuewhen(pl, macd[s.right], 1) and in_range(pl[1], s.lower_range, s.upper_range)
    bool price_ll = l[s.right] < ta.valuewhen(pl, l[s.right], 1)
    bool bullish_condition = price_ll and source_hl and pl
    
    bool oscLH = macd[s.right] < ta.valuewhen(ph, macd[s.right], 1) and in_range(ph[1], s.lower_range, s.upper_range)
    bool priceHH = h[s.right] > ta.valuewhen(ph, h[s.right], 1)
    bool bearish_condition = priceHH and oscLH and ph
    
    float offset = -s.right

    var float current_bullish_value = 0
    var int current_bull_idx = 0
    var float last_bullish_value = 0
    var int last_bullish_idx = 0
    var float current_bearish_value = 0
    var int current_bearish_idx = 0
    var float last_bearish_value = 0
    var int last_bearish_idx = 0

    if pl
        last_bullish_value := current_bullish_value
        last_bullish_idx := current_bull_idx
        current_bullish_value := macd[s.right]
        current_bull_idx := bar_index - s.right

    if ph
        last_bearish_value := current_bearish_value
        last_bearish_idx := current_bearish_idx
        current_bearish_value := macd[s.right]
        current_bearish_idx := bar_index - s.right

    string label_style_bullish = label.style_triangleup
    string label_style_bearish = label.style_triangledown
    string size = size.tiny

    divergence_data ret = divergence_data.new()

    if bullish_condition
        ret := divergence_data.new(true, time[s.right], time[bar_index - last_bullish_idx], current_bullish_value, last_bullish_value, source_atr, true, "Bullish", s.regular_bullish_color, symbol)

    if bearish_condition
        ret := divergence_data.new(true, time[s.right], time[bar_index - last_bearish_idx], current_bearish_value, last_bearish_value, source_atr, false, "Bearish", s.regular_bearish_color, symbol)

    ret

method divergence_alerts(divergence_data self, settings s)=>
    bool wait = (s.confirm ? barstate.isconfirmed : true)
    bool print = self.print.once() and wait

    if print
        if self.polarity
            if s.bullish_divergence
                alert(self.symbol + " " + "Bullish Divergence at " + str.format_time(self.t))
        else
            if s.bearish_divergence
                alert(self.symbol + " " + "Bearish Divergence at " + str.format_time(self.t))

method print_divergence(divergence_data self, bool ready, settings s)=>
    if ready
        if self.print
            if self.polarity
                if s.enable_regular_bullish
                    if str.contains(s.divergence_label, "Line")
                        line.new(self.back_t, self.back_level, self.t, self.level, xloc.bar_time , width = 2, color = self.colour)

                    if str.contains(s.divergence_label, "Label")
                        label.new(self.t, self.level - self.tr, xloc = xloc.bar_time, color = self.colour, style = label.style_triangleup, size = size.small, tooltip = self.tooltip)

            else
                if s.enable_regular_bearish
                    if str.contains(s.divergence_label, "Line")
                        line.new(self.back_t, self.back_level, self.t, self.level, xloc.bar_time , width = 2, color = self.colour)

                    if str.contains(s.divergence_label, "Label")
                        label.new(self.t, self.level + self.tr, xloc = xloc.bar_time, color = self.colour, style = label.style_triangledown, size = size.small, tooltip = self.tooltip)

conditional_ema(float source = close, float length = 9, bool enable = true)=>
    var float smoothed = 0
    if enable and not na(source[1])
        float alpha = 2. / (length + 1)
        smoothed := alpha * source + (1 - alpha) * nz(smoothed[1])

    else
        smoothed

conditional_sma(float source = close, int length = 9, bool enable = true)=>
    if enable and not na(source[length - 1])
        float sum = 0
        for i = 0 to length - 1
            sum += nz(source[i])

        float sma = sum / length

    else
        float(na) 

averages(float source, int length, string style)=>
    sma = conditional_sma(source, length, style == "SMA")
    ema = conditional_ema(source, length, style == "EMA")

    rtn = switch style
        "SMA" => sma
        "EMA" => ema
        => float(na)

    rtn

method signals(macd_data self, settings s, bool enable = true)=>
    bool cross_over_0 = ta.crossover(self.macd, 0) and enable
    bool cross_under_0 = ta.crossunder(self.macd, 0) and enable

    bool macd_cross_bullish = ta.crossover(self.macd, self.sig) and enable
    bool macd_cross_bearish = ta.crossunder(self.macd, self.sig) and enable

    float hist_delta = self.hist - nz(self.hist[1], 0) 

    bool hist_bullish_turn = ta.crossover(hist_delta, 0) and self.hist < 0 and enable
    bool hist_bearish_turn = ta.crossunder(hist_delta, 0) and self.hist > 0 and enable

    bool hist_bullish_continue = ta.crossover(hist_delta, 0) and self.hist > 0 and not macd_cross_bullish and enable
    bool hist_bearish_continue = ta.crossunder(hist_delta, 0) and self.hist < 0 and not macd_cross_bearish and enable

    signal signals = signal.new(cross_over_0, cross_under_0, macd_cross_bullish, macd_cross_bearish, hist_bullish_turn, hist_bearish_turn, hist_bullish_continue, hist_bearish_continue, self.symbol)


macd(settings s, string symbol, string timeframe, bool enable_signal)=>
    color polarity_color = close > open ? s.candle_bullish : s.candle_bearish
    string tf = (timeframe == "" ? timeframe.period : timeframe) + timeframe_type()

    float fast = averages(close, s.fast, s.osc_type)
    float slow = averages(close, s.slow, s.osc_type)
    float macd = fast - slow
    float sig = averages(macd, s.sig, s.osc_type)
    float hist = macd - sig

    bool hist_direction = hist > hist[1]
    bool hist_polarity = hist > 0

    color colour = hist_direction and hist_polarity ? s.bullish_up : not hist_direction and hist_polarity ? s.bullish_down : not hist_direction and not hist_polarity ? s.bearish_down : hist_direction and not hist_polarity ? s.bearish_up : na

    macd_data data = macd_data.new(macd, sig, hist, colour, symbol, tf, open, high, low, close, polarity_color)
    signal signals = data.safe().signals(s, enable_signal)
    divergence_data divergence = find_divergence(macd, hist, high, low, symbol, s)

    [data, signals, divergence]

method symbol(signal self, settings s)=>
    bool set = s.char_set == "Symbol"
    string cross_over_0_symbol = set ? "⍏" : "0U"
    string cross_under_0_symbol = set ? "⍖" : "0D"
    string hist_bearish_continue_symbol = set ? "↷" : "CD"
    string hist_bearish_turn_symbol = set ? "⭝" : "TD"
    string hist_bullish_continue_symbol = set ? "⤿" : "CU"
    string hist_bullish_turn_symbol = set ? "⭜" : "TU"
    string macd_cross_bearish_symbol = set ? "🠗" : "HD"
    string macd_cross_bullish_symbol = set ? "🠕" : "HU"

    bool wait = (s.confirm ? barstate.isconfirmed : true)

    bool cross_over_0 = self.cross_over_0.once() and wait
    bool cross_under_0 = self.cross_under_0.once() and wait
    bool hist_bearish_continue = self.hist_bearish_continue.once() and wait
    bool hist_bearish_turn = self.hist_bearish_turn.once() and wait
    bool hist_bullish_continue = self.hist_bullish_continue.once() and wait
    bool hist_bullish_turn = self.hist_bullish_turn.once() and wait
    bool macd_cross_bearish = self.macd_cross_bearish.once() and wait
    bool macd_cross_bullish = self.macd_cross_bullish.once() and wait

    bool flag = 
     ((cross_over_0 and s.cross_over_0)
     or (cross_under_0 and s.cross_under_0) 
     or (hist_bearish_continue and s.hist_bearish_continue) 
     or (hist_bearish_turn and s.hist_bearish_turn) 
     or (hist_bullish_continue and s.hist_bullish_continue) 
     or (hist_bullish_turn and s.hist_bullish_turn) 
     or (macd_cross_bearish and s.macd_cross_bearish) 
     or (macd_cross_bullish and s.macd_cross_bullish))
     and s.view == "Overview"

    string symbol = 
       cross_over_0 and s.cross_over_0 ? cross_over_0_symbol
     : cross_under_0 and s.cross_under_0 ? cross_under_0_symbol
     : hist_bearish_continue and s.hist_bearish_continue ? hist_bearish_continue_symbol
     : hist_bearish_turn and s.hist_bearish_turn ? hist_bearish_turn_symbol
     : hist_bullish_continue and s.hist_bullish_continue ? hist_bullish_continue_symbol
     : hist_bullish_turn and s.hist_bullish_turn ? hist_bullish_turn_symbol
     : macd_cross_bearish and s.macd_cross_bearish ? macd_cross_bearish_symbol
     : macd_cross_bullish and s.macd_cross_bullish ? macd_cross_bullish_symbol
     : ""

    string tooltip = 
       cross_over_0 and s.cross_over_0 ? "Cross Over 0"
     : cross_under_0 and s.cross_under_0 ? "Cross Under 0"
     : hist_bearish_continue and s.hist_bearish_continue ? "Histogram Bearish Continuation"
     : hist_bearish_turn and s.hist_bearish_turn ? "Histogram Bearish Turn"
     : hist_bullish_continue and s.hist_bullish_continue ? "Histogram Bullish Continuation" 
     : hist_bullish_turn and s.hist_bullish_turn ? "Histogram Bullish Turn" 
     : macd_cross_bearish and s.macd_cross_bearish ? "MACD Cross Bearish"
     : macd_cross_bullish and s.macd_cross_bullish ? "MACD Cross Bullish" 
     : ""

    symbol_data.new(flag, symbol, tooltip)

method signal_alert(signal self, settings s)=>
    bool wait = (s.confirm ? barstate.isconfirmed : true)

    bool cross_over_0 = self.cross_over_0.once() and wait
    bool cross_under_0 = self.cross_under_0.once() and wait
    bool hist_bearish_continue = self.hist_bearish_continue.once() and wait
    bool hist_bearish_turn = self.hist_bearish_turn.once() and wait
    bool hist_bullish_continue = self.hist_bullish_continue.once() and wait
    bool hist_bullish_turn = self.hist_bullish_turn.once() and wait
    bool macd_cross_bearish = self.macd_cross_bearish.once() and wait
    bool macd_cross_bullish = self.macd_cross_bullish.once() and wait

    if cross_over_0 and s.cross_over_0
        alert(self.symbol + " " + "Cross Over 0", alert.freq_all)

    if cross_under_0 and s.cross_under_0
        alert(self.symbol + " " + "Cross Under 0", alert.freq_all)

    if macd_cross_bullish and s.macd_cross_bullish
        alert(self.symbol + " " + "MACD Cross Bullish", alert.freq_all)

    if macd_cross_bearish and s.macd_cross_bearish
        alert(self.symbol + " " + "MACD Cross Bearish", alert.freq_all)

    if hist_bullish_turn and s.hist_bullish_turn
        alert(self.symbol + " " + "Histogram Bullish Turn", alert.freq_all)

    if hist_bearish_turn and s.hist_bearish_turn
        alert(self.symbol + " " + "Histogram Bearish Turn", alert.freq_all)

    if hist_bullish_continue and s.hist_bullish_continue
        alert(self.symbol + " " + "Histogram Bullish Continuation", alert.freq_all)

    if hist_bearish_continue and s.hist_bearish_continue
        alert(self.symbol + " " + "Histogram Bearish Continuation", alert.freq_all)

safe_request(simple string symbol, simple string timeframe, bool enable, simple int history_length, bool ERROR_BYPASS, settings s)=>
    macd_data data_na = macd_data.new()
    signal signal_na = signal.new()
    divergence_data divergence_na = divergence_data.new()

    simple string safe_symbol = ticker.modify(symbol, syminfo.session)

    [data, signal_data, divergence] = request.security(safe_symbol, timeframe, macd(s, ticker.standard(symbol), timeframe, enable), barmerge.gaps_off, barmerge.lookahead_on, false, calc_bars_count = history_length)

    if ERROR_BYPASS
        if enable
            [data.safe(), signal_data.safe(), divergence.safe()]
        else
            [data_na, signal_na, divergence_na]

    else
        [data.safe(), signal_data.safe(), divergence.safe()]
// }

// INPUTS {
const string group_1 = "View"
const string view_tip = "Select what symbol you want to view. If you select Overview it will show all of the signals over time."
const string indi_tip = "Toggle between looking at the MACD and the price of the current symbol as a candle chart. This allows you to monitor your symbols without changing your chart. You can add indicators to the price action by adding an indicator to this indicator. Just pick one of the price options."
const string history_length_tip = "This is the number of historical bars to present. This feature is here to prevent the indicator from breaking due to uneven historical data between the symbols."
const string show_price_line_tip = "Toggle the current closeing price line for Price view."
const string show_symbol_tip = "Display the current symbol you are viewing beside the MACD or Price."
const string label_color_tip = "Adjust the color of the symbol lables. This effects both overview and single view."

string view = input.string("Overview", "View", ["Current", "Symbol 1", "Symbol 2", "Symbol 3", "Symbol 4", "Symbol 5", "Symbol 6", "Symbol 7", "Symbol 8", "Symbol 9", "Symbol 10", "Overview", "None"], view_tip, group = group_1)
string indi = input.string("MACD", "View Toggle", ["MACD", "Price"], tooltip = indi_tip, group = group_1)
int history_length = input.int(3000, "History Length", minval = 0, maxval = 5000, tooltip = history_length_tip, group = group_1)
bool show_price_line = input.bool(true, "Show Price Line", show_price_line_tip, group = group_1)
bool show_symbol = input.bool(true, "Show Symbol Label", show_symbol_tip, group = group_1)
color label_color = input.color(#FFFFFF, "Overview Label Color", label_color_tip, group = group_1)

const string group_2 = "MACD Settings"
const string osc_type_tip = "Pick what average you want to use for the MACD oscillator. SMA is simple moving average while EMA is exponential moving average."
const string sig_type_tip = "Pick what average you want to use for the MACD signal. SMA is simple moving average while EMA is exponential moving average."
const string fast_tip = "Adjust the moving average period fast length."
const string slow_tip = "Adjust the moving average period slow length."
const string sig_tip = "Adjust the moving average period signal length."
const string overlay_cross_icon_tip = "Toggle MACD cross icons in single view mode. This will print a dot when the MACD crosses."

string osc_type = input.string("EMA", "Oscillator MA Type", ["SMA", "EMA"], tooltip = osc_type_tip, group = group_2)
string sig_type = input.string("EMA", "Signal Line MA Type", ["SMA", "EMA"], tooltip = sig_type_tip, group = group_2)
int fast = input.int(12, "Fast Length", tooltip = fast_tip, minval = 1, group = group_2)
int slow = input.int(26, "Slow Length", tooltip = slow_tip, minval = 1, group = group_2)
int sig = input.int(9, "Signal Length", tooltip = sig_tip, minval = 1, group = group_2)
bool overlay_cross_icon = input.bool(true, "MACD Cross Overlay Icon", overlay_cross_icon_tip, group = group_2)

const string group_3 = "MACD Divergence"
const string enable_regular_bullish_tip = "Show bullish divergences on single view mode. This will not effect alerts."
const string enable_regular_bearish_tip = "Show bearish divergences on single view mode. This will not effect alerts."
const string right_tip = "Adjust the number of bars into the future to look for confirmation of a signal. This directly impacts lag but enhances stability."
const string left_tip = "Adjust the number of bars into the past to check for a signal. A longer period will filter out smaller moves."
const string upper_range_tip = "Adjust the maximum size of a divergence."
const string lower_range_tip = "Adjust the minimum size of a divergence."
