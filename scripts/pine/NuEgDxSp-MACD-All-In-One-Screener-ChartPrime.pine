macd_data view_data = switch s.view
    "Current"  => data_0
    "Symbol 1" => data_1
    "Symbol 2" => data_2
    "Symbol 3" => data_3
    "Symbol 4" => data_4
    "Symbol 5" => data_5
    "Symbol 6" => data_6
    "Symbol 7" => data_7
    "Symbol 8" => data_8
    "Symbol 9" => data_9
    "Symbol 10" => data_10
    => macd_data.new()

