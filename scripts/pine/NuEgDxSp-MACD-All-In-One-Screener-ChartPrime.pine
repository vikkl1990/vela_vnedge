            title_10.set_x(bar_index)
    
    string size = symbol_size(symbol_size)
    
    if symbol_signal_0.flag
        label.new(bar_index, 40, symbol_signal_0.symbol, color = alpha, textcolor = data_0.colour, size = size, style = label.style_label_center, tooltip = symbol_signal_0.tooltip)
    
    if symbol_signal_1.flag
        label.new(bar_index, 36, symbol_signal_1.symbol, color = alpha, textcolor = data_1.colour, size = size, style = label.style_label_center, tooltip = symbol_signal_1.tooltip)
    
