if ready
    if s.view != "Overview" and s.show_symbol
        float y = plot_macd ? 0 : view_data.o
        var label tickerid = label.new(bar_index, y, view_data.symbol + "\n" + view_data.timeframe, color = alpha, size = size.normal, style = label.style_label_left, textcolor = s.label_color)
        tickerid.set_xy(bar_index, y)
    
    if s.view == "Overview"
        if current_alert
            var label title_0  = label.new(bar_index, 40, data_0.symbol, color = alpha, size = size.normal, style = label.style_label_left, textcolor = s.label_color)
            title_0.set_x(bar_index)
    
        if symbol_1_alert
            var label title_1  = label.new(bar_index, 36, data_1.symbol, color = alpha, size = size.normal, style = label.style_label_left, textcolor = s.label_color)
            title_1.set_x(bar_index)
    
        if symbol_2_alert
            var label title_2  = label.new(bar_index, 32, data_2.symbol, color = alpha, size = size.normal, style = label.style_label_left, textcolor = s.label_color)
