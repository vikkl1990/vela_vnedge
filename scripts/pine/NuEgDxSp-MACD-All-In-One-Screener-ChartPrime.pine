        label.new(bar_index, 16, symbol_signal_6.symbol, color = alpha, textcolor = data_6.colour, size = size, style = label.style_label_center, tooltip = symbol_signal_6.tooltip)
    
    if symbol_signal_7.flag
        label.new(bar_index, 12, symbol_signal_7.symbol, color = alpha, textcolor = data_7.colour, size = size, style = label.style_label_center, tooltip = symbol_signal_7.tooltip)
    
    if symbol_signal_8.flag
        label.new(bar_index, 8, symbol_signal_8.symbol, color = alpha, textcolor = data_8.colour, size = size, style = label.style_label_center, tooltip = symbol_signal_8.tooltip)
    
    if symbol_signal_9.flag
        label.new(bar_index, 4, symbol_signal_9.symbol, color = alpha, textcolor = data_9.colour, size = size, style = label.style_label_center, tooltip = symbol_signal_9.tooltip)
    
    if symbol_signal_10.flag
        label.new(bar_index, 0, symbol_signal_10.symbol, color = alpha, textcolor = data_10.colour, size = size, style = label.style_label_center, tooltip = symbol_signal_10.tooltip)
    
    table tb = table.new(location(s), 5, 12, s.tb_bg_col, s.tb_frame_col, border_color = s.tb_frame_col, border_width = 1, frame_width = 2)
    
    if s.enable_table
        if current_alert
            tb.cell_config(0, data_0, symbol_signal_0, s)
    
        if symbol_1_alert
            tb.cell_config(1, data_1, symbol_signal_1, s)
    
        if symbol_2_alert
            tb.cell_config(2, data_2, symbol_signal_2, s)
    
        if symbol_3_alert
            tb.cell_config(3, data_3, symbol_signal_3, s)
    
        if symbol_4_alert
            tb.cell_config(4, data_4, symbol_signal_4, s)
    
        if symbol_5_alert
            tb.cell_config(5, data_5, symbol_signal_5, s)
    
        if symbol_6_alert
            tb.cell_config(6, data_6, symbol_signal_6, s)
    
        if symbol_7_alert
            tb.cell_config(7, data_7, symbol_signal_7, s)
    
        if symbol_8_alert
            tb.cell_config(8, data_8, symbol_signal_8, s)
    
        if symbol_9_alert
            tb.cell_config(9, data_9, symbol_signal_9, s)
    
        if symbol_10_alert
            tb.cell_config(10, data_10, symbol_signal_10, s)
    
    if plot_candle and s.show_price_line
        var line price_line = line.new(bar_index, view_data.c, bar_index, view_data.c, color = view_data.polarity, style = line.style_dotted, extend = extend.both)
        price_line.set_xy1(bar_index - 1, view_data.c)
        price_line.set_xy2(bar_index, view_data.c)
        price_line.set_color(view_data.polarity)

plot(current_alert and view == "Overview" ? 40 : na, "Current Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_1_alert and view == "Overview" ? 36 : na, "Symbole 1 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_2_alert and view == "Overview" ? 32 : na, "Symbole 2 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_3_alert and view == "Overview" ? 28 : na, "Symbole 3 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_4_alert and view == "Overview" ? 24 : na, "Symbole 4 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_5_alert and view == "Overview" ? 20 : na, "Symbole 5 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_6_alert and view == "Overview" ? 16 : na, "Symbole 6 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_7_alert and view == "Overview" ? 12 : na, "Symbole 7 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_8_alert and view == "Overview" ? 8 : na, "Symbole 8 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_9_alert and view == "Overview" ? 4 : na, "Symbole 9 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)
plot(symbol_10_alert and view == "Overview" ? 0 : na, "Symbole 10 Overview Line", overview_line_color, 1, display = display.all - display.price_scale, editable = false, show_last = history_length)

plot(plot_candle ? view_data.c : na, "Close", alpha, display = display.data_window, editable = false)
plot(plot_candle ? view_data.o : na, "Open", alpha, display = display.data_window, editable = false)
plot(plot_candle ? view_data.h : na, "High", alpha, display = display.data_window, editable = false)
plot(plot_candle ? view_data.l : na, "Low", alpha, display = display.data_window, editable = false)
plot(plot_candle ? math.avg(view_data.h, view_data.l) : na, "HL2", alpha, display = display.data_window, editable = false)
plot(plot_candle ? math.avg(view_data.h, view_data.l, view_data.c) : na, "HLC3", alpha, display = display.data_window, editable = false)
plot(plot_candle ? math.avg(view_data.o, view_data.h, view_data.l, view_data.c) : na, "OHLC4", alpha, display = display.data_window, editable = false)
plot(plot_candle ? math.avg(view_data.h, view_data.l, view_data.c, view_data.c) : na, "HLCC4", alpha, display = display.data_window, editable = false)

plot(plot_macd ? view_data.hist : na, "Histogram", view_data.colour, style = plot.style_columns, editable = false)
plot(plot_macd ? view_data.sig : na, "Signal", s.signal_color, editable = false)
plot(plot_macd ? view_data.macd : na, "MACD", s.macd_color, editable = false)

plotshape(plot_macd and view_signal.macd_cross_bullish.once() and overlay_cross_icon ? view_data.macd : na, "Cross Over Icon", shape.circle, location.absolute, icon_up, size = size.tiny, editable = false)
plotshape(plot_macd and view_signal.macd_cross_bearish.once() and overlay_cross_icon ? view_data.macd : na, "Cross Over Icon", shape.circle, location.absolute, icon_down, size = size.tiny, editable = false)

view_divergence.print_divergence(ready and plot_macd, s)

plotcandle(plot_candle ? view_data.o : na, plot_candle ? view_data.h : na, plot_candle ? view_data.l : na, plot_candle ? view_data.c : na, "Chart", view_data.polarity, view_data.polarity, bordercolor = view_data.polarity, editable = false)
