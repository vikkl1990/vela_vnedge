//@version=6
indicator("Rare Candlestick Formations", shorttitle = "Rare Candlestick Formations", overlay = true, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86
HIDDEN_COLOR  = #00000000

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

TREND_GROUP     = 'Trend Context'
DETECTION_GROUP = 'Detection Thresholds'
CATALOG_GROUP   = 'Formation Catalog'
DASH_GROUP      = 'Dashboard'
STYLE_GROUP     = 'Style'

// Total number of directional signals tracked by the screener (dashboard rows)
N_SIGNALS = 21

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
trendRuleInput = input.string('EMA', 'Prior Trend Rule', options = ['EMA', 'SMA', 'None'], group = TREND_GROUP, tooltip = 'Almost every formation in the rare catalog is defined relative to an existing advance or decline, so a textbook candle sequence without the required context does not qualify. Close above the moving average marks an advance, below marks a decline, evaluated at the formation\'s first candle. None disables the context check.')

trendLengthInput = input.int(10, 'Trend Length', minval = 1, group = TREND_GROUP, tooltip = 'Moving average length for the prior-trend rule. The 10-period exponential average is the classical screener convention for the short-term trend.')

bodyAvgLengthInput = input.int(14, 'Body Average Length', minval = 1, group = DETECTION_GROUP, tooltip = 'Lookback for the average candle body. Long and small body conditions are measured against this average, so classifications adapt to each market\'s volatility.')

longBodyInput = input.float(1.0, 'Long Body ×', minval = 0.1, step = 0.05, group = DETECTION_GROUP, tooltip = 'A body counts as long when it exceeds the recent average body times this factor. Used wherever a definition calls for a long or tall candle.')

smallBodyInput = input.float(0.5, 'Small Body ×', minval = 0.05, maxval = 1, step = 0.05, group = DETECTION_GROUP, tooltip = 'A body counts as small when it is below the recent average body times this factor. Used wherever a definition calls for a short candle, such as the deliberation\'s third candle.')

longShadowInput = input.float(0.5, 'Long Shadow ×', minval = 0.05, step = 0.05, group = DETECTION_GROUP, tooltip = 'Minimum shadow length as a multiple of the candle body for long-shadow conditions: the first candle of three stars in the south and the fourth candle of the ladder top/bottom.')

marubozuTolInput = input.float(5, 'Marubozu Shadow Tolerance %', minval = 0, maxval = 50, step = 0.5, group = DETECTION_GROUP, tooltip = 'Maximum shadow size as a percentage of the body for a candle to count as a marubozu, required by three stars in the south (third candle) and the concealing baby swallow (first two candles).')

matchTolInput = input.float(10, 'Price Match Tolerance % ATR', minval = 0, maxval = 100, step = 1, group = DETECTION_GROUP, tooltip = 'Tolerance for equal-price conditions - the matching closes of counterattack lines and the stick sandwich, and the matching opens of separating lines - expressed as a percentage of the 14-period ATR. Side-by-side white lines similarity checks use twice this tolerance. Near-misses are how most misidentifications happen, so keep this tight.')

confirmInput = input.bool(false, 'Require Confirmation Close', group = DETECTION_GROUP, tooltip = 'Classical sources generally want the next candle to close beyond the formation\'s extreme before the pattern counts. When enabled, labels and alerts fire on that confirming close - one bar after the formation completes - and unconfirmed prints are discarded. New price lines warnings are count-based and exempt.')

recordLinesInput = input.int(8, 'New Price Lines Count', minval = 3, maxval = 20, group = DETECTION_GROUP, tooltip = 'Number of consecutive record sessions - higher highs in an advance or lower lows in a decline - that triggers the exhaustion warning. Japanese charting classically watches for 8-10 new price lines.')

advanceBlockInput = input.bool(true, 'Advance Block', group = CATALOG_GROUP, tooltip = 'Bearish warning in an advance: three white candles with higher closes, each opening within the prior body, with shrinking bodies and upper shadows longer than the first candle\'s - an advance running out of force.')

deliberationInput = input.bool(true, 'Deliberation', group = CATALOG_GROUP, tooltip = 'Bearish warning in an advance (stalled pattern): two long white candles with higher closes, then a small white body opening at or near the second close - buyers hesitating after the run.')

threeStarsSouthInput = input.bool(true, 'Three Stars in the South', group = CATALOG_GROUP, tooltip = 'Bullish reversal in a decline: a long black candle with a long lower shadow, a smaller black candle holding a higher low, then a small black marubozu inside the prior candle\'s range - downside probes failing, selling pressure ebbing.')

threeRiverInput = input.bool(true, 'Unique Three-River Bottom', group = CATALOG_GROUP, tooltip = 'Bullish reversal in a decline: a long black candle, a black harami whose lower shadow prints a new low, then a small white candle closing below the second candle\'s close.')

concealingInput = input.bool(true, 'Concealing Baby Swallow', group = CATALOG_GROUP, tooltip = 'Bullish reversal in a decline: two long black marubozu, a black candle gapping down at the open whose upper shadow trades back into the prior body, then a black candle engulfing it entirely, shadows included. Requires true opening gaps, so it effectively exists only in markets that close between sessions - among the rarest patterns on record.')

sideBySideInput = input.bool(true, 'Side-by-Side White Lines', group = CATALOG_GROUP, tooltip = 'Continuation: two similar white candles with near-equal opens sitting side by side beyond a body gap - above the gap after a white candle (bullish), below the gap after a black candle (bearish) - with the gap left unfilled. Gap-dependent, so effectively a daily-chart pattern.')

separatingInput = input.bool(true, 'Separating Lines', group = CATALOG_GROUP, tooltip = 'Continuation: two long opposite-colored candles sharing the same open. In an advance, a black candle then a white candle re-opening at that price and rallying (bullish); mirrored in a decline (bearish).')

counterattackInput = input.bool(true, 'Counterattack Lines', group = CATALOG_GROUP, tooltip = 'Reversal (meeting lines): a long candle in the trend direction, then a long opposite-colored candle opening sharply beyond the prior close yet closing exactly back at it. The matching-close requirement is the strict condition that turns an ordinary color clash into a rarity.')

stickSandwichInput = input.bool(true, 'Stick Sandwich', group = CATALOG_GROUP, tooltip = 'Bullish reversal in a decline: a black candle, a white candle closing above its close, then a black candle opening above the white close but closing level with the first close - two matching closes sandwiching the white candle.')

homingPigeonInput = input.bool(true, 'Homing Pigeon', group = CATALOG_GROUP, tooltip = 'Bullish warning in a decline: a long black candle, then a smaller black candle whose body sits entirely inside the prior body - a harami built from two bearish candles, telling the same stalling story.')

descendingHawkInput = input.bool(true, 'Descending Hawk', group = CATALOG_GROUP, tooltip = 'Bearish counterpart of the homing pigeon in an advance: a long white candle, then a smaller white candle whose body sits entirely inside the prior body.')

ladderInput = input.bool(true, 'Ladder Bottom / Ladder Top', group = CATALOG_GROUP, tooltip = 'Five-candle reversal. Ladder bottom: three long black candles with consecutively lower opens and closes, a black candle with a long upper shadow, then a white candle opening above the prior body. Ladder top is the mirror image ending an advance.')

upsideGapCrowsInput = input.bool(true, 'Upside Gap Two Crows', group = CATALOG_GROUP, tooltip = 'Bearish reversal in an advance: a long white candle, a black candle whose body gaps above it, then a black candle engulfing that body while still closing above the white close. Needs a true upside gap, so it effectively exists only on charts with session closes.')

threeLineStrikeInput = input.bool(true, 'Three-Line Strike', group = CATALOG_GROUP, tooltip = 'Continuation: three candles in one direction with progressive closes (soldier/crow structure), then a fourth opening beyond the third close and reversing through all three bodies. Classically filed as continuation in the direction of the first three candles, though published tests disagree on how it resolves.')

newPriceLinesInput = input.bool(true, 'New Price Lines (8-10 Records)', group = CATALOG_GROUP, tooltip = 'Exhaustion warning after a run of record sessions: the set number of consecutive higher highs warns an advance is overextended (bearish), consecutive lower lows warn a decline is overextended (bullish).')

showDashboardInput = input.bool(true, 'Show Dashboard', group = DASH_GROUP, tooltip = 'Full-catalog screener summary: how many times each formation printed on the chart, so nothing slips past while the context judgment stays with the trader.')

hideEmptyInput = input.bool(true, 'Hide Empty Rows', group = DASH_GROUP, tooltip = 'Only list formations that have printed at least once on the chart. Disable to display the whole catalog being watched, including zero counts.')

dashPositionInput = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = DASH_GROUP, tooltip = 'Chart corner where the dashboard is anchored.')

dashSizeInput = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal'], group = DASH_GROUP, tooltip = 'Dashboard text size.')

bullColorInput = input.color(BULL_COLOR, 'Bullish', inline = 'colors', group = STYLE_GROUP, tooltip = 'Color of bullish formation labels and dashboard rows.')

bearColorInput = input.color(BEAR_COLOR, 'Bearish', inline = 'colors', group = STYLE_GROUP, tooltip = 'Color of bearish formation labels and dashboard rows.')

labelSizeInput = input.string('Small', 'Label Size', options = ['Tiny', 'Small', 'Normal'], group = STYLE_GROUP, tooltip = 'Text size of the formation labels drawn on the chart.')

showTrendMaInput = input.bool(false, 'Show Trend MA', group = STYLE_GROUP, tooltip = 'Plot the moving average used for the prior-trend context, useful when judging the trend stage a formation printed in.')

trendMaColorInput = input.color(color.new(NEUTRAL_COLOR, 30), 'Trend MA Color', group = STYLE_GROUP, tooltip = 'Color of the trend moving average plot.')

//---------------------------------------------------------------------------------------------------------------------}
// Candle Anatomy
//---------------------------------------------------------------------------------------------------------------------{
bodySize = math.abs(close - open)
bodyAvg  = ta.sma(bodySize, bodyAvgLengthInput)
atrValue = ta.atr(14)

matchTolerance   = atrValue * matchTolInput / 100
similarTolerance = matchTolerance * 2

smaTrend = ta.sma(close, trendLengthInput)
emaTrend = ta.ema(close, trendLengthInput)
trendMa  = trendRuleInput == 'SMA' ? smaTrend : emaTrend

confirmOffset = confirmInput ? 1 : 0

// Formation extremes over the last 2..5 candles, used for confirmation closes and label anchors
high2 = math.max(high, high[1])
low2  = math.min(low, low[1])
high3 = math.max(high2, high[2])
low3  = math.min(low2, low[2])
high4 = math.max(high3, high[3])
low4  = math.min(low3, low[3])
high5 = math.max(high4, high[4])
low5  = math.min(low4, low[4])

// Anatomy helpers, all reading offsets of globally maintained series
isWhite(int o) => close[o] > open[o]
isBlack(int o) => close[o] < open[o]
bodyTop(int o) => math.max(open[o], close[o])
bodyBot(int o) => math.min(open[o], close[o])
bodyOf(int o)  => math.abs(close[o] - open[o])

upperShadow(int o) => high[o] - bodyTop(o)
lowerShadow(int o) => bodyBot(o) - low[o]

isLong(int o)  => bodyOf(o) > bodyAvg[o] * longBodyInput
isSmall(int o) => bodyOf(o) < bodyAvg[o] * smallBodyInput

isMarubozu(int o) => bodyOf(o) > 0 and upperShadow(o) <= bodyOf(o) * marubozuTolInput / 100 and lowerShadow(o) <= bodyOf(o) * marubozuTolInput / 100

priceMatch(float a, float b) => math.abs(a - b) <= matchTolerance

// Prior-trend context, evaluated at the formation's first candle
inUptrend(int o)   => trendRuleInput == 'None' or close[o] > trendMa[o]
inDowntrend(int o) => trendRuleInput == 'None' or close[o] < trendMa[o]

//---------------------------------------------------------------------------------------------------------------------}
// Formation Detection
//---------------------------------------------------------------------------------------------------------------------{
// Advance block - three white candles with higher closes, each opening within the prior body,
// bodies shrinking and upper shadows lengthening beyond the first candle's
advanceBlockRaw = advanceBlockInput and inUptrend(2) and isWhite(2) and isWhite(1) and isWhite(0) and isLong(2) and
  close[1] > close[2] and close > close[1] and
  open[1] > open[2] and open[1] < close[2] and
  open > open[1] and open < close[1] and
  bodyOf(1) < bodyOf(2) and bodyOf(0) < bodyOf(1) and
  upperShadow(1) > upperShadow(2) and upperShadow(0) > upperShadow(2)

// Deliberation (stalled) - two long white candles then a small white body opening at or near the second close
deliberationRaw = deliberationInput and inUptrend(2) and isWhite(2) and isWhite(1) and isWhite(0) and
  isLong(2) and isLong(1) and isSmall(0) and
  close[1] > close[2] and close > close[1] and
  open >= close[1] - matchTolerance

// Three stars in the south - long black candle with long lower shadow, smaller black candle with a higher low,
// then a small black marubozu inside the prior candle's range
threeStarsSouthRaw = threeStarsSouthInput and inDowntrend(2) and isBlack(2) and isBlack(1) and isBlack(0) and
  isLong(2) and lowerShadow(2) >= bodyOf(2) * longShadowInput and
  bodyOf(1) < bodyOf(2) and low[1] > low[2] and lowerShadow(1) > 0 and
  isMarubozu(0) and bodyOf(0) < bodyOf(1) and high <= high[1] and low >= low[1]

// Unique three-river bottom - long black candle, black harami whose lower shadow makes a new low,
// then a small white candle closing below the second close
threeRiverRaw = threeRiverInput and inDowntrend(2) and isBlack(2) and isLong(2) and
  isBlack(1) and open[1] <= open[2] and close[1] >= close[2] and low[1] < low[2] and
  isWhite(0) and isSmall(0) and close < close[1]

// Concealing baby swallow - two long black marubozu, a black candle gapping down whose upper shadow
// trades back into the prior body, then a black candle engulfing it entirely including the shadows
concealingRaw = concealingInput and inDowntrend(3) and
  isBlack(3) and isBlack(2) and isBlack(1) and isBlack(0) and
  isLong(3) and isLong(2) and isMarubozu(3) and isMarubozu(2) and
  close[2] < close[3] and
  open[1] < close[2] and high[1] > close[2] and
  open >= high[1] and close <= low[1]

// Side-by-side white lines - two similar white candles with near-equal opens beyond a body gap that stays unfilled
sideBySideBullRaw = sideBySideInput and inUptrend(2) and isWhite(2) and isWhite(1) and isWhite(0) and
  bodyBot(1) > bodyTop(2) and
  math.abs(open - open[1]) <= similarTolerance and
  math.abs(bodyOf(0) - bodyOf(1)) <= similarTolerance and
  bodyBot(0) > bodyTop(2)

sideBySideBearRaw = sideBySideInput and inDowntrend(2) and isBlack(2) and isWhite(1) and isWhite(0) and
  bodyTop(1) < bodyBot(2) and
  math.abs(open - open[1]) <= similarTolerance and
  math.abs(bodyOf(0) - bodyOf(1)) <= similarTolerance and
  bodyTop(0) < bodyBot(2)

// Separating lines - two long opposite-colored candles sharing the same open, resuming the trend
separatingBullRaw = separatingInput and inUptrend(1) and isBlack(1) and isWhite(0) and
  isLong(1) and isLong(0) and priceMatch(open, open[1])

separatingBearRaw = separatingInput and inDowntrend(1) and isWhite(1) and isBlack(0) and
  isLong(1) and isLong(0) and priceMatch(open, open[1])

// Counterattack (meeting) lines - long trend candle, then a long opposite candle opening beyond
// the prior close and closing exactly back at it
counterattackBullRaw = counterattackInput and inDowntrend(1) and isBlack(1) and isWhite(0) and
  isLong(1) and isLong(0) and open < close[1] and priceMatch(close, close[1])

counterattackBearRaw = counterattackInput and inUptrend(1) and isWhite(1) and isBlack(0) and
  isLong(1) and isLong(0) and open > close[1] and priceMatch(close, close[1])

// Stick sandwich - black candle, white candle closing above it, black candle closing level with the first close
stickSandwichRaw = stickSandwichInput and inDowntrend(2) and isBlack(2) and isWhite(1) and isBlack(0) and
  close[1] > close[2] and open > close[1] and priceMatch(close, close[2])

// Homing pigeon - long black candle, then a smaller black body entirely inside the prior body
homingPigeonRaw = homingPigeonInput and inDowntrend(1) and isBlack(1) and isBlack(0) and isLong(1) and
  open <= open[1] and close >= close[1] and bodyOf(0) < bodyOf(1)

// Descending hawk - long white candle, then a smaller white body entirely inside the prior body
descendingHawkRaw = descendingHawkInput and inUptrend(1) and isWhite(1) and isWhite(0) and isLong(1) and
  open >= open[1] and close <= close[1] and bodyOf(0) < bodyOf(1)

// Ladder bottom - three long black candles stepping lower, a black candle with a long upper shadow,
// then a white candle opening above the prior body
ladderBottomRaw = ladderInput and inDowntrend(4) and
  isBlack(4) and isBlack(3) and isBlack(2) and isBlack(1) and isWhite(0) and
  isLong(4) and isLong(3) and isLong(2) and
  open[3] < open[4] and open[2] < open[3] and
  close[3] < close[4] and close[2] < close[3] and
  upperShadow(1) >= bodyOf(1) * longShadowInput and
  open > open[1]

// Ladder top - mirror image ending an advance
ladderTopRaw = ladderInput and inUptrend(4) and
  isWhite(4) and isWhite(3) and isWhite(2) and isWhite(1) and isBlack(0) and
  isLong(4) and isLong(3) and isLong(2) and
  open[3] > open[4] and open[2] > open[3] and
  close[3] > close[4] and close[2] > close[3] and
  lowerShadow(1) >= bodyOf(1) * longShadowInput and
  open < open[1]

// Upside gap two crows - long white candle, black candle body-gapping above it, then a black candle
// engulfing that body while still closing above the white close
upsideGapCrowsRaw = upsideGapCrowsInput and inUptrend(2) and isWhite(2) and isLong(2) and isBlack(1) and isBlack(0) and
  close[1] > close[2] and
  open > open[1] and close < close[1] and close > close[2]

// Three-line strike - three progressive candles (soldier/crow structure), then a fourth opening beyond
// the third close and reversing through all three bodies
threeLineBullRaw = threeLineStrikeInput and inUptrend(3) and
  isWhite(3) and isWhite(2) and isWhite(1) and isBlack(0) and
  close[2] > close[3] and close[1] > close[2] and
  open[2] > open[3] and open[2] < close[3] and
  open[1] > open[2] and open[1] < close[2] and
  open > close[1] and close < open[3]

threeLineBearRaw = threeLineStrikeInput and inDowntrend(3) and
  isBlack(3) and isBlack(2) and isBlack(1) and isWhite(0) and
  close[2] < close[3] and close[1] < close[2] and
  open[2] < open[3] and open[2] > close[3] and
  open[1] < open[2] and open[1] > close[2] and
  open < close[1] and close > open[3]

// New price lines - consecutive record sessions; reaching the set count warns of exhaustion
var int recordHighStreak = 0
var int recordLowStreak  = 0
recordHighStreak := na(high[1]) ? 0 : high > high[1] ? recordHighStreak + 1 : 0
recordLowStreak  := na(low[1])  ? 0 : low  < low[1]  ? recordLowStreak  + 1 : 0

newHighLinesRaw = newPriceLinesInput and recordHighStreak == recordLinesInput
newLowLinesRaw  = newPriceLinesInput and recordLowStreak  == recordLinesInput

//---------------------------------------------------------------------------------------------------------------------}
// Confirmation & Signals
//---------------------------------------------------------------------------------------------------------------------{
// Optional classical filter: the candle after the formation must close beyond the formation's extreme.
// With the filter on, signals fire on the confirming close (one bar after completion).
confirmed(bool raw, bool isBull, float formationHigh, float formationLow) =>
    confirmInput ? raw[1] and (isBull ? close > formationHigh[1] : close < formationLow[1]) : raw

advanceBlockSignal      = confirmed(advanceBlockRaw, false, high3, low3)
deliberationSignal      = confirmed(deliberationRaw, false, high3, low3)
threeStarsSouthSignal   = confirmed(threeStarsSouthRaw, true, high3, low3)
threeRiverSignal        = confirmed(threeRiverRaw, true, high3, low3)
concealingSignal        = confirmed(concealingRaw, true, high4, low4)
sideBySideBullSignal    = confirmed(sideBySideBullRaw, true, high3, low3)
sideBySideBearSignal    = confirmed(sideBySideBearRaw, false, high3, low3)
separatingBullSignal    = confirmed(separatingBullRaw, true, high2, low2)
separatingBearSignal    = confirmed(separatingBearRaw, false, high2, low2)
counterattackBullSignal = confirmed(counterattackBullRaw, true, high2, low2)
counterattackBearSignal = confirmed(counterattackBearRaw, false, high2, low2)
stickSandwichSignal     = confirmed(stickSandwichRaw, true, high3, low3)
homingPigeonSignal      = confirmed(homingPigeonRaw, true, high2, low2)
descendingHawkSignal    = confirmed(descendingHawkRaw, false, high2, low2)
ladderBottomSignal      = confirmed(ladderBottomRaw, true, high5, low5)
ladderTopSignal         = confirmed(ladderTopRaw, false, high5, low5)
upsideGapCrowsSignal    = confirmed(upsideGapCrowsRaw, false, high3, low3)
threeLineBullSignal     = confirmed(threeLineBullRaw, true, high4, low4)
threeLineBearSignal     = confirmed(threeLineBearRaw, false, high4, low4)
newHighLinesSignal      = newHighLinesRaw
newLowLinesSignal       = newLowLinesRaw

anyBullishSignal = threeStarsSouthSignal or threeRiverSignal or concealingSignal or sideBySideBullSignal or
  separatingBullSignal or counterattackBullSignal or stickSandwichSignal or homingPigeonSignal or
  ladderBottomSignal or threeLineBullSignal or newLowLinesSignal

anyBearishSignal = advanceBlockSignal or deliberationSignal or sideBySideBearSignal or separatingBearSignal or
  counterattackBearSignal or descendingHawkSignal or ladderTopSignal or upsideGapCrowsSignal or
  threeLineBearSignal or newHighLinesSignal

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
labelSize = switch labelSizeInput
    'Tiny'   => size.tiny
    'Normal' => size.normal
    =>          size.small

var countsArray   = array.new_int(N_SIGNALS, 0)
var namesArray    = array.from('Advance Block', 'Deliberation', 'Three Stars in the South', 'Unique Three-River Bottom',
  'Concealing Baby Swallow', 'Side-by-Side White Lines (Bull)', 'Side-by-Side White Lines (Bear)',
  'Separating Lines (Bull)', 'Separating Lines (Bear)', 'Counterattack Lines (Bull)', 'Counterattack Lines (Bear)',
  'Stick Sandwich', 'Homing Pigeon', 'Descending Hawk', 'Ladder Bottom', 'Ladder Top', 'Upside Gap Two Crows',
  'Three-Line Strike (Bull)', 'Three-Line Strike (Bear)', 'New Price Lines (Highs)', 'New Price Lines (Lows)')
var bullFlagArray = array.from(false, false, true, true, true, true, false, true, false, true, false, true, true,
  false, true, false, false, true, false, false, true)

recordLinesText = str.tostring(recordLinesInput) + ' New\nPrice Lines'

// Draws the formation label on the completion bar (one bar back when the confirmation filter is on)
// and accumulates the dashboard count
markSignal(bool signal, bool isBull, float formationHigh, float formationLow, int barsBack, string labelText, int countIndex) =>
    if signal
        label.new(bar_index - barsBack, isBull ? formationLow[barsBack] : formationHigh[barsBack], labelText,
          color = HIDDEN_COLOR, textcolor = isBull ? bullColorInput : bearColorInput,
          style = isBull ? label.style_label_up : label.style_label_down, size = labelSize)
        array.set(countsArray, countIndex, array.get(countsArray, countIndex) + 1)

markSignal(advanceBlockSignal, false, high3, low3, confirmOffset, 'Advance Block', 0)
markSignal(deliberationSignal, false, high3, low3, confirmOffset, 'Deliberation', 1)
markSignal(threeStarsSouthSignal, true, high3, low3, confirmOffset, 'Three Stars\nin the South', 2)
markSignal(threeRiverSignal, true, high3, low3, confirmOffset, 'Unique Three\nRiver Bottom', 3)
markSignal(concealingSignal, true, high4, low4, confirmOffset, 'Concealing\nBaby Swallow', 4)
markSignal(sideBySideBullSignal, true, high3, low3, confirmOffset, 'Side-by-Side\nWhite Lines', 5)
markSignal(sideBySideBearSignal, false, high3, low3, confirmOffset, 'Side-by-Side\nWhite Lines', 6)
markSignal(separatingBullSignal, true, high2, low2, confirmOffset, 'Separating\nLines', 7)
markSignal(separatingBearSignal, false, high2, low2, confirmOffset, 'Separating\nLines', 8)
markSignal(counterattackBullSignal, true, high2, low2, confirmOffset, 'Counterattack\nLines', 9)
markSignal(counterattackBearSignal, false, high2, low2, confirmOffset, 'Counterattack\nLines', 10)
markSignal(stickSandwichSignal, true, high3, low3, confirmOffset, 'Stick Sandwich', 11)
markSignal(homingPigeonSignal, true, high2, low2, confirmOffset, 'Homing Pigeon', 12)
markSignal(descendingHawkSignal, false, high2, low2, confirmOffset, 'Descending Hawk', 13)
markSignal(ladderBottomSignal, true, high5, low5, confirmOffset, 'Ladder Bottom', 14)
markSignal(ladderTopSignal, false, high5, low5, confirmOffset, 'Ladder Top', 15)
markSignal(upsideGapCrowsSignal, false, high3, low3, confirmOffset, 'Upside Gap\nTwo Crows', 16)
markSignal(threeLineBullSignal, true, high4, low4, confirmOffset, 'Three-Line\nStrike', 17)
markSignal(threeLineBearSignal, false, high4, low4, confirmOffset, 'Three-Line\nStrike', 18)
markSignal(newHighLinesSignal, false, high, low, 0, recordLinesText, 19)
markSignal(newLowLinesSignal, true, high, low, 0, recordLinesText, 20)

plot(showTrendMaInput and trendRuleInput != 'None' ? trendMa : na, 'Trend MA', color = trendMaColorInput, linewidth = 1)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
dashPosition = switch dashPositionInput
    'Top Right'    => position.top_right
    'Top Left'     => position.top_left
    'Bottom Right' => position.bottom_right
    =>                position.bottom_left

dashTextSize = switch dashSizeInput
    'Tiny'   => size.tiny
    'Normal' => size.normal
    =>          size.small

var table dashTable = na

if barstate.islast and showDashboardInput
    if not na(dashTable)
        table.delete(dashTable)
    dashTable := table.new(dashPosition, 2, N_SIGNALS + 1, bgcolor = DASH_BG, border_width = 0,
      frame_color = DASH_FRAME, frame_width = 1)
    table.cell(dashTable, 0, 0, 'Rare Formation', text_color = DASH_HEADER, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, 'Count', text_color = DASH_HEADER, text_size = dashTextSize)
    int rowIndex = 1
    for i = 0 to N_SIGNALS - 1
        int signalCount = array.get(countsArray, i)
        if signalCount > 0 or not hideEmptyInput
            table.cell(dashTable, 0, rowIndex, array.get(namesArray, i),
              text_color = array.get(bullFlagArray, i) ? bullColorInput : bearColorInput,
              text_size = dashTextSize, text_halign = text.align_left)
            table.cell(dashTable, 1, rowIndex, str.tostring(signalCount), text_color = DASH_TEXT,
              text_size = dashTextSize, text_halign = text.align_right)
            rowIndex += 1
    if rowIndex == 1
        table.cell(dashTable, 0, 1, 'No formations on chart', text_color = NEUTRAL_COLOR,
          text_size = dashTextSize, text_halign = text.align_left)
        table.merge_cells(dashTable, 0, 1, 1, 1)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(anyBullishSignal, 'Any Bullish Formation', 'Bullish rare candlestick formation detected - verify the print against the strict definition and its location before acting')
alertcondition(anyBearishSignal, 'Any Bearish Formation', 'Bearish rare candlestick formation detected - verify the print against the strict definition and its location before acting')
alertcondition(advanceBlockSignal, 'Advance Block', 'Advance block - rising bodies shrinking with lengthening upper shadows, the advance may be running out of force')
alertcondition(deliberationSignal, 'Deliberation', 'Deliberation - two long white candles then a small body stalling at the highs, buyers hesitating')
alertcondition(threeStarsSouthSignal, 'Three Stars in the South', 'Three stars in the south - downside probes failing on shrinking black candles, selling pressure ebbing')
alertcondition(threeRiverSignal, 'Unique Three-River Bottom', 'Unique three-river bottom - new low rejected inside a black harami, then a small white close below it')
alertcondition(concealingSignal, 'Concealing Baby Swallow', 'Concealing baby swallow - four black candles with the final one engulfing the gap-down candle, shadows included')
alertcondition(sideBySideBullSignal or sideBySideBearSignal, 'Side-by-Side White Lines', 'Side-by-side white lines - twin white candles holding beyond an unfilled body gap, trend continuation')
alertcondition(separatingBullSignal or separatingBearSignal, 'Separating Lines', 'Separating lines - opposite-colored candles sharing the same open, prior trend resuming')
alertcondition(counterattackBullSignal or counterattackBearSignal, 'Counterattack Lines', 'Counterattack lines - opposite-colored long candles meeting at the same close, potential reversal')
alertcondition(stickSandwichSignal, 'Stick Sandwich', 'Stick sandwich - two black candles with matching closes sandwiching a white candle, potential bottom')
alertcondition(homingPigeonSignal, 'Homing Pigeon', 'Homing pigeon - small black body inside the prior long black body, decline stalling')
alertcondition(descendingHawkSignal, 'Descending Hawk', 'Descending hawk - small white body inside the prior long white body, advance stalling')
alertcondition(ladderBottomSignal or ladderTopSignal, 'Ladder Bottom / Ladder Top', 'Ladder reversal - a stepped run, an intrabar warning shadow, then a gap-open candle against the trend')
alertcondition(upsideGapCrowsSignal, 'Upside Gap Two Crows', 'Upside gap two crows - two black candles eroding an upside gap while it still holds, advance in question')
alertcondition(threeLineBullSignal or threeLineBearSignal, 'Three-Line Strike', 'Three-line strike - a fourth candle reversing through three progressive bodies, classically a continuation pattern')
alertcondition(newHighLinesSignal or newLowLinesSignal, 'New Price Lines', 'New price lines - the set number of consecutive record sessions printed, the move may be overextended')

//---------------------------------------------------------------------------------------------------------------------}
