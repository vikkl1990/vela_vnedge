//@version=6
indicator("Three Black Crows"
  , shorttitle       = "Three Black Crows"
  , overlay          = true
  , format           = format.price
  , max_lines_count  = 500
  , max_labels_count = 500
  , max_boxes_count  = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

//Default palette
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86
color LABEL_BG      = #00000000

//Transparency of the pattern box fill and border
int BOX_BG_TRANSP     = 88
int BOX_BORDER_TRANSP = 60

//Transparency applied to a bounce level once price has traded back into it
int DEAD_LEVEL_TRANSP = 65

//Maximum number of bounce-level setups tracked at once
int MAX_TRACKED = 40

//Trend-context test options
string CTX_AVG = "Above Average"
string CTX_ADV = "Net Advance"
string CTX_ANY = "Either"

string GROUP_DETECTION = "Pattern Detection"
string GROUP_CONTEXT   = "Trend Context"
string GROUP_VARIANTS  = "Variants & Structure"
string GROUP_LEVELS    = "Bounce Levels"
string GROUP_STYLE     = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

bodyLengthInput = input.int(14, "Body Average Length"
  , minval  = 2
  , maxval  = 100
  , group   = GROUP_DETECTION
  , tooltip = "Bars, ending right before the pattern, used to average the real body size of preceding candles. Each crow must print a long body relative to this average.")

bodyMultInput = input.float(1.0, "Long Body Multiplier"
  , minval  = 0.1
  , maxval  = 5
  , step    = 0.1
  , group   = GROUP_DETECTION
  , tooltip = "Minimum real body of each crow as a multiple of the pre-pattern average body. Three modest red candles do not qualify - raise it to demand more substantial sessions.")

shadowPctInput = input.float(30, "Lower Shadow Tolerance %"
  , minval  = 0
  , maxval  = 200
  , step    = 5
  , group   = GROUP_DETECTION
  , tooltip = "Largest lower shadow allowed on each crow, as a percentage of its real body. Each candle should close at or near its low; long lower tails suggest dip buying and weaken the pattern.")

simToggleInput = input.bool(true, "Similar Bodies"
  , inline  = "similar"
  , group   = GROUP_DETECTION
  , tooltip = "Prefer bodies of similar, substantial size across the three crows.")

simPctInput = input.float(50, "Min %"
  , minval  = 10
  , maxval  = 100
  , step    = 5
  , inline  = "similar"
  , group   = GROUP_DETECTION
  , tooltip = "Smallest crow body required, as a percentage of the largest, when 'Similar Bodies' is enabled.")

exhaustMultInput = input.float(1.5, "Exhaustion Multiplier"
  , minval  = 1
  , maxval  = 5
  , step    = 0.1
  , group   = GROUP_DETECTION
  , tooltip = "If the third crow's body reaches this multiple of the average of the first two, the signal is annotated as a possible short-term exhaustion: an accelerating final candle can mark a climax rather than the start of a decline.")

dedupInput = input.bool(true, "Suppress Overlapping Signals"
  , group   = GROUP_DETECTION
  , tooltip = "During an extended run of long dark candles several overlapping triples can qualify. Keep only patterns that do not share candles with a previous signal.")

ctxToggleInput = input.bool(true, "Require Preceding Advance"
  , group   = GROUP_CONTEXT
  , tooltip = "The pattern needs a preceding advance or a market at highs - three dark candles inside a downtrend are just the trend.")

ctxModeInput = input.string(CTX_ANY, "Context Test"
  , options = [CTX_AVG, CTX_ADV, CTX_ANY]
  , group   = GROUP_CONTEXT
  , tooltip = "'Above Average' requires the close preceding the pattern to sit above its moving average (a market at highs). 'Net Advance' requires that close to be higher than it was 'Context Length' bars earlier. 'Either' accepts one of the two.")

ctxLengthInput = input.int(14, "Context Length"
  , minval  = 2
  , maxval  = 100
  , group   = GROUP_CONTEXT
  , tooltip = "Lookback, in bars before the pattern, used by the context test.")

identToggleInput = input.bool(true, "Flag Identical Three Crows"
  , group   = GROUP_VARIANTS
  , tooltip = "Stricter variant where each crow opens at or very near the prior close instead of inside the prior body - no bounce at all between sessions. Traditionally read as even more bearish, though considerably rarer.")

identTolInput = input.float(10, "Open Tolerance %"
  , minval  = 0
  , maxval  = 50
  , step    = 5
  , group   = GROUP_VARIANTS
  , tooltip = "Largest distance allowed between a crow's open and the prior crow's close, as a percentage of the prior body, for the identical variant.")

structToggleInput = input.bool(true, "Prior Swing Low Break"
  , group   = GROUP_VARIANTS
  , tooltip = "Annotate signals whose third crow closes below the most recent swing low confirmed before the pattern - the signal carries more weight when the crows convert candlestick evidence into a structural break.")

swingLengthInput = input.int(5, "Swing Length"
  , minval  = 2
  , maxval  = 50
  , group   = GROUP_VARIANTS
  , tooltip = "Bars required on each side of a low for it to count as a confirmed swing low.")

levelsToggleInput = input.bool(true, "Show Bounce Levels"
  , group   = GROUP_LEVELS
  , tooltip = "Because the third crow often leaves price short-term stretched, many traders wait for a bounce back toward the pattern's midpoint or the first crow's open before entering. Draws both levels after each signal and watches them for a touch.")

levelWindowInput = input.int(20, "Watch Window"
  , minval  = 1
  , maxval  = 200
  , group   = GROUP_LEVELS
  , tooltip = "Bars after the signal during which the bounce levels are extended and monitored. A level dims once price trades back into it.")

showLabelsInput = input.bool(true, "Show Pattern Labels"
  , group   = GROUP_STYLE
  , tooltip = "Labels each completed pattern above its three candles.")

boxToggleInput = input.bool(true, "Highlight Pattern Candles"
  , group   = GROUP_STYLE
  , tooltip = "Draws a shaded box around the three crows.")

showCtxInput = input.bool(false, "Show Context Average"
  , group   = GROUP_STYLE
  , tooltip = "Plots the moving average used by the trend-context test.")

bearColorInput = input.color(BEAR_COLOR, "Pattern", group = GROUP_STYLE)

midColorInput = input.color(NEUTRAL_COLOR, "Midpoint Level", group = GROUP_STYLE)

topColorInput = input.color(BEAR_COLOR, "First Crow Open Level", group = GROUP_STYLE)

basisColorInput = input.color(NEUTRAL_COLOR, "Context Average", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{

//A tracked pair of bounce levels from one completed pattern: the pattern midpoint and the first crow's
//open, extended forward while unvisited during the watch window
type CrowSetup
    line  midLine
    line  topLine
    float midPrice
    float topPrice
    int   startBar
    bool  midHit
    bool  topHit

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

//A qualifying crow: a dark candle whose real body is long relative to the pre-pattern average and whose
//close sits at or near its own low (short lower shadow)
isQualifyingCrow(float o, float l, float c, float refBody) =>
    float body    = o - c
    bool  isDark  = c < o
    bool  isLong  = refBody > 0 and body >= bodyMultInput * refBody
    bool  nearLow = c - l <= body * shadowPctInput / 100
    isDark and isLong and nearLow

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{

float bodySize = math.abs(close - open)
float bodyAvg  = ta.sma(bodySize, bodyLengthInput)
float ctxBasis = ta.sma(close, ctxLengthInput)
float pivotLo  = ta.pivotlow(low, swingLengthInput, swingLengthInput)

//Average real body of the bars immediately preceding the three crows - the yardstick for "long"
float refBody = bodyAvg[3]
bool  refOk   = not na(refBody) and refBody > 0

//Context: the pattern needs a preceding advance or a market at highs - three dark candles inside a
//downtrend are just the trend
bool aboveAvg = not na(ctxBasis[3]) and close[3] > ctxBasis[3]
bool netAdv   = not na(close[3 + ctxLengthInput]) and close[3] > close[3 + ctxLengthInput]
bool ctxPass  = not ctxToggleInput or (ctxModeInput == CTX_AVG ? aboveAvg : ctxModeInput == CTX_ADV ? netAdv : (aboveAvg or netAdv))

//Three consecutive long dark candles closing at or near their lows
bool crow1 = isQualifyingCrow(open[2], low[2], close[2], refBody)
bool crow2 = isQualifyingCrow(open[1], low[1], close[1], refBody)
bool crow3 = isQualifyingCrow(open,    low,    close,    refBody)

//Each later crow opens within the prior crow's real body - a small bounce that immediately failed
bool openIn2 = open[1] <= open[2] and open[1] >= close[2]
bool openIn3 = open    <= open[1] and open    >= close[1]

//Progressively lower closes
bool declining = close < close[1] and close[1] < close[2]

//Real bodies of the three crows (positive for dark candles)
float body1 = open[2] - close[2]
float body2 = open[1] - close[1]
float body3 = open    - close

float maxBody = math.max(body1, body2, body3)
float minBody = math.min(body1, body2, body3)

//Bodies of similar, substantial size - three modest red candles do not qualify
bool simPass = not simToggleInput or (maxBody > 0 and minBody >= maxBody * simPctInput / 100)

bool rawPattern = refOk and ctxPass and crow1 and crow2 and crow3 and openIn2 and openIn3 and declining and simPass

//Optionally keep only patterns that do not share candles with a previous signal
var int lastSignalBar = na

bool spaced = na(lastSignalBar) or bar_index - lastSignalBar >= 3
bool signal = rawPattern and (not dedupInput or spaced)

if signal
    lastSignalBar := bar_index

//Identical three crows: each crow opens at or very near the prior close - no bounce at all between
//sessions, the stricter and rarer variant
bool identical = identToggleInput and signal and math.abs(open[1] - close[2]) <= body1 * identTolInput / 100 and math.abs(open - close[1]) <= body2 * identTolInput / 100

//An accelerating final candle can signal short-term exhaustion rather than the start of a decline
bool exhaust = signal and body3 >= exhaustMultInput * (body1 + body2) / 2

//Most recent swing low confirmed before the pattern - closing below it converts candlestick evidence
//into a structural break
var float lastSwingLow    = na
var int   lastSwingLowBar = na

if not na(pivotLo)
    lastSwingLow    := pivotLo
    lastSwingLowBar := bar_index - swingLengthInput

bool structBreak = structToggleInput and signal and not na(lastSwingLow) and lastSwingLowBar < bar_index - 2 and close < lastSwingLow

//Reference prices of the completed pattern
float patternTop  = open[2]
float patternMid  = (open[2] + close) / 2
float patternHigh = math.max(high, high[1], high[2])
float patternLow  = math.min(low,  low[1],  low[2])

//---------------------------------------------------------------------------------------------------------------------}
// Bounce Levels
//---------------------------------------------------------------------------------------------------------------------{

var array<CrowSetup> setupsArray = array.new<CrowSetup>()

bool midTouch = false
bool topTouch = false

//Extend the active levels, dim each once price bounces back into it, and drop setups whose watch window
//has elapsed or whose levels have both been visited
if array.size(setupsArray) > 0
    array<CrowSetup> keepArray = array.new<CrowSetup>()
    for i = 0 to array.size(setupsArray) - 1
        CrowSetup setup = array.get(setupsArray, i)
        int age = bar_index - setup.startBar
        if age <= levelWindowInput
            if not setup.midHit
                line.set_x2(setup.midLine, bar_index)
                if high >= setup.midPrice
                    setup.midHit := true
                    midTouch     := true
                    line.set_style(setup.midLine, line.style_dotted)
                    line.set_color(setup.midLine, color.new(midColorInput, DEAD_LEVEL_TRANSP))
            if not setup.topHit
                line.set_x2(setup.topLine, bar_index)
                if high >= setup.topPrice
                    setup.topHit := true
                    topTouch     := true
                    line.set_style(setup.topLine, line.style_dotted)
                    line.set_color(setup.topLine, color.new(topColorInput, DEAD_LEVEL_TRANSP))
        if age < levelWindowInput and not (setup.midHit and setup.topHit)
            array.push(keepArray, setup)
    setupsArray := keepArray

//Log the completed pattern's midpoint and first crow's open - the levels many traders wait for a bounce
//into before entering, rather than selling the third close
if signal and levelsToggleInput
    line midLine = line.new(bar_index - 2, patternMid, bar_index, patternMid, color = midColorInput, style = line.style_dashed, width = 1)
    line topLine = line.new(bar_index - 2, patternTop, bar_index, patternTop, color = topColorInput, style = line.style_dashed, width = 1)
    array.push(setupsArray, CrowSetup.new(midLine, topLine, patternMid, patternTop, bar_index, false, false))
    while array.size(setupsArray) > MAX_TRACKED
        array.shift(setupsArray)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

plot(ctxBasis, "Context Average", showCtxInput ? basisColorInput : color(na), 1)

//Mark the completed pattern above its three candles
if signal and showLabelsInput
    string tip = "Three black crows: after an advance, three long dark candles each opened within the prior body and closed near its own low at a progressively lower level - methodical, repeated selling." + (identical ? " Identical variant: each crow opened at or near the prior close, traditionally read as even more bearish." : "") + (structBreak ? " The third crow closed below the prior swing low at " + str.tostring(lastSwingLow, format.mintick) + " - a structural break." : "") + (exhaust ? " Caution: the final body accelerated - possible short-term exhaustion rather than the start of a decline." : "") + " Bounce levels: pattern midpoint " + str.tostring(patternMid, format.mintick) + ", first crow open " + str.tostring(patternTop, format.mintick) + "."

    label.new(bar_index - 1, patternHigh, identical ? "Identical Three Crows" : "Three Black Crows"
      , style     = label.style_label_down
      , color     = LABEL_BG
      , textcolor = bearColorInput
      , size      = size.small
      , tooltip   = tip)

//Shade the three candles forming the pattern
if signal and boxToggleInput
    box.new(bar_index - 2, patternHigh, bar_index, patternLow
      , border_color = color.new(bearColorInput, BOX_BORDER_TRANSP)
      , border_width = 1
      , bgcolor      = color.new(bearColorInput, BOX_BG_TRANSP))

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(signal, "Three Black Crows", "Three black crows on {{ticker}} ({{interval}}) - after an advance, three long dark candles each opened within the prior body and closed near its low at a progressively lower level. A potential character change at the end of the uptrend")

alertcondition(identical, "Identical Three Crows", "Identical three crows on {{ticker}} ({{interval}}) - each crow opened at or near the prior close, the stricter variant traditionally read as even more bearish")

alertcondition(structBreak, "Three Black Crows + Structure Break", "Three black crows on {{ticker}} ({{interval}}) closed below the prior swing low - candlestick evidence converted into a structural break")

alertcondition(midTouch, "Bounce Into Pattern Midpoint", "Price on {{ticker}} ({{interval}}) bounced back into a three black crows pattern midpoint - the reflex bounce many traders wait to sell into")

alertcondition(topTouch, "Bounce Into First Crow Open", "Price on {{ticker}} ({{interval}}) bounced back into the first crow's open after three black crows - the deeper bounce level of the pattern")

//---------------------------------------------------------------------------------------------------------------------}
