//@version=6
indicator("Kalman Filter", shorttitle = "Kalman Filter", overlay = true, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
INIT_VARIANCE     = 1.0   // Var_0 — any positive value works; the gain converges to its steady state regardless
BULL_COLOR        = #089981
BEAR_COLOR        = #f23645
NEUTRAL_COLOR     = #787b86
FILL_PRICE_TRANSP = 60    // gradient transparency at the price end of the fill
FILL_FILT_TRANSP  = 100   // gradient transparency at the filter end of the fill

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source", group = "Settings",
     tooltip = "Price series fed to the filter as the measurement — typically the close. Feeding a noisy indicator series here covers the pre-processing use: filtering an input before it drives another tool trades a little delay for fewer whipsaw flips downstream.")

qInput = input.float(0.01, "Process Noise (Q)", minval = 0, step = 0.001, group = "Settings",
     tooltip = "Process noise variance Q — how much the true level is assumed to wander per bar. Raising it tells the filter prices are informative, so the Kalman gain rises and the line hugs price; lowering it produces a smoother but laggier estimate. Only the Q/R ratio matters in steady state and there is no universal default — 0.01 against R = 1 settles near a 20-bar EMA's responsiveness.")

rInput = input.float(1.0, "Measurement Noise (R)", minval = 0.0001, step = 0.01, group = "Settings",
     tooltip = "Measurement noise variance R — how noisy each price print is assumed to be around the true level. Raising it makes observations less trusted, flattening the line so it rides out chop at the cost of extra lag. Because only the Q/R ratio matters in steady state, a common approach is to keep R fixed and tune Q alone as a single smoothness knob.")

trendColorInput   = input.bool(true, "Slope Trend Coloring", group = "Style",
     tooltip = "Colors the Kalman estimate by its slope — bullish while the filtered level is rising, bearish while it is falling. Disable to draw the line in the neutral color.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Bullish color, used while the filter slope is rising and for bullish crossings/fill.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Bearish color, used while the filter slope is falling and for bearish crossings/fill.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral", group = "Style",
     tooltip = "Line color used when slope trend coloring is disabled, or when the slope is flat.")

showFillInput     = input.bool(true, "Price / Filter Gradient Fill", group = "Style",
     tooltip = "Fills the area between the source and the filter with a vertical gradient — bullish while price holds above the Kalman estimate, bearish while below — fading to fully transparent at the filter line. Visualizes the filtered level serving as a trailing reference.")

showSignalsInput  = input.bool(false, "Price Crossing Markers", group = "Style",
     tooltip = "Displays small triangle markers when the source crosses over or under the Kalman estimate. Off by default to keep the chart clean — the crossing alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Scalar random-walk Kalman filter (state transition and observation both 1) — the published predict/update loop,
// run once per bar:
//   Prior_t    = Est_(t-1)                        — predict: carry the level one bar forward
//   PriorVar_t = Var_(t-1) + Q                    — widen its uncertainty by the process noise
//   K_t        = PriorVar_t / (PriorVar_t + R)    — Kalman gain: predicted uncertainty vs measurement noise
//   Est_t      = Prior_t + K_t * (P_t - Prior_t)  — pull the prediction toward the observed price by that fraction
//   Var_t      = (1 - K_t) * PriorVar_t           — shrink the uncertainty after the update
// Est seeds with the first available price and Var_0 with a positive constant — the gain converges to its steady
// state regardless of the start value. Causal on purpose: each estimate uses only current and past observations,
// so printed values never repaint. Returns the filtered estimate and the gain.
kalmanFilter(float src, float q, float r) =>
    float est    = na
    float errVar = na
    prior    = nz(est[1], src)
    priorVar = nz(errVar[1], INIT_VARIANCE) + q
    gain     = priorVar / (priorVar + r)
    est     := prior + gain * (src - prior)
    errVar  := (1 - gain) * priorVar
    [est, gain]

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
[est, kalmanGain] = kalmanFilter(srcInput, qInput, rInput)

// Slope of the estimate — the adaptive-baseline trend read of the filtered level
slope = est - nz(est[1], est)

// Price crossings — read exactly like moving average crossovers, with responsiveness set by the noise model
crossUp   = ta.crossover(srcInput, est)
crossDown = ta.crossunder(srcInput, est)

// Slope reversals of the filtered level
slopeTurnUp   = slope > 0 and nz(slope[1]) <= 0
slopeTurnDown = slope < 0 and nz(slope[1]) >= 0

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
estColor = trendColorInput ? (slope > 0 ? bullColorInput : slope < 0 ? bearColorInput : neutralColorInput) : neutralColorInput

priceAbove      = srcInput > est
fillTopColor    = showFillInput ? (priceAbove ? color.new(bullColorInput, FILL_PRICE_TRANSP) : color.new(bearColorInput, FILL_FILT_TRANSP)) : na
fillBottomColor = showFillInput ? (priceAbove ? color.new(bullColorInput, FILL_FILT_TRANSP) : color.new(bearColorInput, FILL_PRICE_TRANSP)) : na

srcPlotId = plot(srcInput, "Source", color = na, editable = false, display = display.none)
estPlotId = plot(est, "Kalman Filter", color = estColor, linewidth = 2)

fill(srcPlotId, estPlotId, top_value = math.max(srcInput, est), bottom_value = math.min(srcInput, est), top_color = fillTopColor, bottom_color = fillBottomColor, title = "Price / Filter Gradient Fill")

// Effective blending weight in the data window — the live smoothness-vs-lag readout of the Q/R setting
plot(kalmanGain, "Kalman Gain", color = NEUTRAL_COLOR, precision = 4, editable = false, display = display.data_window)

plotshape(showSignalsInput and crossUp, "Bullish Cross", shape.triangleup, location.belowbar, color = bullColorInput, size = size.tiny)
plotshape(showSignalsInput and crossDown, "Bearish Cross", shape.triangledown, location.abovebar, color = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Bullish Price Cross", "Price crossed above the Kalman Filter on {{ticker}} ({{interval}})")
alertcondition(crossDown, "Bearish Price Cross", "Price crossed below the Kalman Filter on {{ticker}} ({{interval}})")
alertcondition(slopeTurnUp, "Kalman Filter Slope Up", "Kalman Filter slope turned upward on {{ticker}} ({{interval}})")
alertcondition(slopeTurnDown, "Kalman Filter Slope Down", "Kalman Filter slope turned downward on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
