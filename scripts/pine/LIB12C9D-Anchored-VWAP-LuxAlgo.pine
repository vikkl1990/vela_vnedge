//@version=6
indicator("Anchored VWAP", "AVWAP", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // close above the anchored VWAP - buyers since the anchor are in profit
BEAR_COLOR    = #f23645 // close below the anchored VWAP
NEUTRAL_COLOR = #787b86 // bands and the line when price sits exactly on it
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
anchorInput = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Anchor time", confirm = true, group = "Settings", tooltip = "Start time of the VWAP accumulation. Confirm the anchor by clicking a bar on the chart when the indicator is added. Moving the anchor is the only way to restart the line.")

srcInput = input.source(hlc3, "Source", group = "Settings", tooltip = "Price used for the volume weighting. Typical price (high + low + close) / 3 is the classic choice.")

showBandsInput = input.bool(false, "Bands", inline = "bands", group = "Settings", tooltip = "Show standard deviation bands around the anchored VWAP.")
bandsMultInput = input.float(2.0, "Multiplier", minval = 0, step = 0.5, inline = "bands", group = "Settings", tooltip = "Standard deviation multiplier applied to the bands.")

avwapColorInput = input.color(NEUTRAL_COLOR, "AVWAP", group = "Style", tooltip = "Color of the anchored VWAP line when price sits exactly on it. Above the line price takes the bullish color, below it the bearish color.")
bullColorInput  = input.color(BULL_COLOR, "Above", inline = "position", group = "Style", tooltip = "Line color while the close is above the anchored VWAP.")
bearColorInput  = input.color(BEAR_COLOR, "Below", inline = "position", group = "Style", tooltip = "Line color while the close is below the anchored VWAP.")
bandsColorInput = input.color(NEUTRAL_COLOR, "Bands", group = "Style", tooltip = "Color of the standard deviation bands.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
bool anchored = time >= anchorInput

var float sumPV  = 0.0
var float sumV   = 0.0
var float sumPV2 = 0.0

if anchored
    if not anchored[1]
        sumPV  := 0.0
        sumV   := 0.0
        sumPV2 := 0.0
    if not na(srcInput)
        float vol = nz(volume)
        sumPV  += srcInput * vol
        sumV   += vol
        sumPV2 += srcInput * srcInput * vol

float avwap = sumV > 0 ? sumPV / sumV : na
// negative variance from floating point rounding is clamped to 0
float stDev = sumV > 0 ? math.sqrt(math.max(sumPV2 / sumV - avwap * avwap, 0)) : na

float upperBand = avwap + bandsMultInput * stDev
float lowerBand = avwap - bandsMultInput * stDev

bool crossUp   = ta.crossover(close, avwap)
bool crossDown = ta.crossunder(close, avwap)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// Price position against the anchored VWAP - above is the bullish side, below the bearish side
avwapColor = close > avwap ? bullColorInput : close < avwap ? bearColorInput : avwapColorInput

plot(avwap, "AVWAP", avwapColor, 1, plot.style_linebr)

upperPlotId = plot(showBandsInput ? upperBand : na, "Upper Band", bandsColorInput, 1, plot.style_linebr)
lowerPlotId = plot(showBandsInput ? lowerBand : na, "Lower Band", bandsColorInput, 1, plot.style_linebr)

fill(upperPlotId, lowerPlotId, color = color.new(bandsColorInput, 95), title = "Bands Fill")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Price Crossed Above AVWAP", "Price crossed above the Anchored VWAP")
alertcondition(crossDown, "Price Crossed Below AVWAP", "Price crossed below the Anchored VWAP")
//----------------------------------------------------------------------------------------------------------------------}
