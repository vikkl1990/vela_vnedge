//@version=6
indicator("Wavelet Decomposition", "Wavelet Decomposition", overlay = false, max_labels_count = 50, max_lines_count = 50, max_boxes_count = 50, max_polylines_count = 50)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR = #ffd700 // fast details and the denoised line - the fast end of the scale ladder
SLOW_COLOR    = #ff9800 // slow details and the trend approximation - the slow end
GRAY_COLOR    = #787b86
LABEL_BG      = #00000000

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

HAAR = "Haar"
DB4  = "Daubechies-4"
DB6  = "Daubechies-6"

REFLECT  = "Reflection"
PERIODIC = "Periodic"

SUPPRESS = "Suppress"
SOFT     = "Soft Threshold"

TOP_RIGHT    = "Top Right"
TOP_LEFT     = "Top Left"
BOTTOM_RIGHT = "Bottom Right"
BOTTOM_LEFT  = "Bottom Left"
MIDDLE_RIGHT = "Middle Right"

GRP_DECOMP = "Decomposition"
GRP_OUT    = "Denoising & Trend"
GRP_MH     = "Multi-Horizon View"
GRP_STYLE  = "Style"

MIN_WINDOW     = 32
LANE_AMPLITUDE = 0.48
LANE_MARGIN    = 0.7

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput      = input.source(close, "Source", group = GRP_DECOMP, tooltip = "Series decomposed by the transform. The decomposition is exactly additive: the approximation plus all detail levels sums back to this series.")
windowInput   = input.int(256, "Analysis Window", minval = 32, maxval = 1000, group = GRP_DECOMP, tooltip = "Number of most recent bars the transform decomposes. The pyramid recomputes over this rolling sample, so values near the right edge revise as new bars arrive — the wavelet boundary problem.")
levelsInput   = input.int(4, "Levels (J)", minval = 1, maxval = 6, group = GRP_DECOMP, tooltip = "Decomposition depth. Each level halves the frequency band: D1 holds 2-4 bar fluctuations, D2 4-8 bars, and so on; the approximation A_J holds everything slower than 2^(J+1) bars. Depth is automatically reduced when the deepest filter no longer fits the window.")
familyInput   = input.string(DB4, "Wavelet Family", options = [HAAR, DB4, DB6], group = GRP_DECOMP, tooltip = "Low-pass/high-pass filter pair of the pyramid. Haar is the simplest and most edge-friendly; Daubechies wavelets of modest length are the common default for smoother decompositions, at the cost of wider filters and therefore stronger boundary effects.")
boundaryInput = input.string(REFLECT, "Boundary Handling", options = [REFLECT, PERIODIC], group = GRP_DECOMP, tooltip = "How the filters obtain data past the sample edges. Reflection mirrors the sample at both ends; Periodic wraps around to the opposite end. Either way edge values are computed from padded data and revise as new bars arrive.")

denoiseLevelsInput = input.int(2, "Suppress Finest Levels (K)", minval = 0, maxval = 5, group = GRP_OUT, tooltip = "How many of the finest detail levels are removed (or thresholded) before reconstructing the denoised series. 0 reproduces the source exactly; higher values smooth more aggressively by discarding progressively slower fluctuations.")
denoiseModeInput   = input.string(SUPPRESS, "Denoise Mode", options = [SUPPRESS, SOFT], group = GRP_OUT, tooltip = "Suppress zeroes the K finest detail levels outright. Soft Threshold instead shrinks their coefficients toward zero by a universal threshold (median-based noise estimate), which removes fast noise while leaving sharp legitimate moves largely intact.")
showDenoisedInput  = input.bool(true, "Denoised Reconstruction", group = GRP_OUT, tooltip = "Draw the denoised reconstruction (approximation + surviving details) on the price chart.")
showTrendInput     = input.bool(true, "Trend (Approximation)", group = GRP_OUT, tooltip = "Draw the level-J approximation A_J on the price chart — the trend-extraction use of the transform, keeping only the slowest scales.")

showStackInput = input.bool(true, "Detail Stack", group = GRP_MH, tooltip = "Stack the reconstructed detail components in the pane, fastest (D1) on top, slowest at the bottom. All lanes share one amplitude scale, so the relative magnitude of movement across timescales is directly comparable.")
showTableInput = input.bool(true, "Energy Table", group = GRP_MH, tooltip = "Per-level energy of the wavelet coefficients over the window, as a share of total detail energy — which timescales carry the movement. The strongest shading marks the dominant scale. The last row verifies the exact additive reconstruction.")
tablePosInput  = input.string(TOP_RIGHT, "Table Position", options = [TOP_RIGHT, TOP_LEFT, BOTTOM_RIGHT, BOTTOM_LEFT, MIDDLE_RIGHT], group = GRP_MH, tooltip = "Chart corner where the energy table is anchored.")

fastColorInput     = input.color(NEUTRAL_COLOR, "Fast Details", inline = "c1", group = GRP_STYLE)
slowColorInput     = input.color(SLOW_COLOR, "Slow Details", inline = "c1", group = GRP_STYLE)
denoisedColorInput = input.color(NEUTRAL_COLOR, "Denoised", inline = "c2", group = GRP_STYLE)
trendColorInput    = input.color(SLOW_COLOR, "Trend", inline = "c2", group = GRP_STYLE)
lineWidthInput     = input.int(2, "Line Width", minval = 1, maxval = 5, group = GRP_STYLE, tooltip = "Width of the denoised line on the price chart; the trend line draws one step thinner.")
showBoundaryInput  = input.bool(true, "Boundary Zone", inline = "b", group = GRP_STYLE)
boundaryColorInput = input.color(GRAY_COLOR, "", inline = "b", group = GRP_STYLE, tooltip = "Shade the right-edge region whose values depend on padded data. Everything inside this zone revises as new bars arrive; treat it as provisional.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Positive modulo for periodic (circular) indexing
posMod(int i, int m) =>
    ((i % m) + m) % m

// Integer power of two
pow2(int e) =>
    int p = 1
    if e >= 1
        for i = 1 to e
            p *= 2
    p

// MODWT-scaled low-pass (scaling) filter h~ = h / sqrt(2) of the chosen family; taps sum to 1
waveletLowpass(string family) =>
    array<float> h = array.new<float>()
    if family == HAAR
        array.push(h, 0.5)
        array.push(h, 0.5)
    else if family == DB4
        float s3 = math.sqrt(3.0)
        array.push(h, (1.0 + s3) / 8.0)
        array.push(h, (3.0 + s3) / 8.0)
        array.push(h, (3.0 - s3) / 8.0)
        array.push(h, (1.0 - s3) / 8.0)
    else
        float s10 = math.sqrt(10.0)
        float rad = math.sqrt(5.0 + 2.0 * s10)
        array.push(h, (1.0  + s10       + rad)       / 32.0)
        array.push(h, (5.0  + s10       + 3.0 * rad) / 32.0)
        array.push(h, (10.0 - 2.0 * s10 + 2.0 * rad) / 32.0)
        array.push(h, (10.0 - 2.0 * s10 - 2.0 * rad) / 32.0)
        array.push(h, (5.0  + s10       - 3.0 * rad) / 32.0)
        array.push(h, (1.0  + s10       - rad)       / 32.0)
    h

// Matching high-pass filter by the quadrature mirror relation g[l] = (-1)^l * h[L-1-l]
qmfHighpass(array<float> h) =>
    int fLen = array.size(h)
    array<float> g = array.new<float>()
    for l = 0 to fLen - 1
        array.push(g, (l % 2 == 0 ? 1.0 : -1.0) * array.get(h, fLen - 1 - l))
    g

// One MODWT analysis step: out[t] = sum_l f[l] * a[t - dilation*l]  (circular)
analysisStep(array<float> a, array<float> f, int dilation) =>
    int m = array.size(a)
    int fLen = array.size(f)
    array<float> out = array.new<float>(m, 0.0)
    for t = 0 to m - 1
        float s = 0.0
        for l = 0 to fLen - 1
            s += array.get(f, l) * array.get(a, posMod(t - dilation * l, m))
        array.set(out, t, s)
    out

// One inverse MODWT step: out[t] = sum_l f[l] * r[t + dilation*l]  (circular)
synthesisStep(array<float> r, array<float> f, int dilation) =>
    int m = array.size(r)
    int fLen = array.size(f)
    array<float> out = array.new<float>(m, 0.0)
    for t = 0 to m - 1
        float s = 0.0
        for l = 0 to fLen - 1
            s += array.get(f, l) * array.get(r, posMod(t + dilation * l, m))
        array.set(out, t, s)
    out

// Full synthesis cascade from level j back to the sample: first step with the given filter at
// dilation 2^(j-1), then low-pass steps down through the remaining levels
mraCascade(array<float> startArr, array<float> firstFilter, int levelJ, array<float> lowpass) =>
    array<float> result = synthesisStep(startArr, firstFilter, pow2(levelJ - 1))
    if levelJ > 1
        for k2 = 1 to levelJ - 1
            int k = levelJ - k2
            result := synthesisStep(result, lowpass, pow2(k - 1))
    result

// Crop an extended (padded) array back to the analysis window
cropWindow(array<float> src, int offsetP, int count) =>
    array<float> out = array.new<float>(count, 0.0)
    for t = 0 to count - 1
        array.set(out, t, array.get(src, t + offsetP))
    out

// Period band captured by detail level j, in bars
scaleRangeText(int levelJ) =>
    str.tostring(pow2(levelJ)) + "-" + str.tostring(pow2(levelJ + 1)) + " bars"

//---------------------------------------------------------------------------------------------------------------------}
// Source Buffer
//---------------------------------------------------------------------------------------------------------------------{
var lowpassArray  = waveletLowpass(familyInput)
var highpassArray = qmfHighpass(lowpassArray)

var array<float> srcBufferArray = array.new<float>()
var float lastGoodSrc = na

float srcValue = srcInput
if not na(srcValue)
    lastGoodSrc := srcValue
float pushValue = na(srcValue) ? lastGoodSrc : srcValue
if not na(pushValue)
    array.push(srcBufferArray, pushValue)
    if array.size(srcBufferArray) > windowInput
        array.shift(srcBufferArray)

//---------------------------------------------------------------------------------------------------------------------}
// Wavelet Engine (MODWT pyramid + multiresolution reconstruction)
//---------------------------------------------------------------------------------------------------------------------{
var detailMraMatrix = matrix.new<float>()
var array<float> smoothMraArray   = array.new<float>()
var array<float> denoisedMraArray = array.new<float>()
var array<float> energyShareArray = array.new<float>()

var float denoisedLive   = na
var float trendLive      = na
var float trendSlopeLive = na
var float domLevelLive   = na
var float reconErrLive   = na
var int   jEffLive       = 0
var int   boundaryBarsLive = 0

if barstate.islast and array.size(srcBufferArray) >= MIN_WINDOW
    int effN = array.size(srcBufferArray)
    int fLen = array.size(lowpassArray)

    // Clamp depth so the deepest equivalent filter, width (2^J - 1)(L - 1) + 1, fits the window
    int jEff = levelsInput
    while jEff > 1 and (pow2(jEff) - 1) * (fLen - 1) + 1 > effN
        jEff -= 1

    // Extend the window by reflection (or not at all for periodic wrap), then run the circular
    // transform on the extension: reconstruction stays exact on the interior
    int padW = (pow2(jEff) - 1) * (fLen - 1) + 1
    int padP = boundaryInput == PERIODIC ? 0 : math.min(padW, effN - 1)
    int extM = effN + 2 * padP
    array<float> extArray = array.new<float>(extM, 0.0)
    for i = 0 to extM - 1
        int k = i - padP
        k := k < 0 ? -k : k
        k := k >= effN ? 2 * effN - 2 - k : k
        array.set(extArray, i, array.get(srcBufferArray, k))

    // Analysis pyramid: a_j[t] = sum h~[l] a_(j-1)[t - 2^(j-1) l], d_j[t] = sum g~[l] a_(j-1)[t - 2^(j-1) l]
    coeffMatrix = matrix.new<float>()
    array<float> approxArray = array.copy(extArray)
    for j = 1 to jEff
        int dilation = pow2(j - 1)
        array<float> detailCoeffs = analysisStep(approxArray, highpassArray, dilation)
        approxArray := analysisStep(approxArray, lowpassArray, dilation)
        matrix.add_row(coeffMatrix, j - 1, detailCoeffs)

    // Multiresolution synthesis: reconstructed details D_j and smooth A_J with x = A_J + D_J + ... + D_1
    detailMraMatrix := matrix.new<float>()
    array<float> sumArray = array.new<float>(effN, 0.0)
    for j = 1 to jEff
        array<float> reconArray = mraCascade(matrix.row(coeffMatrix, j - 1), highpassArray, j, lowpassArray)
        array<float> croppedArray = cropWindow(reconArray, padP, effN)
        matrix.add_row(detailMraMatrix, j - 1, croppedArray)
        for t = 0 to effN - 1
            array.set(sumArray, t, array.get(sumArray, t) + array.get(croppedArray, t))
    array<float> smoothReconArray = mraCascade(approxArray, lowpassArray, jEff, lowpassArray)
    smoothMraArray := cropWindow(smoothReconArray, padP, effN)

    // Verify the additive identity over the window (reported in the table)
    float maxReconErr = 0.0
    for t = 0 to effN - 1
        float total = array.get(sumArray, t) + array.get(smoothMraArray, t)
        maxReconErr := math.max(maxReconErr, math.abs(total - array.get(srcBufferArray, t)))

    // Denoised reconstruction: drop or soft-threshold the K finest detail levels, keep the rest
    int kEff = math.min(denoiseLevelsInput, jEff)
    denoisedMraArray := array.copy(smoothMraArray)
    for j = 1 to jEff
        if j > kEff
            array<float> keepRow = matrix.row(detailMraMatrix, j - 1)
            for t = 0 to effN - 1
                array.set(denoisedMraArray, t, array.get(denoisedMraArray, t) + array.get(keepRow, t))
        else if denoiseModeInput == SOFT
            array<float> levelCoeffs = matrix.row(coeffMatrix, j - 1)
            array<float> absArray = array.new<float>()
            for t = 0 to effN - 1
                array.push(absArray, math.abs(array.get(levelCoeffs, t + padP)))
            float sigmaJ  = array.median(absArray) / 0.6745
            float lambdaJ = sigmaJ * math.sqrt(2.0 * math.log(effN))
            array<float> thrArray = array.new<float>(extM, 0.0)
            for t = 0 to extM - 1
                float v  = array.get(levelCoeffs, t)
                float av = math.abs(v)
                array.set(thrArray, t, av > lambdaJ ? math.sign(v) * (av - lambdaJ) : 0.0)
            array<float> thrRecon = mraCascade(thrArray, highpassArray, j, lowpassArray)
            for t = 0 to effN - 1
                array.set(denoisedMraArray, t, array.get(denoisedMraArray, t) + array.get(thrRecon, t + padP))

    // Per-level coefficient energy over the window, as share of total detail energy
    energyShareArray := array.new<float>(jEff, 0.0)
    float totalDetailEnergy = 0.0
    for j = 1 to jEff
        array<float> levelCoeffs = matrix.row(coeffMatrix, j - 1)
        float levelEnergy = 0.0
        for t = 0 to effN - 1
            float v = array.get(levelCoeffs, t + padP)
            levelEnergy += v * v
        array.set(energyShareArray, j - 1, levelEnergy)
        totalDetailEnergy += levelEnergy
    int domIdx = 0
    if totalDetailEnergy > 0
        for j = 1 to jEff
            float share = array.get(energyShareArray, j - 1) / totalDetailEnergy * 100.0
            array.set(energyShareArray, j - 1, share)
            if share > array.get(energyShareArray, domIdx)
                domIdx := j - 1

    // Live edge values for alerts and labels (boundary-affected by construction — they revise)
    jEffLive         := jEff
    boundaryBarsLive := math.min((pow2(jEff) - 1) * (fLen - 1), effN - 1)
    denoisedLive     := array.get(denoisedMraArray, effN - 1)
    trendLive        := array.get(smoothMraArray, effN - 1)
    trendSlopeLive   := trendLive - array.get(smoothMraArray, effN - 2)
    domLevelLive     := domIdx + 1.0
    reconErrLive     := maxReconErr

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
// Lane zero lines anchor the pane scale; detail waveforms oscillate around them
laneBaseColor = color.new(GRAY_COLOR, 60)
plot(showStackInput and levelsInput >= 1 ?  0.0 : na, "D1 Baseline", laneBaseColor, 1, display = display.pane, editable = false)
plot(showStackInput and levelsInput >= 2 ? -1.0 : na, "D2 Baseline", laneBaseColor, 1, display = display.pane, editable = false)
plot(showStackInput and levelsInput >= 3 ? -2.0 : na, "D3 Baseline", laneBaseColor, 1, display = display.pane, editable = false)
plot(showStackInput and levelsInput >= 4 ? -3.0 : na, "D4 Baseline", laneBaseColor, 1, display = display.pane, editable = false)
plot(showStackInput and levelsInput >= 5 ? -4.0 : na, "D5 Baseline", laneBaseColor, 1, display = display.pane, editable = false)
plot(showStackInput and levelsInput >= 6 ? -5.0 : na, "D6 Baseline", laneBaseColor, 1, display = display.pane, editable = false)
plot(showStackInput ? LANE_MARGIN : na,                    "Scale Anchor Top",    LABEL_BG, 1, display = display.pane, editable = false)
plot(showStackInput ? 1.0 - levelsInput - LANE_MARGIN : na, "Scale Anchor Bottom", LABEL_BG, 1, display = display.pane, editable = false)

tablePos = switch tablePosInput
    TOP_RIGHT    => position.top_right
    TOP_LEFT     => position.top_left
    BOTTOM_RIGHT => position.bottom_right
    BOTTOM_LEFT  => position.bottom_left
    => position.middle_right

var array<polyline> polyDrawArray = array.new<polyline>()
var array<label>    labelDrawArray = array.new<label>()
var array<line>     lineDrawArray = array.new<line>()
var box   boundaryBoxId = na
var table energyTableId = na

if barstate.islast and jEffLive > 0
    // Clear the previous frame
    for p in polyDrawArray
        polyline.delete(p)
    array.clear(polyDrawArray)
    for lb in labelDrawArray
        label.delete(lb)
    array.clear(labelDrawArray)
    for ln in lineDrawArray
        line.delete(ln)
    array.clear(lineDrawArray)
    box.delete(boundaryBoxId)
    table.delete(energyTableId)

    int effN     = array.size(smoothMraArray)
    int startBar = bar_index - (effN - 1)
    int boundaryStart = bar_index - boundaryBarsLive

    // Shared amplitude scale across all detail lanes preserves relative magnitude between horizons
    float gMax = 0.0
    for j = 1 to jEffLive
        array<float> rowArray = matrix.row(detailMraMatrix, j - 1)
        for t = 0 to effN - 1
            gMax := math.max(gMax, math.abs(array.get(rowArray, t)))
    float amp = gMax > 0 ? LANE_AMPLITUDE / gMax : 0.0

    if showStackInput
        for j = 1 to jEffLive
            color laneColor = jEffLive == 1 ? fastColorInput : color.from_gradient(j, 1, jEffLive, fastColorInput, slowColorInput)
            array<chart.point> lanePoints = array.new<chart.point>()
            array<float> rowArray = matrix.row(detailMraMatrix, j - 1)
            for t = 0 to effN - 1
                array.push(lanePoints, chart.point.from_index(startBar + t, (1.0 - j) + array.get(rowArray, t) * amp))
            array.push(polyDrawArray, polyline.new(lanePoints, line_color = laneColor, line_width = 1))
            array.push(labelDrawArray, label.new(bar_index + 1, 1.0 - j, "D" + str.tostring(j) + " · " + scaleRangeText(j), style = label.style_label_left, textcolor = laneColor, color = LABEL_BG, size = size.small))
        if showBoundaryInput
            boundaryBoxId := box.new(boundaryStart, LANE_MARGIN - 0.1, bar_index, 1.0 - jEffLive - LANE_MARGIN + 0.1, border_color = color.new(boundaryColorInput, 60), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(boundaryColorInput, 90))
            array.push(labelDrawArray, label.new(boundaryStart, LANE_MARGIN - 0.1, "revising edge", style = label.style_label_down, textcolor = color.new(boundaryColorInput, 25), color = LABEL_BG, size = size.tiny, tooltip = "Values in this zone are computed from padded data and revise as new bars arrive — the wavelet boundary problem."))

    if showDenoisedInput
        array<chart.point> denoisedPoints = array.new<chart.point>()
        for t = 0 to effN - 1
            array.push(denoisedPoints, chart.point.from_index(startBar + t, array.get(denoisedMraArray, t)))
        array.push(polyDrawArray, polyline.new(denoisedPoints, line_color = denoisedColorInput, line_width = lineWidthInput, force_overlay = true))
        array.push(labelDrawArray, label.new(bar_index + 1, denoisedLive, "Denoised", style = label.style_label_left, textcolor = denoisedColorInput, color = LABEL_BG, size = size.small, force_overlay = true))
    if showTrendInput
        array<chart.point> trendPoints = array.new<chart.point>()
        for t = 0 to effN - 1
            array.push(trendPoints, chart.point.from_index(startBar + t, array.get(smoothMraArray, t)))
        array.push(polyDrawArray, polyline.new(trendPoints, line_color = trendColorInput, line_width = math.max(1, lineWidthInput - 1), force_overlay = true))
        array.push(labelDrawArray, label.new(bar_index + 1, trendLive, "A" + str.tostring(jEffLive), style = label.style_label_left, textcolor = trendColorInput, color = LABEL_BG, size = size.small, force_overlay = true))
    if showBoundaryInput and (showDenoisedInput or showTrendInput)
        float yTop = high == low ? high + syminfo.mintick : high
        array.push(lineDrawArray, line.new(boundaryStart, low, boundaryStart, yTop, extend = extend.both, color = color.new(boundaryColorInput, 60), style = line.style_dashed, width = 1, force_overlay = true))

    if showTableInput
        int rowCount = jEffLive + 3
        energyTableId := table.new(tablePos, 3, rowCount, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
        color headColor = DASH_HEADER
        color cellColor = DASH_TEXT
        table.cell(energyTableId, 0, 0, "Component", text_color = headColor, text_size = size.tiny, text_halign = text.align_left)
        table.cell(energyTableId, 1, 0, "Scale",     text_color = headColor, text_size = size.tiny, text_halign = text.align_left)
        table.cell(energyTableId, 2, 0, "Energy",    text_color = headColor, text_size = size.tiny, text_halign = text.align_right)
        for j = 1 to jEffLive
            color laneColor = jEffLive == 1 ? fastColorInput : color.from_gradient(j, 1, jEffLive, fastColorInput, slowColorInput)
            float share = array.size(energyShareArray) >= j ? array.get(energyShareArray, j - 1) : 0.0
            table.cell(energyTableId, 0, j, "D" + str.tostring(j), text_color = laneColor, text_size = size.small, text_halign = text.align_left)
            table.cell(energyTableId, 1, j, scaleRangeText(j), text_color = cellColor, text_size = size.small, text_halign = text.align_left)
            table.cell(energyTableId, 2, j, str.tostring(share, "#.#") + "%", text_color = j == domLevelLive ? laneColor : cellColor, text_size = size.small, text_halign = text.align_right, bgcolor = j == domLevelLive ? color.new(laneColor, 80) : DASH_BG)
        table.cell(energyTableId, 0, jEffLive + 1, "A" + str.tostring(jEffLive), text_color = trendColorInput, text_size = size.small, text_halign = text.align_left)
        table.cell(energyTableId, 1, jEffLive + 1, "> " + str.tostring(pow2(jEffLive + 1)) + " bars", text_color = cellColor, text_size = size.small, text_halign = text.align_left)
        table.cell(energyTableId, 2, jEffLive + 1, "trend", text_color = DASH_HEADER, text_size = size.small, text_halign = text.align_right)
        float lastSrc = array.size(srcBufferArray) > 0 ? array.get(srcBufferArray, array.size(srcBufferArray) - 1) : 1.0
        string errText = reconErrLive <= math.abs(lastSrc) * 1e-6 + 1e-8 ? "exact" : str.tostring(reconErrLive)
        table.cell(energyTableId, 0, jEffLive + 2, "A + ΣD − source", text_color = DASH_HEADER, text_size = size.tiny, text_halign = text.align_left)
        table.cell(energyTableId, 1, jEffLive + 2, "", text_color = cellColor, text_size = size.tiny)
        table.cell(energyTableId, 2, jEffLive + 2, errText, text_color = DASH_HEADER, text_size = size.tiny, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
bool liveReady = not na(denoisedLive) and not na(denoisedLive[1])

crossUpAlert   = liveReady and srcInput > denoisedLive and srcInput[1] <= denoisedLive[1]
crossDownAlert = liveReady and srcInput < denoisedLive and srcInput[1] >= denoisedLive[1]
trendUpAlert   = not na(trendSlopeLive) and not na(trendSlopeLive[1]) and trendSlopeLive > 0 and trendSlopeLive[1] <= 0
trendDownAlert = not na(trendSlopeLive) and not na(trendSlopeLive[1]) and trendSlopeLive < 0 and trendSlopeLive[1] >= 0
domShiftAlert  = not na(domLevelLive) and not na(domLevelLive[1]) and domLevelLive != domLevelLive[1]

alertcondition(crossUpAlert,   "Price Crossed Above Denoised", "wavelet decomposition: price crossed above the denoised reconstruction on {{ticker}} {{interval}} (edge values can revise)")
alertcondition(crossDownAlert, "Price Crossed Below Denoised", "wavelet decomposition: price crossed below the denoised reconstruction on {{ticker}} {{interval}} (edge values can revise)")
alertcondition(trendUpAlert,   "Trend Component Turned Up",    "wavelet decomposition: approximation A_J turned up on {{ticker}} {{interval}} (edge values can revise)")
alertcondition(trendDownAlert, "Trend Component Turned Down",  "wavelet decomposition: approximation A_J turned down on {{ticker}} {{interval}} (edge values can revise)")
alertcondition(domShiftAlert,  "Dominant Scale Shifted",       "wavelet decomposition: the detail level carrying the most energy changed on {{ticker}} {{interval}}")

//---------------------------------------------------------------------------------------------------------------------}
