//@version=6
indicator("DeltaLabs - Equal Highs / Equal Lows v0.6 - Body Only",
     overlay=true,
     max_lines_count=500,
     max_labels_count=500)

// ============================================================================
// PA Equal Highs / Equal Lows v0.6
//
// - Uses ONLY the CURRENT chart timeframe.
// - Scans only the selected recent history window (30 days by default).
// - Uses candle BODIES only. Wicks are ignored.
// - Equal highs/lows are built from confirmed body-based swing pivots.
// - Once an EQH/EQL is violated by the BODY, it is deleted completely.
// - No date filters. TradingView controls the visible/history range.
// ============================================================================

// --------------------------------------------------------------------------
// Inputs
// --------------------------------------------------------------------------
leftBars        = input.int(2, "Swing left bars", minval=1)
rightBars       = input.int(2, "Swing right bars", minval=1)

atrLen          = input.int(14, "ATR length", minval=2)
toleranceAtr    = input.float(0.05, "Equality tolerance (ATR)", minval=0.005, step=0.005)
minTicks        = input.int(1, "Minimum tolerance (ticks)", minval=1)

lookbackMode    = input.string("Last 30 days", "History to scan", options=["Last 30 days", "Custom days"])
customLookbackDays = input.int(30, "Custom history days", minval=1, maxval=3650)

ageMode         = input.string("Days", "Max gap between equal touches", options=["Days", "Bars"])
maxDaysBetween  = input.float(10.0, "Max days between equal touches", minval=0.25, step=0.25)
maxBarsBetween  = input.int(300, "Max bars between equal touches", minval=10)

historyDays = lookbackMode == "Last 30 days" ? 30 : customLookbackDays
historyStartTime = last_bar_time - historyDays * 24 * 60 * 60 * 1000

f_age_ok(_oldBar, _oldTime, _newBar, _newTime) =>
    ageMode == "Days" ?
         (_newTime - _oldTime) <= maxDaysBetween * 24.0 * 60.0 * 60.0 * 1000.0 :
         (_newBar - _oldBar) <= maxBarsBetween

showLabels      = input.bool(true, "Show EQH / EQL labels")
showMainLine    = input.bool(true, "Show EQH / EQL line")
lineStyleInput  = input.string("Dashed", "Main line style", options=["Solid", "Dashed", "Dotted"])
lineWidth       = input.int(2, "Main line width", minval=1, maxval=4)

eqhColor        = input.color(color.red, "EQH color")
eqlColor        = input.color(color.teal, "EQL color")
eqhLabelColor   = input.color(color.red, "EQH label color")
eqlLabelColor   = input.color(color.teal, "EQL label color")

showTolerance   = input.bool(false, "Show tolerance boundaries")
toleranceAlpha  = input.int(75, "Tolerance line transparency", minval=0, maxval=100)

f_line_style(_style) =>
    _style == "Solid" ? line.style_solid :
     _style == "Dotted" ? line.style_dotted :
     line.style_dashed

mainLineStyle = f_line_style(lineStyleInput)

// --------------------------------------------------------------------------
// BODY-ONLY price sources
// --------------------------------------------------------------------------
bodyHigh = math.max(open, close)
bodyLow  = math.min(open, close)

atr = ta.atr(atrLen)
tolNow = math.max(atr * toleranceAtr, syminfo.mintick * minTicks)

// Confirmed swings on BODY highs/lows.
pivotHigh = ta.pivothigh(bodyHigh, leftBars, rightBars)
pivotLow  = ta.pivotlow(bodyLow, leftBars, rightBars)

pivotHighBar = bar_index - rightBars
pivotLowBar  = bar_index - rightBars
pivotHighTime = time[rightBars]
pivotLowTime  = time[rightBars]
pivotTol = tolNow[rightBars]

// --------------------------------------------------------------------------
// Candidate swing arrays
// These contain unpaired swing highs/lows that may later become EQH/EQL.
// --------------------------------------------------------------------------
var array<float> highCandidatePrice = array.new_float()
var array<int>   highCandidateBar   = array.new_int()
var array<int>   highCandidateTime  = array.new_int()
var array<float> highCandidateTol   = array.new_float()

var array<float> lowCandidatePrice  = array.new_float()
var array<int>   lowCandidateBar    = array.new_int()
var array<int>   lowCandidateTime   = array.new_int()
var array<float> lowCandidateTol    = array.new_float()

// --------------------------------------------------------------------------
// Active EQH arrays
// --------------------------------------------------------------------------
var array<float> eqhLevel       = array.new_float()
var array<float> eqhTol         = array.new_float()
var array<int>   eqhFirstBar    = array.new_int()
var array<int>   eqhFirstTime   = array.new_int()
var array<int>   eqhLastTouch   = array.new_int()
var array<int>   eqhLastTime    = array.new_int()
var array<int>   eqhTouches     = array.new_int()
var array<line>  eqhLine        = array.new_line()
var array<line>  eqhUpperLine   = array.new_line()
var array<line>  eqhLowerLine   = array.new_line()
var array<label> eqhLabel       = array.new_label()

// --------------------------------------------------------------------------
// Active EQL arrays
// --------------------------------------------------------------------------
var array<float> eqlLevel       = array.new_float()
var array<float> eqlTol         = array.new_float()
var array<int>   eqlFirstBar    = array.new_int()
var array<int>   eqlFirstTime   = array.new_int()
var array<int>   eqlLastTouch   = array.new_int()
var array<int>   eqlLastTime    = array.new_int()
var array<int>   eqlTouches     = array.new_int()
var array<line>  eqlLine        = array.new_line()
var array<line>  eqlUpperLine   = array.new_line()
var array<line>  eqlLowerLine   = array.new_line()
var array<label> eqlLabel       = array.new_label()

// --------------------------------------------------------------------------
// Cleanup old candidates
// --------------------------------------------------------------------------
if array.size(highCandidateBar) > 0
    for i = array.size(highCandidateBar) - 1 to 0
        oldBar = array.get(highCandidateBar, i)
        oldTime = array.get(highCandidateTime, i)
        if oldTime < historyStartTime or not f_age_ok(oldBar, oldTime, bar_index, time)
            array.remove(highCandidatePrice, i)
            array.remove(highCandidateBar, i)
            array.remove(highCandidateTime, i)
            array.remove(highCandidateTol, i)

if array.size(lowCandidateBar) > 0
    for i = array.size(lowCandidateBar) - 1 to 0
        oldBar = array.get(lowCandidateBar, i)
        oldTime = array.get(lowCandidateTime, i)
        if oldTime < historyStartTime or not f_age_ok(oldBar, oldTime, bar_index, time)
            array.remove(lowCandidatePrice, i)
            array.remove(lowCandidateBar, i)
            array.remove(lowCandidateTime, i)
            array.remove(lowCandidateTol, i)

// --------------------------------------------------------------------------
// Invalidate active EQH when BODY clearly breaks above its tolerance band.
// Wicks do NOT matter.
// --------------------------------------------------------------------------
if array.size(eqhLevel) > 0
    for i = array.size(eqhLevel) - 1 to 0
        lvl = array.get(eqhLevel, i)
        tol = array.get(eqhTol, i)
        firstTime = array.get(eqhFirstTime, i)

        outsideHistory = firstTime < historyStartTime
        violated = bodyHigh > lvl + tol

        if violated or outsideHistory
            ln = array.get(eqhLine, i)
            up = array.get(eqhUpperLine, i)
            dn = array.get(eqhLowerLine, i)
            lb = array.get(eqhLabel, i)

            if not na(ln)
                line.delete(ln)
            if not na(up)
                line.delete(up)
            if not na(dn)
                line.delete(dn)
            if not na(lb)
                label.delete(lb)

            array.remove(eqhLevel, i)
            array.remove(eqhTol, i)
            array.remove(eqhFirstBar, i)
            array.remove(eqhFirstTime, i)
            array.remove(eqhLastTouch, i)
            array.remove(eqhLastTime, i)
            array.remove(eqhTouches, i)
            array.remove(eqhLine, i)
            array.remove(eqhUpperLine, i)
            array.remove(eqhLowerLine, i)
            array.remove(eqhLabel, i)
        else
            ln = array.get(eqhLine, i)
            up = array.get(eqhUpperLine, i)
            dn = array.get(eqhLowerLine, i)

            if not na(ln)
                line.set_x2(ln, bar_index)
            if not na(up)
                line.set_x2(up, bar_index)
            if not na(dn)
                line.set_x2(dn, bar_index)

// --------------------------------------------------------------------------
// Invalidate active EQL when BODY clearly breaks below its tolerance band.
// Wicks do NOT matter.
// --------------------------------------------------------------------------
if array.size(eqlLevel) > 0
    for i = array.size(eqlLevel) - 1 to 0
        lvl = array.get(eqlLevel, i)
        tol = array.get(eqlTol, i)
        firstTime = array.get(eqlFirstTime, i)

        outsideHistory = firstTime < historyStartTime
        violated = bodyLow < lvl - tol

        if violated or outsideHistory
            ln = array.get(eqlLine, i)
            up = array.get(eqlUpperLine, i)
            dn = array.get(eqlLowerLine, i)
            lb = array.get(eqlLabel, i)

            if not na(ln)
                line.delete(ln)
            if not na(up)
                line.delete(up)
            if not na(dn)
                line.delete(dn)
            if not na(lb)
                label.delete(lb)

            array.remove(eqlLevel, i)
            array.remove(eqlTol, i)
            array.remove(eqlFirstBar, i)
            array.remove(eqlFirstTime, i)
            array.remove(eqlLastTouch, i)
            array.remove(eqlLastTime, i)
            array.remove(eqlTouches, i)
            array.remove(eqlLine, i)
            array.remove(eqlUpperLine, i)
            array.remove(eqlLowerLine, i)
            array.remove(eqlLabel, i)
        else
            ln = array.get(eqlLine, i)
            up = array.get(eqlUpperLine, i)
            dn = array.get(eqlLowerLine, i)

            if not na(ln)
                line.set_x2(ln, bar_index)
            if not na(up)
                line.set_x2(up, bar_index)
            if not na(dn)
                line.set_x2(dn, bar_index)

// --------------------------------------------------------------------------
// HIGH PIVOT -> update existing EQH or create one from a candidate
// --------------------------------------------------------------------------
if not na(pivotHigh) and pivotHighTime >= historyStartTime
    newPrice = pivotHigh
    newTol = pivotTol

    // 1) First try to add a new touch to an already-active EQH.
    int activeMatch = -1
    float activeBestDist = 1e20

    if array.size(eqhLevel) > 0
        for i = 0 to array.size(eqhLevel) - 1
            lvl = array.get(eqhLevel, i)
            tol = math.max(array.get(eqhTol, i), newTol)
            dist = math.abs(newPrice - lvl)
            oldBar = array.get(eqhLastTouch, i)
            oldTime = array.get(eqhLastTime, i)

            if pivotHighBar > oldBar and f_age_ok(oldBar, oldTime, pivotHighBar, pivotHighTime) and dist <= tol and dist < activeBestDist
                activeMatch := i
                activeBestDist := dist

    if activeMatch != -1
        oldLvl = array.get(eqhLevel, activeMatch)
        oldTouches = array.get(eqhTouches, activeMatch)
        touches = oldTouches + 1
        lvl = (oldLvl * oldTouches + newPrice) / touches
        tol = math.max(array.get(eqhTol, activeMatch), newTol)

        array.set(eqhLevel, activeMatch, lvl)
        array.set(eqhTol, activeMatch, tol)
        array.set(eqhLastTouch, activeMatch, pivotHighBar)
        array.set(eqhLastTime, activeMatch, pivotHighTime)
        array.set(eqhTouches, activeMatch, touches)

        ln = array.get(eqhLine, activeMatch)
        up = array.get(eqhUpperLine, activeMatch)
        dn = array.get(eqhLowerLine, activeMatch)
        lb = array.get(eqhLabel, activeMatch)

        if not na(ln)
            line.set_y1(ln, lvl)
            line.set_y2(ln, lvl)
            line.set_x2(ln, bar_index)

        if not na(up)
            line.set_y1(up, lvl + tol)
            line.set_y2(up, lvl + tol)
            line.set_x2(up, bar_index)

        if not na(dn)
            line.set_y1(dn, lvl - tol)
            line.set_y2(dn, lvl - tol)
            line.set_x2(dn, bar_index)

        if not na(lb)
            label.set_x(lb, pivotHighBar)
            label.set_y(lb, newPrice)
            label.set_text(lb, "EQH ×" + str.tostring(touches))

    else
        // 2) Search an unpaired prior swing high candidate.
        int candidateMatch = -1
        float bestDist = 1e20

        if array.size(highCandidatePrice) > 0
            for i = 0 to array.size(highCandidatePrice) - 1
                oldPrice = array.get(highCandidatePrice, i)
                oldBar = array.get(highCandidateBar, i)
                oldTime = array.get(highCandidateTime, i)
                oldTol = array.get(highCandidateTol, i)

                tol = math.max(oldTol, newTol)
                dist = math.abs(newPrice - oldPrice)

                if pivotHighBar > oldBar and f_age_ok(oldBar, oldTime, pivotHighBar, pivotHighTime) and dist <= tol and dist < bestDist
                    candidateMatch := i
                    bestDist := dist

        if candidateMatch != -1
            firstPrice = array.get(highCandidatePrice, candidateMatch)
            firstBar = array.get(highCandidateBar, candidateMatch)
            firstTime = array.get(highCandidateTime, candidateMatch)
            firstTol = array.get(highCandidateTol, candidateMatch)

            lvl = (firstPrice + newPrice) / 2.0
            tol = math.max(firstTol, newTol)

            // Before creating, make sure the body did NOT already violate
            // the prospective pool between touch #1 and touch #2.
            bool survivedBetweenTouches = true

            barsBackToFirst = bar_index - firstBar
            barsBackToSecond = bar_index - pivotHighBar

            // Scan only between the two pivots, using BODY highs.
            if barsBackToFirst > barsBackToSecond
                for k = barsBackToSecond to barsBackToFirst
                    if bodyHigh[k] > lvl + tol
                        survivedBetweenTouches := false

            if survivedBetweenTouches
                ln = showMainLine ? line.new(firstBar, lvl, bar_index, lvl,
                     xloc=xloc.bar_index, color=eqhColor,
                     width=lineWidth, style=mainLineStyle) : na

                up = showTolerance ? line.new(firstBar, lvl + tol, bar_index, lvl + tol,
                     xloc=xloc.bar_index, color=color.new(eqhColor, toleranceAlpha),
                     width=1, style=line.style_dotted) : na

                dn = showTolerance ? line.new(firstBar, lvl - tol, bar_index, lvl - tol,
                     xloc=xloc.bar_index, color=color.new(eqhColor, toleranceAlpha),
                     width=1, style=line.style_dotted) : na

                lb = showLabels ? label.new(pivotHighBar, newPrice, "EQH ×2",
                     xloc=xloc.bar_index, style=label.style_label_down,
                     textcolor=eqhLabelColor,
                     color=color.new(color.black, 100), size=size.small) : na

                array.push(eqhLevel, lvl)
                array.push(eqhTol, tol)
                array.push(eqhFirstBar, firstBar)
                array.push(eqhFirstTime, firstTime)
                array.push(eqhLastTouch, pivotHighBar)
                array.push(eqhLastTime, pivotHighTime)
                array.push(eqhTouches, 2)
                array.push(eqhLine, ln)
                array.push(eqhUpperLine, up)
                array.push(eqhLowerLine, dn)
                array.push(eqhLabel, lb)

            array.remove(highCandidatePrice, candidateMatch)
            array.remove(highCandidateBar, candidateMatch)
            array.remove(highCandidateTime, candidateMatch)
            array.remove(highCandidateTol, candidateMatch)

        else
            // 3) No match: store as potential first touch.
            array.push(highCandidatePrice, newPrice)
            array.push(highCandidateBar, pivotHighBar)
            array.push(highCandidateTime, pivotHighTime)
            array.push(highCandidateTol, newTol)

// --------------------------------------------------------------------------
// LOW PIVOT -> update existing EQL or create one from a candidate
// --------------------------------------------------------------------------
if not na(pivotLow) and pivotLowTime >= historyStartTime
    newPrice = pivotLow
    newTol = pivotTol

    // 1) Existing active EQL?
    int activeMatch = -1
    float activeBestDist = 1e20

    if array.size(eqlLevel) > 0
        for i = 0 to array.size(eqlLevel) - 1
            lvl = array.get(eqlLevel, i)
            tol = math.max(array.get(eqlTol, i), newTol)
            dist = math.abs(newPrice - lvl)
            oldBar = array.get(eqlLastTouch, i)
            oldTime = array.get(eqlLastTime, i)

            if pivotLowBar > oldBar and f_age_ok(oldBar, oldTime, pivotLowBar, pivotLowTime) and dist <= tol and dist < activeBestDist
                activeMatch := i
                activeBestDist := dist

    if activeMatch != -1
        oldLvl = array.get(eqlLevel, activeMatch)
        oldTouches = array.get(eqlTouches, activeMatch)
        touches = oldTouches + 1
        lvl = (oldLvl * oldTouches + newPrice) / touches
        tol = math.max(array.get(eqlTol, activeMatch), newTol)

        array.set(eqlLevel, activeMatch, lvl)
        array.set(eqlTol, activeMatch, tol)
        array.set(eqlLastTouch, activeMatch, pivotLowBar)
        array.set(eqlLastTime, activeMatch, pivotLowTime)
        array.set(eqlTouches, activeMatch, touches)

        ln = array.get(eqlLine, activeMatch)
        up = array.get(eqlUpperLine, activeMatch)
        dn = array.get(eqlLowerLine, activeMatch)
        lb = array.get(eqlLabel, activeMatch)

        if not na(ln)
            line.set_y1(ln, lvl)
            line.set_y2(ln, lvl)
            line.set_x2(ln, bar_index)

        if not na(up)
            line.set_y1(up, lvl + tol)
            line.set_y2(up, lvl + tol)
            line.set_x2(up, bar_index)

        if not na(dn)
            line.set_y1(dn, lvl - tol)
            line.set_y2(dn, lvl - tol)
            line.set_x2(dn, bar_index)

        if not na(lb)
            label.set_x(lb, pivotLowBar)
            label.set_y(lb, newPrice)
            label.set_text(lb, "EQL ×" + str.tostring(touches))

    else
        // 2) Search an unpaired prior swing low candidate.
        int candidateMatch = -1
        float bestDist = 1e20

        if array.size(lowCandidatePrice) > 0
            for i = 0 to array.size(lowCandidatePrice) - 1
                oldPrice = array.get(lowCandidatePrice, i)
                oldBar = array.get(lowCandidateBar, i)
                oldTime = array.get(lowCandidateTime, i)
                oldTol = array.get(lowCandidateTol, i)

                tol = math.max(oldTol, newTol)
                dist = math.abs(newPrice - oldPrice)

                if pivotLowBar > oldBar and f_age_ok(oldBar, oldTime, pivotLowBar, pivotLowTime) and dist <= tol and dist < bestDist
                    candidateMatch := i
                    bestDist := dist

        if candidateMatch != -1
            firstPrice = array.get(lowCandidatePrice, candidateMatch)
            firstBar = array.get(lowCandidateBar, candidateMatch)
            firstTime = array.get(lowCandidateTime, candidateMatch)
            firstTol = array.get(lowCandidateTol, candidateMatch)

            lvl = (firstPrice + newPrice) / 2.0
            tol = math.max(firstTol, newTol)

            // Make sure BODY never violated the prospective EQL between touches.
            bool survivedBetweenTouches = true

            barsBackToFirst = bar_index - firstBar
            barsBackToSecond = bar_index - pivotLowBar

            if barsBackToFirst > barsBackToSecond
                for k = barsBackToSecond to barsBackToFirst
                    if bodyLow[k] < lvl - tol
                        survivedBetweenTouches := false

            if survivedBetweenTouches
                ln = showMainLine ? line.new(firstBar, lvl, bar_index, lvl,
                     xloc=xloc.bar_index, color=eqlColor,
                     width=lineWidth, style=mainLineStyle) : na

                up = showTolerance ? line.new(firstBar, lvl + tol, bar_index, lvl + tol,
                     xloc=xloc.bar_index, color=color.new(eqlColor, toleranceAlpha),
                     width=1, style=line.style_dotted) : na

                dn = showTolerance ? line.new(firstBar, lvl - tol, bar_index, lvl - tol,
                     xloc=xloc.bar_index, color=color.new(eqlColor, toleranceAlpha),
                     width=1, style=line.style_dotted) : na

                lb = showLabels ? label.new(pivotLowBar, newPrice, "EQL ×2",
                     xloc=xloc.bar_index, style=label.style_label_up,
                     textcolor=eqlLabelColor,
                     color=color.new(color.black, 100), size=size.small) : na

                array.push(eqlLevel, lvl)
                array.push(eqlTol, tol)
                array.push(eqlFirstBar, firstBar)
                array.push(eqlFirstTime, firstTime)
                array.push(eqlLastTouch, pivotLowBar)
                array.push(eqlLastTime, pivotLowTime)
                array.push(eqlTouches, 2)
                array.push(eqlLine, ln)
                array.push(eqlUpperLine, up)
                array.push(eqlLowerLine, dn)
                array.push(eqlLabel, lb)

            array.remove(lowCandidatePrice, candidateMatch)
            array.remove(lowCandidateBar, candidateMatch)
            array.remove(lowCandidateTime, candidateMatch)
            array.remove(lowCandidateTol, candidateMatch)

        else
            // 3) No match: store as potential first touch.
            array.push(lowCandidatePrice, newPrice)
            array.push(lowCandidateBar, pivotLowBar)
            array.push(lowCandidateTime, pivotLowTime)
            array.push(lowCandidateTol, newTol)
