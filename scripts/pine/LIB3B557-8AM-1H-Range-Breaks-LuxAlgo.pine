//@version=6
indicator("8AM 1H Range & Breaks", overlay = true, max_boxes_count = 500, max_lines_count = 500)

// --- Settings ---
// Session Settings
tzInput = input.string("America/New_York", "Timezone", group = "Session Settings")
sessionStr = input.string("0800-0900", "Session Time", group = "Session Settings")

// Display Settings
showIFVG = input.bool(true, "Show IFVGs", group = "Display Settings")
showOB = input.bool(true, "Show Order Blocks", group = "Display Settings")
maxZones = input.int(5, "Max Zones Displayed (per type)", group = "Display Settings", minval=1)
extendBars = input.int(15, "Zone Extension Bars", group = "Display Settings", minval=1, tooltip="How many bars forward to stretch the zones from their creation.")

// Colors
colorHighLine = input.color(#089981, "High Broken Color", group = "Colors")
colorLowLine = input.color(#f23645, "Low Broken Color", group = "Colors")
colorWait = input.color(color.gray, "Waiting Line Color", group = "Colors")

colorBullIFVG = input.color(color.new(color.green, 80), "Bullish IFVG Color", group = "Colors")
colorBearIFVG = input.color(color.new(color.red, 80), "Bearish IFVG Color", group = "Colors")

colorBullOB = input.color(color.new(color.blue, 80), "Bullish OB Color", group = "Colors")
colorBearOB = input.color(color.new(color.orange, 80), "Bearish OB Color", group = "Colors")

// --- UDTs for Box Management ---
type ActiveZone
    box bx
    float top
    float bot
    int startIdx

var ActiveZone[] activeBullZones = array.new<ActiveZone>()
var ActiveZone[] activeBearZones = array.new<ActiveZone>()
var ActiveZone[] activeBullOBs = array.new<ActiveZone>()
var ActiveZone[] activeBearOBs = array.new<ActiveZone>()

// --- Store FVGs for potential inversion ---
type FVG
    float top
    float bot
    int startIdx
    bool active

var FVG[] pendingBullFVGs = array.new<FVG>()
var FVG[] pendingBearFVGs = array.new<FVG>()

// --- Session Logic ---
inSession = not na(time(timeframe.period, sessionStr, tzInput))

var float rangeHigh = na
var float rangeLow  = na

var line highLine = na
var line lowLine = na
var label highLabel = na
var label lowLabel  = na
var label titleLabel = na

var int breakDirection = 0 // 1 for High Break, -1 for Low Break
var bool sessionActive = false
var bool allowFVGs = false

isNewSession = inSession and not inSession[1]
isSessionEnd = not inSession and inSession[1]

// Reset state on new session
if isNewSession
    rangeHigh := high
    rangeLow  := low
    breakDirection := 0
    sessionActive := true
    allowFVGs := false
    
    // Clear old boxes from the previous day
    if activeBullZones.size() > 0
        for i = activeBullZones.size() - 1 to 0
            box.delete(activeBullZones.get(i).bx)
    if activeBearZones.size() > 0
        for i = activeBearZones.size() - 1 to 0
            box.delete(activeBearZones.get(i).bx)
    if activeBullOBs.size() > 0
        for i = activeBullOBs.size() - 1 to 0
            box.delete(activeBullOBs.get(i).bx)
    if activeBearOBs.size() > 0
        for i = activeBearOBs.size() - 1 to 0
            box.delete(activeBearOBs.get(i).bx)
            
    activeBullZones.clear()
    activeBearZones.clear()
    activeBullOBs.clear()
    activeBearOBs.clear()
    pendingBullFVGs.clear()
    pendingBearFVGs.clear()
    
else if inSession
    rangeHigh := math.max(rangeHigh, high)
    rangeLow  := math.min(rangeLow, low)

if isSessionEnd
    sessionActive := false
    allowFVGs := true
    highLine := line.new(bar_index - 1, rangeHigh, bar_index, rangeHigh, color = colorWait, width = 2)
    lowLine  := line.new(bar_index - 1, rangeLow,  bar_index, rangeLow,  color = colorWait, width = 2)

// Detect Breaks
if not inSession and not sessionActive and breakDirection == 0
    if high > rangeHigh
        breakDirection := 1
        line.set_color(highLine, colorHighLine)
        label.new(bar_index, high, "High Break\n▼", color=#00000000, textcolor=colorHighLine, style=label.style_label_down)
    else if low < rangeLow
        breakDirection := -1
        line.set_color(lowLine, colorLowLine)
        label.new(bar_index, low, "▲\nLow Break", color=#00000000, textcolor=colorLowLine, style=label.style_label_up)

// Update lines and main labels
if not inSession and not na(highLine) and not na(lowLine)
    line.set_x2(highLine, bar_index + 20)
    line.set_x2(lowLine,  bar_index + 20)

    color hColor = breakDirection == 1 ? colorHighLine : colorWait
    color lColor = breakDirection == -1 ? colorLowLine : colorWait

    if barstate.islast
        if na(highLabel)
            highLabel := label.new(bar_index + 20, rangeHigh, "High: " + str.tostring(rangeHigh, format.mintick), color = color.new(hColor, 100), textcolor = hColor, style = label.style_label_left, size = size.normal)
            lowLabel  := label.new(bar_index + 20, rangeLow, "Low: " + str.tostring(rangeLow, format.mintick), color = color.new(lColor, 100), textcolor = lColor, style = label.style_label_left, size = size.normal)
        else
            label.set_xy(highLabel, bar_index + 20, rangeHigh)
            label.set_text(highLabel, "High: " + str.tostring(rangeHigh, format.mintick))
            label.set_textcolor(highLabel, hColor)
            
            label.set_xy(lowLabel, bar_index + 20, rangeLow)
            label.set_text(lowLabel, "Low: " + str.tostring(rangeLow, format.mintick))
            label.set_textcolor(lowLabel, lColor)

        int centerX = math.round(math.avg(line.get_x1(highLine), bar_index + 20))
        float midY = math.avg(rangeHigh, rangeLow)
        string titleText = breakDirection == 0 ? "Waiting for break" : "8am"
        float titleY = breakDirection == 0 ? midY : rangeHigh
        string styleDir = breakDirection == 0 ? label.style_label_center : label.style_label_down
        
        if na(titleLabel)
            titleLabel := label.new(centerX, titleY, titleText, color = color.new(color.white, 100), textcolor = chart.fg_color, style = styleDir, size = size.large, force_overlay = true)
        else
            label.set_xy(titleLabel, centerX, titleY)
            label.set_text(titleLabel, titleText)
            label.set_style(titleLabel, styleDir)

bool showBearish = (breakDirection == 1)
bool showBullish = (breakDirection == -1)

// Detect Bullish FVG (Ensure the first candle of the FVG formed AFTER 9am)
if allowFVGs[2] and low > high[2]
    array.push(pendingBullFVGs, FVG.new(low, high[2], bar_index[2], true))

// Detect Bearish FVG (Ensure the first candle of the FVG formed AFTER 9am)
if allowFVGs[2] and high < low[2]
    array.push(pendingBearFVGs, FVG.new(low[2], high, bar_index[2], true))

// Check for IFVG Inversions (Only if direction allows)
if showBearish and showIFVG and pendingBullFVGs.size() > 0
    for i = pendingBullFVGs.size() - 1 to 0
        FVG f = pendingBullFVGs.get(i)
        if f.active and close < f.bot // Price closed below bullish FVG -> Bearish IFVG
            f.active := false
            bx = box.new(f.startIdx, f.top, bar_index + extendBars, f.bot, bgcolor=colorBearIFVG, border_color=color.new(colorBearIFVG, 50), text="IFVG", text_color=color.new(color.white, 0), text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
            activeBearZones.push(ActiveZone.new(bx, f.top, f.bot, bar_index))
            if activeBearZones.size() > maxZones
                removedZone = activeBearZones.shift()
                box.delete(removedZone.bx)

if showBullish and showIFVG and pendingBearFVGs.size() > 0
    for i = pendingBearFVGs.size() - 1 to 0
        FVG f = pendingBearFVGs.get(i)
        if f.active and close > f.top // Price closed above bearish FVG -> Bullish IFVG
            f.active := false
            bx = box.new(f.startIdx, f.top, bar_index + extendBars, f.bot, bgcolor=colorBullIFVG, border_color=color.new(colorBullIFVG, 50), text="IFVG", text_color=color.new(color.white, 0), text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
            activeBullZones.push(ActiveZone.new(bx, f.top, f.bot, bar_index))
            if activeBullZones.size() > maxZones
                removedZone = activeBullZones.shift()
                box.delete(removedZone.bx)

// Check for OBs (Ensure the first candle formed AFTER 9am)
isBullishOB = close > open and close[1] < open[1] and close > high[1] // Bullish Engulfing
isBearishOB = close < open and close[1] > open[1] and close < low[1]  // Bearish Engulfing

if showBullish and showOB and allowFVGs[1] and isBullishOB
    bx = box.new(bar_index[1], high[1], bar_index + extendBars, low[1], bgcolor=colorBullOB, border_color=color.new(colorBullOB, 50), text="OB", text_color=color.new(color.white, 0), text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
    activeBullOBs.push(ActiveZone.new(bx, high[1], low[1], bar_index))
    if activeBullOBs.size() > maxZones
        removedZone = activeBullOBs.shift()
        box.delete(removedZone.bx)

if showBearish and showOB and allowFVGs[1] and isBearishOB
    bx = box.new(bar_index[1], high[1], bar_index + extendBars, low[1], bgcolor=colorBearOB, border_color=color.new(colorBearOB, 50), text="OB", text_color=color.new(color.white, 0), text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
    activeBearOBs.push(ActiveZone.new(bx, high[1], low[1], bar_index))
    if activeBearOBs.size() > maxZones
        removedZone = activeBearOBs.shift()
        box.delete(removedZone.bx)

// Check Mitigation to delete boxes
method checkMitigation(ActiveZone[] zones, bool isBull) =>
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            ActiveZone z = zones.get(i)
            // Only check mitigation on candles AFTER the zone was formed
            if bar_index > z.startIdx
                if isBull and low <= z.bot
                    box.delete(z.bx)
                    zones.remove(i)
                else if not isBull and high >= z.top
                    box.delete(z.bx)
                    zones.remove(i)

checkMitigation(activeBullZones, true)
checkMitigation(activeBearZones, false)
checkMitigation(activeBullOBs, true)
checkMitigation(activeBearOBs, false)