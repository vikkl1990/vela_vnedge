//@version=6
indicator("Flow State Levels Pro", overlay=true, max_lines_count=500, max_labels_count=500)

// ───────── SETTINGS ─────────
showSignals = input.bool(true,"Show Buy/Sell Signals")

confirmSweep = input.bool(true,"Require Liquidity Sweep")
confirmReclaim = input.bool(true,"Require Level Reclaim")

cooldownBars = input.int(5,"Signal Cooldown")

levelColor = input.color(color.teal,"Level Color")
levelWidth = input.int(1,"Level Thickness")

// ───────── LEVEL DISPLAY CONTROL ─────────
limitLevels = input.bool(true,"Show Only Nearest Levels")
levelsToShow = input.int(30,"Levels Visible")

highlightClosest = input.bool(true,"Highlight Closest Levels")
highlightCount = input.int(10,"Highlighted Levels")

// ───────── EMA SETTINGS ─────────
ema1Toggle = input.bool(true,"Show EMA 1")
ema1Length = input.int(9,"EMA 1 Length")
ema1Color = input.color(color.yellow)

ema2Toggle = input.bool(true,"Show EMA 2")
ema2Length = input.int(21,"EMA 2 Length")
ema2Color = input.color(color.orange)

ema3Toggle = input.bool(true,"Show EMA 3")
ema3Length = input.int(50,"EMA 3 Length")
ema3Color = input.color(color.red)

signalEMA = input.string("EMA3","Signal EMA",options=["EMA1","EMA2","EMA3"])
emaStackToggle = input.bool(false,"Require EMA Stack Confirmation")

// ───────── GAMMA ─────────
gammaToggle = input.bool(false,"Enable Gamma Levels")

zeroGamma = input.float(0,"Zero Gamma")
callWall = input.float(0,"Call Wall")
putWall = input.float(0,"Put Wall")

// ───────── MONEY FLOW PROFILE ─────────
enableProfile = input.bool(false,"Enable Money Flow Profile")
profileLookback = input.int(300,"Profile Lookback")
profileRows = input.int(24,"Profile Rows")

bullColor = input.color(color.green,"Bull Flow")
bearColor = input.color(color.red,"Bear Flow")

// ───────── OBJECT STORAGE ─────────
var line[] levelLines = array.new_line()
var line[] gammaLines = array.new_line()
var label[] signalLabels = array.new_label()
var box[] profileBoxes = array.new_box()

// ───────── ADD SPY LEVELS ─────────
extraSpyLevels = input.string("", "Add SPY Levels")

// ───────── EXTRA TICKERS ─────────
extraTicker1 = input.symbol("", "Extra Ticker 1")
extraLevels1 = input.string("", "Levels")

extraTicker2 = input.symbol("", "Extra Ticker 2")
extraLevels2 = input.string("", "Levels")

extraTicker3 = input.symbol("", "Extra Ticker 3")
extraLevels3 = input.string("", "Levels")

// ───────── BASE SPY LEVEL LIST ─────────
var float[] spy = array.from(
501.27,501.85,504.58,505.96,506.84,507.88,508.65,508.8,509.65,
511.15,511.72,512.29,512.88,515.04,515.91,516.87,518.36,518.42,
519.81,520.43,520.91,521.41,522.14,522.5,522.89,523.49,525.83,
528.65,529.54,529.64,531.15,533.11,534.62,536.89,538.25,541.45,
542.72,544.28,546.86,548.24,548.81,551.63,552.64,553.31,554.71,
555.3,556.55,558.1,559.62,561.25,562.31,563.84,564.84,567.72,
569.08,569.57,570.82,571.62,572.28,574.05,576.07,577.26,579.55,
581.45,582.34,584.06,585.64,588.03,589.44,591.13,593.47,595.65,
596.79,597.88,598.46,599.88,600.94,602.17,603.65,604.37,606.56,
607.58,609.73,611.38,612.91,614.98,618.17,620.52,624.1,624.77,
625.7,627.64,630.29,631.98,633.84,636.83,638.09,639.63,642.78,
643.34,644.85,646.97,648.82,650.26,652.21,657.64,660.7,663.2,
665.45,666.74,668.59,671.61,672.94,675.05,676.94,680.01,681.84,
683.05,685.27,686.84,688.99,690.36,691.9,694.06,695.21)

// ───────── BUILD SPX / ES ─────────
var float[] spx = array.new_float()
var float[] es = array.new_float()

if barstate.isfirst
    for i=0 to array.size(spy)-1
        v=array.get(spy,i)
        array.push(spx,v*10)
        array.push(es,v*10)

// ───────── SELECT LEVELS ─────────
var float[] levels = array.new_float()

sym = syminfo.ticker

if barstate.isfirst
    if sym=="SPY"
        levels:=spy
    else if sym=="SPX"
        levels:=spx
    else if str.contains(sym,"ES")
        levels:=es

// ───────── EMA CALCULATIONS ─────────
ema1 = ta.ema(close,ema1Length)
ema2 = ta.ema(close,ema2Length)
ema3 = ta.ema(close,ema3Length)

plot(ema1Toggle?ema1:na,"EMA1",ema1Color,signalEMA=="EMA1"?3:1)
plot(ema2Toggle?ema2:na,"EMA2",ema2Color,signalEMA=="EMA2"?3:1)
plot(ema3Toggle?ema3:na,"EMA3",ema3Color,signalEMA=="EMA3"?3:1)

emaSignal = signalEMA=="EMA1"?ema1:signalEMA=="EMA2"?ema2:ema3

bullStack = ema1>ema2 and ema2>ema3
bearStack = ema1<ema2 and ema2<ema3

// ───────── DRAW LEVELS ─────────
if barstate.isnew

    if array.size(levelLines) > 0
        for i = array.size(levelLines)-1 to 0
            line.delete(array.get(levelLines,i))
        array.clear(levelLines)

    for i=0 to array.size(levels)-1
        lvl=array.get(levels,i)
        dist=math.abs(close-lvl)

        show=true
        if limitLevels
            show:=dist<50

        if show
            l=line.new(bar_index-10000,lvl,bar_index+1,lvl,
            extend=extend.right,
            color=highlightClosest and dist<10?color.yellow:levelColor,
            width=highlightClosest and dist<10?levelWidth+1:levelWidth)

            array.push(levelLines,l)

// ───────── SIGNAL ENGINE ─────────
var int lastSignal=na

buy=false
sell=false

for i=0 to array.size(levels)-1

    lvl=array.get(levels,i)

    sweepBelow=low<lvl and close>lvl
    sweepAbove=high>lvl and close<lvl

    reclaimUp=close>lvl
    reclaimDown=close<lvl

    longConfirm=(confirmSweep?sweepBelow:true) and (confirmReclaim?reclaimUp:true)
    shortConfirm=(confirmSweep?sweepAbove:true) and (confirmReclaim?reclaimDown:true)

    longConfirm:=longConfirm and close>emaSignal
    shortConfirm:=shortConfirm and close<emaSignal

    if emaStackToggle
        longConfirm:=longConfirm and bullStack
        shortConfirm:=shortConfirm and bearStack

    buy:=buy or longConfirm
    sell:=sell or shortConfirm

allow=na(lastSignal) or bar_index-lastSignal>cooldownBars

if showSignals and allow

    if buy
        lbl=label.new(bar_index,low,"BUY",style=label.style_label_up,color=color.green,textcolor=color.white)
        array.push(signalLabels,lbl)
        lastSignal:=bar_index

    if sell
        lbl=label.new(bar_index,high,"SELL",style=label.style_label_down,color=color.red,textcolor=color.white)
        array.push(signalLabels,lbl)
        lastSignal:=bar_index

// ───────── GAMMA LEVELS ─────────
if gammaToggle

    if array.size(gammaLines) > 0
        for i=array.size(gammaLines)-1 to 0
            line.delete(array.get(gammaLines,i))
        array.clear(gammaLines)

    if zeroGamma>0
        g=line.new(bar_index-10000,zeroGamma,bar_index+1,zeroGamma,extend=extend.right,color=color.orange,width=3)
        array.push(gammaLines,g)

    if callWall>0
        g=line.new(bar_index-10000,callWall,bar_index+1,callWall,extend=extend.right,color=color.green,width=3)
        array.push(gammaLines,g)

    if putWall>0
        g=line.new(bar_index-10000,putWall,bar_index+1,putWall,extend=extend.right,color=color.red,width=3)
        array.push(gammaLines,g)

// ───────── MONEY FLOW PROFILE ─────────
lowRange = ta.lowest(low,profileLookback)
highRange = ta.highest(high,profileLookback)

profileOffset = 40

if enableProfile and barstate.islastconfirmedhistory

    if array.size(profileBoxes) > 0
        for i=array.size(profileBoxes)-1 to 0
            box.delete(array.get(profileBoxes,i))
        array.clear(profileBoxes)

    step=(highRange-lowRange)/profileRows

    for r=0 to profileRows-1

        lvlLow=lowRange+step*r
        lvlHigh=lvlLow+step

        vol=0.0
        bull=0.0

        for i=0 to math.min(profileLookback,bar_index)

            if high[i]>=lvlLow and low[i]<lvlHigh

                v=volume[i]
                vol+=v

                if close[i]>open[i]
                    bull+=v

        bear=vol-bull
        width=math.min(int(vol/1000000),60)

        c=bull>bear?bullColor:bearColor

        b=box.new(bar_index+profileOffset,lvlLow,bar_index+profileOffset+width,lvlHigh,bgcolor=c,border_color=c)

        array.push(profileBoxes,b)