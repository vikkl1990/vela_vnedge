//@version=6
indicator("SMI Ergodic", "SMIE", overlay = false, format = format.price, precision = 4)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
DISPLAY_INDICATOR  = "Indicator"
DISPLAY_OSCILLATOR = "Oscillator"

BULL_COLOR    = #089981 // SMI above its signal, histogram rising
BEAR_COLOR    = #f23645 // SMI below its signal, histogram falling
NEUTRAL_COLOR = #787b86 // zero line, SMI while flat against its signal
ACCENT_COLOR  = #ff9800 // the signal line - the one reference to cross
FILL_TRANSP   = 75      // transparency of the SMI / signal spread fill

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
longLengthInput   = input.int(20, "Long Length", minval = 1, group = "Settings", tooltip = "Length of the first EMA smoothing applied to the momentum of the closing price.")
shortLengthInput  = input.int(5, "Short Length", minval = 1, group = "Settings", tooltip = "Length of the second EMA smoothing applied to the momentum of the closing price.")
signalLengthInput = input.int(5, "Signal Length", minval = 1, group = "Settings", tooltip = "Length of the EMA of the SMI that forms the signal line.")
displayInput      = input.string(DISPLAY_INDICATOR, "Display", options = [DISPLAY_INDICATOR, DISPLAY_OSCILLATOR], group = "Settings", tooltip = "Indicator plots the SMI and its signal line. Oscillator plots the difference between the SMI and its signal line as a histogram.")

smiColorInput    = input.color(NEUTRAL_COLOR, "SMI", group = "Style", tooltip = "Color of the SMI line while it sits exactly on its signal line. Above the signal the line takes the grow color, below it the fall color.")
signalColorInput = input.color(ACCENT_COLOR, "Signal", group = "Style", tooltip = "Color of the signal line.")
growColorInput   = input.color(BULL_COLOR, "Oscillator Grow", group = "Style", tooltip = "Color of the oscillator histogram when it is rising, and of the SMI line and spread fill while the SMI is above its signal.")
fallColorInput   = input.color(BEAR_COLOR, "Oscillator Fall", group = "Style", tooltip = "Color of the oscillator histogram when it is falling, and of the SMI line and spread fill while the SMI is below its signal.")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
smi    = ta.tsi(close, shortLengthInput, longLengthInput)
signal = ta.ema(smi, signalLengthInput)
osc    = smi - signal

showIndicator = displayInput == DISPLAY_INDICATOR

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// SMI colored by its side of the signal line - the crossing is the trade
smiColor = smi > signal ? growColorInput : smi < signal ? fallColorInput : smiColorInput

smiPlotId    = plot(showIndicator ? smi : na, "SMI", smiColor)
signalPlotId = plot(showIndicator ? signal : na, "Signal", signalColorInput)
plot(showIndicator ? na : osc, "Oscillator", osc > osc[1] ? growColorInput : fallColorInput, style = plot.style_columns)

fill(smiPlotId, signalPlotId, color.new(smiColor, FILL_TRANSP), "SMI / Signal Spread")

hline(0, "Zero", color.new(NEUTRAL_COLOR, 50), hline.style_dashed)

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(ta.crossover(smi, signal), "Bullish Cross", "SMI Ergodic crossed above its signal line")
alertcondition(ta.crossunder(smi, signal), "Bearish Cross", "SMI Ergodic crossed below its signal line")
alertcondition(ta.crossover(smi, 0), "Bullish Zero Cross", "SMI Ergodic crossed above zero")
alertcondition(ta.crossunder(smi, 0), "Bearish Zero Cross", "SMI Ergodic crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
