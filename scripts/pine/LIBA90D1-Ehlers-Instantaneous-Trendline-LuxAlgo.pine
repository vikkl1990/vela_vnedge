//@version=6
indicator("Ehlers Instantaneous Trendline", shorttitle = "Ehlers Instantaneous Trendline", overlay = true)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
WARMUP_BARS         = 7    // Ehlers' published warm-up span — the FIR average is used until the recursion has history
BULL_COLOR          = #089981
BEAR_COLOR          = #f23645
FILL_TRIGGER_TRANSP = 60   // gradient transparency at the trigger end of the fill
FILL_TREND_TRANSP   = 100  // gradient transparency at the trendline end of the fill
TRIGGER_TRANSP      = 40   // trigger line transparency, keeps the pair distinguishable

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput   = input.source(hl2, "Source", group = "Settings",
     tooltip = "Price series the trendline is computed on. Ehlers' published construction uses the bar midpoint hl2 = (high + low) / 2.")

alphaInput = input.float(0.07, "Alpha", minval = 0.01, maxval = 1, step = 0.01, group = "Settings",
     tooltip = "Smoothing coefficient of the recursive filter. Ehlers' published default is 0.07 — smaller values give a smoother, slower trendline, larger values make it hug price more closely. The recursion is seeded with na and the first bars of history use Ehlers' FIR warm-up average, so the line only appears a few bars into the chart and the trigger two bars after that.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style",
     tooltip = "Pair and fill color while the trigger holds above the trendline — the conventional long bias.")

bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style",
     tooltip = "Pair and fill color while the trigger holds below the trendline — the conventional short bias.")

showFillInput    = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the span between the trendline and the trigger with a vertical gradient in the cross-state color, strongest at the trigger and fading to fully transparent at the trendline — wide trending separation glows while tight braided stretches stay quiet.")

showMarkersInput = input.bool(false, "Crossover Markers", group = "Style",
     tooltip = "Displays a small circle on the trendline where the trigger crosses it. Off by default to keep the chart clean — the crossover alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Ehlers' simplified Instantaneous Trendline — the published single-alpha recursion
// (John Ehlers, "Cybernetic Analysis for Stocks and Futures", 2004):
//   ITrend = (a - a^2/4)*P + (a^2/2)*P[1] - (a - 3a^2/4)*P[2] + 2(1 - a)*ITrend[1] - (1 - a)^2*ITrend[2]
// Warm-up per Ehlers' convention: the recursion is seeded with na — no output at all until two bars of
// source history exist, then bars below WARMUP_BARS take the FIR average (P + 2*P[1] + P[2]) / 4, and
// the full recursion runs from there on.
instantaneousTrendline(float src, simple float a) =>
    c1 = a - a * a / 4
    c2 = 0.5 * a * a
    c3 = a - 0.75 * a * a
    c4 = 2 * (1 - a)
    c5 = (1 - a) * (1 - a)
    float itrend = na
    if bar_index >= WARMUP_BARS
        itrend := c1 * src + c2 * src[1] - c3 * src[2] + c4 * itrend[1] - c5 * itrend[2]
    else if bar_index >= 2
        itrend := (src + 2 * src[1] + src[2]) / 4
    itrend

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// na-proof source — the recursive filter must never ingest na mid-series
float src = nz(srcInput, close)

itrend = instantaneousTrendline(src, alphaInput)

// Trigger — the lag-reduced projection of the trendline (twice the current value minus the value from
// two bars back). It needs trendline history, so it starts two bars after the trendline does.
trigger = 2 * itrend - itrend[2]

// Cross state and crossover events — Ehlers' classic entry/exit read of the pair
bullish   = trigger >= itrend
crossUp   = ta.crossover(trigger, itrend)
crossDown = ta.crossunder(trigger, itrend)

// Slope reversals of the trendline — the moving-average style trend bias read
slope         = itrend - nz(itrend[1], itrend)
slopeTurnUp   = slope > 0 and nz(slope[1]) <= 0
slopeTurnDown = slope < 0 and nz(slope[1]) >= 0

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
stateColor = bullish ? bullColorInput : bearColorInput

fillTopColor    = showFillInput ? color.new(stateColor, bullish ? FILL_TRIGGER_TRANSP : FILL_TREND_TRANSP) : na
fillBottomColor = showFillInput ? color.new(stateColor, bullish ? FILL_TREND_TRANSP : FILL_TRIGGER_TRANSP) : na

itrendPlotId  = plot(itrend, "Trendline", color = stateColor, linewidth = 2)
triggerPlotId = plot(trigger, "Trigger", color = color.new(stateColor, TRIGGER_TRANSP))

fill(itrendPlotId, triggerPlotId, top_value = math.max(itrend, trigger), bottom_value = math.min(itrend, trigger), top_color = fillTopColor, bottom_color = fillBottomColor, title = "Trendline / Trigger Gradient Fill")

plotshape(showMarkersInput and crossUp ? itrend : na, "Bullish Cross", shape.circle, location.absolute, color = bullColorInput, size = size.tiny)
plotshape(showMarkersInput and crossDown ? itrend : na, "Bearish Cross", shape.circle, location.absolute, color = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Bullish Trigger Cross", "Trigger crossed above the Instantaneous Trendline on {{ticker}} ({{interval}})")
alertcondition(crossDown, "Bearish Trigger Cross", "Trigger crossed below the Instantaneous Trendline on {{ticker}} ({{interval}})")
alertcondition(slopeTurnUp, "Trendline Slope Up", "Instantaneous Trendline slope turned upward on {{ticker}} ({{interval}})")
alertcondition(slopeTurnDown, "Trendline Slope Down", "Instantaneous Trendline slope turned downward on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
