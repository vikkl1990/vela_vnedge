//@version=6
indicator("VP/CD Active Relevance Radius", "VP/CD Rails",
     overlay = true, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

//==================================================================================================
// HARD VISUAL CONSTANTS
//==================================================================================================
white20       = color.new(color.white, 80)
priceLabelBg  = color.new(chart.fg_color, 89)
priceLabelFg  = chart.fg_color

// Semantic fixed colors. Kept non-user-configurable to prevent visual meaning drift.
supportFillBase     = color.new(color.lime, 88)
supportBorderBase   = color.new(color.lime, 45)
resistFillBase      = color.new(color.red, 88)
resistBorderBase    = color.new(color.red, 45)
insideFillBase      = color.new(color.teal, 88)
insideBorderBase    = color.new(color.teal, 45)
lvnFillBase         = color.new(color.orange, 98)  // v2.4: AIR/LVN is intentionally weak; it is a corridor, not a shelf
lvnBorderBase       = color.new(color.orange, 78)
staleFillBase       = color.new(color.gray, 93)
staleBorderBase     = color.new(color.gray, 78)
reclaimedFillBase   = color.new(color.green, 82)
reclaimedBorderBase = color.new(color.green, 25)
flippedFillBase     = color.new(color.maroon, 84)
flippedBorderBase   = color.new(color.red, 30)
neutralFillBase     = color.new(color.gray, 88)
neutralBorderBase   = color.new(color.gray, 60)

// v2.1.1 source-strength hierarchy. Confluence must visually outrank single-source estimates.
confSupportFill     = color.new(color.lime, 84)
confSupportBorder   = color.new(color.lime, 24)
confResistFill      = color.new(color.red, 84)
confResistBorder    = color.new(color.red, 24)
confInsideFill      = color.new(color.teal, 84)
confInsideBorder    = color.new(color.teal, 24)
vpSupportFill       = color.new(color.lime, 89)
vpSupportBorder     = color.new(color.lime, 48)
vpResistFill        = color.new(color.red, 89)
vpResistBorder      = color.new(color.red, 48)
vpInsideFill        = color.new(color.teal, 89)
vpInsideBorder      = color.new(color.teal, 48)
chipSupportFill     = color.new(color.lime, 93)
chipSupportBorder   = color.new(color.lime, 66)
chipResistFill      = color.new(color.red, 93)
chipResistBorder    = color.new(color.red, 66)
chipInsideFill      = color.new(color.teal, 93)
chipInsideBorder    = color.new(color.teal, 66)

// v2.2.1 Phase 2: price-memory fallback. These are deliberately lower-authority
// than C-HVN/VP-HVN because they come from repeated price reactions, not accepted volume.
pmSupportFill       = color.new(color.lime, 91)
pmSupportBorder     = color.new(color.lime, 50)
pmResistFill        = color.new(color.red, 91)
pmResistBorder      = color.new(color.red, 50)
pmInsideFill        = color.new(color.teal, 91)
pmInsideBorder      = color.new(color.teal, 50)
airPmFillBase       = color.new(color.orange, 96)
airPmBorderBase     = color.new(color.orange, 62)

// v2.3 structural memory. Same support/resistance color semantics as HVN zones,
// but visually lower authority than raw VP + chip confluence.
structSupportFill   = color.new(color.lime, 90)
structSupportBorder = color.new(color.lime, 52)
structResistFill    = color.new(color.red, 90)
structResistBorder  = color.new(color.red, 52)
structInsideFill    = color.new(color.teal, 90)
structInsideBorder  = color.new(color.teal, 52)
openSkyBg           = color.new(color.orange, 74)
openSkyFg           = chart.fg_color
openSkyLineColor    = color.new(color.orange, 55)

// v2.5 developing-memory and warning visuals. DEV is lower authority than mature HVN/STRUCT/PM.
devSupportFill      = color.new(color.lime, 94)
devSupportBorder    = color.new(color.lime, 58)
devResistFill       = color.new(color.red, 94)
devResistBorder     = color.new(color.red, 58)
devInsideFill       = color.new(color.teal, 94)
devInsideBorder     = color.new(color.teal, 58)
devNeutralFill      = color.new(color.blue, 95)
devNeutralBorder    = color.new(color.blue, 66)
lowMapBg            = color.new(color.red, 72)
lowMapFg            = chart.fg_color

//==================================================================================================
// INPUTS — ADAPTIVE TIMEFRAME ROUTING
// Auto mode detects 12H extended, 1D, 2D-4D, and 1W+ charts.
// Manual override groups are ignored unless Preset Mode = Manual. Diagnostic controls affect Diagnostic mode only.
//==================================================================================================
groupDisplay = "01 Display Mode"
groupCore = "02 Core Profile + Value Area — Adaptive by Timeframe"
groupShelf = "03 Inventory Pressure Rails + Memory Histogram"
groupPreset = "04 Preset / Timeframe Routing"
groupSources = "05 Memory Engines + Chip Model"
groupStatus = "06 Status + Map Warnings"
groupManualZone = "07 Manual Overrides — Zones + Lifecycle (used only in Manual preset)"
groupManualMemory = "08 Manual Overrides — Recent Value + PM + STRUCT + DEV (used only in Manual preset)"
groupManualGuard = "09 Manual Overrides — Guards + Chip Fallback (used only in Manual preset)"
groupAdvanced = "10 Advanced Engine — Always Active"
groupDiagnostic = "11 Diagnostic Mode Only — Zones, Labels, Tables"
groupExternal = "12 External Microstructure Calibration — M6A.2 + Radius Shadow"

// 01 Display Mode
vis_visualMode = input.string("Pressure Rails", "Display Mode", options=["Pressure Rails", "Memory Shelf Histogram", "Diagnostic"], group=groupDisplay)

// 02 Core Profile + Value Area — Adaptive by Timeframe
vp_profileRouting = input.string("Auto by chart timeframe", "Core Profile Routing", options=["Auto by chart timeframe", "Manual"], group=groupCore)
vp_profileDays = input.int(252, "Manual Profile Lookback (Days)", minval=1, maxval=3650, group=groupCore)
vp_profileNumberOfRows = input.int(44, "Manual Profile Resolution / Rows", minval=10, maxval=130, group=groupCore)
vp_valueAreaThreshold = input.float(70, "Value Area (%)", minval=1, maxval=100, group=groupCore) / 100
vp_emphasizeValueArea = input.bool(true, "Emphasize Value Area Rows", group=groupCore)
vp_showValueAreaMarkers = input.bool(true, "Show VAH / VAL / POC Markers", group=groupCore)

// 03 Memory Shelf Histogram — Always User Controlled
v280_histAnchorSide = input.string("Left Edge (extends right)", "Histogram Anchor Side", options=["Left Edge (extends right)", "Right Edge (extends left)"], tooltip="Left Edge anchors shelves to the first candle of the effective profile lookback and extends them right. In Manual routing, this is the candle defined by Manual Profile Lookback (Days). Right Edge anchors shelves to the live bar and extends them left.", group=groupShelf)
v276_shelfMaxLen = input.int(120, "Maximum Rail / Shelf Length", minval=5, maxval=500, tooltip="Pressure Rails: maximum horizontal length assigned to a 100 Pressure Score rail. Memory Histogram: maximum shelf length.", group=groupShelf)
v276_shelfMinLen = input.int(4, "Minimum Rail / Shelf Length", minval=0, maxval=30, group=groupShelf)
v276_shelfContrast = input.string("Strong", "Shelf Strength Contrast", options=["Balanced", "Strong", "Extreme"], group=groupShelf)
v276_minStrength = input.float(42.0, "Hide Shelves Below Authority (%)", minval=0.0, maxval=50.0, step=1.0, tooltip="Relative authority floor versus the strongest final zone. Mandatory current/support/resistance shelves may remain visible below this floor; generic shelves must also pass an internal absolute-authority minimum.", group=groupShelf) / 100.0
v276_memoryShelfColor = input.color(color.rgb(0, 125, 255), "Pressure Rail / Memory Color", group=groupShelf)
v300_railMinScore = input.float(22.0, "Pressure Rail Minimum Score", minval=0.0, maxval=95.0, step=1.0, tooltip="Absolute 0-100 pressure floor. Length is based on the same score; weak maps therefore do not automatically receive full-length rails.", group=groupShelf)
v300_railMaxCount = input.int(18, "Maximum Pressure Rails", minval=3, maxval=40, group=groupShelf)
v300_railThickness = input.float(0.14, "Rail Thickness (profile-row fraction)", minval=0.04, maxval=0.35, step=0.01, tooltip="Keeps rails thin and independent. 0.14 means the rail uses 14% of one profile row vertically.", group=groupShelf)
v278_showImportantShelfPrices = input.bool(true, "Show Important Shelf Prices", group=groupShelf)
v278_importantShelfCount = input.int(3, "Important Shelf Labels", minval=1, maxval=5, group=groupShelf)
v278_importantShelfMinStrength = input.float(65.0, "Important Shelf Minimum Authority (%)", minval=30.0, maxval=100.0, step=5.0, group=groupShelf) / 100.0
v278_shelfPriceMode = input.string("Zone Range", "Important Shelf Price Format", options=["Zone Range", "Center Price"], group=groupShelf)
v278_shelfPricePosition = input.string("Right End", "Important Shelf Price Position", options=["Left End", "Center", "Right End"], tooltip="Places each important price label at the left end, center, or right end of its own shelf. This setting is independent of the histogram anchor side.", group=groupShelf)

// 04 Preset / Timeframe Routing
// Auto recognizes 12H extended, 1D, 2D-4D, and 1W+; 12H uses the 1D structural thresholds with its own core profile depth.
v27_presetMode = input.string("Auto by chart timeframe", "Preset Mode", options=["Auto by chart timeframe", "12H Extended Context", "1D Entry Map", "2D Swing Confirmation Map", "1W Position Map", "Manual"], group=groupPreset)

// 05 Memory Engines + Chip Model
v21_useHybridConfluence = input.bool(true, "Use VP + Chip Confluence for Zones", group=groupSources)
v21_vpConfirmMin = input.float(0.25, "VP High-Node Threshold", minval=0.01, maxval=1.0, group=groupSources)
v21_chipConfirmMin = input.float(0.25, "Chip High-Node Threshold", minval=0.01, maxval=1.0, group=groupSources)
sr_includeTroughs = input.bool(true, "Also Include Trough Zones (LVNs / Air Pockets)", group=groupSources)
v221_usePriceMemory = input.bool(true, "Use Price-Memory Fallback", group=groupSources)
v23_useStructureMemory = input.bool(true, "Use Structural Memory Fallback", group=groupSources)
v25_useDevMemory = input.bool(true, "Use DEV Memory Bands", group=groupSources)
chip_useAsSource = input.bool(true, "Use Chip Distribution as Node Source", group=groupSources)
chip_useSharesOut = input.bool(true, "Use shares outstanding when available", group=groupSources)
chip_turnoverLen = input.int(20, "Turnover Avg Length (fallback)", minval=1, maxval=200, group=groupSources)
chip_turnoverScale = input.float(1.0, "Turnover Scale", minval=0.0, maxval=10.0, group=groupSources)

// 06 Status + Map Warnings
v21_showOpenSpaceLabel = input.bool(true, "Show Open-Space / Structure Status", group=groupStatus)
v211_showAbnormalWarning = input.bool(true, "Show Abnormal-Structure Warning", group=groupStatus)
v25_showLowMapCoverage = input.bool(true, "Show LOW MAP COVERAGE Warning", group=groupStatus)
v23_showOpenSky = input.bool(true, "Show Open-Sky Status", group=groupStatus)
v251_useBracketGuard = input.bool(true, "Use Bracket/Range Guard", group=groupStatus)
v251_useBrokenRecoveryGuard = input.bool(true, "Use Broken-Recovery Guard", group=groupStatus)

// 07 Manual Overrides — Zones + Lifecycle (used only in Manual preset)
sr_topN = input.int(10, "Show Top N Zones", minval=1, maxval=25, group=groupManualZone)
sr_atrFrac = input.float(0.25, "Zone Half-Width = max(priceStep, ATR * frac)", minval=0.01, maxval=2.0, group=groupManualZone)
sr_promMin = input.float(1.30, "Peak Prominence Min (vs local avg)", minval=1.0, maxval=10.0, group=groupManualZone)
sr_relToMaxMin = input.float(0.25, "Peak Min Relative to Max Node", minval=0.01, maxval=1.0, group=groupManualZone)
sr_mergeAtrFrac = input.float(0.50, "Merge Distance (ATR * frac)", minval=0.05, maxval=5.0, group=groupManualZone)
sr_decay = input.float(0.995, "Score Decay per Bar", minval=0.90, maxval=1.0, group=groupManualZone)
vis_battleAtrReach  = input.float(3.0, "Current Battle: Max ATR Distance", minval=0.25, maxval=25.0, group=groupManualZone)
vis_tradingAtrReach = input.float(6.0, "Trading Map: Max ATR Distance", minval=0.25, maxval=50.0, group=groupManualZone)
vis_tradingPctReach = input.float(40.0, "Trading Map: Max % Distance", minval=1.0, maxval=500.0, group=groupManualZone)
vis_recentTouchBars = input.int(30, "Active if touched within N bars", minval=1, maxval=500, group=groupManualZone)
vis_recentFlipBars = input.int(20, "Reclaimed/Flipped if crossed within N bars", minval=1, maxval=300, group=groupManualZone)
vis_staleTouchBars = input.int(120, "Stale if no touch after N bars", minval=10, maxval=2000, group=groupManualZone)
vis_lvnNearAtr = input.float(3.0, "LVN Near-Price Threshold (ATR)", minval=0.25, maxval=25.0, group=groupManualZone)

// 08 Manual Overrides — Recent Value + PM + STRUCT + DEV (used only in Manual preset)
v22_recentProfileDays = input.int(63, "Recent Profile Lookback (Days)", minval=5, maxval=1000, group=groupManualMemory)
v22_valueAtrThreshold = input.float(0.50, "Value Migration Threshold (ATR)", minval=0.05, maxval=5.0, group=groupManualMemory)
v221_pmLookbackDays = input.int(180, "PM Lookback (Days)", minval=5, maxval=3650, group=groupManualMemory)
v221_pmReactionAtr = input.float(0.40, "PM Reaction Band (ATR)", minval=0.05, maxval=2.0, group=groupManualMemory)
v221_pmMinSpanBars = input.int(10, "PM Min Time Span Between Reactions", minval=0, maxval=500, group=groupManualMemory)
v23_msLookbackDays = input.int(252, "Structure Lookback (Days)", minval=20, maxval=3650, group=groupManualMemory)
v23_msClusterAtr = input.float(0.35, "Structure Cluster Band (ATR)", minval=0.05, maxval=2.0, group=groupManualMemory)
v23_msMinSpanBars = input.int(15, "Structure Min Span Between Pivots", minval=0, maxval=1000, group=groupManualMemory)
v23_openSkyLookbackDays = input.int(252, "Open-Sky Lookback (Days)", minval=20, maxval=3650, group=groupManualMemory)
v23_openSkyResistanceAtr = input.float(3.0, "Open-Sky: Max True Resistance ATR", minval=0.25, maxval=25.0, group=groupManualMemory)
v25_devLookbackDays = input.int(34, "DEV Lookback (Days)", minval=5, maxval=365, group=groupManualMemory)
v25_devNearAtr = input.float(2.75, "DEV Max Distance From Price (ATR)", minval=0.25, maxval=15.0, group=groupManualMemory)

// 09 Manual Overrides — Guards + Chip Fallback (used only in Manual preset)
v25_lowMapAtrReach = input.float(2.50, "LOW MAP if no memory within ATR", minval=0.25, maxval=25.0, group=groupManualGuard)
v251_bracketLookbackDays = input.int(252, "Bracket Lookback (Days)", minval=20, maxval=3650, group=groupManualGuard)
v251_bracketMinRangeAtr = input.float(5.0, "Bracket: Min Range Width (ATR)", minval=1.0, maxval=80.0, group=groupManualGuard)
v251_bracketUpperSearchAtr = input.float(12.0, "Bracket: Upper Memory Search (ATR)", minval=1.0, maxval=80.0, group=groupManualGuard)
v251_brokenLookbackDays = input.int(252, "Broken Recovery Lookback (Days)", minval=20, maxval=3650, group=groupManualGuard)
v251_brokenDrawdownPct = input.float(32.0, "Broken Recovery: Min Drawdown %", minval=5.0, maxval=95.0, group=groupManualGuard)
v251_brokenDrawdownAtr = input.float(8.0, "Broken Recovery: Min Drawdown ATR", minval=2.0, maxval=100.0, group=groupManualGuard)
v251_brokenOverheadSearchAtr = input.float(16.0, "Broken Recovery: Overhead Search (ATR)", minval=1.0, maxval=100.0, group=groupManualGuard)
chip_avgTurnoverGuess = input.float(0.01, "Fallback Avg Turnover per Bar", minval=0.0, maxval=1.0, group=groupManualGuard)

// 10 Advanced Engine — Always Active
sr_atrLen = input.int(14, "ATR Length", minval=1, maxval=100, group=groupAdvanced)
sr_touchPts = input.float(1.0, "Score: Touch", minval=0.0, maxval=10.0, group=groupAdvanced)
sr_rejectPts = input.float(2.0, "Score: Valid Rejection", minval=0.0, maxval=20.0, group=groupAdvanced)
sr_breakPts = input.float(3.0, "Score: Confirmed Cross Penalty", minval=0.0, maxval=50.0, group=groupAdvanced)
sr_breakAtrFrac = input.float(0.20, "Cross Distance Confirm (ATR * frac)", minval=0.0, maxval=2.0, group=groupAdvanced)
sr_breakConsec = input.int(2, "Cross Confirm: Consecutive Closes Outside", minval=1, maxval=5, group=groupAdvanced)
sr_deltaStrong = input.float(0.15, "Polarity Bias Threshold (|deltaPct|)", minval=0.0, maxval=1.0, group=groupAdvanced)
vis_hideFarLvns = input.bool(true, "Ignore Far LVNs in Current Map", group=groupAdvanced)
v21_openSpaceAtr = input.float(3.0, "Open-Space HVN Search Distance (ATR)", minval=0.25, maxval=25.0, group=groupAdvanced)
v211_shockRangeAtr = input.float(4.0, "Shock Candle Threshold (Range / ATR)", minval=1.0, maxval=20.0, group=groupAdvanced)
v211_gapAtr = input.float(1.5, "Gap Threshold (Gap / ATR)", minval=0.25, maxval=10.0, group=groupAdvanced)
v211_maxShockBars = input.int(3, "Low Confidence if Shock Bars >=", minval=1, maxval=50, group=groupAdvanced)
v211_maxGapBars = input.int(3, "Low Confidence if Gap Bars >=", minval=1, maxval=50, group=groupAdvanced)
v211_lowPriceCaution = input.float(3.0, "Low-Price Caution Threshold", minval=0.0, maxval=100.0, group=groupAdvanced)
v22_recentNodeThreshold = input.float(0.30, "Recent HVN Threshold", minval=0.05, maxval=1.0, group=groupAdvanced)
v22_recentPocZoneBonus = input.float(1.50, "Relevance Bonus: Zone Aligns With Recent Value", minval=0.0, maxval=10.0, group=groupAdvanced)
v221_pmMinReactions = input.int(3, "PM Min Reactions", minval=2, maxval=25, group=groupAdvanced)
v221_pmMinScore = input.float(2.25, "PM Min Score", minval=0.5, maxval=100.0, group=groupAdvanced)
v221_pmMinNorm = input.float(0.18, "PM Min Relative to Max PM", minval=0.01, maxval=1.0, group=groupAdvanced)
v221_pmCloseDensityMin = input.int(5, "Close-Density PM: Min Closes", minval=2, maxval=100, group=groupAdvanced)
v221_pmUsePivotReactions = input.bool(true, "Use Pivot-Reaction PM", group=groupAdvanced)
v221_pmPivotLeft = input.int(3, "Pivot PM: Left Bars", minval=1, maxval=20, group=groupAdvanced)
v221_pmPivotRight = input.int(3, "Pivot PM: Right Bars", minval=1, maxval=20, group=groupAdvanced)
v221_pmPivotMinReactions = input.int(3, "Pivot PM: Min Reactions", minval=1, maxval=25, group=groupAdvanced)
v221_pmPivotWeight = input.float(1.50, "PM Score: Pivot Reaction", minval=0.0, maxval=20.0, group=groupAdvanced)
v221_pmCloseWeight = input.float(1.00, "PM Score: Close Acceptance", minval=0.0, maxval=10.0, group=groupAdvanced)
v221_pmWickWeight = input.float(0.75, "PM Score: Wick Reaction", minval=0.0, maxval=10.0, group=groupAdvanced)
v221_pmFailWeight = input.float(1.25, "PM Score: Failed Test / Retest", minval=0.0, maxval=10.0, group=groupAdvanced)
v221_pmDecay = input.float(0.997, "PM Recency Decay per Bar", minval=0.90, maxval=1.0, group=groupAdvanced)
v221_pmThinRawThreshold = input.float(0.22, "AIR+PM if Raw Volume <=", minval=0.01, maxval=1.0, group=groupAdvanced)
v221_pmScoreBonus = input.float(4.50, "Relevance Bonus: Price Memory", minval=0.0, maxval=20.0, group=groupAdvanced)
v23_msPivotLeft = input.int(4, "Structure Pivot: Left Bars", minval=1, maxval=30, group=groupAdvanced)
v23_msPivotRight = input.int(4, "Structure Pivot: Right Bars", minval=1, maxval=30, group=groupAdvanced)
v23_msMinTouches = input.int(3, "Structure Min Pivot Touches", minval=2, maxval=30, group=groupAdvanced)
v23_msMinScore = input.float(2.50, "Structure Min Score", minval=0.5, maxval=100.0, group=groupAdvanced)
v23_msMinNorm = input.float(0.20, "Structure Min Relative to Max", minval=0.01, maxval=1.0, group=groupAdvanced)
v23_msPivotWeight = input.float(1.25, "Structure Score: Pivot Touch", minval=0.0, maxval=20.0, group=groupAdvanced)
v23_msMixedSideBonus = input.float(1.00, "Structure Score: Both-Side Memory Bonus", minval=0.0, maxval=20.0, group=groupAdvanced)
v23_msDecay = input.float(0.997, "Structure Recency Decay per Bar", minval=0.90, maxval=1.0, group=groupAdvanced)
v23_msScoreBonus = input.float(4.00, "Relevance Bonus: Structural Memory", minval=0.0, maxval=20.0, group=groupAdvanced)
v23_openSkyBreakoutAtr = input.float(0.15, "Open-Sky Breakout Buffer (ATR)", minval=0.0, maxval=5.0, group=groupAdvanced)
v24_strictAirShelfRules = input.bool(true, "Strict AIR Rule: require reactions + closes/pivots before shelf role", group=groupAdvanced)
v24_runwayTrendLen = input.int(50, "RUNWAY Trend EMA Length", minval=5, maxval=300, group=groupAdvanced)
v24_runwaySlopeBars = input.int(10, "RUNWAY Trend Slope Bars", minval=1, maxval=100, group=groupAdvanced)
v25_devRecentNodeThreshold = input.float(0.38, "DEV Recent Node Threshold", minval=0.05, maxval=1.0, group=groupAdvanced)
v25_devImmatureRawMax = input.float(0.32, "DEV if Full-Profile Raw Node <=", minval=0.01, maxval=1.0, group=groupAdvanced)
v25_devScoreBonus = input.float(3.25, "Relevance Bonus: DEV Memory", minval=0.0, maxval=20.0, group=groupAdvanced)
v25_baseAtr = input.float(6.0, "BASE/FAR Split (ATR)", minval=1.0, maxval=50.0, group=groupAdvanced)
v25_lowMapMinDrawnZones = input.int(1, "LOW MAP if drawn zones below", minval=0, maxval=10, group=groupAdvanced)
v251_bracketUpperMinPivots = input.int(2, "Bracket: Min Upper Pivot Reactions", minval=1, maxval=20, group=groupAdvanced)
v251_bracketLowerMinPivots = input.int(2, "Bracket: Min Lower Pivot Reactions", minval=1, maxval=20, group=groupAdvanced)
v251_bracketForceCandidate = input.bool(true, "Bracket: Force Upper Memory Candidate", group=groupAdvanced)
v251_bracketScoreBonus = input.float(4.75, "Bracket Guard Relevance Bonus", minval=0.0, maxval=30.0, group=groupAdvanced)
v251_brokenRecoverOffLowPct = input.float(20.0, "Broken Recovery: Min Recovery From Low %", minval=0.0, maxval=500.0, group=groupAdvanced)
v251_brokenForceCandidate = input.bool(true, "Broken Recovery: Force Overhead Memory Candidate", group=groupAdvanced)
v251_brokenScoreBonus = input.float(5.50, "Broken Recovery Relevance Bonus", minval=0.0, maxval=30.0, group=groupAdvanced)
v251_blockOpenSkyOnGuards = input.bool(true, "Block Open-Sky/Open-Up During Guards", group=groupAdvanced)
v252_decoupleGuardLookback = input.bool(true, "Guards Use Full Lookback, Not VP Window", group=groupAdvanced)
v252_bracketAllowUpperOnly = input.bool(false, "Bracket: Block OPEN-UP With Upper Memory Only", group=groupAdvanced)
v252_bracketDirectMinPivots = input.int(2, "Bracket: Direct Upper Pivot Min", minval=1, maxval=20, group=groupAdvanced)
v252_brokenDirectMinPivots = input.int(1, "Broken Recovery: Direct Overhead Pivot Min", minval=1, maxval=20, group=groupAdvanced)
v253_bracketMaxUpperPos = input.float(0.86, "Bracket: Max Position Inside Range", minval=0.50, maxval=0.98, step=0.01, group=groupAdvanced)
v253_brokenRequirePctAndAtr = input.bool(true, "Broken Recovery: Require % AND ATR Damage", group=groupAdvanced)
v253_currentZoneIsBattle = input.bool(true, "Current Zone: Separate Battle Role", group=groupAdvanced)

// 11 Diagnostic Mode Only — Zones, Labels, Tables
vis_showStale = input.bool(false, "Show Stale Zones", group=groupDiagnostic)
vis_showLabels = input.bool(true, "Show Zone Labels", group=groupDiagnostic)
v21_showConfluenceInLabels = input.bool(true, "Show VP/Chip Source in Labels", group=groupDiagnostic)
v22_showRecentPoc = input.string("Line + Label", "Recent POC Display", options=["Line + Label", "Line Only", "Hidden"], group=groupDiagnostic)
v22_zoneOriginMode = input.string("Auto", "Zone Display Origin", options=["Auto", "Full Profile", "Last Touch", "Recent Window", "Compact Right"], group=groupDiagnostic)
v22_compactOriginBars = input.int(90, "Compact Right: Width in Bars", minval=5, maxval=1000, group=groupDiagnostic)
v22_lastTouchPadBars = input.int(20, "Last Touch Origin: Padding Bars", minval=0, maxval=500, group=groupDiagnostic)
v22_showValueBadge = input.bool(true, "Show Value Migration Badge", group=groupDiagnostic)
v221_pmReserveNear = input.int(2, "Reserved PM Slots: Near / Inside", minval=0, maxval=10, group=groupDiagnostic)
v221_pmReserveBelow = input.int(2, "Reserved PM Slots: Below Price", minval=0, maxval=10, group=groupDiagnostic)
v221_pmReserveAbove = input.int(2, "Reserved PM Slots: Above Price", minval=0, maxval=10, group=groupDiagnostic)
v23_msReserveNear = input.int(1, "Reserved STRUCT Slots: Near / Inside", minval=0, maxval=10, group=groupDiagnostic)
v23_msReserveBelow = input.int(1, "Reserved STRUCT Slots: Below Price", minval=0, maxval=10, group=groupDiagnostic)
v23_msReserveAbove = input.int(1, "Reserved STRUCT Slots: Above Price", minval=0, maxval=10, group=groupDiagnostic)
v23_openSkyLine = input.bool(true, "Open-Sky Reference Line", group=groupDiagnostic)
v24_labelMode = input.string("Smart", "Zone Label Mode", options=["Smart", "Simple", "Legacy"], group=groupDiagnostic)
v24_showConfidenceClass = input.bool(true, "Show Confidence Class in Labels", group=groupDiagnostic)
v24_showRoleClass = input.bool(true, "Show Role Class in Labels", group=groupDiagnostic)
v24_showBattleTable = input.bool(true, "Show Compact Battle Table", group=groupDiagnostic)
v24_battleTablePos = input.string("Bottom Right", "Battle Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=groupDiagnostic)
v25_devReserveNear = input.int(1, "Reserved DEV Slots: Near / Inside", minval=0, maxval=5, group=groupDiagnostic)
v25_showDistanceState = input.bool(true, "Show ACTIVE/BASE/FAR/OVERHEAD/STALE", group=groupDiagnostic)
v25_showAirTaxonomy = input.bool(true, "Use AIR/AIR+PM/AIR-R/AIR-S Labels", group=groupDiagnostic)
v312_showRailAudit = input.bool(false, "Show Pressure Rail Audit", tooltip="Diagnostic-only audit of the exact Pareto survivors eligible for production Pressure Rails.", group=groupDiagnostic)

// 12 External Microstructure Calibration — Active Guardrails + M6A.2d PM + Event + Rows + Lookback
// Connect these once to the shared adapter outputs. ACTIVE is the production default.
// M4B keeps the bounded map-confidence/shelf-authority guardrails. M6A.2a keeps the validated PM reaction floor active.
// M6A.2b keeps the validated lower shock Range/ATR threshold active; M6A.2c keeps profile-row routing active.
// M6A.2d also activates bounded profile-lookback routing in Auto mode. Manual lookback/rows remain exact; shelf geometry, lifecycle, and support/resistance role logic remain chart-derived.
ext_microPackedV1 = input.source(close, "EXT_MicrostructurePackedV1", group=groupExternal)
ext_microMetaV1 = input.source(close, "EXT_MicrostructureMetaV1", group=groupExternal)
ext_microCalibrationMode = input.string("ACTIVE", "Microstructure Calibration Mode", options=["ACTIVE", "SHADOW", "OFF"], tooltip="ACTIVE applies M4B confidence/shelf guardrails, PM reaction evidence, shock-event sensitivity, M6A.2c profile-row calibration, and M6A.2d bounded profile-lookback calibration when Core Profile Routing is Auto. Manual profile lookback/rows remain exact. SHADOW previews without applying micro calibration. OFF preserves legacy behavior.", group=groupExternal)
ext_showMicroDiagnostic = input.bool(true, "Show Microstructure Contract in Diagnostic Table", group=groupExternal)
ext_showMicroGuardrails = input.bool(true, "Show Active Calibration Rows in Diagnostic Table", group=groupExternal)
ext_opaqueDiagnosticTable = input.bool(true, "Use Opaque Diagnostic Table Background", group=groupExternal)

// Internal display routing and compatibility constants. These are not user settings.
vis_fastScanMode = vis_visualMode == "Pressure Rails"
vis_memoryRailMode = vis_visualMode != "Diagnostic"
vis_displayMode = vis_memoryRailMode ? "Current Battle Map" : "Full Map"
v289_showShelfText = v278_showImportantShelfPrices and not vis_fastScanMode
v289_showValueMarkers = vp_showValueAreaMarkers and not vis_fastScanMode
vp_profileShow = true
vp_profilePlacement = "Left of Lookback"
vp_profileRightOffset = 8
vp_profileWidth = 0.31
vp_pocShow = "None"
vp_pocWidth = 2
vp_profileLevels = "None"
vis_currentMaxZones = 5
vis_cleanShowBattleTable = false
vis_labelDetail = "Compact"
vis_showReliabilityBadge = false
vis_profilePolicy = "Auto by Visual Mode"
vis_profileDimTransparency = 94
v27_railMaxZones = 3
v27_railSide = "Right"
v27_railMinLen = v276_shelfMinLen
v27_railScalingMode = "Linear"
v273_companionColorMode = "Single Memory Color"
v273_companionMemoryColor = v276_memoryShelfColor
v26_showBattleTable = v24_showBattleTable and not vis_memoryRailMode

//==================================================================================================
// PRESET / TIMEFRAME ROUTING - internal effective settings; manual mode preserves raw inputs.
// CE10295 discipline: route presets through compact tuples so the main body does not carry dozens of assignments.
//==================================================================================================

v27AutoPresetCode() =>
    int tfSec = timeframe.in_seconds(timeframe.period)
    timeframe.isweekly or timeframe.ismonthly ? 3 : timeframe.isdaily and timeframe.multiplier == 1 ? 1 : timeframe.isdaily and timeframe.multiplier >= 2 and timeframe.multiplier <= 4 ? 2 : timeframe.isdaily and timeframe.multiplier > 4 ? 3 : timeframe.isintraday and tfSec >= 43200 and tfSec < 86400 ? 4 : 1

v27ModePresetCode(_mode) =>
    _mode == "Manual" ? 0 : _mode == "12H Extended Context" ? 4 : _mode == "1D Entry Map" ? 1 : _mode == "2D Swing Confirmation Map" ? 2 : _mode == "1W Position Map" ? 3 : v27AutoPresetCode()

v27PresetShort() =>
    pc = v27ModePresetCode(v27_presetMode)
    pc == 0 ? "MAN" : pc == 4 ? "12H" : pc == 1 ? "1D" : pc == 2 ? "2D" : "1W"

v27EffI(_manual, _d1, _d2, _w) =>
    pc = v27ModePresetCode(v27_presetMode)
    pc == 0 ? _manual : pc == 2 ? _d2 : pc == 3 ? _w : _d1

v27EffF(_manual, _d1, _d2, _w) =>
    pc = v27ModePresetCode(v27_presetMode)
    pc == 0 ? _manual : pc == 2 ? _d2 : pc == 3 ? _w : _d1

// v2.7.7 adaptive core profile router.
// Auto: 12H=126d/36 rows, 1D=252d/44, 2D-4D=504d/48, 1W+=1825d/55.
// Manual: the two visible manual profile inputs are used exactly as entered.
effProfileDays() =>
    pc = v27AutoPresetCode()
    vp_profileRouting == "Manual" ? vp_profileDays : pc == 4 ? 126 : pc == 1 ? 252 : pc == 2 ? 504 : 1825

effProfileNumberOfRows() =>
    pc = v27AutoPresetCode()
    vp_profileRouting == "Manual" ? vp_profileNumberOfRows : pc == 4 ? 36 : pc == 1 ? 44 : pc == 2 ? 48 : 55
effTopNZones() => v27EffI(sr_topN, 10, 12, 16)
effZoneHalfWidthAtrFrac() => v27EffF(sr_atrFrac, 0.25, 0.30, 0.35)
effPeakProminenceMin() => v27EffF(sr_promMin, 1.30, 1.25, 1.25)
effPeakRelToMaxMin() => v27EffF(sr_relToMaxMin, 0.25, 0.22, 0.20)
effMergeAtrFrac() => v27EffF(sr_mergeAtrFrac, 0.50, 0.60, 0.75)
effScoreDecay() => v27EffF(sr_decay, 0.995, 0.996, 0.998)
effCurrentBattleAtrReach() => v27EffF(vis_battleAtrReach, 3.0, 3.5, 4.5)
effTradingAtrReach() => v27EffF(vis_tradingAtrReach, 6.0, 8.0, 12.0)
effTradingPctReach() => v27EffF(vis_tradingPctReach, 40.0, 55.0, 100.0)
effRecentTouchBars() => v27EffI(vis_recentTouchBars, 20, 24, 18)
effRecentFlipBars() => v27EffI(vis_recentFlipBars, 10, 12, 8)
effStaleTouchBars() => v27EffI(vis_staleTouchBars, 80, 90, 104)
effLvnNearAtr() => v27EffF(vis_lvnNearAtr, 3.0, 3.5, 4.5)
effRecentProfileDays() => v27EffI(v22_recentProfileDays, 63, 126, 365)
effValueMigrationThreshold() => v27EffF(v22_valueAtrThreshold, 0.50, 0.60, 0.75)
effPmLookbackDays() => v27EffI(v221_pmLookbackDays, 180, 504, 1260)
effPmReactionBand() => v27EffF(v221_pmReactionAtr, 0.40, 0.45, 0.50)
effPmMinSpanBars() => v27EffI(v221_pmMinSpanBars, 10, 8, 6)
effStructureLookbackDays() => v27EffI(v23_msLookbackDays, 252, 756, 1825)
effStructureClusterAtr() => v27EffF(v23_msClusterAtr, 0.35, 0.40, 0.50)
effStructureMinSpanBars() => v27EffI(v23_msMinSpanBars, 15, 12, 8)
effOpenSkyLookbackDays() => v27EffI(v23_openSkyLookbackDays, 252, 756, 1825)
effOpenSkyResistanceAtr() => v27EffF(v23_openSkyResistanceAtr, 3.0, 3.5, 5.0)
effDevLookbackDays() => v27EffI(v25_devLookbackDays, 34, 68, 126)
effDevMaxDistanceAtr() => v27EffF(v25_devNearAtr, 2.75, 3.0, 3.5)
effLowMapAtrReach() => v27EffF(v25_lowMapAtrReach, 2.5, 3.0, 4.0)
effBracketLookbackDays() => v27EffI(v251_bracketLookbackDays, 252, 756, 1825)
effBracketMinRangeAtr() => v27EffF(v251_bracketMinRangeAtr, 5.0, 6.0, 8.0)
effBracketUpperSearchAtr() => v27EffF(v251_bracketUpperSearchAtr, 12.0, 16.0, 22.0)
effBrokenLookbackDays() => v27EffI(v251_brokenLookbackDays, 252, 756, 1825)
effBrokenDrawdownPct() => v27EffF(v251_brokenDrawdownPct, 32.0, 32.0, 35.0)
effBrokenDrawdownAtr() => v27EffF(v251_brokenDrawdownAtr, 8.0, 9.0, 10.0)
effBrokenOverheadSearchAtr() => v27EffF(v251_brokenOverheadSearchAtr, 16.0, 20.0, 26.0)
effFallbackTurnoverGuess() => v27EffF(chip_avgTurnoverGuess, 0.01, 0.02, 0.05)


//==================================================================================================
// TYPES
//==================================================================================================
type mprSbeBar
    float o
    float h
    float l
    float c
    float v
    int   idx

type mprSbeBarStore
    float[] barHigh
    float[] barLow
    float[] barVolume
    bool[]  barPolarity
    int[]   barCount

type mprSbeVolumeStore
    float[] totalVolume
    float[] bullishVolume
    int[]   endProfileIndex

type mprSbeProfileStore
    box[]         boxes
    chart.point[] pocPoints
    polyline      pocPolyline
    int           pocLevel
    int           vahLevel
    int           valLevel
    int           startIndex

//==================================================================================================
// HELPERS
//==================================================================================================
clamp01(x) =>
    math.max(0.0, math.min(1.0, x))

getTextSize(_text) =>
    if _text != "None"
        switch _text
            "Tiny"   => size.tiny
            "Small"  => size.small
            "Normal" => size.normal
            => size.auto
    else
        size.auto

requestBarData(_lowerTimeframe) =>
    request.security_lower_tf(syminfo.tickerid, _lowerTimeframe, mprSbeBar.new(open, high, low, close, volume, bar_index), ignore_invalid_timeframe = true)

calculateTimeframe(_depth) =>
    int tfInSec = timeframe.in_seconds(timeframe.period)
    int m = 60
    if _depth == 2
        switch
            tfInSec < 30            => "1S"
            tfInSec < 1 * m         => "5S"
            tfInSec <= 15 * m       => "1"
            tfInSec <= 60 * m       => "5"
            tfInSec <= 240 * m      => "15"
            tfInSec <= 1440 * m     => "60"
            => "D"
    else
        switch
            tfInSec < 15            => "1S"
            tfInSec < 30            => "5S"
            tfInSec < 1 * m         => "15S"
            tfInSec <= 5 * m        => "1"
            tfInSec <= 15 * m       => "5"
            tfInSec <= 60 * m       => "15"
            tfInSec <= 240 * m      => "60"
            tfInSec <= 1440 * m     => "240"
            => "D"

updateLabel(_lb, _x, _y, _text, _style, _tip) =>
    label out = _lb
    if na(out)
        out := label.new(_x, _y, _text, xloc.bar_index, yloc.price, priceLabelBg, _style, priceLabelFg, getTextSize(vp_profileLevels), text.align_left, _tip)
    else
        label.set_xy(out, _x, _y)
        label.set_text(out, _text)
        label.set_style(out, _style)
        label.set_color(out, priceLabelBg)
        label.set_textcolor(out, priceLabelFg)
        label.set_size(out, getTextSize(vp_profileLevels))
        label.set_tooltip(out, _tip)
    out

zoneKindText(_kind) =>
    _kind == 1 ? "HVN" : _kind == 4 ? "DEV" : _kind == 3 ? "STRUCT" : _kind == 2 ? "PM" : _kind == -2 ? "AIR+PM" : _kind == -1 ? "AIR" : "MIX"

// Compact source token helper retained because both the authority tooltip and Diagnostic labels use it.
zoneSourceShort(_kind, _src) =>
    _kind == -2 ? "AIR+PM" : _kind == 4 ? "DEV" : _kind == 3 ? "STRUCT" : _kind == 2 ? "PM" : _kind == -1 ? "AIR" : _src == 3 ? "C-HVN" : _src == 1 ? "VP-HVN" : _src == 2 ? "CH-HVN" : "HVN"

// v2.8.8 Phase M4B: external microstructure reader + bounded active guardrails.
v287MicroStatusName(_code) => _code == 1 ? "READY" : _code == 2 ? "WARN" : _code == 3 ? "ERROR" : "UNMAPPED"
v287MicroProfileName(_code) => _code == 1 ? "STABLE LIQUID" : _code == 2 ? "NORMAL LIQUID" : _code == 3 ? "VOLATILE LIQUID" : _code == 4 ? "LIMITED LIQUIDITY" : _code == 5 ? "THIN STABLE" : _code == 6 ? "THIN EVENT-DRIVEN" : _code == 7 ? "GAP DOMINATED" : _code == 8 ? "LIMITED HISTORY" : _code == 9 ? "DATA UNRELIABLE" : "UNKNOWN"

v287ReadMicro(_main, _meta) =>
    bool mainPresent = not na(_main)
    bool metaPresent = not na(_meta)
    bool bothNa = not mainPresent and not metaPresent
    bool mainOk = mainPresent and _main <= -9300000000.0 and _main > -9600000000.0
    bool metaOk = metaPresent and _meta <= -9700000000.0 and _meta > -9800000000.0
    int payload = mainOk ? int(math.round(-_main - 9300000000.0)) : 0
    int d = payload
    int q = d % 8
    d := int(math.floor(d / 8))
    int h = d % 8
    d := int(math.floor(d / 8))
    int c = d % 8
    d := int(math.floor(d / 8))
    int s = d % 8
    d := int(math.floor(d / 8))
    int e = d % 8
    d := int(math.floor(d / 8))
    int g = d % 8
    d := int(math.floor(d / 8))
    int v = d % 8
    d := int(math.floor(d / 8))
    int l = d % 8
    d := int(math.floor(d / 8))
    int p = d
    int mp = metaOk ? int(math.round(-_meta - 9700000000.0)) : 0
    int dateCode = mp % 8192
    mp := int(math.floor(mp / 8192))
    int expected = mp % 97
    mp := int(math.floor(mp / 97))
    int status = mp % 4
    int schema = int(math.floor(mp / 4))
    int calculated = payload % 97
    bool codesOk = p >= 0 and p <= 9 and l >= 0 and l <= 4 and v >= 0 and v <= 4 and g >= 0 and g <= 4 and e >= 0 and e <= 4 and s >= 0 and s <= 4 and c >= 0 and c <= 4 and h >= 0 and h <= 4 and q >= 0 and q <= 3
    bool schemaOk = metaOk and schema == 1
    bool checksumOk = mainOk and metaOk and calculated == expected
    bool contractOk = mainOk and metaOk and schemaOk and checksumOk and codesOk
    int dateTs = timestamp("GMT+0", 2020, 1, 1, 0, 0) + dateCode * 86400000
    string dateText = contractOk and dateCode > 0 ? str.format_time(dateTs, "yyyy-MM-dd", "GMT+0") : "N.A."
    string fallback = bothNa ? "ADAPTER UNMAPPED / NO BUS DATA" : not mainOk and metaOk ? "MAIN BUS MISSING / WRONG SOURCE" : mainOk and not metaOk ? "META BUS MISSING / WRONG SOURCE" : not mainOk and not metaOk ? "CONNECT BOTH ADAPTER BUS OUTPUTS" : not schemaOk ? "SCHEMA FAILURE" : not checksumOk ? "CHECKSUM FAILURE" : not codesOk ? "CODE RANGE FAILURE" : status == 3 ? "SHEET EXPORT ERROR" : status == 2 ? "CONSERVATIVE WARN" : status == 1 ? "NONE" : "ADAPTER UNMAPPED STATUS"
    string statusText = contractOk ? v287MicroStatusName(status) : bothNa ? "UNMAPPED" : not mainOk or not metaOk ? "INVALID LINK" : "INVALID CONTRACT"
    string headerText = statusText + " | " + (contractOk ? "VALID" : "UNAVAILABLE") + " | " + dateText
    string profileText = contractOk ? v287MicroProfileName(p) + " [" + str.tostring(p) + "]" : "N.A."
    string codeText = contractOk ? "L" + str.tostring(l) + " V" + str.tostring(v) + " G" + str.tostring(g) + " E" + str.tostring(e) + " S" + str.tostring(s) + " C" + str.tostring(c) + " H" + str.tostring(h) + " Q" + str.tostring(q) : "N.A."
    string tipText = "L/V/G/E/S/C/H/Q | Main " + (mainOk ? "OK" : "BAD") + " | Meta " + (metaOk ? "OK" : "BAD") + " | Schema " + str.tostring(schema) + " | Check " + str.tostring(calculated) + "/" + str.tostring(expected) + " | " + fallback
    [headerText, profileText, codeText, fallback, tipText, contractOk, status, p, l, v, g, e, s, c, h, q]

v288MicroGuardrails(_contractOk, _status, _p, _l, _v, _g, _e, _s, _c, _h, _q) =>
    bool usable = _contractOk and (_status == 1 or _status == 2) and _p >= 1 and _p <= 8 and _l >= 1 and _l <= 4 and _v >= 1 and _v <= 4 and _g >= 1 and _g <= 4 and _e >= 1 and _e <= 4 and _s >= 1 and _s <= 4 and _c >= 1 and _c <= 4 and _h >= 1 and _h <= 4 and _q >= 1 and _q <= 3
    float cap = 100.0
    int add = 0
    if usable
        cap := math.min(cap, _q == 3 ? 100.0 : _q == 2 ? 92.0 : 78.0)
        add += _q == 3 ? 0 : _q == 2 ? 2 : 6
        cap := math.min(cap, _h == 4 ? 100.0 : _h == 3 ? 96.0 : _h == 2 ? 82.0 : 70.0)
        add += _h == 4 ? 0 : _h == 3 ? 1 : _h == 2 ? 5 : 8
        cap := math.min(cap, _l == 4 ? 100.0 : _l == 3 ? 96.0 : _l == 2 ? 86.0 : 74.0)
        add += _l == 4 ? 0 : _l == 3 ? 1 : _l == 2 ? 4 : 7
        cap := math.min(cap, _v <= 2 ? 100.0 : _v == 3 ? 92.0 : 82.0)
        add += _v <= 2 ? 0 : _v == 3 ? 2 : 5
        cap := math.min(cap, _g <= 2 ? 100.0 : _g == 3 ? 90.0 : 76.0)
        add += _g <= 2 ? 0 : _g == 3 ? 3 : 6
        cap := math.min(cap, _e == 1 ? 100.0 : _e == 2 ? 96.0 : _e == 3 ? 84.0 : 70.0)
        add += _e == 1 ? 0 : _e == 2 ? 1 : _e == 3 ? 4 : 7
        cap := math.min(cap, _s == 1 ? 100.0 : _s == 2 ? 96.0 : _s == 3 ? 86.0 : 72.0)
        add += _s == 1 ? 0 : _s == 2 ? 1 : _s == 3 ? 4 : 7
        cap := math.min(cap, _c == 1 ? 100.0 : _c == 2 ? 96.0 : _c == 3 ? 86.0 : 72.0)
        add += _c == 1 ? 0 : _c == 2 ? 1 : _c == 3 ? 4 : 7
    int cappedAdd = math.min(add, 12)
    [usable, cap, cappedAdd]

[v287MicroHeader, v287MicroProfile, v287MicroCodes, v287MicroFallback, v287MicroTip, v287MicroContractOk, v287MicroStatusCode, v287MicroProfileCode, v287MicroLiquidityCode, v287MicroVolatilityCode, v287MicroGapCode, v287MicroEventCode, v287MicroStabilityCode, v287MicroContinuityCode, v287MicroHistoryCode, v287MicroQualityCode] = v287ReadMicro(ext_microPackedV1, ext_microMetaV1)
[v288MicroUsable, v288MicroCeiling, v288MicroEvidenceAdd] = v288MicroGuardrails(v287MicroContractOk, v287MicroStatusCode, v287MicroProfileCode, v287MicroLiquidityCode, v287MicroVolatilityCode, v287MicroGapCode, v287MicroEventCode, v287MicroStabilityCode, v287MicroContinuityCode, v287MicroHistoryCode, v287MicroQualityCode)
bool v288MicroActive = ext_microCalibrationMode == "ACTIVE" and v288MicroUsable
bool v288MicroShadow = ext_microCalibrationMode == "SHADOW" and v288MicroUsable
float v288PreviewRelativeFloor = math.min(0.62, v276_minStrength + (v288MicroUsable ? v288MicroEvidenceAdd / 100.0 : 0.0))
float v288PreviewAbsoluteFloor = math.min(52.0, 40.0 + (v288MicroUsable ? v288MicroEvidenceAdd : 0))
float v288EffectiveRelativeFloor = v288MicroActive ? v288PreviewRelativeFloor : v276_minStrength
float v288EffectiveAbsoluteFloor = v288MicroActive ? v288PreviewAbsoluteFloor : 40.0
string v288MicroModeText = ext_microCalibrationMode == "OFF" ? "OFF | LEGACY" : v288MicroUsable ? (v288MicroActive ? "ACTIVE | APPLIED" : "SHADOW | PREVIEW") : ext_microCalibrationMode + " | LEGACY FALLBACK"
string v288MicroImpactText = not v288MicroUsable ? "CALIBRATION UNAVAILABLE" : v288MicroCeiling < 100.0 and v288MicroEvidenceAdd > 0 ? "CAP + HIGHER EVIDENCE" : v288MicroCeiling < 100.0 ? "CONFIDENCE CAP" : v288MicroEvidenceAdd > 0 ? "HIGHER EVIDENCE" : "NO CHANGE"

v288WriteGuardrailRows(table _t, color _txt, color _baseBg, float _rawMap, float _effectiveMap) =>
    float previewMap = v288MicroUsable and not na(_rawMap) ? math.min(_rawMap, v288MicroCeiling) : _rawMap
    string mapCell = ext_showMicroGuardrails ? (v288MicroUsable ? "RAW " + str.tostring(_rawMap, "#") + " | CAP " + str.tostring(v288MicroCeiling, "#") + " | " + (v288MicroActive ? "EFF " + str.tostring(_effectiveMap, "#") : "PREVIEW " + str.tostring(previewMap, "#")) : "LEGACY " + str.tostring(_effectiveMap, "#")) : "HIDDEN"
    string evidenceCell = ext_showMicroGuardrails ? (v288MicroUsable ? "BASE " + str.tostring(v276_minStrength * 100.0, "#") + "% | +" + str.tostring(v288MicroEvidenceAdd) + " | " + (v288MicroActive ? "EFF " : "PREVIEW ") + str.tostring(v288PreviewRelativeFloor * 100.0, "#") + "%" : "BASE " + str.tostring(v276_minStrength * 100.0, "#") + "% | LEGACY") : "HIDDEN"
    string tip = "M4B cap/evidence guardrails. Mandatory shelves and geometry unchanged."
    color modeBg = v288MicroActive ? color.new(color.teal, 42) : v288MicroShadow ? color.new(color.blue, 45) : color.new(color.gray, 55)
    color impactBg = not v288MicroUsable ? color.new(color.orange, 42) : v288MicroImpactText == "NO CHANGE" ? color.new(color.teal, 52) : color.new(color.blue, 45)
    table.cell(_t, 0, 11, "Micro mode", text_color=_txt, bgcolor=_baseBg, tooltip=tip)
    table.cell(_t, 1, 11, ext_showMicroGuardrails ? v288MicroModeText : "HIDDEN", text_color=color.white, bgcolor=modeBg, tooltip=tip)
    table.cell(_t, 0, 12, "Map confidence", text_color=_txt, bgcolor=_baseBg, tooltip=tip)
    table.cell(_t, 1, 12, mapCell, text_color=_txt, bgcolor=_baseBg, tooltip=tip)
    table.cell(_t, 0, 13, "Shelf evidence", text_color=_txt, bgcolor=_baseBg, tooltip=tip)
    table.cell(_t, 1, 13, evidenceCell, text_color=_txt, bgcolor=_baseBg, tooltip=tip)
    table.cell(_t, 0, 14, "Micro impact", text_color=_txt, bgcolor=_baseBg, tooltip=tip)
    table.cell(_t, 1, 14, ext_showMicroGuardrails ? v288MicroImpactText : "HIDDEN", text_color=color.white, bgcolor=impactBg, tooltip=tip)
    0

// v3.0 M6A.2d: fourth controlled activation from the validated M6A.1 router.
// PM reaction evidence, shock Range/ATR sensitivity, and profile-row resolution remain ACTIVE. Bounded profile
// lookback may now also feed the live VP/CD engine when External Microstructure Calibration = ACTIVE AND Core
// Profile Routing is Auto. Manual profile lookback/rows remain exact. Q2 does not force MODERATE routing by itself.
// H1/H2 or LIMITED HISTORY preserve the full current lookback request. Lookback routing is one-way conservative:
// it may shorten the Auto profile window for empirically event/gap/fragility regimes but never lengthen it.
int v290CurDays = effProfileDays()
int v290CurRows = effProfileNumberOfRows()
int v290CurEvidence = v221_pmMinReactions
float v290CurEvent = v211_shockRangeAtr

v290ProfileShadow(_usable, _p, _l, _v, _g, _e, _s, _c, _h, _q) =>
    int pc = v27AutoPresetCode()
    int minDays = pc == 3 ? 756 : pc == 2 ? 252 : pc == 4 ? 90 : 126
    int regime = math.max(_v, math.max(_g, math.max(_e, math.max(_s, _c))))
    bool severe = _p == 6 or _p == 7 or regime == 4
    bool moderate = regime == 3
    bool limitedHistory = _p == 8 or _h <= 2
    float hf = _h == 3 ? 0.85 : 1.0
    float rf = severe ? 0.75 : moderate ? 0.90 : 1.0
    int routedDays = int(math.round(v290CurDays * hf * rf / 7.0) * 7)
    int propDays = _usable ? (limitedHistory ? v290CurDays : math.min(v290CurDays, math.max(minDays, routedDays))) : v290CurDays
    int rowAdj = (_l == 1 ? -10 : _l == 2 ? -6 : _l == 3 ? -2 : 0) + (_h == 1 ? -8 : _h == 2 ? -4 : 0) + (regime == 4 ? 6 : regime == 3 ? 3 : 0)
    int propRows = _usable ? math.max(28, math.min(64, v290CurRows + rowAdj)) : v290CurRows
    int fragility = math.max(0, 4 - _l) + math.max(0, 4 - _h) + math.max(0, 3 - _q) + math.max(0, regime - 2) * 2
    int evidenceAdd = fragility >= 5 ? 2 : fragility >= 2 ? 1 : 0
    int propEvidence = _usable ? math.max(v290CurEvidence, math.min(6, v290CurEvidence + evidenceAdd)) : v290CurEvidence
    float propEvent = _usable ? (severe ? math.max(2.5, v290CurEvent - 1.0) : moderate ? math.max(3.0, v290CurEvent - 0.5) : _p == 1 and _q == 3 ? math.min(5.0, v290CurEvent + 0.5) : v290CurEvent) : v290CurEvent
    string reason = not _usable ? "MICRO UNAVAILABLE | LEGACY" : _h <= 2 ? "LIMITED HISTORY + RISK" : _e >= 3 or _g == 4 or _c == 4 ? "EVENT / GAP REGIME" : regime == 4 ? "EXTREME / ERRATIC" : _l <= 2 ? "LIMITED LIQUIDITY" : moderate ? "MODERATE MICRO RISK" : "STABLE MICROSTRUCTURE"
    [propDays, propRows, propEvidence, propEvent, reason]

[v290PropDays, v290PropRows, v290PropEvidence, v290PropEvent, v290RouteReason] = v290ProfileShadow(v288MicroUsable, v287MicroProfileCode, v287MicroLiquidityCode, v287MicroVolatilityCode, v287MicroGapCode, v287MicroEventCode, v287MicroStabilityCode, v287MicroContinuityCode, v287MicroHistoryCode, v287MicroQualityCode)

// M6A.2d active surface: validated PM reaction evidence + shock-event sensitivity + profile-row calibration
// + bounded profile-lookback calibration. ACTIVE requires the same validated external contract used by M4B.
// Row and lookback calibration apply only in Auto core profile routing; Manual keeps user values exact.
bool v291PmEvidenceActive = ext_microCalibrationMode == "ACTIVE" and v288MicroUsable
int v291EffectivePmMinReactions = v291PmEvidenceActive ? v290PropEvidence : v221_pmMinReactions
bool v293EventSensitivityActive = ext_microCalibrationMode == "ACTIVE" and v288MicroUsable
float v293EffectiveShockRangeAtr = v293EventSensitivityActive ? math.min(v290CurEvent, v290PropEvent) : v211_shockRangeAtr
// M6A.2c row activation: two-sided adaptation is intentional because row count is map resolution, not a
// directional risk threshold. It may rise for event/gap structures or fall for thin/limited-liquidity structures.
// Auto routing only: Manual Profile Resolution / Rows remains exact and is never overridden by the adapter.
bool v294ProfileRowsActive = ext_microCalibrationMode == "ACTIVE" and v288MicroUsable and vp_profileRouting != "Manual"
int v294EffectiveProfileRows = v294ProfileRowsActive ? v290PropRows : v290CurRows
// M6A.2d lookback activation: Auto routing may shorten the core profile window using the already validated
// M6A.1 proposal. The proposal is bounded at or below the baseline and LIMITED HISTORY/H1/H2 preserve the full
// baseline request. Manual Profile Lookback (Days) remains exact and is never overridden by the adapter.
bool v295ProfileLookbackActive = ext_microCalibrationMode == "ACTIVE" and v288MicroUsable and vp_profileRouting != "Manual"
int v295EffectiveProfileDays = v295ProfileLookbackActive ? v290PropDays : v290CurDays
int v296RadiusPct = not v288MicroUsable or v27ModePresetCode(v27_presetMode) == 0 ? 100 : v287MicroVolatilityCode == 4 ? 80 : v287MicroVolatilityCode == 3 ? 90 : 100
float v296RadiusScale = v291PmEvidenceActive ? v296RadiusPct * 0.01 : 1.0
float v296BattleAtr = effCurrentBattleAtrReach() * v296RadiusScale
float v296TradeAtr = effTradingAtrReach() * v296RadiusScale
float v296TradePct = effTradingPctReach() * v296RadiusScale
float v296LvnAtr = effLvnNearAtr() * v296RadiusScale
// Sparse/illiquid symbols can occasionally return an empty current-bar lower-TF array.
// Keep the historical lower-TF build unchanged; only the live/current chart bar may fall back to its own OHLCV.
bool v292CurrentLtfFallback = false

v290WriteShadowRows(table _t, color _txt, color _bg) =>
    bool coreActive = v291PmEvidenceActive and v293EventSensitivityActive
    color routeBg = coreActive and ((v294ProfileRowsActive and v295ProfileLookbackActive) or vp_profileRouting == "Manual") ? color.new(color.teal, 42) : v288MicroUsable ? color.new(color.blue, 45) : color.new(color.gray, 55)
    string routeMode = coreActive ? (v294ProfileRowsActive and v295ProfileLookbackActive ? "PM + EVENT + ROWS + LOOKBACK ACTIVE | " : "PM + EVENT ACTIVE | ") : "SHADOW | "
    string evidenceMode = v291PmEvidenceActive ? "BASE " + str.tostring(v290CurEvidence) + " -> ACTIVE " + str.tostring(v291EffectivePmMinReactions) + " reactions" : str.tostring(v290CurEvidence) + " -> " + str.tostring(v290PropEvidence) + " reactions (shadow)"
    string eventMode = v293EventSensitivityActive ? "BASE " + str.tostring(v290CurEvent, "#.0") + " -> ACTIVE " + str.tostring(v293EffectiveShockRangeAtr, "#.0") + " R/ATR" : str.tostring(v290CurEvent, "#.0") + " -> " + str.tostring(v290PropEvent, "#.0") + " R/ATR SHADOW"
    string rowMode = v294ProfileRowsActive ? "BASE " + str.tostring(v290CurRows) + " -> ACTIVE " + str.tostring(v294EffectiveProfileRows) + " rows" : vp_profileRouting == "Manual" and coreActive ? "MANUAL LOCK " + str.tostring(v290CurRows) + " rows" : str.tostring(v290CurRows) + " -> " + str.tostring(v290PropRows) + " SHADOW"
    string lookbackMode = v295ProfileLookbackActive ? "BASE " + str.tostring(v290CurDays) + "d -> ACTIVE " + str.tostring(v295EffectiveProfileDays) + "d" : vp_profileRouting == "Manual" and coreActive ? "MANUAL LOCK " + str.tostring(v290CurDays) + "d" : str.tostring(v290CurDays) + "d -> " + str.tostring(v290PropDays) + "d SHADOW"
    string ltfSuffix = v292CurrentLtfFallback ? " | LTF CURRENT FALLBACK" : ""
    table.cell(_t, 0, 15, "M6A.3b routing", text_color=_txt, bgcolor=_bg)
    table.cell(_t, 1, 15, routeMode + v290RouteReason + " | RAD " + str.tostring(v296RadiusPct) + (v291PmEvidenceActive ? "% ACT" : "% SH") + ltfSuffix, text_color=color.white, bgcolor=routeBg)
    table.cell(_t, 0, 16, "Profile lookback", text_color=_txt, bgcolor=_bg)
    table.cell(_t, 1, 16, lookbackMode, text_color=_txt, bgcolor=v295ProfileLookbackActive ? color.new(color.teal, 52) : _bg)
    table.cell(_t, 0, 17, "Profile rows", text_color=_txt, bgcolor=_bg)
    table.cell(_t, 1, 17, rowMode, text_color=_txt, bgcolor=v294ProfileRowsActive ? color.new(color.teal, 52) : _bg)
    table.cell(_t, 0, 18, "PM reaction floor", text_color=_txt, bgcolor=_bg)
    table.cell(_t, 1, 18, evidenceMode, text_color=_txt, bgcolor=v291PmEvidenceActive ? color.new(color.teal, 52) : _bg)
    table.cell(_t, 0, 19, "Event sensitivity", text_color=_txt, bgcolor=_bg)
    table.cell(_t, 1, 19, eventMode, text_color=_txt, bgcolor=v293EventSensitivityActive ? color.new(color.teal, 52) : _bg)
    0

// v2.8.1.3 token-lean build: verbose diagnostic source-description helpers remain removed.

stateText(_state) =>
    switch _state
        1 => "Inside"
        2 => "Reclaimed Support"
        3 => "Flipped Resistance"
        4 => "Active"
        5 => "Nearby"
        6 => "Stale"
        => "Unknown"

stateShort(_state) =>
    switch _state
        1 => "IN"
        2 => "RCLM"
        3 => "FLIP"
        4 => "ACT"
        5 => "NEAR"
        6 => "STALE"
        => "UNK"

roleText(_close, _bot, _top) =>
    _close > _top ? "Support-side" : _close < _bot ? "Resistance-side" : "Inside zone"

roleShort(_close, _bot, _top) =>
    _close > _top ? "S" : _close < _bot ? "R" : "IN"

v24AirShelfConfirmed(_kind, _pmReact, _pmCloses, _pmPivots) =>
    _kind == -2 and _pmReact >= v291EffectivePmMinReactions and (_pmCloses >= v221_pmCloseDensityMin or _pmPivots >= v221_pmPivotMinReactions)

v24IsActionableMemory(_kind, _airConfirmed) =>
    _kind == 1 or _kind == 2 or _kind == 3 or _kind == 4 or (_kind == -2 and (not v24_strictAirShelfRules or _airConfirmed))

v24ConfidenceClass(_kind, _src, _rel, _dAtr, _hasShares, _abnormal, _pmReact, _pmCloses, _pmPivots, _msTouches) =>
    string cls = "C"
    bool airConfirmed = v24AirShelfConfirmed(_kind, _pmReact, _pmCloses, _pmPivots)
    if _kind == -1 or (_kind == -2 and v24_strictAirShelfRules and not airConfirmed)
        cls := "AIR"
    else if _kind == 4
        cls := _abnormal ? "C" : "DEV"
    else if _abnormal
        cls := "C"
    else if _kind == 1 and _src == 3 and _rel >= 8.0 and _dAtr <= v296TradeAtr
        cls := "A"
    else if _kind == 1 and (_src == 1 or (_src == 2 and _hasShares)) and _rel >= 6.0
        cls := "B"
    else if _kind == 3 and _msTouches >= v23_msMinTouches and _rel >= 5.0
        cls := "B"
    else if (_kind == 2 or _kind == -2) and airConfirmed and _rel >= 4.0
        cls := "B"
    else
        cls := "C"
    cls

v24RoleClass(_kind, _close, _center, _bot, _top, _airConfirmed, _trendUp, _trendDown) =>
    string role = "MEMORY"
    bool actionableMemory = v24IsActionableMemory(_kind, _airConfirmed)
    if _kind == -1 or (_kind == -2 and v24_strictAirShelfRules and not _airConfirmed)
        role := _center > _close and _trendUp ? "RUNWAY" : "AIR GAP"
    else if actionableMemory and _close > _top
        role := "SUPPORT"
    else if actionableMemory and _close < _bot
        role := "RESISTANCE"
    else
        role := "MEMORY"
    role

v24RoleShort(_role) =>
    _role == "SUPPORT" ? "SUP" : _role == "RESISTANCE" ? "RES" : _role == "RUNWAY" ? "RUN" : _role == "AIR GAP" ? "AIR" : _role == "DEV" ? "DEV" : "MEM"

v25AirTaxonomy(_kind, _close, _center, _airConfirmed) =>
    string out = ""
    if _kind == -2
        out := "AIR+PM"
    else if _kind == -1
        out := not v25_showAirTaxonomy ? "AIR" : _center > _close ? "AIR-R" : _center < _close ? "AIR-S" : "AIR"
    else
        out := ""
    out

v25DistanceState(_close, _bot, _top, _dAtr, _lastTouchAgo) =>
    string out = "ACTIVE"
    if _lastTouchAgo > effStaleTouchBars()
        out := "STALE"
    else if _close < _bot
        out := _dAtr <= v25_baseAtr ? "OVERHEAD" : "FAR"
    else if _close > _top
        out := _dAtr <= v296BattleAtr ? "ACTIVE" : _dAtr <= v25_baseAtr ? "BASE" : "FAR"
    else
        out := "ACTIVE"
    out

v25DistanceShort(_state) =>
    _state == "ACTIVE" ? "ACT" : _state == "BASE" ? "BASE" : _state == "FAR" ? "FAR" : _state == "OVERHEAD" ? "OH" : _state == "STALE" ? "STALE" : "ACT"

// Shared row-overlap helper. Moving this repeated switch out of the main body lowers CE10295 risk.
v255BinOverlap(_lo, _hi, _priceLevel, _step) =>
    _hi == _lo ? 0.0 : _lo >= _priceLevel and _hi > _priceLevel + _step ? (_priceLevel + _step - _lo) / (_hi - _lo) : _hi <= _priceLevel + _step and _lo < _priceLevel ? (_hi - _priceLevel) / (_hi - _lo) : _lo >= _priceLevel and _hi <= _priceLevel + _step ? 1.0 : _step / (_hi - _lo)

// v2.5.6 CE10295 fix: keep v2.5.4 current-zone behavior without extra main-body statements.
v255CurrentTouch(_close, _bot, _top, _atr) =>
    v253_currentZoneIsBattle and _close >= _bot - _atr * 0.10 and _close <= _top + _atr * 0.10

// v2.5.6: final state resolver helpers. These are intentionally fixed constants to avoid extra
// input/main-body pressure after the CE10295 compile fix.
v256OpenAirMinAtr() => 0.75
v256AirTestMaxAtr() => 1.50
v256SwingMemoryMaxAtr() => 1.50
v256BrokenTestPct() => 30.0
v256BrokenTestAtr() => 6.0

v256BrokenTestOk(_memGate, _active, _ddPct, _ddAtr) =>
    bool ok = _memGate and not _active
    ok := ok and not na(_ddPct)
    ok := ok and not na(_ddAtr)
    ok := ok and _ddPct >= v256BrokenTestPct()
    ok := ok and _ddAtr >= v256BrokenTestAtr()
    ok

v256NearestUpperMemory(_lookback, _atr, _maxAtr) =>
    float outPrice = na
    float outAtr = 100000.0
    int outHits = 0
    int maxL = int(math.min(_lookback, math.max(bar_index - 2, 0)))
    if maxL > 4 and _atr > 0
        for i = 2 to maxL - 2
            isHighPivot = high[i] >= high[i - 1] and high[i] > high[i + 1]
            dAtr = math.abs(high[i] - close) / _atr
            nearUpper = high[i] >= close - _atr * 0.05 and dAtr <= _maxAtr
            if isHighPivot and nearUpper
                outHits += 1
                if dAtr < outAtr
                    outAtr := dAtr
                    outPrice := high[i]
        if na(outPrice)
            for j = 1 to maxL
                dAtrFallback = math.abs(high[j] - close) / _atr
                nearFallback = high[j] >= close - _atr * 0.05 and dAtrFallback <= _maxAtr
                if nearFallback and dAtrFallback < outAtr
                    outHits += 1
                    outAtr := dAtrFallback
                    outPrice := high[j]
    [outPrice, outAtr, outHits]

v256BiasText(_broken, _bracket, _battle, _abnormal, _lowMap, _upperTest, _brokenTest, _airTest, _hasSupport, _hasResistance, _valueDeltaAtr, _valueThr) =>
    string out = "BRACKET"
    if _broken and _abnormal
        out := "SHOCK RECOVERY"
    else if _broken
        out := "BROKEN RECOVERY"
    else if _brokenTest
        out := "BROKEN TEST"
    else if _bracket
        out := "BRACKET GUARD"
    else if _battle
        out := "CURRENT BATTLE"
    else if _upperTest
        out := "UPPER TEST"
    else if _airTest
        out := "AIR TEST"
    else if _abnormal
        out := "LOW CONF"
    else if _lowMap
        out := "LOW MAP"
    else if not _hasSupport and not _hasResistance
        out := "OPEN"
    else if _hasSupport and not _hasResistance
        out := "OPEN-UP"
    else if not _hasSupport and _hasResistance
        out := "THIN-DN"
    else if not na(_valueDeltaAtr) and _valueDeltaAtr > _valueThr
        out := "BULL VALUE"
    else if not na(_valueDeltaAtr) and _valueDeltaAtr < -_valueThr
        out := "BEAR VALUE"
    out

// v2.7 Phase 1: whole-map confidence scaffold. These helpers only classify existing evidence.
// They do not alter VP, chip, fallback, merge, scoring, lifecycle, guard, or drawing logic.
v27ClampScore(_score) =>
    math.max(0.0, math.min(100.0, _score))

v27FallbackHeavy(_hasConfluence, _hasVpOnly, _hasChipOnly, _hasPriceMemory, _hasAirPm, _hasStructuralMemory, _hasDevMemory) =>
    bool noMatureVolume = not _hasConfluence and not _hasVpOnly and not _hasChipOnly
    bool fallbackPresent = _hasPriceMemory or _hasAirPm or _hasStructuralMemory or _hasDevMemory
    noMatureVolume and fallbackPresent

v27MapWarningCode(_lowMap, _abnormal, _fallbackHeavy, _staleFarDominant, _guardActive) =>
    int code = 0
    if _abnormal
        code := 2
    else if _lowMap
        code := 1
    else if _guardActive
        code := 5
    else if _fallbackHeavy
        code := 3
    else if _staleFarDominant
        code := 4
    code

v27MapConfidenceScore(_lowMap, _abnormal, _hasConfluence, _hasVpOnly, _hasChipOnly, _hasPriceMemory, _hasAirPm, _hasStructuralMemory, _hasDevMemory, _hasCurrentBattle, _hasSupport, _hasResistance, _hasShares, _useChips, _guardActive, _upperGate, _noUsefulNearMemory, _fallbackHeavy, _staleFarDominant) =>
    float score = 50.0
    if _hasConfluence
        score += _hasShares ? 25.0 : 18.0
    if _hasCurrentBattle
        score += 10.0
    if _hasSupport and _hasResistance
        score += 8.0
    if _hasVpOnly
        score += 12.0
    if _hasStructuralMemory
        score += 7.0
    if _hasPriceMemory
        score += 5.0
    if _hasAirPm
        score += 3.0
    if _hasDevMemory
        score += 3.0
    if _hasChipOnly
        score += _hasShares ? 5.0 : 0.0
    if _useChips and _hasShares
        score += 5.0
    if _useChips and not _hasShares
        score -= 8.0
    if _lowMap
        score -= 25.0
    if _abnormal
        score -= 30.0
    if _guardActive
        score -= 12.0
    if _upperGate
        score -= 8.0
    if _noUsefulNearMemory
        score -= 15.0
    if _fallbackHeavy
        score -= 5.0
    if _staleFarDominant
        score -= 10.0
    if _hasChipOnly and not _hasShares and not _hasVpOnly and not _hasConfluence
        score -= 8.0
    v27ClampScore(score)

v27MapConfidenceClass(_score, _lowMap, _abnormal, _hasConfluence) =>
    _abnormal ? "Event" : _lowMap ? "Sparse" : _score >= 75.0 and _hasConfluence ? "High" : _score >= 50.0 ? "Medium" : "Low"

// v2.7.3 CE10295 hard fix: hidden numeric BUS helper code removed in this compiler-safe build.
// Visual VP/CD map, auto presets, and Memory Rail remain active.

// v2.7.6: obsolete per-zone rail helpers removed; endpoint UI uses the memory-shelf histogram.

// v2.7 Phase 2/3: per-zone reliability scaffold with governance caps. Tooltip-only; does not affect ranking, drawing, guards, or decisions.
v27ZoneReliabilityScore(_kind, _src, _hasShares, _mapScore, _abnormal, _mapWarnCode, _state, _dAtr, _touches, _rejects, _lastTouch, _lastCross, _lastCrossDir, _relScore, _histScore, _pmReact, _pmCloses, _pmPivots, _msTouches, _devScore, _airConfirmed, _isSupportRole, _isResistanceRole) =>
    float score = 40.0
    if _kind == 1 and _src == 3
        score := _hasShares ? 74.0 : 68.0
    else if _kind == 1 and _src == 1
        score := 62.0
    else if _kind == 1 and _src == 2
        score := _hasShares ? 54.0 : 42.0
    else if _kind == 3
        score := 55.0
    else if _kind == 2
        score := 48.0
    else if _kind == -2
        score := _airConfirmed ? 42.0 : 30.0
    else if _kind == 4
        score := 45.0
    else if _kind == -1
        score := 28.0

    score += math.min(_touches, 5) * 2.0
    score += math.min(_rejects, 4) * 3.0
    score += _state == 1 ? 8.0 : (_state == 2 or _state == 3) ? 5.0 : _state == 4 ? 4.0 : _state == 6 ? -18.0 : 0.0
    score += _lastTouch < 20 ? 8.0 : _lastTouch < 60 ? 4.0 : _lastTouch > 160 and _lastTouch < 100000 ? -8.0 : 0.0
    score += _dAtr <= 0.25 ? 8.0 : _dAtr <= 0.75 ? 5.0 : _dAtr <= 1.50 ? 2.0 : _dAtr > 5.0 ? -15.0 : _dAtr > 3.0 ? -8.0 : 0.0
    score += _relScore >= 8.0 ? 8.0 : _relScore >= 5.0 ? 4.0 : _relScore < 2.0 ? -4.0 : 0.0
    score += _histScore >= 15.0 ? 4.0 : _histScore >= 8.0 ? 2.0 : 0.0

    if _kind == 2 or _kind == -2
        score += math.min(_pmReact, 5) * 1.5
        score += math.min(_pmCloses, 5) * 1.0
        score += math.min(_pmPivots, 4) * 1.0
    if _kind == 3
        score += math.min(_msTouches, 6) * 2.0
    if _kind == 4
        score += math.min(_devScore, 12.0) * 0.5

    score += na(_mapScore) ? 0.0 : (_mapScore - 50.0) * 0.15
    score -= _abnormal ? 12.0 : 0.0
    score -= _mapWarnCode == 1 ? 10.0 : _mapWarnCode == 2 ? 15.0 : _mapWarnCode == 3 ? 4.0 : _mapWarnCode == 4 ? 6.0 : _mapWarnCode == 5 ? 6.0 : 0.0
    score -= _kind == 1 and _src == 2 and not _hasShares ? 8.0 : 0.0
    score -= _kind == -1 ? 6.0 : 0.0
    score -= _kind == -2 and not _airConfirmed ? 6.0 : 0.0
    score -= _lastCross <= effRecentFlipBars() and ((_isSupportRole and _lastCrossDir == -1) or (_isResistanceRole and _lastCrossDir == 1)) ? 8.0 : 0.0
    v27ClampScore(score)

v27StructHasStats(_msTouches, _msHighs, _msLows) =>
    _msTouches > 0 or _msHighs > 0 or _msLows > 0

v27ZoneReliabilityCap(_kind, _src, _hasShares, _state, _dAtr, _lastTouch, _mapWarnCode, _abnormal, _airConfirmed, _msTouches, _msHighs, _msLows) =>
    bool currentOrInside = _state == 1
    bool recent = _lastTouch < 60
    bool stale = _state == 6 or (_lastTouch > 160 and _lastTouch < 100000)
    bool far = _dAtr > 3.0
    bool baseDistance = _dAtr > 1.5
    bool eventMap = _abnormal or _mapWarnCode == 2
    bool guardMap = _mapWarnCode == 5
    bool structStats = v27StructHasStats(_msTouches, _msHighs, _msLows)
    float cap = 100.0

    if _kind == -1
        cap := 40.0
    else if _kind == -2
        cap := _airConfirmed ? 58.0 : 48.0
    else if _kind == 4
        cap := 76.0
    else if _kind == 2
        cap := 70.0
    else if _kind == 3
        cap := structStats ? 85.0 : guardMap ? 78.0 : 72.0
    else if _kind == 1 and _src == 3
        cap := currentOrInside and recent and _hasShares and not stale and not far and not eventMap ? 100.0 : 92.0
    else if _kind == 1 and _src == 1
        cap := currentOrInside and recent and not stale and not far ? 88.0 : 78.0
    else if _kind == 1 and _src == 2
        cap := _hasShares ? 82.0 : 65.0
    else
        cap := 70.0

    if _kind == 1 and _src == 3
        if stale
            cap := math.min(cap, 80.0)
        else if far or baseDistance
            cap := math.min(cap, 92.0)
        if eventMap
            cap := math.min(cap, 82.0)
    else if _kind == 1 and _src == 1
        if stale
            cap := math.min(cap, 72.0)
        else if far or baseDistance
            cap := math.min(cap, 78.0)
        if eventMap
            cap := math.min(cap, 74.0)
    else if _kind == 1 and _src == 2
        if _hasShares
            if stale
                cap := math.min(cap, 66.0)
            else if far or baseDistance
                cap := math.min(cap, 74.0)
        else
            if stale
                cap := math.min(cap, 52.0)
            else if far or baseDistance
                cap := math.min(cap, 58.0)
        if eventMap
            cap := math.min(cap, (_hasShares ? 68.0 : 55.0))
    else if _kind == 3
        if stale
            cap := math.min(cap, structStats ? 76.0 : guardMap ? 72.0 : 66.0)
        else if far or baseDistance
            cap := math.min(cap, structStats ? 80.0 : guardMap ? 76.0 : 70.0)
        if eventMap
            cap := math.min(cap, structStats ? 72.0 : 66.0)
    else if _kind == 2
        if stale
            cap := math.min(cap, 60.0)
        else if far or baseDistance
            cap := math.min(cap, 65.0)
        if eventMap
            cap := math.min(cap, 58.0)
    else if _kind == 4
        if stale or far or baseDistance
            cap := math.min(cap, 70.0)
        if eventMap
            cap := math.min(cap, 64.0)
    else if _kind == -2
        if stale or far or baseDistance
            cap := math.min(cap, _airConfirmed ? 52.0 : 44.0)
        if eventMap
            cap := math.min(cap, 46.0)
    else if _kind == -1
        if stale or far or baseDistance
            cap := math.min(cap, 35.0)
        if eventMap
            cap := math.min(cap, 32.0)

    if _mapWarnCode == 1
        cap := math.min(cap, 68.0)
    if _mapWarnCode == 5 and (_kind == 2 or _kind == 4 or _kind == -2 or _kind == -1)
        cap := math.max(0.0, cap - 2.0)
    math.max(0.0, cap)

v27ZoneReliabilityCappedScore(_rawScore, _cap) =>
    v27ClampScore(math.min(_rawScore, _cap))

v27ZoneReliabilityClass(_kind, _score) =>
    _kind == -1 or _kind == -2 ? "AIR" : _kind == 4 ? "DEV" : _score >= 75.0 ? "High" : _score >= 55.0 ? "Medium" : _score >= 40.0 ? "Low" : "Weak"

// v2.8.1.2 token-lean build: verbose reliability-reason text removed; numeric reliability logic remains unchanged.

v24TablePosition(_pos) =>
    _pos == "Top Right" ? position.top_right : _pos == "Bottom Right" ? position.bottom_right : _pos == "Top Left" ? position.top_left : position.bottom_left

valueStateText(_deltaAtr, _thr) =>
    na(_deltaAtr) ? "VALUE UNKNOWN" : _deltaAtr > _thr ? "VALUE UP" : _deltaAtr < -_thr ? "VALUE DOWN" : "VALUE FLAT"

valueStateShort(_deltaAtr, _thr) =>
    na(_deltaAtr) ? "VAL?" : _deltaAtr > _thr ? "VAL↑" : _deltaAtr < -_thr ? "VAL↓" : "VAL="

priceVsValueText(_close, _recentPoc, _atr, _thr) =>
    na(_recentPoc) or na(_atr) or _atr <= 0 ? "Price vs recent value unknown" : _close > _recentPoc + _atr * _thr ? "Price above recent value" : _close < _recentPoc - _atr * _thr ? "Price below recent value" : "Price inside recent value"

//==================================================================================================
// STATE / STORAGE
//==================================================================================================
mprSbeBar bar = mprSbeBar.new(open, high, low, close, volume, bar_index)
mprSbeBar[] ltfBarData = array.new<mprSbeBar>(1, mprSbeBar.new(open, high, low, close, volume, bar_index))

var int prevRows = na
var mprSbeBarStore barDataArray = mprSbeBarStore.new(array.new<float>(0), array.new<float>(0), array.new<float>(0), array.new<bool>(0), array.new<int>(0))
var mprSbeVolumeStore volumeDataArray = mprSbeVolumeStore.new(array.new<float>(1, 0.0), array.new<float>(1, 0.0), array.new<int>(1, 0))
var mprSbeProfileStore VP = mprSbeProfileStore.new(array.new<box>(0), array.new<chart.point>(0), na, na, na, na, na)

var float highestPrice = na
var float lowestPrice  = na

var box[]   srBoxes  = array.new<box>(0)
var label[] srLabels = array.new<label>(0)

var label lbHigh = na
var label lbPOC  = na
var label lbLow  = na
var label chipReliabilityLabel = na
var label valueMigrationLabel = na
var label openSkyLabel = na
var label mapCoverageLabel = na
var table v24BattleTable = na
var table v312RailAuditTable = na

var line pocLine = na
var line recentPocLine = na
var line openSkyLine = na

//==================================================================================================
// TIME -> BARS for days lookback
//==================================================================================================
barsPerDay = 86400.0 / timeframe.in_seconds(timeframe.period)
// v2.8.9.5 M5E: the left anchor is the effective profile-lookback start candle, not the visible viewport edge.
// The right anchor remains the live/right-visible edge.
v278_rightVisibleBarIndex = ta.valuewhen(time == chart.right_visible_bar_time, bar_index, 0)
vp_profileLengthRaw = int(math.round(v295EffectiveProfileDays * barsPerDay))
vp_profileLength = math.min(5000, math.max(1, vp_profileLengthRaw))
vp_profileLength := last_bar_index < vp_profileLength ? last_bar_index : vp_profileLength - 1

v22_recentProfileLengthRaw = int(math.round(effRecentProfileDays() * barsPerDay))
v22_recentProfileLength = math.min(vp_profileLength, math.max(1, v22_recentProfileLengthRaw))

//==================================================================================================
// INIT WHEN ROWS CHANGE
//==================================================================================================
if barstate.isfirst or v294EffectiveProfileRows != prevRows
    prevRows := v294EffectiveProfileRows
    volumeDataArray := mprSbeVolumeStore.new(
        array.new<float>(v294EffectiveProfileRows, 0.0),
        array.new<float>(v294EffectiveProfileRows, 0.0),
        array.new<int>(v294EffectiveProfileRows, 0)
    )

    while array.size(VP.boxes) > 0
        box.delete(array.pop(VP.boxes))

    while array.size(srBoxes) > 0
        box.delete(array.pop(srBoxes))
    while array.size(srLabels) > 0
        label.delete(array.pop(srLabels))

    if not na(chipReliabilityLabel)
        label.delete(chipReliabilityLabel)
        chipReliabilityLabel := na
    if not na(valueMigrationLabel)
        label.delete(valueMigrationLabel)
        valueMigrationLabel := na
    if not na(openSkyLabel)
        label.delete(openSkyLabel)
        openSkyLabel := na
    if not na(mapCoverageLabel)
        label.delete(mapCoverageLabel)
        mapCoverageLabel := na
    if not na(v24BattleTable) and not v26_showBattleTable
        table.delete(v24BattleTable)
        v24BattleTable := na
    if not na(recentPocLine)
        line.delete(recentPocLine)
        recentPocLine := na
    if not na(openSkyLine)
        line.delete(openSkyLine)
        openSkyLine := na

//==================================================================================================
// PROFILE RANGE
//==================================================================================================
if bar.idx == last_bar_index - vp_profileLength
    VP.startIndex := bar.idx
    lowestPrice := bar.l
    highestPrice := bar.h
else if bar.idx > last_bar_index - vp_profileLength
    lowestPrice := math.min(bar.l, lowestPrice)
    highestPrice := math.max(bar.h, highestPrice)

// choose LTF feed
if vp_profileLength <= 700
    ltfBarData := requestBarData(calculateTimeframe(2))
    // Sparse-LTF current-bar fallback: do not let one empty realtime lower-TF array suppress the entire map.
    // Historical bars keep the original lower-TF behavior; this fallback affects only barstate.islast.
    if barstate.islast and ltfBarData.size() == 0
        ltfBarData := array.new<mprSbeBar>(1, mprSbeBar.new(bar.o, bar.h, bar.l, bar.c, bar.v, bar.idx))
        v292CurrentLtfFallback := true
else
    ltfBarData := array.new<mprSbeBar>(1, mprSbeBar.new(bar.o, bar.h, bar.l, bar.c, bar.v, bar.idx))

// collect historical LTF bars
if barstate.ishistory and (bar.idx >= last_bar_index - vp_profileLength) and bar.idx < last_bar_index and ltfBarData.size() > 0
    if not na(nz(ltfBarData.get(0).v))
        for j = 0 to ltfBarData.size() - 1
            barDataArray.barHigh.push(ltfBarData.get(j).h)
            barDataArray.barLow.push(ltfBarData.get(j).l)
            barDataArray.barVolume.push(ltfBarData.get(j).v)
            barDataArray.barPolarity.push(ltfBarData.get(j).c > ltfBarData.get(j).o)
        barDataArray.barCount.push(ltfBarData.size())

priceStep = (highestPrice - lowestPrice) / v294EffectiveProfileRows
atr = ta.atr(sr_atrLen)
avgVolSeries = ta.sma(volume, chip_turnoverLen)
v24TrendEma = ta.ema(close, v24_runwayTrendLen)
v24TrendUp = not na(v24TrendEma[v24_runwaySlopeBars]) and close > v24TrendEma and v24TrendEma > v24TrendEma[v24_runwaySlopeBars]
v24TrendDown = not na(v24TrendEma[v24_runwaySlopeBars]) and close < v24TrendEma and v24TrendEma < v24TrendEma[v24_runwaySlopeBars]
stepOk = priceStep > 0
ltfHasData = ltfBarData.size() > 0
buildNow = barstate.islast and ltfHasData and stepOk

// Shared build-state variables. These are intentionally declared outside the main build block so the
// final status/diagnostic drawing block can be split out. This avoids TradingView CE10205: if statement too long.
float[] chipTotal = array.new<float>(0)
float[] chipBull = array.new<float>(0)
