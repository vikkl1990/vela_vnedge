bool v256BrokenTestGate = false
bool v256AirRoomGate = false
bool v256AirTestGate = false
float v256UpperMemoryPrice = na
float v256UpperMemoryAtr = 100000.0
int v256UpperMemoryHits = 0
string v256UpperMemorySource = "none"
float mapConfidenceRawScore = na
float mapConfidenceScore = na
string mapConfidenceClass = "Low"
int mapWarningCode = 0

// v3.0 P1.1 scope fix: pressure scorer is declared only after all profile arrays/state it reads exist.
// v3.0 P1: Inventory Pressure Rails. Pressure is a participation/acceptance proxy, not participant identity.
// Absolute rail length uses density + local prominence + VP/Chip confluence + price-memory evidence,
// then applies the final MAP/MIC confidence state. P1.5 does not infer participant identity or a buy signal.
v300PressureScore(_lvl) =>
    float rawV = volumeDataArray.totalVolume.get(_lvl)
    float chipV = array.size(chipTotal) > _lvl ? chipTotal.get(_lvl) : 0.0
    float rawSum = volumeDataArray.totalVolume.sum()
    float chipSum = array.size(chipTotal) > 0 ? chipTotal.sum() : 0.0
    bool chipReady = chipMaxNode > 0 and chipSum > 0
    float rowsF = math.max(1.0, float(v294EffectiveProfileRows))
    float rawN = rawMaxNode > 0 ? rawV / rawMaxNode : 0.0
    float chipN = chipMaxNode > 0 ? chipV / chipMaxNode : 0.0
    float rawD = rawSum > 0 ? clamp01((rawV / rawSum * rowsF) / 2.20) : 0.0
    float chipD = chipSum > 0 ? clamp01((chipV / chipSum * rowsF) / 2.20) : 0.0
    float pmN = pmMaxScore > 0 and array.size(pmScoreArr) > _lvl ? clamp01(pmScoreArr.get(_lvl) / pmMaxScore) : 0.0
    float rawP = rawN * 0.55 + rawD * 0.45
    float chipP = chipN * 0.55 + chipD * 0.45
    float base = chipReady ? rawP * 0.35 + chipP * 0.25 + math.min(rawP, chipP) * 0.25 + pmN * 0.15 : rawP * 0.80 + pmN * 0.20
    float q = na(mapConfidenceScore) ? 0.60 : clamp01(mapConfidenceScore / 100.0)
    float score = 100.0 * clamp01(base * (0.45 + q * 0.55))
    score

// v3.0 P1.5.2: Diagnostic audit uses the same Pareto-first survivor selection as production Pressure Rails.
// Production rail math/drawing is unchanged; this only fixes audit parity.
v315WriteRailAudit(table _t) =>
    table.clear(_t, 0, 0, 3, 41)
    color hb = color.new(color.gray, 28)
    color bb = color.new(color.black, 8)
    color tx = color.white
    table.cell(_t, 0, 0, "RAIL AUDIT", text_color=tx, bgcolor=hb, text_size=size.tiny)
    table.cell(_t, 0, 1, "PR#", text_color=tx, bgcolor=bb, text_size=size.tiny)
    table.cell(_t, 1, 1, "Price", text_color=tx, bgcolor=bb, text_size=size.tiny)
    table.cell(_t, 2, 1, "S | A/%", text_color=tx, bgcolor=bb, text_size=size.tiny)
    table.cell(_t, 3, 1, "STATE/PARETO", text_color=tx, bgcolor=bb, text_size=size.tiny)
    int rows = v294EffectiveProfileRows
    float[] scoreArr = array.new<float>(rows, 0.0)
    bool[] keepArr = array.new<bool>(rows, false)
    for lvl = 0 to rows - 1
        array.set(scoreArr, lvl, v300PressureScore(lvl))
    for lvl = 0 to rows - 1
        float sc = array.get(scoreArr, lvl)
        if sc >= v300_railMinScore
            float y = lowestPrice + (lvl + 0.5) * priceStep
            float d = math.abs(y - close)
            bool sideUp = y >= close
            bool dominated = false
            for j = 0 to rows - 1
                if j != lvl
                    float sj = array.get(scoreArr, j)
                    if sj >= v300_railMinScore
                        float yj = lowestPrice + (j + 0.5) * priceStep
                        float dj = math.abs(yj - close)
                        if (yj >= close) == sideUp and sj >= sc and dj <= d and (sj > sc or dj < d)
                            dominated := true
            array.set(keepArr, lvl, not dominated)
    int[] picked = array.new<int>(0)
    int maxPick = math.min(v300_railMaxCount, rows)
    for pick = 0 to maxPick - 1
        int best = -1
        float bestSc = v300_railMinScore - 0.0001
        for lvl = 0 to rows - 1
            float sc = array.get(scoreArr, lvl)
            if array.get(keepArr, lvl) and sc > bestSc and array.indexof(picked, lvl) == -1
                best := lvl
                bestSc := sc
        if best == -1
            break
        array.push(picked, best)
    if array.size(picked) > 0
        for ri = 0 to array.size(picked) - 1
            int lvl = array.get(picked, ri)
            int tr = ri + 2
            float y = lowestPrice + (lvl + 0.5) * priceStep
            float sc = array.get(scoreArr, lvl)
            float dAtr = atr > 0 ? (y - close) / atr : na
            float dPct = close != 0 ? (y - close) / close * 100.0 : na
            string st = close > y and close[1] <= y ? "RELUP" : close < y and close[1] >= y ? "RELDN" : high >= y and low <= y ? "TEST" : close > y ? "ABV" : "BLW"
            string ptxt = "S" + str.tostring(sc, "#") + " | " + (na(dAtr) ? "?" : str.tostring(dAtr, "#.##")) + "A " + (na(dPct) ? "?" : str.tostring(dPct, "#.##")) + "%"
            table.cell(_t, 0, tr, str.tostring(ri + 1), text_color=tx, bgcolor=bb, text_size=size.tiny)
            table.cell(_t, 1, tr, str.tostring(y, format.mintick), text_color=tx, bgcolor=bb, text_size=size.tiny)
            table.cell(_t, 2, tr, ptxt, text_color=tx, bgcolor=bb, text_size=size.tiny)
            table.cell(_t, 3, tr, st + " | KEEP/DRAW", text_color=tx, bgcolor=bb, text_size=size.tiny)
    0


// v2.8.1 Phase 1B: final Memory Shelf Authority renderer.
// Normal mode no longer draws every raw VP/Chip row. It renders a small set of merged final zones after
// PM, STRUCT, DEV, lifecycle, map confidence, guard, source-quality, and reliability logic are available.
// AIR remains a transition corridor and cannot receive normal shelf authority.
v280StateQuality(_state) =>
    _state == 1 ? 1.00 : (_state == 2 or _state == 3) ? 0.92 : _state == 4 ? 0.84 : _state == 5 ? 0.70 : 0.35

v280SourceQuality(_kind, _src, _hasShares, _airConfirmed) =>
    float q = 0.45
    if _kind == 1 and _src == 3
        q := 1.00
    else if _kind == 1 and _src == 1
        q := 0.88
    else if _kind == 1 and _src == 2
        q := _hasShares ? 0.74 : 0.56
    else if _kind == 3
        q := 0.78
    else if _kind == 2
        q := 0.68
    else if _kind == 4
        q := 0.55
    else if _kind == -2
        q := _airConfirmed ? 0.46 : 0.30
    else if _kind == -1
        q := 0.22
    q

v280FallbackMapScore() =>
    bool hasConfluence = false
    bool hasVpOnly = false
    bool hasChipOnly = false
    bool hasPriceMemory = false
    bool hasAirPm = false
    bool hasStructuralMemory = false
    bool hasDevMemory = false
    bool hasCurrentBattle = false
    bool hasSupport = false
    bool hasResistance = false
    bool hasUsefulNearMemory = false
    bool hasNonStaleMemory = false
    if zN > 0
        for zi = 0 to zN - 1
            kd = array.get(zKind, zi)
            src = array.get(zSrc, zi)
            st = array.get(zState, zi)
            dAtr = array.get(zDistAtr, zi)
            bot = array.get(zBot, zi)
            top = array.get(zTop, zi)
            airConfirmed = v24AirShelfConfirmed(kd, array.get(zPmReact, zi), array.get(zPmCloses, zi), array.get(zPmPivots, zi))
            actionable = v24IsActionableMemory(kd, airConfirmed)
            nearNow = st != 6 and (dAtr <= effLowMapAtrReach() or st == 1 or st == 2 or st == 3 or st == 4)
            hasNonStaleMemory := hasNonStaleMemory or st != 6
            if nearNow
                hasConfluence := hasConfluence or (kd == 1 and src == 3)
                hasVpOnly := hasVpOnly or (kd == 1 and src == 1)
                hasChipOnly := hasChipOnly or (kd == 1 and src == 2)
                hasPriceMemory := hasPriceMemory or kd == 2
                hasAirPm := hasAirPm or kd == -2
                hasStructuralMemory := hasStructuralMemory or kd == 3
                hasDevMemory := hasDevMemory or kd == 4
                hasUsefulNearMemory := hasUsefulNearMemory or actionable
                hasCurrentBattle := hasCurrentBattle or (close >= bot and close <= top) or v255CurrentTouch(close, bot, top, atr)
                hasSupport := hasSupport or (actionable and close > top)
                hasResistance := hasResistance or (actionable and close < bot)
    lowMap = not hasUsefulNearMemory
    guardActive = v251BracketGuardActive or v251BrokenRecoveryActive or v256UpperMemoryGate or v256BrokenTestGate
    fallbackHeavy = v27FallbackHeavy(hasConfluence, hasVpOnly, hasChipOnly, hasPriceMemory, hasAirPm, hasStructuralMemory, hasDevMemory)
    noUsefulNearMemory = not hasConfluence and not hasVpOnly and not hasChipOnly and not hasPriceMemory and not hasAirPm and not hasStructuralMemory and not hasDevMemory
    staleFarDominant = zN > 0 and hasNonStaleMemory and not hasUsefulNearMemory
    v27MapConfidenceScore(lowMap, abnormalStructure, hasConfluence, hasVpOnly, hasChipOnly, hasPriceMemory, hasAirPm, hasStructuralMemory, hasDevMemory, hasCurrentBattle, hasSupport, hasResistance, hasSharesOut, useChips, guardActive, v256UpperMemoryGate, noUsefulNearMemory, fallbackHeavy, staleFarDominant)

v280ZoneAuthority(_zi, _mapScore, _mapWarn, _zWtMax) =>
    kd = array.get(zKind, _zi)
    src = array.get(zSrc, _zi)
    st = array.get(zState, _zi)
    bot = array.get(zBot, _zi)
    top = array.get(zTop, _zi)
    dAtr = array.get(zDistAtr, _zi)
    touches = array.get(zTouches, _zi)
    rejects = array.get(zRejects, _zi)
    lastTouch = array.get(zLastTouch, _zi)
    lastCross = array.get(zLastCross, _zi)
    lastCrossDir = array.get(zCrossDir, _zi)
    relScore = array.get(zRelScore, _zi)
    histScore = array.get(zHistScore, _zi)
    pmReact = array.get(zPmReact, _zi)
    pmCloses = array.get(zPmCloses, _zi)
    pmPivots = array.get(zPmPivots, _zi)
    msTouches = array.get(zMsTouches, _zi)
    msHighs = array.get(zMsHighs, _zi)
    msLows = array.get(zMsLows, _zi)
    devScore = array.get(zDevScore, _zi)
    airConfirmed = v24AirShelfConfirmed(kd, pmReact, pmCloses, pmPivots)
    rawReliability = v27ZoneReliabilityScore(kd, src, hasSharesOut, _mapScore, abnormalStructure, _mapWarn, st, dAtr, touches, rejects, lastTouch, lastCross, lastCrossDir, relScore, histScore, pmReact, pmCloses, pmPivots, msTouches, devScore, airConfirmed, close > top, close < bot)
    reliabilityCap = v27ZoneReliabilityCap(kd, src, hasSharesOut, st, dAtr, lastTouch, _mapWarn, abnormalStructure, airConfirmed, msTouches, msHighs, msLows)
    reliability = v27ZoneReliabilityCappedScore(rawReliability, reliabilityCap)
    locationNorm = _zWtMax > 0 ? math.max(0.0, math.min(1.0, array.get(zWt, _zi) / _zWtMax)) : 0.0
    lifeQ = v280StateQuality(st)
    sourceQ = v280SourceQuality(kd, src, hasSharesOut, airConfirmed)
    distanceQ = math.max(0.30, 1.0 - dAtr / math.max(v296TradeAtr * 1.50, 0.25))
    actionable = v24IsActionableMemory(kd, airConfirmed)
    authority = reliability * 0.60 + locationNorm * 20.0 + lifeQ * 10.0 + sourceQ * 10.0
    authority *= 0.82 + distanceQ * 0.18
    if not actionable
        authority := kd == -1 or kd == -2 ? math.min(34.0, reliability * 0.45 + locationNorm * 12.0) : 0.0
    if st == 6
        authority *= 0.55
    [reliability, locationNorm, math.max(0.0, math.min(100.0, authority)), airConfirmed]

// v2.8.2 Phase 1C: transitive shelf families and adjacency compression.
// Overlapping, touching, and narrowly separated zones are unioned before visual selection. The
// highest-authority member keeps its own geometry; transitive family evidence adds confluence only.
v282FamilyLink(_a, _b) =>
    aBot = array.get(zBot, _a)
    aTop = array.get(zTop, _a)
    bBot = array.get(zBot, _b)
    bTop = array.get(zTop, _b)
    aCenter = array.get(zCenter, _a)
    bCenter = array.get(zCenter, _b)
    overlap = math.max(0.0, math.min(aTop, bTop) - math.max(aBot, bBot))
    narrowWidth = math.max(syminfo.mintick, math.min(math.abs(aTop - aBot), math.abs(bTop - bBot)))
    overlapRatio = overlap / narrowWidth
    gap = math.max(0.0, math.max(aBot, bBot) - math.min(aTop, bTop))
    gapAtr = atr > 0 ? gap / atr : 100000.0
    centerAtr = atr > 0 ? math.abs(aCenter - bCenter) / atr : 100000.0
    pcRaw = v27ModePresetCode(v27_presetMode)
    pc = pcRaw == 0 ? v27AutoPresetCode() : pcRaw
    adjAtr = pc == 3 ? 0.15 : pc == 2 ? 0.10 : 0.08
    adjWidth = pc == 3 ? 0.20 : pc == 2 ? 0.15 : 0.12
    centerMax = pc == 3 ? 0.55 : pc == 2 ? 0.40 : 0.30
    splitAtr = pc == 3 ? 0.30 : pc == 2 ? 0.25 : 0.20
    adjacency = gap <= math.max(atr > 0 ? atr * adjAtr : 0.0, narrowWidth * adjWidth)
    centerLink = centerAtr <= centerMax and gapAtr <= splitAtr
    priceBetween = gap > 0 and close > math.min(aTop, bTop) and close < math.max(aBot, bBot)
    linked = overlapRatio >= 0.18 or adjacency or centerLink
    linked and not (priceBetween and gapAtr >= splitAtr)

v282Root(array<int> _parent, _x) =>
    int r = _x
    while array.get(_parent, r) != r
        r := array.get(_parent, r)
    r

v282Union(array<int> _parent, _a, _b) =>
    ra = v282Root(_parent, _a)
    rb = v282Root(_parent, _b)
    if ra != rb
        array.set(_parent, rb, ra)
    0

v282Eligible(_zi, array<bool> _airConfirmedArr) =>
    kd = array.get(zKind, _zi)
    st = array.get(zState, _zi)
    dAtr = array.get(zDistAtr, _zi)
    dPct = array.get(zDistPct, _zi)
    airOk = array.get(_airConfirmedArr, _zi)
    actionable = v24IsActionableMemory(kd, airOk)
    pcRawR = v27ModePresetCode(v27_presetMode)
    pcR = pcRawR == 0 ? v27AutoPresetCode() : pcRawR
    maxAtrR = (pcR == 3 ? 5.0 : pcR == 2 ? 4.0 : 3.0) * v296RadiusScale
    maxPctR = (pcR == 3 ? 45.0 : pcR == 2 ? 30.0 : 20.0) * v296RadiusScale
    inReach = dAtr <= maxAtrR and dPct <= maxPctR
    st != 6 and ((actionable and (inReach or st == 1)) or (not actionable and (kd == -1 or kd == -2) and dAtr <= math.min(v296LvnAtr, maxAtrR) and dPct <= maxPctR))

v282FamilyBonus(_zi, array<int> _parent, array<bool> _airConfirmedArr) =>
    kd0 = array.get(zKind, _zi)
    air0 = array.get(_airConfirmedArr, _zi)
    actionable0 = v24IsActionableMemory(kd0, air0)
    bool hasVolume = kd0 == 1
    bool hasPm = kd0 == 2 or (kd0 == -2 and air0)
    bool hasStruct = kd0 == 3
    bool hasDev = kd0 == 4
    root0 = v282Root(_parent, _zi)
    if actionable0 and zN > 1
        for zj = 0 to zN - 1
            if zj != _zi and v282Root(_parent, zj) == root0
                kdJ = array.get(zKind, zj)
                airJ = array.get(_airConfirmedArr, zj)
                if v24IsActionableMemory(kdJ, airJ)
                    hasVolume := hasVolume or kdJ == 1
                    hasPm := hasPm or kdJ == 2 or (kdJ == -2 and airJ)
                    hasStruct := hasStruct or kdJ == 3
                    hasDev := hasDev or kdJ == 4
    familyCount = (hasVolume ? 1 : 0) + (hasPm ? 1 : 0) + (hasStruct ? 1 : 0) + (hasDev ? 1 : 0)
    actionable0 ? math.min(7.5, math.max(0, familyCount - 1) * 2.5) : 0.0

// v3.0 P1.5.4: P1.5.1 rails retained; REL label is offset right to avoid overlap with UP/DN labels.
// Pareto Pressure Rails + current relevance/release + terminal endpoint price text.
// No distance cutoff or distance weighting is introduced. The nearest surviving rail on each side is
// highlighted categorically, while rail length remains a direct linear display of Pressure Score.
// REL marks a close crossing of a surviving pressure rail on the current bar; it is a release candidate, not a trade signal.
v300DrawPressureRails() =>
    int rows = v294EffectiveProfileRows
    float[] scoreArr = array.new<float>(rows, 0.0)
    bool[] keepArr = array.new<bool>(rows, false)
    for lvl = 0 to rows - 1
        array.set(scoreArr, lvl, v300PressureScore(lvl))
    for lvl = 0 to rows - 1
        float sc = array.get(scoreArr, lvl)
        if sc >= v300_railMinScore
            float y = lowestPrice + (lvl + 0.5) * priceStep
            float d = math.abs(y - close)
            bool sideUp = y >= close
            bool dominated = false
            for j = 0 to rows - 1
                if j != lvl
                    float sj = array.get(scoreArr, j)
                    if sj >= v300_railMinScore
                        float yj = lowestPrice + (j + 0.5) * priceStep
                        float dj = math.abs(yj - close)
                        if (yj >= close) == sideUp and sj >= sc and dj <= d and (sj > sc or dj < d)
                            dominated := true
            array.set(keepArr, lvl, not dominated)

    int[] picked = array.new<int>(0)
    int maxPick = math.min(v300_railMaxCount, rows)
    for pick = 0 to maxPick - 1
        int best = -1
        float bestSc = v300_railMinScore - 0.0001
        for lvl = 0 to rows - 1
            float sc = array.get(scoreArr, lvl)
            if array.get(keepArr, lvl) and sc > bestSc and array.indexof(picked, lvl) == -1
                best := lvl
                bestSc := sc
        if best == -1
            break
        array.push(picked, best)

    int nearUp = -1
    int nearDn = -1
    float nearUpD = 1e20
    float nearDnD = 1e20
    float relY = na
    float relSc = na
    int relDir = 0
    if array.size(picked) > 0
        for pi = 0 to array.size(picked) - 1
            int lvl = array.get(picked, pi)
            float y = lowestPrice + (lvl + 0.5) * priceStep
            float d = math.abs(y - close)
            if y >= close and d < nearUpD
                nearUp := lvl
                nearUpD := d
            if y < close and d < nearDnD
                nearDn := lvl
                nearDnD := d
            if close > y and close[1] <= y and (relDir != 1 or na(relY) or y > relY)
                relY := y
                relSc := array.get(scoreArr, lvl)
                relDir := 1
            if close < y and close[1] >= y and (relDir != -1 or na(relY) or y < relY)
                relY := y
                relSc := array.get(scoreArr, lvl)
                relDir := -1

    bool anchorLeft = v280_histAnchorSide == "Left Edge (extends right)"
    int anchorIndex = anchorLeft ? math.max(0, last_bar_index - vp_profileLength) : last_bar_index
    int minLen = math.max(1, v276_shelfMinLen)
    int maxLen = math.max(minLen, v276_shelfMaxLen)
    color rc = v276_memoryShelfColor
    if array.size(picked) > 0
        for pi = 0 to array.size(picked) - 1
            int lvl = array.get(picked, pi)
            float sc = array.get(scoreArr, lvl)
            int railLen = math.max(minLen, int(math.round(maxLen * clamp01(sc / 100.0))))
            int x1 = anchorLeft ? anchorIndex : anchorIndex - railLen
            int x2 = anchorLeft ? anchorIndex + railLen : anchorIndex
            float y = lowestPrice + (lvl + 0.5) * priceStep
            float half = math.max(syminfo.mintick, priceStep * v300_railThickness * 0.45)
            bool near = lvl == nearUp or lvl == nearDn
            bool relSameRail = relDir != 0 and not na(relY) and math.abs(y - relY) <= syminfo.mintick * 0.5
            int tr0 = int(math.max(15.0, math.min(78.0, 76.0 - sc * 0.62)))
            int tr = near ? math.max(6, tr0 - 18) : math.min(90, tr0 + 10)
            VP.boxes.push(box.new(x1, y + half, x2, y - half, xloc=xloc.bar_index, border_color=color.new(rc, math.max(0, tr - 18)), border_width=near ? 2 : 1, border_style=line.style_solid, bgcolor=color.new(rc, tr), force_overlay=true))
            srLabels.push(label.new(anchorLeft ? x2 : x1, y + half * 2.0, str.tostring(y, format.mintick), xloc.bar_index, yloc.price, color.new(rc, 100), label.style_none, rc, size.normal, text.align_center))
            if near and not relSameRail
                string nt = (lvl == nearUp ? "UP " : "DN ") + str.tostring(y, format.mintick) + " | P" + str.tostring(sc, "#")
                srLabels.push(label.new(last_bar_index + 1, y, nt, xloc.bar_index, yloc.price, color.new(rc, 30), label.style_label_left, color.white, size.small, text.align_left))
    if relDir != 0 and not na(relY)
        string rt = (relDir == 1 ? "REL UP " : "REL DN ") + str.tostring(relY, format.mintick) + " | P" + str.tostring(relSc, "#")
        srLabels.push(label.new(last_bar_index + 4, relY, rt, xloc.bar_index, yloc.price, color.new(rc, 10), label.style_label_left, color.white, size.small, text.align_left))
    0.0


// Memory Shelf Histogram / Diagnostic renderer. Pressure Rails uses v300DrawPressureRails above.
v280DrawMemoryShelfAuthority() =>
    int minLen = math.max(0, v276_shelfMinLen)
    int maxLen = math.max(minLen, v276_shelfMaxLen)
    float exponent = v276_shelfContrast == "Extreme" ? 2.15 : v276_shelfContrast == "Strong" ? 1.65 : 1.20
    bool anchorLeft = v280_histAnchorSide == "Left Edge (extends right)"
    int profileStartIndex = math.max(0, last_bar_index - vp_profileLength)
    int anchorIndex = anchorLeft ? profileStartIndex : nz(v278_rightVisibleBarIndex, last_bar_index) + 1
    bool vaReady = not na(VP.valLevel) and not na(VP.vahLevel) and not na(VP.pocLevel)
    float renderMapScore = na(mapConfidenceScore) ? v280FallbackMapScore() : mapConfidenceScore
    float activeRelativeFloor = v288EffectiveRelativeFloor
    float activeAbsoluteFloor = v288EffectiveAbsoluteFloor
    int renderMapWarn = na(mapConfidenceScore) ? (abnormalStructure ? 2 : renderMapScore < 40.0 ? 1 : 0) : mapWarningCode
    float zWtMax = zN > 0 ? zWt.max() : 0.0
    float[] authArr = array.new<float>(zN, 0.0)
    float[] reliabilityArr = array.new<float>(zN, 0.0)
    float[] locationArr = array.new<float>(zN, 0.0)
    float[] clusterBonusArr = array.new<float>(zN, 0.0)
    bool[] airConfirmedArr = array.new<bool>(zN, false)
    int[] parent = array.new<int>(zN, 0)

    if zN > 0
        for zi = 0 to zN - 1
            array.set(parent, zi, zi)
            [rel, loc, auth, airOk] = v280ZoneAuthority(zi, renderMapScore, renderMapWarn, zWtMax)
            array.set(reliabilityArr, zi, rel)
            array.set(locationArr, zi, loc)
            array.set(authArr, zi, auth)
            array.set(airConfirmedArr, zi, airOk)

    if zN > 1
        for za = 0 to zN - 2
            if v282Eligible(za, airConfirmedArr)
                for zb = za + 1 to zN - 1
                    if v282Eligible(zb, airConfirmedArr) and v282FamilyLink(za, zb)
                        unionResult = v282Union(parent, za, zb)
        for zi = 0 to zN - 1
            array.set(parent, zi, v282Root(parent, zi))

    if zN > 0
        for zi = 0 to zN - 1
            clusterBonus = v282FamilyBonus(zi, parent, airConfirmedArr)
            array.set(clusterBonusArr, zi, clusterBonus)
            array.set(authArr, zi, math.min(100.0, array.get(authArr, zi) + clusterBonus))

    int[] famRoots = array.new<int>(0)
    int[] famRep = array.new<int>(0)
    int[] famInsideRep = array.new<int>(0)
    float[] famAuth = array.new<float>(0)
    float[] famInsideAuth = array.new<float>(0)
    float[] famBot = array.new<float>(0)
    float[] famTop = array.new<float>(0)
    bool[] famActionable = array.new<bool>(0)

    if zN > 0
        for zi = 0 to zN - 1
            if v282Eligible(zi, airConfirmedArr)
                root = array.get(parent, zi)
                fi = array.indexof(famRoots, root)
                if fi == -1
                    array.push(famRoots, root)
                    array.push(famRep, -1)
                    array.push(famInsideRep, -1)
                    array.push(famAuth, -1.0)
                    array.push(famInsideAuth, -1.0)
                    array.push(famBot, array.get(zBot, zi))
                    array.push(famTop, array.get(zTop, zi))
                    array.push(famActionable, false)
                    fi := array.size(famRoots) - 1
                bot = array.get(zBot, zi)
                top = array.get(zTop, zi)
                auth = array.get(authArr, zi)
                kd = array.get(zKind, zi)
                actionable = v24IsActionableMemory(kd, array.get(airConfirmedArr, zi))
                wasActionable = array.get(famActionable, fi)
                array.set(famBot, fi, math.min(array.get(famBot, fi), bot))
                array.set(famTop, fi, math.max(array.get(famTop, fi), top))
                if actionable
                    if not wasActionable or auth > array.get(famAuth, fi)
                        array.set(famRep, fi, zi)
                        array.set(famAuth, fi, auth)
                    array.set(famActionable, fi, true)
                    if close >= bot and close <= top and auth > array.get(famInsideAuth, fi)
                        array.set(famInsideRep, fi, zi)
                        array.set(famInsideAuth, fi, auth)
                else if not wasActionable and auth > array.get(famAuth, fi)
                    array.set(famRep, fi, zi)
                    array.set(famAuth, fi, auth)

    float maxAuthority = 0.0
    if array.size(famRoots) > 0
        for fi = 0 to array.size(famRoots) - 1
            if array.get(famActionable, fi)
                maxAuthority := math.max(maxAuthority, array.get(famAuth, fi))

    int[] selected = array.new<int>(0)
    int[] selectedFam = array.new<int>(0)
    int bestFi = -1
    float bestAuth = -1.0

    if array.size(famRoots) > 0
        for fi = 0 to array.size(famRoots) - 1
            auth = array.get(famAuth, fi)
            if array.get(famActionable, fi) and close >= array.get(famBot, fi) and close <= array.get(famTop, fi) and auth > bestAuth
                bestFi := fi
                bestAuth := auth
    if bestFi != -1
        rep = array.get(famInsideRep, bestFi)
        array.push(selectedFam, bestFi)
        array.push(selected, rep != -1 ? rep : array.get(famRep, bestFi))

    bestFi := -1
    bestAuth := -1.0
    float bestDist = 100000.0
    if array.size(famRoots) > 0 and array.size(selected) < v27_railMaxZones
        for fi = 0 to array.size(famRoots) - 1
            d = atr > 0 ? (close - array.get(famTop, fi)) / atr : 100000.0
            auth = array.get(famAuth, fi)
            if array.get(famActionable, fi) and close > array.get(famTop, fi) and array.indexof(selectedFam, fi) == -1 and (d < bestDist or (d == bestDist and auth > bestAuth))
                bestFi := fi
                bestDist := d
                bestAuth := auth
    if bestFi != -1
        array.push(selectedFam, bestFi)
        array.push(selected, array.get(famRep, bestFi))

    bestFi := -1
    bestAuth := -1.0
    bestDist := 100000.0
    if array.size(famRoots) > 0 and array.size(selected) < v27_railMaxZones
        for fi = 0 to array.size(famRoots) - 1
            d = atr > 0 ? (array.get(famBot, fi) - close) / atr : 100000.0
            auth = array.get(famAuth, fi)
            if array.get(famActionable, fi) and close < array.get(famBot, fi) and array.indexof(selectedFam, fi) == -1 and (d < bestDist or (d == bestDist and auth > bestAuth))
                bestFi := fi
                bestDist := d
                bestAuth := auth
    if bestFi != -1
        array.push(selectedFam, bestFi)
        array.push(selected, array.get(famRep, bestFi))

    if array.size(famRoots) > 0 and array.size(selected) < v27_railMaxZones
        bestFi := -1
        bestDist := 100000.0
        for fi = 0 to array.size(famRoots) - 1
            fBot = array.get(famBot, fi)
            fTop = array.get(famTop, fi)
            d = close > fTop ? (atr > 0 ? (close - fTop) / atr : 100000.0) : close < fBot ? (atr > 0 ? (fBot - close) / atr : 100000.0) : 0.0
            if not array.get(famActionable, fi) and array.indexof(selectedFam, fi) == -1 and d <= v296LvnAtr and d < bestDist
                bestFi := fi
                bestDist := d
        if bestFi != -1
            array.push(selectedFam, bestFi)
            array.push(selected, array.get(famRep, bestFi))

    while array.size(selected) < v27_railMaxZones and array.size(famRoots) > 0 and maxAuthority > 0
        bestFi := -1
        bestAuth := -1.0
        for fi = 0 to array.size(famRoots) - 1
            auth = array.get(famAuth, fi)
            if array.get(famActionable, fi) and array.indexof(selectedFam, fi) == -1 and auth >= activeAbsoluteFloor and auth / maxAuthority >= activeRelativeFloor and auth > bestAuth
                bestFi := fi
                bestAuth := auth
        if bestFi == -1
            break
        array.push(selectedFam, bestFi)
        array.push(selected, array.get(famRep, bestFi))

    int[] importantIdx = array.new<int>(0)
    if v289_showShelfText and array.size(selected) > 0 and maxAuthority > 0
        for pick = 0 to v278_importantShelfCount - 1
            int bestZi = -1
            float bestAuth = -1.0
            for si = 0 to array.size(selected) - 1
                zi = array.get(selected, si)
                kd = array.get(zKind, zi)
                airOk = array.get(airConfirmedArr, zi)
                actionable = v24IsActionableMemory(kd, airOk)
                fi = array.get(selectedFam, si)
                auth = array.get(famAuth, fi)
                relAuth = auth / maxAuthority
                if actionable and relAuth >= v278_importantShelfMinStrength and array.indexof(importantIdx, zi) == -1 and auth > bestAuth
                    bestZi := zi
                    bestAuth := auth
            if bestZi != -1
                array.push(importantIdx, bestZi)

    if array.size(selected) > 0 and maxAuthority > 0
        for si = 0 to array.size(selected) - 1
            zi = array.get(selected, si)
            fi = array.get(selectedFam, si)
            familyLow = array.get(famBot, fi)
            familyHigh = array.get(famTop, fi)
            kd = array.get(zKind, zi)
            st = array.get(zState, zi)
            centerY = array.get(zCenter, zi)
            zoneLow = array.get(zBot, zi)
            zoneHigh = array.get(zTop, zi)
            auth = array.get(famAuth, fi)
            reliability = array.get(reliabilityArr, zi)
            locationNorm = array.get(locationArr, zi)
            airOk = array.get(airConfirmedArr, zi)
            actionable = v24IsActionableMemory(kd, airOk)
            relativeAuthority = math.max(0.0, math.min(1.0, auth / maxAuthority))
            absoluteAuthority = math.max(0.0, math.min(1.0, auth / 100.0))
            visualAuthority = math.max(0.0, math.min(1.0, absoluteAuthority * 0.65 + relativeAuthority * 0.35))
            shaped = math.pow(visualAuthority, exponent)
            shelfLen = int(math.round(minLen + shaped * (maxLen - minLen)))
            zoneHalf = math.max(syminfo.mintick, math.abs(zoneHigh - zoneLow) * 0.5)
            pcRawW = v27ModePresetCode(v27_presetMode)
            pcW = pcRawW == 0 ? v27AutoPresetCode() : pcRawW
            minHalf = math.max(syminfo.mintick, priceStep * 0.50)
            atrHalf = atr > 0 ? atr * (pcW == 3 ? 1.00 : pcW == 2 ? 0.75 : 0.60) : zoneHalf
            pctHalf = math.abs(close) * (pcW == 3 ? 0.10 : pcW == 2 ? 0.07 : 0.05)
            maxHalf = math.max(minHalf, math.min(atrHalf, pctHalf))
            displayHalf = math.max(minHalf, math.min(zoneHalf * (0.38 + locationNorm * 0.62), maxHalf))
            displayCenter = centerY
            currentFamily = close >= familyLow and close <= familyHigh
            battleEdge = displayHalf > 0 ? math.min(1.0, math.abs(close - displayCenter) / displayHalf) : 1.0
            if pcW == 3 and currentFamily
                displayHalf := math.max(minHalf, math.min(displayHalf, math.abs(close) * (0.05 + battleEdge * battleEdge * 0.05)))
            if currentFamily
                displayCenter := math.max(close - displayHalf * 0.85, math.min(close + displayHalf * 0.85, displayCenter))
            topY = displayCenter + displayHalf
            botY = displayCenter - displayHalf
            mapQuality = math.max(0.0, math.min(1.0, renderMapScore / 100.0))
            int transparency = int(math.round(92.0 - visualAuthority * 25.0 - mapQuality * 12.0))
            if kd == 4
                transparency += 7
            else if kd == 2 or kd == 3
                transparency += 3
            else if kd == -2
                transparency += airOk ? 10 : 16
            else if kd == -1
                transparency += 18
            if st == 5
                transparency += 4
            transparency := math.max(48, math.min(98, transparency))
            borderTransparency = math.max(24, transparency - 25)
            borderWidth = reliability >= 75.0 ? 2 : 1
            borderStyle = kd == 1 ? line.style_solid : (kd == 2 or kd == 3) ? line.style_dashed : line.style_dotted
            shelfColor = not actionable ? color.orange : v276_memoryShelfColor
            int shelfStart = anchorLeft ? anchorIndex : anchorIndex - shelfLen
            int shelfEnd = anchorLeft ? anchorIndex + shelfLen : anchorIndex
            VP.boxes.push(box.new(shelfStart, topY, shelfEnd, botY, xloc=xloc.bar_index, border_color=color.new(shelfColor, borderTransparency), border_width=borderWidth, border_style=borderStyle, bgcolor=color.new(shelfColor, transparency)))

            if v289_showShelfText and array.indexof(importantIdx, zi) != -1
                shelfWidth = math.abs(topY - botY)
                shelfWidthPct = math.abs(displayCenter) > syminfo.mintick ? shelfWidth / math.abs(displayCenter) * 100.0 : 0.0
                widthTxt = " (" + str.tostring(shelfWidthPct, "#.0") + "%)"
                priceTxt = (v278_shelfPriceMode == "Center Price" ? str.tostring(displayCenter, format.mintick) : str.tostring(botY, format.mintick) + " - " + str.tostring(topY, format.mintick)) + widthTxt
                roleTxt = close > familyHigh ? "Support memory" : close < familyLow ? "Resistance memory" : "Current battle family"
                priceTip = roleTxt + " | A " + str.tostring(auth, "#.0") + " | R " + str.tostring(reliability, "#.0")
                int shelfLeftX = math.min(shelfStart, shelfEnd)
                int shelfRightX = math.max(shelfStart, shelfEnd)
                int shelfCenterX = int(math.round((shelfLeftX + shelfRightX) * 0.5))
                int priceLabelX = v278_shelfPricePosition == "Left End" ? shelfLeftX : v278_shelfPricePosition == "Center" ? shelfCenterX : shelfRightX
                labelStyle = v278_shelfPricePosition == "Left End" ? label.style_label_left : v278_shelfPricePosition == "Center" ? label.style_label_center : label.style_label_right
                labelAlign = v278_shelfPricePosition == "Left End" ? text.align_left : v278_shelfPricePosition == "Center" ? text.align_center : text.align_right
                lb = label.new(priceLabelX, displayCenter, priceTxt, xloc.bar_index, yloc.price, color.new(shelfColor, 78), labelStyle, chart.fg_color, size.tiny, labelAlign, priceTip)
                array.push(srLabels, lb)

    if v289_showValueMarkers and vaReady
        markerLen = math.max(5, int(math.round(maxLen * 0.22)))
        int markerStart = anchorLeft ? anchorIndex : anchorIndex - markerLen
        int markerEnd = anchorLeft ? anchorIndex + markerLen : anchorIndex
        markerHalf = math.max(syminfo.mintick, priceStep * 0.025)
        vahY = lowestPrice + (VP.vahLevel + 1.0) * priceStep
        valY = lowestPrice + VP.valLevel * priceStep
        pocY = lowestPrice + (VP.pocLevel + 0.5) * priceStep
        VP.boxes.push(box.new(markerStart, vahY + markerHalf, markerEnd, vahY - markerHalf, xloc=xloc.bar_index, border_color=color.new(v276_memoryShelfColor, 32), border_width=1, border_style=line.style_dashed, bgcolor=color.new(v276_memoryShelfColor, 82)))
        VP.boxes.push(box.new(markerStart, valY + markerHalf, markerEnd, valY - markerHalf, xloc=xloc.bar_index, border_color=color.new(v276_memoryShelfColor, 32), border_width=1, border_style=line.style_dashed, bgcolor=color.new(v276_memoryShelfColor, 82)))
        VP.boxes.push(box.new(markerStart, pocY + markerHalf * 1.4, markerEnd, pocY - markerHalf * 1.4, xloc=xloc.bar_index, border_color=color.new(v276_memoryShelfColor, 18), border_width=2, border_style=line.style_solid, bgcolor=color.new(v276_memoryShelfColor, 68)))
    0.0


// v2.7.1 Phase 5 CE10295 fix: open-sky object logic wrapped in a helper to offset hidden BUS plot calls.
v27UpdateOpenSky(label _skyLabel, line _skyLine, bool _lowMapCoverageState) =>
    int outLookbackLen = math.min(vp_profileLength, math.max(2, int(math.round(effOpenSkyLookbackDays() * barsPerDay))))
    float outPrevHigh = na
    for osh = 1 to outLookbackLen
        outPrevHigh := na(outPrevHigh) ? high[osh] : math.max(outPrevHigh, high[osh])
    bool outTrueResistanceNear = false
    float outNearestTrueResistanceAtr = 100000.0
    if zN > 0
        for osi = 0 to zN - 1
            kd = array.get(zKind, osi)
            st = array.get(zState, osi)
            bot = array.get(zBot, osi)
            dAtr = array.get(zDistAtr, osi)
            showByState = vis_showStale or st != 6
            airConfirmedSky = v24AirShelfConfirmed(kd, array.get(zPmReact, osi), array.get(zPmCloses, osi), array.get(zPmPivots, osi))
            isTrueMemory = v24IsActionableMemory(kd, airConfirmedSky)
            if isTrueMemory and showByState and close < bot
                outNearestTrueResistanceAtr := math.min(outNearestTrueResistanceAtr, dAtr)
                if dAtr <= effOpenSkyResistanceAtr()
                    outTrueResistanceNear := true
    bool outOpenSkyBreakout = v23_showOpenSky and not na(outPrevHigh) and atr > 0 and close > outPrevHigh + atr * v23_openSkyBreakoutAtr
    bool outOpenSkyBlockedByGuard = (v251_blockOpenSkyOnGuards and (v251BracketGuardActive or v251BrokenRecoveryActive)) or _lowMapCoverageState or abnormalStructure
    bool outOpenSkyActive = outOpenSkyBreakout and not outTrueResistanceNear and not outOpenSkyBlockedByGuard
    label outSkyLabel = _skyLabel
    line outSkyLine = _skyLine
    if v23_showOpenSky and outOpenSkyActive and not vis_memoryRailMode
        skyTxt = "OPEN SKY | EXT RISK"
        skyTip = "Open-Sky mode: price is above the previous " + str.tostring(effOpenSkyLookbackDays()) + "-day high and no true nearby overhead memory is detected within " + str.tostring(effOpenSkyResistanceAtr(), "#.##") + " ATR." +
                 "\nThis is not a buy signal." +
                 "\nInterpretation: classical overhead supply is weak/absent; risk shifts to extension, volatility, failed breakout, and distance from value." +
                 "\nPrevious lookback high: " + str.tostring(outPrevHigh, format.mintick) +
                 "\nNearest true resistance: " + (outNearestTrueResistanceAtr >= 100000 ? "none" : str.tostring(outNearestTrueResistanceAtr, "#.##") + " ATR") +
                 "\nOpen-sky blocked by v2.5.6 guard: " + str.tostring(outOpenSkyBlockedByGuard)
        outSkyLabel := label.new(last_bar_index + 1, high, skyTxt, xloc.bar_index, yloc.price, openSkyBg, label.style_label_left, openSkyFg, size.tiny, text.align_left, skyTip)
        if v23_openSkyLine
            outSkyLine := line.new(math.max(VP.startIndex, last_bar_index - outLookbackLen), outPrevHigh, last_bar_index, outPrevHigh, xloc=xloc.bar_index, extend=extend.none, color=openSkyLineColor, style=line.style_dotted, width=1)
    else
        if not na(outSkyLabel)
            label.delete(outSkyLabel)
            outSkyLabel := na
        if not na(outSkyLine)
            line.delete(outSkyLine)
            outSkyLine := na
    [outSkyLabel, outSkyLine, outLookbackLen, outPrevHigh, outTrueResistanceNear, outNearestTrueResistanceAtr, outOpenSkyBreakout, outOpenSkyActive]


//==================================================================================================
// v2.8.9.3 token-lean: retain only the reliability badge helper.
//==================================================================================================

v255UpdateChipReliabilityLabel(label _lb) =>
    label out = _lb
    if vis_showReliabilityBadge and useChips and not vis_memoryRailMode
        badgeTxt = hasSharesOut ? "Chip: shares" : "Chip: fallback"
        badgeTip = hasSharesOut ? "Chip model uses reported shares outstanding when available." : "Chip model uses fallback turnover estimate. Treat chip zones as lower-confidence approximation."
        badgeColor = hasSharesOut ? color.new(color.green, 78) : color.new(color.orange, 72)
        badgeY = highestPrice
        badgeX = last_bar_index + 1
        if na(out)
            out := label.new(badgeX, badgeY, badgeTxt, xloc.bar_index, yloc.price, badgeColor, label.style_label_left, chart.fg_color, size.tiny, text.align_left, badgeTip)
        else
            label.set_xy(out, badgeX, badgeY)
            label.set_text(out, badgeTxt)
            label.set_color(out, badgeColor)
            label.set_textcolor(out, chart.fg_color)
            label.set_size(out, size.tiny)
            label.set_style(out, label.style_label_left)
            label.set_tooltip(out, badgeTip)
    else
        if not na(out)
            label.delete(out)
            out := na
    out

//==================================================================================================
// CLEAN PREVIOUS DRAWINGS - split out to keep main build block below TradingView CE10205 limits
//==================================================================================================
if buildNow
    while array.size(VP.boxes) > 0
        box.delete(array.pop(VP.boxes))

    while array.size(srBoxes) > 0
        box.delete(array.pop(srBoxes))
    while array.size(srLabels) > 0
        label.delete(array.pop(srLabels))

    if not na(VP.pocPolyline)
        polyline.delete(VP.pocPolyline)
        VP.pocPolyline := na

    if not na(pocLine)
        line.delete(pocLine)
        pocLine := na
    if not na(recentPocLine)
        line.delete(recentPocLine)
        recentPocLine := na
    if not na(valueMigrationLabel)
        label.delete(valueMigrationLabel)
        valueMigrationLabel := na
    if not na(openSkyLabel)
        label.delete(openSkyLabel)
        openSkyLabel := na
    if not na(mapCoverageLabel)
        label.delete(mapCoverageLabel)
        mapCoverageLabel := na
    if not na(openSkyLine)
        line.delete(openSkyLine)
        openSkyLine := na
    if not na(v24BattleTable) and not v26_showBattleTable
        table.delete(v24BattleTable)
        v24BattleTable := na

//==================================================================================================
// MAIN BUILD - only on last bar
//==================================================================================================
if buildNow
    // Rolling LTF arrays within window
    if barDataArray.barCount.size() > vp_profileLength
        bc = barDataArray.barCount.shift()
        for _ = 0 to bc - 1
            barDataArray.barHigh.shift()
            barDataArray.barLow.shift()
            barDataArray.barVolume.shift()
            barDataArray.barPolarity.shift()

    // add current ltf bars
    if not na(nz(ltfBarData.get(0).v))
        for j = 0 to ltfBarData.size() - 1
            barDataArray.barHigh.push(ltfBarData.get(j).h)
            barDataArray.barLow.push(ltfBarData.get(j).l)
            barDataArray.barVolume.push(ltfBarData.get(j).v)
            barDataArray.barPolarity.push(ltfBarData.get(j).c > ltfBarData.get(j).o)
        barDataArray.barCount.push(ltfBarData.size())

    // Reset bins
    for i = 0 to v294EffectiveProfileRows - 1
        volumeDataArray.totalVolume.set(i, 0.0)
        volumeDataArray.bullishVolume.set(i, 0.0)
        volumeDataArray.endProfileIndex.set(i, 0)

    // Rebuild volume profile bins from LTF bar arrays
    barIndex = vp_profileLength
    numberOfBars = 0
    arraySize = barDataArray.barVolume.size()

    VP.pocPoints.clear()

    for arrayIndex = 0 to arraySize - 1
        levelHigh = barDataArray.barHigh.get(arrayIndex)
        levelLow  = barDataArray.barLow.get(arrayIndex)
        levelVol  = barDataArray.barVolume.get(arrayIndex)

        int startSlot = math.max(math.floor((levelLow - lowestPrice) / priceStep), 0)
        int endSlot   = math.min(math.floor((levelHigh - lowestPrice) / priceStep), v294EffectiveProfileRows - 1)

        for p = startSlot to endSlot
            float priceLevel = lowestPrice + p * priceStep

            volProp = v255BinOverlap(levelLow, levelHigh, priceLevel, priceStep)

            volumeDataArray.totalVolume.set(p, volumeDataArray.totalVolume.get(p) + levelVol * volProp)
            if barDataArray.barPolarity.get(arrayIndex)
                volumeDataArray.bullishVolume.set(p, volumeDataArray.bullishVolume.get(p) + levelVol * volProp)

        // Developing POC is volume-based only. In chip source mode, use regular POC for consistency.
        if (vp_pocShow == "Developing") and (not chip_useAsSource)
            curMax = volumeDataArray.totalVolume.max()
            curPocLevel = volumeDataArray.totalVolume.indexof(curMax)
            if curPocLevel != -1
                if arrayIndex == barDataArray.barCount.get(vp_profileLength - barIndex)
                    mprSbeBar b = bar[barIndex]
                    VP.pocPoints.push(chart.point.from_index(b.idx, math.avg(b.h, b.l)))
                    VP.pocPoints.push(chart.point.from_index(b.idx + 1, lowestPrice + (curPocLevel + 0.5) * priceStep))
                    numberOfBars += barDataArray.barCount.get(vp_profileLength - barIndex)
                    barIndex -= 1
                else if arrayIndex == (numberOfBars + barDataArray.barCount.get(vp_profileLength - barIndex)) and numberOfBars != 0
                    mprSbeBar b = bar[barIndex]
                    VP.pocPoints.push(chart.point.from_index(b.idx + 1, lowestPrice + (curPocLevel + 0.5) * priceStep))
                    numberOfBars += barDataArray.barCount.get(vp_profileLength - barIndex)
                    barIndex -= 1
                else if barIndex == 0
                    mprSbeBar b = bar[barIndex]
                    VP.pocPoints.push(chart.point.from_index(b.idx + 1, lowestPrice + (curPocLevel + 0.5) * priceStep))
                    numberOfBars += barDataArray.barCount.get(vp_profileLength - barIndex)

    if (vp_pocShow == "Developing") and (not chip_useAsSource) and (VP.pocPoints.size() > 1)
        VP.pocPolyline := polyline.new(VP.pocPoints, false, false, xloc.bar_index, white20, color(na), line.style_solid, vp_pocWidth)

    //==================================================================================================
    // CHIP DISTRIBUTION - Cost Basis Approximation via Turnover Migration
    //==================================================================================================
    chipTotal := array.new<float>(v294EffectiveProfileRows, 0.0)
    chipBull := array.new<float>(v294EffectiveProfileRows, 0.0)

    sharesOut := na
    if chip_useSharesOut
        sharesOut := request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ")

    hasSharesOut := chip_useSharesOut and not na(sharesOut) and sharesOut > 0
    for k = vp_profileLength to 0
        float vBar = volume[k]
        if vBar > 0
            float avgV = nz(avgVolSeries[k], vBar)

            float tBase = na
            if hasSharesOut
                tBase := vBar / sharesOut
            else
                tBase := effFallbackTurnoverGuess() * (avgV > 0 ? (vBar / avgV) : 1.0)

            float turnover = clamp01(tBase * chip_turnoverScale)

            if turnover > 0
                for r = 0 to v294EffectiveProfileRows - 1
                    chipTotal.set(r, chipTotal.get(r) * (1.0 - turnover))
                    chipBull.set(r,  chipBull.get(r)  * (1.0 - turnover))

                float hi = high[k]
                float lo = low[k]
                bool isBullBar = close[k] > open[k]

                if hi == lo
                    int slot = int(math.floor((lo - lowestPrice) / priceStep))
                    slot := math.max(0, math.min(v294EffectiveProfileRows - 1, slot))
                    chipTotal.set(slot, chipTotal.get(slot) + turnover)
                    if isBullBar
                        chipBull.set(slot, chipBull.get(slot) + turnover)
                else
                    int startSlot = math.max(int(math.floor((lo - lowestPrice) / priceStep)), 0)
                    int endSlot   = math.min(int(math.floor((hi - lowestPrice) / priceStep)), v294EffectiveProfileRows - 1)

                    float sumW = 0.0
                    for p = startSlot to endSlot
                        float priceLevel = lowestPrice + p * priceStep
                        float w = v255BinOverlap(lo, hi, priceLevel, priceStep)
                        sumW += w

                    if sumW > 0
                        for p = startSlot to endSlot
                            float priceLevel = lowestPrice + p * priceStep
                            float w = v255BinOverlap(lo, hi, priceLevel, priceStep)

                            float d = w / sumW
                            chipTotal.set(p, chipTotal.get(p) + turnover * d)
                            if isBullBar
                                chipBull.set(p, chipBull.get(p) + turnover * d)

    //==================================================================================================
    // V2.2 RECENT PROFILE - raw traded-volume window for value migration
    // This is deliberately raw-volume based. It measures recent acceptance, not estimated cost basis.
    //==================================================================================================
    recentTotal := array.new<float>(v294EffectiveProfileRows, 0.0)
    recentBull := array.new<float>(v294EffectiveProfileRows, 0.0)

    for rk = v22_recentProfileLength to 0
        float rVol = volume[rk]
        if rVol > 0
            float rHi = high[rk]
            float rLo = low[rk]
            bool rBull = close[rk] > open[rk]

            if rHi == rLo
                int rSlot = int(math.floor((rLo - lowestPrice) / priceStep))
                rSlot := math.max(0, math.min(v294EffectiveProfileRows - 1, rSlot))
                recentTotal.set(rSlot, recentTotal.get(rSlot) + rVol)
                if rBull
                    recentBull.set(rSlot, recentBull.get(rSlot) + rVol)
            else
                int rStart = math.max(int(math.floor((rLo - lowestPrice) / priceStep)), 0)
                int rEnd   = math.min(int(math.floor((rHi - lowestPrice) / priceStep)), v294EffectiveProfileRows - 1)
                float rSumW = 0.0
                for rp = rStart to rEnd
                    float rPriceLevel = lowestPrice + rp * priceStep
                    float rW = v255BinOverlap(rLo, rHi, rPriceLevel, priceStep)
                    rSumW += rW

                if rSumW > 0
                    for rp = rStart to rEnd
                        float rPriceLevel = lowestPrice + rp * priceStep
                        float rW = v255BinOverlap(rLo, rHi, rPriceLevel, priceStep)
                        float rShare = rW / rSumW
                        recentTotal.set(rp, recentTotal.get(rp) + rVol * rShare)
                        if rBull
                            recentBull.set(rp, recentBull.get(rp) + rVol * rShare)

    recentMaxNode := recentTotal.max()
    recentPocLevel := recentMaxNode > 0 ? recentTotal.indexof(recentMaxNode) : -1
    recentPocPrice := recentPocLevel != -1 ? (lowestPrice + (recentPocLevel + 0.5) * priceStep) : na

    //==================================================================================================
    // Source handling
    // v2.1: POC/profile histogram can still use the selected Chip/Volume source, but zone detection
    // can use VP + Chip confluence so raw traded volume and estimated holder memory are compared.
    //==================================================================================================
    useChips := chip_useAsSource
    useHybridZones := v21_useHybridConfluence
    pocModeEff := (useChips and vp_pocShow == "Developing") ? "Regular" : vp_pocShow
    rawMaxNode := volumeDataArray.totalVolume.max()
    chipMaxNode := chipTotal.max()
    nodeMax := useChips ? chipMaxNode : rawMaxNode

    //==================================================================================================
    // V2.2.1-P2B - INDEPENDENT PRICE-MEMORY FALLBACK
    // This engine is intentionally independent from VP/Chip nodes. It detects repeated price reactions
    // first, then later merges with volume/chip zones. This prevents PM from disappearing when volume is thin.
    //==================================================================================================
    pmScoreArr := array.new<float>(v294EffectiveProfileRows, 0.0)
    pmPivotScoreArr := array.new<float>(v294EffectiveProfileRows, 0.0)
    pmReactArr := array.new<int>(v294EffectiveProfileRows, 0)
    pmCloseArr := array.new<int>(v294EffectiveProfileRows, 0)
    pmWickArr := array.new<int>(v294EffectiveProfileRows, 0)
    pmFailArr := array.new<int>(v294EffectiveProfileRows, 0)
    pmPivotArr := array.new<int>(v294EffectiveProfileRows, 0)
    pmOldestAgoArr := array.new<int>(v294EffectiveProfileRows, -1)
    pmNewestAgoArr := array.new<int>(v294EffectiveProfileRows, 100000)

    pmLookbackRaw = int(math.round(effPmLookbackDays() * barsPerDay))
    pmLookbackLen := math.min(vp_profileLength, math.max(1, pmLookbackRaw))

    if v221_usePriceMemory
        // A) Close/wick/failed-test memory: repeated behavior around an ATR-normalized band.
        for pk = pmLookbackLen to 0
            localAtr = atr[pk]
            if not na(localAtr) and localAtr > 0
                band = math.max(priceStep, localAtr * effPmReactionBand())
                int pmStart = math.max(int(math.floor((low[pk] - band - lowestPrice) / priceStep)), 0)
                int pmEnd   = math.min(int(math.floor((high[pk] + band - lowestPrice) / priceStep)), v294EffectiveProfileRows - 1)
                recW = math.pow(v221_pmDecay, pk)

                for pl = pmStart to pmEnd
                    pmPrice = lowestPrice + (pl + 0.5) * priceStep
                    closeInside = math.abs(close[pk] - pmPrice) <= band
                    touchedBand = high[pk] >= pmPrice - band and low[pk] <= pmPrice + band

                    // Wick reaction = traded through/into the band, then closed away from the band.
                    wickRejectUp = touchedBand and low[pk] <= pmPrice + band and close[pk] > pmPrice + band
                    wickRejectDn = touchedBand and high[pk] >= pmPrice - band and close[pk] < pmPrice - band

                    // Failed test/retest = bar tries through a level/band but closes back on the original side.
                    failBreakUp = high[pk] >= pmPrice + band and close[pk] < pmPrice and open[pk] <= pmPrice
                    failBreakDn = low[pk] <= pmPrice - band and close[pk] > pmPrice and open[pk] >= pmPrice
                    failedTest = failBreakUp or failBreakDn
                    wickReaction = wickRejectUp or wickRejectDn

                    if closeInside or wickReaction or failedTest
                        pmReactArr.set(pl, pmReactArr.get(pl) + 1)
                        addScore = (closeInside ? v221_pmCloseWeight : 0.0) + (wickReaction ? v221_pmWickWeight : 0.0) + (failedTest ? v221_pmFailWeight : 0.0)
                        pmScoreArr.set(pl, pmScoreArr.get(pl) + addScore * recW)
                        pmOldestAgoArr.set(pl, math.max(pmOldestAgoArr.get(pl), pk))
                        pmNewestAgoArr.set(pl, math.min(pmNewestAgoArr.get(pl), pk))
                        if closeInside
                            pmCloseArr.set(pl, pmCloseArr.get(pl) + 1)
                        if wickReaction
                            pmWickArr.set(pl, pmWickArr.get(pl) + 1)
                        if failedTest
                            pmFailArr.set(pl, pmFailArr.get(pl) + 1)

        // B) Pivot-reaction memory: repeated swing highs/lows at the same price band.
        // This is the independent fallback that catches obvious reactions even when volume/chip is weak.
        if v221_pmUsePivotReactions
            pivotLeftEff = math.max(1, v221_pmPivotLeft)
            pivotRightEff = math.max(1, v221_pmPivotRight)
            for pk = pmLookbackLen to 0
                localAtr = atr[pk]
                canEvalPivot = not na(localAtr) and localAtr > 0 and pk >= pivotRightEff and pk + pivotLeftEff <= pmLookbackLen
                if canEvalPivot
                    bool isPivotHigh = true
                    bool isPivotLow = true

                    for pp = 1 to pivotLeftEff
                        if high[pk] <= high[pk + pp]
                            isPivotHigh := false
                        if low[pk] >= low[pk + pp]
                            isPivotLow := false

                    for pp = 1 to pivotRightEff
                        if high[pk] < high[pk - pp]
                            isPivotHigh := false
                        if low[pk] > low[pk - pp]
                            isPivotLow := false

                    pivotBand = math.max(priceStep, localAtr * effPmReactionBand())
                    recW = math.pow(v221_pmDecay, pk)

                    if isPivotHigh
                        int pivStart = math.max(int(math.floor((high[pk] - pivotBand - lowestPrice) / priceStep)), 0)
                        int pivEnd   = math.min(int(math.floor((high[pk] + pivotBand - lowestPrice) / priceStep)), v294EffectiveProfileRows - 1)
                        for pl = pivStart to pivEnd
                            pmReactArr.set(pl, pmReactArr.get(pl) + 1)
                            pmPivotArr.set(pl, pmPivotArr.get(pl) + 1)
                            pmScoreArr.set(pl, pmScoreArr.get(pl) + v221_pmPivotWeight * recW)
                            pmPivotScoreArr.set(pl, pmPivotScoreArr.get(pl) + v221_pmPivotWeight * recW)
                            pmOldestAgoArr.set(pl, math.max(pmOldestAgoArr.get(pl), pk))
                            pmNewestAgoArr.set(pl, math.min(pmNewestAgoArr.get(pl), pk))

                    if isPivotLow
                        int pivStart = math.max(int(math.floor((low[pk] - pivotBand - lowestPrice) / priceStep)), 0)
                        int pivEnd   = math.min(int(math.floor((low[pk] + pivotBand - lowestPrice) / priceStep)), v294EffectiveProfileRows - 1)
                        for pl = pivStart to pivEnd
                            pmReactArr.set(pl, pmReactArr.get(pl) + 1)
                            pmPivotArr.set(pl, pmPivotArr.get(pl) + 1)
                            pmScoreArr.set(pl, pmScoreArr.get(pl) + v221_pmPivotWeight * recW)
                            pmPivotScoreArr.set(pl, pmPivotScoreArr.get(pl) + v221_pmPivotWeight * recW)
                            pmOldestAgoArr.set(pl, math.max(pmOldestAgoArr.get(pl), pk))
                            pmNewestAgoArr.set(pl, math.min(pmNewestAgoArr.get(pl), pk))

    pmMaxScore := pmScoreArr.max()
    pmMaxPivotScore := pmPivotScoreArr.max()
    pmRawCandidateBins := 0
    pmAcceptedCandidateBins := 0
    pmRejectedFewReactions := 0
    pmRejectedShortSpan := 0
    pmRejectedLowScore := 0

// Split: POC, candidate, zone, and drawing work starts here. Keeps compiler if-block size low.
if buildNow
    //==================================================================================================
    // Compute POC + Value Area internally
    //==================================================================================================
    VP.pocLevel := useChips ? chipTotal.indexof(nodeMax) : volumeDataArray.totalVolume.indexof(nodeMax)

    totalTraded = useChips ? (chipTotal.sum() * vp_valueAreaThreshold) : (volumeDataArray.totalVolume.sum() * vp_valueAreaThreshold)
    vaVol = VP.pocLevel != -1 ? (useChips ? chipTotal.get(VP.pocLevel) : volumeDataArray.totalVolume.get(VP.pocLevel)) : 0.0

    VP.vahLevel := VP.pocLevel
    VP.valLevel := VP.pocLevel

    while vaVol < totalTraded
        if VP.valLevel == 0 and VP.vahLevel == v294EffectiveProfileRows - 1
            break

        volAbove = 0.0
        if VP.vahLevel < v294EffectiveProfileRows - 1
            volAbove := useChips ? chipTotal.get(VP.vahLevel + 1) : volumeDataArray.totalVolume.get(VP.vahLevel + 1)

        volBelow = 0.0
        if VP.valLevel > 0
            volBelow := useChips ? chipTotal.get(VP.valLevel - 1) : volumeDataArray.totalVolume.get(VP.valLevel - 1)

        if volAbove == 0 and volBelow == 0
            break

        if volAbove >= volBelow
            vaVol += volAbove
            VP.vahLevel += 1
        else
            vaVol += volBelow
            VP.valLevel -= 1

    pocPrice := (VP.pocLevel != -1) ? (lowestPrice + (VP.pocLevel + 0.5) * priceStep) : na

    //==================================================================================================
    // V2.2 VALUE MIGRATION
    // Compares long-profile POC with recent raw-volume POC. This tells whether acceptance has migrated.
    //==================================================================================================
    valueDeltaAtr := (not na(recentPocPrice) and not na(pocPrice) and atr > 0) ? (recentPocPrice - pocPrice) / atr : na
    valueState := valueStateText(valueDeltaAtr, effValueMigrationThreshold())
    valueShort := valueStateShort(valueDeltaAtr, effValueMigrationThreshold())
    priceVsRecentValue := priceVsValueText(close, recentPocPrice, atr, effValueMigrationThreshold())
    recentStartIndex := math.max(VP.startIndex, last_bar_index - v22_recentProfileLength)

    //==================================================================================================
    // Draw POC
    //==================================================================================================
    if pocModeEff == "Regular" and VP.pocLevel != -1 and not vis_memoryRailMode
        pocLine := line.new(VP.startIndex, pocPrice, last_bar_index, pocPrice, xloc=xloc.bar_index, extend=extend.none, color=white20, style=line.style_solid, width=vp_pocWidth)

    // V2.2 Recent POC line/badge. v2.6.1: hide in Clean by default because it is context, not a decision zone.
    recentPocDisplay = vis_memoryRailMode ? "Hidden" : v22_showRecentPoc
    if recentPocDisplay != "Hidden" and not na(recentPocPrice)
        recentPocLine := line.new(recentStartIndex, recentPocPrice, last_bar_index, recentPocPrice, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.aqua, 72), style=line.style_dashed, width=1)
        if recentPocDisplay == "Line + Label" and v22_showValueBadge
            valueTip = "Recent raw-volume POC: " + str.tostring(recentPocPrice, format.mintick) +
                 "\nLong profile POC: " + (na(pocPrice) ? "n/a" : str.tostring(pocPrice, format.mintick)) +
                 "\nValue migration: " + valueState +
                 "\nPOC delta: " + (na(valueDeltaAtr) ? "n/a" : str.tostring(valueDeltaAtr, "#.##") + " ATR") +
                 "\n" + priceVsRecentValue +
                 "\nRecent lookback: " + str.tostring(effRecentProfileDays()) + " days"
            valueMigrationLabel := label.new(last_bar_index + 1, recentPocPrice, valueShort, xloc.bar_index, yloc.price, color.new(color.aqua, 88), label.style_label_left, chart.fg_color, size.tiny, text.align_left, valueTip)

    //==================================================================================================
    // v2.8.0 MEMORY SHELF AUTHORITY ROUTING
    // Diagnostic mode preserves the original split profile histogram.
    // Normal mode defers rendering until final PM/STRUCT/DEV/lifecycle/reliability/map-confidence state exists.
    //==================================================================================================
    profilePlotLen = vp_profileLength > 360 ? 360 : vp_profileLength
    profWidthBars  = profilePlotLen * vp_profileWidth
    profileAutoHidden = vp_profilePlacement == "Auto-hide in Current Battle" and vis_displayMode == "Current Battle Map"
    profilePolicyAllows = vis_memoryRailMode ? true : vis_profilePolicy == "Always Off" ? false : vis_profilePolicy == "Always On" ? true : vis_profilePolicy == "Use Core Input" ? true : vis_visualMode == "Diagnostic"
    profileShouldDraw = vp_profileShow and nodeMax > 0 and (vis_memoryRailMode or (profilePolicyAllows and vp_profilePlacement != "Hidden" and not profileAutoHidden))
    profileBg = vis_visualMode == "Diagnostic" ? white20 : color.new(color.gray, vis_profileDimTransparency)

    if profileShouldDraw
        if vis_memoryRailMode
            // v2.8.1: deferred. Clustered final authority shelves are rendered after reliability and map confidence are available.
            int authorityRenderDeferred = 1
        else
            for lvl = 0 to v294EffectiveProfileRows - 1
                tot  = useChips ? chipTotal.get(lvl) : volumeDataArray.totalVolume.get(lvl)
                bull = useChips ? chipBull.get(lvl)  : volumeDataArray.bullishVolume.get(lvl)
                bear = math.max(tot - bull, 0.0)

                x1 = vp_profilePlacement == "Right Margin" ? last_bar_index + vp_profileRightOffset : VP.startIndex
                x2 = int(x1 + (bull / nodeMax) * profWidthBars)
                VP.boxes.push(box.new(x1, lowestPrice + (lvl + 0.1) * priceStep, x2, lowestPrice + (lvl + 0.9) * priceStep,
                                      border_color=color(na), bgcolor=profileBg))

                x3 = x2
                x4 = int(x3 + (bear / nodeMax) * profWidthBars)
                VP.boxes.push(box.new(x3, lowestPrice + (lvl + 0.1) * priceStep, x4, lowestPrice + (lvl + 0.9) * priceStep,
                                      border_color=color(na), bgcolor=profileBg))

                volumeDataArray.endProfileIndex.set(lvl, x4)

    //==================================================================================================
    // Base price labels
    //==================================================================================================
    profilePriceLabelsAllowed = not vis_memoryRailMode and vp_profileLevels != "None" and VP.pocLevel != -1 and (vis_visualMode == "Diagnostic" or profileShouldDraw)
    if profilePriceLabelsAllowed
        lbHigh := updateLabel(lbHigh, VP.startIndex, highestPrice, str.tostring(highestPrice, format.mintick), label.style_label_down, "Profile High")
        lbPOC  := updateLabel(lbPOC,  last_bar_index, pocPrice,     str.tostring(pocPrice, format.mintick),     label.style_label_left, "Point of Control")
        lbLow  := updateLabel(lbLow,  VP.startIndex, lowestPrice,   str.tostring(lowestPrice,  format.mintick), label.style_label_up,   "Profile Low")

    //==================================================================================================
    // PEAKS + TROUGHS -> CANDIDATE ZONES
    // kind: 1 = HVN acceptance, 4 = DEV developing memory, 3 = STRUCT, 2 = PM, -2 = AIR+PM, -1 = LVN / air pocket
    //==================================================================================================
    candLvl := array.new<int>(0)
    candWt := array.new<float>(0)
    candDelta := array.new<float>(0)
    candKind := array.new<int>(0)
    candSrc := array.new<int>(0)  // 1=VP-only, 2=Chip-only, 3=VP+Chip confluence, 4=Raw LVN/AIR, 5=PM, 6=AIR+PM, 7=STRUCT

    vmaxNode = useHybridZones ? 1.0 : nodeMax
    N = math.max(1, int(v294EffectiveProfileRows * 0.09))

    // Peaks / HVNs
    for lvl = 0 to v294EffectiveProfileRows - 1
        rawV = volumeDataArray.totalVolume.get(lvl)
        chipV = chipTotal.get(lvl)
        rawNorm = rawMaxNode > 0 ? rawV / rawMaxNode : 0.0
        chipNorm = chipMaxNode > 0 ? chipV / chipMaxNode : 0.0
        v = useHybridZones ? math.max(rawNorm, chipNorm) : (useChips ? chipV : rawV)

        if vmaxNode > 0 and (v / vmaxNode) >= effPeakRelToMaxMin()
            left  = math.max(0, lvl - N)
            right = math.min(v294EffectiveProfileRows - 1, lvl + N)

            bool isPeak = true
            neighSum = 0.0
            neighCnt = 0

            for k = left to right
                if k != lvl
                    rawVk = volumeDataArray.totalVolume.get(k)
                    chipVk = chipTotal.get(k)
                    rawNormK = rawMaxNode > 0 ? rawVk / rawMaxNode : 0.0
                    chipNormK = chipMaxNode > 0 ? chipVk / chipMaxNode : 0.0
                    vk = useHybridZones ? math.max(rawNormK, chipNormK) : (useChips ? chipVk : rawVk)
                    neighSum += vk
                    neighCnt += 1
                    if vk >= v
                        isPeak := false

            neighAvg = neighCnt > 0 ? neighSum / neighCnt : v
            prom = neighAvg > 0 ? v / neighAvg : 999.0

            if isPeak and prom >= effPeakProminenceMin()
                rawBull = volumeDataArray.bullishVolume.get(lvl)
                rawBear = math.max(rawV - rawBull, 0.0)
                chipBullV = chipBull.get(lvl)
                chipBear = math.max(chipV - chipBullV, 0.0)
                rawDelta = rawV > 0 ? (rawBull - rawBear) / rawV : 0.0
                chipDelta = chipV > 0 ? (chipBullV - chipBear) / chipV : 0.0

                bool vpHigh = rawNorm >= v21_vpConfirmMin
                bool chipHigh = chipNorm >= v21_chipConfirmMin
                src = vpHigh and chipHigh ? 3 : vpHigh ? 1 : chipHigh ? 2 : (useChips ? 2 : 1)
                deltaPct = src == 3 ? (rawDelta + chipDelta) / 2.0 : src == 2 ? chipDelta : rawDelta

                // Hybrid weights are normalized. Confluent zones earn full weight; one-source zones are deliberately lower confidence.
                wt = useHybridZones ? (src == 3 ? (rawNorm + chipNorm) / 2.0 : math.max(rawNorm, chipNorm) * 0.75) : v

                array.push(candLvl, lvl)
                array.push(candWt, wt)
                array.push(candDelta, deltaPct)
                array.push(candKind, 1)
                array.push(candSrc, src)

    // Troughs / LVNs / Air pockets
    // v2.1: AIR pockets are based on raw traded-volume scarcity, not chip estimates. Low actual participation is what creates a transition corridor.
    if sr_includeTroughs and rawMaxNode > 0
        for lvl = 0 to v294EffectiveProfileRows - 1
            rawV = volumeDataArray.totalVolume.get(lvl)
            rawNorm = rawMaxNode > 0 ? rawV / rawMaxNode : 0.0
            v = rawNorm
            if v <= 0.20
                left  = math.max(0, lvl - N)
                right = math.min(v294EffectiveProfileRows - 1, lvl + N)

                bool isTrough = true
                neighSum = 0.0
                neighCnt = 0

                for k = left to right
                    if k != lvl
                        rawVk = volumeDataArray.totalVolume.get(k)
                        vk = rawMaxNode > 0 ? rawVk / rawMaxNode : 0.0
                        neighSum += vk
                        neighCnt += 1
                        if vk <= v
                            isTrough := false

                neighAvg = neighCnt > 0 ? neighSum / neighCnt : v
                troughProm = v > 0 ? neighAvg / v : 999.0

                if isTrough and troughProm >= effPeakProminenceMin()
                    // LVN weight represents valley strength, not raw volume.
                    troughStrength = 1.0 - v
                    rawBull = volumeDataArray.bullishVolume.get(lvl)
                    rawBear = math.max(rawV - rawBull, 0.0)
                    deltaPct = rawV > 0 ? (rawBull - rawBear) / rawV : 0.0
                    pmOkHere = v221_usePriceMemory and pmMaxScore > 0 and pmReactArr.get(lvl) >= v291EffectivePmMinReactions and pmScoreArr.get(lvl) >= v221_pmMinScore

                    array.push(candLvl, lvl)
                    array.push(candWt, pmOkHere ? math.max(troughStrength, pmScoreArr.get(lvl) / pmMaxScore) : troughStrength)
                    array.push(candDelta, deltaPct)
                    array.push(candKind, pmOkHere ? -2 : -1)
                    array.push(candSrc, pmOkHere ? 6 : 4)

    // Independent Price-Memory fallback candidates.
    // P2B intentionally does NOT require an existing VP/Chip node. Adjacent accepted PM bins merge later.
    if v221_usePriceMemory and pmMaxScore > 0
        for lvl = 0 to v294EffectiveProfileRows - 1
            pmScore = pmScoreArr.get(lvl)
            pmNorm = pmScore / pmMaxScore
            pmReact = pmReactArr.get(lvl)
            pmCloses = pmCloseArr.get(lvl)
            pmPivots = pmPivotArr.get(lvl)
            pmOldestAgo = pmOldestAgoArr.get(lvl)
            pmNewestAgo = pmNewestAgoArr.get(lvl)
            pmSpanBars = pmOldestAgo >= 0 and pmNewestAgo < 100000 ? math.max(pmOldestAgo - pmNewestAgo, 0) : 0

            hasAnyPMTrace = pmReact > 0 or pmScore > 0 or pmCloses > 0 or pmPivots > 0
            if hasAnyPMTrace
                pmRawCandidateBins += 1

            closeDensityOk = pmCloses >= v221_pmCloseDensityMin and pmSpanBars >= effPmMinSpanBars()
            pivotReactionOk = pmPivots >= v221_pmPivotMinReactions and pmSpanBars >= effPmMinSpanBars()
            generalReactionOk = pmReact >= v291EffectivePmMinReactions and pmScore >= v221_pmMinScore and pmNorm >= v221_pmMinNorm and pmSpanBars >= effPmMinSpanBars()
            independentPmOk = generalReactionOk or closeDensityOk or pivotReactionOk

            if independentPmOk
                rawV = volumeDataArray.totalVolume.get(lvl)
                rawNorm = rawMaxNode > 0 ? rawV / rawMaxNode : 0.0
                chipV = chipTotal.get(lvl)
                chipNorm = chipMaxNode > 0 ? chipV / chipMaxNode : 0.0
                bool thinReactive = rawNorm <= v221_pmThinRawThreshold and pmReact >= v291EffectivePmMinReactions
                pmWeightBase = math.max(pmNorm, closeDensityOk ? math.min(1.0, pmCloses / math.max(v221_pmCloseDensityMin * 2.0, 1.0)) : 0.0)
                pmWeightBase := math.max(pmWeightBase, pivotReactionOk ? math.min(1.0, pmPivots / math.max(v221_pmPivotMinReactions * 2.0, 1.0)) : 0.0)

                array.push(candLvl, lvl)
                array.push(candWt, math.max(pmWeightBase, 0.10))
                array.push(candDelta, 0.0)
                array.push(candKind, thinReactive ? -2 : 2)
                array.push(candSrc, thinReactive ? 6 : 5)
                pmAcceptedCandidateBins += 1

            else if hasAnyPMTrace
                if pmReact < v291EffectivePmMinReactions and pmCloses < v221_pmCloseDensityMin and pmPivots < v221_pmPivotMinReactions
                    pmRejectedFewReactions += 1
                else if pmSpanBars < effPmMinSpanBars()
                    pmRejectedShortSpan += 1
                else
                    pmRejectedLowScore += 1

    //==================================================================================================
    // V2.3 STRUCTURAL MEMORY FALLBACK
    // Independent swing-structure layer. This catches clean range edges / repeated pivots where
    // VP/Chip/PM bins are too sparse or too volume-dependent. It is not a signal. It marks memory.
    //==================================================================================================
    msScoreArr := array.new<float>(v294EffectiveProfileRows, 0.0)
    msHighArr := array.new<int>(v294EffectiveProfileRows, 0)
    msLowArr := array.new<int>(v294EffectiveProfileRows, 0)
    msTouchArr := array.new<int>(v294EffectiveProfileRows, 0)
    msOldestAgoArr := array.new<int>(v294EffectiveProfileRows, -1)
    msNewestAgoArr := array.new<int>(v294EffectiveProfileRows, 100000)

    msRawCandidateBins := 0
    msAcceptedCandidateBins := 0
    msRejectedFewTouches := 0
    msRejectedShortSpan := 0
    msRejectedLowScore := 0

    msLookbackRaw = int(math.round(effStructureLookbackDays() * barsPerDay))
    msLookbackLen = math.min(vp_profileLength, math.max(1, msLookbackRaw))

    if v23_useStructureMemory
        msLeftEff = math.max(1, v23_msPivotLeft)
        msRightEff = math.max(1, v23_msPivotRight)
        for mk = msLookbackLen to 0
            localAtr = atr[mk]
            canEvalStructPivot = not na(localAtr) and localAtr > 0 and mk >= msRightEff and mk + msLeftEff <= msLookbackLen
            if canEvalStructPivot
                bool msPivotHigh = true
                bool msPivotLow = true

                for mp = 1 to msLeftEff
                    if high[mk] <= high[mk + mp]
                        msPivotHigh := false
                    if low[mk] >= low[mk + mp]
                        msPivotLow := false

                for mp = 1 to msRightEff
                    if high[mk] < high[mk - mp]
                        msPivotHigh := false
                    if low[mk] > low[mk - mp]
                        msPivotLow := false

                msBand = math.max(priceStep, localAtr * effStructureClusterAtr())
                msRecW = math.pow(v23_msDecay, mk)

                if msPivotHigh
                    int msStart = math.max(int(math.floor((high[mk] - msBand - lowestPrice) / priceStep)), 0)
                    int msEnd   = math.min(int(math.floor((high[mk] + msBand - lowestPrice) / priceStep)), v294EffectiveProfileRows - 1)
                    for ml = msStart to msEnd
                        msHighArr.set(ml, msHighArr.get(ml) + 1)
                        msTouchArr.set(ml, msTouchArr.get(ml) + 1)
                        msScoreArr.set(ml, msScoreArr.get(ml) + v23_msPivotWeight * msRecW)
                        msOldestAgoArr.set(ml, math.max(msOldestAgoArr.get(ml), mk))
                        msNewestAgoArr.set(ml, math.min(msNewestAgoArr.get(ml), mk))

                if msPivotLow
                    int msStart = math.max(int(math.floor((low[mk] - msBand - lowestPrice) / priceStep)), 0)
                    int msEnd   = math.min(int(math.floor((low[mk] + msBand - lowestPrice) / priceStep)), v294EffectiveProfileRows - 1)
                    for ml = msStart to msEnd
                        msLowArr.set(ml, msLowArr.get(ml) + 1)
                        msTouchArr.set(ml, msTouchArr.get(ml) + 1)
                        msScoreArr.set(ml, msScoreArr.get(ml) + v23_msPivotWeight * msRecW)
                        msOldestAgoArr.set(ml, math.max(msOldestAgoArr.get(ml), mk))
                        msNewestAgoArr.set(ml, math.min(msNewestAgoArr.get(ml), mk))

        // Bonus for levels that have both high-pivot and low-pivot memory. These are often range boundaries
        // that changed role over time, not one-off swing points.
        for ml = 0 to v294EffectiveProfileRows - 1
            if msHighArr.get(ml) > 0 and msLowArr.get(ml) > 0
                msScoreArr.set(ml, msScoreArr.get(ml) + v23_msMixedSideBonus)

    msMaxScore := msScoreArr.max()

    if v23_useStructureMemory and msMaxScore > 0
        for lvl = 0 to v294EffectiveProfileRows - 1
            msScore = msScoreArr.get(lvl)
            msNorm = msScore / msMaxScore
            msTouches = msTouchArr.get(lvl)
            msHighs = msHighArr.get(lvl)
            msLows = msLowArr.get(lvl)
            msOldestAgo = msOldestAgoArr.get(lvl)
            msNewestAgo = msNewestAgoArr.get(lvl)
            msSpanBars = msOldestAgo >= 0 and msNewestAgo < 100000 ? math.max(msOldestAgo - msNewestAgo, 0) : 0
            hasAnyStructTrace = msTouches > 0 or msScore > 0
            if hasAnyStructTrace
                msRawCandidateBins += 1

            structOk = msTouches >= v23_msMinTouches and msSpanBars >= effStructureMinSpanBars() and msScore >= v23_msMinScore and msNorm >= v23_msMinNorm
            if structOk
                msBias = msTouches > 0 ? (msLows - msHighs) / msTouches : 0.0
                msWeight = math.max(msNorm, 0.10)
                array.push(candLvl, lvl)
                array.push(candWt, msWeight)
                array.push(candDelta, msBias)
                array.push(candKind, 3)
                array.push(candSrc, 7)
                msAcceptedCandidateBins += 1
            else if hasAnyStructTrace
                if msTouches < v23_msMinTouches
                    msRejectedFewTouches += 1
                else if msSpanBars < effStructureMinSpanBars()
                    msRejectedShortSpan += 1
                else
                    msRejectedLowScore += 1

// Split: merging/scoring/drawing zones starts here. Keeps compiler if-block size low.
if buildNow
    //==================================================================================================
    // V2.5.4 STATE + GUARD RESOLVER
    // These guards are semantic protections, not signals. v2.5.2 decouples them from the active VP
    // window so a short profile cannot hide long-range bracket/broken-recovery structure.
    //==================================================================================================
    v251BracketGuardActive := false
    v251BrokenRecoveryActive := false
    v251BracketCandidateForced := false
    v251BrokenCandidateForced := false
    v252BracketUpperOnly := false
    v252BrokenIncompleteOverhead := false
    v251BracketUpperPrice := na
    v251BracketLowerPrice := na
    v251BrokenOverheadPrice := na
    v251BracketRangeAtr := na
    v251BrokenDrawdownPctNow := na
    v251BrokenDrawdownAtrNow := na
    v251BracketUpperLvl := -1
    v251BracketLowerLvl := -1
    v251BrokenOverheadLvl := -1
    v251BracketUpperPivots := 0
    v251BracketLowerPivots := 0
    v252BrokenOverheadPivots := 0
    v256UpperMemoryGate := false
    v256BrokenTestGate := false
    v256AirRoomGate := false
    v256AirTestGate := false
    v256UpperMemoryPrice := na
    v256UpperMemoryAtr := 100000.0
    v256UpperMemoryHits := 0
    v256UpperMemorySource := "none"

    guardMaxBars = math.min(bar_index, 4990)

    // Bracket Guard: a large-cap range is a price-structure object first, not a VP object.
    // v2.5.2 scans direct pivot highs/lows across the guard lookback and only then maps the best
    // candidate back into VP rows when the row exists. This prevents V-style one-sided OPEN-UP maps.
    bracketLookbackRaw = int(math.round(effBracketLookbackDays() * barsPerDay))
    bracketLookbackBase = v252_decoupleGuardLookback ? guardMaxBars : vp_profileLength
    bracketLookbackLen = int(math.min(bracketLookbackBase, math.max(2, bracketLookbackRaw)))
    float bracketHigh = na
    float bracketLow = na
    for bg = 1 to bracketLookbackLen
        bracketHigh := na(bracketHigh) ? high[bg] : math.max(bracketHigh, high[bg])
        bracketLow := na(bracketLow) ? low[bg] : math.min(bracketLow, low[bg])

    if v251_useBracketGuard and not na(bracketHigh) and not na(bracketLow) and atr > 0 and priceStep > 0 and bracketHigh > bracketLow
        v251BracketRangeAtr := (bracketHigh - bracketLow) / atr
        bracketPos = (close - bracketLow) / (bracketHigh - bracketLow)
        insideBracket = bracketPos > 0.12 and bracketPos < v253_bracketMaxUpperPos and v251BracketRangeAtr >= effBracketMinRangeAtr()

        float bestUpperScore = -1.0
        float bestLowerScore = -1.0

        // Existing structural-memory rows remain useful, but they are no longer the only source.
        for lvl = 0 to v294EffectiveProfileRows - 1
            lvlPrice = lowestPrice + (lvl + 0.5) * priceStep
            lvlHighs = msHighArr.get(lvl)
            lvlLows = msLowArr.get(lvl)
            lvlTouches = msTouchArr.get(lvl)
            lvlMsScore = msScoreArr.get(lvl)
            lvlPmReact = pmReactArr.get(lvl)
            lvlRawNorm = rawMaxNode > 0 ? volumeDataArray.totalVolume.get(lvl) / rawMaxNode : 0.0

            dAbove = (lvlPrice - close) / atr
            dBelow = (close - lvlPrice) / atr

            upperCandidate = lvlPrice > close + atr * 0.10 and dAbove <= effBracketUpperSearchAtr() and lvlHighs >= v251_bracketUpperMinPivots
            lowerCandidate = lvlPrice < close - atr * 0.10 and dBelow <= effBracketUpperSearchAtr() and lvlLows >= v251_bracketLowerMinPivots

            upperScore = lvlHighs * 2.0 + lvlTouches * 0.75 + lvlPmReact * 0.40 + lvlMsScore + lvlRawNorm * 2.0
            lowerScore = lvlLows * 2.0 + lvlTouches * 0.75 + lvlPmReact * 0.40 + lvlMsScore + lvlRawNorm * 2.0

            if upperCandidate and upperScore > bestUpperScore
                bestUpperScore := upperScore
                v251BracketUpperLvl := lvl
                v251BracketUpperPrice := lvlPrice
                v251BracketUpperPivots := lvlHighs
            if lowerCandidate and lowerScore > bestLowerScore
                bestLowerScore := lowerScore
                v251BracketLowerLvl := lvl
                v251BracketLowerPrice := lvlPrice
                v251BracketLowerPivots := lvlLows

        // Independent direct-pivot pass. This is the v2.5.2 fix for missed V-style upper brackets.
        int[] bracketUpperCnt = array.new<int>(v294EffectiveProfileRows, 0)
        float[] bracketUpperScore = array.new<float>(v294EffectiveProfileRows, 0.0)
        int[] bracketLowerCnt = array.new<int>(v294EffectiveProfileRows, 0)
        float[] bracketLowerScore = array.new<float>(v294EffectiveProfileRows, 0.0)

        if bracketLookbackLen > 4
            for bgp = 2 to bracketLookbackLen - 2
                ph = high[bgp] >= high[bgp - 1] and high[bgp] > high[bgp + 1]
                pl = low[bgp] <= low[bgp - 1] and low[bgp] < low[bgp + 1]
                ageWeight = math.pow(0.997, bgp)

                if ph and high[bgp] > close + atr * 0.10 and (high[bgp] - close) / atr <= effBracketUpperSearchAtr()
                    rowH = int(math.floor((high[bgp] - lowestPrice) / priceStep))
                    if rowH >= 0 and rowH < v294EffectiveProfileRows
                        array.set(bracketUpperCnt, rowH, array.get(bracketUpperCnt, rowH) + 1)
                        array.set(bracketUpperScore, rowH, array.get(bracketUpperScore, rowH) + ageWeight)

                if pl and low[bgp] < close - atr * 0.10 and (close - low[bgp]) / atr <= effBracketUpperSearchAtr()
                    rowL = int(math.floor((low[bgp] - lowestPrice) / priceStep))
                    if rowL >= 0 and rowL < v294EffectiveProfileRows
                        array.set(bracketLowerCnt, rowL, array.get(bracketLowerCnt, rowL) + 1)
                        array.set(bracketLowerScore, rowL, array.get(bracketLowerScore, rowL) + ageWeight)

        for lvl = 0 to v294EffectiveProfileRows - 1
            directUpperCnt = array.get(bracketUpperCnt, lvl)
            directLowerCnt = array.get(bracketLowerCnt, lvl)
            lvlPrice = lowestPrice + (lvl + 0.5) * priceStep
            dAbove = (lvlPrice - close) / atr
            dBelow = (close - lvlPrice) / atr

            directUpperOk = directUpperCnt >= v252_bracketDirectMinPivots and lvlPrice > close + atr * 0.10 and dAbove <= effBracketUpperSearchAtr()
            directLowerOk = directLowerCnt >= v251_bracketLowerMinPivots and lvlPrice < close - atr * 0.10 and dBelow <= effBracketUpperSearchAtr()
            directUpperScore = array.get(bracketUpperScore, lvl) * 4.0 + directUpperCnt * 2.0 + msScoreArr.get(lvl) + pmReactArr.get(lvl) * 0.35
            directLowerScore = array.get(bracketLowerScore, lvl) * 4.0 + directLowerCnt * 2.0 + msScoreArr.get(lvl) + pmReactArr.get(lvl) * 0.35

            if directUpperOk and directUpperScore > bestUpperScore
                bestUpperScore := directUpperScore
                v251BracketUpperLvl := lvl
                v251BracketUpperPrice := lvlPrice
                v251BracketUpperPivots := directUpperCnt

            if directLowerOk and directLowerScore > bestLowerScore
                bestLowerScore := directLowerScore
                v251BracketLowerLvl := lvl
                v251BracketLowerPrice := lvlPrice
                v251BracketLowerPivots := directLowerCnt

        bracketHasTwoSides = v251BracketUpperLvl != -1 and v251BracketLowerLvl != -1
        v252BracketUpperOnly := insideBracket and v251BracketUpperLvl != -1 and v251BracketLowerLvl == -1 and v252_bracketAllowUpperOnly
        v251BracketGuardActive := insideBracket and bracketHasTwoSides and close > v251BracketLowerPrice and close < v251BracketUpperPrice and atr > 0 and (v251BracketUpperPrice - close) / atr <= effBracketUpperSearchAtr() and (close - v251BracketLowerPrice) / atr <= effBracketUpperSearchAtr()

        if v251BracketGuardActive and v251_bracketForceCandidate and v251BracketUpperLvl != -1
            array.push(candLvl, v251BracketUpperLvl)
            array.push(candWt, math.min(1.0, math.max(0.25, bestUpperScore / 12.0)))
            array.push(candDelta, -0.30)
            array.push(candKind, 3)
            array.push(candSrc, 7)
            v251BracketCandidateForced := true

    // Broken-Recovery Guard: a violent drawdown/recovery is evaluated over the full guard lookback.
    // v2.5.2 blocks clean OPEN-UP even when the active VP window has too little overhead evidence.
    brokenLookbackRaw = int(math.round(effBrokenLookbackDays() * barsPerDay))
    brokenLookbackBase = v252_decoupleGuardLookback ? guardMaxBars : vp_profileLength
    brokenLookbackLen = int(math.min(brokenLookbackBase, math.max(2, brokenLookbackRaw)))
    float brokenHigh = na
    float brokenLow = na
    for br = 1 to brokenLookbackLen
        brokenHigh := na(brokenHigh) ? high[br] : math.max(brokenHigh, high[br])
        brokenLow := na(brokenLow) ? low[br] : math.min(brokenLow, low[br])

    if v251_useBrokenRecoveryGuard and not na(brokenHigh) and not na(brokenLow) and brokenHigh > 0 and brokenLow > 0 and atr > 0 and priceStep > 0
        v251BrokenDrawdownPctNow := (brokenHigh - brokenLow) / brokenHigh * 100.0
        v251BrokenDrawdownAtrNow := (brokenHigh - brokenLow) / atr
        recoveryOffLowPct = (close - brokenLow) / brokenLow * 100.0
        belowPriorSupply = close < brokenHigh - atr * 1.0
        shockContext = abnormalStructure or abnormalShockBars > 0 or abnormalGapBars > 0
        brokenPctOk = v251BrokenDrawdownPctNow >= effBrokenDrawdownPct()
        brokenAtrOk = v251BrokenDrawdownAtrNow >= effBrokenDrawdownAtr()
        brokenDamageOk = v253_brokenRequirePctAndAtr ? (brokenPctOk and brokenAtrOk) : (brokenPctOk or brokenAtrOk or shockContext)
        brokenDamageOk := brokenDamageOk or (shockContext and v251BrokenDrawdownPctNow >= 24.0 and v251BrokenDrawdownAtrNow >= effBrokenDrawdownAtr() * 0.70)
        v251BrokenRecoveryActive := belowPriorSupply and recoveryOffLowPct >= v251_brokenRecoverOffLowPct and brokenDamageOk

        float bestBrokenScore = -1.0
        if v251BrokenRecoveryActive
            for lvl = 0 to v294EffectiveProfileRows - 1
                lvlPrice = lowestPrice + (lvl + 0.5) * priceStep
                dAbove = (lvlPrice - close) / atr
                if lvlPrice > close + atr * 0.10 and dAbove <= effBrokenOverheadSearchAtr()
                    lvlHighs = msHighArr.get(lvl)
                    lvlTouches = msTouchArr.get(lvl)
                    lvlMsScore = msScoreArr.get(lvl)
                    lvlPmReact = pmReactArr.get(lvl)
                    lvlPmCloses = pmCloseArr.get(lvl)
                    lvlRawNorm = rawMaxNode > 0 ? volumeDataArray.totalVolume.get(lvl) / rawMaxNode : 0.0
                    lvlRecentNorm = recentMaxNode > 0 ? recentTotal.get(lvl) / recentMaxNode : 0.0
                    overheadScore = lvlHighs * 2.0 + lvlTouches * 0.85 + lvlMsScore + lvlPmReact * 0.55 + lvlPmCloses * 0.25 + lvlRawNorm * 2.0 + lvlRecentNorm
                    if overheadScore > bestBrokenScore
                        bestBrokenScore := overheadScore
                        v251BrokenOverheadLvl := lvl
                        v251BrokenOverheadPrice := lvlPrice
                        v252BrokenOverheadPivots := lvlHighs

            // Independent direct-pivot overhead pass. This fixes UNH-style broken recoveries where
            // the active VP/chip rows are sparse or too recent to preserve prior overhead memory.
            int[] brokenUpperCnt = array.new<int>(v294EffectiveProfileRows, 0)
            float[] brokenUpperScore = array.new<float>(v294EffectiveProfileRows, 0.0)
            float bestBrokenDirectPrice = na
            float bestBrokenDirectScore = -1.0

            if brokenLookbackLen > 4
                for brp = 2 to brokenLookbackLen - 2
                    ph = high[brp] >= high[brp - 1] and high[brp] > high[brp + 1]
                    if ph and high[brp] > close + atr * 0.10 and (high[brp] - close) / atr <= effBrokenOverheadSearchAtr()
                        ageWeight = math.pow(0.997, brp)
                        if ageWeight > bestBrokenDirectScore
                            bestBrokenDirectScore := ageWeight
                            bestBrokenDirectPrice := high[brp]
                        rowH = int(math.floor((high[brp] - lowestPrice) / priceStep))
                        if rowH >= 0 and rowH < v294EffectiveProfileRows
                            array.set(brokenUpperCnt, rowH, array.get(brokenUpperCnt, rowH) + 1)
                            array.set(brokenUpperScore, rowH, array.get(brokenUpperScore, rowH) + ageWeight)

            for lvl = 0 to v294EffectiveProfileRows - 1
                directCnt = array.get(brokenUpperCnt, lvl)
                lvlPrice = lowestPrice + (lvl + 0.5) * priceStep
                dAbove = (lvlPrice - close) / atr
                directOk = directCnt >= v252_brokenDirectMinPivots and lvlPrice > close + atr * 0.10 and dAbove <= effBrokenOverheadSearchAtr()
                directScore = array.get(brokenUpperScore, lvl) * 4.0 + directCnt * 2.0 + msScoreArr.get(lvl) + pmReactArr.get(lvl) * 0.35
                if directOk and directScore > bestBrokenScore
                    bestBrokenScore := directScore
                    v251BrokenOverheadLvl := lvl
                    v251BrokenOverheadPrice := lvlPrice
                    v252BrokenOverheadPivots := directCnt

            if na(v251BrokenOverheadPrice) and not na(bestBrokenDirectPrice)
                v251BrokenOverheadPrice := bestBrokenDirectPrice
                v252BrokenOverheadPivots := math.max(v252BrokenOverheadPivots, 1)

            v252BrokenIncompleteOverhead := v251BrokenRecoveryActive and v251BrokenOverheadLvl == -1 and na(v251BrokenOverheadPrice)

            if v251_brokenForceCandidate and v251BrokenOverheadLvl != -1 and bestBrokenScore > 0
                array.push(candLvl, v251BrokenOverheadLvl)
                array.push(candWt, math.min(1.0, math.max(0.25, bestBrokenScore / 14.0)))
                array.push(candDelta, -0.40)
                array.push(candKind, 3)
                array.push(candSrc, 7)
                v251BrokenCandidateForced := true

    // v2.5.6 Upper-Memory Fallback: if no formal resistance survives, the state layer still remembers
    // nearby prior swing highs. This prevents false OPEN-UP near an unresolved upper test.
    swingLookbackRaw = int(math.round(effBracketLookbackDays() * barsPerDay))
    swingLookbackLen = int(math.min(guardMaxBars, math.max(2, swingLookbackRaw)))
    [swingMemPrice, swingMemAtr, swingMemHits] = v256NearestUpperMemory(swingLookbackLen, atr, v256SwingMemoryMaxAtr())
    if not na(swingMemPrice)
        v256UpperMemoryPrice := swingMemPrice
        v256UpperMemoryAtr := swingMemAtr
        v256UpperMemoryHits := swingMemHits
        v256UpperMemorySource := "SWING-H"
        v256UpperMemoryGate := true

    if v251BracketGuardActive and not na(v251BracketUpperPrice) and atr > 0
        tmpAtr = math.abs(v251BracketUpperPrice - close) / atr
        if tmpAtr <= v256SwingMemoryMaxAtr() and tmpAtr < v256UpperMemoryAtr
            v256UpperMemoryPrice := v251BracketUpperPrice
            v256UpperMemoryAtr := tmpAtr
            v256UpperMemorySource := "BRACKET"
            v256UpperMemoryGate := true

    if v251BrokenRecoveryActive and not na(v251BrokenOverheadPrice) and atr > 0
        tmpAtr = math.abs(v251BrokenOverheadPrice - close) / atr
        if tmpAtr <= v256SwingMemoryMaxAtr() and tmpAtr < v256UpperMemoryAtr
            v256UpperMemoryPrice := v251BrokenOverheadPrice
            v256UpperMemoryAtr := tmpAtr
            v256UpperMemorySource := "BROKEN-OH"
            v256UpperMemoryGate := true

    v256BrokenTestGate := v256BrokenTestOk(v256UpperMemoryGate, v251BrokenRecoveryActive, v251BrokenDrawdownPctNow, v251BrokenDrawdownAtrNow)

// Split again after v2.5.2 guards to avoid TradingView CE10205 on the build block.
if buildNow
    //==================================================================================================
    // V2.5 DEV MEMORY BANDS
    // Recent acceptance after fast repricing can be real before it becomes a mature full-profile HVN.
    // DEV zones are lower-authority, limited to the current battle area, and shown as forming memory.
    //==================================================================================================
    devScoreArr := array.new<float>(v294EffectiveProfileRows, 0.0)
    devRawCandidateBins := 0
    devAcceptedCandidateBins := 0
    devLookbackRaw = int(math.round(effDevLookbackDays() * barsPerDay))
    devLookbackLen = math.min(vp_profileLength, math.max(1, devLookbackRaw))
    devMaxScore := 0.0

    if v25_useDevMemory and recentMaxNode > 0 and atr > 0
        for lvl = 0 to v294EffectiveProfileRows - 1
            devPrice = lowestPrice + (lvl + 0.5) * priceStep
            recentNormDev = recentTotal.get(lvl) / recentMaxNode
            rawNormDev = rawMaxNode > 0 ? volumeDataArray.totalVolume.get(lvl) / rawMaxNode : 0.0
            dAtrDev = math.abs(devPrice - close) / atr
            immatureDev = rawNormDev <= v25_devImmatureRawMax
            nearDev = dAtrDev <= effDevMaxDistanceAtr()
            recentDevOk = recentNormDev >= v25_devRecentNodeThreshold
            scoreDev = recentNormDev * math.max(0.0, 1.0 - dAtrDev / math.max(effDevMaxDistanceAtr(), 0.25))
            if recentDevOk and nearDev
                devRawCandidateBins += 1
            if recentDevOk and nearDev and immatureDev
                devScoreArr.set(lvl, scoreDev)
                devMaxScore := math.max(devMaxScore, scoreDev)

        for lvl = 0 to v294EffectiveProfileRows - 1
            scoreDev = devScoreArr.get(lvl)
            if scoreDev > 0 and devMaxScore > 0
                rawV = volumeDataArray.totalVolume.get(lvl)
                rawBull = volumeDataArray.bullishVolume.get(lvl)
                rawBear = math.max(rawV - rawBull, 0.0)
                deltaDev = rawV > 0 ? (rawBull - rawBear) / rawV : 0.0
                array.push(candLvl, lvl)
                array.push(candWt, math.max(scoreDev / devMaxScore, 0.10))
                array.push(candDelta, deltaDev)
                array.push(candKind, 4)
                array.push(candSrc, 8)
                devAcceptedCandidateBins += 1

    //==================================================================================================
    // BUILD ZONES: levels -> price zones, then merge nearby zones
    //==================================================================================================
    candN := array.size(candLvl)

    zCenter := array.new<float>(0)
    zBot := array.new<float>(0)
    zTop := array.new<float>(0)
    zWt := array.new<float>(0)
    zDelta := array.new<float>(0)
    zKind := array.new<int>(0)
    zSrc := array.new<int>(0)

    halfW = math.max(priceStep * 1.0, atr * effZoneHalfWidthAtrFrac())

    if candN > 0
        int[] idx = array.new<int>(candN, 0)
        for i = 0 to candN - 1
            array.set(idx, i, i)

        if candN > 1
            for i = 0 to candN - 2
                best = i
                bestP = lowestPrice + (array.get(candLvl, array.get(idx, i)) + 0.5) * priceStep
                for j = i + 1 to candN - 1
                    pj = lowestPrice + (array.get(candLvl, array.get(idx, j)) + 0.5) * priceStep
                    if pj < bestP
                        bestP := pj
                        best := j
                tmp = array.get(idx, i)
                array.set(idx, i, array.get(idx, best))
                array.set(idx, best, tmp)

        mergeDist = atr * effMergeAtrFrac()

        for t = 0 to candN - 1
            ii  = array.get(idx, t)
            lvl = array.get(candLvl, ii)

            c   = lowestPrice + (lvl + 0.5) * priceStep
            bot = c - halfW
            top = c + halfW
            wt  = array.get(candWt, ii)
            dp  = array.get(candDelta, ii)
            kd  = array.get(candKind, ii)
            sc  = array.get(candSrc, ii)

            if array.size(zCenter) == 0
                array.push(zCenter, c), array.push(zBot, bot), array.push(zTop, top), array.push(zWt, wt), array.push(zDelta, dp), array.push(zKind, kd), array.push(zSrc, sc)
            else
                last = array.size(zCenter) - 1
                lastC = array.get(zCenter, last)

                if math.abs(c - lastC) <= mergeDist
                    lastBot = array.get(zBot, last)
                    lastTop = array.get(zTop, last)
                    lastWt  = array.get(zWt, last)
                    lastDp  = array.get(zDelta, last)
                    lastKd  = array.get(zKind, last)
                    lastSc  = array.get(zSrc, last)

                    newWt = lastWt + wt
                    newC  = newWt > 0 ? (lastC * lastWt + c * wt) / newWt : lastC
                    newDp = newWt > 0 ? (lastDp * lastWt + dp * wt) / newWt : lastDp
                    // P2B merge hierarchy:
                    // 1) Never let PM downgrade a true HVN/confluence zone.
                    // 2) LVN + PM becomes AIR+PM because thin areas with repeated reaction are not empty air.
                    // 3) Otherwise keep the stronger contributor's semantic type.
                    newKd = lastKd == kd ? lastKd : (lastKd == 1 or kd == 1 ? 1 : lastKd == 3 or kd == 3 ? 3 : (lastKd == -1 and kd == 2) or (lastKd == 2 and kd == -1) or lastKd == -2 or kd == -2 ? -2 : lastKd == 2 or kd == 2 ? 2 : lastKd == 4 or kd == 4 ? 4 : (lastWt >= wt ? lastKd : kd))
                    newSc = lastWt >= wt ? lastSc : sc
                    // Preserve highest-confidence source if any merged contributor has VP+Chip confluence.
                    if lastSc == 3 or sc == 3
                        newSc := 3
                    else if newKd == 1 and (lastSc == 1 or sc == 1)
                        newSc := 1
                    else if newKd == 1 and (lastSc == 2 or sc == 2)
                        newSc := 2
                    else if newKd == -2
                        newSc := 6
                    else if newKd == 2
                        newSc := 5
                    else if newKd == 3
                        newSc := 7
                    else if newKd == 4
                        newSc := 8

                    array.set(zCenter, last, newC)
                    array.set(zBot, last, math.min(lastBot, bot))
                    array.set(zTop, last, math.max(lastTop, top))
                    array.set(zWt, last, newWt)
                    array.set(zDelta, last, newDp)
                    array.set(zKind, last, newKd)
                    array.set(zSrc, last, newSc)
                else
                    array.push(zCenter, c), array.push(zBot, bot), array.push(zTop, top), array.push(zWt, wt), array.push(zDelta, dp), array.push(zKind, kd), array.push(zSrc, sc)

    //==================================================================================================
    // SCORE + LIFECYCLE STATES
    //==================================================================================================
    zN := array.size(zCenter)
    zHistScore := array.new<float>(zN, 0.0)
    zRelScore := array.new<float>(zN, 0.0)
    zState := array.new<int>(zN, 0)
    zTouches := array.new<int>(zN, 0)
    zRejects := array.new<int>(zN, 0)
    zLastTouch := array.new<int>(zN, 100000)
    zLastCross := array.new<int>(zN, 100000)
    zCrossDir := array.new<int>(zN, 0)
    zDistAtr := array.new<float>(zN, 100000.0)
    zDistPct := array.new<float>(zN, 100000.0)
    zPmScore := array.new<float>(zN, 0.0)
    zPmReact := array.new<int>(zN, 0)
    zPmCloses := array.new<int>(zN, 0)
    zPmWicks := array.new<int>(zN, 0)
    zPmFails := array.new<int>(zN, 0)
    zPmPivots := array.new<int>(zN, 0)
    zMsScore := array.new<float>(zN, 0.0)
    zDevScore := array.new<float>(zN, 0.0)
    zMsTouches := array.new<int>(zN, 0)
    zMsHighs := array.new<int>(zN, 0)
    zMsLows := array.new<int>(zN, 0)

    if zN > 0
        zWtMax = zWt.max()

        for zi = 0 to zN - 1
            c   = array.get(zCenter, zi)
            bot = array.get(zBot, zi)
            top = array.get(zTop, zi)
            kd  = array.get(zKind, zi)

            // PM stats inside this zone. Use max bin values to avoid double-counting wide merged zones.
            pmZoneScore = 0.0
            pmZoneReact = 0
            pmZoneCloses = 0
            pmZoneWicks = 0
            pmZoneFails = 0
            pmZonePivots = 0
            pmStartLvl = math.max(0, int(math.floor((bot - lowestPrice) / priceStep)))
            pmEndLvl = math.min(v294EffectiveProfileRows - 1, int(math.floor((top - lowestPrice) / priceStep)))
            if v221_usePriceMemory and pmStartLvl <= pmEndLvl
                for pmLvl = pmStartLvl to pmEndLvl
                    pmZoneScore := math.max(pmZoneScore, pmScoreArr.get(pmLvl))
                    pmZoneReact := math.max(pmZoneReact, pmReactArr.get(pmLvl))
                    pmZoneCloses := math.max(pmZoneCloses, pmCloseArr.get(pmLvl))
                    pmZoneWicks := math.max(pmZoneWicks, pmWickArr.get(pmLvl))
                    pmZoneFails := math.max(pmZoneFails, pmFailArr.get(pmLvl))
                    pmZonePivots := math.max(pmZonePivots, pmPivotArr.get(pmLvl))

            hasPriceMemory = v221_usePriceMemory and pmZoneReact >= v291EffectivePmMinReactions and pmZoneScore >= v221_pmMinScore
            msZoneScore = 0.0
            msZoneTouches = 0
            msZoneHighs = 0
            msZoneLows = 0
            msStartLvl = math.max(0, int(math.floor((bot - lowestPrice) / priceStep)))
            msEndLvl = math.min(v294EffectiveProfileRows - 1, int(math.floor((top - lowestPrice) / priceStep)))
            if v23_useStructureMemory and msStartLvl <= msEndLvl
                for msLvl = msStartLvl to msEndLvl
                    msZoneScore := math.max(msZoneScore, msScoreArr.get(msLvl))
                    msZoneTouches := math.max(msZoneTouches, msTouchArr.get(msLvl))
                    msZoneHighs := math.max(msZoneHighs, msHighArr.get(msLvl))
                    msZoneLows := math.max(msZoneLows, msLowArr.get(msLvl))

            hasStructuralMemory = v23_useStructureMemory and msZoneTouches >= v23_msMinTouches and msZoneScore >= v23_msMinScore

            devZoneScore = 0.0
            if v25_useDevMemory and msStartLvl <= msEndLvl
                for devLvl = msStartLvl to msEndLvl
                    devZoneScore := math.max(devZoneScore, devScoreArr.get(devLvl))

            if kd == -1 and hasPriceMemory
                kd := -2
                array.set(zKind, zi, kd)
                array.set(zSrc, zi, 6)

            score = 0.0
            touchCnt = 0
            rejectCnt = 0
            lastTouchAgo = 100000
            lastCrossAgo = 100000
            lastCrossDir = 0
            consecAbove = 0
            consecBelow = 0
            confirmedSide = 0

            for k = vp_profileLength to 0
                hi = high[k]
                lo = low[k]
                cl = close[k]
                ak = atr[k]
                buf = ak * sr_breakAtrFrac

                touch = (lo <= top) and (hi >= bot)

                if touch
                    touchCnt += 1
                    lastTouchAgo := k
                    score += sr_touchPts

                    // Rejection means the bar interacted with the zone but closed away from it.
                    rejectedUp = lo <= top and cl > top
                    rejectedDn = hi >= bot and cl < bot
                    if rejectedUp or rejectedDn
                        rejectCnt += 1
                        score += sr_rejectPts

                above = cl > top + buf
                below = cl < bot - buf

                if above
                    consecAbove += 1
                    consecBelow := 0
                    if consecAbove >= sr_breakConsec and confirmedSide != 1
                        lastCrossAgo := k
                        lastCrossDir := 1
                        confirmedSide := 1
                        score -= sr_breakPts
                else if below
                    consecBelow += 1
                    consecAbove := 0
                    if consecBelow >= sr_breakConsec and confirmedSide != -1
                        lastCrossAgo := k
                        lastCrossDir := -1
                        confirmedSide := -1
                        score -= sr_breakPts
                else
                    consecAbove := 0
                    consecBelow := 0

                score *= effScoreDecay()

            currentDistance = close > top ? (close - top) : close < bot ? (bot - close) : 0.0
            dAtr = atr > 0 ? currentDistance / atr : 100000.0
            dPct = close != 0 ? math.abs(currentDistance / close) * 100.0 : 100000.0

            nodeNorm = zWtMax > 0 ? array.get(zWt, zi) / zWtMax : 0.0
            nodeScore = nodeNorm * 8.0
            recencyScore = lastTouchAgo <= effRecentTouchBars() ? 6.0 * (1.0 - lastTouchAgo / math.max(effRecentTouchBars(), 1)) : 0.0
            distanceScore = math.max(0.0, 1.0 - dAtr / math.max(v296TradeAtr, 0.25)) * 6.0
            stalePenalty = lastTouchAgo > effStaleTouchBars() ? 8.0 : 0.0
            srcType = array.get(zSrc, zi)
            isMemoryZone = kd == 1 or kd == 2 or kd == 3 or kd == 4 or kd == -2
            lvnPenalty = kd == -1 ? 1.0 : 0.0
            airPmPenalty = kd == -2 ? 0.35 : 0.0
            chipOnlyPenalty = kd == 1 and srcType == 2 and not hasSharesOut ? 2.0 : 0.0
            vpOnlyPenalty = kd == 1 and srcType == 1 ? 0.5 : 0.0
            confluenceBonus = kd == 1 and srcType == 3 ? 2.0 : 0.0
            pmBonus = hasPriceMemory ? (pmMaxScore > 0 ? (pmZoneScore / pmMaxScore) * v221_pmScoreBonus : 0.0) : 0.0
            structBonus = hasStructuralMemory ? (msMaxScore > 0 ? (msZoneScore / msMaxScore) * v23_msScoreBonus : 0.0) : 0.0
            devBonus = kd == 4 and devMaxScore > 0 ? (devZoneScore / devMaxScore) * v25_devScoreBonus : 0.0
            bracketGuardBonus = v251BracketGuardActive and not na(v251BracketUpperPrice) and c >= v251BracketUpperPrice - halfW and c <= v251BracketUpperPrice + halfW ? v251_bracketScoreBonus : 0.0
            brokenGuardBonus = v251BrokenRecoveryActive and not na(v251BrokenOverheadPrice) and c >= v251BrokenOverheadPrice - halfW and c <= v251BrokenOverheadPrice + halfW ? v251_brokenScoreBonus : 0.0

            // v2.2: recent-value alignment bonus. A zone that overlaps or sits close to recent POC/current value
            // is more relevant than an old historical node of equal size.
            recentPocAligned = isMemoryZone and not na(recentPocPrice) and recentPocPrice >= bot and recentPocPrice <= top
            recentPocNear = isMemoryZone and not na(recentPocPrice) and math.abs(c - recentPocPrice) <= math.max(halfW, atr * effValueMigrationThreshold())
            recentLvl = int(math.floor((c - lowestPrice) / priceStep))
            recentLvl := math.max(0, math.min(v294EffectiveProfileRows - 1, recentLvl))
            recentNodeNorm = recentMaxNode > 0 ? recentTotal.get(recentLvl) / recentMaxNode : 0.0
            recentValueBonus = (recentPocAligned ? v22_recentPocZoneBonus : recentPocNear ? v22_recentPocZoneBonus * 0.50 : 0.0) + (isMemoryZone and recentNodeNorm >= v22_recentNodeThreshold ? recentNodeNorm : 0.0)

            histScore = score + nodeScore + confluenceBonus + pmBonus + structBonus + devBonus + bracketGuardBonus + brokenGuardBonus - chipOnlyPenalty - vpOnlyPenalty
            relScore = histScore + recencyScore + distanceScore + recentValueBonus - stalePenalty - lvnPenalty - airPmPenalty

            currentState = 0
            isInside = close <= top and close >= bot
            recentCross = lastCrossAgo <= effRecentFlipBars()

            if isInside
                currentState := 1
            else if close > top and recentCross and lastCrossDir == 1
                currentState := 2
            else if close < bot and recentCross and lastCrossDir == -1
                currentState := 3
            else if lastTouchAgo <= effRecentTouchBars()
                currentState := 4
            else if dAtr <= v296TradeAtr
                currentState := 5
            else
                currentState := 6

            array.set(zHistScore, zi, histScore)
            array.set(zRelScore, zi, relScore)
            array.set(zState, zi, currentState)
            array.set(zTouches, zi, touchCnt)
            array.set(zRejects, zi, rejectCnt)
            array.set(zLastTouch, zi, lastTouchAgo)
            array.set(zLastCross, zi, lastCrossAgo)
            array.set(zCrossDir, zi, lastCrossDir)
            array.set(zDistAtr, zi, dAtr)
            array.set(zDistPct, zi, dPct)
            array.set(zPmScore, zi, pmZoneScore)
            array.set(zPmReact, zi, pmZoneReact)
            array.set(zPmCloses, zi, pmZoneCloses)
            array.set(zPmWicks, zi, pmZoneWicks)
            array.set(zPmFails, zi, pmZoneFails)
            array.set(zPmPivots, zi, pmZonePivots)
            array.set(zMsScore, zi, msZoneScore)
            array.set(zDevScore, zi, devZoneScore)
            array.set(zMsTouches, zi, msZoneTouches)
            array.set(zMsHighs, zi, msZoneHighs)
            array.set(zMsLows, zi, msZoneLows)

    //==================================================================================================
    // V2.1.1 ABNORMAL-STRUCTURE GUARD
    // Detects spike/gap/low-price conditions that reduce trust in any horizontal memory map.
    //==================================================================================================
    abnormalShockBars := 0
    abnormalGapBars := 0
    abnormalMaxRangeAtr := 0.0
    abnormalMaxGapAtr := 0.0

    if v211_showAbnormalWarning
        for ak = vp_profileLength to 0
            localAtr = atr[ak]
            if not na(localAtr) and localAtr > 0
                rangeAtr = (high[ak] - low[ak]) / localAtr
                abnormalMaxRangeAtr := math.max(abnormalMaxRangeAtr, rangeAtr)
                if rangeAtr >= v293EffectiveShockRangeAtr
                    abnormalShockBars += 1
                if ak < vp_profileLength
                    gapAtr = math.abs(open[ak] - close[ak + 1]) / localAtr
                    abnormalMaxGapAtr := math.max(abnormalMaxGapAtr, gapAtr)
                    if gapAtr >= v211_gapAtr
                        abnormalGapBars += 1

    abnormalLowPrice := v211_lowPriceCaution > 0 and close <= v211_lowPriceCaution and abnormalMaxRangeAtr >= v293EffectiveShockRangeAtr * 0.75
    abnormalStructure := v211_showAbnormalWarning and (abnormalShockBars >= v211_maxShockBars or abnormalGapBars >= v211_maxGapBars or abnormalLowPrice)

    //==================================================================================================
    // PICK + DRAW ZONES - v2.0.1 Visual Discipline Patch
    // Current Battle Map is no longer just "top relevance".
    // It prioritizes: current inside zone, nearest HVN support, nearest HVN resistance,
    // nearest LVN/air pocket above, nearest LVN/air pocket below, then fills by relevance.
    //==================================================================================================
    v23DrawCount := 0

    if zN > 0
        int[] zIdx = array.new<int>(zN, 0)
        k = 0
        while k < zN
            array.set(zIdx, k, k)
            k += 1

        // Sort all zones by current relevance for fallback/fill behavior.
        if zN > 1
            i = 0
            while i < zN - 1
                best = i
                bestZi = array.get(zIdx, i)
                bestScore = array.get(zRelScore, bestZi)

                j = i + 1
                while j < zN
                    ziJ = array.get(zIdx, j)
                    sc = array.get(zRelScore, ziJ)
                    if sc > bestScore
                        bestScore := sc
                        best := j
                    j += 1

                tmp = array.get(zIdx, i)
                array.set(zIdx, i, array.get(zIdx, best))
                array.set(zIdx, best, tmp)
                i += 1

        int[] drawList = array.new<int>(0)
        maxDraw = vis_displayMode == "Current Battle Map" ? vis_currentMaxZones : effTopNZones()
        maxDraw := vis_memoryRailMode ? math.min(v27_railMaxZones, 3) : maxDraw

        if vis_displayMode == "Current Battle Map"
            int bestInside = -1
            float bestInsideScore = -1000000000.0

            int bestHvnSupport = -1
            float bestHvnSupportDist = 1000000000.0
            float bestHvnSupportScore = -1000000000.0

            int bestHvnResistance = -1
            float bestHvnResistanceDist = 1000000000.0
            float bestHvnResistanceScore = -1000000000.0

            int bestAirAbove = -1
            float bestAirAboveDist = 1000000000.0
            float bestAirAboveScore = -1000000000.0

            int bestAirBelow = -1
            float bestAirBelowDist = 1000000000.0
            float bestAirBelowScore = -1000000000.0

            // Structural pass: choose the zones that answer the actual battle-map questions.
            for zi = 0 to zN - 1
                c = array.get(zCenter, zi)
                bot = array.get(zBot, zi)
                top = array.get(zTop, zi)
                kd = array.get(zKind, zi)
                st = array.get(zState, zi)
                dAtr = array.get(zDistAtr, zi)
                relSc = array.get(zRelScore, zi)

                showByState = vis_showStale or st != 6
                nearEnough = dAtr <= v296BattleAtr or st == 1 or st == 2 or st == 3 or st == 4
                lvnAllowed = kd != -1 or not vis_hideFarLvns or dAtr <= v296LvnAtr or st == 1

                if showByState and nearEnough and lvnAllowed
                    isInside = close <= top and close >= bot

                    if isInside and relSc > bestInsideScore
                        bestInside := zi
                        bestInsideScore := relSc

                    // HVN/acceptance zones: treated as support/resistance shelves based on current price location.
                    airConfirmedBattle = v24AirShelfConfirmed(kd, array.get(zPmReact, zi), array.get(zPmCloses, zi), array.get(zPmPivots, zi))
                    actionableBattle = v24IsActionableMemory(kd, airConfirmedBattle)

                    if actionableBattle and close > top
                        dist = close - top
                        if dist < bestHvnSupportDist or (dist == bestHvnSupportDist and relSc > bestHvnSupportScore)
                            bestHvnSupport := zi
                            bestHvnSupportDist := dist
                            bestHvnSupportScore := relSc

                    if actionableBattle and close < bot
                        dist = bot - close
                        if dist < bestHvnResistanceDist or (dist == bestHvnResistanceDist and relSc > bestHvnResistanceScore)
                            bestHvnResistance := zi
                            bestHvnResistanceDist := dist
                            bestHvnResistanceScore := relSc

                    // LVNs/air pockets: treated as transition corridors, not shelves.
                    if kd == -1 and c > close
                        dist = c - close
                        if dist < bestAirAboveDist or (dist == bestAirAboveDist and relSc > bestAirAboveScore)
                            bestAirAbove := zi
                            bestAirAboveDist := dist
                            bestAirAboveScore := relSc

                    if kd == -1 and c < close
                        dist = close - c
                        if dist < bestAirBelowDist or (dist == bestAirBelowDist and relSc > bestAirBelowScore)
                            bestAirBelow := zi
                            bestAirBelowDist := dist
                            bestAirBelowScore := relSc

            if bestInside != -1 and array.indexof(drawList, bestInside) == -1
                array.push(drawList, bestInside)
            if bestHvnSupport != -1 and array.indexof(drawList, bestHvnSupport) == -1
                array.push(drawList, bestHvnSupport)
            if bestHvnResistance != -1 and array.indexof(drawList, bestHvnResistance) == -1
                array.push(drawList, bestHvnResistance)

            // v2.3 reserved Structural Memory quota. STRUCT candidates get slots before PM/AIR fill so repeated
            // swing/range levels are not suppressed by sparse VP/Chip data.
            if vis_visualMode != "Clean" and not vis_memoryRailMode and v23_useStructureMemory and (v23_msReserveNear + v23_msReserveBelow + v23_msReserveAbove > 0)
                msNearAdded = 0
                msBelowAdded = 0
                msAboveAdded = 0
                scanMs = 0
                while scanMs < zN and array.size(drawList) < maxDraw
                    ziMs = array.get(zIdx, scanMs)
                    scanMs += 1
                    kdMs = array.get(zKind, ziMs)
                    stMs = array.get(zState, ziMs)
                    dAtrMs = array.get(zDistAtr, ziMs)
                    botMs = array.get(zBot, ziMs)
                    topMs = array.get(zTop, ziMs)
                    isStructZone = kdMs == 3
                    showMsByState = vis_showStale or stMs != 6
                    nearMsEnough = dAtrMs <= v296BattleAtr or stMs == 1 or stMs == 2 or stMs == 3 or stMs == 4
                    if isStructZone and showMsByState and nearMsEnough and array.indexof(drawList, ziMs) == -1
                        if close >= botMs and close <= topMs and msNearAdded < v23_msReserveNear
                            array.push(drawList, ziMs)
                            msNearAdded += 1
                        else if close > topMs and msBelowAdded < v23_msReserveBelow
                            array.push(drawList, ziMs)
                            msBelowAdded += 1
                        else if close < botMs and msAboveAdded < v23_msReserveAbove
                            array.push(drawList, ziMs)
                            msAboveAdded += 1

            // P2B reserved PM quota. PM candidates get slots before plain AIR corridors so the fallback survives display ranking.
            if vis_visualMode != "Clean" and not vis_memoryRailMode and v221_usePriceMemory and (v221_pmReserveNear + v221_pmReserveBelow + v221_pmReserveAbove > 0)
                pmNearAdded = 0
                pmBelowAdded = 0
                pmAboveAdded = 0
                scanPm = 0
                while scanPm < zN and array.size(drawList) < maxDraw
                    ziPm = array.get(zIdx, scanPm)
                    scanPm += 1
                    kdPm = array.get(zKind, ziPm)
                    stPm = array.get(zState, ziPm)
                    dAtrPm = array.get(zDistAtr, ziPm)
                    botPm = array.get(zBot, ziPm)
                    topPm = array.get(zTop, ziPm)
                    isPmZone = kdPm == 2 or kdPm == -2
                    showPmByState = vis_showStale or stPm != 6
                    nearPmEnough = dAtrPm <= v296BattleAtr or stPm == 1 or stPm == 2 or stPm == 3 or stPm == 4
                    if isPmZone and showPmByState and nearPmEnough and array.indexof(drawList, ziPm) == -1
                        if close >= botPm and close <= topPm and pmNearAdded < v221_pmReserveNear
                            array.push(drawList, ziPm)
                            pmNearAdded += 1
                        else if close > topPm and pmBelowAdded < v221_pmReserveBelow
                            array.push(drawList, ziPm)
                            pmBelowAdded += 1
                        else if close < botPm and pmAboveAdded < v221_pmReserveAbove
                            array.push(drawList, ziPm)
                            pmAboveAdded += 1

            if vis_visualMode != "Clean" and not vis_memoryRailMode and v25_useDevMemory and v25_devReserveNear > 0
                devAdded = 0
                scanDev = 0
                while scanDev < zN and array.size(drawList) < maxDraw and devAdded < v25_devReserveNear
                    ziDev = array.get(zIdx, scanDev)
                    scanDev += 1
                    kdDev = array.get(zKind, ziDev)
                    stDev = array.get(zState, ziDev)
                    dAtrDev = array.get(zDistAtr, ziDev)
                    showDevByState = vis_showStale or stDev != 6
                    nearDevEnough = dAtrDev <= v296BattleAtr or stDev == 1 or stDev == 2 or stDev == 3 or stDev == 4
                    if kdDev == 4 and showDevByState and nearDevEnough and array.indexof(drawList, ziDev) == -1
                        array.push(drawList, ziDev)
                        devAdded += 1

            if vis_memoryRailMode
                bestAirPath = bestAirAbove
                bestAirPathDist = bestAirAboveDist
                if bestAirBelow != -1 and (bestAirAbove == -1 or bestAirBelowDist < bestAirPathDist)
                    bestAirPath := bestAirBelow
                    bestAirPathDist := bestAirBelowDist
                if bestAirPath != -1 and array.indexof(drawList, bestAirPath) == -1 and array.size(drawList) < maxDraw
                    array.push(drawList, bestAirPath)
            if vis_visualMode != "Clean" and not vis_memoryRailMode and bestAirAbove != -1 and array.indexof(drawList, bestAirAbove) == -1 and array.size(drawList) < maxDraw
                array.push(drawList, bestAirAbove)
            if vis_visualMode != "Clean" and not vis_memoryRailMode and bestAirBelow != -1 and array.indexof(drawList, bestAirBelow) == -1 and array.size(drawList) < maxDraw
                array.push(drawList, bestAirBelow)

            // Fill remaining slots by relevance, but keep the stricter battle-map distance and LVN rules.
            scan = 0
            while scan < zN and array.size(drawList) < maxDraw and vis_visualMode != "Clean" and not vis_memoryRailMode
                zi = array.get(zIdx, scan)
                scan += 1

                st = array.get(zState, zi)
                kd = array.get(zKind, zi)
                dAtr = array.get(zDistAtr, zi)

                showByState = vis_showStale or st != 6
                nearEnough = dAtr <= v296BattleAtr or st == 1 or st == 2 or st == 3 or st == 4
                lvnAllowed = kd != -1 or not vis_hideFarLvns or dAtr <= v296LvnAtr or st == 1

                if showByState and nearEnough and lvnAllowed and array.indexof(drawList, zi) == -1
                    array.push(drawList, zi)
        else
            // Trading Map / Full Map keep relevance ranking, with visual discipline applied to far LVNs.
            // v2.3: reserve structural memory first, then PM, then generic relevance fill.
            if v23_useStructureMemory and (v23_msReserveNear + v23_msReserveBelow + v23_msReserveAbove > 0)
                msNearAdded = 0
                msBelowAdded = 0
                msAboveAdded = 0
                scanMs = 0
                while scanMs < zN and array.size(drawList) < maxDraw
                    ziMs = array.get(zIdx, scanMs)
                    scanMs += 1
                    kdMs = array.get(zKind, ziMs)
                    stMs = array.get(zState, ziMs)
                    dAtrMs = array.get(zDistAtr, ziMs)
                    dPctMs = array.get(zDistPct, ziMs)
                    botMs = array.get(zBot, ziMs)
                    topMs = array.get(zTop, ziMs)
                    isStructZone = kdMs == 3
                    showMsByState = vis_showStale or stMs != 6
                    showMsByMode = vis_displayMode == "Full Map" ? true : (dAtrMs <= v296TradeAtr or dPctMs <= v296TradePct or stMs == 1 or stMs == 2 or stMs == 3 or stMs == 4)
                    if isStructZone and showMsByState and showMsByMode and array.indexof(drawList, ziMs) == -1
                        if close >= botMs and close <= topMs and msNearAdded < v23_msReserveNear
                            array.push(drawList, ziMs)
                            msNearAdded += 1
                        else if close > topMs and msBelowAdded < v23_msReserveBelow
                            array.push(drawList, ziMs)
                            msBelowAdded += 1
                        else if close < botMs and msAboveAdded < v23_msReserveAbove
                            array.push(drawList, ziMs)
                            msAboveAdded += 1

            // P2B: reserve PM slots before generic relevance fill so valid price-memory fallback survives ranking.
            if v221_usePriceMemory and (v221_pmReserveNear + v221_pmReserveBelow + v221_pmReserveAbove > 0)
                pmNearAdded = 0
                pmBelowAdded = 0
                pmAboveAdded = 0
                scanPm = 0
                while scanPm < zN and array.size(drawList) < maxDraw
                    ziPm = array.get(zIdx, scanPm)
                    scanPm += 1
                    kdPm = array.get(zKind, ziPm)
                    stPm = array.get(zState, ziPm)
                    dAtrPm = array.get(zDistAtr, ziPm)
                    dPctPm = array.get(zDistPct, ziPm)
                    botPm = array.get(zBot, ziPm)
                    topPm = array.get(zTop, ziPm)
                    isPmZone = kdPm == 2 or kdPm == -2
                    showPmByState = vis_showStale or stPm != 6
                    showPmByMode = vis_displayMode == "Full Map" ? true : (dAtrPm <= v296TradeAtr or dPctPm <= v296TradePct or stPm == 1 or stPm == 2 or stPm == 3 or stPm == 4)
                    if isPmZone and showPmByState and showPmByMode and array.indexof(drawList, ziPm) == -1
                        if close >= botPm and close <= topPm and pmNearAdded < v221_pmReserveNear
                            array.push(drawList, ziPm)
                            pmNearAdded += 1
                        else if close > topPm and pmBelowAdded < v221_pmReserveBelow
                            array.push(drawList, ziPm)
                            pmBelowAdded += 1
                        else if close < botPm and pmAboveAdded < v221_pmReserveAbove
                            array.push(drawList, ziPm)
                            pmAboveAdded += 1

            if v25_useDevMemory and v25_devReserveNear > 0
                devAdded = 0
                scanDev = 0
                while scanDev < zN and array.size(drawList) < maxDraw and devAdded < v25_devReserveNear
                    ziDev = array.get(zIdx, scanDev)
                    scanDev += 1
                    kdDev = array.get(zKind, ziDev)
                    stDev = array.get(zState, ziDev)
                    dAtrDev = array.get(zDistAtr, ziDev)
                    dPctDev = array.get(zDistPct, ziDev)
                    showDevByState = vis_showStale or stDev != 6
                    showDevByMode = vis_displayMode == "Full Map" ? true : (dAtrDev <= v296TradeAtr or dPctDev <= v296TradePct or stDev == 1 or stDev == 2 or stDev == 3 or stDev == 4)
                    if kdDev == 4 and showDevByState and showDevByMode and array.indexof(drawList, ziDev) == -1
                        array.push(drawList, ziDev)
                        devAdded += 1

            scan = 0
            while scan < zN and array.size(drawList) < maxDraw
                zi = array.get(zIdx, scan)
                scan += 1

                kd = array.get(zKind, zi)
                st = array.get(zState, zi)
                dAtr = array.get(zDistAtr, zi)
                dPct = array.get(zDistPct, zi)

                showByMode = true
                if vis_displayMode == "Trading Map"
                    showByMode := dAtr <= v296TradeAtr or dPct <= v296TradePct or st == 1 or st == 2 or st == 3 or st == 4
                else
                    showByMode := true

                showByState = vis_showStale or st != 6
                lvnAllowed = kd != -1 or not vis_hideFarLvns or vis_displayMode == "Full Map" or dAtr <= v296LvnAtr or st == 1

                if showByMode and showByState and lvnAllowed and array.indexof(drawList, zi) == -1
                    array.push(drawList, zi)

        drawCount = array.size(drawList)
        v23DrawCount := drawCount
        if drawCount > 0
            for di = 0 to drawCount - 1
                zi = array.get(drawList, di)

                c = array.get(zCenter, zi)
                bot = array.get(zBot, zi)
                top = array.get(zTop, zi)
                dp = array.get(zDelta, zi)
                kd = array.get(zKind, zi)
                srcType = array.get(zSrc, zi)
                histSc = array.get(zHistScore, zi)
                relSc = array.get(zRelScore, zi)
                st = array.get(zState, zi)
                touches = array.get(zTouches, zi)
                rejects = array.get(zRejects, zi)
                lastTouchAgo = array.get(zLastTouch, zi)
                lastCrossAgo = array.get(zLastCross, zi)
                lastCrossDir = array.get(zCrossDir, zi)
                dAtr = array.get(zDistAtr, zi)
                dPct = array.get(zDistPct, zi)
                pmZoneScore = array.get(zPmScore, zi)
                pmZoneReact = array.get(zPmReact, zi)
                pmZoneCloses = array.get(zPmCloses, zi)
                pmZoneWicks = array.get(zPmWicks, zi)
                pmZoneFails = array.get(zPmFails, zi)
                pmZonePivots = array.get(zPmPivots, zi)
                msZoneScore = array.get(zMsScore, zi)
                msZoneTouches = array.get(zMsTouches, zi)
                msZoneHighs = array.get(zMsHighs, zi)
                msZoneLows = array.get(zMsLows, zi)
                devZoneScore = array.get(zDevScore, zi)

                airConfirmed = v24AirShelfConfirmed(kd, pmZoneReact, pmZoneCloses, pmZonePivots)
                roleNow = roleText(close, bot, top)
                roleNowShort = roleShort(close, bot, top)
                v24Class = v24ConfidenceClass(kd, srcType, relSc, dAtr, hasSharesOut, abnormalStructure, pmZoneReact, pmZoneCloses, pmZonePivots, msZoneTouches)
                v24Role = v24RoleClass(kd, close, c, bot, top, airConfirmed, v24TrendUp, v24TrendDown)
                v24RoleS = v24RoleShort(v24Role)
                v25DistState = v25DistanceState(close, bot, top, dAtr, lastTouchAgo)
                v25DistS = v25DistanceShort(v25DistState)
                v25AirTxt = v25AirTaxonomy(kd, close, c, airConfirmed)
                kindTxt = v25AirTxt != "" ? v25AirTxt : (v21_showConfluenceInLabels ? zoneSourceShort(kd, srcType) : zoneKindText(kd))
                stTxt = stateText(st)
                stShort = stateShort(st)
                bias = math.abs(dp) >= sr_deltaStrong ? (dp > 0 ? "Bull-biased" : "Bear-biased") : "Neutral-bias"
                mapScoreForZone = na(mapConfidenceScore) ? 50.0 : mapConfidenceScore
                mapWarnForZone = mapWarningCode
                zoneReliabilityRawScore = v27ZoneReliabilityScore(kd, srcType, hasSharesOut, mapScoreForZone, abnormalStructure, mapWarnForZone, st, dAtr, touches, rejects, lastTouchAgo, lastCrossAgo, lastCrossDir, relSc, histSc, pmZoneReact, pmZoneCloses, pmZonePivots, msZoneTouches, devZoneScore, airConfirmed, close > top, close < bot)
                zoneReliabilityCap = v27ZoneReliabilityCap(kd, srcType, hasSharesOut, st, dAtr, lastTouchAgo, mapWarnForZone, abnormalStructure, airConfirmed, msZoneTouches, msZoneHighs, msZoneLows)
                zoneReliabilityScore = v27ZoneReliabilityCappedScore(zoneReliabilityRawScore, zoneReliabilityCap)
                zoneReliabilityClass = v27ZoneReliabilityClass(kd, zoneReliabilityScore)

                fillCol = neutralFillBase
                borderCol = neutralBorderBase
                borderStyle = line.style_solid
                borderW = 2

                // v2.1.1 visual hierarchy:
                // C-HVN > VP-HVN > CH-HVN > AIR. Chip-only zones are deliberately dimmer than confluence zones.
                isSupportRole = close > top
                isResistanceRole = close < bot
                isInsideRole = not isSupportRole and not isResistanceRole

                if st == 6
                    fillCol := staleFillBase
                    borderCol := staleBorderBase
                    borderStyle := line.style_dotted
                    borderW := 1
                else if kd == -1
                    fillCol := lvnFillBase
                    borderCol := lvnBorderBase
                    borderStyle := line.style_dashed
                    borderW := 1
                else if kd == -2 and not airConfirmed
                    fillCol := lvnFillBase
                    borderCol := lvnBorderBase
                    borderStyle := line.style_dotted
                    borderW := 1
                else if kd == -2
                    fillCol := airPmFillBase
                    borderCol := airPmBorderBase
                    borderStyle := line.style_dashed
                    borderW := 1
                else if kd == 4
                    fillCol := isSupportRole ? devSupportFill : isResistanceRole ? devResistFill : isInsideRole ? devInsideFill : devNeutralFill
                    borderCol := isSupportRole ? devSupportBorder : isResistanceRole ? devResistBorder : isInsideRole ? devInsideBorder : devNeutralBorder
                    borderStyle := line.style_dashed
                    borderW := 1
                else if kd == 3
                    fillCol := isSupportRole ? structSupportFill : isResistanceRole ? structResistFill : structInsideFill
                    borderCol := isSupportRole ? structSupportBorder : isResistanceRole ? structResistBorder : structInsideBorder
                    borderStyle := line.style_dashed
                    borderW := 2
                else if kd == 2
                    fillCol := isSupportRole ? pmSupportFill : isResistanceRole ? pmResistFill : pmInsideFill
                    borderCol := isSupportRole ? pmSupportBorder : isResistanceRole ? pmResistBorder : pmInsideBorder
                    borderStyle := line.style_dashed
                    borderW := 2
                else if st == 2
                    fillCol := srcType == 3 ? confSupportFill : srcType == 2 ? chipSupportFill : reclaimedFillBase
                    borderCol := srcType == 3 ? confSupportBorder : srcType == 2 ? chipSupportBorder : reclaimedBorderBase
                    borderStyle := line.style_solid
                    borderW := srcType == 3 ? 3 : srcType == 2 ? 1 : 2
                else if st == 3
                    fillCol := srcType == 3 ? confResistFill : srcType == 2 ? chipResistFill : flippedFillBase
                    borderCol := srcType == 3 ? confResistBorder : srcType == 2 ? chipResistBorder : flippedBorderBase
                    borderStyle := line.style_solid
                    borderW := srcType == 3 ? 3 : srcType == 2 ? 1 : 2
                else if isSupportRole
                    fillCol := srcType == 3 ? confSupportFill : srcType == 2 ? chipSupportFill : vpSupportFill
                    borderCol := srcType == 3 ? confSupportBorder : srcType == 2 ? chipSupportBorder : vpSupportBorder
                    borderStyle := line.style_solid
                    borderW := srcType == 3 ? 3 : srcType == 2 ? 1 : 2
                else if isResistanceRole
                    fillCol := srcType == 3 ? confResistFill : srcType == 2 ? chipResistFill : vpResistFill
                    borderCol := srcType == 3 ? confResistBorder : srcType == 2 ? chipResistBorder : vpResistBorder
                    borderStyle := line.style_solid
                    borderW := srcType == 3 ? 3 : srcType == 2 ? 1 : 2
                else
                    fillCol := srcType == 3 ? confInsideFill : srcType == 2 ? chipInsideFill : vpInsideFill
                    borderCol := srcType == 3 ? confInsideBorder : srcType == 2 ? chipInsideBorder : vpInsideBorder
                    borderStyle := line.style_solid
                    borderW := srcType == 3 ? 3 : srcType == 2 ? 1 : 2

                // v2.2 Zone-origin discipline. A current battle shelf should not always look like it existed
                // with equal force from the full profile start.
                originModeEff = v22_zoneOriginMode == "Auto" ? (vis_displayMode == "Current Battle Map" ? "Compact Right" : vis_displayMode == "Trading Map" ? "Last Touch" : "Full Profile") : v22_zoneOriginMode
                originLeft = VP.startIndex
                if originModeEff == "Recent Window"
                    originLeft := recentStartIndex
                else if originModeEff == "Compact Right"
                    originLeft := math.max(VP.startIndex, last_bar_index - v22_compactOriginBars)
                else if originModeEff == "Last Touch"
                    originLeft := lastTouchAgo < 100000 ? math.max(VP.startIndex, last_bar_index - math.min(vp_profileLength, lastTouchAgo + v22_lastTouchPadBars)) : VP.startIndex
                else
                    originLeft := VP.startIndex

                // v2.7.6 companion UI is the right-side memory-shelf histogram above.
                // Zone boxes and labels remain available only in Diagnostic mode.
                if not vis_memoryRailMode
                    b = box.new(left=originLeft, top=top, right=last_bar_index, bottom=bot, xloc=xloc.bar_index,
                                border_color=borderCol, border_width=borderW, border_style=borderStyle, bgcolor=fillCol)
                    array.push(srBoxes, b)

                if not vis_memoryRailMode and vis_showLabels
                    txt = str.tostring(c, format.mintick)
                    labelRole = v24RoleS
                    if v24_labelMode == "Simple"
                        prefix = (v24_showConfidenceClass ? v24Class + " " : "") + (v25_showDistanceState ? v25DistS + " " : "") + (v24_showRoleClass ? labelRole + " " : "")
                        txt := prefix + str.tostring(c, format.mintick)
                    else if v24_labelMode == "Smart"
                        prefix = (v24_showConfidenceClass ? v24Class + " " : "") + (v25_showDistanceState ? v25DistState + " " : "") + (v24_showRoleClass ? v24Role + " " : "")
                        txt := prefix + kindTxt + " " + str.tostring(c, format.mintick)
                    else
                        labelRole := kd == -1 ? (c > close ? "UP" : c < close ? "DN" : "IN") : roleNowShort
                        txt := vis_labelDetail == "Verbose" ? stTxt + " | " + kindTxt + " | " + labelRole + " | " + str.tostring(c, format.mintick) : stShort + " " + kindTxt + "-" + labelRole + " " + str.tostring(c, format.mintick)

                    crossTxt = lastCrossDir == 1 ? "Cross up" : lastCrossDir == -1 ? "Cross down" : "No cross"
                    chipTxt = useChips ? (hasSharesOut ? "shares" : "fallback") : "raw VP"
                    tip = "Zone: " + str.tostring(bot, format.mintick) + " - " + str.tostring(top, format.mintick) +
                          "\nCenter: " + str.tostring(c, format.mintick) +
                          "\nType/source: " + kindTxt +
                          "\nState/role: " + stTxt + " / " + v24Role +
                          "\nConfidence/reliability: " + v24Class + " / " + zoneReliabilityClass + " " + str.tostring(zoneReliabilityScore, "#") +
                          "\nScores: hist " + str.tostring(histSc, "#.##") + ", current " + str.tostring(relSc, "#.##") +
                          "\nDistance: " + str.tostring(dAtr, "#.##") + " ATR / " + str.tostring(dPct, "#.##") + "%" +
                          "\nTouches/rejections: " + str.tostring(touches) + " / " + str.tostring(rejects) +
                          "\nLast touch: " + (lastTouchAgo >= 100000 ? "none" : str.tostring(lastTouchAgo) + " bars") +
                          "\nCross: " + crossTxt +
                          "\nPolarity: " + bias + " " + str.tostring(dp * 100, "#.##") + "%" +
                          "\nChip input: " + chipTxt +
                          "\nValue: " + valueState + " / " + priceVsRecentValue +
                          "\nEndpoint map only; historical availability is not established."


                    if v23_useStructureMemory
                        tip := tip +
                               "\nSTRUCT score: " + str.tostring(msZoneScore, "#.##") +
                               "\nSTRUCT touches: " + str.tostring(msZoneTouches) +
                               "\nSTRUCT pivot highs: " + str.tostring(msZoneHighs) +
                               "\nSTRUCT pivot lows: " + str.tostring(msZoneLows)


                    labelSizeEff = getTextSize(vp_profileLevels)
                    labelBgEff = priceLabelBg
                    labelFgEff = priceLabelFg
                    labelXEff = last_bar_index + 1
                    labelStyleEff = label.style_label_right
                    lb = label.new(labelXEff, c, txt, xloc.bar_index, yloc.price,
                                   labelBgEff, labelStyleEff, labelFgEff, labelSizeEff, text.align_left, tip)
                    array.push(srLabels, lb)

// Split out of the main build block to avoid TradingView CE10205: if statement too long.
if buildNow
    //==================================================================================================
    // V2.1.1 OPEN-SPACE / STRUCTURE STATUS + MAP CONFIDENCE
    //==================================================================================================
    bool lowMapCoverageState = false
    if v21_showOpenSpaceLabel
        bool hasNearHvnSupport = false
        bool hasNearHvnResistance = false
        bool hasNearConfluence = false
        bool hasNearVpOnly = false
        bool hasNearChipOnly = false
        bool hasNearPriceMemory = false
        bool hasNearAirPm = false
        bool hasNearStructuralMemory = false
        float nearestSupportAtr = 100000.0
        float nearestResistanceAtr = 100000.0
        float nearestAirAtr = 100000.0
        float nearestSupportPrice = na
        float nearestResistancePrice = na
        float nearestSupportLo = na
        float nearestSupportHi = na
        float nearestResistanceLo = na
        float nearestResistanceHi = na
        float secondResistanceAtr = 100000.0
        float secondResistanceLo = na
        float secondResistanceHi = na
        float nearestAirPrice = na
        float nearestAirAboveAtr = 100000.0
        string nearestAirRole = "none"
        bool hasCurrentBattle = false
        float currentBattlePrice = na
        float currentBattleLo = na
        float currentBattleHi = na
        float currentBattleAtr = 100000.0
        string currentBattleRole = "none"
        bool hasNearDevMemory = false
        float nearestDevAtr = 100000.0
        float nearestDevPrice = na

        if zN > 0
            for zi = 0 to zN - 1
                kd = array.get(zKind, zi)
                srcType = array.get(zSrc, zi)
                st = array.get(zState, zi)
                bot = array.get(zBot, zi)
                top = array.get(zTop, zi)
                dAtr = array.get(zDistAtr, zi)
                showByState = vis_showStale or st != 6
                nearForStatus = dAtr <= v21_openSpaceAtr or st == 1 or st == 2 or st == 3 or st == 4

                airConfirmedStatus = v24AirShelfConfirmed(kd, array.get(zPmReact, zi), array.get(zPmCloses, zi), array.get(zPmPivots, zi))
                actionableStatus = v24IsActionableMemory(kd, airConfirmedStatus)
                if actionableStatus and showByState
                    if nearForStatus
                        hasNearConfluence := hasNearConfluence or srcType == 3
                        hasNearVpOnly := hasNearVpOnly or srcType == 1
                        hasNearChipOnly := hasNearChipOnly or srcType == 2
                        hasNearPriceMemory := hasNearPriceMemory or kd == 2
                        hasNearAirPm := hasNearAirPm or kd == -2
                        hasNearStructuralMemory := hasNearStructuralMemory or kd == 3

                    currentTouchStatus = v255CurrentTouch(close, bot, top, atr)
                    if currentTouchStatus
                        hasCurrentBattle := true
                        battleCenter = array.get(zCenter, zi)
                        battleRole = v24RoleClass(kd, close, battleCenter, bot, top, airConfirmedStatus, v24TrendUp, v24TrendDown)
                        if dAtr < currentBattleAtr
                            currentBattleAtr := dAtr
                            currentBattlePrice := battleCenter
                            currentBattleLo := bot
                            currentBattleHi := top
                            currentBattleRole := battleRole == "" ? "CURRENT" : battleRole
                    else if close > top
                        if dAtr < nearestSupportAtr
                            nearestSupportAtr := dAtr
                            nearestSupportPrice := array.get(zCenter, zi)
                            nearestSupportLo := bot
                            nearestSupportHi := top
                        if dAtr <= v21_openSpaceAtr
                            hasNearHvnSupport := true
                    else if close < bot
                        if dAtr < nearestResistanceAtr
                            secondResistanceAtr := nearestResistanceAtr
                            secondResistanceLo := nearestResistanceLo
                            secondResistanceHi := nearestResistanceHi
                            nearestResistanceAtr := dAtr
                            nearestResistancePrice := array.get(zCenter, zi)
                            nearestResistanceLo := bot
                            nearestResistanceHi := top
                        else if dAtr < secondResistanceAtr
                            secondResistanceAtr := dAtr
                            secondResistanceLo := bot
                            secondResistanceHi := top
                        if dAtr <= v21_openSpaceAtr
                            hasNearHvnResistance := true
                    else
                        hasNearHvnSupport := true
                        hasNearHvnResistance := true
                        nearestSupportAtr := 0.0
                        nearestResistanceAtr := 0.0
                        nearestSupportPrice := array.get(zCenter, zi)
                        nearestResistancePrice := array.get(zCenter, zi)
                        nearestSupportLo := bot
                        nearestSupportHi := top
                        nearestResistanceLo := bot
                        nearestResistanceHi := top

                if kd == 4 and showByState
                    if dAtr <= effDevMaxDistanceAtr()
                        hasNearDevMemory := true
                    if dAtr < nearestDevAtr
                        nearestDevAtr := dAtr
                        nearestDevPrice := array.get(zCenter, zi)

                isAirForTable = (kd == -1 or (kd == -2 and not actionableStatus)) and showByState
                if isAirForTable
                    if array.get(zCenter, zi) > close and dAtr < nearestAirAboveAtr
                        nearestAirAboveAtr := dAtr
                    if dAtr < nearestAirAtr
                        nearestAirAtr := dAtr
                        nearestAirPrice := array.get(zCenter, zi)
                        nearestAirRole := v25AirTaxonomy(kd, close, array.get(zCenter, zi), airConfirmedStatus)
                        if nearestAirRole == ""
                            nearestAirRole := v24RoleClass(kd, close, array.get(zCenter, zi), bot, top, airConfirmedStatus, v24TrendUp, v24TrendDown)

        // v2.5.2 guard override: if bracket/broken-recovery logic found overhead memory, do not allow
        // the status layer to read as clean OPEN/OPEN-UP simply because the standard nearest-resistance
        // scan did not find a mature HVN inside its usual ATR threshold.
        if v251BracketGuardActive and not na(v251BracketUpperPrice) and atr > 0
            guardAtr = math.abs(v251BracketUpperPrice - close) / atr
            if guardAtr < nearestResistanceAtr
                secondResistanceAtr := nearestResistanceAtr
                secondResistanceLo := nearestResistanceLo
                secondResistanceHi := nearestResistanceHi
                nearestResistanceAtr := guardAtr
                nearestResistancePrice := v251BracketUpperPrice
                nearestResistanceLo := v251BracketUpperPrice
                nearestResistanceHi := v251BracketUpperPrice
            hasNearHvnResistance := true
            hasNearStructuralMemory := true

        if v251BrokenRecoveryActive and not na(v251BrokenOverheadPrice) and atr > 0
            brokenAtr = math.abs(v251BrokenOverheadPrice - close) / atr
            if brokenAtr < nearestResistanceAtr
                secondResistanceAtr := nearestResistanceAtr
                secondResistanceLo := nearestResistanceLo
                secondResistanceHi := nearestResistanceHi
                nearestResistanceAtr := brokenAtr
                nearestResistancePrice := v251BrokenOverheadPrice
                nearestResistanceLo := v251BrokenOverheadPrice
                nearestResistanceHi := v251BrokenOverheadPrice
            hasNearHvnResistance := true
            hasNearStructuralMemory := true

        if not na(nearestSupportPrice) and not na(nearestResistancePrice) and atr > 0
            overlapRoleAtr = math.abs(nearestSupportPrice - nearestResistancePrice) / atr
            if overlapRoleAtr <= 0.18
                hasCurrentBattle := true
                if na(currentBattlePrice)
                    currentBattlePrice := (nearestSupportPrice + nearestResistancePrice) / 2.0
                    currentBattleLo := math.min(nearestSupportLo, nearestResistanceLo)
                    currentBattleHi := math.max(nearestSupportHi, nearestResistanceHi)
                    currentBattleAtr := math.min(nearestSupportAtr, nearestResistanceAtr)
                    currentBattleRole := "CURRENT OVERLAP"
                nearestSupportAtr := 100000.0
                nearestResistanceAtr := 100000.0
                nearestSupportPrice := na
                nearestResistancePrice := na
                nearestSupportLo := na
                nearestSupportHi := na
                nearestResistanceLo := na
                nearestResistanceHi := na
                hasNearHvnSupport := false
                hasNearHvnResistance := false

        noSupportNearLowMap = nearestSupportAtr > effLowMapAtrReach()
        noResistanceNearLowMap = nearestResistanceAtr > effLowMapAtrReach()
        noDevNearLowMap = nearestDevAtr > effLowMapAtrReach()
        noBattleNearLowMap = currentBattleAtr > effLowMapAtrReach()
        noMemoryWithinLowMapReach = noSupportNearLowMap and noResistanceNearLowMap and noDevNearLowMap and noBattleNearLowMap
        lowMapNoAcceptedMemory = zN > 0 and noMemoryWithinLowMapReach and not hasNearPriceMemory and not hasNearStructuralMemory and not hasNearDevMemory and not hasCurrentBattle
        lowMapTooFewZones = v23DrawCount <= v25_lowMapMinDrawnZones and noMemoryWithinLowMapReach
        lowMapCoverage = v25_showLowMapCoverage and (lowMapTooFewZones or lowMapNoAcceptedMemory or (v23DrawCount <= 1 and noMemoryWithinLowMapReach))
        lowMapCoverage := lowMapCoverage or (v251BracketGuardActive and not v251BracketCandidateForced) or (v251BrokenRecoveryActive and not v251BrokenCandidateForced)
        lowMapCoverageState := lowMapCoverage

        rawOpenStatus = not hasCurrentBattle and not hasNearHvnSupport and not hasNearHvnResistance
        rawOpenUpStatus = not hasCurrentBattle and hasNearHvnSupport and not hasNearHvnResistance
        rawCleanUpsideStatus = rawOpenStatus or rawOpenUpStatus
        overheadAirVisible = not na(nearestAirPrice) and nearestAirPrice > close and nearestAirAtr < 100000.0
        v256AirRoomGate := rawCleanUpsideStatus and overheadAirVisible and nearestAirAtr < v256OpenAirMinAtr()
        v256AirTestGate := rawCleanUpsideStatus and overheadAirVisible and nearestAirAtr >= v256OpenAirMinAtr() and nearestAirAtr <= v256AirTestMaxAtr()
        v256FinalUpperGate = rawCleanUpsideStatus and not lowMapCoverage and (v256UpperMemoryGate or v256AirRoomGate or v256AirTestGate)
        v256BrokenTestFinal = v256FinalUpperGate and v256BrokenTestGate
        v256ResolvedUpperPrice = v256UpperMemoryGate ? v256UpperMemoryPrice : nearestAirPrice
        v256ResolvedUpperAtr = v256UpperMemoryGate ? v256UpperMemoryAtr : nearestAirAtr
        if v256FinalUpperGate
            hasNearStructuralMemory := hasNearStructuralMemory or v256UpperMemoryGate

        // v2.7 Phase 1: whole-map confidence uses existing evidence only.
        guardActiveForMap = v251BracketGuardActive or v251BrokenRecoveryActive or v256BrokenTestFinal or v256FinalUpperGate
        mapSparseDominant = lowMapCoverage and noMemoryWithinLowMapReach
        noUsefulNearMemory = not hasCurrentBattle and not hasNearConfluence and not hasNearVpOnly and not hasNearChipOnly and not hasNearPriceMemory and not hasNearAirPm and not hasNearStructuralMemory and not hasNearDevMemory
        fallbackHeavyMap = v27FallbackHeavy(hasNearConfluence, hasNearVpOnly, hasNearChipOnly, hasNearPriceMemory, hasNearAirPm, hasNearStructuralMemory, hasNearDevMemory)
        staleFarDominant = zN > 0 and v23DrawCount > 0 and noMemoryWithinLowMapReach and not hasCurrentBattle
        mapConfidenceRawScore := v27MapConfidenceScore(mapSparseDominant, abnormalStructure, hasNearConfluence, hasNearVpOnly, hasNearChipOnly, hasNearPriceMemory, hasNearAirPm, hasNearStructuralMemory, hasNearDevMemory, hasCurrentBattle, hasNearHvnSupport, hasNearHvnResistance, hasSharesOut, useChips, guardActiveForMap, v256FinalUpperGate, noUsefulNearMemory, fallbackHeavyMap, staleFarDominant)
        mapConfidenceScore := v288MicroActive ? math.min(mapConfidenceRawScore, v288MicroCeiling) : mapConfidenceRawScore
        mapConfidenceClass := v27MapConfidenceClass(mapConfidenceScore, mapSparseDominant, abnormalStructure, hasNearConfluence)
        mapWarningCode := v27MapWarningCode(mapSparseDominant, abnormalStructure, fallbackHeavyMap, staleFarDominant, guardActiveForMap)
        confTxt = mapConfidenceClass + " " + str.tostring(mapConfidenceScore, "#")
        if lowMapCoverage and not vis_memoryRailMode
            lowMapTxt = "LOW MAP COVERAGE"
            lowMapTip = "The active price area is under-mapped. No reliable HVN/PM/STRUCT/DEV memory was detected within " + str.tostring(effLowMapAtrReach(), "#.##") + " ATR. This is an omission warning, not an open-sky signal."
            if na(mapCoverageLabel)
                mapCoverageLabel := label.new(last_bar_index + 1, low, lowMapTxt, xloc.bar_index, yloc.price, lowMapBg, label.style_label_left, lowMapFg, size.tiny, text.align_left, lowMapTip)
            else
                label.set_xy(mapCoverageLabel, last_bar_index + 1, low)
                label.set_text(mapCoverageLabel, lowMapTxt)
                label.set_color(mapCoverageLabel, lowMapBg)
                label.set_textcolor(mapCoverageLabel, lowMapFg)
                label.set_size(mapCoverageLabel, size.tiny)
                label.set_style(mapCoverageLabel, label.style_label_left)
                label.set_tooltip(mapCoverageLabel, lowMapTip)
        else
            if not na(mapCoverageLabel)
                label.delete(mapCoverageLabel)
                mapCoverageLabel := na

        if v26_showBattleTable
            if na(v24BattleTable)
                v24BattleTable := table.new(v24TablePosition(v24_battleTablePos), 2, 20, border_width=1)
            biasTxt = v256BiasText(v251BrokenRecoveryActive, v251BracketGuardActive, hasCurrentBattle, abnormalStructure, lowMapCoverage, v256FinalUpperGate, v256BrokenTestFinal, v256AirRoomGate or v256AirTestGate, hasNearHvnSupport, hasNearHvnResistance, valueDeltaAtr, effValueMigrationThreshold())

            supTxt = na(nearestSupportPrice) ? (not na(nearestDevPrice) and nearestDevPrice < close ? "DEV/forming " + str.tostring(nearestDevPrice, format.mintick) + " / " + str.tostring(nearestDevAtr, "#.##") + " ATR" : "none") : str.tostring(nearestSupportPrice, format.mintick) + " / " + str.tostring(nearestSupportAtr, "#.##") + " ATR"
            resTxt = "none"
            if not na(nearestResistancePrice)
                resTxt := str.tostring(nearestResistancePrice, format.mintick) + " / " + str.tostring(nearestResistanceAtr, "#.##") + " ATR"
            else if v256FinalUpperGate and not na(v256ResolvedUpperPrice)
                resTxt := "memory " + str.tostring(v256ResolvedUpperPrice, format.mintick) + " / " + str.tostring(v256ResolvedUpperAtr, "#.##") + " ATR"
            battleTxt = "none"
            if not na(currentBattlePrice)
                battleTxt := str.tostring(currentBattlePrice, format.mintick) + " / " + currentBattleRole
            else if v256FinalUpperGate and not na(v256ResolvedUpperPrice)
                battleTxt := biasTxt + " " + str.tostring(v256ResolvedUpperPrice, format.mintick)
            airTxt = na(nearestAirPrice) ? "none" : str.tostring(nearestAirPrice, format.mintick) + " / " + nearestAirRole + " / " + str.tostring(nearestAirAtr, "#.##") + " ATR"
            if v256AirRoomGate
                airTxt := airTxt + " | TOO CLOSE"
            else if v256AirTestGate
                airTxt := airTxt + " | TEST"
            devTxt = na(nearestDevPrice) ? "none" : str.tostring(nearestDevPrice, format.mintick) + " / " + str.tostring(nearestDevAtr, "#.##") + " ATR"
            guardTxt = "none"
            if v251BrokenRecoveryActive
                guardTxt := "RECOVERY OH " + (na(v251BrokenOverheadPrice) ? "none" : str.tostring(v251BrokenOverheadPrice, format.mintick))
            else if v251BracketGuardActive
                guardTxt := "BRACKET R " + (na(v251BracketUpperPrice) ? "none" : str.tostring(v251BracketUpperPrice, format.mintick))
            else if v256BrokenTestFinal
                guardTxt := "BROKEN TEST " + (na(v256ResolvedUpperPrice) ? "none" : str.tostring(v256ResolvedUpperPrice, format.mintick))
            else if v256FinalUpperGate
                guardTxt := "UPPER MEM " + (na(v256ResolvedUpperPrice) ? "none" : str.tostring(v256ResolvedUpperPrice, format.mintick))
            table.cell(v24BattleTable, 0, 0, "v3.0 M6A.3b | " + v27PresetShort(), bgcolor=color.new(color.gray, 38), text_color=color.white)
            table.cell(v24BattleTable, 1, 0, confTxt + " | " + biasTxt, bgcolor=color.new(color.gray, 38), text_color=color.white)
            table.cell(v24BattleTable, 0, 1, "Current zone", text_color=chart.fg_color)
            table.cell(v24BattleTable, 1, 1, battleTxt, text_color=chart.fg_color)
            table.cell(v24BattleTable, 0, 2, "Support below", text_color=chart.fg_color)
            table.cell(v24BattleTable, 1, 2, supTxt, text_color=chart.fg_color)
            table.cell(v24BattleTable, 0, 3, "Res / memory above", text_color=chart.fg_color)
            table.cell(v24BattleTable, 1, 3, resTxt, text_color=chart.fg_color)
            table.cell(v24BattleTable, 0, 4, "Air path", text_color=chart.fg_color)
            table.cell(v24BattleTable, 1, 4, airTxt, text_color=chart.fg_color)
            table.cell(v24BattleTable, 0, 5, "DEV / Coverage", text_color=chart.fg_color)
            table.cell(v24BattleTable, 1, 5, devTxt + " | " + (lowMapCoverage ? "LOW MAP" : abnormalStructure ? "EVENT MAP" : v23DrawCount <= 1 ? "SPARSE" : "OK"), text_color=chart.fg_color)
            table.cell(v24BattleTable, 0, 6, "Guard / Bias", text_color=chart.fg_color)
            table.cell(v24BattleTable, 1, 6, guardTxt + " | " + biasTxt + " | " + valueShort, text_color=chart.fg_color)
            color tableBaseBg = ext_opaqueDiagnosticTable ? color.new(color.black, 8) : na
            color tableText = ext_opaqueDiagnosticTable ? color.white : chart.fg_color
            color microBg = not ext_showMicroDiagnostic ? color.new(color.gray, 70) : not v287MicroContractOk ? color.new(color.red, 42) : v287MicroStatusCode == 1 ? color.new(color.teal, 42) : v287MicroStatusCode == 2 ? color.new(color.orange, 36) : color.new(color.red, 34)
            for tableRow = 1 to 6
                table.cell_set_bgcolor(v24BattleTable, 0, tableRow, tableBaseBg)
                table.cell_set_bgcolor(v24BattleTable, 1, tableRow, tableBaseBg)
                table.cell_set_text_color(v24BattleTable, 0, tableRow, tableText)
                table.cell_set_text_color(v24BattleTable, 1, tableRow, tableText)
            table.cell(v24BattleTable, 0, 7, "Micro contract", text_color=tableText, bgcolor=tableBaseBg, tooltip=v287MicroTip)
            table.cell(v24BattleTable, 1, 7, ext_showMicroDiagnostic ? v287MicroHeader : "HIDDEN", text_color=color.white, bgcolor=microBg, tooltip=v287MicroTip)
            table.cell(v24BattleTable, 0, 8, "Micro profile", text_color=tableText, bgcolor=tableBaseBg, tooltip=v287MicroTip)
            table.cell(v24BattleTable, 1, 8, ext_showMicroDiagnostic ? v287MicroProfile : "HIDDEN", text_color=tableText, bgcolor=tableBaseBg, tooltip=v287MicroTip)
            table.cell(v24BattleTable, 0, 9, "Micro codes", text_color=tableText, bgcolor=tableBaseBg, tooltip=v287MicroTip)
            table.cell(v24BattleTable, 1, 9, ext_showMicroDiagnostic ? v287MicroCodes : "HIDDEN", text_color=tableText, bgcolor=tableBaseBg, tooltip=v287MicroTip)
            color fallbackBg = v287MicroFallback == "NONE" ? color.new(color.teal, 52) : v287MicroStatusCode == 2 and v287MicroContractOk ? color.new(color.orange, 42) : color.new(color.red, 40)
            table.cell(v24BattleTable, 0, 10, "Micro fallback", text_color=tableText, bgcolor=tableBaseBg, tooltip=v287MicroTip)
            table.cell(v24BattleTable, 1, 10, ext_showMicroDiagnostic ? v287MicroFallback : "HIDDEN", text_color=color.white, bgcolor=fallbackBg, tooltip=v287MicroTip)
            guardrailRows = v288WriteGuardrailRows(v24BattleTable, tableText, tableBaseBg, mapConfidenceRawScore, mapConfidenceScore)
            shadowRows = v290WriteShadowRows(v24BattleTable, tableText, tableBaseBg)
        else
            if not na(v24BattleTable)
                table.delete(v24BattleTable)
                v24BattleTable := na

        if v312_showRailAudit and nodeMax > 0 and not vis_memoryRailMode
            if na(v312RailAuditTable)
                v312RailAuditTable := table.new(position.bottom_left, 4, 42, border_width=1)
            auditRows = v315WriteRailAudit(v312RailAuditTable)
        else
            if not na(v312RailAuditTable)
                table.delete(v312RailAuditTable)
                v312RailAuditTable := na

    else
        if not na(mapCoverageLabel)
            label.delete(mapCoverageLabel)
            mapCoverageLabel := na
        if not na(v24BattleTable)
            table.delete(v24BattleTable)
            v24BattleTable := na
        if not na(v312RailAuditTable)
            table.delete(v312RailAuditTable)
            v312RailAuditTable := na

    //==================================================================================================
    // V2.3 OPEN-SKY MODE
    // Open-sky object logic is helper-wrapped to keep the main body below TradingView CE10295 limits.
    //==================================================================================================
    [openSkyLabelNew, openSkyLineNew, openSkyLookbackLenNew, prevOpenSkyHighNew, trueResistanceNearNew, nearestTrueResistanceAtrNew, openSkyBreakoutNew, openSkyActiveNew] = v27UpdateOpenSky(openSkyLabel, openSkyLine, lowMapCoverageState)
    openSkyLabel := openSkyLabelNew
    openSkyLine := openSkyLineNew
    openSkyLookbackLen := openSkyLookbackLenNew
    prevOpenSkyHigh := prevOpenSkyHighNew
    trueResistanceNear := trueResistanceNearNew
    nearestTrueResistanceAtr := nearestTrueResistanceAtrNew
    openSkyBreakout := openSkyBreakoutNew
    openSkyActive := openSkyActiveNew

    //==================================================================================================
    // v2.8.9.3 token-lean: optional PM debug UI remains removed; core PM calculations unchanged.
    //==================================================================================================
    chipReliabilityLabel := v255UpdateChipReliabilityLabel(chipReliabilityLabel)

    // v3.0 P1.5: Pressure Rails add nearest-side emphasis and current-bar release candidates; Diagnostic keeps the audit.
    if vis_memoryRailMode and nodeMax > 0
        if vis_fastScanMode
            v300DrawPressureRails()
        else
            v280DrawMemoryShelfAuthority()

//==================================================================================================
// v2.7.3 CE10295 hard fix
// Hidden BUS plots are intentionally removed in this lean compiler-safe file.
