//@version=6
indicator(
     "MACD Momentum Structure",
     shorttitle="MACDStruct",
     overlay=false,
     max_lines_count=100,
     max_labels_count=50)

// ============================================================================
// VERTEX MACD MOMENTUM STRUCTURE
//
// MACD transformed into a visual momentum map:
//
// ACCELERATION
//      ↓
// EXPANSION
//      ↓
// DECELERATION
//      ↓
// TRANSITION / EXHAUSTION
//      ↓
// MOMENTUM SHIFT
//
// This indicator visualizes momentum structure.
// It does not predict future price with certainty.
// ============================================================================


// ============================================================================
// INPUTS
// ============================================================================

groupMACD = "MACD"

fastLength = input.int(
     12,
     "Fast Length",
     minval=1,
     group=groupMACD)

slowLength = input.int(
     26,
     "Slow Length",
     minval=2,
     group=groupMACD)

signalLength = input.int(
     9,
     "Signal Length",
     minval=1,
     group=groupMACD)

source = input.source(
     close,
     "Source",
     group=groupMACD)

groupVisual = "Visual Structure"

showHistogram = input.bool(
     true,
     "Show Momentum Histogram",
     group=groupVisual)

showWave = input.bool(
     true,
     "Show Momentum Wave",
     group=groupVisual)

showSignal = input.bool(
     true,
     "Show Signal Wave",
     group=groupVisual)

showZero = input.bool(
     true,
     "Show Zero Line",
     group=groupVisual)

showPhases = input.bool(
     true,
     "Show Momentum Phases",
     group=groupVisual)

showTurningPoints = input.bool(
     true,
     "Show Turning Points",
     group=groupVisual)

showFlow = input.bool(
     true,
     "Show Momentum Flow",
     group=groupVisual)

showDivergence = input.bool(
     true,
     "Show Divergence",
     group=groupVisual)

waveSmooth = input.int(
     3,
     "Wave Smoothing",
     minval=1,
     maxval=10,
     group=groupVisual)

groupFlow = "Momentum Flow"

flowLength = input.int(
     8,
     "Flow Projection",
     minval=3,
     maxval=30,
     group=groupFlow)

turnSensitivity = input.int(
     3,
     "Turning Point Sensitivity",
     minval=1,
     maxval=8,
     group=groupFlow)


// ============================================================================
// COLORS
// ============================================================================

color bullishStrong = color.rgb(50, 205, 150)
color bullishSoft   = color.rgb(75, 175, 205)

color bearishStrong = color.rgb(235, 95, 105)
color bearishSoft   = color.rgb(225, 150, 80)

color neutralColor  = color.rgb(150, 160, 175)


// ============================================================================
// MACD CALCULATION
// ============================================================================

fastEMA = ta.ema(source, fastLength)
slowEMA = ta.ema(source, slowLength)

macd = fastEMA - slowEMA
signal = ta.ema(macd, signalLength)
hist = macd - signal

// Smoothed MACD wave
wave = ta.ema(macd, waveSmooth)


// ============================================================================
// MOMENTUM CHARACTERISTICS
// ============================================================================

histRising = hist > hist[1]
histFalling = hist < hist[1]

macdRising = macd > macd[1]
macdFalling = macd < macd[1]

acceleration = hist - hist[1]


// ============================================================================
// MOMENTUM PHASE CLASSIFICATION
//
// 1 = Bullish Acceleration
// 2 = Bullish Expansion
// 3 = Bullish Deceleration
// 4 = Bearish Acceleration
// 5 = Bearish Expansion
// 6 = Bearish Deceleration
// 7 = Transition
// ============================================================================

int phase = 7

if macd > 0 and hist > 0 and histRising
    phase := 2

else if macd > 0 and hist > 0 and histFalling
    phase := 3

else if macd > 0 and hist <= 0 and histRising
    phase := 1

else if macd < 0 and hist < 0 and histFalling
    phase := 5

else if macd < 0 and hist < 0 and histRising
    phase := 6

else if macd < 0 and hist >= 0 and histFalling
    phase := 4

else
    phase := 7


// ============================================================================
// PHASE COLOR
// ============================================================================

color waveColor =
     phase == 1 or phase == 2 ?
         bullishStrong :
     phase == 3 ?
         bullishSoft :
     phase == 4 or phase == 5 ?
         bearishStrong :
     phase == 6 ?
         bearishSoft :
         neutralColor


// ============================================================================
// HISTOGRAM COLOR
// ============================================================================

color histogramColor =
     hist >= 0 ?
         histRising ?
             color.new(bullishStrong, 15) :
             color.new(bullishSoft, 20) :
         histFalling ?
             color.new(bearishStrong, 15) :
             color.new(bearishSoft, 20)


// ============================================================================
// ZERO LINE
// ============================================================================

hline(
     0,
     "Zero",
     color =
         showZero ?
             color.new(color.white, 75) :
             color.new(color.white, 100),
     linestyle=hline.style_dotted)


// ============================================================================
// HISTOGRAM
// ============================================================================

plot(
     showHistogram ? hist : na,
     title="Momentum Histogram",
     style=plot.style_columns,
     color=histogramColor,
     histbase=0)


// ============================================================================
// MACD MOMENTUM WAVE
// ============================================================================

wavePlot = plot(
     showWave ? wave : na,
     title="Momentum Wave",
     color=waveColor,
     linewidth=3)


// ============================================================================
// SIGNAL WAVE
// ============================================================================

signalPlot = plot(
     showSignal ? signal : na,
     title="Signal Wave",
     color=color.new(color.white, 35),
     linewidth=1)


// ============================================================================
// WAVE SPREAD
// ============================================================================

fill(
     wavePlot,
     signalPlot,
     color =
         wave >= signal ?
             color.new(bullishStrong, 90) :
             color.new(bearishStrong, 90),
     title="Momentum Wave Spread")


// ============================================================================
// TURNING POINTS
// ============================================================================

pivotHigh = ta.pivothigh(
     wave,
     turnSensitivity,
     turnSensitivity)

pivotLow = ta.pivotlow(
     wave,
     turnSensitivity,
     turnSensitivity)

bool newHigh = not na(pivotHigh)
bool newLow = not na(pivotLow)


// ============================================================================
// TURNING POINT MARKERS
// ============================================================================
//
// IMPORTANT:
// plotshape() uses its first argument as the plotted Y value when
// location.absolute is used.
// ============================================================================

plotshape(
     showTurningPoints ? pivotHigh : na,
     title="Momentum High",
     style=shape.circle,
     location=location.absolute,
     offset=-turnSensitivity,
     size=size.tiny,
     color=color.new(bullishSoft, 0))

plotshape(
     showTurningPoints ? pivotLow : na,
     title="Momentum Low",
     style=shape.circle,
     location=location.absolute,
     offset=-turnSensitivity,
     size=size.tiny,
     color=color.new(bearishSoft, 0))


// ============================================================================
// CROSSOVER / CROSSUNDER
// ============================================================================

bullCross = ta.crossover(macd, signal)
bearCross = ta.crossunder(macd, signal)

plotshape(
     bullCross ? 0 : na,
     title="Bullish Momentum Shift",
     style=shape.triangleup,
     location=location.absolute,
     size=size.tiny,
     color=color.new(bullishStrong, 0))

plotshape(
     bearCross ? 0 : na,
     title="Bearish Momentum Shift",
     style=shape.triangledown,
     location=location.absolute,
     size=size.tiny,
     color=color.new(bearishStrong, 0))


// ============================================================================
// ZERO-LINE TRANSITIONS
// ============================================================================

bullZero = ta.crossover(macd, 0)
bearZero = ta.crossunder(macd, 0)

plotshape(
     bullZero ? 0 : na,
     title="Bullish Zero Transition",
     style=shape.diamond,
     location=location.absolute,
     size=size.tiny,
     color=color.new(bullishStrong, 0))

plotshape(
     bearZero ? 0 : na,
     title="Bearish Zero Transition",
     style=shape.diamond,
     location=location.absolute,
     size=size.tiny,
     color=color.new(bearishStrong, 0))


// ============================================================================
// MOMENTUM FLOW OBJECTS
// ============================================================================

var array<line> flowLines = array.new_line()
var array<label> phaseLabels = array.new_label()


// ============================================================================
// CLEAR OLD FLOW OBJECTS
// ============================================================================

if barstate.islast

    if array.size(flowLines) > 0

        for i = 0 to array.size(flowLines) - 1
            line.delete(array.get(flowLines, i))

        array.clear(flowLines)


    if array.size(phaseLabels) > 0

        for i = 0 to array.size(phaseLabels) - 1
            label.delete(array.get(phaseLabels, i))

        array.clear(phaseLabels)


// ============================================================================
// MOMENTUM FLOW PROJECTION
// ============================================================================
//
// This projects the current momentum direction rather than price.
// It is intentionally presented as a "flow", not a prediction.
// ============================================================================

if showFlow and barstate.islast

    float currentWave = wave

    float waveSlope = wave - wave[3]

    float projectedWave =
         currentWave + waveSlope * 0.75

    int x1 = bar_index

    int x2 =
         bar_index +
         int(math.round(flowLength * 0.45))

    int x3 =
         bar_index +
         flowLength

    float middleWave =
         currentWave +
         (projectedWave - currentWave) * 0.45


    line flow1 = line.new(
         x1,
         currentWave,
         x2,
         middleWave,
         color=color.new(waveColor, 10),
         width=3)

    line flow2 = line.new(
         x2,
         middleWave,
         x3,
         projectedWave,
         color=color.new(waveColor, 30),
         width=3,
         style=line.style_dashed)


    array.push(flowLines, flow1)
    array.push(flowLines, flow2)


// ============================================================================
// PHASE LABEL
// ============================================================================

string phaseText = ""

if phase == 1
    phaseText := "ACCELERATION"

else if phase == 2
    phaseText := "MOMENTUM EXPANSION"

else if phase == 3
    phaseText := "DECELERATION"

else if phase == 4
    phaseText := "BEARISH ACCELERATION"

else if phase == 5
    phaseText := "MOMENTUM EXPANSION"

else if phase == 6
    phaseText := "DECELERATION"

else
    phaseText := "TRANSITION"


if showPhases and barstate.islast

    label phaseLabel = label.new(
         bar_index + 2,
         wave,
         phaseText,
         style=label.style_label_left,
         color=color.new(waveColor, 20),
         textcolor=color.white,
         size=size.small)

    array.push(phaseLabels, phaseLabel)


// ============================================================================
// DIVERGENCE DETECTION
// ============================================================================

pricePivotHigh = ta.pivothigh(
     high,
     turnSensitivity,
     turnSensitivity)

pricePivotLow = ta.pivotlow(
     low,
     turnSensitivity,
     turnSensitivity)


// Previous confirmed pivot values
var float previousPriceHigh = na
var float previousWaveHigh = na

var float previousPriceLow = na
var float previousWaveLow = na


bool bearishDivergence = false
bool bullishDivergence = false


// ----------------------------------------------------------------------------
// BEARISH DIVERGENCE
// Price makes higher high.
// Momentum makes lower high.
// ----------------------------------------------------------------------------

if not na(pricePivotHigh) and not na(pivotHigh)

    float currentPriceHigh = pricePivotHigh
    float currentWaveHigh = pivotHigh

    bearishDivergence :=
         not na(previousPriceHigh) and
         not na(previousWaveHigh) and
         currentPriceHigh > previousPriceHigh and
         currentWaveHigh < previousWaveHigh

    previousPriceHigh := currentPriceHigh
    previousWaveHigh := currentWaveHigh


// ----------------------------------------------------------------------------
// BULLISH DIVERGENCE
// Price makes lower low.
// Momentum makes higher low.
// ----------------------------------------------------------------------------

if not na(pricePivotLow) and not na(pivotLow)

    float currentPriceLow = pricePivotLow
    float currentWaveLow = pivotLow

    bullishDivergence :=
         not na(previousPriceLow) and
         not na(previousWaveLow) and
         currentPriceLow < previousPriceLow and
         currentWaveLow > previousWaveLow

    previousPriceLow := currentPriceLow
    previousWaveLow := currentWaveLow


// ============================================================================
// DIVERGENCE MARKERS
// ============================================================================

plotshape(
     showDivergence and bearishDivergence ? wave : na,
     title="Bearish Momentum Divergence",
     style=shape.labeldown,
     location=location.absolute,
     offset=-turnSensitivity,
     size=size.tiny,
     color=color.new(bearishSoft, 10),
     text="DIV",
     textcolor=color.white)


plotshape(
     showDivergence and bullishDivergence ? wave : na,
     title="Bullish Momentum Divergence",
     style=shape.labelup,
     location=location.absolute,
     offset=-turnSensitivity,
     size=size.tiny,
     color=color.new(bullishSoft, 10),
     text="DIV",
     textcolor=color.white)


// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     bullCross,
     title="Bullish MACD Momentum Shift",
     message="Vertex MACD Momentum Structure: bullish momentum shift.")

alertcondition(
     bearCross,
     title="Bearish MACD Momentum Shift",
     message="Vertex MACD Momentum Structure: bearish momentum shift.")

alertcondition(
     bullishDivergence,
     title="Bullish Momentum Divergence",
     message="Vertex MACD Momentum Structure: bullish momentum divergence detected.")

alertcondition(
     bearishDivergence,
     title="Bearish Momentum Divergence",
     message="Vertex MACD Momentum Structure: bearish momentum divergence detected.")
