// All time components are read once in the selected timezone and passed on to
// every session; dayofweek starts at Sunday and is converted to ISO counting
// (1 = Monday).
string cal_timezone = inp_timezone == "Exchange" ? syminfo.timezone : inp_timezone

int cal_year       = year      (time, cal_timezone)
int cal_month      = month     (time, cal_timezone)
int cal_dayOfMonth = dayofmonth(time, cal_timezone)
int cal_hour       = hour      (time, cal_timezone)
int cal_minute     = minute    (time, cal_timezone)
int cal_dayOfWeek  = dayofweek (time, cal_timezone)
int cal_isoDay     = cal_dayOfWeek == 1 ? 7 : cal_dayOfWeek - 1
int cal_weekOfYear = weekofyear(time, cal_timezone)

int cal_timeKey = cal_hour * con_shift2 + cal_minute


// Each call site keeps its own var instance of the state variables, so the seven
// sessions run as seven state machines independent of one another.
f_sessionBox(bool show, string mode, int startMonth, int endMonth, int startDay, int endDay, int startHour, int endHour, int startMinute, int endMinute, color fillColor, bool showBorder, color borderColor, int borderWidth, int barYear, int barMonth, int barDayOfMonth, int barIsoDay, int barWeekOfYear, int timeKey) =>
    int cal_currentKey = switch mode
        con_optDaily   => timeKey
        con_optWeekly  => barIsoDay     * con_shift4 + timeKey
        con_optMonthly => barDayOfMonth * con_shift4 + timeKey
        =>                barMonth * con_shift6 + barDayOfMonth * con_shift4 + timeKey

    int cal_startKey = switch mode
        con_optDaily   => startHour * con_shift2 + startMinute
        con_optWeekly  => math.min(startDay, 7) * con_shift4 + startHour * con_shift2 + startMinute
        con_optMonthly => startDay * con_shift4 + startHour * con_shift2 + startMinute
        =>                startMonth * con_shift6 + startDay * con_shift4 + startHour * con_shift2 + startMinute

    int cal_endKey = switch mode
        con_optDaily   => endHour * con_shift2 + endMinute
        con_optWeekly  => math.min(endDay, 7) * con_shift4 + endHour * con_shift2 + endMinute
        con_optMonthly => endDay * con_shift4 + endHour * con_shift2 + endMinute
        =>                endMonth * con_shift6 + endDay * con_shift4 + endHour * con_shift2 + endMinute

    bool cal_isWrapping = cal_startKey > cal_endKey

    bool cal_inWindow = cal_startKey == cal_endKey ? true : cal_isWrapping ? (cal_currentKey >= cal_startKey or cal_currentKey < cal_endKey) : (cal_currentKey >= cal_startKey and cal_currentKey < cal_endKey)

    int cal_periodId = switch mode
        con_optDaily   => barYear * con_shift4 + barMonth * con_shift2 + barDayOfMonth
        con_optWeekly  => barYear * con_shift2 + barWeekOfYear
        con_optMonthly => barYear * con_shift2 + barMonth
        =>                barYear

    var int  cal_prevPeriodId = na
    var bool cal_prevInWindow = false
    bool cal_periodChanged = not na(cal_prevPeriodId) and cal_periodId != cal_prevPeriodId

    bool cal_isStart = cal_inWindow and (not cal_prevInWindow or (not cal_isWrapping and cal_periodChanged))

    var box[] outp_sessionBoxes = array.new<box>()
    var box   outp_currentBox   = na

    if show
        if cal_isStart
            outp_currentBox := box.new(left = bar_index, top = high, right = bar_index, bottom = low,
                 xloc         = xloc.bar_index,
                 border_color = showBorder ? borderColor : na,
                 border_width = showBorder ? borderWidth : 0,
                 bgcolor      = fillColor)
            array.push(outp_sessionBoxes, outp_currentBox)
            if array.size(outp_sessionBoxes) > con_maxBoxesPerSession
                box.delete(array.shift(outp_sessionBoxes))

        else if cal_inWindow and not na(outp_currentBox)
            box.set_top   (outp_currentBox, math.max(box.get_top(outp_currentBox),    high))
            box.set_bottom(outp_currentBox, math.min(box.get_bottom(outp_currentBox), low))
            box.set_right (outp_currentBox, bar_index)

    cal_prevInWindow := cal_inWindow
    cal_prevPeriodId := cal_periodId


f_sessionBox(inp_show1, inp_mode1, inp_startMonth1, inp_endMonth1, inp_startDay1, inp_endDay1, inp_startHour1, inp_endHour1, inp_startMinute1, inp_endMinute1, inp_fillColor1, inp_showBorder1, inp_borderColor1, inp_borderWidth1, cal_year, cal_month, cal_dayOfMonth, cal_isoDay, cal_weekOfYear, cal_timeKey)
