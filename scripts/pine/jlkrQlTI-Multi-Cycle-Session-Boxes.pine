//@version=6
indicator(title = "Multi Cycle Session Boxes", shorttitle = "Session", overlay = true, max_boxes_count = 500)


// The mode names exist once as constants and are referenced everywhere,
// so a typo becomes a compile error instead of a silent dead option.
const string con_optDaily   = "Daily"
const string con_optWeekly  = "Weekly"
const string con_optMonthly = "Monthly"
const string con_optYearly  = "Yearly"

// Seven sessions at 70 boxes each stay below the max_boxes_count of 500.
const int con_maxBoxesPerSession = 70

// Points in time are compared as a single number; the factors shift month, day
// and hour two decimal places to the left each.
const int con_shift2 = 100
const int con_shift4 = 10000
const int con_shift6 = 1000000

const string con_modeTooltip = "Determines which fields below are evaluated:\n\n" + con_optDaily + "     ->  hour : minute only\n\n" + con_optWeekly + "  ->  day (1 = Mon ... 7 = Sun) + hour : minute\n\n" + con_optMonthly + " ->  day (1 - 31) + hour : minute\n\n" + con_optYearly + "    ->  month + day + hour : minute"
const string con_dayTooltip  = "In " + con_optWeekly + " mode both day fields only count up to 7. Higher values are treated as Sunday.\n\nIn " + con_optMonthly + " and " + con_optYearly + " mode, days the calendar month does not have are never reached. An out-of-range start skips the session for that month, an out-of-range end extends the box to the end of the month."

const string con_grpTimezone = "Timezone"

string inp_timezone = input.string(defval = "Europe/Berlin", title = "Timezone", group = con_grpTimezone, options = ["Exchange", "UTC", "Europe/Berlin", "Europe/London", "America/New_York", "America/Chicago", "Asia/Tokyo", "Asia/Shanghai", "Australia/Sydney"])


// Seven identically built blocks: on/off switch and repeat mode, then the time
// window from month down to minute, then fill and border.
const string con_grpSession1 = "SESSION 1"
bool   inp_show1 = input.bool(defval = true, title = "Show boxes", group = con_grpSession1)
string inp_mode1 = input.string(defval = con_optWeekly, title = "Repeat", options = [con_optDaily, con_optWeekly, con_optMonthly, con_optYearly], group = con_grpSession1, tooltip = con_modeTooltip, active = inp_show1)
bool   cal_showMonth1 = inp_show1 and inp_mode1 == con_optYearly
bool   cal_showDay1   = inp_show1 and inp_mode1 != con_optDaily

const string con_grpTime1 = "Session 1 Time (Start:End)"
int inp_startMonth1  = input.int(defval = 4,  title = "Month", minval = 1, maxval = 12, inline = "month1", group = con_grpTime1, active = cal_showMonth1)
int inp_endMonth1    = input.int(defval = 5,  title = ":", minval = 1, maxval = 12, inline = "month1", group = con_grpTime1, active = cal_showMonth1)
int inp_startDay1    = input.int(defval = 1,  title = "Day", minval = 1, maxval = 31, inline = "day1", group = con_grpTime1, active = cal_showDay1)
int inp_endDay1      = input.int(defval = 3,  title = ":", minval = 1, maxval = 31, tooltip = con_dayTooltip, inline = "day1", group = con_grpTime1, active = cal_showDay1)
int inp_startHour1   = input.int(defval = 12, title = "Hour", minval = 0, maxval = 23, inline = "hour1", group = con_grpTime1, active = inp_show1)
int inp_endHour1     = input.int(defval = 15, title = ":", minval = 0, maxval = 23, inline = "hour1", group = con_grpTime1, active = inp_show1)
int inp_startMinute1 = input.int(defval = 0,  title = "Minute", minval = 0, maxval = 59, inline = "minute1", group = con_grpTime1, active = inp_show1)
int inp_endMinute1   = input.int(defval = 30, title = ":", minval = 0, maxval = 59, inline = "minute1", group = con_grpTime1, active = inp_show1)

const string con_grpGraphic1 = "Session 1 Graphic"
color inp_fillColor1   = input.color(defval = color.new(color.teal, 88), title = "Fill", group = con_grpGraphic1, active = inp_show1)
bool  inp_showBorder1  = input.bool(defval = true, title = "Border", inline = "bd1", group = con_grpGraphic1, active = inp_show1)
color inp_borderColor1 = input.color(defval = color.new(color.teal, 40), title = "", inline = "bd1", group = con_grpGraphic1, active = inp_show1 and inp_showBorder1)
int   inp_borderWidth1 = input.int(defval = 1, title = "", minval = 1, maxval = 4, inline = "bd1", group = con_grpGraphic1, active = inp_show1 and inp_showBorder1)

