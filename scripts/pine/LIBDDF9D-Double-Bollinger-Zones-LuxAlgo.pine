//@version=6
indicator("Double Bollinger Zones", shorttitle = "Double Bollinger Zones", overlay = true, format = format.price)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_COLOR = #089981
BEARISH_COLOR = #f23645
NEUTRAL_COLOR = #5b9cf6

UPTREND   =  1 // qualified buy zone residence
DOWNTREND = -1 // qualified sell zone residence
NO_TREND  =  0 // neutral - no regime claimed

ZONE_EDGE_TRANSP    = 80  // zone gradient transparency at the outer band (strongest shading)
ZONE_FLOOR_TRANSP   = 100 // zone gradient transparency at the inner band (fully transparent)
NEUTRAL_EDGE_TRANSP = 92  // neutral gradient transparency at the inner bands
NEUTRAL_MID_TRANSP  = 100 // neutral gradient transparency at the basis
OUTER_LINE_TRANSP   = 50  // transparency of the outer band lines

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 2
  , group   = "Settings"
  , tooltip = "Lookback of the shared basis and of the standard deviation both band pairs are built from. Both sets must run off the same basis and length, otherwise the zones lose their meaning. 20 is the standard construction.")

srcInput = input.source(close, "Source"
  , group   = "Settings"
  , tooltip = "Series the basis and standard deviation are computed on. Zone residence itself is always judged on closing prices, per the method - wicks poking across a boundary do not change the zone.")

basisTypeInput = input.string("SMA", "Basis Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"]
  , group   = "Settings"
  , tooltip = "Moving average used as the single shared basis of both band pairs. The classic construction is a 20-period simple moving average; the alternatives change how quickly the whole zone map tracks price without changing the zone logic.")

innerMultInput = input.float(1.0, "Inner Multiplier", minval = 0.1, step = 0.1
  , group   = "Settings"
  , tooltip = "Standard deviations for the inner band pair - the regime boundaries. Above the basis the inner band is the buy zone floor, below it the sell zone ceiling, and everything between the two inner bands is the neutral zone. 1 is the defining setting of the double-band method.")

outerMultInput = input.float(2.0, "Outer Multiplier", minval = 0.1, step = 0.1
  , group   = "Settings"
  , tooltip = "Standard deviations for the outer band pair - the far edges of the buy and sell zones, keeping their classic role as the rarely exceeded envelope. 2 is the defining setting of the double-band method.")

confirmClosesInput = input.int(2, "Confirmation Closes", minval = 1
  , group   = "Regime"
  , tooltip = "Consecutive closes inside a zone required before its regime is qualified. Demanding more than a single print is the method's first guard against whipsaw at the zone boundary; raise it in choppy tape, or set 1 to react to the first qualifying close.")

bufferInput = input.float(0.0, "Zone Boundary Buffer", minval = 0.0, maxval = 1.0, step = 0.05
  , group   = "Regime"
  , tooltip = "Extra distance, in standard deviations, a close must clear beyond the one-deviation line before it counts as inside the buy or sell zone. A small buffer is the classic second guard against whipsaw at the zone floor; 0 classifies against the raw bands.")

showDashboardInput = input.bool(true, "Show Dashboard"
  , group   = "Dashboard"
  , tooltip = "Zone-state panel: current zone, qualified regime, consecutive closes inside the zone, and how deep the close sits beyond the one-deviation boundary - the same states the method screens a watchlist for.")

dashboardLocationInput = input.string("Top Right", "Location", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"]
  , group   = "Dashboard"
  , tooltip = "Chart corner the dashboard is anchored to.")

dashboardSizeInput = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"]
  , group   = "Dashboard"
  , tooltip = "Text size of the dashboard.")

bullColorInput = input.color(BULLISH_COLOR, "Bullish"
  , group   = "Style"
  , tooltip = "Color of the buy zone - its floor line, its gradient fill, and the uptrend regime readouts.")

bearColorInput = input.color(BEARISH_COLOR, "Bearish"
  , group   = "Style"
  , tooltip = "Color of the sell zone - its ceiling line, its gradient fill, and the downtrend regime readouts.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Neutral"
  , group   = "Style"
  , tooltip = "Color of the neutral zone fill, of the basis while no regime is qualified, and of the neutral readouts.")

regimeBasisInput = input.bool(true, "Regime-Colored Basis"
  , group   = "Style"
  , tooltip = "Tints the basis line by the qualified regime - bullish while consecutive closes hold the buy zone, bearish while they hold the sell zone, neutral otherwise - so the regime map reads at a glance.")

showFillInput = input.bool(true, "Zone Gradient Fills"
  , group   = "Style"
  , tooltip = "Shades each zone with a vertical gradient: the buy and sell zones intensify toward their outer band, the neutral zone stays faint around the basis. Purely visual - the zone logic is unaffected.")

showMarkersInput = input.bool(false, "Regime Markers"
  , group   = "Style"
  , tooltip = "Displays a small marker when a regime qualifies (triangle) or loses its zone (cross). Off by default to keep the chart clean - the alerts cover the same events regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Every basis candidate is computed on every bar, so the selected one is always internally consistent
smaValue  = ta.sma(srcInput, lengthInput)
emaValue  = ta.ema(srcInput, lengthInput)
rmaValue  = ta.rma(srcInput, lengthInput)
wmaValue  = ta.wma(srcInput, lengthInput)
vwmaValue = ta.vwma(srcInput, lengthInput)

basis = switch basisTypeInput
    "EMA"        => emaValue
    "SMMA (RMA)" => rmaValue
    "WMA"        => wmaValue
    "VWMA"       => vwmaValue
    => smaValue

dev = ta.stdev(srcInput, lengthInput)

// Both pairs share one basis and one deviation; keeping the multipliers ordered protects the zones if the inputs are ever inverted
innerMult = math.min(innerMultInput, outerMultInput)
outerMult = math.max(innerMultInput, outerMultInput)

// Four lines, three zones: buy zone between the upper pair, sell zone between the lower pair, neutral zone inside the inner pair
upperOuterBand = basis + outerMult * dev
upperInnerBand = basis + innerMult * dev
lowerInnerBand = basis - innerMult * dev
lowerOuterBand = basis - outerMult * dev

// Classification boundaries - the one-deviation lines pushed out by the optional whipsaw buffer
buyZoneFloor    = basis + (innerMult + bufferInput) * dev
sellZoneCeiling = basis - (innerMult + bufferInput) * dev

//---------------------------------------------------------------------------------------------------------------------}
// Regime Logic
//---------------------------------------------------------------------------------------------------------------------{
// Residence is judged on closes: under rough normality price spends most of its time within one deviation of its own
// mean, so a close holding beyond the inner band is evidence of drift rather than noise
inBuyZone     = not na(buyZoneFloor) and close > buyZoneFloor
inSellZone    = not na(sellZoneCeiling) and close < sellZoneCeiling
inNeutralZone = not na(basis) and not inBuyZone and not inSellZone

// Consecutive-close runs inside each zone - single prints do not qualify a regime
var int buyCloses     = 0
var int sellCloses    = 0
var int neutralCloses = 0
buyCloses     := inBuyZone     ? buyCloses + 1     : 0
sellCloses    := inSellZone    ? sellCloses + 1    : 0
neutralCloses := inNeutralZone ? neutralCloses + 1 : 0

// The regime map: a trend is claimed only after the required run of closes, and drops back to neutral the moment the
// zone is lost - the loss of the zone floor is the method's first warning
regime = buyCloses >= confirmClosesInput ? UPTREND : sellCloses >= confirmClosesInput ? DOWNTREND : NO_TREND

uptrendQualified   = regime == UPTREND   and nz(regime[1]) != UPTREND
downtrendQualified = regime == DOWNTREND and nz(regime[1]) != DOWNTREND
uptrendEnded       = nz(regime[1]) == UPTREND   and regime != UPTREND
downtrendEnded     = nz(regime[1]) == DOWNTREND and regime != DOWNTREND

// A full traverse - one outer zone, through neutral, into the other - is the map's picture of a completed regime change
var int lastTrendRegime = NO_TREND
bullishTraverse = uptrendQualified   and lastTrendRegime == DOWNTREND
bearishTraverse = downtrendQualified and lastTrendRegime == UPTREND
if uptrendQualified
    lastTrendRegime := UPTREND
else if downtrendQualified
    lastTrendRegime := DOWNTREND

// Pullbacks that tag the one-deviation line intrabar but close back inside the zone keep the regime intact - the
// method's continuation entry, with the invalidation sitting just beyond the boundary
buyFloorHeld    = regime == UPTREND   and nz(regime[1]) == UPTREND   and low  <= upperInnerBand and close > buyZoneFloor
sellCeilingHeld = regime == DOWNTREND and nz(regime[1]) == DOWNTREND and high >= lowerInnerBand and close < sellZoneCeiling

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
regimeColor = regime == UPTREND ? bullColorInput : regime == DOWNTREND ? bearColorInput : neutralColorInput
basisColor  = regimeBasisInput ? regimeColor : neutralColorInput

upperOuterPlotId = plot(upperOuterBand, "Upper Outer Band", color = color.new(bullColorInput, OUTER_LINE_TRANSP), linewidth = 1)
upperInnerPlotId = plot(upperInnerBand, "Buy Zone Floor (Upper Inner Band)", color = bullColorInput, linewidth = 1)
basisPlotId      = plot(basis, "Basis", color = basisColor, linewidth = 1)
lowerInnerPlotId = plot(lowerInnerBand, "Sell Zone Ceiling (Lower Inner Band)", color = bearColorInput, linewidth = 1)
lowerOuterPlotId = plot(lowerOuterBand, "Lower Outer Band", color = color.new(bearColorInput, OUTER_LINE_TRANSP), linewidth = 1)

fill(upperOuterPlotId, upperInnerPlotId
  , top_value    = upperOuterBand
  , bottom_value = upperInnerBand
  , top_color    = showFillInput ? color.new(bullColorInput, ZONE_EDGE_TRANSP) : na
  , bottom_color = showFillInput ? color.new(bullColorInput, ZONE_FLOOR_TRANSP) : na
  , title        = "Buy Zone Gradient Fill")

fill(lowerInnerPlotId, lowerOuterPlotId
  , top_value    = lowerInnerBand
  , bottom_value = lowerOuterBand
  , top_color    = showFillInput ? color.new(bearColorInput, ZONE_FLOOR_TRANSP) : na
  , bottom_color = showFillInput ? color.new(bearColorInput, ZONE_EDGE_TRANSP) : na
  , title        = "Sell Zone Gradient Fill")

fill(upperInnerPlotId, basisPlotId
  , top_value    = upperInnerBand
  , bottom_value = basis
  , top_color    = showFillInput ? color.new(neutralColorInput, NEUTRAL_EDGE_TRANSP) : na
  , bottom_color = showFillInput ? color.new(neutralColorInput, NEUTRAL_MID_TRANSP) : na
  , title        = "Neutral Zone Fill (Upper Half)")

fill(basisPlotId, lowerInnerPlotId
  , top_value    = basis
  , bottom_value = lowerInnerBand
  , top_color    = showFillInput ? color.new(neutralColorInput, NEUTRAL_MID_TRANSP) : na
  , bottom_color = showFillInput ? color.new(neutralColorInput, NEUTRAL_EDGE_TRANSP) : na
  , title        = "Neutral Zone Fill (Lower Half)")

plotshape(showMarkersInput and uptrendQualified, "Uptrend Qualified", shape.triangleup, location.belowbar, color = bullColorInput, size = size.tiny)
plotshape(showMarkersInput and downtrendQualified, "Downtrend Qualified", shape.triangledown, location.abovebar, color = bearColorInput, size = size.tiny)
plotshape(showMarkersInput and uptrendEnded, "Uptrend Lost Its Zone", shape.xcross, location.abovebar, color = neutralColorInput, size = size.tiny)
plotshape(showMarkersInput and downtrendEnded, "Downtrend Lost Its Zone", shape.xcross, location.belowbar, color = neutralColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
dashboardLocation = switch dashboardLocationInput
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

dashboardTextSize = switch dashboardSizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    => size.normal

var table dashboardTable = table.new(dashboardLocation, 2, 4, bgcolor = color.new(chart.bg_color, 25), frame_color = color.new(chart.fg_color, 85), frame_width = 1)

if barstate.islast and showDashboardInput
    zoneText  = inBuyZone ? "Buy Zone" : inSellZone ? "Sell Zone" : inNeutralZone ? "Neutral" : "—"
    zoneColor = inBuyZone ? bullColorInput : inSellZone ? bearColorInput : inNeutralZone ? neutralColorInput : chart.fg_color

    regimeText = regime == UPTREND ? "Uptrend" : regime == DOWNTREND ? "Downtrend" : "Neutral"

    // Run length of the current residence, against the qualification requirement for the trend zones
    closesInZone = inBuyZone ? buyCloses : inSellZone ? sellCloses : neutralCloses
    closesText   = inBuyZone or inSellZone ? str.tostring(closesInZone) + " / " + str.tostring(confirmClosesInput) : str.tostring(closesInZone)

    // Depth of the close beyond the one-deviation boundary, in deviations - distance from the zone floor that pullbacks get measured against
    zoneDepth = inBuyZone ? (close - upperInnerBand) / dev : inSellZone ? (lowerInnerBand - close) / dev : na
    depthText = na(zoneDepth) ? "—" : str.tostring(zoneDepth, "0.00") + "σ"

    table.cell(dashboardTable, 0, 0, "Zone",        text_color = chart.fg_color, text_size = dashboardTextSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 0, zoneText,      text_color = zoneColor,      text_size = dashboardTextSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 1, "Regime",      text_color = chart.fg_color, text_size = dashboardTextSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 1, regimeText,    text_color = regimeColor,    text_size = dashboardTextSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 2, "Zone Closes", text_color = chart.fg_color, text_size = dashboardTextSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 2, closesText,    text_color = chart.fg_color, text_size = dashboardTextSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 3, "Zone Depth",  text_color = chart.fg_color, text_size = dashboardTextSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 3, depthText,     text_color = zoneColor,      text_size = dashboardTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(uptrendQualified, "Uptrend Qualified (Buy Zone)", "Double Bollinger Zones: uptrend regime qualified on {{ticker}} - the required consecutive closes inside the buy zone are in place ({{interval}})")
alertcondition(downtrendQualified, "Downtrend Qualified (Sell Zone)", "Double Bollinger Zones: downtrend regime qualified on {{ticker}} - the required consecutive closes inside the sell zone are in place ({{interval}})")
alertcondition(uptrendEnded, "Uptrend Lost Its Zone", "Double Bollinger Zones: the uptrend lost the buy zone on {{ticker}} - the close no longer holds beyond the upper one-deviation band, the trend's first warning ({{interval}})")
alertcondition(downtrendEnded, "Downtrend Lost Its Zone", "Double Bollinger Zones: the downtrend lost the sell zone on {{ticker}} - the close no longer holds beyond the lower one-deviation band, the trend's first warning ({{interval}})")
alertcondition(bullishTraverse, "Bullish Regime Change (Full Traverse)", "Double Bollinger Zones: full traverse on {{ticker}} - price moved from the sell zone through neutral and qualified the buy zone, a completed regime change ({{interval}})")
alertcondition(bearishTraverse, "Bearish Regime Change (Full Traverse)", "Double Bollinger Zones: full traverse on {{ticker}} - price moved from the buy zone through neutral and qualified the sell zone, a completed regime change ({{interval}})")
alertcondition(buyFloorHeld, "Buy Zone Floor Held (Pullback)", "Double Bollinger Zones: pullback tagged the buy zone floor and closed back inside the zone on {{ticker}} - continuation setup with the invalidation just below the floor ({{interval}})")
alertcondition(sellCeilingHeld, "Sell Zone Ceiling Held (Pullback)", "Double Bollinger Zones: pullback tagged the sell zone ceiling and closed back inside the zone on {{ticker}} - continuation setup with the invalidation just above the ceiling ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
