//@version=6
indicator("NQ OVN to AM Amplitude", overlay = true, precision = 2)

string tz         = input.string("America/New_York", "Timezone")
string tfHist     = input.timeframe("15", "History timeframe")
int    lookback   = input.int(60, "Lookback sessions", minval = 10)
float  multSmall  = input.float(1.93, "Small OVN multiplier", step = 0.01)
float  multLarge  = input.float(0.95, "Large OVN multiplier", step = 0.01)

int    atrPeriod  = input.int(14, "ATR period", minval = 1)
string atrTF      = input.timeframe("", "ATR timeframe (empty = chart)")
float  atrMult    = input.float(2.0, "ATR stop multiplier", minval = 0.1, step = 0.1)

bool inOvn    = not na(time(timeframe.period, "1800-0600", tz))
bool ovnStart = inOvn and not inOvn[1]
bool ovnEnd   = inOvn[1] and not inOvn

var float ovnHi = na
var float ovnLo = na
var float lockedRng = na
var float lockedOvnPct = na
var float lockedAmPts = na
var float lockedAmPct = na
var string lockedSize = "-"

if inOvn
    if ovnStart or na(ovnHi)
        ovnHi := high
        ovnLo := low
    else
        ovnHi := math.max(ovnHi, high)
        ovnLo := math.min(ovnLo, low)

f_histMed() =>
    bool sIn = not na(time(timeframe.period, "1800-0600", tz))
    bool sStart = sIn and not sIn[1]
    bool sEnd = sIn[1] and not sIn
    var float hi = na
    var float lo = na
    var float[] hist = array.new_float()
    if sIn
        if sStart or na(hi)
            hi := high
            lo := low
        else
            hi := math.max(hi, high)
            lo := math.min(lo, low)
    if sEnd and not na(hi)
        array.push(hist, hi - lo)
        if array.size(hist) > lookback
            array.shift(hist)
    float med = na
    if array.size(hist) >= 10
        float[] tmp = array.copy(hist)
        array.sort(tmp)
        int n = array.size(tmp)
        int mid = int(n / 2)
        med := n % 2 == 0 ? (array.get(tmp, mid - 1) + array.get(tmp, mid)) / 2.0 : array.get(tmp, mid)
    med

float ovnMed = request.security(syminfo.tickerid, tfHist, f_histMed(), lookahead = barmerge.lookahead_off)

if ovnEnd and not na(ovnHi) and not na(ovnLo)
    lockedRng := ovnHi - ovnLo
    bool isLarge = na(ovnMed) ? true : lockedRng >= ovnMed
    lockedSize := isLarge ? "LARGE" : "SMALL"
    float mult = isLarge ? multLarge : multSmall
    lockedOvnPct := lockedRng / close * 100.0
    lockedAmPts := lockedRng * mult
    lockedAmPct := lockedAmPts / close * 100.0

int  h = hour(time, tz)
int  m = minute(time, tz)
bool inAM = (h > 9 and h < 12) or (h == 9 and m >= 30)
bool amStart = inAM and not inAM[1]

var float amHi = na
var float amLo = na
if amStart
    amHi := high
    amLo := low
if inAM
    amHi := math.max(nz(amHi, high), high)
    amLo := math.min(nz(amLo, low), low)

float livePts = not na(amHi) and not na(amLo) ? amHi - amLo : na
float livePct = not na(livePts) ? livePts / close * 100.0 : na

float atrPts = atrTF == "" ? ta.atr(atrPeriod) : request.security(syminfo.tickerid, atrTF, ta.atr(atrPeriod), lookahead = barmerge.lookahead_off)
float stopPts = atrPts * atrMult
float stopPct = stopPts / close * 100.0

var table t = table.new(position.top_right, 2, 4, bgcolor = color.new(#0f0f0f, 8), border_width = 1, border_color = color.new(color.gray, 55), frame_color = color.new(color.gray, 55), frame_width = 1)

if barstate.islast
    color sizeCol = lockedSize == "LARGE" ? color.aqua : lockedSize == "SMALL" ? color.orange : color.gray

    table.cell(t, 0, 0, "OVN " + lockedSize, text_color = sizeCol, text_halign = text.align_left, text_size = size.normal)
    table.cell(t, 1, 0, na(lockedRng) ? "-" : str.tostring(lockedRng, "#.#") + " pts   " + str.tostring(lockedOvnPct, "0.000") + "%", text_color = color.white, text_halign = text.align_right, text_size = size.normal)

    table.cell(t, 0, 1, "AM projected", text_color = color.orange, text_halign = text.align_left, text_size = size.normal)
    table.cell(t, 1, 1, na(lockedAmPts) ? "-" : str.tostring(lockedAmPts, "#.#") + " pts   " + str.tostring(lockedAmPct, "0.000") + "%", text_color = color.orange, text_halign = text.align_right, text_size = size.normal)

    table.cell(t, 0, 2, "AM current", text_color = color.gray, text_halign = text.align_left, text_size = size.normal)
    table.cell(t, 1, 2, na(livePts) ? "-" : str.tostring(livePts, "#.#") + " pts   " + str.tostring(livePct, "0.000") + "%", text_color = color.white, text_halign = text.align_right, text_size = size.normal)

    table.cell(t, 0, 3, "2x ATR stop", text_color = color.orange, text_halign = text.align_left, text_size = size.normal)
    table.cell(t, 1, 3, na(stopPts) ? "-" : str.tostring(stopPts, "#.#") + " pts   " + str.tostring(stopPct, "0.000") + "%", text_color = color.orange, text_halign = text.align_right, text_size = size.normal)