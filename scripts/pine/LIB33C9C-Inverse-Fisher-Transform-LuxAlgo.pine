//@version=6
indicator("Inverse Fisher Transform", "Inverse Fisher Transform", overlay = false, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BASE_RSI   = "RSI"
BASE_STOCH = "Stochastic"
BASE_SMI   = "SMI"
BASE_CCI   = "CCI"

OSC_MIDPOINT = 50.0 // midpoint removed from 0-100 bounded oscillators to center them on zero

CENTER_LEVEL = 0.0
UPPER_RAIL   = 1.0
LOWER_RAIL   = -1.0

FILL_VALUE_TRANSP  = 50  // gradient transparency at the oscillator end of the fill
FILL_CENTER_TRANSP = 100 // gradient transparency at the zero-line end of the fill

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
baseInput = input.string(BASE_RSI, "Base Oscillator", options = [BASE_RSI, BASE_STOCH, BASE_SMI, BASE_CCI], group = "Settings"
  , tooltip = "Zero-centered oscillator fed to the transform. A short RSI is Ehlers' published example; stochastic, SMI and CCI variants are common. Every base is centered onto the same roughly ±50 footing before scaling — RSI and stochastic by removing their 50 midpoint, the ±100-scaled SMI and CCI by halving — so the scale factor behaves the same for each. Different inputs still produce differently behaved lines.")

lengthInput = input.int(5, "Length", minval = 2, group = "Settings"
  , tooltip = "Lookback of the base oscillator. Ehlers' 2004 example used a 5-period RSI, short enough that the raw oscillator actually visits its extremes.")

sourceInput = input.source(close, "Source", group = "Settings"
  , tooltip = "Price series feeding the base oscillator. Classic CCI implementations use HLC3 (typical price).")

smiSmoothInput = input.int(3, "SMI Smoothing", minval = 1, group = "Settings"
  , tooltip = "Double-EMA smoothing applied to the SMI numerator and denominator. Only used when the base oscillator is SMI.")

scaleInput = input.float(0.1, "Scale Factor", minval = 0.01, step = 0.01, group = "Settings"
  , tooltip = "Multiplier applied to the zero-centered oscillator before smoothing and transforming — the knob that decides how often the ±1 rails are reached. 0.1 is Ehlers' published value; larger values saturate sooner and more often, smaller values leave the output lingering in the ambiguous middle. Two settings can disagree on the same data, so check it before comparing charts.")

smoothInput = input.int(9, "Smoothing Length", minval = 1, group = "Settings"
  , tooltip = "Weighted moving average applied to the scaled input before the transform, per Ehlers' recipe (9 in his example). It steadies the input at the cost of a little lag; 1 disables smoothing.")

//---------------------------------------------------------------------------------------------------------------------}
// Thresholds
//---------------------------------------------------------------------------------------------------------------------{
upperInput = input.float(0.5, "Upper Threshold", minval = 0, maxval = 1, step = 0.05, group = "Thresholds"
  , tooltip = "Boundary between the transition zone and the upper saturated zone. A cross down through it is the conventional sell or exit trigger; a cross up through it commits the output to the +1 rail — a bullish regime label rather than an overbought fade.")

lowerInput = input.float(-0.5, "Lower Threshold", minval = -1, maxval = 0, step = 0.05, group = "Thresholds"
  , tooltip = "Boundary between the transition zone and the lower saturated zone. A cross up through it is the conventional buy trigger; a cross down through it commits the output to the -1 rail — a bearish regime label.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(#089981, "Bullish", inline = "direction", group = "Style"
  , tooltip = "Color of the oscillator and gradient fill above the zero line.")

bearColorInput = input.color(#f23645, "Bearish", inline = "direction", group = "Style"
  , tooltip = "Color of the oscillator and gradient fill below the zero line.")

gradientFillInput = input.bool(true, "Gradient Fill", group = "Style"
  , tooltip = "Vertical gradient between the transform and the zero line, fully transparent at zero and more opaque at the value.")

markersInput = input.bool(false, "Trigger Markers", group = "Style"
  , tooltip = "Circles on the oscillator at the conventional triggers — the cross up through the lower threshold and the cross down through the upper threshold. Off by default to keep the pane clean, the matching alerts fire regardless.")

levelsColorInput = input.color(#787b86, "Levels Color", group = "Style"
  , tooltip = "Color of the dashed threshold levels, the dotted zero line and the dotted ±1 rails.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// John Ehlers' inverse Fisher transform (TASC, 2004): IFT(x) = (e^(2x) - 1) / (e^(2x) + 1), algebraically
// the hyperbolic tangent. The S-curve is nearly linear for small inputs but pushes moderately strong inputs
// hard toward ±1, so a sensibly scaled oscillator spends most of its time saturated near a rail and crosses
// the middle quickly. Written here as 1 - 2 / (e^(2x) + 1), the same value on every finite input, but an
// extreme unbounded input (e.g. a CCI spike on a flat market) settles at the rail instead of returning na.
inverseFisher(float scaledOsc) =>
    1 - 2 / (math.exp(2 * scaledOsc) + 1)

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
// Base oscillators, all computed on every bar so their internal state stays consistent whichever is selected
rsiValue   = ta.rsi(sourceInput, lengthInput)
stochValue = ta.stoch(sourceInput, high, low, lengthInput)
cciValue   = ta.cci(sourceInput, lengthInput)

// Stochastic Momentum Index (Blau): distance of the source from the midpoint of the high/low range,
// double-EMA smoothed and expressed as a percentage of the half-range, bounded ±100
highestHigh  = ta.highest(high, lengthInput)
lowestLow    = ta.lowest(low, lengthInput)
smiNumerator = ta.ema(ta.ema(sourceInput - math.avg(highestHigh, lowestLow), smiSmoothInput), smiSmoothInput)
smiRange     = ta.ema(ta.ema(highestHigh - lowestLow, smiSmoothInput), smiSmoothInput)
float smiValue = na(smiRange) ? na : smiRange != 0 ? 200 * smiNumerator / smiRange : 0

// Common zero-centered footing of roughly ±50: RSI and stochastic have their 50 midpoint removed, the
// ±100-bounded SMI is halved, and CCI's classic ±100 band is halved onto the same scale, so the published
// 0.1 scale factor lands typical values of every base in the curve's active region
float centeredValue = switch baseInput
    BASE_RSI   => rsiValue - OSC_MIDPOINT
    BASE_STOCH => stochValue - OSC_MIDPOINT
    BASE_SMI   => smiValue / 2
    => cciValue / 2

// Ehlers' pipeline: scale the centered oscillator (±5 with the published 0.1 factor), steady it with a
// weighted moving average, then compress it through the transform into a -1 to +1 near-binary state
scaledValue   = scaleInput * centeredValue
smoothedValue = ta.wma(scaledValue, smoothInput)
ift           = inverseFisher(smoothedValue)

// Threshold events — the ±0.5 convention: crossing the lower boundary upward is the buy trigger, crossing
// the upper boundary downward the sell/exit, and crossings into the outer zones mark saturated regimes
bullTriggerEvent    = ta.crossover(ift, lowerInput)
bearTriggerEvent    = ta.crossunder(ift, upperInput)
bullSaturationEvent = ta.crossover(ift, upperInput)
bearSaturationEvent = ta.crossunder(ift, lowerInput)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
oscColor = ift > CENTER_LEVEL ? bullColorInput : bearColorInput

fillTopColor    = ift > CENTER_LEVEL ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_CENTER_TRANSP)
fillBottomColor = ift > CENTER_LEVEL ? color.new(bullColorInput, FILL_CENTER_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

oscPlotId    = plot(ift, "Inverse Fisher Transform", oscColor, 2)
centerPlotId = plot(CENTER_LEVEL, "Center", editable = false, display = display.none)

fill(oscPlotId, centerPlotId
  , math.max(ift, CENTER_LEVEL)
  , math.min(ift, CENTER_LEVEL)
  , gradientFillInput ? fillTopColor : na
  , gradientFillInput ? fillBottomColor : na)

hline(upperInput, "Upper Threshold", levelsColorInput, hline.style_dashed)
hline(lowerInput, "Lower Threshold", levelsColorInput, hline.style_dashed)
hline(CENTER_LEVEL, "Zero Line", color.new(levelsColorInput, 50), hline.style_dotted)
hline(UPPER_RAIL, "Upper Rail", color.new(levelsColorInput, 50), hline.style_dotted)
hline(LOWER_RAIL, "Lower Rail", color.new(levelsColorInput, 50), hline.style_dotted)

plotshape(markersInput and bullTriggerEvent ? ift : na, "Bullish Trigger Marker", shape.circle, location.absolute, color = bullColorInput, size = size.tiny)
plotshape(markersInput and bearTriggerEvent ? ift : na, "Bearish Trigger Marker", shape.circle, location.absolute, color = bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullTriggerEvent, "Bullish Trigger", "Inverse Fisher Transform crossed up through the lower threshold on {{ticker}} ({{interval}}), conventional buy trigger")
alertcondition(bearTriggerEvent, "Bearish Trigger", "Inverse Fisher Transform crossed down through the upper threshold on {{ticker}} ({{interval}}), conventional sell/exit trigger")
alertcondition(bullSaturationEvent, "Bullish Saturation", "Inverse Fisher Transform crossed up through the upper threshold on {{ticker}} ({{interval}}), output committed to the +1 rail")
alertcondition(bearSaturationEvent, "Bearish Saturation", "Inverse Fisher Transform crossed down through the lower threshold on {{ticker}} ({{interval}}), output committed to the -1 rail")

//---------------------------------------------------------------------------------------------------------------------}
