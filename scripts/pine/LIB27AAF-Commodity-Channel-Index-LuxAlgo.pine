//@version=6
indicator("Commodity Channel Index", "CCI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SCALING_CONSTANT = 0.015 // Lambert's scaling constant

BULL_COLOR    = #089981 // readings above zero - source above its average
BEAR_COLOR    = #f23645 // readings below zero - source below its average
NEUTRAL_COLOR = #787b86 // exact zero / warm-up readings and the reference levels

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill

//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput     = input.int(20, "Length", minval = 1, group = "Settings", tooltip = "Number of bars used for the moving average and the mean absolute deviation of the source")
srcInput        = input.source(hlc3, "Source", group = "Settings", tooltip = "Price series measured by the CCI, the typical price hlc3 is the classic choice")
upperInput      = input.float(100, "Upper Level", step = 10, group = "Settings", tooltip = "Overbought reference level, +100 classically")
lowerInput      = input.float(-100, "Lower Level", step = 10, group = "Settings", tooltip = "Oversold reference level, -100 classically")

cciColorInput   = input.color(NEUTRAL_COLOR, "CCI Line", group = "Style", tooltip = "Color of the CCI line")
bullColorInput  = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style", tooltip = "Line and fill color while the CCI reads above zero")
bearColorInput  = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style", tooltip = "Line and fill color while the CCI reads below zero")
levelColorInput = input.color(NEUTRAL_COLOR, "Levels", group = "Style", tooltip = "Color of the upper, lower and zero reference lines")

//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
smaValue = ta.sma(srcInput, lengthInput)
madValue = ta.dev(srcInput, lengthInput) // mean absolute deviation about the SMA (Lambert's MD)

cci = madValue == 0 ? 0.0 : (srcInput - smaValue) / (SCALING_CONSTANT * madValue)

crossAboveUpper = ta.crossover(cci, upperInput)
crossBelowLower = ta.crossunder(cci, lowerInput)
zeroLineCross   = ta.cross(cci, 0)

//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish above zero, bearish below, neutral at zero
cciColor = cci > 0 ? bullColorInput : cci < 0 ? bearColorInput : cciColorInput

cciPlotId  = plot(cci, "CCI", cciColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward the zero line, following the line color
fill(cciPlotId, zeroPlotId, math.max(cci, 0), math.min(cci, 0), cci > 0 ? color.new(cciColor, FILL_LINE_TRANSP) : color.new(cciColor, FILL_ZERO_TRANSP), cci > 0 ? color.new(cciColor, FILL_ZERO_TRANSP) : color.new(cciColor, FILL_LINE_TRANSP), title = "CCI Gradient")

hline(upperInput, "Upper Level", levelColorInput, hline.style_dashed)
hline(lowerInput, "Lower Level", levelColorInput, hline.style_dashed)
hline(0, "Zero Line", levelColorInput, hline.style_dotted)

//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossAboveUpper, "Cross Above +100", "CCI crossed above the +100 level")
alertcondition(crossBelowLower, "Cross Below -100", "CCI crossed below the -100 level")
alertcondition(zeroLineCross, "Zero Line Cross", "CCI crossed the zero line")

//----------------------------------------------------------------------------------------------------------------------}
