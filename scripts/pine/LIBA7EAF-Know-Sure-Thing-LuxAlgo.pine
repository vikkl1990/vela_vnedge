//@version=6
indicator("Know Sure Thing", "KST", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
SETTINGS_GROUP = "Settings"
STYLE_GROUP    = "Style"

BULL_COLOR    = #089981 // KST above zero
BEAR_COLOR    = #f23645 // KST below zero
NEUTRAL_COLOR = #787b86 // zero line
ACCENT_COLOR  = #ff9800 // signal line - the one accent

FILL_LINE_TRANSP = 60  // gradient transparency at the KST line
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero line
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
rocLength1Input = input.int(10, "ROC Length #1", minval = 1, group = SETTINGS_GROUP, tooltip = "Lookback of the first (shortest) rate of change.")
rocLength2Input = input.int(15, "ROC Length #2", minval = 1, group = SETTINGS_GROUP, tooltip = "Lookback of the second rate of change.")
rocLength3Input = input.int(20, "ROC Length #3", minval = 1, group = SETTINGS_GROUP, tooltip = "Lookback of the third rate of change.")
rocLength4Input = input.int(30, "ROC Length #4", minval = 1, group = SETTINGS_GROUP, tooltip = "Lookback of the fourth (longest) rate of change.")

smaLength1Input = input.int(10, "SMA Length #1", minval = 1, group = SETTINGS_GROUP, tooltip = "Smoothing length applied to the first rate of change (RCMA #1).")
smaLength2Input = input.int(10, "SMA Length #2", minval = 1, group = SETTINGS_GROUP, tooltip = "Smoothing length applied to the second rate of change (RCMA #2).")
smaLength3Input = input.int(10, "SMA Length #3", minval = 1, group = SETTINGS_GROUP, tooltip = "Smoothing length applied to the third rate of change (RCMA #3).")
smaLength4Input = input.int(15, "SMA Length #4", minval = 1, group = SETTINGS_GROUP, tooltip = "Smoothing length applied to the fourth rate of change (RCMA #4).")

signalLengthInput = input.int(9, "Signal Length", minval = 1, group = SETTINGS_GROUP, tooltip = "Simple moving average length of the signal line.")

bullColorInput   = input.color(BULL_COLOR, "Bullish", inline = "kst", group = STYLE_GROUP, tooltip = "Color of the KST line while above zero.")
bearColorInput   = input.color(BEAR_COLOR, "Bearish", inline = "kst", group = STYLE_GROUP, tooltip = "Color of the KST line while below zero.")
signalColorInput = input.color(ACCENT_COLOR, "Signal", group = STYLE_GROUP, tooltip = "Color of the signal line.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
rcma1 = ta.sma(ta.roc(close, rocLength1Input), smaLength1Input)
rcma2 = ta.sma(ta.roc(close, rocLength2Input), smaLength2Input)
rcma3 = ta.sma(ta.roc(close, rocLength3Input), smaLength3Input)
rcma4 = ta.sma(ta.roc(close, rocLength4Input), smaLength4Input)

kst        = rcma1 + 2 * rcma2 + 3 * rcma3 + 4 * rcma4
signalLine = ta.sma(kst, signalLengthInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
kstColor = kst >= 0 ? bullColorInput : bearColorInput

kstPlotId  = plot(kst, "KST", kstColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)
plot(signalLine, "Signal", signalColorInput)

fill(kstPlotId, zeroPlotId, top_value = kst >= 0 ? kst : 0, bottom_value = kst >= 0 ? 0 : kst, top_color = color.new(kstColor, kst >= 0 ? FILL_LINE_TRANSP : FILL_ZERO_TRANSP), bottom_color = color.new(kstColor, kst >= 0 ? FILL_ZERO_TRANSP : FILL_LINE_TRANSP), title = "KST Gradient")

hline(0, "Zero", color = NEUTRAL_COLOR, linestyle = hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
bullishCross     = ta.crossover(kst, signalLine)
bearishCross     = ta.crossunder(kst, signalLine)
bullishZeroCross = ta.crossover(kst, 0)
bearishZeroCross = ta.crossunder(kst, 0)

alertcondition(bullishCross, "Bullish Cross", "KST crossed above its signal line")
alertcondition(bearishCross, "Bearish Cross", "KST crossed below its signal line")
alertcondition(bullishZeroCross, "Bullish Zero Cross", "KST crossed above zero")
alertcondition(bearishZeroCross, "Bearish Zero Cross", "KST crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
