// Sequence Snap | RSI-Confirmed Reversal Scalper
// Looks for a run of same-direction candles breaking away from a reversal candle,
// then checks RSI agrees before taking the trade. Exit is one fixed stop and one
// fixed reward target, nothing dynamic.
//@version=6

strategy(
     "Sequence Snap | RSI-Confirmed Reversal Scalper",
     overlay = true,
     pyramiding = 0,
     initial_capital = 50000,
     currency = currency.USD,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 20,
     commission_type = strategy.commission.percent,
     commission_value = 0.05,
     slippage = 1,
     margin_long = 5,
     margin_short = 5
)

// ── Inputs: pattern shape ─────────────────────────────────────────────────────
grpSeq = "Pattern Shape"
runLength = input.int(
     5,
     "Candles In The Run",
     options = [2, 3, 4, 5],
     group = grpSeq,
     tooltip = "How many candles in a row must push the same direction after the reversal candle."
)

tolerancePct = input.float(
     0.05,
     "Wobble Allowance (%)",
     step = 0.01,
     group = grpSeq,
     tooltip = "Lets one candle in the run close slightly against the trend and still count. Set to 0 to require a perfectly clean run."
)

// ── Inputs: RSI check ─────────────────────────────────────────────────────────
grpRsi = "Momentum Check"
useRsiFilter = input.bool(true, "Require RSI Agreement", group = grpRsi, tooltip = "The candle pattern alone is just shape — this makes sure real momentum backs it up.")
rsiLen       = input.int(14, "RSI Length", group = grpRsi)
rsiMinLong   = input.int(40, "RSI Floor For Longs", group = grpRsi)
rsiMaxShort  = input.int(60, "RSI Ceiling For Shorts", group = grpRsi)

// ── Inputs: trade management ──────────────────────────────────────────────────
grpTrade = "Trade Management"
takeProfitR = input.string("1.5R", "Reward Target", options = ["0.5R", "1R", "1.5R", "2R"], group = grpTrade)
enableLongTrades  = input.bool(true, "Allow Longs", group = grpTrade)
enableShortTrades = input.bool(false, "Allow Shorts", group = grpTrade)

// ── Inputs: visuals ─────────────────────────────────────────────────────────
grpVis = "Visuals"
showSignal   = input.bool(true, "Show Entry Arrows", group = grpVis)
showSLTP     = input.bool(true, "Show Stop / Target Lines", group = grpVis)
showFlash    = input.bool(true, "Flash Background On Entry", group = grpVis)
showDash     = input.bool(true, "Show Dashboard", group = grpVis)
dashPos      = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grpVis)
dashSize     = input.string("Small", "Dashboard Text Size", options = ["Tiny", "Small", "Normal"], group = grpVis)
colBull      = input.color(#00c176, "Bull Color", group = grpVis)
colBear      = input.color(#ff3b30, "Bear Color", group = grpVis)
colDashBg    = input.color(#161b22, "Panel Background", group = grpVis)
colDashHead  = input.color(#0d1117, "Header Background", group = grpVis)

// ── R multiple lookup ─────────────────────────────────────────────────────────
rrMultiple = switch takeProfitR
    "0.5R" => 0.5
    "1R"   => 1.0
    "1.5R" => 1.5
    "2R"   => 2.0
    => 1.5

// ── State ─────────────────────────────────────────────────────────────────────
var float stopLossPrice   = na
var float takeProfitPrice = na
var float stopDisplay     = na
var float tpDisplay       = na

// ── RSI ───────────────────────────────────────────────────────────────────────
rsiVal     = ta.rsi(close, rsiLen)
rsiRising  = rsiVal > rsiVal[1]
rsiFalling = rsiVal < rsiVal[1]

rsiOkLong  = not useRsiFilter or (rsiVal > rsiMinLong and rsiRising)
rsiOkShort = not useRsiFilter or (rsiVal < rsiMaxShort and rsiFalling)

// ── Reversal candle: the one the run breaks away from ────────────────────────
reversalWasDown = close[runLength] < open[runLength]
reversalWasUp   = close[runLength] > open[runLength]

// ── Check the run holds together, bullish direction ──────────────────────────
bool runIsBullish = true

for i = 0 to runLength - 1
    if close[i] <= open[i]
        runIsBullish := false
    if low[i] <= low[runLength]
        runIsBullish := false
    if i < runLength - 1
        floorClose = close[i + 1] * (1 - tolerancePct / 100)
        if close[i] <= floorClose
            runIsBullish := false

// ── Check the run holds together, bearish direction ───────────────────────────
bool runIsBearish = true

for i = 0 to runLength - 1
    if close[i] >= open[i]
        runIsBearish := false
    if high[i] >= high[runLength]
        runIsBearish := false
    if i < runLength - 1
        ceilClose = close[i + 1] * (1 + tolerancePct / 100)
        if close[i] >= ceilClose
            runIsBearish := false

// ── Combine pattern + momentum check ──────────────────────────────────────────
longSetup  = reversalWasDown and runIsBullish and rsiOkLong
shortSetup = reversalWasUp and runIsBearish and rsiOkShort

// ── Long entry ────────────────────────────────────────────────────────────────
if enableLongTrades and longSetup and strategy.position_size == 0
    stopLossPrice := low[runLength]
    riskPts = close - stopLossPrice
    takeProfitPrice := close + riskPts * rrMultiple
    strategy.entry("Long", strategy.long)

// ── Short entry ───────────────────────────────────────────────────────────────
if enableShortTrades and shortSetup and strategy.position_size == 0
    stopLossPrice := high[runLength]
    riskPts = stopLossPrice - close
    takeProfitPrice := close - riskPts * rrMultiple
    strategy.entry("Short", strategy.short)

// ── Exits: one stop, one target, done ─────────────────────────────────────────
if not na(stopLossPrice) and strategy.position_size > 0
    strategy.exit("Long Exit", from_entry = "Long", stop = stopLossPrice, limit = takeProfitPrice)

if not na(stopLossPrice) and strategy.position_size < 0
    strategy.exit("Short Exit", from_entry = "Short", stop = stopLossPrice, limit = takeProfitPrice)

// ── Track lines only while a trade is open ────────────────────────────────────
if strategy.position_size == 0
    stopDisplay := na
    tpDisplay := na
else
    stopDisplay := stopLossPrice
    tpDisplay := takeProfitPrice

// ── Entry flash ───────────────────────────────────────────────────────────────
bgcolor(showFlash and longSetup and enableLongTrades ? color.new(colBull, 85) : na, title = "Long Entry Flash")
bgcolor(showFlash and shortSetup and enableShortTrades ? color.new(colBear, 85) : na, title = "Short Entry Flash")

// ── Signal arrows ─────────────────────────────────────────────────────────────
plotshape(
     showSignal and enableLongTrades and longSetup and strategy.position_size == 0,
     title = "Long Signal", location = location.belowbar, color = colBull, style = shape.triangleup, size = size.small
)

plotshape(
     showSignal and enableShortTrades and shortSetup and strategy.position_size == 0,
     title = "Short Signal", location = location.abovebar, color = colBear, style = shape.triangledown, size = size.small
)

plot(showSLTP ? stopDisplay : na, "Stop Loss", color = colBear, linewidth = 2, style = plot.style_linebr)
plot(showSLTP ? tpDisplay : na, "Take Profit", color = colBull, linewidth = 2, style = plot.style_linebr)

// ── Dashboard ─────────────────────────────────────────────────────────────────
f_dashPos(p) =>
    switch p
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        => position.bottom_left

f_dashSize(sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        => size.normal

var table dash = table.new(f_dashPos(dashPos), 2, 8, border_width = 1, border_color = color.new(colBull, 60))

if showDash and barstate.islast

    dSize = f_dashSize(dashSize)
    dbg = color.new(colDashBg, 0)
    hdr = color.new(colDashHead, 0)
    muted = color.new(#8b949e, 0)

    posText  = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? colBull : strategy.position_size < 0 ? colBear : muted

    rsiColor = rsiVal > rsiMinLong ? colBull : rsiVal < rsiMaxShort ? colBear : muted

    table.cell(dash, 0, 0, "Sequence Snap", text_color = color.white, text_size = dSize, bgcolor = hdr, text_halign = text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker, text_color = muted, text_size = dSize, bgcolor = hdr, text_halign = text.align_right)

    table.cell(dash, 0, 1, "Position", text_color = muted, text_size = dSize, bgcolor = dbg)
    table.cell(dash, 1, 1, posText, text_color = posColor, text_size = dSize, bgcolor = dbg, text_halign = text.align_right)

    table.cell(dash, 0, 2, "RSI", text_color = muted, text_size = dSize, bgcolor = dbg)
    table.cell(dash, 1, 2, str.tostring(rsiVal, "#.#"), text_color = rsiColor, text_size = dSize, bgcolor = dbg, text_halign = text.align_right)

    table.cell(dash, 0, 3, "Run Length", text_color = muted, text_size = dSize, bgcolor = dbg)
    table.cell(dash, 1, 3, str.tostring(runLength) + " candles", text_color = color.white, text_size = dSize, bgcolor = dbg, text_halign = text.align_right)

    table.cell(dash, 0, 4, "Wobble Allowance", text_color = muted, text_size = dSize, bgcolor = dbg)
    table.cell(dash, 1, 4, str.tostring(tolerancePct, "#.##") + "%", text_color = color.white, text_size = dSize, bgcolor = dbg, text_halign = text.align_right)

    table.cell(dash, 0, 5, "RSI Filter", text_color = muted, text_size = dSize, bgcolor = dbg)
    table.cell(dash, 1, 5, useRsiFilter ? "ON" : "OFF", text_color = useRsiFilter ? colBull : muted, text_size = dSize, bgcolor = dbg, text_halign = text.align_right)

    table.cell(dash, 0, 6, "Longs / Shorts", text_color = muted, text_size = dSize, bgcolor = dbg)
    sideText = (enableLongTrades ? "ON" : "OFF") + " / " + (enableShortTrades ? "ON" : "OFF")
    table.cell(dash, 1, 6, sideText, text_color = color.white, text_size = dSize, bgcolor = dbg, text_halign = text.align_right)

    table.cell(dash, 0, 7, "Target", text_color = muted, text_size = dSize, bgcolor = dbg)
    table.cell(dash, 1, 7, takeProfitR, text_color = color.white, text_size = dSize, bgcolor = dbg, text_halign = text.align_right)