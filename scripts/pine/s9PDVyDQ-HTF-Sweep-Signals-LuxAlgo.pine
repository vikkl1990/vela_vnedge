//@version=6
indicator("HTF Sweep Signals", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- Group Name ---
// Inputs
tfInput = input.timeframe("240", title = "Higher Timeframe", tooltip = "The timeframe to calculate the sweep signals on.")
trendSignalsInput = input.bool(false, title = "Trend Signals", tooltip = "If enabled, bullish signals only print if the previous HTF candle was bullish (close > open), and bearish signals only print if the previous HTF candle was bearish (close < open).")

// --- Group Name ---
// Style Settings
bullColorInput = input.color(#089981, "Bullish Color", group = "Style")
bearColorInput = input.color(#f23645, "Bearish Color", group = "Style")

// --- Group Name ---
// Core Logic

// @function Formats a timeframe string to display in Hours (H) if applicable
f_format_tf(tf) =>
    tf_num = str.tonumber(tf)
    if not na(tf_num)
        if tf_num >= 60 and tf_num % 60 == 0
            str.tostring(tf_num / 60) + "H"
        else
            str.tostring(tf_num) + "m"
    else
        tf

// @function Calculates the sweep signals and returns the HTF bar data needed for the box
// @returns A tuple with boolean values for bullish/bearish signals, and bar bounds (time, time_close, high, low, open)
f_data(trendSignals) =>
    prevBull = close[1] > open[1]
    prevBear = close[1] < open[1]
    
    bull = low < low[1] and close > close[1] and (not trendSignals or prevBull)
    bear = high > high[1] and close < close[1] and (not trendSignals or prevBear)
    
    // Return the previous closed bar's data to be used safely with lookahead
    [bull[1], bear[1], time[1], time_close[1], high[1], low[1], open[1]]

// Fetch the signals and data from the higher timeframe using the standard non-repainting lookahead approach
[bullHTF, bearHTF, t_open, t_close, hHTF, lHTF, oHTF] = request.security(syminfo.tickerid, tfInput, f_data(trendSignalsInput), lookahead = barmerge.lookahead_on)

// Check if a new higher timeframe bar has started
isNewHTF = ta.change(time(tfInput)) != 0

// --- Visual Elements ---
// Calculate if the current chart timeframe is lower than the input HTF
isLTF = timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(tfInput)

// For HTF chart plotting, calculate signals directly to avoid 1-bar delay
[localBull, localBear, _, _, _, _, _] = f_data(trendSignalsInput)
bullPlot = isLTF ? (bullHTF and isNewHTF) : localBull
bearPlot = isLTF ? (bearHTF and isNewHTF) : localBear

// Arrows for signals
plotshape(bullPlot, "Bullish Sweep", shape.triangleup, location.belowbar, color.new(bullColorInput, 0), size = size.small)
plotshape(bearPlot, "Bearish Sweep", shape.triangledown, location.abovebar, color.new(bearColorInput, 0), size = size.small)

if isNewHTF and isLTF
    labelText = f_format_tf(tfInput) + " Open"
    
    if bullHTF
        box.new(t_open, hHTF, t_close, lHTF, xloc = xloc.bar_time, border_color = color.new(bullColorInput, 0), border_style = line.style_dashed, bgcolor = color.new(bullColorInput, 90))
        line.new(t_open, oHTF, t_close, oHTF, xloc = xloc.bar_time, color = color.new(bullColorInput, 0), style = line.style_solid, width = 2)
        label.new(t_close, oHTF, labelText, xloc = xloc.bar_time, color = #00000000, style = label.style_label_left, textcolor = bullColorInput, size = size.small)
        
    if bearHTF
        box.new(t_open, hHTF, t_close, lHTF, xloc = xloc.bar_time, border_color = color.new(bearColorInput, 0), border_style = line.style_dashed, bgcolor = color.new(bearColorInput, 90))
        line.new(t_open, oHTF, t_close, oHTF, xloc = xloc.bar_time, color = color.new(bearColorInput, 0), style = line.style_solid, width = 2)
        label.new(t_close, oHTF, labelText, xloc = xloc.bar_time, color = #00000000, style = label.style_label_left, textcolor = bearColorInput, size = size.small)
