//@version=6
indicator("NY Macro Status", overlay = true, max_lines_count = 500)

tz       = "America/New_York"
showNext = input.bool(true, "Show next macro when idle")
showNow  = input.bool(true, "Show current time")
txtSize  = input.string("large", "Text size", options = ["small", "normal", "large", "huge"])
onCol    = input.color(color.rgb(0, 200, 100), "Active color")
offCol   = input.color(color.rgb(225, 225, 225), "Idle color")
txtCol   = input.color(color.black, "Text color")
brdCol   = input.color(color.black, "Border color")

gV = "Vertical lines"
showV   = input.bool(false, "Show vertical lines", group = gV)
vEnd    = input.bool(true, "Also mark macro end", group = gV)
vCol    = input.color(color.new(color.gray, 30), "Start line color", group = gV)
vColEnd = input.color(color.new(color.gray, 60), "End line color", group = gV)
vStyle  = input.string("dashed", "Style", options = ["solid", "dashed", "dotted"], group = gV)
vWidth  = input.int(1, "Width", minval = 1, maxval = 4, group = gV)
vDays   = input.int(3, "Keep last N days", minval = 1, maxval = 20, group = gV)

g1 = "Macro 1"
on1 = input.bool(true, "Enabled", group = g1)
n1  = input.string("NY AM 1", "Name", group = g1)
a1  = input.string("8:50 AM", "Start", group = g1)
b1  = input.string("9:10 AM", "End", group = g1)

g2 = "Macro 2"
on2 = input.bool(true, "Enabled", group = g2)
n2  = input.string("NY AM 2", "Name", group = g2)
a2  = input.string("9:50 AM", "Start", group = g2)
b2  = input.string("10:10 AM", "End", group = g2)

g3 = "Macro 3"
on3 = input.bool(true, "Enabled", group = g3)
n3  = input.string("NY AM 3", "Name", group = g3)
a3  = input.string("10:50 AM", "Start", group = g3)
b3  = input.string("11:10 AM", "End", group = g3)

g4 = "Macro 4"
on4 = input.bool(true, "Enabled", group = g4)
n4  = input.string("Lunch", "Name", group = g4)
a4  = input.string("11:50 AM", "Start", group = g4)
b4  = input.string("12:10 PM", "End", group = g4)

g5 = "Macro 5"
on5 = input.bool(true, "Enabled", group = g5)
n5  = input.string("Early PM", "Name", group = g5)
a5  = input.string("12:50 PM", "Start", group = g5)
b5  = input.string("1:10 PM", "End", group = g5)

g6 = "Macro 6"
on6 = input.bool(true, "Enabled", group = g6)
n6  = input.string("PM", "Name", group = g6)
a6  = input.string("1:10 PM", "Start", group = g6)
b6  = input.string("1:40 PM", "End", group = g6)

g7 = "Macro 7"
on7 = input.bool(true, "Enabled", group = g7)
n7  = input.string("Last Hour", "Name", group = g7)
a7  = input.string("3:15 PM", "Start", group = g7)
b7  = input.string("3:45 PM", "End", group = g7)

g8 = "Macro 8"
on8 = input.bool(false, "Enabled", group = g8)
n8  = input.string("Close", "Name", group = g8)
a8  = input.string("3:50 PM", "Start", group = g8)
b8  = input.string("4:10 PM", "End", group = g8)

// ── helpers ───────────────────────────────────────────────────────────────────
f_parse(string raw) =>
    string s = str.upper(str.replace_all(raw, " ", ""))
    bool pm = str.contains(s, "PM")
    bool am = str.contains(s, "AM")
    s := str.replace_all(s, "PM", "")
    s := str.replace_all(s, "AM", "")
    parts = str.split(s, ":")
    float hf = str.tonumber(array.get(parts, 0))
    float mf = array.size(parts) > 1 ? str.tonumber(array.get(parts, 1)) : 0.0
    int out = na
    if not na(hf) and not na(mf)
        int h = int(hf)
        int m = int(mf)
        if pm and h < 12
            h := h + 12
        if am and h == 12
            h := 0
        if not pm and not am and h < 8
            h := h + 12
        out := h * 60 + m
    out

f_12h(int m) =>
    int h   = math.floor(m / 60)
    int mm  = m % 60
    int h12 = h % 12 == 0 ? 12 : h % 12
    str.tostring(h12) + ":" + str.tostring(mm, "00") + (h >= 12 ? " PM" : " AM")

f_dur(int m) =>
    m >= 60 ? str.tostring(math.floor(m / 60)) + "h " + str.tostring(m % 60) + "m" : str.tostring(m) + " min"

f_add(bool on, string nm, string a, string b, int[] st, int[] en, string[] nms) =>
    if on
        int s = f_parse(a)
        int e = f_parse(b)
        if not na(s) and not na(e)
            array.push(st, s)
            array.push(en, e)
            array.push(nms, nm)

tsz = txtSize == "small" ? size.small : txtSize == "normal" ? size.normal : txtSize == "large" ? size.large : size.huge
vst = vStyle == "solid" ? line.style_solid : vStyle == "dashed" ? line.style_dashed : line.style_dotted

var starts = array.new_int()
var ends   = array.new_int()
var names  = array.new_string()
if barstate.isfirst
    f_add(on1, n1, a1, b1, starts, ends, names)
    f_add(on2, n2, a2, b2, starts, ends, names)
    f_add(on3, n3, a3, b3, starts, ends, names)
    f_add(on4, n4, a4, b4, starts, ends, names)
    f_add(on5, n5, a5, b5, starts, ends, names)
    f_add(on6, n6, a6, b6, starts, ends, names)
    f_add(on7, n7, a7, b7, starts, ends, names)
    f_add(on8, n8, a8, b8, starts, ends, names)

nMac = array.size(starts)

// ── vertical lines ────────────────────────────────────────────────────────────
var vlines = array.new_line()
barMin  = hour(time, tz) * 60 + minute(time, tz)
prevMin = nz(barMin[1], -1)

f_vline(color c) =>
    ln = line.new(bar_index, low, bar_index, high, extend = extend.both, color = c, style = vst, width = vWidth)
    array.push(vlines, ln)
    if array.size(vlines) > vDays * nMac * 2
        line.delete(array.shift(vlines))

if showV and nMac > 0 and dayofweek(time, tz) != dayofweek.saturday and dayofweek(time, tz) != dayofweek.sunday
    for i = 0 to nMac - 1
        s = array.get(starts, i)
        e = array.get(ends, i)
        hitS = barMin >= s and (prevMin < s or prevMin > barMin)
        hitE = barMin >= e and (prevMin < e or prevMin > barMin)
        if hitS
            f_vline(vCol)
        if vEnd and hitE
            f_vline(vColEnd)

// ── corner status ─────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 3, frame_color = brdCol, frame_width = 2, border_width = 0)

f_row(int r, string l, string v, color bg) =>
    table.cell(t, 0, r, l, text_color = txtCol, bgcolor = bg, text_size = tsz, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = txtCol, bgcolor = bg, text_size = tsz, text_halign = text.align_right)

if barstate.islast
    nowMin = hour(timenow, tz) * 60 + minute(timenow, tz)
    bool active = false
    int aS = na
    int aE = na
    string aN = ""
    int nextS = na
    string nextN = ""
    if nMac > 0
        for i = 0 to nMac - 1
            s = array.get(starts, i)
            e = array.get(ends, i)
            if nowMin >= s and nowMin < e
                active := true
                aS := s
                aE := e
                aN := array.get(names, i)
            if s > nowMin and (na(nextS) or s < nextS)
                nextS := s
                nextN := array.get(names, i)

    table.clear(t, 0, 0, 1, 2)
    int r = 0
    if active
        f_row(r, "MACRO", aN, onCol)
        r += 1
        f_row(r, "Ends", f_12h(aE) + "   (" + f_dur(aE - nowMin) + ")", onCol)
        r += 1
        if showNow
            f_row(r, "Now", f_12h(nowMin), onCol)
    else if showNext and not na(nextS)
        f_row(r, "Next", nextN, offCol)
        r += 1
        f_row(r, "Starts", f_12h(nextS) + "   (" + f_dur(nextS - nowMin) + ")", offCol)
        r += 1
        if showNow
            f_row(r, "Now", f_12h(nowMin), offCol)