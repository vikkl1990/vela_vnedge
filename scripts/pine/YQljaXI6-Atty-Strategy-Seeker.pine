bool showHind = input.bool(true, "Stamp the hindsight warning on drawn trades", group = gP, tooltip = "The selected row's trades are on the chart BECAUSE they won. Leave this on.")

// ───────────────────────────────────────────────────────────────────────────────
// 5 · PANE
