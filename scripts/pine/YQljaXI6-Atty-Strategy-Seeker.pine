string gD = "5 · Pane"
bool showWF = input.bool(true, "Walk-forward basket (the honest curve)", group = gD)
bool showOOS = input.bool(true, "Frozen holdout basket", group = gD)
bool showChamp = input.bool(true, "Champion #1, fitted", group = gD)
bool showSel = input.bool(false, "Selected row, fitted", group = gD)
bool showBH = input.bool(true, "Buy and hold", group = gD)
string benchSym = input.symbol("SP:SPX", "Buy-and-hold benchmark", group = gD, tooltip = "Defaults to the cash index rather than the chart symbol. A back-adjusted continuous futures series has correct price DIFFERENCES but distorted RATIOS, so a percent return taken off it is wrong. The cash index has no such problem.")
string equityMode = input.string("Percent", "Pane units", options = ["Percent", "Dollars"], group = gD, tooltip = "Dollars restates every curve as an account starting at the balance below. Each leg is shown as if that leg alone had the whole balance; the basket splits the same balance equally across the legs, which is what makes their drawdowns comparable.")
float startBal = input.float(100000, "Starting balance", minval = 100, step = 1000, group = gD)
bool showLegs = input.bool(true, "Draw each basket leg separately", group = gD)
