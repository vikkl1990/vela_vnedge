string gP = "4 · Chart"
int pick = input.int(1, "Leaderboard row to put on the chart", minval = 1, maxval = 10, group = gP)
bool showLive = input.bool(true, "Draw the selected row's trades and open position", group = gP)
int drawTr = input.int(30, "Draw its last N trades", minval = 5, maxval = 120, group = gP)
bool showPos = input.bool(true, "Shade exposure", group = gP)
string follow = input.string("Top-K basket", "Shading follows", options = ["Top-K basket", "Selected row"], group = gP)
