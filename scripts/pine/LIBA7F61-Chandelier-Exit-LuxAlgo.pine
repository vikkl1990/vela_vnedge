//@version=6
indicator("Chandelier Exit", "CE", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(22, "Length", minval = 1, group = "Settings", tooltip = "Lookback used for both the highest high / lowest low extremes and the ATR.")

multInput = input.float(3.0, "ATR Multiplier", minval = 0, step = 0.1, group = "Settings", tooltip = "Multiple of ATR subtracted from the highest high (long stop) and added to the lowest low (short stop).")

ratchetInput = input.bool(false, "Ratchet Stops", group = "Settings", tooltip = "Prevents the long stop from falling and the short stop from rising, resetting once close crosses through the stop.")

longColorInput = input.color(#089981, "Long Stop", group = "Style", tooltip = "Color of the long trailing stop line.")

shortColorInput = input.color(#f23645, "Short Stop", group = "Style", tooltip = "Color of the short trailing stop line.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
atrValue = multInput * ta.atr(lengthInput)

longStopBasic = ta.highest(high, lengthInput) - atrValue
shortStopBasic = ta.lowest(low, lengthInput) + atrValue

var float longStopRatchet = na
var float shortStopRatchet = na

longStopPrev = nz(longStopRatchet[1], longStopBasic)
longStopRatchet := nz(close[1], close) > longStopPrev ? math.max(longStopBasic, longStopPrev) : longStopBasic

shortStopPrev = nz(shortStopRatchet[1], shortStopBasic)
shortStopRatchet := nz(close[1], close) < shortStopPrev ? math.min(shortStopBasic, shortStopPrev) : shortStopBasic

longStop = ratchetInput ? longStopRatchet : longStopBasic
shortStop = ratchetInput ? shortStopRatchet : shortStopBasic
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(longStop, "Long Stop", longColorInput)
plot(shortStop, "Short Stop", shortColorInput)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
exitLong = ta.crossunder(close, longStop)
exitShort = ta.crossover(close, shortStop)

alertcondition(exitLong, "Exit Long", "Close crossed below the Chandelier Exit long stop")
alertcondition(exitShort, "Exit Short", "Close crossed above the Chandelier Exit short stop")
//----------------------------------------------------------------------------------------------------------------------}
