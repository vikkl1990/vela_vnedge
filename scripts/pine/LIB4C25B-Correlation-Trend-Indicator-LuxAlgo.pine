//@version=6
indicator("Correlation Trend Indicator"
  , shorttitle = "Correlation Trend Indicator"
  , overlay    = false
  , format     = format.price
  , precision  = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

float UPPER_BOUND = 1.0  // Hard upper bound of the Pearson correlation
float LOWER_BOUND = -1.0 // Hard lower bound of the Pearson correlation

int MAX_LOOKBACK = 500

int FULL_TRANSP   = 100
int HALF_TRANSP   = 50
int REGIME_TRANSP = 92

string GROUP_CTI   = "Correlation Trend"
string GROUP_STYLE = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

lengthInput = input.int(20, "Length"
  , minval  = 2
  , maxval  = MAX_LOOKBACK
  , group   = GROUP_CTI
  , tooltip = "Lookback window (n), in bars, over which the source is correlated against an ideal straight rising line. The window sets the trend scale being measured; half the period of interest is a common choice, and different lookbacks routinely disagree because they measure different swings.")

sourceInput = input.source(close, "Source"
  , group   = GROUP_CTI
  , tooltip = "Series measured against the ideal rising line, usually the close.")

thresholdInput = input.float(0.5, "Trend Threshold"
  , minval  = 0.0
  , maxval  = 1.0
  , step    = 0.05
  , group   = GROUP_CTI
  , tooltip = "Magnitude treated as a meaningful trend within the window. Readings above it flag a bullish trend regime, readings below its negative mirror a bearish one, and readings in between a trendless window. A common convention is around 0.5.")

regimeBgInput = input.bool(true, "Regime Background"
  , group   = GROUP_STYLE
  , tooltip = "Tints the pane background while the reading holds beyond the trend threshold, marking the stretches where a trend-following playbook applies.")

showCrossMarkersInput = input.bool(false, "Zero Cross Markers"
  , group   = GROUP_STYLE
  , tooltip = "Shows circles on the zero line when the reading changes sign. The alerts cover these events even when markers are hidden.")

bullColorInput = input.color(#089981, "Bullish Color", group = GROUP_STYLE)

bearColorInput = input.color(#f23645, "Bearish Color", group = GROUP_STYLE)

levelsColorInput = input.color(#787b86, "Levels Color", group = GROUP_STYLE)

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{

max_bars_back(sourceInput, MAX_LOOKBACK)

// Pearson correlation between the source and an ideal straight rising line over the
// lookback. The line value paired with offset i is y = -i, so the line rises as bars
// get more recent and a steadily rising market yields a positive reading.
float sumX  = 0.0 // Sx  = SUM C[t-i]
float sumY  = 0.0 // Sy  = SUM y_i
float sumXX = 0.0 // Sxx = SUM C[t-i]^2
float sumYY = 0.0 // Syy = SUM y_i^2
float sumXY = 0.0 // Sxy = SUM C[t-i] * y_i

for i = 0 to lengthInput - 1
    float x = sourceInput[i]
    float y = -i
    sumX  += x
    sumY  += y
    sumXX += x * x
    sumYY += y * y
    sumXY += x * y

// CTI = (n*Sxy - Sx*Sy) / sqrt((n*Sxx - Sx^2) * (n*Syy - Sy^2))
float covXY = lengthInput * sumXY - sumX * sumY
float varX  = lengthInput * sumXX - sumX * sumX
float varY  = lengthInput * sumYY - sumY * sumY

// Clamped for floating-point safety. A perfectly flat window has no defined
// correlation and is scored as 0 — no linear drift worth the name.
float cti = na
if not na(covXY)
    cti := varX > 0 and varY > 0 ? math.max(LOWER_BOUND, math.min(UPPER_BOUND, covXY / math.sqrt(varX * varY))) : 0.0

// Trend regime versus the threshold band — the regime gate
int regime = cti > thresholdInput ? 1 : cti < -thresholdInput ? -1 : 0

bool bullRegimeStart = regime == 1 and nz(regime[1]) != 1
bool bearRegimeStart = regime == -1 and nz(regime[1]) != -1
bool regimeEnd       = regime == 0 and nz(regime[1]) != 0

// Zero-line crossings — trend-change confirmation, lagging the turn by a fraction of the window
bool bullCross = ta.crossover(cti, 0)
bool bearCross = ta.crossunder(cti, 0)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{

color ctiColor = cti > 0 ? bullColorInput : bearColorInput

ctiPlotId  = plot(cti, "Correlation Trend", ctiColor, 1)
zeroPlotId = plot(0, "Zero Anchor", editable = false, display = display.none)

fill(ctiPlotId, zeroPlotId
  , top_value    = math.max(cti, 0)
  , bottom_value = math.min(cti, 0)
  , top_color    = cti > 0 ? color.new(bullColorInput, HALF_TRANSP) : color.new(bearColorInput, FULL_TRANSP)
  , bottom_color = cti > 0 ? color.new(bullColorInput, FULL_TRANSP) : color.new(bearColorInput, HALF_TRANSP)
  , title        = "Gradient Fill")

hline(UPPER_BOUND, "Upper Bound", levelsColorInput, hline.style_dotted)
hline(thresholdInput, "Upper Threshold", levelsColorInput, hline.style_dashed)
hline(0, "Zero Line", levelsColorInput, hline.style_dotted)
hline(-thresholdInput, "Lower Threshold", levelsColorInput, hline.style_dashed)
hline(LOWER_BOUND, "Lower Bound", levelsColorInput, hline.style_dotted)

plot(showCrossMarkersInput and bullCross ? 0.0 : na, "Bullish Zero Cross", bullColorInput, 3, plot.style_circles)
plot(showCrossMarkersInput and bearCross ? 0.0 : na, "Bearish Zero Cross", bearColorInput, 3, plot.style_circles)

bgcolor(regimeBgInput and regime != 0 ? color.new(regime == 1 ? bullColorInput : bearColorInput, REGIME_TRANSP) : color(na)
  , title = "Trend Regime Background")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(bullRegimeStart, "Bullish Trend Regime", "Correlation Trend Indicator rose above the trend threshold on {{ticker}} ({{interval}})")
alertcondition(bearRegimeStart, "Bearish Trend Regime", "Correlation Trend Indicator fell below the negative trend threshold on {{ticker}} ({{interval}})")
alertcondition(regimeEnd, "Trendless Regime", "Correlation Trend Indicator returned inside the threshold band on {{ticker}} ({{interval}})")
alertcondition(bullCross, "Bullish Zero Cross", "Correlation Trend Indicator crossed above zero on {{ticker}} ({{interval}})")
alertcondition(bearCross, "Bearish Zero Cross", "Correlation Trend Indicator crossed below zero on {{ticker}} ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
