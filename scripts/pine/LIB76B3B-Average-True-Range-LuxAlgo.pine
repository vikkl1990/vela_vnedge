//@version=6
indicator("Average True Range", "ATR", overlay = false, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR = #787b86 // contracting or flat volatility
ACCENT_COLOR  = #ff9800 // expanding volatility - the reading to look at
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 1, group = "Settings", tooltip = "Number of bars used to average the true range.")

smoothingInput = input.string("RMA", "Smoothing", options = ["RMA", "SMA", "EMA", "WMA"], group = "Settings", tooltip = "Moving average applied to the true range. RMA is Wilder's original smoothing used by the classic ATR.")

atrColorInput    = input.color(NEUTRAL_COLOR, "ATR Line", group = "Style", tooltip = "Color of the ATR line while volatility contracts or holds flat.")
expandColorInput = input.color(ACCENT_COLOR, "Expanding", group = "Style", tooltip = "Color of the ATR line while it rises - volatility expanding bar to bar.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
trueRange = ta.tr(true)

atrRma = ta.rma(trueRange, lengthInput)
atrSma = ta.sma(trueRange, lengthInput)
atrEma = ta.ema(trueRange, lengthInput)
atrWma = ta.wma(trueRange, lengthInput)

atr = switch smoothingInput
    "RMA" => atrRma
    "SMA" => atrSma
    "EMA" => atrEma
    "WMA" => atrWma
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// Slope coloring - rising ATR is expanding volatility, the state worth noticing
atrColor = atr > atr[1] ? expandColorInput : atrColorInput

atrPlotId  = plot(atr, "ATR", atrColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

fill(atrPlotId, zeroPlotId, top_value = atr, bottom_value = 0, top_color = color.new(atrColor, 75), bottom_color = color.new(atrColor, 100), title = "ATR Gradient")
//----------------------------------------------------------------------------------------------------------------------}
