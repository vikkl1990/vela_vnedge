//@version=6
indicator("ATR Risk & Position Sizer", overlay=true)

// ============================================================
// INPUTS
// ============================================================
grpTable = "Table Settings"
tablePos  = input.string("Top Right", "Table Position",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpTable)
textSize  = input.string("Normal", "Text Size", options=["Small", "Normal", "Large"], group=grpTable)

grpRisk = "Risk Settings"
riskAmount = input.float(500, "Max Risk Amount ($)", minval=1, step=50, group=grpRisk)
atrLength  = input.int(14, "ATR Length", minval=1, group=grpRisk)
atrMult    = input.float(1.0, "ATR Multiplier (Stop Distance)", minval=0.1, step=0.1, group=grpRisk,
     tooltip="Stop Loss Distance = ATR x this multiplier. This is what makes the stop (and position size) dynamic with volatility.")
baseSize   = input.int(1, "Base Size (Contract Increment)", minval=1, group=grpRisk,
     tooltip="Allowed contracts will always be a multiple of this number, rounded down to stay within your configured risk. Set to 1 to allow any whole number, 2 for even numbers only, etc.")

grpContract = "Contract Settings"
contractSel = input.string("Mini", "Contract Type", options=["Mini", "Micro"], group=grpContract,
     tooltip="The traded asset is auto-detected from the chart. This only controls which contract size (Mini/Micro) is used for the dollar-per-point value.")

grpVol = "Volatility Check"
shortTolerancePct = input.float(80.0, "Bar Range Spike Tolerance (%)", minval=0.1, step=0.5, group=grpVol,
     tooltip="How far a single bar's true range can exceed current ATR before it's flagged red (a sudden expansion). While red, sizing uses (bar range + current ATR) / 2 instead of current ATR - i.e. only half of the amount by which the bar exceeded ATR. Every bar that still exceeds this threshold resets the downgrade countdown, but only the highest such value seen during the episode is retained and used for sizing - it never decreases until the state clears. Yellow triggers at half this value, and now applies the same adjustment (also using its own retained peak), just less aggressively since its threshold is lower.")
downgradeBars = input.int(3, "Downgrade Confirmation (bars)", minval=0, group=grpVol,
     tooltip="Escalating to a more severe state (green->yellow->red) always happens instantly. Dropping back to a calmer state only happens after it has held for this many consecutive bars, to avoid flicker right at the threshold. Any bar that still exceeds the current state's threshold resets this countdown back to zero - only a sustained calm-down counts. While the countdown is running, sizing keeps using the highest (bar range + current ATR) / 2 value recorded during the episode, not the live ATR. Set to 0 for instant, symmetric switching.")
adjustSizing = input.bool(true, "Adjust Contract Size on Yellow/Red", group=grpVol,
     tooltip="When enabled, Contracts Allowed / Stop Loss Distance / Max Risk are recalculated using the elevated (bar range + current ATR) / 2 value while yellow or red is active. When disabled, sizing always uses the normal ATR - yellow and red only show as a color warning in the table, with no effect on the numbers.")

grpTier = "Tiered Sizing"
tieredEnabled = input.bool(false, "Enable Tiered Sizing", group=grpTier,
     tooltip="Shows Contracts Allowed and Max Risk as three grades (C/B/A) computed from the risk allocations below, instead of a single value.")
gradeAPct = input.float(100.0, "Grade A Risk Allocation (%)", minval=0.1, step=5, group=grpTier)
gradeBPct = input.float(60.0, "Grade B Risk Allocation (%)", minval=0.1, step=5, group=grpTier)
gradeCPct = input.float(30.0, "Grade C Risk Allocation (%)", minval=0.1, step=5, group=grpTier)

// ============================================================
// ASSET AUTO-DETECTION
// ============================================================
// Root symbol is used so both dated contracts (ESZ2025) and continuous
// contracts (ES1!) resolve the same way. Falls back to the ticker if root is empty.
t = syminfo.root != "" ? syminfo.root : syminfo.ticker

detectAsset(_t) =>
    float _tick  = na
    float _mini  = na
    float _micro = na
    string _name = ""
    bool _found  = false

    if str.contains(_t, "MES") or str.contains(_t, "ES")
        _name := "ES"
        _tick := 0.25
        _mini := 50.0
        _micro := 5.0
        _found := true
    else if str.contains(_t, "MNQ") or str.contains(_t, "NQ")
        _name := "NQ"
        _tick := 0.25
        _mini := 20.0
        _micro := 2.0
        _found := true
    else if str.contains(_t, "MYM") or str.contains(_t, "YM")
        _name := "YM"
        _tick := 1.0
        _mini := 5.0
        _micro := 0.5
        _found := true
    else if str.contains(_t, "M2K") or str.contains(_t, "RTY")
        _name := "RTY"
        _tick := 0.10
        _mini := 50.0
        _micro := 5.0
        _found := true
    else if str.contains(_t, "MGC") or str.contains(_t, "GC") or str.contains(_t, "XAUUSD") or str.contains(_t, "GOLD")
        _name := "GC"
        _tick := 0.10
        _mini := 100.0
        _micro := 10.0
        _found := true
    else if str.contains(_t, "SIL") or str.contains(_t, "SI") or str.contains(_t, "XAGUSD")
        _name := "SI"
        _tick := 0.005
        _mini := 5000.0
        _micro := 1000.0
        _found := true
    else if str.contains(_t, "PL")
        _name := "PL"
        _tick := 0.10
        _mini := 50.0
        _micro := na
        _found := true
    else if str.contains(_t, "MHG") or str.contains(_t, "HG")
        _name := "HG"
        _tick := 0.0005
        _mini := 25000.0
        _micro := 2500.0
        _found := true
    else if str.contains(_t, "MCL") or str.contains(_t, "CL")
        _name := "CL"
        _tick := 0.01
        _mini := 1000.0
        _micro := 100.0
        _found := true
    else if str.contains(_t, "MNG") or str.contains(_t, "NG")
        _name := "NG"
        _tick := 0.001
        _mini := 10000.0
        _micro := 1000.0
        _found := true
    else if str.contains(_t, "HO")
        _name := "HO"
        _tick := 0.0001
        _mini := 42000.0
        _micro := na
        _found := true
    else if str.contains(_t, "RB")
        _name := "RB"
        _tick := 0.0001
        _mini := 42000.0
        _micro := na
        _found := true
    else if str.contains(_t, "DX")
        _name := "DX"
        _tick := 0.005
        _mini := 1000.0
        _micro := na
        _found := true
    else if str.contains(_t, "M6E") or str.contains(_t, "6E")
        _name := "6E"
        _tick := 0.00005
        _mini := 125000.0
        _micro := 12500.0
        _found := true
    else if str.contains(_t, "M6B") or str.contains(_t, "6B")
        _name := "6B"
        _tick := 0.0001
        _mini := 62500.0
        _micro := 6250.0
        _found := true
    else if str.contains(_t, "M6A") or str.contains(_t, "6A")
        _name := "6A"
        _tick := 0.0001
        _mini := 100000.0
        _micro := 10000.0
        _found := true
    else if str.contains(_t, "ZB")
        _name := "ZB"
        _tick := 0.03125
        _mini := 1000.0
        _micro := na
        _found := true
    else if str.contains(_t, "ZN")
        _name := "ZN"
        _tick := 0.015625
        _mini := 1000.0
        _micro := na
        _found := true
    else if str.contains(_t, "ZW")
        _name := "ZW"
        _tick := 0.25
        _mini := 50.0
        _micro := na
        _found := true
    else if str.contains(_t, "ZS")
        _name := "ZS"
        _tick := 0.25
        _mini := 50.0
        _micro := na
        _found := true
    else if str.contains(_t, "ZC")
        _name := "ZC"
        _tick := 0.25
        _mini := 50.0
        _micro := na
        _found := true
    else if str.contains(_t, "CT")
        _name := "CT"
        _tick := 0.01
        _mini := 500.0
        _micro := na
        _found := true
    else if str.contains(_t, "SB")
        _name := "SB"
        _tick := 0.01
        _mini := 1120.0
        _micro := na
        _found := true
    else if str.contains(_t, "KC")
        _name := "KC"
        _tick := 0.05
        _mini := 375.0
        _micro := na
        _found := true
    else if str.contains(_t, "CC")
        _name := "CC"
        _tick := 1.0
        _mini := 10.0
        _micro := na
        _found := true

    [_found, _name, _tick, _mini, _micro]

[assetFound, assetName, tickSize, miniPointValue, microPointValue] = detectAsset(t)

pointValue    = contractSel == "Mini" ? miniPointValue : microPointValue
sizeAvailable = not na(pointValue)

// ============================================================
// ATR VOLATILITY CHECK (current bar's true range vs. ATR)
// ============================================================
currentATR = ta.atr(atrLength)
barRange   = ta.tr(true)

// How far this bar's true range sits above current ATR (positive = an outsized bar)
pctVsBar = not na(currentATR) and not na(barRange) and currentATR != 0 ? (barRange - currentATR) / currentATR * 100.0 : na

yellowTolerancePct = shortTolerancePct / 2.0

nearingThreshold = not na(pctVsBar) and pctVsBar > yellowTolerancePct
barSpiking       = not na(pctVsBar) and pctVsBar > shortTolerancePct

// Raw (unsmoothed) state each bar. Red overrides yellow.
rawState = barSpiking ? "red" : nearingThreshold ? "yellow" : "green"

severity(s) =>
    s == "red" ? 2 : s == "yellow" ? 1 : 0

// Asymmetric smoothing: escalating to a more severe state is instant (fast
// reaction to rising volatility); dropping to a calmer state only commits
// once the calmer condition has held for N consecutive bars, so a single
// quiet bar right after a spike doesn't immediately flip the color back.
//
// Yellow and red each retain their own peak for as long as volState stays
// at that level: any bar still exceeding that level's threshold resets the
// downgrade countdown immediately, and the peak updates if it's a new high
// (but never lowers). Since a single spike bar can be extreme, only HALF of
// the amount by which it exceeds current ATR is recorded (e.g. ATR 5, bar
// range 10 -> recorded 7.5; a later bar range of 12 -> recorded 8.5),
// rather than the full raw bar range. A peak is cleared the moment its
// state is no longer the active one.
var string volState        = "green"
var int    downgradeCount  = 0
var float  peakRed         = na
var float  peakYellow      = na

if severity(rawState) >= severity(volState)
    if severity(rawState) > severity(volState)
        volState := rawState
    downgradeCount := 0
else
    downgradeCount := downgradeCount + 1
    if downgradeCount >= downgradeBars
        volState := rawState
        downgradeCount := 0

dampedRange = currentATR + (barRange - currentATR) / 2.0

if volState == "red"
    if na(peakRed) or dampedRange > peakRed
        peakRed := dampedRange
    peakYellow := na
else if volState == "yellow"
    if na(peakYellow) or dampedRange > peakYellow
        peakYellow := dampedRange
    peakRed := na
else
    peakRed    := na
    peakYellow := na

volColor = volState == "red" ? color.red : volState == "yellow" ? color.yellow : color.green

// While yellow/red (and the adjustment is enabled), use the retained peak
// for sizing (wider stop, fewer contracts) until the spike settles back
// within tolerance. When the checkbox is off, sizing always uses the
// normal current ATR - only the color reflects the state.
volEffectiveATR = volState == "red" ? peakRed : volState == "yellow" ? peakYellow : currentATR
effectiveATR    = adjustSizing ? volEffectiveATR : currentATR

// ============================================================
// ATR-BASED STOP DISTANCE & SIZING
// ============================================================
stopDistanceRaw = effectiveATR * atrMult

// Stops can only be placed at valid tick increments, so round DOWN to the
// nearest tick multiple for this asset before using the distance anywhere.
stopTicks    = na(tickSize) ? na : math.floor(stopDistanceRaw / tickSize)
stopDistance = na(tickSize) ? stopDistanceRaw : stopTicks * tickSize

riskPerContract = sizeAvailable ? stopDistance * pointValue : na
rawContracts    = sizeAvailable and riskPerContract > 0 ? math.floor(riskAmount / riskPerContract) : na

float finalContracts = na
if not na(rawContracts)
    finalContracts := math.floor(rawContracts / baseSize) * baseSize
    finalContracts := finalContracts < 0 ? 0 : finalContracts

contractMultiple = baseSize > 0 ? finalContracts / baseSize : na

maxRiskCalc = not na(finalContracts) ? finalContracts * riskPerContract : na

// ============================================================
// TIERED SIZING (Grade C / B / A)
// ============================================================
// Same math as above, just against a fraction of the configured risk. Each
// grade is independently rounded down to the nearest base-size multiple, so
// a grade can legitimately show 0 if its slice of the risk isn't enough to
// afford even one base-size unit - e.g. base size 5 with only 5 contracts
// affordable at 100% risk means grades B and C will show 0.
sizeForRisk(riskAmt) =>
    raw = sizeAvailable and riskPerContract > 0 ? math.floor(riskAmt / riskPerContract) : na
    float finalC = na
    if not na(raw)
        finalC := math.floor(raw / baseSize) * baseSize
        finalC := finalC < 0 ? 0 : finalC
    maxR = not na(finalC) ? finalC * riskPerContract : na
    [finalC, maxR]

tierTxt(letter, contracts) =>
    base = letter + ": " + str.tostring(contracts, "#")
    baseSize > 1 ? base + " (" + str.tostring(contracts / baseSize, "#") + "x)" : base

[contractsA, maxRiskA] = sizeForRisk(riskAmount * gradeAPct / 100.0)
[contractsB, maxRiskB] = sizeForRisk(riskAmount * gradeBPct / 100.0)
[contractsC, maxRiskC] = sizeForRisk(riskAmount * gradeCPct / 100.0)

// ============================================================
// TABLE
// ============================================================
getPosition(p) =>
    switch p
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

getSize(s) =>
    switch s
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal

var table infoTable = na

if barstate.islast
    if not na(infoTable)
        table.delete(infoTable)

    txtSize = getSize(textSize)

    if not assetFound
        // ---- Unrecognized asset error ----
        infoTable := table.new(getPosition(tablePos), 1, 2,
             bgcolor=color.new(color.black, 10), border_width=1, border_color=color.red)
        table.cell(infoTable, 0, 0, "Unsupported Asset", text_color=color.white, bgcolor=color.new(color.red, 40), text_size=txtSize)
        table.cell(infoTable, 0, 1, "Ticker '" + t + "' not recognized.\nSupported: ES NQ YM RTY GC SI PL HG\nCL NG HO RB DX 6E 6B 6A ZB ZN\nZW ZS ZC CT SB KC CC",
             text_color=color.red, text_size=txtSize)
    else if not sizeAvailable
        // ---- Contract size not available for this asset ----
        infoTable := table.new(getPosition(tablePos), 1, 2,
             bgcolor=color.new(color.black, 10), border_width=1, border_color=color.orange)
        table.cell(infoTable, 0, 0, assetName + " Detected", text_color=color.white, bgcolor=color.new(color.orange, 40), text_size=txtSize)
        table.cell(infoTable, 0, 1, contractSel + " contract not available for " + assetName + ".\nPlease switch Contract Type to the size that trades.",
             text_color=color.orange, text_size=txtSize)
    else
        // ---- Normal display ----
        // Row order: header, Contracts Allowed, Max Risk, Stop Loss Distance.
        // Max Risk and Stop Loss are swapped from before so the two rows
        // that vary by grade (Contracts Allowed, Max Risk) stay adjacent,
        // with the single grade-independent Stop Loss row at the bottom.
        cols = tieredEnabled ? 4 : 2
        infoTable := table.new(getPosition(tablePos), cols, 4,
             bgcolor=color.new(color.black, 10), border_width=1,
             border_color=color.gray, frame_color=color.gray, frame_width=1)

        headerColor = volState == "red" ? color.red : volState == "yellow" ? color.yellow : color.white
        riskColor   = headerColor
        stopColor   = headerColor

        // Header: asset, size, ATR multiplier, defined risk amount
        headerTxt = assetName + " (" + contractSel + ") | ATR " + str.tostring(atrMult, "#.##") + "x | Risk $" + str.tostring(riskAmount, "#.##") + " | Size " + str.tostring(baseSize, "#")
        table.cell(infoTable, 0, 0, headerTxt, text_color=headerColor, bgcolor=color.new(color.blue, 55), text_size=txtSize)
        table.merge_cells(infoTable, 0, 0, cols - 1, 0)

        if tieredEnabled
            // Row 1: Contracts Allowed (Grade C / B / A)
            table.cell(infoTable, 0, 1, "Contracts Allowed", text_color=color.white, text_halign=text.align_left, text_size=txtSize)
            table.cell(infoTable, 1, 1, tierTxt("C", contractsC), text_color = contractsC <= 0 ? color.red : volColor, text_size=txtSize)
            table.cell(infoTable, 2, 1, tierTxt("B", contractsB), text_color = contractsB <= 0 ? color.red : volColor, text_size=txtSize)
            table.cell(infoTable, 3, 1, tierTxt("A", contractsA), text_color = contractsA <= 0 ? color.red : volColor, text_size=txtSize)

            // Row 2: Max Risk (Grade C / B / A)
            table.cell(infoTable, 0, 2, "Max Risk ($)", text_color=color.white, text_halign=text.align_left, text_size=txtSize)
            table.cell(infoTable, 1, 2, "$" + str.tostring(maxRiskC, "#.##"), text_color=riskColor, text_size=txtSize)
            table.cell(infoTable, 2, 2, "$" + str.tostring(maxRiskB, "#.##"), text_color=riskColor, text_size=txtSize)
            table.cell(infoTable, 3, 2, "$" + str.tostring(maxRiskA, "#.##"), text_color=riskColor, text_size=txtSize)

            // Row 3: Stop Loss Distance (single value, doesn't vary by grade)
            table.cell(infoTable, 0, 3, "Stop Loss Distance", text_color=color.white, text_halign=text.align_left, text_size=txtSize)
            table.cell(infoTable, 1, 3, str.tostring(stopDistance, "#.##") + " pts / " + str.tostring(stopTicks, "#") + " ticks",
                 text_color=stopColor, text_size=txtSize)
            table.merge_cells(infoTable, 1, 3, cols - 1, 3)
        else
            // Row 1: Contracts allowed
            table.cell(infoTable, 0, 1, "Contracts Allowed", text_color=color.white, text_halign=text.align_left, text_size=txtSize)
            contractsTxt = baseSize > 1 ? str.tostring(finalContracts, "#") + " (" + str.tostring(contractMultiple, "#") + "x)" : str.tostring(finalContracts, "#")
            table.cell(infoTable, 1, 1, contractsTxt,
                 text_color = finalContracts <= 0 ? color.red : volColor, text_size=txtSize)

            // Row 2: Max risk (actual, after rounding)
            table.cell(infoTable, 0, 2, "Max Risk ($)", text_color=color.white, text_halign=text.align_left, text_size=txtSize)
            table.cell(infoTable, 1, 2, "$" + str.tostring(maxRiskCalc, "#.##"), text_color=riskColor, text_size=txtSize)

            // Row 3: Stop loss distance
            table.cell(infoTable, 0, 3, "Stop Loss Distance", text_color=color.white, text_halign=text.align_left, text_size=txtSize)
            table.cell(infoTable, 1, 3, str.tostring(stopDistance, "#.##") + " pts / " + str.tostring(stopTicks, "#") + " ticks",
                 text_color=stopColor, text_size=txtSize)
