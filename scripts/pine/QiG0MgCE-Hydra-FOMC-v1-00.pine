// @author @BBItsTime
// @version=6

// Hydra FOMC v1.00

// ─────────────────────────────────────────────────────────────────────────────
// DESCRIPTION
// Measures how the chart's security (SPY, SPX, QQQ, TLT, GLD, BTC, any symbol
// on a Daily chart) moved before, on, and after every U.S. Federal Reserve
// fed funds rate change since September 2007, and shows the market and
// economic conditions that existed when each decision was made.
// 
// WHAT IT OFFERS
// • Every Fed rate change since Sep 18 2007 (hikes, cuts, emergency cuts),
//   with new moves auto-detected from TradingView's U.S. interest rate feed.
// • Security picker: measure the chart's symbol, SPY, SPX, QQQ, TLT, GLD,
//   BTC, or any Custom symbol without changing the chart. The measured
//   security is shown in a purple badge at the top of the table.
// • Before / Day of / After returns for each event over four windows plus
//   1 day, all close-to-close. T = first session on/after the announcement.
// • Period presets: Custom, Super Short (2W), Short (1M), Medium (3M),
//   Medium-Long (6M), Long (1Y), each with a matched trend MA.
// • Market conditions at T-1: VIX level (colored calm/normal/stressed/crisis)
//   and % distance from the trend moving average.
// • Economic conditions known at the announcement: CPI, Core CPI,
//   unemployment, nonfarm payrolls, GDP growth and initial jobless claims.
//   Feeds are stamped at the end of the period measured, so each print is
//   paired with its real release date from built-in BLS/BEA calendars and
//   is never used before it was public. Estimated timing is marked *,
//   stale prints (delayed or unpublished reports) are marked †.
// • Guidance read: day-of change in the 2-year and 10-year Treasury yields,
//   the market's verdict on the statement, projections and press
//   conference. Moves opposite to the rate change (a hawkish cut or a
//   dovish hike) are flagged ◆.
// • Expected vs Surprise: fed funds futures split each move into the part the
//   market had already discounted and the part that surprised it.
// • Priced 6M: how much easing or tightening the 6-month bill had priced for
//   the coming months, read at T-1 (free data, no futures needed).
// • Baseline row: the security's median return over the same window length
//   across ALL sessions, so event medians can be read against normal drift.
// • Summary rows: median or average by Hikes / Cuts / Emergency / All,
//   % of events up per window, sample-size and window-overlap warnings.
// • Filters: date range, event type, row count, newest first, before/after
//   column modes and column toggles to fit the table on screen.
// • New rate from the feed or the hard-coded target history.
// • Chart labels showing the rate change, new rate, or both, with a
//   detailed hover for every event.
// • Highlight event: marks any event (or the most recent) with a vertical
//   band, dims the other labels and highlights its table row. Use the
//   chart's Go to date (Alt+G / Option+G) to jump there.
// • Hover ANY table cell for what it means; the ⚠ Data notes cell lists the
//   data cautions to read before drawing conclusions.
//
// NOTES
// Economic values are the feeds' latest revised figures, not first-reported
// numbers, and colors compare to the prior print, not forecasts.
// Built-in calendars: CPI and jobs through Aug 2026, GDP through Q2 2026.
// Extend hDate/hBps/hUpper and the release calendars as history grows.
//
// POSSIBLE FUTURE FEATURES
// 1. HOLD MEETINGS — add the ~150 no-change FOMC decisions since 2007 as a
//    fifth group ("Hold", Move = 0) plus an Events-to-list filter. Gives a
//    control group for the change medians and is where guidance does most of
//    the work. Needs every meeting date from the Fed's per-year calendar
//    pages (about 15 pages); a wrong date silently corrupts that row.
// 2. CYCLE POSITION — mark each move as 1st, 2nd, 3rd… of its cycle, with a
//    "first move only" filter. First cut / first hike is the most-studied
//    Fed question and position often splits otherwise mixed results.
// 3. CONDITION FILTERS on the summary rows — include only events where VIX >
//    30, CPI > 4%, price above/below the trend MA, or a hawkish/dovish read.
//    Turns the table from description into hypothesis testing.
// 4. PATH, NOT JUST ENDPOINTS — max drawdown and max run-up inside the after
//    windows, so a +1% month that first fell 8% is visible.
// 5. CSV EXPORT — write per-event metrics as display=display.data_window
//    plots on the event bar so TradingView's "Export chart data" produces a
//    file for spreadsheet work.
// 6. DOT PLOT MEDIAN — the Fed's own projected year-end rate and its change
//    from the prior projection (2012 onward, quarterly meetings only).
// 7. FREE SURPRISE PROXY — a "Surprise source" option using FRED:DTB3 day-of
//    change for users without CME futures data (proxy only; no expected/
//    surprise split).
// 8. ALERTS — when a new rate change is auto-detected, or when an event's
//    windows complete.
// 9. CALENDAR REFRESH — extend hDate/hBps/hUpper and the CPI, jobs and GDP
//    release calendars as new data arrives (currently to Sep 2026 / Aug 2026
//    / Q2 2026). 
// ─────────────────────────────────────────────────────────────────────────────

const string VERSION = "v1.00"
indicator("Hydra FOMC " + VERSION, "Hydra FOMC " + VERSION, overlay = true, max_labels_count = 200, max_bars_back = 1100)

const string G_TBL  = "Economic Performance Table"
const string G_RNG  = "Date range"
const string G_DATA = "Data"
const string G_VIX  = "VIX stress colors"
const string G_ECON = "Economic conditions (known at announcement)"
const string G_PER  = "Periods (trading sessions)"

// Input titles show their default value in [brackets].
secPick    = input.string("Chart", "Security [Chart]", options = ["Chart", "SPY", "SPX", "QQQ", "TLT", "GLD", "BTC", "Custom"], group = G_TBL, tooltip = "Which security's returns and trend MA the table measures.\nChart = the symbol on this chart.\nCustom = the symbol chosen in Custom security below.\nSPY = AMEX:SPY (S&P 500 ETF) · SPX = SP:SPX (S&P 500 index; may need an index data subscription) · QQQ = NASDAQ:QQQ (Nasdaq-100 ETF) · TLT = NASDAQ:TLT (20+ yr Treasury ETF) · GLD = AMEX:GLD (gold ETF) · BTC = BITSTAMP:BTCUSD (bitcoin, data from 2011).\n\nWindows are counted in THIS CHART's sessions, so use a Daily stock or ETF chart for the ETFs and index. BTC trades 24/7 and closes at 00:00 UTC, so its daily closes don't line up exactly with U.S. sessions. A security with shorter history shows — for earlier events.")
customSym  = input.symbol("AMEX:IWM", "Custom security [AMEX:IWM]", group = G_TBL, tooltip = "CUSTOM ONLY: used when Security = Custom; ignored otherwise.\nPick any symbol (stock, ETF, index, future, crypto). Windows are still counted on this chart's daily sessions, so choose a symbol that trades on the same days as the chart for clean results.")
showTable  = input.bool(true, "Show Table [On]", group = G_TBL, tooltip = "Off = hide the table entirely. Chart labels still follow the 'Chart labels' setting.\n\nBEFORE INTERPRETING: hover the '⚠ Data notes' cell at the top-left of the table. Key cautions: economic values are revised figures (not first-reported); colors compare to the prior print, not forecasts; * = estimated release timing; † = stale print (report delayed or never published); small samples and overlapping windows make medians descriptive, not proof.")
showEvents = input.bool(true, "Show per-event rows [On]", group = G_TBL, tooltip = "Off = summary rows only (compact table).")
evFilter   = input.string("All", "Events to list [All]", options = ["All", "Hikes", "Cuts", "Emergency"], group = G_TBL, tooltip = "Which events get their own row. Summary rows always use every event in the date range.")
maxRows    = input.int(10, "Max event rows, 0 = all [10]", minval = 0, group = G_TBL, tooltip = "Keeps the table short enough to fit on screen.")
newest     = input.bool(true, "Newest events first [On]", group = G_TBL)
hdrEvery   = input.int(8, "Repeat header every N rows, 0 = off [8]", minval = 0, group = G_TBL, tooltip = "Re-prints column names inside the event list.")
colMode    = input.string("Both", "Performance columns [Both]", options = ["Before", "After", "Both"], group = G_TBL, tooltip = "Before = Period 4/3/2/1 and 1D before the rate change.\nAfter = 1D and Period 1/2/3/4 after the rate change.\nBoth = all of them.\nThe 'Day of' column is shown in every mode. VIX / MA columns have their own toggle.")
showBase   = input.bool(true, "Show baseline row [On]", group = G_TBL, tooltip = "Adds a Baseline row: the measured security's median return over the same window lengths across EVERY session in the date range, not just event days. A Fed effect is the difference between a group's median and this row.")
showEcon   = input.bool(false, "Show economic columns [Off]", group = G_TBL, tooltip = "Master switch for the CPI / Core / Unemp / NFP / GDP / Claims columns. Each also has its own toggle under Economic conditions.\nOFF by default to keep the table narrow on first load; turn it on for the full economic backdrop of each decision.")
showGuide  = input.bool(true, "Show guidance (yield) columns [On]", group = G_TBL, tooltip = "Master switch for the 2Y Δ and 10Y Δ columns. Each also has its own toggle under Guidance read.\nOff also stops both yield requests, which is the fix if a yield symbol is unavailable.")
showCond   = input.bool(true, "Show VIX / MA columns [On]", group = G_TBL, tooltip = "Market-condition columns at T-1: VIX and % vs the trend MA.\nOff also stops the VIX request, which is the fix if the VIX symbol is unavailable.")
showLong   = input.bool(false, "Show Period 3 & 4 columns [Off]", group = G_TBL, tooltip = "The two longest windows (before and/or after, per Performance columns). OFF by default to keep the table narrow; turn on for the 3M and 1Y views.")
topPad     = input.int(0, "Blank rows above table [0]", minval = 0, maxval = 10, group = G_TBL, tooltip = "Pushes the table down by this many empty rows, to clear the chart's top toolbar or another indicator's legend. Pine cannot offset a table in pixels, so blank rows are the way to nudge it.")
posIn      = input.string("Top Right", "Table position [Top Right]", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = G_TBL)
sizeIn     = input.string("Tiny", "Text size [Tiny]", options = ["Tiny", "Small", "Normal"], group = G_TBL)

useRange = input.bool(true, "Limit to date range [On]", group = G_RNG, tooltip = "On = only events announced between From and To, and the Baseline row also covers just that span. Off = every event and every session on the chart's loaded history.\nOn by default, starting 2007-01-01, so the baseline is measured over the same era as the events instead of the symbol's entire history.\nSummary rows and chart labels follow the range. After-windows still use bars past the To date.")
rngStart = input.time(timestamp("01 Jan 2007 00:00 +0000"), "From [2007-01-01]", group = G_RNG, tooltip = "The first Fed event in the script is 2007-09-18, so 2007-01-01 keeps every event while holding the Baseline row to the same period.")
rngEnd   = input.time(timestamp("31 Dec 2030 00:00 +0000"), "To [2030-12-31]", group = G_RNG)

const string G_PRICE = "Expectations (priced in)"
show6M     = input.bool(true, "Priced 6M column [On]", group = G_PRICE, tooltip = "Forward-looking: the 6-month Treasury bill yield at T-1 minus the target rate in effect, in basis points. Negative = cuts priced over the coming months (about four meetings), positive = hikes priced. Roughly 25bp per expected move.\nUses free TVC data, unlike the futures columns.")
y6Sym      = input.symbol("FRED:DGS6MO", "6-month rate symbol [FRED:DGS6MO]", group = G_PRICE, tooltip = "FRED:DGS6MO quotes a YIELD in percent, which is what this column needs.\nFree alternatives: FRED:DTB3 (3-month yield), FRED:DGS1 (1-year yield), TVC:US01Y.\nCareful with TVC bill symbols such as TVC:US06M: they quote a PRICE near 100, not a yield. Set Quote type below if you use one.")
y6Mode     = input.string("Auto", "Quote type [Auto]", options = ["Auto", "Yield", "Bill price"], group = G_PRICE, tooltip = "Yield = the symbol reports a percent yield (FRED:DGS…).\nBill price = the symbol reports a discount price near 100 (TVC bill symbols); the yield is then approximated as (100 − price) × 12 / maturity months.\nAuto treats any value above 25 as a price.")
y6Months   = input.int(6, "Bill maturity, months [6]", minval = 1, maxval = 24, group = G_PRICE, tooltip = "Only used when the symbol is price-quoted: 6 for a 6-month bill, 3 for a 3-month bill.")
showPriced = input.bool(false, "Expected / Surprise columns [Off]", group = G_PRICE, tooltip = "Splits each rate change into the part the market had already priced and the part that surprised it, using fed funds futures (the standard Kuttner method).\nSurprise = change in the implied rate on announcement day, scaled for how much of the month is left. Priced = the actual change minus that surprise.\n\nOFF by default because the ZQ contracts need CME market data, which many plans do not include: with it off the request never runs and the rest of the table is unaffected.")
ffSym1     = input.symbol("CBOT:ZQ1!", "Front-month futures [CBOT:ZQ1!]", group = G_PRICE, tooltip = "30-day fed funds futures, front month. Implied rate = 100 − price.")
ffSym2     = input.symbol("CBOT:ZQ2!", "Next-month futures [CBOT:ZQ2!]", group = G_PRICE, tooltip = "Used instead of the front month when the meeting falls in the last 3 days of a month, where the front-month scaling blows up.")

const string G_GUIDE = "Guidance read (Treasury yields)"
show2Y  = input.bool(true, "2Y yield change [On]", group = G_GUIDE, tooltip = "Day-of change in the 2-year Treasury yield, in basis points. The 2-year is the market's fastest read on the expected path of Fed policy.")
y2Sym   = input.symbol("TVC:US02Y", "2Y yield symbol [TVC:US02Y]", group = G_GUIDE)
show10Y = input.bool(true, "10Y yield change [On]", group = G_GUIDE, tooltip = "Day-of change in the 10-year Treasury yield, in basis points. Shows whether the guidance also moved longer-term rates.")
y10Sym  = input.symbol("TVC:US10Y", "10Y yield symbol [TVC:US10Y]", group = G_GUIDE)
oppBp   = input.float(2.0, "Opposite-move threshold, bp [2]", minval = 0, step = 0.5, group = G_GUIDE, tooltip = "A move is flagged ◆ when the yield goes AGAINST the rate change by at least this many basis points: yield down on a hike (dovish read) or yield up on a cut (hawkish read). Filters out noise.")

autoDetect = input.bool(true, "Auto-detect new Fed moves [On]", group = G_DATA, tooltip = "Watches the US interest rate feed and adds any rate change after the last hard-coded event (Sep 16 2026). Auto events are typed hike/cut; an unscheduled move can't be detected as 'Emergency' automatically.")
statIn     = input.string("Median", "Group statistic [Median]", options = ["Median", "Average"], group = G_DATA, tooltip = "How the summary rows are calculated. Median resists outliers like Mar 16 2020 (−12%).")
rateSrc    = input.string("Feed", "New rate source [Feed]", options = ["Feed", "Hard-coded"], group = G_DATA, tooltip = "Feed = the US interest rate value on the event bar, shown as reported (e.g. 4.00%).\n\nHard-coded = the target entered in the script, shown as a range (e.g. 3.75–4.00%).\nHard-coded list covers Sep 18 2007 → Sep 16 2026 (42 events). Moves after that come only from auto-detect and always use the feed value.\n\nIf the feed has no value for an event, the hard-coded target is used. Hover a New rate cell to see both.")
labelMode  = input.string("Fed change", "Chart labels [Fed change]", options = ["None", "Fed change", "New rate", "Both"], group = G_DATA, tooltip = "What each event label on the chart shows: the change in bp, the new rate, both, or no labels.\nRed = hike, green = cut, orange = emergency. Hover a label for details.")
vixSym     = input.symbol("TVC:VIX", "VIX symbol [TVC:VIX]", group = G_DATA, tooltip = "Used for the 'VIX T-1' column (fear level going into each decision).")
hlPick     = input.string("None", "Highlight event [None]", options = ["None", "Most recent", "2026-09-16", "2025-12-10", "2025-10-29", "2025-09-17", "2024-12-18", "2024-11-07", "2024-09-18", "2023-07-26", "2023-05-03", "2023-03-22", "2023-02-01", "2022-12-14", "2022-11-02", "2022-09-21", "2022-07-27", "2022-06-15", "2022-05-04", "2022-03-16", "2020-03-15", "2020-03-03", "2019-10-30", "2019-09-18", "2019-07-31", "2018-12-19", "2018-09-26", "2018-06-13", "2018-03-21", "2017-12-13", "2017-06-14", "2017-03-15", "2016-12-14", "2015-12-16", "2008-12-16", "2008-10-29", "2008-10-08", "2008-04-30", "2008-03-18", "2008-01-30", "2008-01-22", "2007-12-11", "2007-10-31", "2007-09-18"], group = G_DATA, tooltip = "Marks one event on the chart with a vertical band, enlarges its label and highlights its table row.\nMost recent = the latest event on the chart (includes auto-detected moves).\nTo jump there: Alt+G (Option+G on Mac) and type the date.\nNothing is drawn if the event is outside the date range or loaded history.")
hlDim      = input.bool(true, "Dim other labels while highlighting [On]", group = G_DATA, tooltip = "When an event is highlighted, fades every other event label so the highlighted one stands out.")

vixCalm   = input.float(15, "Calm below [15]", group = G_VIX, inline = "v1", tooltip = "VIX T-1 cell colors: green = calm, gray = normal, orange = stressed, red = crisis.")
vixStress = input.float(20, "Stressed at [20]", group = G_VIX, inline = "v2")
vixCrisis = input.float(30, "Crisis at [30]", group = G_VIX, inline = "v2")

showCPI    = input.bool(true, "CPI YoY [On]", group = G_ECON, tooltip = "Feed IRYY. Paired with BLS CPI release dates.")
showCore   = input.bool(true, "Core CPI YoY [On]", group = G_ECON, tooltip = "Feed CIR. Same BLS release dates as CPI.")
showUR     = input.bool(true, "Unemployment rate [On]", group = G_ECON, tooltip = "Feed UR. Paired with BLS Employment Situation release dates.")
showNFP    = input.bool(true, "Nonfarm payrolls [On]", group = G_ECON, tooltip = "Feed NFP (monthly change). Same release as unemployment.")
showGDP    = input.bool(true, "GDP growth [On]", group = G_ECON, tooltip = "Paired with BEA advance-estimate release dates.")
gdpField   = input.string("GDPQQ", "GDP feed field [GDPQQ]", options = ["GDPQQ", "GDPGA"], group = G_ECON, tooltip = "GDPQQ = GDP growth rate as the feed reports it. GDPGA = annualized growth (BEA headline). If GDPQQ shows small values like 0.4, it is quarterly, not annualized.")
showClaims = input.bool(true, "Initial jobless claims [On]", group = G_ECON)
claimsSym  = input.symbol("FRED:ICSA", "Claims symbol [FRED:ICSA]", group = G_ECON)
claimsLag  = input.int(5, "Claims release lag, days [5]", minval = 0, maxval = 6, group = G_ECON, tooltip = "Days from the claims data stamp to its Thursday release. 5 assumes the feed stamps the week-ending Saturday.")

perPreset = input.string("Custom", "Period preset [Custom]", options = ["Custom", "Super Short", "Short", "Medium", "Medium-Long", "Long"], group = G_PER, tooltip = "Sets Periods 1-4 (trading sessions) and, if enabled below, the trend MA.\nCustom: your Period / MA inputs (defaults 5/21/63/252, MA 200).\nSuper Short (2 weeks): 2/3/5/10 = 2D·3D·1W·2W, MA 20. Event reaction and fast reversals.\nShort (1 month): 3/5/10/21 = 3D·1W·2W·1M, MA 50. Swing view, stays inside one meeting cycle.\nMedium (3 months): 5/10/21/63 = 1W·2W·1M·3M, MA 50. Priced-in vs repricing into the next meetings.\nMedium-Long (6 months): 10/21/63/126 = 2W·1M·3M·6M, MA 100. Did a cycle turn follow?\nLong (1 year): 21/63/126/252 = 1M·3M·6M·1Y, MA 200. Investor view.\n\nFed meetings are ~32 sessions apart, so windows longer than that overlap the next decisions.")
presetMA  = input.bool(true, "Preset sets trend MA [On]", group = G_PER, tooltip = "On = each preset uses its matched MA (20/50/50/100/200). Off = always use your Trend MA length. Custom always uses your Trend MA length.")
inMaLen   = input.int(200, "Trend MA length [200]", minval = 2, maxval = 1000, group = G_PER, tooltip = "SMA for the 'vs MA' column: % distance of the close from this SMA at T-1. Used when preset = Custom, or when 'Preset sets trend MA' is off.")
inPer1    = input.int(5, "Period 1 [5]", minval = 2, maxval = 1000, group = G_PER, tooltip = "CUSTOM ONLY: ignored unless Period preset = Custom.\nShortest window in trading sessions, used BEFORE and AFTER the rate change. 5 ≈ 1 week, 21 ≈ 1 month, 63 ≈ 3 months, 126 ≈ 6 months, 252 ≈ 1 year.\nMust be P1 < P2 < P3 < P4. The 1D columns are fixed.")
inPer2    = input.int(21, "Period 2 [21]", minval = 2, maxval = 1000, group = G_PER, tooltip = "CUSTOM ONLY: ignored unless Period preset = Custom. Must be larger than Period 1.")
inPer3    = input.int(63, "Period 3 [63]", minval = 2, maxval = 1000, group = G_PER, tooltip = "CUSTOM ONLY: ignored unless Period preset = Custom. Must be larger than Period 2.")
inPer4    = input.int(252, "Period 4 [252]", minval = 2, maxval = 1000, group = G_PER, tooltip = "CUSTOM ONLY: ignored unless Period preset = Custom. Longest window; must be larger than Period 3.")

// Resolve the active periods and MA from the preset
int per1 = switch perPreset
    "Super Short" => 2
    "Short"       => 3
    "Medium"      => 5
    "Medium-Long" => 10
    "Long"        => 21
    => inPer1
int per2 = switch perPreset
    "Super Short" => 3
    "Short"       => 5
    "Medium"      => 10
    "Medium-Long" => 21
    "Long"        => 63
    => inPer2
int per3 = switch perPreset
    "Super Short" => 5
    "Short"       => 10
    "Medium"      => 21
    "Medium-Long" => 63
    "Long"        => 126
    => inPer3
int per4 = switch perPreset
    "Super Short" => 10
    "Short"       => 21
    "Medium"      => 63
    "Medium-Long" => 126
    "Long"        => 252
    => inPer4
int presetMaLen = switch perPreset
    "Super Short" => 20
    "Short"       => 50
    "Medium"      => 50
    "Medium-Long" => 100
    "Long"        => 200
    => inMaLen
int maLen = presetMA ? presetMaLen : inMaLen

tblPos = switch posIn
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right

txtSize = switch sizeIn
    "Small"  => size.small
    "Normal" => size.normal
    => size.tiny

if not timeframe.isdaily
    runtime.error("Load this indicator on a Daily (1D) chart.")
if not (per1 < per2 and per2 < per3 and per3 < per4)
    runtime.error("Custom periods must increase: Period 1 < Period 2 < Period 3 < Period 4.")

// ── Hard-coded history ───────────────────────────────────────────────────────
// hDate = announcement date, hBps = change in bp, hUpper = new target (upper
// bound of the range; single target before Dec 16 2008).
// 2008-12-16 was 1.00% → 0–0.25% (coded −100bp). 2020-03-15 was a Sunday → T = Mar 16.
var array<int> hDate = array.from(
     20070918, 20071031, 20071211, 20080122, 20080130, 20080318, 20080430, 20081008, 20081029, 20081216,
     20151216, 20161214, 20170315, 20170614, 20171213, 20180321, 20180613, 20180926, 20181219,
     20190731, 20190918, 20191030, 20200303, 20200315,
     20220316, 20220504, 20220615, 20220727, 20220921, 20221102, 20221214,
     20230201, 20230322, 20230503, 20230726,
     20240918, 20241107, 20241218,
     20250917, 20251029, 20251210,
     20260916)

var array<int> hBps = array.from(
     -50, -25, -25, -75, -50, -75, -25, -50, -50, -100,
     25, 25, 25, 25, 25, 25, 25, 25, 25,
     -25, -25, -25, -50, -100,
     25, 50, 75, 75, 75, 75, 50,
     25, 25, 25, 25,
     -50, -25, -25,
     -25, -25, -25,
     25)

var array<float> hUpper = array.from(
     4.75, 4.50, 4.25, 3.50, 3.00, 2.25, 2.00, 1.50, 1.00, 0.25,
     0.50, 0.75, 1.00, 1.25, 1.50, 1.75, 2.00, 2.25, 2.50,
     2.25, 2.00, 1.75, 1.25, 0.25,
     0.50, 1.00, 1.75, 2.50, 3.25, 4.00, 4.50,
     4.75, 5.00, 5.25, 5.50,
     5.00, 4.75, 4.50,
     4.25, 4.00, 3.75,
     4.00)

var array<int> hEmerg = array.from(20080122, 20081008, 20200303, 20200315)

const int NCOL = 24
int   NA_I = na
float NA_F = na

// Live event lists (hard-coded + auto-detected)
var int nHard    = array.size(hDate)
var int lastHard = array.get(hDate, array.size(hDate) - 1)
var array<int>    evDate  = array.copy(hDate)
var array<int>    evBps   = array.copy(hBps)
var array<float>  evUpper = array.copy(hUpper)
var array<string> evType  = array.new<string>()
var array<bool>   evAuto  = array.new<bool>(array.size(hDate), false)
var array<int>    evBar   = array.new<int>(array.size(hDate), NA_I)
var array<float>  evCls   = array.new<float>(array.size(hDate), NA_F)
var array<float>  evFeed  = array.new<float>(array.size(hDate), NA_F)
var array<label>  evLbl   = array.new<label>(array.size(hDate))   // chart label per event (for highlight/dim)   // feed rate captured on the event bar
// matrix cols: 0 VIX | 1 vs MA | 2 P4 bef | 3 P3 bef | 4 P2 bef | 5 P1 bef | 6 1D bef
//              7 Day of | 8 1D aft | 9 P1 aft | 10 P2 aft | 11 P3 aft | 12 P4 aft
//              13 CPI | 14 Core CPI | 15 Unemp | 16 NFP | 17 GDP | 18 Claims (known at T)
//              19 2Y yield Δ bp (day of) | 20 10Y yield Δ bp (day of)
//              21 expected change bp | 22 policy surprise bp | 23 priced 6M bp
var matrix<float> res = matrix.new<float>(array.size(hDate), NCOL, NA_F)
// econMeta per event: for series k (0-5) → col k*3 = reference period, k*3+1 = release date (negative = estimated), k*3+2 = prior print
var matrix<float> econMeta = matrix.new<float>(array.size(hDate), 18, NA_F)
// econSt per series row k: 0 known | 1 prior | 2 ref | 3 release | 4 calendar pointer (claims: pending value) | 5 pending stamp time | 6 pending ref
var matrix<float> econSt = matrix.new<float>(6, 7, NA_F)
var map<int, float> mCpi  = map.new<int, float>()
var map<int, float> mCore = map.new<int, float>()
var map<int, float> mUr   = map.new<int, float>()
var map<int, float> mNfp  = map.new<int, float>()
var map<int, float> mGdp  = map.new<int, float>()

if array.size(evType) == 0
    for i = 0 to nHard - 1
        int d = array.get(hDate, i)
        array.push(evType, array.includes(hEmerg, d) ? "Emergency" : array.get(hBps, i) > 0 ? "Hike" : "Cut")

// ── Helpers ──────────────────────────────────────────────────────────────────
// Short label for a session count: 252→1Y, 63→3M, 21→1M, 10→2W, 7→7D
perLbl(int n) =>
    n % 252 == 0 ? str.tostring(int(n / 252)) + "Y" : n % 21 == 0 ? str.tostring(int(n / 21)) + "M" : n % 5 == 0 ? str.tostring(int(n / 5)) + "W" : str.tostring(n) + "D"

pct(float a, float b) =>
    na(a) or na(b) or b == 0 ? na : (a / b - 1.0) * 100.0

fmtPct(float v) =>
    na(v) ? "—" : str.tostring(v, "#0.00") + "%"

bgFor(float v) =>
    na(v) ? color.new(color.gray, 85) : v >= 0 ? color.new(color.green, 70) : color.new(color.red, 70)

dateStr(int d) =>
    int y = int(math.floor(d / 10000))
    int m = int(math.floor(d / 100)) % 100
    int dd = d % 100
    str.tostring(y) + "-" + str.tostring(m, "00") + "-" + str.tostring(dd, "00")

rateStr(float upper, int d) =>
    na(upper) ? "—" : d < 20081216 ? str.tostring(upper, "#0.00") + "%" : str.tostring(math.max(upper - 0.25, 0.0), "#0.00") + "–" + str.tostring(upper, "#0.00") + "%"

feedStr(float v) =>
    na(v) ? "—" : str.tostring(v, "#0.00") + "%"

// New-rate text for an event, honoring the source setting
evRateTxt(int idx) =>
    float fv = array.get(evFeed, idx)
    bool useFeed = rateSrc == "Feed" and not na(fv)
    useFeed ? feedStr(fv) : array.get(evAuto, idx) ? feedStr(array.get(evUpper, idx)) : rateStr(array.get(evUpper, idx), array.get(evDate, idx))

evRateBoth(int idx) =>
    "Feed: " + feedStr(array.get(evFeed, idx)) + "  ·  Hard-coded: " + (array.get(evAuto, idx) ? "n/a (auto event; hard-coded list ends " + dateStr(lastHard) + ")" : rateStr(array.get(evUpper, idx), array.get(evDate, idx)))
     + (rateSrc == "Feed" and na(array.get(evFeed, idx)) ? "\n(no feed value on this bar, showing hard-coded)" : "")

vixTier(float v) =>
    na(v) ? "n/a" : v < vixCalm ? "Calm" : v < vixStress ? "Normal" : v < vixCrisis ? "Stressed" : "Crisis"

vixBg(float v) =>
    na(v) ? color.new(color.gray, 85) : v < vixCalm ? color.new(color.green, 55) : v < vixStress ? color.new(color.gray, 55) : v < vixCrisis ? color.new(color.orange, 40) : color.new(color.red, 30)

// Yield change color: up = hawkish read (red), down = dovish read (green)
yieldBg(float v) =>
    na(v) ? color.new(color.gray, 85) : math.abs(v) < 0.5 ? color.new(color.gray, 60) : v > 0 ? color.new(color.red, 60) : color.new(color.green, 60)

// Opposite read: yield moved against the rate change by at least the threshold
isOpposite(string t, float v) =>
    not na(v) and ((t == "Hike" and v <= -oppBp) or (t != "Hike" and v >= oppBp))

grpOpposite(matrix<float> mtx, array<string> types, int col, string grp) =>
    int c = 0
    for i = 0 to matrix.rows(mtx) - 1
        string t = array.get(types, i)
        if (grp == "All" or t == grp) and isOpposite(t, matrix.get(mtx, i, col))
            c += 1
    c

// Thousands formatter; the NFP and claims feeds report persons
fmtK(float v, bool signed) =>
    float k = v / 1000
    (signed and k > 0 ? "+" : "") + str.tostring(k, "#,##0") + "K"

valTxt(int c, float v) =>
    na(v) ? "—" : c == 0 ? str.tostring(v, "#0.0") : c >= 19 ? (v > 0 ? "+" : "") + str.tostring(v, "#0") + "bp" : c == 16 ? fmtK(v, true) : c == 18 ? fmtK(v, false) : c >= 13 ? str.tostring(v, "#0.0") + "%" : fmtPct(v)

valBg(int c, float v) =>
    c == 0 ? vixBg(v) : c == 21 ? color.new(color.blue, 70) : (c == 19 or c == 20 or c == 22 or c == 23) ? yieldBg(v) : c >= 13 ? color.new(color.teal, 70) : bgFor(v)

// Event-row econ color: NFP/GDP by sign; others vs the prior print (red = worse/hotter, green = better/cooler)
econBg(int c, float v, float pr) =>
    color bad = color.new(color.red, 60)
    color good = color.new(color.green, 60)
    na(v) ? color.new(color.gray, 85) : (c == 16 or c == 17) ? (v < 0 ? bad : good) : (na(pr) or v == pr) ? color.new(color.gray, 60) : v > pr ? bad : good

monStr(int ym) =>
    str.format_time(timestamp("UTC", int(ym / 100), ym % 100, 1, 0, 0), "MMM yyyy", "UTC")

periodStr(int c, float ref) =>
    na(ref) ? "" : c == 17 ? "Q" + str.tostring(int((int(ref) % 100) / 3)) + " " + str.tostring(int(int(ref) / 100)) : c == 18 ? "week ending " + dateStr(int(ref)) : monStr(int(ref))

grpStat(matrix<float> mtx, array<string> types, int col, string grp, bool useMedian) =>
    array<float> vals = array.new<float>()
    for i = 0 to matrix.rows(mtx) - 1
        float v = matrix.get(mtx, i, col)
        if not na(v) and (grp == "All" or array.get(types, i) == grp)
            array.push(vals, v)
    array.size(vals) == 0 ? na : useMedian ? array.median(vals) : array.avg(vals)

grpUp(matrix<float> mtx, int col) =>
    int up = 0
    int c = 0
    for i = 0 to matrix.rows(mtx) - 1
        float v = matrix.get(mtx, i, col)
        if not na(v)
            c += 1
            up += v > 0 ? 1 : 0
    c == 0 ? na : up * 100.0 / c

grpCount(array<int> bars, array<string> types, string grp) =>
    int c = 0
    for i = 0 to array.size(bars) - 1
        if not na(array.get(bars, i)) and (grp == "All" or array.get(types, i) == grp)
            c += 1
    c

// Events in a group whose Period 4 window reaches a neighboring Fed move (before or after)
grpOverlap(array<int> bars, array<string> types, string grp, int span) =>
    int c = 0
    int n = array.size(bars)
    for i = 0 to n - 1
        int bi = array.get(bars, i)
        if not na(bi) and (grp == "All" or array.get(types, i) == grp)
            bool hit = false
            for j = 0 to n - 1
                int bj = array.get(bars, j)
                if j != i and not na(bj) and math.abs(bj - bi) < span
                    hit := true
            c += hit ? 1 : 0
    c

// ── Per-bar series ───────────────────────────────────────────────────────────
int   dayKey  = year * 10000 + month * 100 + dayofmonth
int   prevKey = bar_index == 0 ? dayKey : dayKey[1]
string secSym  = switch secPick
    "SPY" => "AMEX:SPY"
    "SPX" => "SP:SPX"
    "QQQ" => "NASDAQ:QQQ"
    "TLT" => "NASDAQ:TLT"
    "GLD" => "AMEX:GLD"
    "BTC" => "BITSTAMP:BTCUSD"
    "Custom" => customSym
    => syminfo.tickerid
string secName = secPick == "Chart" ? syminfo.ticker : secPick == "Custom" ? array.get(str.split(customSym, ":"), array.size(str.split(customSym, ":")) - 1) : secPick
// Measured price: the chart's close, or the picked security's daily close sampled on this chart's bars
// Daily chart requesting daily data: lookahead_on returns the SAME date's bar.
// With lookahead_off the other symbol's bar is not confirmed yet and the value
// comes back one day late (bug fixed in v1.01). No future data is used because
// the chart and the request are both Daily.
float secReq  = na
if secPick != "Chart"
    secReq := request.security(secSym, "D", close, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float pClose  = secPick == "Chart" ? close : secReq
float trendMa = ta.sma(pClose, maLen)
float vixPrev = na
if showCond
    vixPrev := request.security(vixSym, "D", close[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float fedRate = request.economic("US", "INTR")
bool  rateChg = not na(fedRate) and not na(fedRate[1]) and math.abs(fedRate - fedRate[1]) >= 0.1
float vsSma   = pct(pClose[1], trendMa[1])
float p4Bef   = pct(pClose[1], pClose[per4 + 1])
float p3Bef   = pct(pClose[1], pClose[per3 + 1])
float p2Bef   = pct(pClose[1], pClose[per2 + 1])
float p1Bef   = pct(pClose[1], pClose[per1 + 1])
float dBef    = pct(pClose[1], pClose[2])
float dOf     = pct(pClose, pClose[1])
// Day-of yield changes in basis points, computed on each yield symbol's own sessions
float y2Chg   = na
float y10Chg  = na
if showGuide and show2Y
    y2Chg := request.security(y2Sym, "D", (close - close[1]) * 100, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
if showGuide and show10Y
    y10Chg := request.security(y10Sym, "D", (close - close[1]) * 100, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
// Fed funds futures: implied rate = 100 − price, so the implied-rate change in bp is (prev price − price) * 100
float y6Lvl   = na
if show6M
    y6Lvl := request.security(y6Sym, "D", close[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
// Some bill symbols quote a discount price near 100 instead of a yield
bool  y6IsPrice = y6Mode == "Bill price" or (y6Mode == "Auto" and not na(y6Lvl) and y6Lvl > 25)
float y6Yield   = na(y6Lvl) ? na : y6IsPrice ? (100.0 - y6Lvl) * 12.0 / y6Months : y6Lvl
// Easing/tightening already priced for the coming months: 6M yield at T-1 vs the rate in effect
float priced6 = na(y6Yield) or na(fedRate[1]) ? na : (y6Yield - fedRate[1]) * 100

float ff1Chg  = na
float ff2Chg  = na
if showPriced
    ff1Chg := request.security(ffSym1, "D", (close[1] - close) * 100, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
    ff2Chg := request.security(ffSym2, "D", (close[1] - close) * 100, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
int   daysInMo = int((timestamp("UTC", month == 12 ? year + 1 : year, month == 12 ? 1 : month + 1, 1, 0, 0) - timestamp("UTC", year, month, 1, 0, 0)) / 86400000)
// Kuttner surprise: scale the front-month move by the share of the month still to run; near month end use the next contract unscaled
float surpBp  = not showPriced ? na : dayofmonth > daysInMo - 3 ? ff2Chg : na(ff1Chg) ? na : ff1Chg * daysInMo / (daysInMo - dayofmonth)

// ── Economic releases ────────────────────────────────────────────────────────
// CPI release dates (BLS archive): reference month → release date. 247 entries.
