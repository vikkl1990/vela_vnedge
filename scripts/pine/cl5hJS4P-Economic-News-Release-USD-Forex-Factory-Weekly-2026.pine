//@version=6
indicator("Economic News Release - USD Forex Factory Weekly V4.1", overlay = true)

// USD weekly economic calendar table.
// Replay-safe: week selection is anchored to the last chart/replay bar (`time`), never `timenow`.
//
// Impact model:
// 4 = RED / High
// 3 = ORANGE / Medium
// 2 = GRAY / Low
// 1 = SILVER / Holiday
//
// IMPORTANT:
// Pine Script cannot make arbitrary HTTP requests to Forex Factory.
// Calendar rows therefore have to be embedded. September 2026 was rebuilt from
// Forex Factory calendar data available on Sep 13, 2026. Later scheduled dates
// remain a snapshot and can change at the source.

string TZ = "America/New_York"
int DAY_MS = 24 * 60 * 60 * 1000

string GROUP_FILTERS = "1. USD News Filters"
bool showHigh    = input.bool(true, "Show RED / High impact", group = GROUP_FILTERS)
bool showMedium  = input.bool(true, "Show ORANGE / Medium impact", group = GROUP_FILTERS)
bool showLow     = input.bool(true, "Show GRAY / Low impact", group = GROUP_FILTERS)
bool showHoliday = input.bool(true, "Show SILVER / Holidays", group = GROUP_FILTERS)

string GROUP_TABLE = "2. Weekly News Table"
string weekChoice = input.string(
     "This Week",
     "Display Week",
     options = ["This Week", "Next Week"],
     tooltip = "Replay-safe. This Week follows the week containing the replay cursor's last available bar; Next Week advances one calendar week.",
     group = GROUP_TABLE
)

string tableLocation = input.string(
     "Bottom Center",
     "Table Location",
     options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"],
     group = GROUP_TABLE
)

int tableTransparency = input.int(25, "Event Row Transparency", minval = 0, maxval = 100, group = GROUP_TABLE)

string tableTextSize = input.string(
     "Tiny",
     "Table Text Size",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"],
     tooltip = "Controls the table text. The title automatically remains one size larger where possible.",
     group = GROUP_TABLE
)

var array<int> evTs = array.new_int()
var array<string> evName = array.new_string()
var array<int> evImpact = array.new_int()
var array<int> evWeek = array.new_int()
var array<string> evFixedTime = array.new_string()
var array<int> weekStarts = array.new_int()

f_addEvent(int ts, string eventName, int impact, int weekStart, string fixedTime) =>
    array.push(evTs, ts)
    array.push(evName, eventName)
    array.push(evImpact, impact)
    array.push(evWeek, weekStart)
    array.push(evFixedTime, fixedTime)

f_tablePosition(string location) =>
    switch location
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.bottom_center

f_textSize(string choice) =>
    switch choice
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.tiny

f_titleTextSize(string choice) =>
    switch choice
        "Tiny" => size.small
        "Small" => size.normal
        "Normal" => size.large
        "Large" => size.huge
        => size.huge

f_impactEnabled(int impact) =>
    impact == 4 ? showHigh :
     impact == 3 ? showMedium :
     impact == 2 ? showLow :
     showHoliday

f_impactText(int impact) =>
    impact == 4 ? "RED / High" :
     impact == 3 ? "ORANGE / Medium" :
     impact == 2 ? "GRAY / Low" :
     "SILVER / Holiday"

f_impactBg(int impact) =>
    impact == 4 ? color.new(color.red, tableTransparency) :
     impact == 3 ? color.new(color.orange, tableTransparency) :
     impact == 2 ? color.new(color.gray, tableTransparency) :
     color.new(color.silver, math.min(tableTransparency + 4, 100))

if barstate.isfirst
    array.push(weekStarts, timestamp(TZ, 2025, 12, 29, 0, 0))
    array.push(weekStarts, timestamp(TZ, 2026, 1, 5, 0, 0))
    array.push(weekStarts, timestamp(TZ, 2026, 1, 12, 0, 0))
