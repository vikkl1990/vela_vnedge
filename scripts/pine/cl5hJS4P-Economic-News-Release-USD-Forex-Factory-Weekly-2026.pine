f_weekIndexAt(int anchorTs) =>
    int selectedIndex = -1
    int count = array.size(weekStarts)
    if count > 0
        for i = 0 to count - 1
            int mondayStart = array.get(weekStarts, i)
            int sundayActivation = mondayStart - DAY_MS
            if anchorTs >= sundayActivation
                selectedIndex := i
    selectedIndex

f_countVisibleEvents(int selectedWeek) =>
    int matched = 0
    int count = array.size(evTs)
    if count > 0
        for i = 0 to count - 1
            int impact = array.get(evImpact, i)
            if array.get(evWeek, i) == selectedWeek and f_impactEnabled(impact)
                matched += 1
    matched

f_renderWeek(table target, int selectedWeek, string titleText) =>
    color titleBg = color.new(color.rgb(30, 45, 65), 18)
    color headerBg = color.new(color.rgb(36, 91, 132), 18)
    color headerText = color.white
    string bodySize = f_textSize(tableTextSize)
    string titleSize = f_titleTextSize(tableTextSize)

    table.cell(target, 0, 0, titleText, bgcolor = titleBg, text_color = headerText, text_size = titleSize)
    table.cell(target, 1, 0, str.format_time(selectedWeek, "MMM dd", TZ) + " - " + str.format_time(selectedWeek + 4 * DAY_MS, "MMM dd", TZ), bgcolor = titleBg, text_color = headerText, text_size = bodySize)
    table.cell(target, 2, 0, "USD", bgcolor = titleBg, text_color = headerText, text_size = bodySize)
    table.cell(target, 3, 0, "America/New_York", bgcolor = titleBg, text_color = headerText, text_size = bodySize)
    table.cell(target, 4, 0, str.format_time(selectedWeek, "yyyy", TZ), bgcolor = titleBg, text_color = headerText, text_size = bodySize)

    table.cell(target, 0, 1, "Day / Date", bgcolor = headerBg, text_color = headerText, text_size = bodySize)
    table.cell(target, 1, 1, "Time ET", bgcolor = headerBg, text_color = headerText, text_size = bodySize)
    table.cell(target, 2, 1, "USD Release", bgcolor = headerBg, text_color = headerText, text_size = bodySize)
    table.cell(target, 3, 1, "Impact Folder", bgcolor = headerBg, text_color = headerText, text_size = bodySize)
    table.cell(target, 4, 1, "Status", bgcolor = headerBg, text_color = headerText, text_size = bodySize)

    int row = 2
    int matched = 0
    int count = array.size(evTs)

    if count > 0
        for i = 0 to count - 1
            int impact = array.get(evImpact, i)
            if array.get(evWeek, i) == selectedWeek and f_impactEnabled(impact)
                int ts = array.get(evTs, i)
                string fixedTime = array.get(evFixedTime, i)
                string timeText = str.length(fixedTime) > 0 ? fixedTime : str.format_time(ts, "hh:mm a", TZ)
                color rowBg = f_impactBg(impact)
                color textColor = impact == 1 ? color.new(color.black, 0) : color.new(color.white, 0)

                table.cell(target, 0, row, str.format_time(ts, "EEE MMM dd", TZ), bgcolor = rowBg, text_color = textColor, text_size = bodySize)
                table.cell(target, 1, row, timeText, bgcolor = rowBg, text_color = textColor, text_size = bodySize)
                table.cell(target, 2, row, array.get(evName, i), bgcolor = rowBg, text_color = textColor, text_size = bodySize)
                table.cell(target, 3, row, f_impactText(impact), bgcolor = rowBg, text_color = textColor, text_size = bodySize)
                table.cell(target, 4, row, impact == 1 ? "Market holiday" : "Economic calendar", bgcolor = rowBg, text_color = textColor, text_size = bodySize)

                row += 1
                matched += 1

    if matched == 0
        table.cell(target, 0, 2, "No selected USD calendar records embedded for this week.", bgcolor = color.new(color.gray, 88), text_color = color.white, text_size = bodySize)
        table.cell(target, 1, 2, "", bgcolor = color.new(color.gray, 88))
        table.cell(target, 2, 2, "", bgcolor = color.new(color.gray, 88))
        table.cell(target, 3, 2, "", bgcolor = color.new(color.gray, 88))
        table.cell(target, 4, 2, "", bgcolor = color.new(color.gray, 88))

var table newsTable = na

if barstate.islast
    // In Bar Replay, `time` is the last available replay bar's timestamp.
    int replayAnchor = time
    int thisWeekIndex = f_weekIndexAt(replayAnchor)
    int selectedIndex = weekChoice == "Next Week" ? thisWeekIndex + 1 : thisWeekIndex
    int lastIndex = array.size(weekStarts) - 1
    string tableTitle = weekChoice == "Next Week" ? "Next Week USD News" : "This Week USD News"

    // Pine table dimensions are set when the table is created.
    // Recreate it at the exact required height so there are no unused blank rows.
    if not na(newsTable)
        table.delete(newsTable)

    if selectedIndex >= 0 and selectedIndex <= lastIndex
        int selectedWeek = array.get(weekStarts, selectedIndex)
        int visibleEvents = f_countVisibleEvents(selectedWeek)
        int requiredRows = visibleEvents > 0 ? visibleEvents + 2 : 3

        newsTable := table.new(
             f_tablePosition(tableLocation),
             5,
             requiredRows,
             frame_color = color.new(color.silver, 70),
             frame_width = 1,
             border_color = color.new(color.silver, 85),
             border_width = 1
        )

        f_renderWeek(newsTable, selectedWeek, tableTitle)
    else
        newsTable := table.new(
             f_tablePosition(tableLocation),
             5,
             1,
             frame_color = color.new(color.silver, 70),
             frame_width = 1,
             border_color = color.new(color.silver, 85),
             border_width = 1
        )
        table.cell(newsTable, 0, 0, "No calendar week available", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = f_textSize(tableTextSize))

