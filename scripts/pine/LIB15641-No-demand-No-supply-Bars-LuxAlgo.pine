//@version=6
indicator("No-demand / No-supply Bars"
  , shorttitle       = "No-demand / No-supply Bars"
  , overlay          = true
  , max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MODE_TREND = "Moving Average Trend"
MODE_NONE  = "None"

TYPE_SMA = "SMA"
TYPE_EMA = "EMA"

SIZE_TINY   = "Tiny"
SIZE_SMALL  = "Small"
SIZE_NORMAL = "Normal"

color BULL_COLOR    = #089981
color BEAR_COLOR    = #f23645
color NEUTRAL_COLOR = #787b86

color LABEL_BG = #00000000

//Transparency of the ghost tags used for unqualified detections, and of the context average line
int GHOST_TRANSPARENCY   = 45
int CONTEXT_TRANSPARENCY = 60

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
spreadLengthInput = input.int(20, "Spread Average Length", minval = 2, maxval = 500, group = "Bar Detection",
  tooltip = "Bars used to build the average spread (high - low). A bar counts as narrow only against this rolling average, so the read stays relative to the instrument's own recent prints rather than any absolute number.")

narrowSpreadInput = input.float(1, "Narrow Spread Threshold", minval = 0.1, maxval = 2, step = 0.05, group = "Bar Detection",
  tooltip = "Fraction of the average spread the bar must stay below to count as narrow. 1 demands a spread below the recent average; lower values demand progressively tighter bars and rarer prints. VSA authors vary on the exact cutoff, so it is an explicit parameter rather than a hidden constant.")

backgroundModeInput = input.string(MODE_TREND, "Background Filter", options = [MODE_TREND, MODE_NONE], group = "Background Context",
  tooltip = "VSA reads neither bar in isolation, only against the background. 'Moving Average Trend' qualifies no-supply only when the close holds above the context average (background strength - the pullback used to time longs) and no-demand only when it holds below (background weakness - the rally to sell into). 'None' treats every detection as qualified.")

contextTypeInput = input.string(TYPE_EMA, "Context Average", options = [TYPE_SMA, TYPE_EMA], inline = "context", group = "Background Context",
  tooltip = "Average family used for the background trend read.")

contextLengthInput = input.int(50, "Length", minval = 2, maxval = 500, inline = "context", group = "Background Context",
  tooltip = "Context average length. Longer settings demand a more mature background before a detection qualifies.")

nsColorInput = input.color(BULL_COLOR, "No-Supply", inline = "colors", group = "Style",
  tooltip = "No-supply color - a down bar with nothing behind it: sellers failed to appear on the dip (bullish implication against background strength).")

ndColorInput = input.color(BEAR_COLOR, "No-Demand", inline = "colors", group = "Style",
  tooltip = "No-demand color - an up bar no professional money chased (bearish implication against background weakness).")

labelSizeInput = input.string(SIZE_TINY, "Tag Size", options = [SIZE_TINY, SIZE_SMALL, SIZE_NORMAL], group = "Style",
  tooltip = "Size of the ND and NS tags.")

showUnqualifiedInput = input.bool(false, "Ghost Unqualified Detections", group = "Style",
  tooltip = "Also tags detections printed against the wrong background, as faded ghost marks. VSA treats them as information, not signals - a low-volume dip inside a genuine downtrend is normal and proves nothing.")

showConfirmInput = input.bool(true, "Mark Next-Bar Confirmations", group = "Style",
  tooltip = "Marks the confirmation VSA commonly waits for before acting: an up close on the bar after a no-supply bar (the successful test), a down close on the bar after a no-demand bar. Triangles print on the confirming bar.")

showContextInput = input.bool(true, "Show Context Average", group = "Style",
  tooltip = "Plots the context average tinted by the background it reports - no-supply color while the close holds above it (strength), no-demand color below it (weakness). Hidden when the background filter is 'None'.")

colorBarsInput = input.bool(false, "Color Qualified Bars", group = "Style",
  tooltip = "Additionally paints the price bars that print a qualified detection.")

labelSize = labelSizeInput == SIZE_TINY ? size.tiny : labelSizeInput == SIZE_NORMAL ? size.normal : size.small

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
//Tags a detection bar - qualified prints as a filled label, unqualified as a faded ghost tag
tagBar(bool isNoDemand, bool qualified, string bgText, float relSpread, float relVolume) =>
    color sideColor = isNoDemand ? ndColorInput : nsColorInput
    label.new(bar_index, isNoDemand ? high : low, isNoDemand ? "ND" : "NS"
      , style     = isNoDemand ? label.style_label_down : label.style_label_up
      , color     = qualified ? sideColor : LABEL_BG
      , textcolor = qualified ? chart.bg_color : color.new(sideColor, GHOST_TRANSPARENCY)
      , size      = labelSize
      , tooltip   = (isNoDemand ? "No-demand bar" : "No-supply bar")
      + (qualified ? "" : " - unqualified, background out of line")
      + "\n" + (isNoDemand ? "Up" : "Down") + " close on a narrow spread, volume below both prior bars"
      + "\nSpread: " + str.tostring(100 * relSpread, "#") + "% of average"
      + "\nVolume: " + str.tostring(100 * relVolume, "#") + "% of the lower prior-two print"
      + "\nBackground: " + bgText)

//---------------------------------------------------------------------------------------------------------------------}
// Bar Detection
//---------------------------------------------------------------------------------------------------------------------{
barSpread = high - low

//Rolling baselines, computed unconditionally on every bar
averageSpread = ta.sma(barSpread, spreadLengthInput)
contextSma    = ta.sma(close, contextLengthInput)
contextEma    = ta.ema(close, contextLengthInput)

contextAverage = contextTypeInput == TYPE_EMA ? contextEma : contextSma
useContext     = backgroundModeInput == MODE_TREND

//Classic VSA bar tests
upClose   = not na(close[1]) and close > close[1]
downClose = not na(close[1]) and close < close[1]

narrowSpread = not na(averageSpread) and barSpread < averageSpread * narrowSpreadInput

lowVolume = not na(volume) and not na(volume[2]) and volume < volume[1] and volume < volume[2]

//Bar classifications - settled on completed bars only, VSA reads the finished print
noDemand = barstate.isconfirmed and upClose and narrowSpread and lowVolume
noSupply = barstate.isconfirmed and downClose and narrowSpread and lowVolume

//Measured signature, reported in the tags and the data window
spreadRatio      = not na(averageSpread) and averageSpread > 0 ? barSpread / averageSpread : na
lowerPriorVolume = math.min(nz(volume[1]), nz(volume[2]))
volumeRatio      = lowerPriorVolume > 0 ? volume / lowerPriorVolume : na

//---------------------------------------------------------------------------------------------------------------------}
// Background Grading & Confirmation
//---------------------------------------------------------------------------------------------------------------------{
backgroundStrength = not na(contextAverage) and close > contextAverage
backgroundWeakness = not na(contextAverage) and close < contextAverage

//A bar means nothing on its own - no-supply is graded against background strength, no-demand against weakness
qualifiedNoDemand = noDemand and (not useContext or backgroundWeakness)
qualifiedNoSupply = noSupply and (not useContext or backgroundStrength)

//Next-bar close confirmation - back up after no-supply (the successful test), down after no-demand
noDemandConfirmed = bar_index > 0 and qualifiedNoDemand[1] and barstate.isconfirmed and downClose
noSupplyConfirmed = bar_index > 0 and qualifiedNoSupply[1] and barstate.isconfirmed and upClose

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
backgroundText = not useContext ? "filter off - every detection qualifies"
  : backgroundStrength ? "strength - close above the context average"
  : backgroundWeakness ? "weakness - close below the context average"
  : "undetermined"

if noDemand and (qualifiedNoDemand or showUnqualifiedInput)
    tagBar(true, qualifiedNoDemand, backgroundText, spreadRatio, volumeRatio)

if noSupply and (qualifiedNoSupply or showUnqualifiedInput)
    tagBar(false, qualifiedNoSupply, backgroundText, spreadRatio, volumeRatio)

//Context average, tinted by the background it reports
contextColor = backgroundStrength ? color.new(nsColorInput, CONTEXT_TRANSPARENCY)
  : backgroundWeakness ? color.new(ndColorInput, CONTEXT_TRANSPARENCY)
  : color.new(NEUTRAL_COLOR, CONTEXT_TRANSPARENCY)

plot(useContext and showContextInput ? contextAverage : na, "Context Average", contextColor, 1, plot.style_line)

//Next-bar confirmations on the confirming bar
plotshape(showConfirmInput and noDemandConfirmed, "No-Demand Confirmation", shape.triangledown, location.abovebar, ndColorInput, size = size.tiny)
plotshape(showConfirmInput and noSupplyConfirmed, "No-Supply Confirmation", shape.triangleup, location.belowbar, nsColorInput, size = size.tiny)

//Optional candle coloring; the measured signature is reported in the data window
barcolor(colorBarsInput and qualifiedNoDemand ? ndColorInput : colorBarsInput and qualifiedNoSupply ? nsColorInput : na, title = "Qualified No-demand / No-supply Bars")

plot(spreadRatio, "Spread / Average Spread", color = NEUTRAL_COLOR, display = display.data_window)
plot(volumeRatio, "Volume / Lower Prior-Two Volume", color = NEUTRAL_COLOR, display = display.data_window)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(qualifiedNoDemand, "No-Demand Bar", "No-demand bar - up close on a narrow spread with volume below both prior bars; the rally lacks professional buying")
alertcondition(qualifiedNoSupply, "No-Supply Bar", "No-supply bar - down close on a narrow spread with volume below both prior bars; the dip lacks real selling")
alertcondition(noDemandConfirmed, "No-Demand Confirmed", "Down close on the bar following a no-demand bar - the weakness read is confirmed")
alertcondition(noSupplyConfirmed, "No-Supply Confirmed", "Up close on the bar following a no-supply bar - the test succeeded, sellers failed to appear on the dip")

//---------------------------------------------------------------------------------------------------------------------}
