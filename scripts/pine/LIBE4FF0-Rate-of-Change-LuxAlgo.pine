//@version=6
indicator("Rate of Change", "ROC", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // reading above zero - source above its value from the lookback
BEAR_COLOR    = #f23645 // reading below zero
NEUTRAL_COLOR = #787b86 // zero line and a reading exactly at zero

FILL_LINE_TRANSP = 50  // gradient transparency at the line end of the fill
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero end of the fill
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(9, "Length", minval = 1, group = "Settings", tooltip = "Lookback period, the source is compared with its value this many bars ago")
srcInput = input.source(close, "Source", group = "Settings", tooltip = "Series used as input for the calculation")
modeInput = input.string("ROC %", "Mode", options = ["ROC %", "Momentum"], group = "Settings", tooltip = "ROC % plots the change as a percentage of the source value from the lookback, Momentum plots the raw difference")

lineColorInput = input.color(NEUTRAL_COLOR, "Line", group = "Style", tooltip = "Color of the rate of change line when the reading sits exactly at zero")
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "state", group = "Style", tooltip = "Color of the line and fill while the reading is above zero")
bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "state", group = "Style", tooltip = "Color of the line and fill while the reading is below zero")
showFillInput  = input.bool(true, "Gradient Fill", group = "Style", tooltip = "Fills the area between the line and zero, following the line color")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
rocValue = ta.roc(srcInput, lengthInput)
momValue = ta.mom(srcInput, lengthInput)

oscValue = switch modeInput
    "ROC %"    => rocValue
    "Momentum" => momValue
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
lineColor = na(oscValue) ? lineColorInput : oscValue > 0 ? bullColorInput : oscValue < 0 ? bearColorInput : lineColorInput

rocPlotId  = plot(oscValue, "ROC", lineColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

fill(rocPlotId, zeroPlotId, top_value = oscValue, bottom_value = 0, top_color = showFillInput ? color.new(lineColor, FILL_LINE_TRANSP) : color(na), bottom_color = showFillInput ? color.new(lineColor, FILL_ZERO_TRANSP) : color(na), title = "ROC Gradient")

hline(0, "Zero Line", color = NEUTRAL_COLOR, linestyle = hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
crossUp = ta.crossover(oscValue, 0)
crossDown = ta.crossunder(oscValue, 0)

alertcondition(crossUp, "Zero Cross Up", "Rate of Change crossed above the zero line")
alertcondition(crossDown, "Zero Cross Down", "Rate of Change crossed below the zero line")
//----------------------------------------------------------------------------------------------------------------------}
