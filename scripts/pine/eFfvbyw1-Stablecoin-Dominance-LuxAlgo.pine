//@version=5
indicator("Stablecoin Dominance [LuxAlgo]", "LuxAlgo - Stablecoin Dominance", format = format.percent, overlay = true, scale = scale.none)
//----------------------------------------------------------------------------------------------------------------------
//Settings
//---------------------------------------------------------------------------------------------------------------------{
fillStyle = input.string('Gradient', 'Fill Style', options = ['Gradient', 'Solid', 'None'])

showUsdt = input(true, 'USDT', inline = 'usdt')
usdtCss  = input(#089981, '', inline = 'usdt')

showUsdc = input(true, 'USDC', inline = 'usdc')
usdcCss  = input(#2962ff, '', inline = 'usdc')

showBusd = input(true, 'BUSD', inline = 'busd')
busdCss  = input(#faad14, '', inline = 'busd')

showDai  = input(true, 'DAI  ', inline = 'dai' )
daiCss  = input(#9c27b0, '', inline = 'dai')

showTusd = input(true, 'TUSD', inline = 'tusd')
tusdCss  = input(#2b2e7f, '', inline = 'tusd')

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
return_na(x) => x == 0 or x == 100 ? 0 : x

//---------------------------------------------------------------------------------------------------------------------}
//Get data
//---------------------------------------------------------------------------------------------------------------------{
usdt = nz(request.security('USDT_SUPPLY', 'D', showUsdt ? close : 0))
usdc = nz(request.security('USDC_SUPPLY', 'D', showUsdc ? close : 0))
busd = nz(request.security('BUSD_SUPPLY', 'D', showBusd ? close : 0))
dai  = nz(request.security('DAI_SUPPLY' , 'D', showDai  ? close : 0))
tusd = nz(request.security('TUSD_MARKETCAPREAL/CRYPTO:TUSDUSD', 'D', showTusd ? close : 0))

//---------------------------------------------------------------------------------------------------------------------}
//Compute dominance
//---------------------------------------------------------------------------------------------------------------------{
sum = usdt + usdc + tusd + dai + busd
dominances = array.new<float>(0)

//Dominances
usdt_d = return_na(usdt / sum * 100)
usdc_d = return_na(usdc / sum * 100)
busd_d = return_na(busd / sum * 100)
dai_d  = return_na(dai  / sum * 100)
tusd_d = return_na(tusd / sum * 100)

//Sort dominances
dominances.push(usdt_d)
dominances.push(usdc_d)
dominances.push(busd_d)
dominances.push(dai_d)
dominances.push(tusd_d)

dominances.sort(order.descending)

//Get sorted dominances
a = dominances.get(0)
b = dominances.get(1)
c = dominances.get(2)
d = dominances.get(3)
e = dominances.get(4)

//---------------------------------------------------------------------------------------------------------------------}
//Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var tb = table.new(position.top_right, 2, 5, na)

if barstate.isfirst
    tb.cell(0, 0, 'USDT', text_color = usdtCss, text_size = size.small, text_halign = text.align_left)
    tb.cell(0, 1, 'USDC', text_color = usdcCss, text_size = size.small, text_halign = text.align_left)
    tb.cell(0, 2, 'BUSD', text_color = busdCss, text_size = size.small, text_halign = text.align_left)
    tb.cell(0, 3, 'DAI' , text_color = daiCss , text_size = size.small, text_halign = text.align_left)
    tb.cell(0, 4, 'TUSD', text_color = tusdCss, text_size = size.small, text_halign = text.align_left)

if barstate.islast
    tb.cell(1, 0, str.tostring(usdt_d, format.percent), text_color = usdtCss, text_size = size.small, text_halign = text.align_right)
    tb.cell(1, 1, str.tostring(usdc_d, format.percent), text_color = usdcCss, text_size = size.small, text_halign = text.align_right)
    tb.cell(1, 2, str.tostring(busd_d, format.percent), text_color = busdCss, text_size = size.small, text_halign = text.align_right)
    tb.cell(1, 3, str.tostring(dai_d , format.percent), text_color = daiCss , text_size = size.small, text_halign = text.align_right)
    tb.cell(1, 4, str.tostring(tusd_d, format.percent), text_color = tusdCss, text_size = size.small, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
//Plots
//---------------------------------------------------------------------------------------------------------------------{
//Comparison function to color areas
compare(a, color_fillStyle, transp)=>
    color css = na

    if fillStyle != color_fillStyle
        css := na
    else if a > 0
        css := switch a
            usdt_d => color.new(usdtCss, transp)
            usdc_d => color.new(usdcCss, transp)
            busd_d => color.new(busdCss, transp)
            dai_d  => color.new(daiCss , transp)
            tusd_d => color.new(tusdCss, transp)
            => color.new(chart.bg_color, 100)

//Dominances plots
plot(usdt_d, 'USDT', color = usdt_d[1] == 0 ? na : usdtCss)
plot(usdc_d, 'USDC', color = usdc_d[1] == 0 ? na : usdcCss)
plot(busd_d, 'BUSD', color = busd_d[1] == 0 ? na : busdCss)
plot(dai_d , 'DAI' , color = dai_d[1] == 0  ? na : daiCss)
plot(tusd_d, 'TUSD', color = tusd_d[1] == 0 ? na : tusdCss)

//Dummy fill plots
plot_a = plot(a, '1st', color = na, display = display.none)
plot_b = plot(b, '2nd', color = na, display = display.none)
plot_c = plot(c, '3rd', color = na, display = display.none)
plot_d = plot(d, '4th', color = na, display = display.none)
plot_e = plot(e, '5th', color = na, display = display.none)
plot_0 = plot(0, '6th', color = na, display = display.none)

//Solid fill
fill(plot_a, plot_b, color = compare(a, 'Solid', 80))
fill(plot_b, plot_c, color = compare(b, 'Solid', 80))
fill(plot_c, plot_d, color = compare(c, 'Solid', 80))
fill(plot_d, plot_e, color = compare(d, 'Solid', 80))
fill(plot_e, plot_0, color = compare(e, 'Solid', 80))

//Gradient fill
fill(plot_a, plot_b, top_value = a, bottom_value = b, top_color = compare(a, 'Gradient', 80), bottom_color = compare(b, 'Gradient', 80))
fill(plot_b, plot_c, top_value = b, bottom_value = c, top_color = compare(b, 'Gradient', 80), bottom_color = compare(c, 'Gradient', 80))
fill(plot_c, plot_d, top_value = c, bottom_value = d, top_color = compare(c, 'Gradient', 80), bottom_color = compare(d, 'Gradient', 80))
fill(plot_d, plot_e, top_value = d, bottom_value = e, top_color = compare(d, 'Gradient', 80), bottom_color = compare(e, 'Gradient', 80))
fill(plot_e, plot_0, top_value = e, bottom_value = 0, top_color = compare(e, 'Gradient', 80), bottom_color = compare(0, 'Gradient', 80))

//Comparison lines
n = bar_index

for l in line.all
    l.delete()

if barstate.islast
    line.new(n + 10, a, n + 10, b, color = compare(a, fillStyle, 0))
    line.new(n + 20, b, n + 20, c, color = compare(b, fillStyle, 0))
    line.new(n + 30, c, n + 30, d, color = compare(c, fillStyle, 0))
    line.new(n + 40, d, n + 40, e, color = compare(d, fillStyle, 0))
    line.new(n + 50, e, n + 50, 0, color = compare(e, fillStyle, 0))

//---------------------------------------------------------------------------------------------------------------------}