//@version=6
indicator("Hurst Exponent", shorttitle = "Hurst Exponent", overlay = false, format = format.price, precision = 3)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
TREND_COLOR   = #089981 // persistence - trend-following logic has statistical footing
REVERT_COLOR  = #ff9800 // anti-persistence - the one accent, fading has footing
NEUTRAL_COLOR = #787b86 // random-walk band and neutral readings

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

BAND_TRANSP = 92        // transparency of the neutral band shading

MID_LEVEL     = 0.5     // random-walk benchmark for the exponent
MIN_SUBSAMPLE = 8       // smallest dyadic subsample length in the rescaled-range cascade

FILL_VALUE_TRANSP = 50  // gradient transparency at the exponent value
FILL_MID_TRANSP   = 100 // gradient transparency at the 0.5 benchmark

LOG_RETURNS = "Log Returns"
DIFFERENCES = "Simple Differences"

SMA_TYPE = "SMA"
EMA_TYPE = "EMA"
RMA_TYPE = "RMA"
WMA_TYPE = "WMA"

TOP_RIGHT    = "Top Right"
TOP_LEFT     = "Top Left"
BOTTOM_RIGHT = "Bottom Right"
BOTTOM_LEFT  = "Bottom Left"

TINY_SIZE   = "Tiny"
SMALL_SIZE  = "Small"
NORMAL_SIZE = "Normal"

EPSILON = 1e-12

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput          = input.source(close, "Source", group = "Hurst Exponent",
     tooltip = "Series the exponent is estimated on. The rescaled-range analysis runs on this series' increments.")

lengthInput       = input.int(128, "Sample Length", minval = 32, maxval = 512, group = "Hurst Exponent",
     tooltip = "Rolling window size n - the number of increments each estimate is computed on. The window is split into dyadic subsample sizes (8, 16, 32, ... up to n) for the log R/S versus log size regression. R/S analysis needs substantial data: longer windows are steadier but adapt more slowly, and readings on trading-sized windows remain tendencies, not precise numbers.")

incrementsInput   = input.string(LOG_RETURNS, "Increments", options = [LOG_RETURNS, DIFFERENCES], group = "Hurst Exponent",
     tooltip = "Differencing applied to the source before analysis. Log returns are the standard choice for prices; simple differences stay defined for series that can be zero or negative.")

smoothTypeInput   = input.string(SMA_TYPE, "Smoothing Method", options = [SMA_TYPE, EMA_TYPE, RMA_TYPE, WMA_TYPE], group = "Hurst Exponent",
     tooltip = "Moving average family applied to the raw exponent. Raw rolling estimates jump from bar to bar, so the smoothed series carries the regime read and drives the alerts.")

smoothLengthInput = input.int(5, "Smoothing Length", minval = 1, maxval = 200, group = "Hurst Exponent",
     tooltip = "Length of the smoothing applied to the raw exponent. 1 follows the raw estimate exactly.")

bandInput         = input.float(0.05, "Neutral Band Width", minval = 0, maxval = 0.25, step = 0.01, group = "Regime",
     tooltip = "Half-width of the noise band around the 0.5 random-walk benchmark. Estimation error on rolling windows is substantial, so small deviations from 0.5 are read as noise rather than signal: no trending or mean-reverting regime is called until the smoothed H clears the band.")

showDashInput     = input.bool(true, "Show Dashboard", group = "Dashboard",
     tooltip = "Displays a summary panel quoting the current reading alongside its estimation method, the log-log fit quality and the active regime - different estimators and windows give different values, so H is best read with its method.")

dashLocInput      = input.string(TOP_RIGHT, "Location", options = [TOP_RIGHT, TOP_LEFT, BOTTOM_RIGHT, BOTTOM_LEFT], inline = "dash", group = "Dashboard",
     tooltip = "Position of the dashboard on the chart.")

dashSizeInput     = input.string(SMALL_SIZE, "Size", options = [TINY_SIZE, SMALL_SIZE, NORMAL_SIZE], inline = "dash", group = "Dashboard",
     tooltip = "Text size of the dashboard.")

trendColorInput   = input.color(TREND_COLOR, "Trending (H > 0.5)", group = "Style",
     tooltip = "Color used when the smoothed H sits above the neutral band - persistent increments, trending character.")

revertColorInput  = input.color(REVERT_COLOR, "Mean-Reverting (H < 0.5)", group = "Style",
     tooltip = "Color used when the smoothed H sits below the neutral band - anti-persistent increments, mean-reverting character.")

neutralColorInput = input.color(NEUTRAL_COLOR, "Random Walk / Neutral", group = "Style",
     tooltip = "Color used inside the neutral band, for the band itself and for the raw estimate.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the 0.5 benchmark and the smoothed H with a vertical gradient, fully transparent at 0.5 and strongest at the current value.")

showRawInput      = input.bool(false, "Show Raw Estimate", group = "Style",
     tooltip = "Plots the unsmoothed per-bar estimate behind the smoothed line to visualize how much raw readings jump.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Table corner from the dashboard position option
tableLocation(string positionText) =>
    switch
        positionText == TOP_RIGHT    => position.top_right
        positionText == TOP_LEFT     => position.top_left
        positionText == BOTTOM_RIGHT => position.bottom_right
        => position.bottom_left

// Table text size from the dashboard size option
tableTextSize(string sizeText) =>
    switch
        sizeText == TINY_SIZE  => size.tiny
        sizeText == SMALL_SIZE => size.small
        => size.normal

// Classical rescaled-range (R/S) estimate of the Hurst exponent. For each dyadic subsample
// size (n, n/2, n/4, ... down to MIN_SUBSAMPLE) the sample is cut into contiguous subsamples;
// each contributes the range of its cumulative deviations from the subsample mean divided by
// its standard deviation, and the sizes' average R/S values feed an OLS fit of log(R/S)
// against log(size). The fitted slope is H. Returns the slope, the fit's R-squared and the
// number of regression points
rescaledRangeHurst(array<float> sample) =>
    int sampleSize = sample.size()
    array<float> logSizeValues = array.new<float>()
    array<float> logRsValues   = array.new<float>()
    int subSize = sampleSize
    while subSize >= MIN_SUBSAMPLE
        int subCount = math.floor(sampleSize / subSize)
        float rsSum  = 0.0
        int rsCount  = 0
        for sub = 0 to subCount - 1
            int head = sub * subSize
            float meanSum = 0.0
            for i = head to head + subSize - 1
                meanSum += sample.get(i)
            float subMean = meanSum / subSize
            float runSum = 0.0
            float runMax = 0.0
            float runMin = 0.0
            float varSum = 0.0
            for i = head to head + subSize - 1
                float deviation = sample.get(i) - subMean
                runSum += deviation
                runMax := math.max(runMax, runSum)
                runMin := math.min(runMin, runSum)
                varSum += deviation * deviation
            float sigma = math.sqrt(varSum / subSize)
            if sigma > EPSILON
                rsSum   += (runMax - runMin) / sigma
                rsCount += 1
        if rsCount > 0
            float meanRs = rsSum / rsCount
            if meanRs > EPSILON
                logSizeValues.push(math.log(subSize))
                logRsValues.push(math.log(meanRs))
        subSize := math.floor(subSize / 2)
    int pointCount = logSizeValues.size()
    float slopeH = na
    float fitR2  = na
    if pointCount >= 2
        float meanX = logSizeValues.avg()
        float meanY = logRsValues.avg()
        float sumXx = 0.0
        float sumXy = 0.0
        float sumYy = 0.0
        for i = 0 to pointCount - 1
            float dx = logSizeValues.get(i) - meanX
            float dy = logRsValues.get(i) - meanY
            sumXx += dx * dx
            sumXy += dx * dy
            sumYy += dy * dy
        if sumXx > EPSILON
            slopeH := sumXy / sumXx
            fitR2  := sumYy > EPSILON ? sumXy * sumXy / (sumXx * sumYy) : 1.0
    [slopeH, fitR2, pointCount]

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Increment series - log returns are the standard differencing for prices; simple
// differences remain defined for series that can be zero or negative
float increment = switch
    incrementsInput == LOG_RETURNS => srcInput > 0 and srcInput[1] > 0 ? math.log(srcInput / srcInput[1]) : na
    => srcInput - srcInput[1]

// Rolling sample - the most recent valid increments, capped at the sample length
var array<float> incrementArray = array.new<float>()

if not na(increment)
    incrementArray.push(increment)
    if incrementArray.size() > lengthInput
        incrementArray.shift()

// Raw exponent, log-log fit quality and regression point count, once the window is full
[hurstRaw, hurstFitR2, hurstFitPoints] = if incrementArray.size() == lengthInput
    rescaledRangeHurst(incrementArray)
else
    [float(na), float(na), 0]

// Smoothed reading - raw rolling estimates jump, so the smoothed series carries the regime read
float hurstSma = ta.sma(hurstRaw, smoothLengthInput)
float hurstEma = ta.ema(hurstRaw, smoothLengthInput)
float hurstRma = ta.rma(hurstRaw, smoothLengthInput)
float hurstWma = ta.wma(hurstRaw, smoothLengthInput)

float hurstValue = switch
    smoothTypeInput == EMA_TYPE => hurstEma
    smoothTypeInput == RMA_TYPE => hurstRma
    smoothTypeInput == WMA_TYPE => hurstWma
    => hurstSma

float upperBand = MID_LEVEL + bandInput
float lowerBand = MID_LEVEL - bandInput

// Regime state: +1 persistent/trending above the band, -1 anti-persistent/mean-reverting
// below it, 0 inside - where past direction carries no usable information
int regimeState = na(hurstValue) ? 0 : hurstValue > upperBand ? 1 : hurstValue < lowerBand ? -1 : 0

bool trendingShift  = regimeState == 1  and nz(regimeState[1]) != 1
bool revertingShift = regimeState == -1 and nz(regimeState[1]) != -1
bool randomShift    = regimeState == 0  and nz(regimeState[1]) != 0 and not na(hurstValue)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
color regimeColor = regimeState == 1 ? trendColorInput : regimeState == -1 ? revertColorInput : neutralColorInput

bool aboveMid = nz(hurstValue, MID_LEVEL) >= MID_LEVEL

color sideColor      = aboveMid ? trendColorInput : revertColorInput
color valueFillColor = gradientInput ? color.new(sideColor, FILL_VALUE_TRANSP) : na
color midFillColor   = gradientInput ? color.new(sideColor, FILL_MID_TRANSP) : na

plot(showRawInput ? hurstRaw : na, "Raw Estimate", color = color.new(neutralColorInput, 60), linewidth = 1, style = plot.style_linebr)

hurstPlotId = plot(hurstValue, "Hurst Exponent", color = regimeColor, linewidth = 2, style = plot.style_linebr)
midPlotId   = plot(MID_LEVEL, "Random-Walk Benchmark (0.5)", color = color.new(NEUTRAL_COLOR, 50), linewidth = 1)

fill(hurstPlotId, midPlotId, top_value = math.max(hurstValue, MID_LEVEL), bottom_value = math.min(hurstValue, MID_LEVEL), top_color = aboveMid ? valueFillColor : midFillColor, bottom_color = aboveMid ? midFillColor : valueFillColor, title = "Persistence Gradient Fill")

upperHlineId = hline(MID_LEVEL + bandInput, "Trending Threshold", color = color.new(trendColorInput, 60), linestyle = hline.style_dashed)
lowerHlineId = hline(MID_LEVEL - bandInput, "Mean-Reversion Threshold", color = color.new(revertColorInput, 60), linestyle = hline.style_dashed)

// neutral band shading anchored on hidden plots
upperBandPlotId = plot(upperBand, "Upper Band Anchor", color = color(na), editable = false, display = display.none)
lowerBandPlotId = plot(lowerBand, "Lower Band Anchor", color = color(na), editable = false, display = display.none)

fill(upperBandPlotId, lowerBandPlotId, color = color.new(neutralColorInput, BAND_TRANSP), title = "Neutral Band")

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashboardTable = na

if barstate.islast and showDashInput
    if na(dashboardTable)
        dashboardTable := table.new(tableLocation(dashLocInput), 2, 5, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

    string textSize  = tableTextSize(dashSizeInput)
    color labelColor = DASH_HEADER
    color valueColor = DASH_TEXT

    bool hurstValid   = not na(hurstValue)
    string hurstText  = hurstValid ? str.tostring(hurstValue, "0.000") : "n/a"
    string regimeText = not hurstValid ? "n/a" : regimeState == 1 ? "Trending" : regimeState == -1 ? "Mean Reverting" : "Random Walk"
    string fitText    = na(hurstFitR2) ? "n/a" : str.tostring(hurstFitR2, "0.00")
    string windowText = incrementArray.size() < lengthInput ? str.tostring(incrementArray.size()) + " / " + str.tostring(lengthInput) + " bars" : str.tostring(lengthInput) + " bars, " + str.tostring(hurstFitPoints) + " sizes"
    color readColor   = hurstValid ? regimeColor : labelColor

    table.cell(dashboardTable, 0, 0, "Method", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 0, "Rescaled Range (R/S)", text_color = valueColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 1, "Hurst (H)", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 1, hurstText, text_color = readColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 2, "Regime", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 2, regimeText, text_color = readColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 3, "Fit R²", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 3, fitText, text_color = valueColor, text_size = textSize, text_halign = text.align_right)
    table.cell(dashboardTable, 0, 4, "Window", text_color = labelColor, text_size = textSize, text_halign = text.align_left)
    table.cell(dashboardTable, 1, 4, windowText, text_color = valueColor, text_size = textSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(trendingShift, "Trending Regime", "Hurst Exponent on {{ticker}}: the smoothed H crossed above the neutral band - persistent increments, readings above 0.5 support trend-following logic ({{interval}})")
alertcondition(revertingShift, "Mean-Reverting Regime", "Hurst Exponent on {{ticker}}: the smoothed H crossed below the neutral band - anti-persistent increments, readings below 0.5 favor fading and mean reversion ({{interval}})")
alertcondition(randomShift, "Random-Walk Zone", "Hurst Exponent on {{ticker}}: the smoothed H moved back inside the neutral band around 0.5 - random-walk territory, neither playbook has statistical footing ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
