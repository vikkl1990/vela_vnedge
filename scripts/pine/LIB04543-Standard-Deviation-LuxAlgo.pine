//@version=6
indicator("Standard Deviation", "StdDev", overlay = false, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR = #787b86 // contracting or flat volatility - structure
ACCENT_COLOR  = #ff9800 // expanding volatility - the reading to look at
FILL_TRANSP   = 80      // gradient transparency at the line end of the fill
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 1, group = "Settings", tooltip = "Number of bars used to compute the standard deviation.")
sourceInput = input.source(close, "Source", group = "Settings", tooltip = "Price series the standard deviation is calculated on.")

lineColorInput = input.color(NEUTRAL_COLOR, "Standard Deviation", group = "Style", tooltip = "Color of the standard deviation line while volatility contracts or holds flat.")
expandColorInput = input.color(ACCENT_COLOR, "Expanding", group = "Style", tooltip = "Color of the standard deviation line and fill while volatility expands bar to bar.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
stdDev = ta.stdev(sourceInput, lengthInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// Expanding volatility takes the accent, contracting volatility stays structural grey
stdDevColor = stdDev > nz(stdDev[1], stdDev) ? expandColorInput : lineColorInput

stdDevPlotId = plot(stdDev, "Standard Deviation", color = stdDevColor)
zeroPlotId   = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

fill(stdDevPlotId, zeroPlotId, top_value = stdDev, bottom_value = 0, top_color = color.new(stdDevColor, FILL_TRANSP), bottom_color = color.new(stdDevColor, 100), title = "Standard Deviation Gradient")
//----------------------------------------------------------------------------------------------------------------------}
