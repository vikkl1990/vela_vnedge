//@version=6
indicator("Floor Pivots", shorttitle = "Floor Pivots", overlay = true, format = format.price, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
string GROUP_SETTINGS = "Settings"
string GROUP_STYLE    = "Style"

BULL_COLOR    = #089981
BEAR_COLOR    = #f23645
NEUTRAL_COLOR = #787b86
DASH_BG       = #161616
DASH_FRAME    = #2E2E2E

string TIER_CLASSIC = "Classic"
string TIER_RANGE   = "Range Multiple"

anchorInput = input.string("Daily", "Anchor Period"
  , options = ["Daily", "Weekly", "Monthly", "Yearly"]
  , group   = GROUP_SETTINGS
  , tooltip = "Completed prior period supplying the high, low, and close. The ladder rolls at each new period and stays fixed until the next roll: nothing that prints today changes today's pivots. Match the set to your holding period: daily pivots for intraday trading, weekly, monthly or yearly sets for higher timeframe context. On 24-hour markets the day boundary of your data feed shifts every level.")

thirdTierInput = input.string(TIER_CLASSIC, "R3 / S3 Formula"
  , options = [TIER_CLASSIC, TIER_RANGE]
  , group   = GROUP_SETTINGS
  , tooltip = "Third-tier formulas vary by source. Classic: R3 = H + 2 * (P - L), S3 = L - 2 * (H - P). Range Multiple: R3 = P + 2 * (H - L), S3 = P - 2 * (H - L). P, R1/S1 and R2/S2 are identical under both variants.")

showPivotInput = input.bool(true, "Pivot (P)"
  , inline = "pivot"
  , group  = GROUP_STYLE)

pivotColorInput = input.color(NEUTRAL_COLOR, ""
  , inline  = "pivot"
  , group   = GROUP_STYLE
  , tooltip = "Central pivot P = (H + L + C) / 3, the average of the prior period's high, low, and close.")

showTier1Input = input.bool(true, "R1 / S1"
  , group   = GROUP_STYLE
  , tooltip = "First tier: R1 = 2P - L reflects the prior low through the pivot, S1 = 2P - H reflects the prior high.")

showTier2Input = input.bool(true, "R2 / S2"
  , group   = GROUP_STYLE
  , tooltip = "Second tier: R2 = P + (H - L) and S2 = P - (H - L), one full prior range above and below the pivot.")

showTier3Input = input.bool(true, "R3 / S3"
  , group   = GROUP_STYLE
  , tooltip = "Third tier: the outermost rungs of the ladder, computed with the selected R3 / S3 formula.")

resistanceColorInput = input.color(BEAR_COLOR, "Resistance Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of the resistance levels R1, R2 and R3.")

supportColorInput = input.color(BULL_COLOR, "Support Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of the support levels S1, S2 and S3.")

lineWidthInput = input.int(1, "Line Width"
  , minval  = 1
  , maxval  = 5
  , group   = GROUP_STYLE
  , tooltip = "Line width of all pivot levels.")

showLabelsInput = input.bool(true, "Level Labels"
  , group   = GROUP_STYLE
  , tooltip = "Show a name and price label for each visible level of the current set, next to the most recent bar.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
string anchorTf = switch anchorInput
    "Daily"   => "D"
    "Weekly"  => "W"
    "Monthly" => "M"
    =>           "12M"

// prior completed period high, low and close — the [1] offset with lookahead returns the finished period's values
// from the first bar of the new period without repainting
[priorHigh, priorLow, priorClose] = request.security(syminfo.tickerid, anchorTf, [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

// the anchor period must be greater than or equal to the chart timeframe to be meaningful
bool anchorTooSmall = timeframe.in_seconds(anchorTf) < timeframe.in_seconds(timeframe.period)
bool anchorIsChart  = timeframe.in_seconds(anchorTf) == timeframe.in_seconds(timeframe.period)

// first chart bar of a new anchor period, where the whole ladder rolls to fresh values
bool newPeriod = timeframe.change(anchorTf)
bool rollBar   = newPeriod and not anchorIsChart

float pivotPoint = anchorTooSmall ? na : (priorHigh + priorLow + priorClose) / 3
float priorRange = priorHigh - priorLow

float r1Level = 2 * pivotPoint - priorLow
float s1Level = 2 * pivotPoint - priorHigh
float r2Level = pivotPoint + priorRange
float s2Level = pivotPoint - priorRange

bool  classicTier = thirdTierInput == TIER_CLASSIC
float r3Level     = classicTier ? priorHigh + 2 * (pivotPoint - priorLow)  : pivotPoint + 2 * priorRange
float s3Level     = classicTier ? priorLow  - 2 * (priorHigh - pivotPoint) : pivotPoint - 2 * priorRange

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
// levels hold flat within each period, breaking at every roll so each set displays as its own horizontal segment
plot(showTier3Input and not rollBar ? r3Level    : na, "R3",        resistanceColorInput, lineWidthInput, plot.style_linebr)
plot(showTier2Input and not rollBar ? r2Level    : na, "R2",        resistanceColorInput, lineWidthInput, plot.style_linebr)
plot(showTier1Input and not rollBar ? r1Level    : na, "R1",        resistanceColorInput, lineWidthInput, plot.style_linebr)
plot(showPivotInput and not rollBar ? pivotPoint : na, "Pivot (P)", pivotColorInput,      lineWidthInput, plot.style_linebr)
plot(showTier1Input and not rollBar ? s1Level    : na, "S1",        supportColorInput,    lineWidthInput, plot.style_linebr)
plot(showTier2Input and not rollBar ? s2Level    : na, "S2",        supportColorInput,    lineWidthInput, plot.style_linebr)
plot(showTier3Input and not rollBar ? s3Level    : na, "S3",        supportColorInput,    lineWidthInput, plot.style_linebr)

//---------------------------------------------------------------------------------------------------------------------}
// Labels
//---------------------------------------------------------------------------------------------------------------------{
var label[] levelLabels = array.new<label>()

if barstate.islast and showLabelsInput and not anchorTooSmall
    for eachLabel in levelLabels
        label.delete(eachLabel)
    array.clear(levelLabels)

    string[] levelNames  = array.from("R3", "R2", "R1", "P", "S1", "S2", "S3")
    float[]  levelValues = array.from(r3Level, r2Level, r1Level, pivotPoint, s1Level, s2Level, s3Level)
    bool[]   levelShows  = array.from(showTier3Input, showTier2Input, showTier1Input, showPivotInput, showTier1Input, showTier2Input, showTier3Input)
    color[]  levelColors = array.from(resistanceColorInput, resistanceColorInput, resistanceColorInput, pivotColorInput, supportColorInput, supportColorInput, supportColorInput)

    for i = 0 to 6
        float levelValue = array.get(levelValues, i)

        if array.get(levelShows, i) and not na(levelValue)
            array.push(levelLabels, label.new(bar_index, levelValue
              , array.get(levelNames, i) + "  " + str.tostring(levelValue, format.mintick)
              , color     = #00000000
              , textcolor = array.get(levelColors, i)
              , style     = label.style_label_left
              , size      = size.small))

// warn when the selected anchor period is lower than the chart timeframe
if barstate.islast and anchorTooSmall
    var table warnTable = table.new(position.top_right, 1, 1, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

    table.cell(warnTable, 0, 0, "Floor Pivots: anchor period must be greater than or equal to the chart timeframe"
      , text_color = BEAR_COLOR
      , text_size  = size.small
      , bgcolor    = DASH_BG)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
// crosses on the roll bar itself are ignored, since they compare price against the previous period's ladder
bool crossAbovePivot = ta.crossover(close, pivotPoint)  and not rollBar
bool crossBelowPivot = ta.crossunder(close, pivotPoint) and not rollBar
bool crossAboveR1    = ta.crossover(close, r1Level)     and not rollBar
bool crossBelowS1    = ta.crossunder(close, s1Level)    and not rollBar
bool crossAboveR2    = ta.crossover(close, r2Level)     and not rollBar
bool crossBelowS2    = ta.crossunder(close, s2Level)    and not rollBar
bool crossAboveR3    = ta.crossover(close, r3Level)     and not rollBar
bool crossBelowS3    = ta.crossunder(close, s3Level)    and not rollBar

alertcondition(crossAbovePivot, "Price Crossed Above Pivot (P)", "Price crossed above the central pivot, bias leans long while P holds as support")
alertcondition(crossBelowPivot, "Price Crossed Below Pivot (P)", "Price crossed below the central pivot, bias leans short while P holds as resistance")
alertcondition(crossAboveR1,    "Price Crossed Above R1",        "Price crossed above R1, a one-sided push beyond the first resistance warns range traders to stop fading")
alertcondition(crossBelowS1,    "Price Crossed Below S1",        "Price crossed below S1, a one-sided push beyond the first support warns range traders to stop fading")
alertcondition(crossAboveR2,    "Price Crossed Above R2",        "Price crossed above R2, the second resistance of the floor pivot ladder")
alertcondition(crossBelowS2,    "Price Crossed Below S2",        "Price crossed below S2, the second support of the floor pivot ladder")
alertcondition(crossAboveR3,    "Price Crossed Above R3",        "Price crossed above R3, the outermost resistance of the floor pivot ladder")
alertcondition(crossBelowS3,    "Price Crossed Below S3",        "Price crossed below S3, the outermost support of the floor pivot ladder")

//---------------------------------------------------------------------------------------------------------------------}
