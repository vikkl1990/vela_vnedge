//@version=6
indicator("Historical Volatility", "HV", overlay = false, format = format.percent, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR = #787b86
ACCENT_COLOR  = #ff9800
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(10, "Length", minval = 2, group = "Settings", tooltip = "Lookback window in bars for the standard deviation of close-to-close log returns.")
annualizeInput = input.bool(true, "Annualize", inline = "annualize", group = "Settings", tooltip = "Scale the per-bar volatility to an annual figure by multiplying by the square root of the periods per year.")
periodsPerYearInput = input.int(252, "Periods Per Year", minval = 1, inline = "annualize", group = "Settings", tooltip = "Number of periods in a year used for annualization: 252 for daily bars, 52 for weekly, 12 for monthly.")

hvColorInput = input.color(ACCENT_COLOR, "Volatility Line", group = "Style", tooltip = "Color of the historical volatility line at its recent highs; the line fades toward grey as volatility contracts.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
logReturn = math.log(close / close[1])

// Sample (n - 1) standard deviation about the current window mean, expanded as sum(r^2) - n * mean^2
meanReturn = math.sum(logReturn, lengthInput) / lengthInput
squaredSum = math.sum(logReturn * logReturn, lengthInput)
sampleStdev = math.sqrt(math.max(squaredSum - lengthInput * meanReturn * meanReturn, 0) / (lengthInput - 1))

annualizationFactor = annualizeInput ? math.sqrt(periodsPerYearInput) : 1.0
hv = sampleStdev * annualizationFactor * 100
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// Color intensity tracks where the reading sits in its own recent range: grey when quiet, accent when volatility expands
hvRangeLow  = ta.lowest(hv, 100)
hvRangeHigh = ta.highest(hv, 100)
hvColor     = color.from_gradient(hv, hvRangeLow, hvRangeHigh, NEUTRAL_COLOR, hvColorInput)

hvPlot   = plot(hv, "Historical Volatility", hvColor, 2)
basePlot = plot(0, "Base Anchor", display = display.none, editable = false)
fill(hvPlot, basePlot, hv, 0, color.new(hvColor, 75), color.new(hvColor, 100))
//----------------------------------------------------------------------------------------------------------------------}
