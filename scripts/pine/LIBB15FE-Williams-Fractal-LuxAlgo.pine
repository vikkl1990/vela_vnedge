//@version=6
indicator("Williams Fractal", "Fractals", overlay = true, format = format.price, precision = 0)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
periodsInput = input.int(2, "Periods", minval = 2, group = "Settings", tooltip = "Bars required on each side of the candidate bar. 2 is Bill Williams' classic 5-bar fractal. A fractal is confirmed, and its marker drawn, only once this many later bars have closed.")

upColorInput   = input.color(#f23645, "Up Fractal", group = "Style", tooltip = "Color of the up fractal marker (swing high), drawn above the fractal bar.")
downColorInput = input.color(#089981, "Down Fractal", group = "Style", tooltip = "Color of the down fractal marker (swing low), drawn below the fractal bar.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
n = periodsInput

// Candidate bar sits n bars back; its high (low) must strictly exceed (undercut) every one of the n bars on each side
upFractal   = bar_index >= 2 * n
downFractal = bar_index >= 2 * n

for i = 1 to n
    upFractal   := upFractal   and high[n] > high[n + i] and high[n] > high[n - i]
    downFractal := downFractal and low[n]  < low[n + i]  and low[n]  < low[n - i]
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plotshape(upFractal, "Up Fractal", shape.triangleup, location.abovebar, upColorInput, offset = -n)
plotshape(downFractal, "Down Fractal", shape.triangledown, location.belowbar, downColorInput, offset = -n)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(upFractal, "Up Fractal Confirmed", "New up fractal (swing high) confirmed")
alertcondition(downFractal, "Down Fractal Confirmed", "New down fractal (swing low) confirmed")
//----------------------------------------------------------------------------------------------------------------------}
