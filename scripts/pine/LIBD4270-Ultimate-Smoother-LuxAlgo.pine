//@version=6
indicator("Ultimate Smoother", shorttitle = "Ultimate Smoother", overlay = true)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
FILTER_K = 1.414 // Ehlers' published pole-placement constant (approximation of sqrt(2))

GROUP_SMOOTHER  = 'Smoother'
GROUP_COMPANION = 'Slow Companion'
GROUP_STYLE     = 'Style'

//---------------------------------------------------------------------------------------------------------------------}
// Inputs
//---------------------------------------------------------------------------------------------------------------------{
periodInput = input.int(20, 'Critical Period', minval = 4, group = GROUP_SMOOTHER, tooltip = 'Critical period P in bars, wavelengths shorter than P are attenuated. Around 20 is a common starting point, shorter values track more aggressively and pass more chop, longer values smooth more but push useful swings toward the imperfect region near the cutoff.')
sourceInput = input.source(close, 'Source', group = GROUP_SMOOTHER, tooltip = 'Series the filter runs on, close by default. Select any series to use the smoothed output as a low lag replacement input for other tools.')

showSlowInput   = input.bool(false, 'Show Slow Companion', group = GROUP_COMPANION, tooltip = 'Display a slower Ultimate Smoother alongside the fast line for moving average crossover style readings, where the low passband lag of the fast line makes it more timely.')
slowPeriodInput = input.int(50, 'Slow Critical Period', minval = 4, group = GROUP_COMPANION, tooltip = 'Critical period of the slow companion. Keep it above the main critical period so the pair behaves as a fast/slow crossover.')

bullColorInput = input.color(#089981, 'Bullish', inline = 'trend', group = GROUP_STYLE)
bearColorInput = input.color(#f23645, 'Bearish', inline = 'trend', group = GROUP_STYLE)
slowColorInput = input.color(#ff9800, 'Slow Companion', group = GROUP_STYLE)
fillInput      = input.bool(true, 'Crossover Fill', group = GROUP_STYLE, tooltip = 'Fill the area between the fast line and the slow companion with the trend color of the pair, visible when the slow companion is enabled.')
markersInput   = input.bool(false, 'Price Cross Markers', group = GROUP_STYLE, tooltip = 'Show markers when price crosses the Ultimate Smoother. The alerts cover these events even when markers are hidden.')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Ultimate Smoother (John Ehlers, 2024), the input minus a two-pole high-pass response collapsed to one recursion.
// The output is seeded to the input until the recursion has two prior values.
ultimateSmoother(float src, simple int period) =>
    a1 = math.exp(-FILTER_K * math.pi / period)
    b1 = 2 * a1 * math.cos(FILTER_K * math.pi / period)
    c2 = b1
    c3 = -a1 * a1
    c1 = (1 + c2 - c3) / 4
    var float us = na
    if na(src[2]) or na(us[1]) or na(us[2])
        us := src
    else
        us := (1 - c1) * src + (2 * c1 - c2) * src[1] - (c1 + c3) * src[2] + c2 * us[1] + c3 * us[2]
    us

//---------------------------------------------------------------------------------------------------------------------}
// Core Logic
//---------------------------------------------------------------------------------------------------------------------{
fastSmoother = ultimateSmoother(sourceInput, periodInput)
slowSmoother = ultimateSmoother(sourceInput, slowPeriodInput)

var int slopeDirection = 0
slopeDirection := fastSmoother > fastSmoother[1] ? 1 : fastSmoother < fastSmoother[1] ? -1 : slopeDirection

priceCrossUp   = ta.crossover(close, fastSmoother)
priceCrossDown = ta.crossunder(close, fastSmoother)
turnedRising   = slopeDirection == 1 and nz(slopeDirection[1]) != 1
turnedFalling  = slopeDirection == -1 and nz(slopeDirection[1]) != -1
fastCrossUp    = ta.crossover(fastSmoother, slowSmoother)
fastCrossDown  = ta.crossunder(fastSmoother, slowSmoother)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
trendColor = slopeDirection == 1 ? bullColorInput : slopeDirection == -1 ? bearColorInput : #787b86

fastPlotId = plot(fastSmoother, 'Ultimate Smoother', trendColor, 2)
slowPlotId = plot(showSlowInput ? slowSmoother : na, 'Slow Companion', slowColorInput)

fill(fastPlotId, slowPlotId, fillInput ? color.new(fastSmoother > slowSmoother ? bullColorInput : bearColorInput, 80) : na, title = 'Crossover Fill')

plotshape(markersInput and priceCrossUp, 'Price Cross Up', shape.triangleup, location.belowbar, bullColorInput, size = size.tiny)
plotshape(markersInput and priceCrossDown, 'Price Cross Down', shape.triangledown, location.abovebar, bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(priceCrossUp, 'Price Crossed Above Smoother', 'Price crossed above the Ultimate Smoother on {{ticker}} ({{interval}})')
alertcondition(priceCrossDown, 'Price Crossed Below Smoother', 'Price crossed below the Ultimate Smoother on {{ticker}} ({{interval}})')
alertcondition(turnedRising, 'Smoother Turned Rising', 'Ultimate Smoother turned rising on {{ticker}} ({{interval}})')
alertcondition(turnedFalling, 'Smoother Turned Falling', 'Ultimate Smoother turned falling on {{ticker}} ({{interval}})')
alertcondition(fastCrossUp, 'Bullish Companion Cross', 'Ultimate Smoother crossed above the slow companion on {{ticker}} ({{interval}})')
alertcondition(fastCrossDown, 'Bearish Companion Cross', 'Ultimate Smoother crossed below the slow companion on {{ticker}} ({{interval}})')

//---------------------------------------------------------------------------------------------------------------------}
