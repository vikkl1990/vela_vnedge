//@version=6
indicator("ATR Expansion/contraction", shorttitle = "ATR Expansion/contraction", overlay = false, format = format.percent, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR     = #787b86 // structure - the equilibrium line
ACCENT_COLOR      = #ff9800 // the one accent - volatility expanding
DASH_BG       = #161616
DASH_FRAME    = #2E2E2E
DASH_HEADER   = #808080
DASH_TEXT     = #DBDBDB

EXPANSION_COLOR   = ACCENT_COLOR  // non-directional volatility color - expansion side, the "look here"
CONTRACTION_COLOR = NEUTRAL_COLOR // compression side recedes into structure grey
BAR_EVENT_COLOR   = ACCENT_COLOR  // expansion-bar diamonds share the expansion accent
DECAY_TRANSP      = 55      // line transparency while a state is fading
FILL_VALUE_TRANSP = 50      // gradient transparency at the read's value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the equilibrium line

REF_LONG = "Long ATR"
REF_AVG  = "Average of Fast ATR"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
fastLengthInput   = input.int(5, "Fast ATR Length", minval = 1, group = "Volatility Read",
     tooltip = "Lookback of the fast ATR - the responsive side of the comparison. Short lookbacks of 5 to 10 bars pick up fresh changes in bar travel quickly; the shorter the lookback, the faster and noisier the read.")

slowLengthInput   = input.int(20, "Slow ATR Length", minval = 2, group = "Volatility Read",
     tooltip = "Lookback of the slow baseline - 20 to 50 bars is the common range. Serves as the long ATR, or as the averaging window when the Reference is set to 'Average of Fast ATR'.")

refModeInput      = input.string(REF_LONG, "Reference", options = [REF_LONG, REF_AVG], group = "Volatility Read",
     tooltip = "Baseline the fast ATR is measured against. 'Long ATR' divides a short-lookback ATR by a long-lookback one (the ratio form). 'Average of Fast ATR' compares the fast ATR to its own simple moving average - the classic slope form, e.g. a 14-period ATR against its 20-period average.")

barMultInput      = input.float(2.0, "True Range Multiple", minval = 1.0, step = 0.25, group = "Expansion Bars",
     tooltip = "Flags an expansion bar when the bar's true range reaches this multiple of the prevailing ATR (the reference measured on the prior bar, so a bar is never compared against itself). There is no universal threshold - the higher the multiple, the rarer and more significant the flagged bars.")

showBarsInput     = input.bool(true, "Mark Expansion Bars", group = "Expansion Bars",
     tooltip = "Draws a diamond at the top of the pane on expansion bars - single bars whose true range is a large multiple of prevailing ATR, the wide-range-bar signature many systems read as genuine participation behind a move.")

contextLengthInput = input.int(100, "Context Lookback", minval = 10, group = "Context",
     tooltip = "History window used for context. The current fast ATR is ranked into a percentile against this window, and a contraction extreme is called when the read falls to its lowest level of the window.")

showExtremesInput = input.bool(false, "Mark Contraction Extremes", group = "Context",
     tooltip = "Displays a small circle on the metric while it sits at its deepest compression of the context lookback. Off by default to keep the pane clean - the Contraction Extreme alert works regardless.")

showDashInput     = input.bool(true, "Show Dashboard", group = "Dashboard",
     tooltip = "Displays the current volatility state and how long it has persisted, the current bar's true-range-to-ATR multiple, and the percentile rank of the fast ATR over the context lookback.")

dashPosInput      = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "dash", group = "Dashboard",
     tooltip = "Corner of the pane the dashboard is anchored to.")

dashSizeInput     = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], inline = "dash", group = "Dashboard",
     tooltip = "Dashboard text size.")

expansionColorInput   = input.color(EXPANSION_COLOR, "Expansion", group = "Style",
     tooltip = "Color of the read while the fast ATR holds above its reference. The line is solid while ATR is still rising (expansion building) and dimmed once it turns down (expansion decaying).")

contractionColorInput = input.color(CONTRACTION_COLOR, "Contraction", group = "Style",
     tooltip = "Color of the read while the fast ATR holds below its reference. The line is solid while ATR is still falling (compression deepening) and dimmed once it turns up (compression easing). Also colors the optional contraction-extreme circles.")

barColorInput         = input.color(BAR_EVENT_COLOR, "Expansion Bars", group = "Style",
     tooltip = "Color of the expansion-bar diamonds at the top of the pane.")

gradientInput         = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the equilibrium line and the read with a vertical gradient in the state color - fully transparent at zero, strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
getTablePosition(positionText) =>
    switch positionText
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

getTextSize(sizeText) =>
    switch sizeText
        "Tiny"  => size.tiny
        "Small" => size.small
        => size.normal

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// True range and the two ATR lookbacks - Wilder's smoothed true range on both sides
trueRange  = ta.tr(true)
fastAtr    = ta.atr(fastLengthInput)
slowAtr    = ta.atr(slowLengthInput)
atrAverage = ta.sma(fastAtr, slowLengthInput)

// Reference - the slow baseline the fast ATR is compared against
reference = refModeInput == REF_LONG ? slowAtr : atrAverage

// Expansion read - the fast ATR as a percentage above (+) or below (-) its slow baseline.
// Zero is equilibrium: fast and slow bar travel agree. Above zero, recent ranges run wider
// than the prevailing baseline (expansion); below zero, ranges are compressing (contraction)
ratioPct = not na(reference) and reference > 0 ? (fastAtr / reference - 1) * 100 : na

// State - above equilibrium with ATR still rising is expansion, below with ATR still falling
// is contraction; the zero crossings mark the transitions between the two regimes
expansionSide = not na(ratioPct) and ratioPct >= 0
atrRising     = not na(fastAtr[1]) and fastAtr > fastAtr[1]
atrFalling    = not na(fastAtr[1]) and fastAtr < fastAtr[1]
stateBuilding = expansionSide ? atrRising : atrFalling

expansionStart   = ta.crossover(ratioPct, 0)
contractionStart = ta.crossunder(ratioPct, 0)
stateChange      = expansionStart or contractionStart
barsInState      = ta.barssince(stateChange)

// Expansion bars - a single bar whose true range is a large multiple of the prevailing ATR,
// an event within whatever state the market is in
prevailingAtr = reference[1]
rangeMultiple = not na(prevailingAtr) and prevailingAtr > 0 ? trueRange / prevailingAtr : na
expansionBar  = not na(rangeMultiple) and rangeMultiple >= barMultInput

// Context - percentile rank of the fast ATR against its own history, and the contraction
// extreme: the read sitting at its deepest compression of the context lookback, the armed
// condition that tends to precede the next expansion
atrPercentile    = ta.percentrank(fastAtr, contextLengthInput)
compressionFloor = ta.lowest(ratioPct, contextLengthInput)
extremeTouch     = not na(ratioPct) and not na(compressionFloor) and ratioPct < 0 and ratioPct <= compressionFloor
newExtreme       = extremeTouch and not extremeTouch[1]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
stateColor = expansionSide ? expansionColorInput : contractionColorInput
lineColor  = stateBuilding ? stateColor : color.new(stateColor, DECAY_TRANSP)

fillTopColor    = gradientInput ? color.new(stateColor, expansionSide ? FILL_VALUE_TRANSP : FILL_ZERO_TRANSP) : na
fillBottomColor = gradientInput ? color.new(stateColor, expansionSide ? FILL_ZERO_TRANSP : FILL_VALUE_TRANSP) : na

ratioPlotId = plot(ratioPct, "ATR Expansion %", color = lineColor, linewidth = 1)
zeroPlotId  = plot(0, "Equilibrium", color = color.new(NEUTRAL_COLOR, 40), linewidth = 1)

fill(ratioPlotId, zeroPlotId, top_value = math.max(nz(ratioPct), 0), bottom_value = math.min(nz(ratioPct), 0), top_color = fillTopColor, bottom_color = fillBottomColor, title = "State Gradient Fill")

plotshape(showBarsInput and expansionBar, "Expansion Bars", shape.diamond, location.top, barColorInput, size = size.tiny)

plot(showExtremesInput and extremeTouch ? ratioPct : na, "Contraction Extreme Marker", color = contractionColorInput, linewidth = 2, style = plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var table dashTable = na

if barstate.isfirst and showDashInput
    dashTable := table.new(getTablePosition(dashPosInput), 2, 4, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if barstate.islast and showDashInput and not na(dashTable)
    stateText    = na(ratioPct) ? "-" : expansionSide ? stateBuilding ? "Expansion (building)" : "Expansion (decaying)" : stateBuilding ? "Contraction (deepening)" : "Contraction (easing)"
    durationText = na(barsInState) ? "-" : str.tostring(barsInState + 1) + " bars"
    multipleText = na(rangeMultiple) ? "-" : str.tostring(rangeMultiple, "#.##") + "x"
    pctText      = na(atrPercentile) ? "-" : str.tostring(atrPercentile, "#") + "%"
    labelColor   = DASH_HEADER
    dashTextSize = getTextSize(dashSizeInput)
    table.cell(dashTable, 0, 0, "State", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, stateText, text_color = na(ratioPct) ? DASH_TEXT : stateColor, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 1, "Bars in State", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, durationText, text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, "Bar TR / ATR", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, multipleText, text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 3, "ATR Percentile", text_color = labelColor, text_size = dashTextSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, pctText, text_color = DASH_TEXT, text_size = dashTextSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(expansionStart, "Expansion Started", "ATR expansion started on {{ticker}} - fast ATR crossed above its reference, volatility building ({{interval}})")
alertcondition(contractionStart, "Contraction Started", "ATR contraction started on {{ticker}} - fast ATR crossed below its reference, ranges compressing ({{interval}})")
alertcondition(expansionBar, "Expansion Bar", "Expansion bar on {{ticker}} - true range reached the configured multiple of prevailing ATR ({{interval}})")
alertcondition(newExtreme, "Contraction Extreme", "Contraction extreme on {{ticker}} - the read fell to its deepest compression of the context lookback, breakout conditions arming ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
