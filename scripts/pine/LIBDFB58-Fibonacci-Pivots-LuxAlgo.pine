//@version=6
indicator("Fibonacci Pivots", shorttitle = "Fibonacci Pivots", overlay = true, format = format.price, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
string GROUP_SETTINGS = "Settings"
string GROUP_STYLE    = "Style"

color BULL_COLOR    = #089981 // support tiers below the pivot
color BEAR_COLOR    = #f23645 // resistance tiers above the pivot
color NEUTRAL_COLOR = #787b86 // the central pivot and the rotation zone

color DASH_BG    = #161616
color DASH_FRAME = #2E2E2E

int ZONE_TRANSP = 92

// Fibonacci fractions of the prior period high-to-low range
float FIB_TIER_0 = 0.236
float FIB_TIER_1 = 0.382
float FIB_TIER_2 = 0.618
float FIB_TIER_3 = 1.000
float FIB_TIER_4 = 1.382

anchorInput = input.string("Daily", "Anchor Period"
  , options = ["Daily", "Weekly", "Monthly"]
  , group   = GROUP_SETTINGS
  , tooltip = "Completed prior period supplying the high, low, and close. The ladder is computed once at each period boundary and stays fixed until the next roll: nothing that prints today changes today's pivots. Use a period at least one step above your execution timeframe: prior-day for intraday charts, prior-week for daily swing charts, prior-month for longer holds. On 24-hour markets the day boundary of your data feed defines the inputs, so different session templates print different pivots from identical data.")

showPivotInput = input.bool(true, "Pivot (P)"
  , inline = "pivot"
  , group  = GROUP_STYLE)

pivotColorInput = input.color(NEUTRAL_COLOR, ""
  , inline  = "pivot"
  , group   = GROUP_STYLE
  , tooltip = "Central pivot P = (H + L + C) / 3 of the prior period. It is not Fibonacci-derived: it is the same average classic floor pivots use. Trade holding above P is commonly read as a bullish session lean, below as bearish.")

showTier1Input = input.bool(true, "R1 / S1 (0.382)"
  , group   = GROUP_STYLE
  , tooltip = "First tier at 38.2% of the prior high-to-low range above and below the pivot, the first zones to watch for stalls or reactions.")

showTier2Input = input.bool(true, "R2 / S2 (0.618)"
  , group   = GROUP_STYLE
  , tooltip = "Second tier at 61.8% of the prior range, serving as an objective on stronger trending days.")

showTier3Input = input.bool(true, "R3 / S3 (1.000)"
  , group   = GROUP_STYLE
  , tooltip = "Third tier a full prior range above and below the pivot. By construction, reaching it marks an unusually directional session.")

showTier0Input = input.bool(false, "R0 / S0 (0.236)"
  , group   = GROUP_STYLE
  , tooltip = "Optional inner tier at 23.6% of the prior range, between the pivot and the first tier. The standard Fibonacci set uses 0.382, 0.618 and 1.000; some platforms add this rung.")

showTier4Input = input.bool(false, "R4 / S4 (1.382)"
  , group   = GROUP_STYLE
  , tooltip = "Optional outer tier at 138.2% of the prior range, beyond R3 / S3, for sessions that extend past the full prior range.")

resistanceColorInput = input.color(BEAR_COLOR, "Resistance Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of the resistance levels above the pivot. The optional 0.236 and 1.382 tiers are drawn faded so the standard ladder stays prominent.")

supportColorInput = input.color(BULL_COLOR, "Support Color"
  , group   = GROUP_STYLE
  , tooltip = "Color of the support levels below the pivot. The optional 0.236 and 1.382 tiers are drawn faded so the standard ladder stays prominent.")

showZoneInput = input.bool(true, "R1 - S1 Rotation Zone"
  , inline = "zone"
  , group  = GROUP_STYLE)

zoneColorInput = input.color(color.new(NEUTRAL_COLOR, ZONE_TRANSP), ""
  , inline  = "zone"
  , group   = GROUP_STYLE
  , tooltip = "Shade the band between R1 and S1. Rotational sessions tend to live inside this zone while trend days walk the ladder tier by tier, so the shading doubles as a day-type read.")

lineWidthInput = input.int(1, "Line Width"
  , minval  = 1
  , maxval  = 5
  , group   = GROUP_STYLE
  , tooltip = "Line width of all pivot levels.")

showLabelsInput = input.bool(true, "Level Labels"
  , group   = GROUP_STYLE
  , tooltip = "Show a name and price label for each visible level of the current set, next to the most recent bar.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
string anchorTf = switch anchorInput
    "Daily"  => "D"
    "Weekly" => "W"
    =>          "M"

// prior completed period high, low and close — the [1] offset with lookahead returns the finished period's values
// from the first bar of the new period without repainting
[priorHigh, priorLow, priorClose] = request.security(syminfo.tickerid, anchorTf, [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

// the anchor period must be greater than or equal to the chart timeframe to be meaningful
bool anchorTooSmall = timeframe.in_seconds(anchorTf) < timeframe.in_seconds(timeframe.period)
bool anchorIsChart  = timeframe.in_seconds(anchorTf) == timeframe.in_seconds(timeframe.period)

// first chart bar of a new anchor period, where the whole ladder rolls to fresh values
bool newPeriod = timeframe.change(anchorTf)
bool rollBar   = newPeriod and not anchorIsChart

// the central pivot is borrowed from the floor set; the satellites are symmetric Fibonacci fractions of the prior
// range, so level spacing scales with how far the prior period actually traveled
float pivotPoint = anchorTooSmall ? na : (priorHigh + priorLow + priorClose) / 3
float priorRange = priorHigh - priorLow

float r0Level = pivotPoint + FIB_TIER_0 * priorRange
float s0Level = pivotPoint - FIB_TIER_0 * priorRange
float r1Level = pivotPoint + FIB_TIER_1 * priorRange
float s1Level = pivotPoint - FIB_TIER_1 * priorRange
float r2Level = pivotPoint + FIB_TIER_2 * priorRange
float s2Level = pivotPoint - FIB_TIER_2 * priorRange
float r3Level = pivotPoint + FIB_TIER_3 * priorRange
float s3Level = pivotPoint - FIB_TIER_3 * priorRange
float r4Level = pivotPoint + FIB_TIER_4 * priorRange
float s4Level = pivotPoint - FIB_TIER_4 * priorRange

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
// optional tiers are drawn faded so the standard 0.382 / 0.618 / 1.000 ladder stays prominent
color fadedResistanceColor = color.new(resistanceColorInput, 40)
color fadedSupportColor    = color.new(supportColorInput, 40)

// levels hold flat within each period, breaking at every roll so each set displays as its own horizontal segment
plot(showTier4Input and not rollBar ? r4Level : na, "R4 (1.382)", fadedResistanceColor, lineWidthInput, plot.style_linebr)
plot(showTier3Input and not rollBar ? r3Level : na, "R3 (1.000)", resistanceColorInput, lineWidthInput, plot.style_linebr)
plot(showTier2Input and not rollBar ? r2Level : na, "R2 (0.618)", resistanceColorInput, lineWidthInput, plot.style_linebr)
r1PlotId = plot(showTier1Input and not rollBar ? r1Level : na, "R1 (0.382)", resistanceColorInput, lineWidthInput, plot.style_linebr)
plot(showTier0Input and not rollBar ? r0Level : na, "R0 (0.236)", fadedResistanceColor, lineWidthInput, plot.style_linebr)
plot(showPivotInput and not rollBar ? pivotPoint : na, "Pivot (P)", pivotColorInput, lineWidthInput, plot.style_linebr)
plot(showTier0Input and not rollBar ? s0Level : na, "S0 (0.236)", fadedSupportColor, lineWidthInput, plot.style_linebr)
s1PlotId = plot(showTier1Input and not rollBar ? s1Level : na, "S1 (0.382)", supportColorInput, lineWidthInput, plot.style_linebr)
plot(showTier2Input and not rollBar ? s2Level : na, "S2 (0.618)", supportColorInput, lineWidthInput, plot.style_linebr)
plot(showTier3Input and not rollBar ? s3Level : na, "S3 (1.000)", supportColorInput, lineWidthInput, plot.style_linebr)
plot(showTier4Input and not rollBar ? s4Level : na, "S4 (1.382)", fadedSupportColor, lineWidthInput, plot.style_linebr)

// rotational sessions tend to live between R1 and S1, so a soft shading of that band doubles as a day-type read
fill(r1PlotId, s1PlotId, color = showZoneInput ? zoneColorInput : na, title = "Rotation Zone")

//---------------------------------------------------------------------------------------------------------------------}
// Labels
//---------------------------------------------------------------------------------------------------------------------{
var label[] levelLabels = array.new<label>()

if barstate.islast and showLabelsInput and not anchorTooSmall
    for eachLabel in levelLabels
        label.delete(eachLabel)
    array.clear(levelLabels)

    string[] levelNames  = array.from("R4", "R3", "R2", "R1", "R0", "P", "S0", "S1", "S2", "S3", "S4")
    float[]  levelValues = array.from(r4Level, r3Level, r2Level, r1Level, r0Level, pivotPoint, s0Level, s1Level, s2Level, s3Level, s4Level)
    bool[]   levelShows  = array.from(showTier4Input, showTier3Input, showTier2Input, showTier1Input, showTier0Input, showPivotInput, showTier0Input, showTier1Input, showTier2Input, showTier3Input, showTier4Input)
    color[]  levelColors = array.from(fadedResistanceColor, resistanceColorInput, resistanceColorInput, resistanceColorInput, fadedResistanceColor, pivotColorInput, fadedSupportColor, supportColorInput, supportColorInput, supportColorInput, fadedSupportColor)

    for i = 0 to array.size(levelNames) - 1
        float levelValue = array.get(levelValues, i)

        if array.get(levelShows, i) and not na(levelValue)
            array.push(levelLabels, label.new(bar_index, levelValue
              , array.get(levelNames, i) + "  " + str.tostring(levelValue, format.mintick)
              , color     = #00000000
              , textcolor = array.get(levelColors, i)
              , style     = label.style_label_left
              , size      = size.small))

// warn when the selected anchor period is lower than the chart timeframe
if barstate.islast and anchorTooSmall
    var table warnTable = table.new(position.top_right, 1, 1, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

    table.cell(warnTable, 0, 0, "Fibonacci Pivots: anchor period must be greater than or equal to the chart timeframe"
      , text_color = BEAR_COLOR
      , text_size  = size.small
      , bgcolor    = DASH_BG)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
// crosses on the roll bar itself are ignored, since they compare price against the previous period's ladder
bool crossAbovePivot = ta.crossover(close, pivotPoint)  and not rollBar
bool crossBelowPivot = ta.crossunder(close, pivotPoint) and not rollBar
bool crossAboveR1    = ta.crossover(close, r1Level)     and not rollBar
bool crossBelowS1    = ta.crossunder(close, s1Level)    and not rollBar
bool crossAboveR2    = ta.crossover(close, r2Level)     and not rollBar
bool crossBelowS2    = ta.crossunder(close, s2Level)    and not rollBar
bool crossAboveR3    = ta.crossover(close, r3Level)     and not rollBar
bool crossBelowS3    = ta.crossunder(close, s3Level)    and not rollBar

alertcondition(crossAbovePivot, "Price Crossed Above Pivot (P)",  "Price crossed above the central pivot, session bias leans long while P holds as support")
alertcondition(crossBelowPivot, "Price Crossed Below Pivot (P)",  "Price crossed below the central pivot, session bias leans short while P holds as resistance")
alertcondition(crossAboveR1,    "Price Crossed Above R1 (0.382)", "Price crossed above R1 at 38.2% of the prior range, the first resistance tier of the Fibonacci pivot ladder")
alertcondition(crossBelowS1,    "Price Crossed Below S1 (0.382)", "Price crossed below S1 at 38.2% of the prior range, the first support tier of the Fibonacci pivot ladder")
alertcondition(crossAboveR2,    "Price Crossed Above R2 (0.618)", "Price crossed above R2 at 61.8% of the prior range, a common objective on stronger trending sessions")
alertcondition(crossBelowS2,    "Price Crossed Below S2 (0.618)", "Price crossed below S2 at 61.8% of the prior range, a common objective on stronger trending sessions")
alertcondition(crossAboveR3,    "Price Crossed Above R3 (1.000)", "Price crossed above R3, a full prior range above the pivot, marking an unusually directional session")
alertcondition(crossBelowS3,    "Price Crossed Below S3 (1.000)", "Price crossed below S3, a full prior range below the pivot, marking an unusually directional session")

//---------------------------------------------------------------------------------------------------------------------}
