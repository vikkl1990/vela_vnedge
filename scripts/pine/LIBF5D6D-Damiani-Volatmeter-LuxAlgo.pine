//@version=6
indicator("Damiani Volatmeter"
  , shorttitle = "Damiani Volatmeter"
  , overlay    = false
  , format     = format.price
  , precision  = 3)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
int TRANSP_VALUE  = 50   //Gradient fill opacity at the volatility line
int TRANSP_HIDDEN = 100  //Gradient fill opacity at the threshold line
int TRANSP_SOFT   = 90   //Background highlight opacity

BULL_COLOR    = #089981  //Trade allowed - volatility above the threshold
BEAR_COLOR    = #f23645  //No-trade - volatility at or below the threshold
NEUTRAL_COLOR = #787b86  //Threshold line and the volatility line before data is ready

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_TEXT   = #DBDBDB

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
fastLengthInput = input.int(7, "Fast Length (Viscosity)", minval = 1, group = "Settings"
  , tooltip = "Fast window used for both the ATR ratio and the standard deviation ratio. Called 'viscosity' in the commonly shared version.")

slowLengthInput = input.int(50, "Slow Length (Sedimentation)", minval = 2, group = "Settings"
  , tooltip = "Slow baseline window used for both the ATR ratio and the standard deviation ratio. Called 'sedimentation' in the commonly shared version.")

lagKInput = input.float(0.5, "Lag Suppressor (k)", minval = 0, step = 0.1, group = "Settings"
  , tooltip = "Coefficient of the lag suppression term k * (V[1] - V[3]) added to the raw ATR ratio. Set to 0 to disable the term, as some versions of the indicator do.")

threshCInput = input.float(1.1, "Threshold Constant (c)", step = 0.05, group = "Settings"
  , tooltip = "Constant the standard deviation ratio is subtracted from to build the adaptive threshold line T = c - StdDev(fast) / StdDev(slow).")

srcInput = input.source(close, "StdDev Source", group = "Settings"
  , tooltip = "Source used by the standard deviation ratio of the threshold line. The commonly shared version uses closing prices.")

//Style
volColorInput = input.color(NEUTRAL_COLOR, "Volatility Line", group = "Style"
  , tooltip = "Color of the volatility line before data is ready. Once the filter resolves, the line takes the trade / no-trade color.")

threshColorInput = input.color(NEUTRAL_COLOR, "Threshold Line", group = "Style")

tradeColorInput = input.color(BULL_COLOR, "Trade Allowed", inline = "state", group = "Style")

noTradeColorInput = input.color(BEAR_COLOR, "No-Trade", inline = "state", group = "Style")

showStateInput = input.bool(true, "Show State Dashboard", group = "Style"
  , tooltip = "Displays the current trade / no-trade state in the top right corner of the pane.")

showMarkersInput = input.bool(false, "Show Regime Change Markers", group = "Style"
  , tooltip = "Displays a circle on the volatility line whenever the filter switches between trade allowed and no-trade.")

showBgInput = input.bool(false, "Highlight No-Trade Zones", group = "Style"
  , tooltip = "Shades the pane background while the volatility line is below the threshold line.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
atrFast = ta.atr(fastLengthInput)
atrSlow = ta.atr(slowLengthInput)

stdevFast = ta.stdev(srcInput, fastLengthInput)
stdevSlow = ta.stdev(srcInput, slowLengthInput)

//Volatility line, fast/slow ATR ratio with recursive lag suppression V = Vraw + k * (V[1] - V[3])
volRaw = atrSlow > 0 ? atrFast / atrSlow : na

float vol = na
vol := na(volRaw) ? na : volRaw + lagKInput * (nz(vol[1], volRaw) - nz(vol[3], volRaw))

//Threshold line T = c - StdDev(src, fast) / StdDev(src, slow)
threshold = stdevSlow > 0 ? threshCInput - stdevFast / stdevSlow : na

//Trade / no-trade state
dataReady    = not na(vol) and not na(threshold)
tradeAllowed = dataReady and vol > threshold
noTrade      = dataReady and vol <= threshold

turnOn  = tradeAllowed and noTrade[1]
turnOff = noTrade and tradeAllowed[1]

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
//Volatility line colored by state - trade allowed above the threshold, no-trade below
volLineColor = tradeAllowed ? tradeColorInput : noTrade ? noTradeColorInput : volColorInput

volPlot    = plot(vol, "Volatility", volLineColor, 2)
threshPlot = plot(threshold, "Threshold", threshColorInput)

//Gradient fill between the two lines, transparent at the threshold, colored by the trade/no-trade state
topColor    = tradeAllowed ? color.new(tradeColorInput, TRANSP_VALUE)  : color.new(noTradeColorInput, TRANSP_HIDDEN)
bottomColor = tradeAllowed ? color.new(tradeColorInput, TRANSP_HIDDEN) : color.new(noTradeColorInput, TRANSP_VALUE)

fill(volPlot, threshPlot, math.max(vol, threshold), math.min(vol, threshold), topColor, bottomColor)

//Optional regime change markers, off by default
plotshape(showMarkersInput and turnOn ? vol : na, "Turn-On Marker", shape.circle, location.absolute, tradeColorInput, size = size.tiny)
plotshape(showMarkersInput and turnOff ? vol : na, "Turn-Off Marker", shape.circle, location.absolute, noTradeColorInput, size = size.tiny)

//Optional no-trade background highlight, off by default
bgcolor(showBgInput and noTrade ? color.new(noTradeColorInput, TRANSP_SOFT) : na, title = "No-Trade Background")

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
var stateTable = table.new(position.top_right, 1, 1, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)

if barstate.islast and showStateInput
    color stateColor = dataReady ? (tradeAllowed ? tradeColorInput : noTradeColorInput) : DASH_TEXT
    string stateText = dataReady ? (tradeAllowed ? "Trade Allowed" : "No Trade") : "Loading..."

    table.cell(stateTable, 0, 0, stateText
      , text_color = stateColor
      , text_size  = size.small
      , bgcolor    = DASH_BG)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(turnOn, "Trade Allowed", "Damiani Volatmeter: volatility crossed above the threshold on {{ticker}} {{interval}}, trading is allowed")
alertcondition(turnOff, "No-Trade Zone", "Damiani Volatmeter: volatility crossed below the threshold on {{ticker}} {{interval}}, no-trade zone")

//---------------------------------------------------------------------------------------------------------------------}
