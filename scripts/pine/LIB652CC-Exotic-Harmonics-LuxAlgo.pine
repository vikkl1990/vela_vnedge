//@version=6
indicator("Exotic Harmonics", "Exotic Harmonics", overlay = true, max_lines_count = 500, max_labels_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MAX_PIVOTS = 12
FIB_T1     = 0.382
FIB_T2     = 0.618
LABEL_BG   = #00000000

GRP_SWING = "Swing Detection"
GRP_PAT   = "Patterns"
GRP_NS    = "Nen Star Ratios"
GRP_WS    = "White Swan Ratios"
GRP_BS    = "Black Swan Ratios"
GRP_STYLE = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lenInput = input.int(10, "Swing Length", minval = 2, group = GRP_SWING, tooltip = "Number of bars on each side required to confirm a swing high or swing low. Confirmed swings alternate to supply the X, A, B, C and D anchors; larger values return bigger patterns that confirm later.")

nenOnInput   = input.bool(true, "Nen Star", group = GRP_PAT, tooltip = "Detect the Nen Star, a community-defined XABCD structure whose C swing extends beyond A and whose D completes near the 1.272 extension of XA.")
whiteOnInput = input.bool(true, "White Swan", group = GRP_PAT, tooltip = "Detect the White Swan, a community-defined XABCD structure with a deep BC extension and a completion that stays inside the XA leg.")
blackOnInput = input.bool(true, "Black Swan", group = GRP_PAT, tooltip = "Detect the Black Swan, commonly presented as the White Swan inverse: B extends beyond X and the completion runs well beyond the XA leg.")
tolInput     = input.float(0.05, "Ratio Tolerance", minval = 0.01, maxval = 0.25, step = 0.01, group = GRP_PAT, tooltip = "Accepted deviation when matching point ratios. Applies to the Nen Star D anchor of XA and to the embedded AB=CD equality check; with 0.05 an anchor of 1.272 accepts 1.222 to 1.322. Also widens the Nen Star tolerated extreme used for invalidation.")

nsAbMinInput = input.float(0.382, "B of XA", minval = 0, step = 0.001, inline = "nsab", group = GRP_NS, tooltip = "Window of B's retracement of XA accepted for the Nen Star. Exotic specifications vary by source, so fix one set of bounds and apply it consistently.")
nsAbMaxInput = input.float(0.786, "to", minval = 0, step = 0.001, inline = "nsab", group = GRP_NS, tooltip = "Upper bound of B's retracement of XA for the Nen Star.")
nsBcMinInput = input.float(1.13, "C of AB", minval = 0, step = 0.001, inline = "nsbc", group = GRP_NS, tooltip = "Window of C's extension of AB accepted for the Nen Star. Values above 1 force C beyond A, the hallmark of this structure.")
nsBcMaxInput = input.float(1.414, "to", minval = 0, step = 0.001, inline = "nsbc", group = GRP_NS, tooltip = "Upper bound of C's extension of AB for the Nen Star.")
nsCdMinInput = input.float(1.272, "D of BC", minval = 0, step = 0.001, inline = "nscd", group = GRP_NS, tooltip = "Window of D's extension of BC accepted for the Nen Star.")
nsCdMaxInput = input.float(2.0, "to", minval = 0, step = 0.001, inline = "nscd", group = GRP_NS, tooltip = "Upper bound of D's extension of BC for the Nen Star.")
nsXadInput   = input.float(1.272, "D of XA Anchor", minval = 0, step = 0.001, group = GRP_NS, tooltip = "XA ratio anchoring the Nen Star completion: D must land within the ratio tolerance of this value. 1.272 is the commonly published anchor, placing D beyond X.")

wsAbMinInput  = input.float(0.382, "B of XA", minval = 0, step = 0.001, inline = "wsab", group = GRP_WS, tooltip = "Window of B's retracement of XA accepted for the White Swan. Exotic specifications vary by source, so fix one set of bounds and apply it consistently.")
wsAbMaxInput  = input.float(0.724, "to", minval = 0, step = 0.001, inline = "wsab", group = GRP_WS, tooltip = "Upper bound of B's retracement of XA for the White Swan.")
wsBcMinInput  = input.float(2.0, "C of AB", minval = 0, step = 0.001, inline = "wsbc", group = GRP_WS, tooltip = "Window of C's extension of AB accepted for the White Swan; the deep extension beyond A is its signature.")
wsBcMaxInput  = input.float(4.237, "to", minval = 0, step = 0.001, inline = "wsbc", group = GRP_WS, tooltip = "Upper bound of C's extension of AB for the White Swan.")
wsCdMinInput  = input.float(0.5, "D of BC", minval = 0, step = 0.001, inline = "wscd", group = GRP_WS, tooltip = "Window of D's retracement of BC accepted for the White Swan.")
wsCdMaxInput  = input.float(0.886, "to", minval = 0, step = 0.001, inline = "wscd", group = GRP_WS, tooltip = "Upper bound of D's retracement of BC for the White Swan.")
wsXadMinInput = input.float(0.236, "D of XA", minval = 0, step = 0.001, inline = "wsxd", group = GRP_WS, tooltip = "Window of D's retracement of XA accepted for the White Swan. Below 1 the completion stays inside the XA leg.")
wsXadMaxInput = input.float(0.886, "to", minval = 0, step = 0.001, inline = "wsxd", group = GRP_WS, tooltip = "Upper bound of D's retracement of XA for the White Swan; doubles as the tolerated extreme used for the invalidation level.")

bsAbMinInput  = input.float(1.382, "B of XA", minval = 0, step = 0.001, inline = "bsab", group = GRP_BS, tooltip = "Window of B's extension of XA accepted for the Black Swan. Values above 1 force B beyond X, the mirror of the White Swan geometry.")
bsAbMaxInput  = input.float(2.618, "to", minval = 0, step = 0.001, inline = "bsab", group = GRP_BS, tooltip = "Upper bound of B's extension of XA for the Black Swan.")
bsBcMinInput  = input.float(0.236, "C of AB", minval = 0, step = 0.001, inline = "bsbc", group = GRP_BS, tooltip = "Window of C's retracement of AB accepted for the Black Swan.")
bsBcMaxInput  = input.float(0.5, "to", minval = 0, step = 0.001, inline = "bsbc", group = GRP_BS, tooltip = "Upper bound of C's retracement of AB for the Black Swan.")
bsCdMinInput  = input.float(1.128, "D of BC", minval = 0, step = 0.001, inline = "bscd", group = GRP_BS, tooltip = "Window of D's extension of BC accepted for the Black Swan.")
bsCdMaxInput  = input.float(2.0, "to", minval = 0, step = 0.001, inline = "bscd", group = GRP_BS, tooltip = "Upper bound of D's extension of BC for the Black Swan.")
bsXadMinInput = input.float(1.128, "D of XA", minval = 0, step = 0.001, inline = "bsxd", group = GRP_BS, tooltip = "Window of D's extension of XA accepted for the Black Swan. Above 1 the completion runs beyond X, extension-pattern territory.")
bsXadMaxInput = input.float(2.618, "to", minval = 0, step = 0.001, inline = "bsxd", group = GRP_BS, tooltip = "Upper bound of D's extension of XA for the Black Swan; doubles as the tolerated extreme used for the invalidation level.")

bullColorInput  = input.color(#089981, "Bullish Patterns", group = GRP_STYLE, tooltip = "Color of bullish patterns, which complete at a swing low D and are watched for a reversal higher.")
bearColorInput  = input.color(#f23645, "Bearish Patterns", group = GRP_STYLE, tooltip = "Color of bearish patterns, which complete at a swing high D and are watched for a reversal lower.")
widthInput      = input.int(2, "Leg Line Width", minval = 1, maxval = 5, group = GRP_STYLE, tooltip = "Width of the X to A, A to B, B to C and C to D pattern legs.")
showPointsInput = input.bool(true, "Point Labels", group = GRP_STYLE, tooltip = "Show the X, A, B and C letters at the pattern anchors. The D label always shows the pattern name and XA ratio, with full measurements in its tooltip.")
showRatiosInput = input.bool(true, "Leg Ratio Labels", group = GRP_STYLE, tooltip = "Print the measured B of XA, C of AB and D of BC ratios along the structure, mirroring the Fibonacci-tool readings used to verify the pattern manually.")
showFillInput   = input.bool(true, "Pattern Fill", group = GRP_STYLE, tooltip = "Shade the XAB and BCD triangles of each pattern with its direction color.")
showAbcdInput   = input.bool(true, "Embedded AB=CD Projection", group = GRP_STYLE, tooltip = "Draw the completion level of the ABCD embedded in the final three legs. A completion is taken more seriously when this projection lands where the XA-derived level does.")
showTradeInput  = input.bool(true, "Trade Levels", group = GRP_STYLE, tooltip = "Draw the mechanical risk template of the most recent completion: an invalidation level beyond the tolerated D extreme and initial targets at the 0.382 and 0.618 retracements of the CD leg.")

//---------------------------------------------------------------------------------------------------------------------}
// Types
//---------------------------------------------------------------------------------------------------------------------{
type Pivot
    float price
    int   barIdx
    int   dir

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// append an alternating swing to the pivot array, extending the last swing when a same-direction extreme prints
addPivot(array<Pivot> arr, float price, int barIdx, int pDir) =>
    bool changed = false
    int n = array.size(arr)
    if n == 0
        array.push(arr, Pivot.new(price, barIdx, pDir))
        changed := true
    else
        Pivot prev = array.get(arr, n - 1)
        if prev.dir == pDir
            if (pDir == 1 and price > prev.price) or (pDir == -1 and price < prev.price)
                prev.price := price
                prev.barIdx := barIdx
                changed := true
        else
            array.push(arr, Pivot.new(price, barIdx, pDir))
            changed := true
    if array.size(arr) > MAX_PIVOTS
        array.shift(arr)
    changed

// true when a measured ratio falls inside a user window, tolerant of inverted bounds
inWin(float v, float mn, float mx) =>
    not na(v) and v >= math.min(mn, mx) and v <= math.max(mn, mx)

// y value of the straight chord (x1,y1)-(x2,y2) at bar xm, used to split chords for exact triangle fills
chordY(int x1, float y1, int x2, float y2, int xm) =>
    x2 == x1 ? y2 : y1 + (y2 - y1) * (xm - x1) / (x2 - x1)

// letter label at a swing anchor, above highs and below lows
swingLabel(int barIdx, float price, string txt, int pDir, color txtColor) =>
    label.new(barIdx, price, txt, style = pDir == 1 ? label.style_label_down : label.style_label_up, color = LABEL_BG, textcolor = txtColor, size = size.small)

// unobtrusive ratio reading centered on a measuring chord
ratioLabel(int barIdx, float price, string txt, color txtColor) =>
    label.new(barIdx, price, txt, style = label.style_label_center, color = LABEL_BG, textcolor = txtColor, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Swing Detection
//---------------------------------------------------------------------------------------------------------------------{
var array<Pivot> pivotArray = array.new<Pivot>()

swingHigh = ta.pivothigh(high, lenInput, lenInput)
swingLow  = ta.pivotlow(low, lenInput, lenInput)

int pivotBarIdx = bar_index - lenInput
int lastDirNow = array.size(pivotArray) > 0 ? array.get(pivotArray, array.size(pivotArray) - 1).dir : 0
bool pivotChanged = false

// when a bar confirms both swings, process the one opposite to the last swing first to preserve alternation
if not na(swingHigh) and not na(swingLow) and lastDirNow == 1
    pivotChanged := addPivot(pivotArray, swingLow, pivotBarIdx, -1)
    pivotChanged := addPivot(pivotArray, swingHigh, pivotBarIdx, 1) or pivotChanged
else
    if not na(swingHigh)
        pivotChanged := addPivot(pivotArray, swingHigh, pivotBarIdx, 1) or pivotChanged
    if not na(swingLow)
        pivotChanged := addPivot(pivotArray, swingLow, pivotBarIdx, -1) or pivotChanged

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{
// drawings of the most recent structure, replaced in place when its D swing extends
var array<line> patternLines = array.new<line>()
var array<label> patternLabels = array.new<label>()
var array<linefill> patternFills = array.new<linefill>()
var int lastXBar = -1
var int lastABar = -1
var int lastBBar = -1
var int lastCBar = -1

// risk template of the most recent completion
var int   activeDir = 0
var float stopLevel = na
var float t1Level   = na
var float t2Level   = na
var bool  t1Hit     = false
var bool  t2Hit     = false
var line  stopLn    = na
var line  t1Ln      = na
var line  t2Ln      = na
var label stopLb    = na
var label t1Lb      = na
var label t2Lb      = na

bool bullEvent      = false
bool bearEvent      = false
bool nenEvent       = false
bool whiteEvent     = false
bool blackEvent     = false
bool confluentEvent = false

if pivotChanged and array.size(pivotArray) >= 5
    int n = array.size(pivotArray)
    Pivot dP = array.get(pivotArray, n - 1)
    Pivot cP = array.get(pivotArray, n - 2)
    Pivot bP = array.get(pivotArray, n - 3)
    Pivot aP = array.get(pivotArray, n - 4)
    Pivot xP = array.get(pivotArray, n - 5)
    // the newest swing is the D candidate, a swing low completes a bullish structure, a swing high a bearish one
    int dirCand = dP.dir == -1 ? 1 : -1
    bool structOk = dirCand == 1 ? aP.price > xP.price and aP.price > bP.price and cP.price > bP.price and cP.price > dP.price : aP.price < xP.price and aP.price < bP.price and cP.price < bP.price and cP.price < dP.price
    float xaDist = math.abs(aP.price - xP.price)
    float abDist = math.abs(aP.price - bP.price)
    float bcDist = math.abs(cP.price - bP.price)
    float cdDist = math.abs(cP.price - dP.price)
    float abRet  = xaDist > 0 ? abDist / xaDist : na
    float bcRet  = abDist > 0 ? bcDist / abDist : na
    float cdExt  = bcDist > 0 ? cdDist / bcDist : na
    // signed retracement of XA at D, negative when D fails to pull back from A at all
    float xadVal = xaDist > 0 ? (dirCand == 1 ? aP.price - dP.price : dP.price - aP.price) / xaDist : na
    float abcdRatio = abDist > 0 ? cdDist / abDist : na
    int patId = 0
    if structOk
        if nenOnInput and inWin(abRet, nsAbMinInput, nsAbMaxInput) and inWin(bcRet, nsBcMinInput, nsBcMaxInput) and inWin(cdExt, nsCdMinInput, nsCdMaxInput) and not na(xadVal) and math.abs(xadVal - nsXadInput) <= tolInput
            patId := 1
        if patId == 0 and whiteOnInput and inWin(abRet, wsAbMinInput, wsAbMaxInput) and inWin(bcRet, wsBcMinInput, wsBcMaxInput) and inWin(cdExt, wsCdMinInput, wsCdMaxInput) and inWin(xadVal, wsXadMinInput, wsXadMaxInput)
            patId := 2
        if patId == 0 and blackOnInput and inWin(abRet, bsAbMinInput, bsAbMaxInput) and inWin(bcRet, bsBcMinInput, bsBcMaxInput) and inWin(cdExt, bsCdMinInput, bsCdMaxInput) and inWin(xadVal, bsXadMinInput, bsXadMaxInput)
            patId := 3
    if patId != 0
        string pName = patId == 1 ? "Nen Star" : patId == 2 ? "White Swan" : "Black Swan"
        color col     = dirCand == 1 ? bullColorInput : bearColorInput
        color faint   = color.new(col, 55)
        color fillCol = color.new(col, 88)
        int xB = xP.barIdx
        int aB = aP.barIdx
        int bB = bP.barIdx
        int cB = cP.barIdx
        int dB = dP.barIdx
        // an extending D refines the same structure, so its previous drawings are replaced instead of stacked
        bool sameStruct = xB == lastXBar and aB == lastABar and bB == lastBBar and cB == lastCBar
        if sameStruct
            for lf in patternFills
                linefill.delete(lf)
            for pl in patternLines
                line.delete(pl)
            for lb in patternLabels
                label.delete(lb)
        array.clear(patternFills)
        array.clear(patternLines)
        array.clear(patternLabels)
        line legXa = line.new(xB, xP.price, aB, aP.price, color = col, width = widthInput)
        line legAb = line.new(aB, aP.price, bB, bP.price, color = col, width = widthInput)
        line legBc = line.new(bB, bP.price, cB, cP.price, color = col, width = widthInput)
        line legCd = line.new(cB, cP.price, dB, dP.price, color = col, width = widthInput)
        // chords split at the opposing anchor so each linefill closes an exact triangle half
        float xbAtA = chordY(xB, xP.price, bB, bP.price, aB)
        float bdAtC = chordY(bB, bP.price, dB, dP.price, cB)
        line chXb1 = line.new(xB, xP.price, aB, xbAtA, color = faint, style = line.style_dotted)
        line chXb2 = line.new(aB, xbAtA, bB, bP.price, color = faint, style = line.style_dotted)
        line chBd1 = line.new(bB, bP.price, cB, bdAtC, color = faint, style = line.style_dotted)
        line chBd2 = line.new(cB, bdAtC, dB, dP.price, color = faint, style = line.style_dotted)
        array.push(patternLines, legXa)
        array.push(patternLines, legAb)
        array.push(patternLines, legBc)
        array.push(patternLines, legCd)
        array.push(patternLines, chXb1)
        array.push(patternLines, chXb2)
        array.push(patternLines, chBd1)
        array.push(patternLines, chBd2)
        if showFillInput
            array.push(patternFills, linefill.new(legXa, chXb1, fillCol))
            array.push(patternFills, linefill.new(legAb, chXb2, fillCol))
            array.push(patternFills, linefill.new(legBc, chBd1, fillCol))
            array.push(patternFills, linefill.new(legCd, chBd2, fillCol))
        // confluence at D between the embedded AB=CD projection and the XA-derived completion
        bool confluent = not na(abcdRatio) and math.abs(abcdRatio - 1.0) <= tolInput
        float abcdLv = cP.price - dirCand * abDist
        if showAbcdInput
            array.push(patternLines, line.new(cB, abcdLv, dB, abcdLv, color = faint, style = line.style_dotted))
        // mechanical risk template: hard invalidation beyond the tolerated D extreme, targets on the CD leg
        float xadLimit = patId == 1 ? nsXadInput + tolInput : patId == 2 ? math.max(wsXadMinInput, wsXadMaxInput) : math.max(bsXadMinInput, bsXadMaxInput)
        float stopLv = dirCand == 1 ? aP.price - xadLimit * xaDist : aP.price + xadLimit * xaDist
        float t1Lv = dP.price + dirCand * FIB_T1 * cdDist
        float t2Lv = dP.price + dirCand * FIB_T2 * cdDist
        if showPointsInput
            array.push(patternLabels, swingLabel(xB, xP.price, "X", xP.dir, col))
            array.push(patternLabels, swingLabel(aB, aP.price, "A", aP.dir, col))
            array.push(patternLabels, swingLabel(bB, bP.price, "B", bP.dir, col))
            array.push(patternLabels, swingLabel(cB, cP.price, "C", cP.dir, col))
        if showRatiosInput
            array.push(patternLabels, ratioLabel((xB + bB) / 2, (xP.price + bP.price) / 2, str.tostring(abRet, "0.000"), faint))
            array.push(patternLabels, ratioLabel((aB + cB) / 2, (aP.price + cP.price) / 2, str.tostring(bcRet, "0.000"), faint))
            array.push(patternLabels, ratioLabel((bB + dB) / 2, (bP.price + dP.price) / 2, str.tostring(cdExt, "0.000"), faint))
        string tip = (dirCand == 1 ? "Bullish " : "Bearish ") + pName + " completed"
        tip := tip + "\nB of XA: " + str.tostring(abRet, "0.000")
        tip := tip + "\nC of AB: " + str.tostring(bcRet, "0.000")
        tip := tip + "\nD of BC: " + str.tostring(cdExt, "0.000")
        tip := tip + "\nD of XA: " + str.tostring(xadVal, "0.000")
        tip := tip + "\nEmbedded CD to AB: " + str.tostring(abcdRatio, "0.000") + (confluent ? " (confluent)" : "")
        tip := tip + "\nInvalidation: " + str.tostring(stopLv, format.mintick)
        tip := tip + "\nTargets: " + str.tostring(t1Lv, format.mintick) + " / " + str.tostring(t2Lv, format.mintick)
        string nameTxt = pName + "\n" + str.tostring(xadVal, "0.00") + " XA" + (confluent ? "\nAB=CD" : "")
        array.push(patternLabels, label.new(dB, dP.price, nameTxt, style = dirCand == 1 ? label.style_label_up : label.style_label_down, color = LABEL_BG, textcolor = col, size = size.small, tooltip = tip))
        // the newest completion becomes the tracked setup, replacing the previous level set
        line.delete(stopLn)
        line.delete(t1Ln)
        line.delete(t2Ln)
        label.delete(stopLb)
        label.delete(t1Lb)
        label.delete(t2Lb)
        if showTradeInput
            stopLn := line.new(dB, stopLv, bar_index, stopLv, color = color.new(col, 25), style = line.style_dashed)
            t1Ln := line.new(dB, t1Lv, bar_index, t1Lv, color = faint, style = line.style_dotted)
            t2Ln := line.new(dB, t2Lv, bar_index, t2Lv, color = faint, style = line.style_dotted)
            stopLb := label.new(bar_index, stopLv, "Invalidation", style = label.style_label_left, color = LABEL_BG, textcolor = color.new(col, 25), size = size.tiny)
            t1Lb := label.new(bar_index, t1Lv, "T1 0.382", style = label.style_label_left, color = LABEL_BG, textcolor = faint, size = size.tiny)
            t2Lb := label.new(bar_index, t2Lv, "T2 0.618", style = label.style_label_left, color = LABEL_BG, textcolor = faint, size = size.tiny)
        activeDir := dirCand
        stopLevel := stopLv
        t1Level := t1Lv
        t2Level := t2Lv
        t1Hit := false
        t2Hit := false
        lastXBar := xB
        lastABar := aB
        lastBBar := bB
        lastCBar := cB
        if dirCand == 1
            bullEvent := true
        else
            bearEvent := true
        if patId == 1
            nenEvent := true
        if patId == 2
            whiteEvent := true
        if patId == 3
            blackEvent := true
        if confluent
            confluentEvent := true

//---------------------------------------------------------------------------------------------------------------------}
// Trade Level Tracking
//---------------------------------------------------------------------------------------------------------------------{
bool invalidEvent = false
bool t1Event = false
bool t2Event = false

if activeDir != 0
    if not na(stopLn)
        line.set_x2(stopLn, bar_index)
    if not na(t1Ln)
        line.set_x2(t1Ln, bar_index)
    if not na(t2Ln)
        line.set_x2(t2Ln, bar_index)
    if not na(stopLb)
        label.set_x(stopLb, bar_index)
    if not na(t1Lb)
        label.set_x(t1Lb, bar_index)
    if not na(t2Lb)
        label.set_x(t2Lb, bar_index)
    // a decisive close beyond the tolerated D extreme kills the setup mechanically
    if (activeDir == 1 and close < stopLevel) or (activeDir == -1 and close > stopLevel)
        invalidEvent := true
        activeDir := 0

if activeDir != 0
    if not t1Hit and ((activeDir == 1 and high >= t1Level) or (activeDir == -1 and low <= t1Level))
        t1Hit := true
        t1Event := true
    if not t2Hit and ((activeDir == 1 and high >= t2Level) or (activeDir == -1 and low <= t2Level))
        t2Hit := true
        t2Event := true

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullEvent, "Bullish Exotic Harmonic", "Bullish exotic harmonic completed - D swing confirmed inside the pattern ratio windows, watch the zone for reversal evidence")
alertcondition(bearEvent, "Bearish Exotic Harmonic", "Bearish exotic harmonic completed - D swing confirmed inside the pattern ratio windows, watch the zone for reversal evidence")
alertcondition(nenEvent, "Nen Star Completed", "Nen Star completed - D swing confirmed near the 1.272 XA anchor within tolerance")
alertcondition(whiteEvent, "White Swan Completed", "White Swan completed - D swing confirmed inside its ratio windows")
alertcondition(blackEvent, "Black Swan Completed", "Black Swan completed - D swing confirmed inside its ratio windows")
alertcondition(confluentEvent, "Confluent Completion (AB=CD)", "Exotic harmonic completed with AB=CD confluence - the embedded projection landed with the XA-derived completion")
alertcondition(invalidEvent, "Completion Invalidated", "Price closed beyond the tolerated D extreme - the active exotic harmonic setup is invalidated")
alertcondition(t1Event, "Target 1 Reached", "Price reached Target 1 - the 0.382 retracement of the CD leg of the active exotic harmonic")
alertcondition(t2Event, "Target 2 Reached", "Price reached Target 2 - the 0.618 retracement of the CD leg of the active exotic harmonic")
//---------------------------------------------------------------------------------------------------------------------}
