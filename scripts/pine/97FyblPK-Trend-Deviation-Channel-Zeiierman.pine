indicator("Trend Deviation Channel (Zeiierman)",overlay=true,max_lines_count=50,max_boxes_count=200,max_labels_count=100,max_bars_back=1500)
//}

// ~~ Tooltips {
var string t1 ="Price series used to fit the trend model and measure deviation. Close is the default, but other price sources can be selected."
var string t2 ="Number of historical bars used to estimate the trend. Higher values create a smoother, slower channel. Lower values react faster to recent price structure."
var string t3 ="Base ATR-normalized trend strength required before the center trendline can enter an Up or Down state. Lower values classify trends more easily. Higher values require stronger directional movement."
var string t4 ="Trend strength level below which an active Up or Down trend returns to Neutral. Lower values keep established trends active longer and create more hysteresis between entry and exit."
var string t5 ="Controls how deviation width is measured. Asymmetric learns separate normal distances above and below trend. Symmetric uses the same deviation width on both sides."
var string t6 ="Maximum residual size allowed to influence deviation-width calculations, measured in ATRs. This reduces the effect of isolated shocks or abnormal candles on the entire channel."
var string t7 ="Minimum allowed deviation width as a fraction of ATR. Prevents the rails from collapsing too tightly around the trend during extremely low-volatility periods."
var string t8 ="Minimum number of historical residuals required on one side of the trend before that side receives its own asymmetric deviation estimate. If there are too few samples, the shared deviation scale is used instead."
var string t9 ="Distance of the first deviation rail from the trend baseline. This defines the normal Core region around trend and the point where Stretch begins."
var string t10="Distance of the second deviation rail from the trend baseline. Crossing this level generates the optional 2D Expansion and Re-entry signals."
var string t11="Distance of the outer deviation rail from the trend baseline. Crossing this level generates the 3D Expansion and Re-entry events."
var string t12="Controls how slowly previous deviation stress fades. Higher values retain memory of repeated or persistent movement beyond the first deviation rail for longer. This does not change the rail positions."
var string t13="Show the +1D, +2D, +3D, 0 TREND, -1D, -2D and -3D labels at the projected end of the trend channel."
var string t14="Show a live label beside current price displaying its normalized distance from trend and current deviation zone, such as +1.25D STRETCH."
var string t15="Show confirmed 2D Expansion markers when price closes beyond the upper or lower 2D deviation rail."
var string t16="Show confirmed 2D Re-entry markers when price closes back inside the upper or lower 2D deviation rail."
var string t17="Show confirmed 3D Expansion markers when price closes beyond the upper or lower 3D deviation rail. These use larger diamond markers to distinguish extreme displacement."
var string t18="Show confirmed 3D Re-entry markers when price closes back inside the upper or lower 3D deviation rail. These use larger triangle markers to distinguish extreme re-entry."
var string t19="Color of the center 0 TREND line when the trend model is classified as bullish."
var string t20="Color of the center 0 TREND line when the trend model is classified as bearish."
var string t21="Color of the center 0 TREND line when directional strength is insufficient for an active bullish or bearish trend state."
var string t22="Color used for positive deviation rails, upper channel zones, upper profile bins and upside deviation events."
var string t23="Color used for negative deviation rails, lower channel zones, lower profile bins and downside deviation events."
var string t24="Show the rolling deviation distribution profile outside the projected trend channel. The profile measures how frequently price has occupied different normalized distances from trend."
var string t25="Number of vertical buckets used to build the deviation profile. More bins provide finer distribution detail but can make the profile noisier. Fewer bins create a smoother distribution."
var string t26="Maximum positive and negative deviation range displayed by the profile, measured in D units. Observations outside this range are not included in the visible histogram. The range will not be smaller than the outer deviation rail."
var string t27="Horizontal distance in bars between the projected end of the trend channel and the beginning of the deviation profile."
var string t28="Maximum horizontal width of the most populated profile bin, measured in bars. All other bins are scaled proportionally to their observation count."
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Groups {
gT="1. Trend Model"
gD="2. Deviation Engine"
gV="3. Visuals"
gS="4. Signal Markers"
gP="5. Deviation Profile"
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs {
s=input.source(close,"Source",group=gT,tooltip=t1)
tl=input.int(200,"Trend Length",20,400,group=gT,tooltip=t2)
te=input.float(1.0,"Trend Enter Strength",0.1,step=0.1,group=gT,tooltip=t3)
tx=input.float(0.25,"Trend Exit Strength",0.0,step=0.05,group=gT,tooltip=t4)

dm=input.string("Asymmetric","Deviation Shape",["Asymmetric","Symmetric"],group=gD,tooltip=t5)
cap=input.float(4.0,"Residual Shock Cap (ATR)",1.0,20.0,0.25,group=gD,tooltip=t6)
mn=input.float(0.05,"Minimum Deviation Width (ATR)",0.01,1.0,0.01,group=gD,tooltip=t7)
ns=input.int(12,"Minimum One-Side Samples",3,100,group=gD,tooltip=t8)
d1i=input.float(1.0,"Deviation 1",0.25,step=0.25,group=gD,tooltip=t9)
d2i=input.float(2.0,"Deviation 2",0.5,step=0.25,group=gD,tooltip=t10)
d3i=input.float(3.0,"Deviation 3",0.75,step=0.25,group=gD,tooltip=t11)
sd=input.float(0.90,"Stretch Memory",0.50,0.99,0.01,group=gD,tooltip=t12)

slb=input.bool(true,"Show Rail Labels",group=gV,tooltip=t13)
sbd=input.bool(false,"Show Current Deviation",group=gV,tooltip=t14)
cu=input.color(color.rgb(18,209,235),"Up Trend",group=gV,tooltip=t19)
cd=input.color(color.rgb(250,40,86),"Down Trend",group=gV,tooltip=t20)
cn=input.color(color.rgb(150,150,150),"Neutral Trend",group=gV,tooltip=t21)
uc=input.color(color.rgb(255,112,67),"Upper Deviation",group=gV,tooltip=t22)
dc=input.color(color.rgb(0,188,212),"Lower Deviation",group=gV,tooltip=t23)

s2e=input.bool(true,"Show 2D Expansion",group=gS,tooltip=t15)
s2r=input.bool(true,"Show 2D Re-entry",group=gS,tooltip=t16)
s3e=input.bool(false,"Show 3D Expansion",group=gS,tooltip=t17)
s3r=input.bool(false,"Show 3D Re-entry",group=gS,tooltip=t18)

sp=input.bool(true,"Show Deviation Profile",group=gP,tooltip=t24)
pb=input.int(20,"Bins",11,61,group=gP,tooltip=t25)
pr0=input.float(3.1,"Profile Range (D)",1.0,6.0,0.25,group=gP,tooltip=t26)
pg=input.int(12,"Profile Gap",0,50,group=gP,tooltip=t27)
pw=input.int(24,"Profile Max Width",5,100,group=gP,tooltip=t28)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Constants {
const int C=0
const int U1=1
const int U2=2
const int U3=3
const int D1=4
const int D2=5
const int D3=6
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Types {
type Rail
    float z
    string nm
    int lvl
    line ln

type Prof
    array<float> v
    array<int> bin
    array<box> bx
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ State {
d1=math.max(0.25,d1i)
d2=math.max(d1+0.10,d2i)
d3=math.max(d2+0.10,d3i)
pr=math.max(pr0,d3)

var array<Rail> rl=array.new<Rail>()
var array<linefill> fl=array.new<linefill>()
var array<label> lb=array.new<label>()
var Prof pf=Prof.new(array.new_float(),array.new_int(pb,0),array.new<box>())
var int tr=0
var float st=0.0
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Helpers {
zPx(float c,float z,float us,float ds)=>c+(z>=0?z*us:z*ds)
rlCol(float z,color tc)=>z>0?uc:z<0?dc:tc
rlSty(int n)=>n==2?line.style_dashed:n==3?line.style_dotted:line.style_solid
rlWid(int n)=>n==0?3:n==2?2:1
rlTr(int n)=>n==1?10:n==2?0:n==3?20:0
zone(float z)=>math.abs(z)<d1?"CORE":math.abs(z)<d2?"STRETCH":math.abs(z)<d3?"EXTREME":"DISLOCATED"
trTxt(int x)=>x==1?"UP":x==-1?"DOWN":"NEUTRAL"

clearLb(array<label> a)=>
    while a.size()>0
        label.delete(a.pop())
    0

hideBx(box b,int x,float y)=>
    box.set_left(b,x)
    box.set_right(b,x)
    box.set_top(b,y)
    box.set_bottom(b,y)
    box.set_bgcolor(b,color.new(chart.fg_color,100))
    box.set_border_color(b,color.new(chart.fg_color,100))
    0

addRail(array<Rail> a,float z,string nm,int lvl)=>
    a.push(Rail.new(z,nm,lvl,line.new(na,na,na,na,xloc=xloc.bar_index,extend=extend.none)))
    0

initRails(array<Rail> a)=>
    addRail(a,0.0,"0 TREND",0)
    addRail(a,d1,"+1D",1)
    addRail(a,d2,"+2D",2)
    addRail(a,d3,"+3D",3)
    addRail(a,-d1,"-1D",1)
    addRail(a,-d2,"-2D",2)
    addRail(a,-d3,"-3D",3)
    0

initFills(array<Rail> a,array<linefill> f)=>
    f.push(linefill.new(a.get(C).ln,a.get(U1).ln,color.new(uc,96)))
    f.push(linefill.new(a.get(U1).ln,a.get(U2).ln,color.new(uc,92)))
    f.push(linefill.new(a.get(U2).ln,a.get(U3).ln,color.new(uc,87)))
    f.push(linefill.new(a.get(C).ln,a.get(D1).ln,color.new(dc,96)))
    f.push(linefill.new(a.get(D1).ln,a.get(D2).ln,color.new(dc,92)))
    f.push(linefill.new(a.get(D2).ln,a.get(D3).ln,color.new(dc,87)))
    0

method railPaint(Rail r,int x1,int x2,float c1,float c2,float us,float ds,color tc)=>
    y1=zPx(c1,r.z,us,ds)
    y2=zPx(c2,r.z,us,ds)
    col=rlCol(r.z,tc)
    line.set_xy1(r.ln,x1,y1)
    line.set_xy2(r.ln,x2,y2)
    line.set_color(r.ln,r.lvl==0?col:color.new(col,rlTr(r.lvl)))
    line.set_width(r.ln,rlWid(r.lvl))
    line.set_style(r.ln,rlSty(r.lvl))
    0

method railTag(Rail r,array<label> a,int x,float c,float us,float ds,color tc,float ts,float ef,float req,int tr)=>
    y=zPx(c,r.z,us,ds)
    col=rlCol(r.z,tc)
    tip=r.lvl==0?"State: "+trTxt(tr)+"\nTrend Strength: "+str.tostring(ts,"#.##")+" ATR\nRequired Strength: "+str.tostring(req,"#.##")+" ATR\nPath Efficiency: "+str.tostring(ef*100,"#.0")+"%":"Deviation rail: "+r.nm
    a.push(label.new(x,y,r.nm,xloc=xloc.bar_index,yloc=yloc.price,style=label.style_label_left,color=color.new(chart.bg_color,100),textcolor=col,size=size.tiny,tooltip=tip))
    0

dev(float _s,int len,float re,float sl,float cp,int minN)=>
    uss=0.0
    dss=0.0
    ass=0.0
    un=0
    dn=0
    an=0

    for i=1 to len
        fit=re-sl*(i-1)
        r=_s[i]-fit

        if not na(r)
            q=math.max(-cp,math.min(cp,r))
            ass+=q*q
            an+=1

            if q>=0
                uss+=q*q
                un+=1
            else
                dss+=q*q
                dn+=1

    av=an>1?math.sqrt(ass/an):na
    up=un>=minN?math.sqrt(uss/un):av
    dp=dn>=minN?math.sqrt(dss/dn):av
    [up,dp,av]

entryReq(float ef)=>
    q=0.18<=0?1.0:math.max(0.0,math.min(1.0,ef/0.18))
    te*(1.50-0.50*q)

nextTrend(int x,float ts,float req)=>
    out=x

    if x==0
        if ts>req
            out:=1
        else if ts<-req
            out:=-1
    else if x==1
        if ts<-req
            out:=-1
        else if ts<tx
            out:=0
    else
        if ts>req
            out:=1
        else if ts>-tx
            out:=0

    out

drawRails(array<Rail> a,int x1,int x2,float c1,float c2,float us,float ds,color tc)=>
    for i=0 to a.size()-1
        a.get(i).railPaint(x1,x2,c1,c2,us,ds,tc)
    0

drawTags(array<Rail> a,array<label> out,int x,float c,float us,float ds,color tc,float ts,float ef,float req,int tr)=>
    clearLb(out)

    if slb
        for i=0 to a.size()-1
            a.get(i).railTag(out,x,c,us,ds,tc,ts,ef,req,tr)

    0

badge(array<label> a,float z,float y,float st,color tc)=>
    if sbd
        sg0=z>=0?"+":""
        bc=z>0?uc:z<0?dc:tc
        txt=sg0+str.tostring(z,"#.##")+"D  "+zone(z)
        tip="Current price deviation from the trend projection. Stretch memory: "+str.tostring(st,"#.##")
        a.push(label.new(bar_index+1,y,txt,xloc=xloc.bar_index,yloc=yloc.price,style=label.style_label_left,color=color.new(bc,78),textcolor=chart.fg_color,size=size.small,tooltip=tip))
    0
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Profile Engine {
method profAdd(Prof p,float z,int keep)=>
    if not na(z)
        p.v.push(z)

        while p.v.size()>keep
            p.v.shift()
    0

method profPut(Prof p,float z)=>
    if not na(z) and z>=-pr and z<=pr
        q=(z+pr)/(2.0*pr)
        id=int(math.floor(q*pb))
        id:=math.max(0,math.min(pb-1,id))
        p.bin.set(id,p.bin.get(id)+1)
    0

method profEnsure(Prof p,int x,float y)=>
    while p.bx.size()<pb
        p.bx.push(box.new(left=x,top=y,right=x,bottom=y,xloc=xloc.bar_index,bgcolor=color.new(chart.fg_color,100),border_color=color.new(chart.fg_color,100)))
    0

method profBuild(Prof p,float liveZ,bool liveOn)=>
    p.bin.fill(0)

    if p.v.size()>0
        for i=0 to p.v.size()-1
            p.profPut(p.v.get(i))

    if liveOn
        p.profPut(liveZ)

    0

method profPaint(Prof p,float liveZ,bool liveOn,int x,float pc,float us,float ds,color tc)=>
    p.profEnsure(x,pc)
    p.profBuild(liveZ,liveOn)

    mx=0
    for i=0 to pb-1
        mx:=math.max(mx,p.bin.get(i))

    dz=2.0*pr/pb

    for i=0 to pb-1
        b=p.bx.get(i)
        n=p.bin.get(i)

        if sp and n>0 and mx>0
            zl=-pr+dz*i
            zh=zl+dz
            zm=(zl+zh)*0.5

            yl=zPx(pc,zl,us,ds)
            yh=zPx(pc,zh,us,ds)

            w=math.max(1,int(math.round(pw*float(n)/float(mx))))
            c=math.abs(zm)<0.25?tc:zm>0?uc:dc

            box.set_left(b,x)
            box.set_right(b,x+w)
            box.set_top(b,yh)
            box.set_bottom(b,yl)
            box.set_bgcolor(b,color.new(c,72))
            box.set_border_color(b,color.new(c,88))
        else
            hideBx(b,x,pc)

    0
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Static Setup {
if barstate.isfirst
    initRails(rl)
    initFills(rl,fl)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Deviation Engine {
re=ta.linreg(s[1],tl,0)
rp=ta.linreg(s[1],tl,1)
sg=re-rp
at=ta.atr(100)[1]

ok=not na(re) and not na(sg) and not na(at) and at>0
cp=at*cap

[ur,dr,ar]=dev(s,tl,re,sg,cp,ns)

f0=at*mn
sh=ok and not na(ar)?math.max(ar,f0):na
us=dm=="Symmetric"?sh:ok and not na(ur)?math.max(ur,f0):sh
ds=dm=="Symmetric"?sh:ok and not na(dr)?math.max(dr,f0):sh

bs=ok?re+sg:na
rr=ok?s-bs:na
z=ok?rr>=0?rr/us:rr/ds:na
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Trend State {
path=ta.sma(math.abs(ta.change(s)),tl-1)[1]*(tl-1)
disp=math.abs(s[1]-s[tl])

ef=ok and path>0?disp/path:0.0
ts=ok?sg*(tl-1)/at:na
req=ok?entryReq(ef):na

if barstate.isconfirmed and ok
    tr:=nextTrend(tr,ts,req)
    st:=math.min(3.0,st*sd+math.max(math.abs(z)-d1,0.0)*(1.0-sd))
    pf.profAdd(z,tl)

tc=tr==1?cu:tr==-1?cd:cn
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Drawing {
if barstate.islast and ok
    x1=bar_index-tl
    x2=bar_index+5
    c1=re-sg*(tl-1)
    c2=bs+sg*5

    drawRails(rl,x1,x2,c1,c2,us,ds,tc)
    drawTags(rl,lb,x2,c2,us,ds,tc,ts,ef,req,tr)
    badge(lb,z,s,st,tc)

    px=x2+pg
    pc=bs+sg*(5+pg)

    pf.profPaint(z,barstate.isrealtime and not barstate.isconfirmed,px,pc,us,ds,tc)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Signals {
xoU=ta.crossover(z,d2)
xoD=ta.crossunder(z,-d2)
xiU=ta.crossunder(z,d2)
xiD=ta.crossover(z,-d2)

xoU3=ta.crossover(z,d3)
xoD3=ta.crossunder(z,-d3)
xiU3=ta.crossunder(z,d3)
xiD3=ta.crossover(z,-d3)

uEx=barstate.isconfirmed and ok and xoU
dEx=barstate.isconfirmed and ok and xoD
uIn=barstate.isconfirmed and ok and xiU
dIn=barstate.isconfirmed and ok and xiD

uEx3=barstate.isconfirmed and ok and xoU3
dEx3=barstate.isconfirmed and ok and xoD3
uIn3=barstate.isconfirmed and ok and xiU3
dIn3=barstate.isconfirmed and ok and xiD3

plotshape(s2e and uEx and not (s3e and uEx3),"Upper 2D Expansion",shape.circle,location.abovebar,uc,size=size.tiny,text="2D",textcolor=color.white)
plotshape(s2e and dEx and not (s3e and dEx3),"Lower 2D Expansion",shape.circle,location.belowbar,dc,size=size.tiny,text="2D",textcolor=color.white)

plotshape(s3e and uEx3,"Upper 3D Expansion",shape.diamond,location.abovebar,uc,size=size.small,text="3D",textcolor=color.white)
plotshape(s3e and dEx3,"Lower 3D Expansion",shape.diamond,location.belowbar,dc,size=size.small,text="3D",textcolor=color.white)

plotshape(s2r and uIn,"Upper 2D Re-entry",shape.triangledown,location.abovebar,uc,size=size.tiny)
plotshape(s2r and dIn,"Lower 2D Re-entry",shape.triangleup,location.belowbar,dc,size=size.tiny)

plotshape(s3r and uIn3,"Upper 3D Re-entry",shape.triangledown,location.abovebar,uc,size=size.small,text="3D",textcolor=color.white)
plotshape(s3r and dIn3,"Lower 3D Re-entry",shape.triangleup,location.belowbar,dc,size=size.small,text="3D",textcolor=color.white)

alertcondition(uEx,"Upper 2D Expansion","Price closed beyond the upper 2D trend-deviation rail.")
alertcondition(dEx,"Lower 2D Expansion","Price closed beyond the lower 2D trend-deviation rail.")
alertcondition(uIn,"Upper 2D Re-entry","Price closed back inside the upper 2D trend-deviation rail.")
alertcondition(dIn,"Lower 2D Re-entry","Price closed back inside the lower 2D trend-deviation rail.")

alertcondition(uEx3,"Upper 3D Expansion","Price closed beyond the upper 3D trend-deviation rail.")
alertcondition(dEx3,"Lower 3D Expansion","Price closed beyond the lower 3D trend-deviation rail.")
alertcondition(uIn3,"Upper 3D Re-entry","Price closed back inside the upper 3D trend-deviation rail.")
alertcondition(dIn3,"Lower 3D Re-entry","Price closed back inside the lower 3D trend-deviation rail.")
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}