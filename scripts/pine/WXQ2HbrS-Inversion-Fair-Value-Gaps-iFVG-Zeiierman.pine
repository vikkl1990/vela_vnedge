//@version=6
indicator("Inversion Fair Value Gaps [iFVG] (Zeiierman)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)
//}

// ~~ Tooltips {
var string t1  = "Controls the minimum size an FVG must have before it is accepted. The gap size is compared with the average ATR of the three candles that formed it. Higher values show fewer but larger and more significant gaps. Lower values show more gaps, including smaller and noisier ones. Use a higher value to reduce clutter and a lower value for more sensitivity."
var string t2  = "When enabled, an FVG is only accepted if it forms close to a confirmed swing point. Bullish FVGs must be near a swing low, while bearish FVGs must be near a swing high. This can remove weaker gaps that form in the middle of random price movement, but it will also reduce the total number of signals."
var string t3  = "Controls how large a swing must be before it is confirmed as a fractal. Higher values require more candles on both sides of the swing, creating stronger but slower and less frequent swing points. Lower values confirm smaller swings faster, producing more signals but also more market noise."
var string t4  = "Controls how close the confirmed fractal must be to the FVG structure. Higher values allow the FVG to form farther away from the swing, which increases the number of accepted gaps. Lower values require a tighter connection between the swing and the FVG, which is more selective but may miss valid setups."
var string t5  = "Controls how long a broken FVG remains available to pair with a new opposing FVG and create an iFVG. Higher values give the market more time to form the opposing gap, producing more possible iFVG pairings. Lower values require the reversal to happen quickly, creating fewer but more immediate setups."
var string t6  = "Controls what happens after a zone reaches its mitigation level. When enabled, the zone is removed from the chart. When disabled, the zone stops extending and remains visible as historical context. Keeping old zones can help with review, but it also adds more objects to the chart."
var string t7  = "Defines how deeply price must enter a zone before it is considered mitigated. 50% Fill marks the zone as mitigated when price reaches its midpoint. Full Fill waits until price reaches the far edge of the zone. 50% Fill reacts earlier, while Full Fill is stricter and keeps zones active longer."
var string t8  = "Selects which price data confirms mitigation. Wicks count any intrabar touch of the mitigation level, so zones are removed or frozen sooner. Close requires the candle to close through the level, which is slower but filters out temporary wick penetrations."
var string t9  = "When enabled, zones that are too far from current price are hidden to keep the chart cleaner and reduce rendering work. Hidden zones are not deleted and continue to exist internally. They can become visible again when price moves back within the allowed distance."
var string t10 = "Sets the maximum distance between current price and the nearest edge of a zone, measured in ATR. Higher values keep more distant zones visible. Lower values show only zones close to price, producing a cleaner and faster chart. This setting affects visibility only and does not change detection or alerts."
var string t11 = "When enabled, nearby live zones of the same type and direction are visually combined into one larger zone. This reduces overlap and chart clutter. The original zones still exist internally, so detection, mitigation, memory, and alerts continue to use the original logic."
var string t12 = "Controls how far apart two compatible zones may be and still appear merged, measured in ATR. Higher values combine more zones and create broader visual areas. Lower values only merge zones that overlap or sit very close together. A value near zero gives the most precise separation."
var string t13 = "Shows regular Fair Value Gap zones on the chart. This switch controls regular FVG drawings only. Detection, internal memory, inversion pairing, and alerts continue to operate even when regular FVG zones are hidden. Enable it for full gap context or disable it to display only the selected iFVG zones."
var string t14 = "Shows inversion Fair Value Gap zones on the chart. This switch controls iFVG drawings only and does not disable iFVG detection, mitigation tracking, memory, or alerts. Disable it when you want to inspect regular FVGs without displaying inversion zones."
var string t15 = "Shows a horizontal equilibrium line at the exact midpoint of every visible FVG and iFVG zone. The line is rendered independently for each zone type, so enabling regular FVGs does not remove iFVG EQ lines and enabling iFVGs does not remove regular FVG EQ lines. Hidden zone types do not display an EQ line."
var string t26 = "Gradually makes older visible zones more transparent. This helps recent zones stand out while older zones remain visible in the background. It changes the box appearance only and does not affect EQ lines, detection, mitigation, alerts, or zone validity."
var string t16 = "Shows the name of each live visible zone, such as Bullish FVG or Bearish iFVG. Disable this for a cleaner chart and slightly lower drawing workload. Mitigated zones that have stopped extending do not keep active labels."
var string t17 = "When enabled, label text automatically uses the matching zone color. When disabled, all labels use the custom text color selected below. Use zone colors for faster visual identification or one custom color for a more uniform appearance."
var string t18 = "Sets the label text color used when Use Zone Color as Text is disabled. This changes label appearance only and has no effect on detection or alerts."
var string t19 = "Controls the size of all FVG and iFVG labels. Larger sizes are easier to read but take more chart space. Smaller sizes reduce clutter and are better when many zones are visible."
var string t20 = "Controls how many bars to the right of the current candle live labels are placed. Higher values move labels farther away from price and reduce overlap with candles. Lower values keep labels closer to the active zone."
var string t21 = "Sets the fill color and transparency of bullish regular FVG zones. More transparency makes the zone lighter and less dominant. Less transparency makes it stronger and easier to see. This can also be used as the bullish FVG label color."
var string t22 = "Sets the fill color and transparency of bearish regular FVG zones. More transparency makes the zone lighter and less dominant. Less transparency makes it stronger and easier to see. This can also be used as the bearish FVG label color."
var string t23 = "Sets the fill color and transparency of bullish inversion FVG zones. More transparency creates a softer background. Less transparency makes bullish iFVGs stand out more clearly. This can also be used as the bullish iFVG label color."
var string t24 = "Sets the fill color and transparency of bearish inversion FVG zones. More transparency creates a softer background. Less transparency makes bearish iFVGs stand out more clearly. This can also be used as the bearish iFVG label color."
var string t25 = "Sets the color and transparency of the equilibrium midpoint line. Use a stronger color to make the 50% level easier to see, or a more transparent color to keep it subtle. This changes appearance only."
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Groups {
var string gDet = "1. Detection"
var string gFrac = "2. Fractal Filter"
var string gMem = "3. Memory"
var string gMit = "4. Mitigation"
var string gDist = "5. Distance Filter"
var string gMerge = "6. Zone Merging"
var string gView = "7. Display"
var string gText = "8. Labels"
var string gStyle = "9. Styling"
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs {
float minGap = input.float(0.10, "Minimum FVG Size", minval=0.0, maxval=2.0, step=0.05, group=gDet, tooltip=t1)

bool useFrac = input.bool(false, "Enable Fractal Filter", group=gFrac, tooltip=t2)
int fracLen  = input.int(1, "Fractal Length", minval=1, maxval=10, group=gFrac, tooltip=t3)
int fracNear = input.int(3, "Maximum Distance From FVG", minval=0, maxval=20, group=gFrac, tooltip=t4)

int pairWin = input.int(8, "Pairing Window", minval=1, maxval=50, group=gMem, tooltip=t5)

bool delFilled   = input.bool(true, "Delete Mitigated Zones", group=gMit, tooltip=t6)
string fillLvl   = input.string("Full Fill", "Mitigation Level", options=["50% Fill", "Full Fill"], group=gMit, tooltip=t7)
string fillSrc   = input.string("Wicks", "Mitigation Source", options=["Wicks", "Close"], group=gMit, tooltip=t8)

bool useDist  = input.bool(true, "Filter Distant Zones", group=gDist, tooltip=t9)
float maxDist = input.float(50.0, "Maximum Distance From Price", minval=1.0, maxval=500.0, step=1.0, group=gDist, tooltip=t10)

bool useMerge   = input.bool(true, "Merge Nearby Zones", group=gMerge, tooltip=t11)
float mergeDist = input.float(2.35, "Maximum Merge Distance", minval=0.0, maxval=10.0, step=0.05, group=gMerge, tooltip=t12)

bool showIfvg = input.bool(true, "Show iFVGs", group=gView, tooltip=t14)
bool showFvg  = input.bool(false, "Show Regular FVGs", group=gView, tooltip=t13)
bool showEq   = input.bool(true, "Show EQ Line", group=gView, tooltip=t15)
bool fadeOld  = input.bool(false, "Fade With Age", group=gView, tooltip=t26)

bool showText      = input.bool(true, "Show Labels", group=gText, tooltip=t16)
bool zoneTextColor = input.bool(true, "Use Zone Color as Text", group=gText, tooltip=t17)
color textClr      = input.color(color.white, "Custom Text Color", group=gText, tooltip=t18)
string textSz      = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=gText, tooltip=t19)
int textOff        = input.int(5, "Label Offset Right", minval=0, maxval=50, group=gText, tooltip=t20)

color fvgUpClr  = input.color(color.new(#00A884, 89), "Bullish FVG", group=gStyle, tooltip=t21)
color fvgDnClr  = input.color(color.new(#E5484D, 89), "Bearish FVG", group=gStyle, tooltip=t22)
color ifvgUpClr = input.color(color.new(#2E6BFF, 72), "Bullish iFVG", group=gStyle, tooltip=t23)
color ifvgDnClr = input.color(color.new(#FF8A1F, 72), "Bearish iFVG", group=gStyle, tooltip=t24)
color eqClr     = input.color(color.new(#A7B0BD, 20), "EQ Line", group=gStyle, tooltip=t25)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Types {
type Mem
    float hi
    float lo
    bool up
    int born
    int left
    int leftTime
    float srcHi
    float srcLo
    int breakBar

type Zone
    float hi
    float lo
    float mid
    float mit
    bool up
    bool inv
    int left
    int leftTime
    int born
    int bornTime
    int stop
    int endTime
    bool hit
    bool live
    bool dead
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ State {
var array<Mem> mem    = array.new<Mem>()
var array<Zone> zones = array.new<Zone>()

float atr     = ta.atr(14)
float distAtr = atr
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw State {
var array<box> boxes    = array.new_box()
var array<line> lines   = array.new_line()
var array<label> labels = array.new_label()
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Helpers {
zoneColor(bool up, bool inv) =>
    inv ? (up ? ifvgUpClr : ifvgDnClr) : (up ? fvgUpClr : fvgDnClr)

fadeColor(color clr, int age) =>
    float base = color.t(clr)
    float pct  = math.min(age, 100) / float(100)
    color.new(clr, math.min(95.0, base + pct * (95.0 - base)))

zoneText(Zone z) =>
    z.inv ? (z.up ? "Bullish iFVG" : "Bearish iFVG") : (z.up ? "Bullish FVG" : "Bearish FVG")

textSize() =>
    textSz == "Tiny" ? size.tiny : textSz == "Small" ? size.small : textSz == "Normal" ? size.normal : size.large

textColor(Zone z) =>
    zoneTextColor ? color.new(zoneColor(z.up, z.inv), 0) : textClr

zoneDist(float hi, float lo) =>
    close > hi ? close - hi : close < lo ? lo - close : 0.0

inRange(Zone z) =>
    bool apply = z.inv ? true : true
    not useDist or not apply or na(distAtr) or zoneDist(z.hi, z.lo) <= distAtr * maxDist

typeVisible(Zone z) =>
    z.inv ? showIfvg : showFvg

isVisible(Zone z) =>
    typeVisible(z) and not z.dead and inRange(z)

rightTime(Zone z) =>
    z.live ? time : z.endTime

nearFvg(int fracBar) =>
    int first   = bar_index - 2
    int impulse = bar_index - 1
    bool nearStart = not na(fracBar) and math.abs(fracBar - first) <= fracNear
    bool nearMove  = not na(fracBar) and math.abs(fracBar - impulse) <= fracNear
    nearStart or nearMove

newZone(float hi, float lo, bool up, bool inv, int left, int leftTime, int born, int bornTime) =>
    float mid = math.avg(hi, lo)
    float mit = fillLvl == "50% Fill" ? mid : up ? lo : hi
    Zone.new(hi, lo, mid, mit, up, inv, left, leftTime, born, bornTime, -1, na, false, true, false)

freezeZone(Zone z, int endBar, int endTime) =>
    Zone.new(z.hi, z.lo, z.mid, z.mit, z.up, z.inv, z.left, z.leftTime, z.born, z.bornTime, endBar, endTime, z.hit, false, false)

killZone(Zone z) =>
    Zone.new(z.hi, z.lo, z.mid, z.mit, z.up, z.inv, z.left, z.leftTime, z.born, z.bornTime, z.stop, z.endTime, z.hit, false, true)

markTested(Zone z) =>
    Zone.new(z.hi, z.lo, z.mid, z.mit, z.up, z.inv, z.left, z.leftTime, z.born, z.bornTime, z.stop, z.endTime, true, z.live, z.dead)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Merge {
mergeEnabled(Zone z) =>
    z.live and not z.dead

mergeKey(Zone z) =>
    z.inv ? (z.up ? 0 : 1) : (z.up ? 2 : 3)

zoneGap(Zone a, Zone b) =>
    float gap = 0.0

    if a.hi < b.lo
        gap := b.lo - a.hi
    else if b.hi < a.lo
        gap := a.lo - b.hi
    gap

canMerge(Zone a, Zone b) =>
    bool sameKind = a.inv == b.inv
    bool sameDir  = a.up == b.up
    bool sameLive = a.live == b.live
    bool liveOk   = (a.live and b.live)
    bool distOk   = na(atr) or zoneGap(a, b) <= atr * mergeDist
    useMerge and sameKind and sameDir and sameLive and liveOk and distOk

mergeZone(Zone a, Zone b) =>
    float hi  = math.max(a.hi, b.hi)
    float lo  = math.min(a.lo, b.lo)
    float mid = math.avg(hi, lo)
    float mit = fillLvl == "50% Fill" ? mid : a.up ? lo : hi

    bool aLeft   = a.left <= b.left
    int left     = aLeft ? a.left : b.left
    int leftTime = aLeft ? a.leftTime : b.leftTime

    bool bNewer  = b.born > a.born
    int born     = bNewer ? b.born : a.born
    int bornTime = bNewer ? b.bornTime : a.bornTime

    int stop    = a.live ? -1 : math.max(a.stop, b.stop)
    int endTime = na(a.endTime) ? b.endTime : na(b.endTime) ? a.endTime : math.max(a.endTime, b.endTime)

    bool hit  = a.hit or b.hit
    bool live = a.live and b.live
    Zone.new(hi, lo, mid, mit, a.up, a.inv, left, leftTime, born, bornTime, stop, endTime, hit, live, false)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Memory {
memExpired(Mem m) =>
    bool old   = bar_index - m.born > 200
    bool spent = m.breakBar >= 0 and bar_index - m.breakBar > pairWin
    old or spent

trackBreak(Mem m) =>
    int br = m.breakBar

    if br < 0
        bool crossed = m.up ? close < m.lo : close > m.hi

        if crossed
            br := bar_index

    Mem.new(m.hi, m.lo, m.up, m.born, m.left, m.leftTime, m.srcHi, m.srcLo, br)

addMem(array<Mem> arr, float hi, float lo, bool up, int born, int left, int leftTime, float srcHi, float srcLo, 
    int breakBar) =>
    arr.push(Mem.new(hi, lo, up, born, left, leftTime, srcHi, srcLo, breakBar))

cleanMem() =>
    int n = mem.size()

    if n > 0
        for i = n - 1 to 0
            Mem m = trackBreak(mem.get(i))

            if memExpired(m)
                mem.remove(i)
            else
                mem.set(i, m)

    while mem.size() > 100
        mem.shift()
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Zone State {
entered(Zone z) =>
    z.up ? low <= z.hi : high >= z.lo

mitigated(Zone z) =>
    float p   = fillSrc == "Wicks" ? (z.up ? low : high) : close
    z.up ? p <= z.mit : p >= z.mit

dropFresh(float hi, float lo, bool up) =>
    int n = zones.size()

    if n > 0
        for i = n - 1 to 0
            Zone z = zones.get(i)
            bool same = not z.dead and not z.inv and z.up == up
            bool hit = z.lo < hi and z.hi > lo

            if same and hit
                zones.set(i, killZone(z))
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Engine {
processGap(float hi, float lo, bool up) =>
    bool madeInv = false

    float keep  = nz(atr[1]) * math.max(minGap, 0.05)
    float gapHi = hi
    float gapLo = lo
    bool alive  = true

    array<Mem> next = array.new<Mem>()
    int n = mem.size()

    if n > 0
        for i = 0 to n - 1
            Mem old = mem.get(i)

            float cutHi = math.min(gapHi, old.hi)
            float cutLo = math.max(gapLo, old.lo)

            float zoneHi = math.min(hi, old.srcHi)
            float zoneLo = math.max(lo, old.srcLo)

            bool same     = old.up == up
            bool noHit    = cutHi <= cutLo
            bool tooSmall = zoneHi - zoneLo < nz(atr[1]) * minGap

            if not alive or same or noHit or tooSmall
                next.push(old)
                continue

            zones.push(newZone(zoneHi, zoneLo, up, true, old.left, old.leftTime, bar_index - 1, time[1]))
            dropFresh(zoneHi, zoneLo, old.up)
            madeInv := true

            if old.hi - cutHi >= keep
                next.push(Mem.new(old.hi, cutHi, old.up, old.born, old.left, old.leftTime, old.srcHi, old.srcLo, 
                old.breakBar))

            if cutLo - old.lo >= keep
                next.push(Mem.new(cutLo, old.lo, old.up, old.born, old.left, old.leftTime, old.srcHi, old.srcLo, 
                old.breakBar))

            bool full   = cutHi >= gapHi and cutLo <= gapLo
            bool topHit = cutHi >= gapHi
            bool botHit = cutLo <= gapLo

            if full
                alive := false
            else if topHit
                gapHi := cutLo
            else if botHit
                gapLo := cutHi
            else
                gapLo := cutHi

            if alive and gapHi - gapLo < keep
                alive := false
    mem.clear()

    int nextCount = next.size()

    if nextCount > 0
        for i = 0 to nextCount - 1
            mem.push(next.get(i))

    if alive and gapHi - gapLo >= keep
        addMem(mem, gapHi, gapLo, up, bar_index, bar_index - 1, time[1], hi, lo, -1)

    if not madeInv
        zones.push(newZone(hi, lo, up, false, bar_index - 1, time[1], bar_index - 1, time[1]))
    madeInv
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Fractals {
float pivotLo = ta.pivotlow(low, fracLen, fracLen)
float pivotHi = ta.pivothigh(high, fracLen, fracLen)

bool newLo = not na(pivotLo)
bool newHi = not na(pivotHi)

int loFrac = ta.valuewhen(newLo, bar_index - fracLen, 0)
int hiFrac = ta.valuewhen(newHi, bar_index - fracLen, 0)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Detection {
float gapAtr = math.avg(atr, math.avg(atr[1], atr[2]))

bool bullW = low > high[2]
bool bearW = high < low[2]

float bodyTop2 = math.max(open[2], close[2])
float bodyBot2 = math.min(open[2], close[2])
float bodyTop0 = math.max(open, close)
float bodyBot0 = math.min(open, close)

bool bullB = bodyBot0 > bodyTop2
bool bearB = bodyTop0 < bodyBot2

bool bullGap = bullW or bullB
bool bearGap = bearW or bearB

float bullHi = low
float bullLo = bullW ? high[2] : bodyTop2

float bearHi = bearW ? low[2] : bodyBot2
float bearLo = high

float bullSz = bullGap ? bullHi - bullLo : 0.0
float bearSz = bearGap ? bearHi - bearLo : 0.0

bool bullFrac = not useFrac or nearFvg(loFrac)
bool bearFrac = not useFrac or nearFvg(hiFrac)

bool bullValid = bullGap and bullFrac and bullSz > 0 and not na(gapAtr) and bullSz >= gapAtr * minGap
bool bearValid = bearGap and bearFrac and bearSz > 0 and not na(gapAtr) and bearSz >= gapAtr * minGap

bool newBullFvg  = false
bool newBearFvg  = false
bool newBullIfvg = false
bool newBearIfvg = false
bool bullRetest  = false
bool bearRetest  = false
bool bullFilled  = false
bool bearFilled  = false
bool bullIfvgBreak = false
bool bearIfvgBreak = false
bool bullFvgBreak  = false
bool bearFvgBreak  = false
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Processing {
if barstate.isconfirmed
    int memN = mem.size()

    if memN > 0
        for i = 0 to memN - 1
            Mem m = mem.get(i)

            if m.breakBar < 0
                bool breakNow = m.up ? close < m.lo : close > m.hi

                if breakNow
                    if m.up
                        bullFvgBreak := true
                    else
                        bearFvgBreak := true
    cleanMem()

    if bullValid
        newBullFvg := true
        bool bullMade = processGap(bullHi, bullLo, true)

        if bullMade
            newBullIfvg := true

    if bearValid
        newBearFvg := true
        bool bearMade = processGap(bearHi, bearLo, false)

        if bearMade
            newBearIfvg := true
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Zone Updates {
if barstate.isconfirmed and zones.size() > 0
    for i = zones.size() - 1 to 0
        Zone z = zones.get(i)

        if not z.dead and z.live and bar_index > z.born + 1
            bool zoneBreak = z.inv and (z.up ? close < z.lo : close > z.hi)

            if zoneBreak
                if z.up
                    bullIfvgBreak := true
                else
                    bearIfvgBreak := true

        if not z.dead and z.live and not z.hit and bar_index > z.born + 1
            if entered(z)
                z := markTested(z)

                if z.inv
                    if z.up
                        bullRetest := true
                    else
                        bearRetest := true

                zones.set(i, z)

        if not z.dead and z.live and bar_index > z.born + 1 and mitigated(z)
            if z.inv
                if z.up
                    bullFilled := true
                else
                    bearFilled := true

            z := delFilled ? killZone(z) : freezeZone(z, bar_index, time)
            zones.set(i, z)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw Delete {
delBox(box src) =>
    if not na(src)
        box.delete(src)
    true

delLine(line src) =>
    if not na(src)
        line.delete(src)
    true

delLabel(label src) =>
    if not na(src)
        label.delete(src)
    true

clearDraw(box bx, line ln, label lb) =>
    bool d1 = delBox(bx)
    bool d2 = delLine(ln)
    bool d3 = delLabel(lb)
    true
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw Arrays {
syncSlots() =>
    while boxes.size() < zones.size()
        boxes.push(na)
        lines.push(na)
        labels.push(na)
    true
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw Create {
newBox(Zone z, color clr, int rightT) =>
    box.new(z.leftTime, z.hi, rightT, z.lo, xloc=xloc.bar_time, bgcolor=clr, border_color=na)

newLine(Zone z, int rightT) =>
    showEq ? line.new(z.leftTime, z.mid, rightT, z.mid, xloc=xloc.bar_time, color=eqClr, style=line.style_solid) : na

newLabel(Zone z) =>
    showText and z.live ? label.new(bar_index + textOff, z.mid, zoneText(z), xloc=xloc.bar_index, style=label.style_label_left, 
    color=color.new(color.white, 100), textcolor=textColor(z), size=textSize()) : na
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw Sync {
syncBox(Zone z, box src, color clr, int rightT) =>
    box out = src

    if na(out)
        out := newBox(z, clr, rightT)

    box.set_left(out, z.leftTime)
    box.set_top(out, z.hi)
    box.set_bottom(out, z.lo)
    box.set_bgcolor(out, clr)
    box.set_border_color(out, na)

    box.set_extend(out, extend.none)
    box.set_right(out, rightT)
    out

syncLine(Zone z, line src, int rightT) =>
    line out = src

    if showEq
        if na(out)
            out := newLine(z, rightT)

        line.set_x1(out, z.leftTime)
        line.set_y1(out, z.mid)
        line.set_y2(out, z.mid)
        line.set_color(out, eqClr)

        line.set_extend(out, extend.none)
        line.set_x2(out, rightT)
    else
        if not na(out)
            line.delete(out)
            out := na
    out

syncLabel(Zone z, label src) =>
    label out = src

    if showText and z.live
        if na(out)
            out := newLabel(z)

        label.set_x(out, bar_index + textOff)
        label.set_y(out, z.mid)
        label.set_text(out, zoneText(z))
        label.set_textcolor(out, textColor(z))
        label.set_style(out, label.style_label_left)
        label.set_size(out, textSize())
    else
        if not na(out)
            label.delete(out)
            out := na
    out
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw {
drawZone(int i, Zone z, bool mergedView) =>
    box bx   = boxes.get(i)
    line ln  = lines.get(i)
    label lb = labels.get(i)

    int age    = bar_index - z.born
    int rightT = rightTime(z)

    color base    = zoneColor(z.up, z.inv)
    color drawClr = fadeOld ? fadeColor(base, age) : base

    if isVisible(z)
        bool boxNeedsSync = z.live or mergedView or fadeOld or na(bx)

        if boxNeedsSync
            bx := syncBox(z, bx, drawClr, rightT)
            lb := syncLabel(z, lb)

        ln := syncLine(z, ln, rightT)
    else
        bool cleared = clearDraw(bx, ln, lb)
        bx := na
        ln := na
        lb := na

    boxes.set(i, bx)
    lines.set(i, ln)
    labels.set(i, lb)
    true

hideZone(int i) =>
    box bx   = boxes.get(i)
    line ln  = lines.get(i)
    label lb = labels.get(i)

    bool cleared = clearDraw(bx, ln, lb)

    boxes.set(i, na)
    lines.set(i, na)
    labels.set(i, na)
    true
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw Remove {
removeZone(int i) =>
    box bx   = boxes.get(i)
    line ln  = lines.get(i)
    label lb = labels.get(i)

    bool cleared = clearDraw(bx, ln, lb)

    boxes.remove(i)
    lines.remove(i)
    labels.remove(i)
    zones.remove(i)

    true
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Draw Limit {
trimZones() =>
    while zones.size() > 450
        bool removed = removeZone(0)
    true
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Render {
if barstate.isconfirmed
    bool slotsOk = syncSlots()
    bool trimmed = trimZones()

    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)

            if z.dead
                bool removed = removeZone(i)

    bool slotsAfter = syncSlots()
    int n = zones.size()

    if n > 0
        array<int> ownerGroup = array.new_int(n, -1)
        array<int> reps       = array.new_int()
        array<int> keys       = array.new_int()
        array<Zone> merged    = array.new<Zone>()
        array<int> candidates = array.new_int()

        if useMerge
            for i = 0 to n - 1
                Zone z = zones.get(i)

                if isVisible(z) and mergeEnabled(z)
                    candidates.push(i)

        int candidateCount = candidates.size()

        if candidateCount > 0
            for c = 0 to candidateCount - 1
                int i = candidates.get(c)
                Zone z = zones.get(i)
                int key = mergeKey(z)
                int found = -1
                int groups = merged.size()

                if groups > 0
                    for g = 0 to groups - 1
                        if keys.get(g) == key
                            Zone group = merged.get(g)

                            if canMerge(group, z)
                                found := g
                                break

                if found < 0
                    int groupId = merged.size()
                    reps.push(i)
                    keys.push(key)
                    merged.push(z)
                    ownerGroup.set(i, groupId)
                else
                    Zone group = merged.get(found)
                    merged.set(found, mergeZone(group, z))
                    ownerGroup.set(i, found)

        for i = 0 to n - 1
            Zone z = zones.get(i)
            int groupId = ownerGroup.get(i)

            if groupId < 0
                bool drawn = drawZone(i, z, false)
            else
                int rep = reps.get(groupId)

                if i == rep
                    Zone viewZone = merged.get(groupId)
                    bool drawn = drawZone(i, viewZone, true)
                else
                    bool hidden = hideZone(i)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Alerts {
alertcondition(newBullFvg, "New Bullish FVG", "A new bullish FVG formed on {{ticker}} ({{interval}}).")
alertcondition(newBearFvg, "New Bearish FVG", "A new bearish FVG formed on {{ticker}} ({{interval}}).")
alertcondition(newBullFvg or newBearFvg, "New FVG", "A new FVG formed on {{ticker}} ({{interval}}).")

alertcondition(newBullIfvg, "New Bullish iFVG", "A new bullish inversion FVG formed on {{ticker}} ({{interval}}).")
alertcondition(newBearIfvg, "New Bearish iFVG", "A new bearish inversion FVG formed on {{ticker}} ({{interval}}).")
alertcondition(newBullIfvg or newBearIfvg, "New iFVG", "A new inversion FVG formed on {{ticker}} ({{interval}}).")

alertcondition(bullRetest, "Bullish iFVG Retest", "Price retested a bullish inversion FVG on {{ticker}} ({{interval}}).")
alertcondition(bearRetest, "Bearish iFVG Retest", "Price retested a bearish inversion FVG on {{ticker}} ({{interval}}).")
alertcondition(bullRetest or bearRetest, "iFVG Retest", "Price retested an inversion FVG on {{ticker}} ({{interval}}).")

alertcondition(bullFilled, "Bullish iFVG Mitigated", "A bullish inversion FVG was mitigated on {{ticker}} ({{interval}}).")
alertcondition(bearFilled, "Bearish iFVG Mitigated", "A bearish inversion FVG was mitigated on {{ticker}} ({{interval}}).")
alertcondition(bullFilled or bearFilled, "iFVG Mitigated", "An inversion FVG was mitigated on {{ticker}} ({{interval}}).")

alertcondition(bullIfvgBreak, "Bullish iFVG Break", "Price closed below a bullish inversion FVG on {{ticker}} ({{interval}}).")
alertcondition(bearIfvgBreak, "Bearish iFVG Break", "Price closed above a bearish inversion FVG on {{ticker}} ({{interval}}).")
alertcondition(bullIfvgBreak or bearIfvgBreak, "iFVG Break", "Price closed through an inversion FVG on {{ticker}} ({{interval}}).")

alertcondition(bullFvgBreak, "Bullish FVG Break", "Price closed below a remembered bullish FVG on {{ticker}} ({{interval}}).")
alertcondition(bearFvgBreak, "Bearish FVG Break", "Price closed above a remembered bearish FVG on {{ticker}} ({{interval}}).")
alertcondition(bullFvgBreak or bearFvgBreak, "FVG Break", "Price closed through a remembered FVG on {{ticker}} ({{interval}}).")
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}