//@version=6

indicator(
     "KIRON Universal Pattern Engine — Clean Build",
     shorttitle = "KIRON Patterns",
     overlay = true,
     max_bars_back = 5000,
     max_lines_count = 500,
     max_labels_count = 500,
     max_boxes_count = 100
)

// =============================================================================
// SECTION 1 — CORE SETTINGS
// =============================================================================

string GROUP_ENGINE = "1. Engine Settings"
string GROUP_PATTERNS = "2. Pattern Selection"
string GROUP_VISUALS = "3. Pattern Visuals"

// -----------------------------------------------------------------------------
// ENGINE SETTINGS
// -----------------------------------------------------------------------------

pivotLength = input.int(
     5,
     "Confirmed pivot length",
     minval = 2,
     maxval = 20,
     group = GROUP_ENGINE
)

atrLength = input.int(
     14,
     "ATR length",
     minval = 2,
     maxval = 100,
     group = GROUP_ENGINE
)

levelToleranceATR = input.float(
     0.25,
     "Level tolerance × ATR",
     minval = 0.05,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_ENGINE
)

minimumPatternHeightATR = input.float(
     1.00,
     "Minimum pattern height × ATR",
     minval = 0.25,
     maxval = 10.00,
     step = 0.25,
     group = GROUP_ENGINE
)

minimumPatternQuality = input.int(
     50,
     "Minimum pattern quality %",
     minval = 0,
     maxval = 100,
     step = 5,
     group = GROUP_ENGINE
)

maximumPatternAge = input.int(
     100,
     "Maximum pattern age in bars",
     minval = 10,
     maxval = 500,
     group = GROUP_ENGINE
)

// -----------------------------------------------------------------------------
// PATTERN SELECTION
// -----------------------------------------------------------------------------

detectFlags = input.bool(
     true,
     "Bull and bear flags",
     group = GROUP_PATTERNS
)

detectDirectionalTriangles = input.bool(
     true,
     "Ascending and descending triangles",
     group = GROUP_PATTERNS
)

detectRectangles = input.bool(
     true,
     "Rectangles",
     group = GROUP_PATTERNS
)

detectDoublePatterns = input.bool(
     true,
     "Double tops and bottoms",
     group = GROUP_PATTERNS
)

detectHeadShoulders = input.bool(
     true,
     "Head and shoulders",
     group = GROUP_PATTERNS
)

detectPennants = input.bool(
     true,
     "Bullish and bearish pennants",
     group = GROUP_PATTERNS
)

detectWedges = input.bool(
     true,
     "Rising and falling wedges",
     group = GROUP_PATTERNS
)

detectCupHandle = input.bool(
     true,
     "Cup and handle",
     group = GROUP_PATTERNS
)

detectTriplePatterns = input.bool(
     true,
     "Triple tops and bottoms",
     group = GROUP_PATTERNS
)

detectSymmetricalTriangles = input.bool(
     true,
     "Symmetrical triangles",
     group = GROUP_PATTERNS
)

// -----------------------------------------------------------------------------
// VISUAL SETTINGS
// -----------------------------------------------------------------------------

showPatternGeometry = input.bool(
     true,
