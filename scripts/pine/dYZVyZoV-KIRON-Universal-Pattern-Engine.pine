     group = GROUP_VISUALS
)

// Invisible build-check plot.
plot(
     na,
     title = "Build Check",
     display = display.none
)
// =============================================================================
// SECTION 2 — ATR AND CONFIRMED MARKET PIVOTS
// =============================================================================

// Maximum number of confirmed highs and lows retained by the engine.
const int MAX_STORED_PIVOTS = 60

showConfirmedPivots = input.bool(
     true,
     "Show confirmed swing pivots",
     group = GROUP_VISUALS
)

// -----------------------------------------------------------------------------
// CORE VOLATILITY VALUES
// -----------------------------------------------------------------------------

float atrValue = ta.atr(atrLength)
float levelTolerance = atrValue * levelToleranceATR
float minimumPatternHeight = atrValue * minimumPatternHeightATR

// -----------------------------------------------------------------------------
// NON-REPAINTING CONFIRMED PIVOTS
// -----------------------------------------------------------------------------

float confirmedPivotHigh = ta.pivothigh(
     high,
     pivotLength,
     pivotLength
)

float confirmedPivotLow = ta.pivotlow(
     low,
     pivotLength,
     pivotLength
)

int confirmedPivotBar = bar_index - pivotLength

// -----------------------------------------------------------------------------
// PERSISTENT PIVOT STORAGE
// -----------------------------------------------------------------------------

var array<float> pivotHighPrices = array.new_float()
var array<int> pivotHighBars = array.new_int()

var array<float> pivotLowPrices = array.new_float()
var array<int> pivotLowBars = array.new_int()

// Store a newly confirmed pivot high.
if not na(confirmedPivotHigh)
    array.push(
         pivotHighPrices,
         confirmedPivotHigh
    )

    array.push(
         pivotHighBars,
         confirmedPivotBar
    )

    if array.size(pivotHighPrices) > MAX_STORED_PIVOTS
        array.shift(pivotHighPrices)
        array.shift(pivotHighBars)

// Store a newly confirmed pivot low.
if not na(confirmedPivotLow)
    array.push(
         pivotLowPrices,
         confirmedPivotLow
    )

    array.push(
         pivotLowBars,
         confirmedPivotBar
    )

    if array.size(pivotLowPrices) > MAX_STORED_PIVOTS
        array.shift(pivotLowPrices)
        array.shift(pivotLowBars)

// -----------------------------------------------------------------------------
// SAFE PIVOT-ACCESS FUNCTIONS
// Offset 0 is the newest confirmed pivot.
// Offset 1 is the previous confirmed pivot.
// -----------------------------------------------------------------------------

f_pivotHigh(int offset) =>
    float result = na
    int arrayIndex = array.size(pivotHighPrices) - 1 - offset

    if offset >= 0 and arrayIndex >= 0
        result := array.get(
             pivotHighPrices,
             arrayIndex
        )

    result

f_pivotHighBar(int offset) =>
    int result = na
    int arrayIndex = array.size(pivotHighBars) - 1 - offset

    if offset >= 0 and arrayIndex >= 0
        result := array.get(
             pivotHighBars,
             arrayIndex
        )

    result

f_pivotLow(int offset) =>
    float result = na
    int arrayIndex = array.size(pivotLowPrices) - 1 - offset

    if offset >= 0 and arrayIndex >= 0
        result := array.get(
             pivotLowPrices,
             arrayIndex
        )

    result

f_pivotLowBar(int offset) =>
    int result = na
    int arrayIndex = array.size(pivotLowBars) - 1 - offset

    if offset >= 0 and arrayIndex >= 0
        result := array.get(
             pivotLowBars,
             arrayIndex
        )

    result

// -----------------------------------------------------------------------------
// SHARED PRICE-GEOMETRY FUNCTIONS
// -----------------------------------------------------------------------------

f_levelsEqual(
     float firstPrice,
     float secondPrice
 ) =>
    bool result = false

    if not na(firstPrice) and not na(secondPrice)
        result := math.abs(firstPrice - secondPrice) <= levelTolerance

    result

f_lineValue(
     int firstBar,
     float firstPrice,
     int secondBar,
     float secondPrice,
     int targetBar
 ) =>
    float result = na

    bool coordinatesValid = not na(firstBar) and not na(firstPrice) and not na(secondBar) and not na(secondPrice) and not na(targetBar)

    if coordinatesValid and secondBar != firstBar
        float lineSlope = (secondPrice - firstPrice) / (secondBar - firstBar)
        result := firstPrice + lineSlope * (targetBar - firstBar)

    result

f_patternHeightValid(
     float upperPrice,
     float lowerPrice
 ) =>
    bool result = false

    if not na(upperPrice) and not na(lowerPrice)
        result := upperPrice > lowerPrice and upperPrice - lowerPrice >= minimumPatternHeight

    result

f_priceBetween(
     float price,
     float lowerBoundary,
     float upperBoundary
 ) =>
    bool result = false

    if not na(price) and not na(lowerBoundary) and not na(upperBoundary)
        result := price >= lowerBoundary and price <= upperBoundary

    result

// -----------------------------------------------------------------------------
// CONFIRMED-PIVOT MARKERS
// These appear only after the pivot has been confirmed.
// The negative offset places each marker on its actual pivot candle.
// -----------------------------------------------------------------------------

plotshape(
     showConfirmedPivots and not na(confirmedPivotHigh),
     title = "Confirmed Pivot High",
     style = shape.triangledown,
     location = location.abovebar,
     color = bearishPatternColour,
     size = size.tiny,
     offset = -pivotLength
)

plotshape(
     showConfirmedPivots and not na(confirmedPivotLow),
     title = "Confirmed Pivot Low",
     style = shape.triangleup,
     location = location.belowbar,
     color = bullishPatternColour,
     size = size.tiny,
     offset = -pivotLength
)
// =============================================================================
// SECTION 3 — PATTERN CANDIDATE AND FROZEN GEOMETRY
// =============================================================================

// Every detected pattern receives its own candidate record.
//
// The eight point pairs store the exact bars and prices that created the
// pattern. Later drawing sections will use these frozen points instead of
// searching for new pivots and accidentally changing the pattern shape.

type PatternCandidate
    string name
    int rank
    int direction
    int startBar
    int readyBar
    float upperTrigger
    float lowerTrigger
    float zoneTop
    float zoneBottom
    float height
    float quality
    float bullishStop
    float bearishStop
    bool valid
    int pointCount
    int point1Bar
    float point1Price
    int point2Bar
    float point2Price
    int point3Bar
    float point3Price
    int point4Bar
    float point4Price
    int point5Bar
    float point5Price
    int point6Bar
    float point6Price
    int point7Bar
    float point7Price
    int point8Bar
    float point8Price


// Create a completely empty pattern candidate.
f_emptyCandidate() =>
    PatternCandidate.new(
         "",
         0,
         0,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         0.0,
         na,
         na,
         false,
         0,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na
    )


// Create the main candidate record.
//
// direction:
//  1 = bullish
// -1 = bearish
//  0 = neutral or awaiting breakout direction
f_createCandidate(
     string patternName,
     int patternRank,
     int patternDirection,
     int patternStartBar,
     int patternReadyBar,
     float patternUpperTrigger,
     float patternLowerTrigger,
     float patternZoneTop,
     float patternZoneBottom,
     float patternHeight,
     float patternQuality,
     float patternBullishStop,
     float patternBearishStop
) =>
    float safeQuality = math.max(0.0, math.min(1.0, patternQuality))

    bool nameReady = str.length(patternName) > 0

    bool rankReady =
         patternRank >= 1 and
         patternRank <= 10

    bool directionReady =
         patternDirection >= -1 and
         patternDirection <= 1

    bool barsReady =
         not na(patternStartBar) and
         not na(patternReadyBar) and
         patternStartBar <= patternReadyBar

    bool zoneReady =
         not na(patternZoneTop) and
         not na(patternZoneBottom) and
         patternZoneTop > patternZoneBottom

    bool heightReady =
         not na(patternHeight) and
         patternHeight > 0.0

    bool triggerReady = false

    if patternDirection > 0
        triggerReady := not na(patternUpperTrigger)
    else if patternDirection < 0
        triggerReady := not na(patternLowerTrigger)
    else
        triggerReady :=
             not na(patternUpperTrigger) and
             not na(patternLowerTrigger)

    bool candidateValid =
         nameReady and
         rankReady and
         directionReady and
         barsReady and
         zoneReady and
         heightReady and
         triggerReady

    PatternCandidate.new(
         patternName,
         patternRank,
         patternDirection,
         patternStartBar,
         patternReadyBar,
         patternUpperTrigger,
         patternLowerTrigger,
         patternZoneTop,
         patternZoneBottom,
         patternHeight,
         safeQuality,
         patternBullishStop,
         patternBearishStop,
         candidateValid,
         0,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na
    )


// Store one exact chart point inside a candidate.
//
// pointNumber must be from 1 to 8.
f_setPatternPoint(
     PatternCandidate candidate,
     int pointNumber,
     int pointBar,
     float pointPrice
) =>
    bool pointValid =
         pointNumber >= 1 and
         pointNumber <= 8 and
         not na(pointBar) and
         not na(pointPrice)

    if pointValid
        if pointNumber == 1
            candidate.point1Bar := pointBar
            candidate.point1Price := pointPrice
        else if pointNumber == 2
            candidate.point2Bar := pointBar
            candidate.point2Price := pointPrice
        else if pointNumber == 3
            candidate.point3Bar := pointBar
            candidate.point3Price := pointPrice
        else if pointNumber == 4
            candidate.point4Bar := pointBar
            candidate.point4Price := pointPrice
        else if pointNumber == 5
            candidate.point5Bar := pointBar
            candidate.point5Price := pointPrice
        else if pointNumber == 6
            candidate.point6Bar := pointBar
            candidate.point6Price := pointPrice
        else if pointNumber == 7
            candidate.point7Bar := pointBar
            candidate.point7Price := pointPrice
        else if pointNumber == 8
            candidate.point8Bar := pointBar
            candidate.point8Price := pointPrice

        candidate.pointCount := math.max(
             candidate.pointCount,
             pointNumber
        )

    candidate


// Return the bar belonging to a stored pattern point.
f_patternPointBar(
     PatternCandidate candidate,
     int pointNumber
) =>
    int pointBar = na

    if pointNumber == 1
        pointBar := candidate.point1Bar
    else if pointNumber == 2
        pointBar := candidate.point2Bar
    else if pointNumber == 3
        pointBar := candidate.point3Bar
    else if pointNumber == 4
        pointBar := candidate.point4Bar
    else if pointNumber == 5
        pointBar := candidate.point5Bar
    else if pointNumber == 6
        pointBar := candidate.point6Bar
    else if pointNumber == 7
        pointBar := candidate.point7Bar
    else if pointNumber == 8
        pointBar := candidate.point8Bar

    pointBar


// Return the price belonging to a stored pattern point.
f_patternPointPrice(
     PatternCandidate candidate,
     int pointNumber
) =>
    float pointPrice = na

    if pointNumber == 1
        pointPrice := candidate.point1Price
    else if pointNumber == 2
        pointPrice := candidate.point2Price
    else if pointNumber == 3
        pointPrice := candidate.point3Price
    else if pointNumber == 4
        pointPrice := candidate.point4Price
    else if pointNumber == 5
        pointPrice := candidate.point5Price
    else if pointNumber == 6
        pointPrice := candidate.point6Price
    else if pointNumber == 7
        pointPrice := candidate.point7Price
    else if pointNumber == 8
        pointPrice := candidate.point8Price

    pointPrice


// Confirm that a requested frozen point exists.
f_patternPointExists(
     PatternCandidate candidate,
     int pointNumber
) =>
    int storedBar = f_patternPointBar(candidate, pointNumber)
    float storedPrice = f_patternPointPrice(candidate, pointNumber)

    pointNumber >= 1 and
         pointNumber <= candidate.pointCount and
         not na(storedBar) and
         not na(storedPrice)


// Return the correct visual colour for the pattern direction.
f_candidateColour(PatternCandidate candidate) =>
    color resultColour = neutralPatternColour

    if candidate.direction > 0
        resultColour := bullishPatternColour
    else if candidate.direction < 0
        resultColour := bearishPatternColour

    resultColour


// Return readable direction text for labels and the dashboard.
f_candidateDirectionText(PatternCandidate candidate) =>
    string directionText = "NEUTRAL"

    if candidate.direction > 0
        directionText := "BULLISH"
    else if candidate.direction < 0
        directionText := "BEARISH"

    directionText


// Convert candidate quality from 0.00–1.00 into 0–100.
f_candidateQualityPercent(PatternCandidate candidate) =>
    int(
         math.round(
              math.max(
                   0.0,
                   math.min(
                        1.0,
                        candidate.quality
                   )
              ) * 100.0
         )
    )


// Create a stable identity for an individual pattern.
f_candidateKey(PatternCandidate candidate) =>
    candidate.name +
         "|" +
         str.tostring(candidate.direction) +
         "|" +
         str.tostring(candidate.startBar) +
         "|" +
         str.tostring(candidate.readyBar)
         // =============================================================================
// SECTION 4 — PATTERN DRAWING FOUNDATION
// =============================================================================

// Pattern drawings are stored separately from entry, stop and target drawings.
// This allows pattern geometry to be refreshed without affecting the trade plan.

const int MAX_PATTERN_LINES = 450
const int MAX_PATTERN_LABELS = 450

var array<line> patternGeometryLines = array.new_line()
var array<label> patternGeometryLabels = array.new_label()


// Remove every pattern line and label currently controlled by the engine.
f_clearPatternGeometry() =>
    while array.size(patternGeometryLines) > 0
        line.delete(array.pop(patternGeometryLines))

    while array.size(patternGeometryLabels) > 0
        label.delete(array.pop(patternGeometryLabels))

    0


// Confirm that two chart points can form a valid line.
f_validPatternSegment(
     int firstBar,
     float firstPrice,
     int secondBar,
     float secondPrice
) =>
    not na(firstBar) and
         not na(firstPrice) and
         not na(secondBar) and
         not na(secondPrice) and
         secondBar > firstBar


// Draw and store one pattern line.
f_addPatternLine(
     int firstBar,
     float firstPrice,
     int secondBar,
     float secondPrice,
     color lineColour,
     int requestedWidth,
     string lineStyle
) =>
    line createdLine = na

    bool segmentValid = f_validPatternSegment(
         firstBar,
         firstPrice,
         secondBar,
         secondPrice
    )

    if showPatternGeometry and segmentValid
        if array.size(patternGeometryLines) >= MAX_PATTERN_LINES
            line.delete(array.shift(patternGeometryLines))

        int safeLineWidth = math.max(
             1,
             math.min(
                  10,
                  requestedWidth
             )
        )

        createdLine := line.new(
             x1 = firstBar,
             y1 = firstPrice,
             x2 = secondBar,
             y2 = secondPrice,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = lineColour,
             style = lineStyle,
             width = safeLineWidth
        )

        array.push(
             patternGeometryLines,
             createdLine
        )

    createdLine


// Draw a horizontal pattern level between two specified bars.
f_addPatternLevel(
     int firstBar,
     int secondBar,
     float levelPrice,
     color levelColour,
     int requestedWidth,
     string lineStyle
) =>
    line createdLevel = f_addPatternLine(
         firstBar,
         levelPrice,
         secondBar,
         levelPrice,
         levelColour,
         requestedWidth,
         lineStyle
    )

    createdLevel


// Draw and store one pattern-point label.
f_addPatternPointLabel(
     int pointBar,
     float pointPrice,
     string pointText,
     color pointColour,
     bool placeAbove
) =>
    label createdLabel = na

    bool pointValid =
         showPatternPointLabels and
         not na(pointBar) and
         not na(pointPrice) and
         str.length(pointText) > 0

    if pointValid
        if array.size(patternGeometryLabels) >= MAX_PATTERN_LABELS
            label.delete(array.shift(patternGeometryLabels))

        string selectedStyle = placeAbove ? label.style_label_down : label.style_label_up

        createdLabel := label.new(
             x = pointBar,
             y = pointPrice,
             text = pointText,
             xloc = xloc.bar_index,
             yloc = yloc.price,
             color = pointColour,
             style = selectedStyle,
             textcolor = color.white,
             size = size.small,
             textalign = text.align_center
        )

        array.push(
             patternGeometryLabels,
             createdLabel
        )

    createdLabel


// Connect every frozen point belonging to a candidate.
//
// This creates the main visible outline of the pattern. Because it reads the
// stored candidate points, the geometry cannot silently jump to newer pivots.
f_drawCandidatePolyline(
     PatternCandidate candidate,
     color lineColour
) =>
    int segmentsDrawn = 0

    bool candidateCanBeDrawn =
         showPatternGeometry and
         candidate.valid and
         candidate.pointCount >= 2

    if candidateCanBeDrawn
        for pointNumber = 1 to candidate.pointCount - 1
            int firstBar = f_patternPointBar(
                 candidate,
                 pointNumber
            )

            float firstPrice = f_patternPointPrice(
                 candidate,
                 pointNumber
            )

            int secondBar = f_patternPointBar(
                 candidate,
                 pointNumber + 1
            )

            float secondPrice = f_patternPointPrice(
                 candidate,
                 pointNumber + 1
            )

            bool firstPointExists = f_patternPointExists(
                 candidate,
                 pointNumber
            )

            bool secondPointExists = f_patternPointExists(
                 candidate,
                 pointNumber + 1
            )

            if firstPointExists and secondPointExists
                line createdSegment = f_addPatternLine(
                     firstBar,
                     firstPrice,
                     secondBar,
                     secondPrice,
                     lineColour,
                     patternLineWidth,
                     line.style_solid
                )

                if not na(createdSegment)
                    segmentsDrawn += 1

    segmentsDrawn
    // =============================================================================
// SECTION 5 — FROZEN ENTRY, STOP AND TARGET CALCULATION
// =============================================================================

string GROUP_TRADE_PLAN = "4. Trade Plan"

entryBufferATR = input.float(
     0.05,
     "Entry buffer — ATR",
     minval = 0.0,
     step = 0.01,
     group = GROUP_TRADE_PLAN
)

stopBufferATR = input.float(
     0.15,
     "Stop buffer — ATR",
     minval = 0.0,
     step = 0.01,
     group = GROUP_TRADE_PLAN
)

target1RiskReward = input.float(
     1.0,
     "TP1 risk-to-reward",
     minval = 0.5,
     step = 0.1,
     group = GROUP_TRADE_PLAN
)

target2RiskReward = input.float(
     2.0,
     "TP2 risk-to-reward",
     minval = 0.5,
     step = 0.1,
     group = GROUP_TRADE_PLAN
)

target3RiskReward = input.float(
     3.0,
     "TP3 risk-to-reward",
     minval = 0.5,
     step = 0.1,
     group = GROUP_TRADE_PLAN
)


// A trade plan is created only from a valid directional pattern.
// Once stored, these prices will remain frozen.

type PatternTradePlan
    bool valid
    int direction
    float entry
    float stop
    float target1
    float target2
    float target3
    float risk
    float rewardRisk1
    float rewardRisk2
    float rewardRisk3


// Create an empty trade plan.
f_emptyTradePlan() =>
    PatternTradePlan.new(
         false,
         0,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na,
         na
    )


// Build a complete trade plan from one pattern candidate.
f_buildTradePlan(PatternCandidate candidate) =>
    bool planValid = false
    int planDirection = candidate.direction

    float entryPrice = na
    float stopPrice = na
    float target1Price = na
    float target2Price = na
    float target3Price = na
    float riskDistance = na

    float calculatedRR1 = math.max(
         0.5,
         target1RiskReward
    )

    float calculatedRR2 = math.max(
         calculatedRR1,
         target2RiskReward
    )

    float calculatedRR3 = math.max(
         calculatedRR2,
         target3RiskReward
    )

    bool directionalCandidate =
         candidate.direction == 1 or
         candidate.direction == -1

    bool qualityAccepted =
         f_candidateQualityPercent(candidate) >=
         minimumPatternQuality

    if candidate.valid and directionalCandidate and qualityAccepted
        float triggerPrice = na
        float structuralStop = na

        if candidate.direction > 0
            triggerPrice := candidate.upperTrigger
            structuralStop := candidate.bullishStop

            if na(structuralStop)
                structuralStop := candidate.zoneBottom
        else
            triggerPrice := candidate.lowerTrigger
            structuralStop := candidate.bearishStop

            if na(structuralStop)
                structuralStop := candidate.zoneTop

        bool requiredPricesAvailable =
             not na(triggerPrice) and
             not na(structuralStop) and
             not na(atrValue)

        if requiredPricesAvailable
            entryPrice :=
                 triggerPrice +
                 candidate.direction *
                 atrValue *
                 entryBufferATR

            stopPrice :=
                 structuralStop -
                 candidate.direction *
                 atrValue *
                 stopBufferATR

            riskDistance := math.abs(
                 entryPrice - stopPrice
            )

            bool stopOnCorrectSide = false

            if candidate.direction > 0
                stopOnCorrectSide := stopPrice < entryPrice
            else
                stopOnCorrectSide := stopPrice > entryPrice

            bool riskValid =
                 riskDistance >= syminfo.mintick

            planValid :=
                 stopOnCorrectSide and
                 riskValid

            if planValid
                target1Price :=
                     entryPrice +
                     candidate.direction *
                     riskDistance *
                     calculatedRR1

                target2Price :=
                     entryPrice +
                     candidate.direction *
                     riskDistance *
                     calculatedRR2

                target3Price :=
                     entryPrice +
                     candidate.direction *
                     riskDistance *
                     calculatedRR3

    PatternTradePlan.new(
         planValid,
         planDirection,
         entryPrice,
         stopPrice,
         target1Price,
         target2Price,
         target3Price,
         riskDistance,
         calculatedRR1,
         calculatedRR2,
         calculatedRR3
    )


// Return readable trade direction text.
f_tradePlanDirectionText(PatternTradePlan tradePlan) =>
    string directionText = "NONE"

    if tradePlan.direction > 0
        directionText := "LONG"
    else if tradePlan.direction < 0
        directionText := "SHORT"

    directionText
    // =============================================================================
// SECTION 6 — ENTRY, STOP AND TARGET DRAWING ENGINE
// =============================================================================

tradePlanProjectionBars = input.int(
     40,
     "Trade-plan projection bars",
     minval = 5,
     maxval = 200,
     group = GROUP_TRADE_PLAN
)

tradePlanLineWidth = input.int(
     4,
     "Trade-plan line width",
     minval = 1,
     maxval = 10,
     group = GROUP_TRADE_PLAN
)

const int MAX_TRADE_PLAN_OBJECTS = 20

var array<line> tradePlanLines = array.new_line()
var array<label> tradePlanLabels = array.new_label()


// Remove the existing entry, stop and target drawings.
f_clearTradePlanGeometry() =>
    while array.size(tradePlanLines) > 0
        line.delete(array.pop(tradePlanLines))

    while array.size(tradePlanLabels) > 0
        label.delete(array.pop(tradePlanLabels))

    0


// Draw one horizontal trade-plan level and its price label.
f_addTradePlanLevel(
     int firstBar,
     int secondBar,
     float levelPrice,
     string levelName,
     color levelColour,
     int requestedWidth
) =>
    int objectsCreated = 0

    bool levelValid =
         not na(firstBar) and
         not na(secondBar) and
         not na(levelPrice) and
         secondBar > firstBar

    if showTradePlan and levelValid
        if array.size(tradePlanLines) >= MAX_TRADE_PLAN_OBJECTS
            line.delete(array.shift(tradePlanLines))

        if array.size(tradePlanLabels) >= MAX_TRADE_PLAN_OBJECTS
            label.delete(array.shift(tradePlanLabels))

        int safeWidth = math.max(
             1,
             math.min(
                  10,
                  requestedWidth
             )
        )

        line newTradeLine = line.new(
             x1 = firstBar,
             y1 = levelPrice,
             x2 = secondBar,
             y2 = levelPrice,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = levelColour,
             style = line.style_solid,
             width = safeWidth
        )

        string levelText =
             levelName +
             " " +
             str.tostring(
                  levelPrice,
                  format.mintick
             )

        label newTradeLabel = label.new(
             x = secondBar,
             y = levelPrice,
             text = levelText,
             xloc = xloc.bar_index,
             yloc = yloc.price,
             color = levelColour,
             style = label.style_label_left,
             textcolor = color.white,
             size = size.small
        )

        array.push(
             tradePlanLines,
             newTradeLine
        )

        array.push(
             tradePlanLabels,
             newTradeLabel
        )

        objectsCreated := 1

    objectsCreated


// Draw the complete trade plan belonging to the selected pattern.
f_drawTradePlan(
     PatternCandidate candidate,
     PatternTradePlan tradePlan
) =>
    int levelsDrawn = 0

    bool tradePlanCanBeDrawn =
         showTradePlan and
         candidate.valid and
         tradePlan.valid and
         not na(candidate.readyBar)

    if tradePlanCanBeDrawn
        int planStartBar = candidate.readyBar

        int planEndBar = math.max(
             bar_index + tradePlanProjectionBars,
             planStartBar + 1
        )

        levelsDrawn += f_addTradePlanLevel(
             planStartBar,
             planEndBar,
             tradePlan.entry,
             "ENTRY",
             entryColour,
             tradePlanLineWidth
        )

        levelsDrawn += f_addTradePlanLevel(
             planStartBar,
             planEndBar,
             tradePlan.stop,
             "SL",
             stopColour,
             tradePlanLineWidth
        )

        string target1Text =
             "TP1 · " +
             str.tostring(
                  tradePlan.rewardRisk1,
                  "#.0"
             ) +
             "R"

        string target2Text =
             "TP2 · " +
             str.tostring(
                  tradePlan.rewardRisk2,
                  "#.0"
             ) +
             "R"

        string target3Text =
             "TP3 · " +
             str.tostring(
                  tradePlan.rewardRisk3,
                  "#.0"
             ) +
             "R"

        levelsDrawn += f_addTradePlanLevel(
             planStartBar,
             planEndBar,
             tradePlan.target1,
             target1Text,
             targetColour,
             tradePlanLineWidth
        )

        levelsDrawn += f_addTradePlanLevel(
             planStartBar,
             planEndBar,
             tradePlan.target2,
             target2Text,
             targetColour,
             tradePlanLineWidth
        )

        levelsDrawn += f_addTradePlanLevel(
             planStartBar,
             planEndBar,
             tradePlan.target3,
             target3Text,
             targetColour,
             tradePlanLineWidth
        )

    levelsDrawn
    // =============================================================================
// SECTION 7 — CANDIDATE REGISTRY AND STRONGEST-PATTERN SELECTION
// =============================================================================

// Every detector will place its valid result into this array.
// The array can contain several different patterns at the same time.

const int MAX_REGISTERED_CANDIDATES = 30

var array<PatternCandidate> detectedCandidates = array.new<PatternCandidate>()


// Clear the temporary candidate registry before a new detection pass.
f_clearCandidateRegistry(
     array<PatternCandidate> candidates
) =>
    array.clear(candidates)

    0


// Add one valid pattern to the candidate registry.
f_registerCandidate(
     array<PatternCandidate> candidates,
     PatternCandidate candidate,
     bool patternEnabled
) =>
    int registeredCount = array.size(candidates)

    bool candidateAccepted =
         patternEnabled and
         candidate.valid

    if candidateAccepted
        if array.size(candidates) < MAX_REGISTERED_CANDIDATES
            array.push(
                 candidates,
                 candidate
            )

        registeredCount := array.size(candidates)

    registeredCount


// Confirm that a candidate is suitable for a directional trade plan.
f_candidateEligibleForTrade(
     PatternCandidate candidate
) =>
    bool directionAccepted =
         candidate.direction == 1 or
         candidate.direction == -1

    bool qualityAccepted =
         f_candidateQualityPercent(candidate) >=
         minimumPatternQuality

    bool ageAccepted = false

    if not na(candidate.readyBar)
        int candidateAge =
             bar_index -
             candidate.readyBar

        ageAccepted :=
             candidateAge >= 0 and
             candidateAge <= maximumPatternAge

    candidate.valid and
         directionAccepted and
         qualityAccepted and
         ageAccepted


// Calculate the candidate's selection score.
//
// Pattern quality is the main factor.
// Priority rank and pattern freshness act as additional weighting.
f_candidateSelectionScore(
     PatternCandidate candidate
) =>
    float qualityScore =
         candidate.quality *
         100.0

    float priorityScore =
         (
              11.0 -
              candidate.rank
         ) *
         2.0

    float freshnessScore = 0.0

    if not na(candidate.readyBar)
        int candidateAge = math.max(
             0,
             bar_index - candidate.readyBar
        )

        float ageRatio =
             candidateAge /
             math.max(
                  1.0,
                  maximumPatternAge
             )

        freshnessScore :=
             math.max(
                  0.0,
                  1.0 - ageRatio
             ) *
             5.0

    qualityScore +
         priorityScore +
         freshnessScore


// Return the array position of the strongest eligible candidate.
//
// A result of -1 means that no candidate currently qualifies.
f_findStrongestCandidateIndex(
     array<PatternCandidate> candidates
) =>
    int strongestIndex = -1
    float strongestScore = na

    int candidateCount =
         array.size(candidates)

    if candidateCount > 0
        for candidateIndex = 0 to candidateCount - 1
            PatternCandidate currentCandidate = array.get(
                 candidates,
                 candidateIndex
            )

            bool candidateEligible =
                 f_candidateEligibleForTrade(
                      currentCandidate
                 )

            if candidateEligible
                float currentScore =
                     f_candidateSelectionScore(
                          currentCandidate
                     )

                if strongestIndex == -1
                    strongestIndex := candidateIndex
                    strongestScore := currentScore
                else if currentScore > strongestScore
                    strongestIndex := candidateIndex
                    strongestScore := currentScore

    strongestIndex


// Return the strongest eligible candidate.
//
// If nothing qualifies, an empty candidate is returned.
f_getStrongestCandidate(
     array<PatternCandidate> candidates
) =>
    PatternCandidate strongestCandidate =
         f_emptyCandidate()

    int strongestIndex =
         f_findStrongestCandidateIndex(
              candidates
         )

    if strongestIndex >= 0
        strongestCandidate := array.get(
             candidates,
             strongestIndex
        )

    strongestCandidate
    // =============================================================================
// SECTION 8 — CONFIRMED PIVOT SEARCH BETWEEN TWO BARS
// =============================================================================

// This record stores one exact confirmed pivot.
// It allows every detector to preserve both the pivot bar and pivot price.

type PatternPivot
    bool valid
    int pivotBar
    float pivotPrice


// Create an empty pivot result.
f_emptyPatternPivot() =>
    PatternPivot.new(
         false,
         na,
         na
    )


// Return the highest confirmed pivot high strictly between two bars.
f_highestPivotHighBetween(
     int firstBar,
     int secondBar
) =>
    PatternPivot result =
         f_emptyPatternPivot()

    bool searchRangeValid =
         not na(firstBar) and
         not na(secondBar) and
         secondBar > firstBar

    int availableHighPivots =
         array.size(pivotHighPrices)

    if searchRangeValid and availableHighPivots > 0
        for pivotIndex = 0 to availableHighPivots - 1
            int currentPivotBar = array.get(
                 pivotHighBars,
                 pivotIndex
            )

            float currentPivotPrice = array.get(
                 pivotHighPrices,
                 pivotIndex
            )

            bool pivotInsideRange =
                 currentPivotBar > firstBar and
                 currentPivotBar < secondBar

            if pivotInsideRange
                if not result.valid
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice > result.pivotPrice
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice == result.pivotPrice and currentPivotBar > result.pivotBar
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )

    result


// Return the lowest confirmed pivot low strictly between two bars.
f_lowestPivotLowBetween(
     int firstBar,
     int secondBar
) =>
    PatternPivot result =
         f_emptyPatternPivot()

    bool searchRangeValid =
         not na(firstBar) and
         not na(secondBar) and
         secondBar > firstBar

    int availableLowPivots =
         array.size(pivotLowPrices)

    if searchRangeValid and availableLowPivots > 0
        for pivotIndex = 0 to availableLowPivots - 1
            int currentPivotBar = array.get(
                 pivotLowBars,
                 pivotIndex
            )

            float currentPivotPrice = array.get(
                 pivotLowPrices,
                 pivotIndex
            )

            bool pivotInsideRange =
                 currentPivotBar > firstBar and
                 currentPivotBar < secondBar

            if pivotInsideRange
                if not result.valid
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice < result.pivotPrice
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice == result.pivotPrice and currentPivotBar > result.pivotBar
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )

    result


// Return the highest confirmed pivot high from a chosen bar onward.
f_highestPivotHighFrom(
     int firstBar
) =>
    PatternPivot result =
         f_emptyPatternPivot()

    int availableHighPivots =
         array.size(pivotHighPrices)

    if not na(firstBar) and availableHighPivots > 0
        for pivotIndex = 0 to availableHighPivots - 1
            int currentPivotBar = array.get(
                 pivotHighBars,
                 pivotIndex
            )

            float currentPivotPrice = array.get(
                 pivotHighPrices,
                 pivotIndex
            )

            if currentPivotBar >= firstBar
                if not result.valid
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice > result.pivotPrice
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice == result.pivotPrice and currentPivotBar > result.pivotBar
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )

    result


// Return the lowest confirmed pivot low from a chosen bar onward.
f_lowestPivotLowFrom(
     int firstBar
) =>
    PatternPivot result =
         f_emptyPatternPivot()

    int availableLowPivots =
         array.size(pivotLowPrices)

    if not na(firstBar) and availableLowPivots > 0
        for pivotIndex = 0 to availableLowPivots - 1
            int currentPivotBar = array.get(
                 pivotLowBars,
                 pivotIndex
            )

            float currentPivotPrice = array.get(
                 pivotLowPrices,
                 pivotIndex
            )

            if currentPivotBar >= firstBar
                if not result.valid
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice < result.pivotPrice
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotPrice == result.pivotPrice and currentPivotBar > result.pivotBar
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )

    result
    // =============================================================================
// SECTION 9 — DOUBLE BOTTOM AND DOUBLE TOP DETECTION
// =============================================================================

string GROUP_DOUBLE_PATTERNS = "5. Double Top and Bottom"

minimumDoubleSeparationBars = input.int(
     5,
     "Minimum bars between the two tops or bottoms",
     minval = 2,
     maxval = 100,
     group = GROUP_DOUBLE_PATTERNS
)

maximumDoubleSeparationBars = input.int(
     80,
     "Maximum bars between the two tops or bottoms",
     minval = 10,
     maxval = 500,
     group = GROUP_DOUBLE_PATTERNS
)


// Calculate the quality produced by two matching price levels.
f_doublePatternLevelQuality(
     float firstPrice,
     float secondPrice
) =>
    float safeTolerance = math.max(
         levelTolerance,
         syminfo.mintick
    )

    float levelDifference = math.abs(
         firstPrice -
         secondPrice
    )

    math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              levelDifference /
              safeTolerance
         )
    )


// Calculate pattern quality using level similarity and pattern height.
f_doublePatternQuality(
     float firstPrice,
     float secondPrice,
     float patternHeight
) =>
    float levelQuality =
         f_doublePatternLevelQuality(
              firstPrice,
              secondPrice
         )

    float safeHeightRequirement = math.max(
         minimumPatternHeight * 2.0,
         syminfo.mintick
    )

    float heightQuality = math.min(
         1.0,
         patternHeight /
         safeHeightRequirement
    )

    math.max(
         0.0,
         math.min(
              1.0,
              levelQuality * 0.70 +
              heightQuality * 0.30
         )
    )


// Detect a developing or completed Double Bottom.
//
// Stored geometry:
// Point 1 = first bottom
// Point 2 = intervening high
// Point 3 = second bottom
// Point 4 = current developing or breakout leg
f_detectDoubleBottom() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableLows =
         array.size(pivotLowPrices)

    if availableLows >= 2
        float firstBottomPrice =
             f_pivotLow(1)

        int firstBottomBar =
             f_pivotLowBar(1)

        float secondBottomPrice =
             f_pivotLow(0)

        int secondBottomBar =
             f_pivotLowBar(0)

        bool bottomPricesAvailable =
             not na(firstBottomPrice) and
             not na(firstBottomBar) and
             not na(secondBottomPrice) and
             not na(secondBottomBar)

        if bottomPricesAvailable
            int separationBars =
                 secondBottomBar -
                 firstBottomBar

            bool separationValid =
                 separationBars >= minimumDoubleSeparationBars and
                 separationBars <= maximumDoubleSeparationBars

            bool bottomsMatch =
                 f_levelsEqual(
                      firstBottomPrice,
                      secondBottomPrice
                 )

            if separationValid and bottomsMatch
                PatternPivot middleHigh =
                     f_highestPivotHighBetween(
                          firstBottomBar,
                          secondBottomBar
                     )

                if middleHigh.valid
                    float patternBottom = math.min(
                         firstBottomPrice,
                         secondBottomPrice
                    )

                    float necklinePrice =
                         middleHigh.pivotPrice

                    float patternHeight =
                         necklinePrice -
                         patternBottom

                    bool heightValid =
                         f_patternHeightValid(
                              necklinePrice,
                              patternBottom
                         )

                    if heightValid
                        float patternQuality =
                             f_doublePatternQuality(
                                  firstBottomPrice,
                                  secondBottomPrice,
                                  patternHeight
                             )

                        int patternReadyBar =
                             secondBottomBar +
                             pivotLength

                        result := f_createCandidate(
                             "DOUBLE BOTTOM",
                             4,
                             1,
                             firstBottomBar,
                             patternReadyBar,
                             necklinePrice,
                             na,
                             necklinePrice,
                             patternBottom,
                             patternHeight,
                             patternQuality,
                             patternBottom,
                             na
                        )

                        result := f_setPatternPoint(
                             result,
                             1,
                             firstBottomBar,
                             firstBottomPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             2,
                             middleHigh.pivotBar,
                             middleHigh.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             3,
                             secondBottomBar,
                             secondBottomPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             4,
                             bar_index,
                             close
                        )

    result


// Detect a developing or completed Double Top.
//
// Stored geometry:
// Point 1 = first top
// Point 2 = intervening low
// Point 3 = second top
// Point 4 = current developing or breakout leg
f_detectDoubleTop() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    if availableHighs >= 2
        float firstTopPrice =
             f_pivotHigh(1)

        int firstTopBar =
             f_pivotHighBar(1)

        float secondTopPrice =
             f_pivotHigh(0)

        int secondTopBar =
             f_pivotHighBar(0)

        bool topPricesAvailable =
             not na(firstTopPrice) and
             not na(firstTopBar) and
             not na(secondTopPrice) and
             not na(secondTopBar)

        if topPricesAvailable
            int separationBars =
                 secondTopBar -
                 firstTopBar

            bool separationValid =
                 separationBars >= minimumDoubleSeparationBars and
                 separationBars <= maximumDoubleSeparationBars

            bool topsMatch =
                 f_levelsEqual(
                      firstTopPrice,
                      secondTopPrice
                 )

            if separationValid and topsMatch
                PatternPivot middleLow =
                     f_lowestPivotLowBetween(
                          firstTopBar,
                          secondTopBar
                     )

                if middleLow.valid
                    float patternTop = math.max(
                         firstTopPrice,
                         secondTopPrice
                    )

                    float necklinePrice =
                         middleLow.pivotPrice

                    float patternHeight =
                         patternTop -
                         necklinePrice

                    bool heightValid =
                         f_patternHeightValid(
                              patternTop,
                              necklinePrice
                         )

                    if heightValid
                        float patternQuality =
                             f_doublePatternQuality(
                                  firstTopPrice,
                                  secondTopPrice,
                                  patternHeight
                             )

                        int patternReadyBar =
                             secondTopBar +
                             pivotLength

                        result := f_createCandidate(
                             "DOUBLE TOP",
                             4,
                             -1,
                             firstTopBar,
                             patternReadyBar,
                             na,
                             necklinePrice,
                             patternTop,
                             necklinePrice,
                             patternHeight,
                             patternQuality,
                             na,
                             patternTop
                        )

                        result := f_setPatternPoint(
                             result,
                             1,
                             firstTopBar,
                             firstTopPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             2,
                             middleLow.pivotBar,
                             middleLow.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             3,
                             secondTopBar,
                             secondTopPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             4,
                             bar_index,
                             close
                        )

    result
    // =============================================================================
// SECTION 10 — FULL DOUBLE TOP AND DOUBLE BOTTOM VISUALS
// =============================================================================

doublePatternProjectionBars = input.int(
     20,
     "Double-pattern neckline projection",
     minval = 5,
     maxval = 100,
     group = GROUP_DOUBLE_PATTERNS
)


// Return the current visual state of a detected pattern.
f_currentPatternStatus(
     PatternCandidate candidate
) =>
    string patternStatus = "FORMING"

    if candidate.direction > 0
        bool bullishInvalidation =
             close <
             candidate.zoneBottom -
             levelTolerance

        bool bullishBreakout =
             close >
             candidate.upperTrigger

        if bullishInvalidation
            patternStatus := "INVALIDATED"
        else if bullishBreakout
            patternStatus := "BREAKOUT"
    else if candidate.direction < 0
        bool bearishInvalidation =
             close >
             candidate.zoneTop +
             levelTolerance

        bool bearishBreakout =
             close <
             candidate.lowerTrigger

        if bearishInvalidation
            patternStatus := "INVALIDATED"
        else if bearishBreakout
            patternStatus := "BREAKOUT"

    patternStatus


// Draw the complete M or W structure.
//
// Double Bottom:
// B1 → Neckline → B2 → Developing leg
//
// Double Top:
// T1 → Neckline → T2 → Developing leg
f_drawDoublePattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedDoublePattern =
         candidate.name == "DOUBLE BOTTOM" or
         candidate.name == "DOUBLE TOP"

    if candidate.valid and recognisedDoublePattern
        color patternColour =
             f_candidateColour(candidate)

        int firstExtremeBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float firstExtremePrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int middlePivotBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float middlePivotPrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int secondExtremeBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float secondExtremePrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int developingBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float developingPrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        line firstPatternLeg = f_addPatternLine(
             firstExtremeBar,
             firstExtremePrice,
             middlePivotBar,
             middlePivotPrice,
             patternColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(firstPatternLeg)
            linesDrawn += 1

        line secondPatternLeg = f_addPatternLine(
             middlePivotBar,
             middlePivotPrice,
             secondExtremeBar,
             secondExtremePrice,
             patternColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(secondPatternLeg)
            linesDrawn += 1

        if showDevelopingLeg
            line developingPatternLeg = f_addPatternLine(
                 secondExtremeBar,
                 secondExtremePrice,
                 developingBar,
                 developingPrice,
                 patternColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(developingPatternLeg)
                linesDrawn += 1

        int necklineEndBar = math.max(
             bar_index + doublePatternProjectionBars,
             middlePivotBar + 1
        )

        line necklineLine = f_addPatternLevel(
             middlePivotBar,
             necklineEndBar,
             middlePivotPrice,
             necklineColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(necklineLine)
            linesDrawn += 1

        bool bullishDouble =
             candidate.direction > 0

        string firstPointText =
             bullishDouble ? "B1" : "T1"

        string secondPointName =
             bullishDouble ? "B2" : "T2"

        string middlePointText =
             "NECKLINE"

        string secondPointText =
             secondPointName +
             "\n" +
             candidate.name +
             "\n" +
             f_currentPatternStatus(candidate)

        bool extremeLabelsAbove =
             not bullishDouble

        bool middleLabelAbove =
             bullishDouble

        label firstPointLabel = f_addPatternPointLabel(
             firstExtremeBar,
             firstExtremePrice,
             firstPointText,
             patternColour,
             extremeLabelsAbove
        )

        label middlePointLabel = f_addPatternPointLabel(
             middlePivotBar,
             middlePivotPrice,
             middlePointText,
             necklineColour,
             middleLabelAbove
        )

        label secondPointLabel = f_addPatternPointLabel(
             secondExtremeBar,
             secondExtremePrice,
             secondPointText,
             patternColour,
             extremeLabelsAbove
        )

    linesDrawn
    // =============================================================================
// SECTION 11 — TRIPLE BOTTOM AND TRIPLE TOP DETECTION
// =============================================================================

string GROUP_TRIPLE_PATTERNS = "6. Triple Top and Bottom"

minimumTripleSeparationBars = input.int(
     4,
     "Minimum bars between consecutive tops or bottoms",
     minval = 2,
     maxval = 100,
     group = GROUP_TRIPLE_PATTERNS
)

maximumTriplePatternBars = input.int(
     140,
     "Maximum total triple-pattern length",
     minval = 20,
     maxval = 500,
     group = GROUP_TRIPLE_PATTERNS
)


// Confirm that three tops or three bottoms occupy the same price area.
f_threeLevelsEqual(
     float firstLevel,
     float secondLevel,
     float thirdLevel
) =>
    float highestLevel = math.max(
         math.max(
              firstLevel,
              secondLevel
         ),
         thirdLevel
    )

    float lowestLevel = math.min(
         math.min(
              firstLevel,
              secondLevel
         ),
         thirdLevel
    )

    highestLevel -
         lowestLevel <=
         levelTolerance


// Calculate the quality of a triple pattern.
f_triplePatternQuality(
     float firstLevel,
     float secondLevel,
     float thirdLevel,
     float patternHeight
) =>
    float highestLevel = math.max(
         math.max(
              firstLevel,
              secondLevel
         ),
         thirdLevel
    )

    float lowestLevel = math.min(
         math.min(
              firstLevel,
              secondLevel
         ),
         thirdLevel
    )

    float levelSpread =
         highestLevel -
         lowestLevel

    float safeTolerance = math.max(
         levelTolerance,
         syminfo.mintick
    )

    float levelQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              levelSpread /
              safeTolerance
         )
    )

    float safeHeightRequirement = math.max(
         minimumPatternHeight * 2.0,
         syminfo.mintick
    )

    float heightQuality = math.min(
         1.0,
         patternHeight /
         safeHeightRequirement
    )

    math.max(
         0.0,
         math.min(
              1.0,
              levelQuality * 0.75 +
              heightQuality * 0.25
         )
    )


// Detect a Triple Bottom.
//
// Stored geometry:
// Point 1 = first bottom
// Point 2 = first intervening high
// Point 3 = second bottom
// Point 4 = second intervening high
// Point 5 = third bottom
// Point 6 = current developing or breakout leg
f_detectTripleBottom() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableLows =
         array.size(pivotLowPrices)

    if availableLows >= 3
        float firstBottomPrice =
             f_pivotLow(2)

        int firstBottomBar =
             f_pivotLowBar(2)

        float secondBottomPrice =
             f_pivotLow(1)

        int secondBottomBar =
             f_pivotLowBar(1)

        float thirdBottomPrice =
             f_pivotLow(0)

        int thirdBottomBar =
             f_pivotLowBar(0)

        bool pricesAvailable =
             not na(firstBottomPrice) and
             not na(secondBottomPrice) and
             not na(thirdBottomPrice)

        bool barsAvailable =
             not na(firstBottomBar) and
             not na(secondBottomBar) and
             not na(thirdBottomBar)

        if pricesAvailable and barsAvailable
            int firstSeparation =
                 secondBottomBar -
                 firstBottomBar

            int secondSeparation =
                 thirdBottomBar -
                 secondBottomBar

            int completePatternLength =
                 thirdBottomBar -
                 firstBottomBar

            bool pivotOrderValid =
                 firstBottomBar <
                 secondBottomBar and
                 secondBottomBar <
                 thirdBottomBar

            bool separationValid =
                 firstSeparation >= minimumTripleSeparationBars and
                 secondSeparation >= minimumTripleSeparationBars and
                 completePatternLength <= maximumTriplePatternBars

            bool bottomsMatch =
                 f_threeLevelsEqual(
                      firstBottomPrice,
                      secondBottomPrice,
                      thirdBottomPrice
                 )

            if pivotOrderValid and separationValid and bottomsMatch
                PatternPivot firstMiddleHigh =
                     f_highestPivotHighBetween(
                          firstBottomBar,
                          secondBottomBar
                     )

                PatternPivot secondMiddleHigh =
                     f_highestPivotHighBetween(
                          secondBottomBar,
                          thirdBottomBar
                     )

                bool middlePivotsValid =
                     firstMiddleHigh.valid and
                     secondMiddleHigh.valid

                if middlePivotsValid
                    float patternBottom = math.min(
                         math.min(
                              firstBottomPrice,
                              secondBottomPrice
                         ),
                         thirdBottomPrice
                    )

                    float necklinePrice = math.max(
                         firstMiddleHigh.pivotPrice,
                         secondMiddleHigh.pivotPrice
                    )

                    float patternHeight =
                         necklinePrice -
                         patternBottom

                    bool heightValid =
                         f_patternHeightValid(
                              necklinePrice,
                              patternBottom
                         )

                    if heightValid
                        float patternQuality =
                             f_triplePatternQuality(
                                  firstBottomPrice,
                                  secondBottomPrice,
                                  thirdBottomPrice,
                                  patternHeight
                             )

                        int patternReadyBar =
                             thirdBottomBar +
                             pivotLength

                        result := f_createCandidate(
                             "TRIPLE BOTTOM",
                             9,
                             1,
                             firstBottomBar,
                             patternReadyBar,
                             necklinePrice,
                             na,
                             necklinePrice,
                             patternBottom,
                             patternHeight,
                             patternQuality,
                             patternBottom,
                             na
                        )

                        result := f_setPatternPoint(
                             result,
                             1,
                             firstBottomBar,
                             firstBottomPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             2,
                             firstMiddleHigh.pivotBar,
                             firstMiddleHigh.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             3,
                             secondBottomBar,
                             secondBottomPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             4,
                             secondMiddleHigh.pivotBar,
                             secondMiddleHigh.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             5,
                             thirdBottomBar,
                             thirdBottomPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             6,
                             bar_index,
                             close
                        )

    result


// Detect a Triple Top.
//
// Stored geometry:
// Point 1 = first top
// Point 2 = first intervening low
// Point 3 = second top
// Point 4 = second intervening low
// Point 5 = third top
// Point 6 = current developing or breakout leg
f_detectTripleTop() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    if availableHighs >= 3
        float firstTopPrice =
             f_pivotHigh(2)

        int firstTopBar =
             f_pivotHighBar(2)

        float secondTopPrice =
             f_pivotHigh(1)

        int secondTopBar =
             f_pivotHighBar(1)

        float thirdTopPrice =
             f_pivotHigh(0)

        int thirdTopBar =
             f_pivotHighBar(0)

        bool pricesAvailable =
             not na(firstTopPrice) and
             not na(secondTopPrice) and
             not na(thirdTopPrice)

        bool barsAvailable =
             not na(firstTopBar) and
             not na(secondTopBar) and
             not na(thirdTopBar)

        if pricesAvailable and barsAvailable
            int firstSeparation =
                 secondTopBar -
                 firstTopBar

            int secondSeparation =
                 thirdTopBar -
                 secondTopBar

            int completePatternLength =
                 thirdTopBar -
                 firstTopBar

            bool pivotOrderValid =
                 firstTopBar <
                 secondTopBar and
                 secondTopBar <
                 thirdTopBar

            bool separationValid =
                 firstSeparation >= minimumTripleSeparationBars and
                 secondSeparation >= minimumTripleSeparationBars and
                 completePatternLength <= maximumTriplePatternBars

            bool topsMatch =
                 f_threeLevelsEqual(
                      firstTopPrice,
                      secondTopPrice,
                      thirdTopPrice
                 )

            if pivotOrderValid and separationValid and topsMatch
                PatternPivot firstMiddleLow =
                     f_lowestPivotLowBetween(
                          firstTopBar,
                          secondTopBar
                     )

                PatternPivot secondMiddleLow =
                     f_lowestPivotLowBetween(
                          secondTopBar,
                          thirdTopBar
                     )

                bool middlePivotsValid =
                     firstMiddleLow.valid and
                     secondMiddleLow.valid

                if middlePivotsValid
                    float patternTop = math.max(
                         math.max(
                              firstTopPrice,
                              secondTopPrice
                         ),
                         thirdTopPrice
                    )

                    float necklinePrice = math.min(
                         firstMiddleLow.pivotPrice,
                         secondMiddleLow.pivotPrice
                    )

                    float patternHeight =
                         patternTop -
                         necklinePrice

                    bool heightValid =
                         f_patternHeightValid(
                              patternTop,
                              necklinePrice
                         )

                    if heightValid
                        float patternQuality =
                             f_triplePatternQuality(
                                  firstTopPrice,
                                  secondTopPrice,
                                  thirdTopPrice,
                                  patternHeight
                             )

                        int patternReadyBar =
                             thirdTopBar +
                             pivotLength

                        result := f_createCandidate(
                             "TRIPLE TOP",
                             9,
                             -1,
                             firstTopBar,
                             patternReadyBar,
                             na,
                             necklinePrice,
                             patternTop,
                             necklinePrice,
                             patternHeight,
                             patternQuality,
                             na,
                             patternTop
                        )

                        result := f_setPatternPoint(
                             result,
                             1,
                             firstTopBar,
                             firstTopPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             2,
                             firstMiddleLow.pivotBar,
                             firstMiddleLow.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             3,
                             secondTopBar,
                             secondTopPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             4,
                             secondMiddleLow.pivotBar,
                             secondMiddleLow.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             5,
                             thirdTopBar,
                             thirdTopPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             6,
                             bar_index,
                             close
                        )

    result
    // =============================================================================
// SECTION 12 — FULL TRIPLE TOP AND TRIPLE BOTTOM VISUALS
// =============================================================================

triplePatternProjectionBars = input.int(
     20,
     "Triple-pattern neckline projection",
     minval = 5,
     maxval = 100,
     group = GROUP_TRIPLE_PATTERNS
)


// Draw the complete Triple Bottom or Triple Top structure.
//
// Triple Bottom:
// B1 → N1 → B2 → N2 → B3 → Developing leg
//
// Triple Top:
// T1 → N1 → T2 → N2 → T3 → Developing leg
f_drawTriplePattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedTriplePattern =
         candidate.name == "TRIPLE BOTTOM" or
         candidate.name == "TRIPLE TOP"

    if candidate.valid and recognisedTriplePattern
        color patternColour =
             f_candidateColour(candidate)

        // Draw the four confirmed pattern legs.
        for pointNumber = 1 to 4
            int firstPointBar =
                 f_patternPointBar(
                      candidate,
                      pointNumber
                 )

            float firstPointPrice =
                 f_patternPointPrice(
                      candidate,
                      pointNumber
                 )

            int secondPointBar =
                 f_patternPointBar(
                      candidate,
                      pointNumber + 1
                 )

            float secondPointPrice =
                 f_patternPointPrice(
                      candidate,
                      pointNumber + 1
                 )

            line confirmedSegment = f_addPatternLine(
                 firstPointBar,
                 firstPointPrice,
                 secondPointBar,
                 secondPointPrice,
                 patternColour,
                 patternLineWidth,
                 line.style_solid
            )

            if not na(confirmedSegment)
                linesDrawn += 1

        // Draw the live leg from the third extreme to current price.
        if showDevelopingLeg
            int thirdExtremeBar =
                 f_patternPointBar(
                      candidate,
                      5
                 )

            float thirdExtremePrice =
                 f_patternPointPrice(
                      candidate,
                      5
                 )

            int developingBar =
                 f_patternPointBar(
                      candidate,
                      6
                 )

            float developingPrice =
                 f_patternPointPrice(
                      candidate,
                      6
                 )

            line developingSegment = f_addPatternLine(
                 thirdExtremeBar,
                 thirdExtremePrice,
                 developingBar,
                 developingPrice,
                 patternColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(developingSegment)
                linesDrawn += 1

        bool bullishTriple =
             candidate.direction > 0

        float necklinePrice =
             bullishTriple ?
             candidate.upperTrigger :
             candidate.lowerTrigger

        int necklineStartBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        int necklineEndBar = math.max(
             bar_index + triplePatternProjectionBars,
             necklineStartBar + 1
        )

        line necklineLine = f_addPatternLevel(
             necklineStartBar,
             necklineEndBar,
             necklinePrice,
             necklineColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(necklineLine)
            linesDrawn += 1

        int firstExtremeBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float firstExtremePrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int firstMiddleBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float firstMiddlePrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int secondExtremeBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float secondExtremePrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int secondMiddleBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float secondMiddlePrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        int thirdExtremeBar =
             f_patternPointBar(
                  candidate,
                  5
             )

        float thirdExtremePrice =
             f_patternPointPrice(
                  candidate,
                  5
             )

        string firstExtremeText =
             bullishTriple ? "B1" : "T1"

        string secondExtremeText =
             bullishTriple ? "B2" : "T2"

        string thirdExtremeName =
             bullishTriple ? "B3" : "T3"

        string thirdExtremeText =
             thirdExtremeName +
             "\n" +
             candidate.name +
             "\n" +
             f_currentPatternStatus(candidate)

        bool extremeLabelsAbove =
             not bullishTriple

        bool middleLabelsAbove =
             bullishTriple

        label firstExtremeLabel = f_addPatternPointLabel(
             firstExtremeBar,
             firstExtremePrice,
             firstExtremeText,
             patternColour,
             extremeLabelsAbove
        )

        label firstMiddleLabel = f_addPatternPointLabel(
             firstMiddleBar,
             firstMiddlePrice,
             "N1",
             necklineColour,
             middleLabelsAbove
        )

        label secondExtremeLabel = f_addPatternPointLabel(
             secondExtremeBar,
             secondExtremePrice,
             secondExtremeText,
             patternColour,
             extremeLabelsAbove
        )

        label secondMiddleLabel = f_addPatternPointLabel(
             secondMiddleBar,
             secondMiddlePrice,
             "N2",
             necklineColour,
             middleLabelsAbove
        )

        label thirdExtremeLabel = f_addPatternPointLabel(
             thirdExtremeBar,
             thirdExtremePrice,
             thirdExtremeText,
             patternColour,
             extremeLabelsAbove
        )

    linesDrawn
    // =============================================================================
// SECTION 13 — HEAD AND SHOULDERS DETECTION
// =============================================================================

string GROUP_HEAD_SHOULDERS = "7. Head and Shoulders"

minimumShoulderSeparationBars = input.int(
     4,
     "Minimum bars between shoulder and head",
     minval = 2,
     maxval = 100,
     group = GROUP_HEAD_SHOULDERS
)

maximumHeadShouldersBars = input.int(
     160,
     "Maximum complete pattern length",
     minval = 20,
     maxval = 500,
     group = GROUP_HEAD_SHOULDERS
)

shoulderToleranceATR = input.float(
     0.40,
     "Shoulder price tolerance — ATR",
     minval = 0.05,
     maxval = 2.0,
     step = 0.05,
     group = GROUP_HEAD_SHOULDERS
)

minimumHeadProminenceATR = input.float(
     0.50,
     "Minimum head prominence — ATR",
     minval = 0.10,
     maxval = 5.0,
     step = 0.10,
     group = GROUP_HEAD_SHOULDERS
)


// Calculate Head-and-Shoulders quality.
//
// The score measures:
// 1. Shoulder price similarity.
// 2. Time symmetry around the head.
// 3. Head prominence.
f_headShouldersQuality(
     float firstShoulderPrice,
     float secondShoulderPrice,
     int firstArmBars,
     int secondArmBars,
     float headProminence
) =>
    float safeShoulderTolerance = math.max(
         atrValue * shoulderToleranceATR,
         syminfo.mintick
    )

    float shoulderDifference = math.abs(
         firstShoulderPrice -
         secondShoulderPrice
    )

    float shoulderQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              shoulderDifference /
              safeShoulderTolerance
         )
    )

    float largestArm = math.max(
         float(firstArmBars),
         float(secondArmBars)
    )

    float timeDifference = math.abs(
         float(firstArmBars - secondArmBars)
    )

    float timeQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              timeDifference /
              math.max(
                   1.0,
                   largestArm
              )
         )
    )

    float minimumProminence = math.max(
         atrValue * minimumHeadProminenceATR,
         syminfo.mintick
    )

    float prominenceQuality = math.min(
         1.0,
         headProminence /
         math.max(
              minimumProminence * 2.0,
              syminfo.mintick
         )
    )

    math.max(
         0.0,
         math.min(
              1.0,
              shoulderQuality * 0.45 +
              timeQuality * 0.25 +
              prominenceQuality * 0.30
         )
    )


// Detect a bearish Head and Shoulders.
//
// Stored geometry:
// Point 1 = left shoulder
// Point 2 = first neckline pivot
// Point 3 = head
// Point 4 = second neckline pivot
// Point 5 = right shoulder
// Point 6 = current developing or breakout leg
f_detectHeadAndShoulders() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    if availableHighs >= 3
        float leftShoulderPrice =
             f_pivotHigh(2)

        int leftShoulderBar =
             f_pivotHighBar(2)

        float headPrice =
             f_pivotHigh(1)

        int headBar =
             f_pivotHighBar(1)

        float rightShoulderPrice =
             f_pivotHigh(0)

        int rightShoulderBar =
             f_pivotHighBar(0)

        bool pricesAvailable =
             not na(leftShoulderPrice) and
             not na(headPrice) and
             not na(rightShoulderPrice)

        bool barsAvailable =
             not na(leftShoulderBar) and
             not na(headBar) and
             not na(rightShoulderBar)

        if pricesAvailable and barsAvailable
            int firstArmBars =
                 headBar -
                 leftShoulderBar

            int secondArmBars =
                 rightShoulderBar -
                 headBar

            int completePatternBars =
                 rightShoulderBar -
                 leftShoulderBar

            bool pivotOrderValid =
                 leftShoulderBar <
                 headBar and
                 headBar <
                 rightShoulderBar

            bool timingValid =
                 firstArmBars >= minimumShoulderSeparationBars and
                 secondArmBars >= minimumShoulderSeparationBars and
                 completePatternBars <= maximumHeadShouldersBars

            float shoulderTolerance = math.max(
                 atrValue * shoulderToleranceATR,
                 syminfo.mintick
            )

            bool shouldersMatch =
                 math.abs(
                      leftShoulderPrice -
                      rightShoulderPrice
                 ) <= shoulderTolerance

            float highestShoulder = math.max(
                 leftShoulderPrice,
                 rightShoulderPrice
            )

            float headProminence =
                 headPrice -
                 highestShoulder

            bool headProminent =
                 headProminence >=
                 atrValue *
                 minimumHeadProminenceATR

            if pivotOrderValid and timingValid and shouldersMatch and headProminent
                PatternPivot firstNecklinePivot =
                     f_lowestPivotLowBetween(
                          leftShoulderBar,
                          headBar
                     )

                PatternPivot secondNecklinePivot =
                     f_lowestPivotLowBetween(
                          headBar,
                          rightShoulderBar
                     )

                bool necklinePivotsValid =
                     firstNecklinePivot.valid and
                     secondNecklinePivot.valid

                if necklinePivotsValid
                    float necklineAtHead = f_lineValue(
                         firstNecklinePivot.pivotBar,
                         firstNecklinePivot.pivotPrice,
                         secondNecklinePivot.pivotBar,
                         secondNecklinePivot.pivotPrice,
                         headBar
                    )

                    float projectedNeckline = f_lineValue(
                         firstNecklinePivot.pivotBar,
                         firstNecklinePivot.pivotPrice,
                         secondNecklinePivot.pivotBar,
                         secondNecklinePivot.pivotPrice,
                         bar_index
                    )

                    bool necklineValuesAvailable =
                         not na(necklineAtHead) and
                         not na(projectedNeckline)

                    if necklineValuesAvailable
                        float patternHeight =
                             headPrice -
                             necklineAtHead

                        float patternBottom = math.min(
                             firstNecklinePivot.pivotPrice,
                             secondNecklinePivot.pivotPrice
                        )

                        bool heightValid =
                             f_patternHeightValid(
                                  headPrice,
                                  necklineAtHead
                             )

                        if heightValid
                            float patternQuality =
                                 f_headShouldersQuality(
                                      leftShoulderPrice,
                                      rightShoulderPrice,
                                      firstArmBars,
                                      secondArmBars,
                                      headProminence
                                 )

                            int patternReadyBar =
                                 rightShoulderBar +
                                 pivotLength

                            result := f_createCandidate(
                                 "HEAD AND SHOULDERS",
                                 5,
                                 -1,
                                 leftShoulderBar,
                                 patternReadyBar,
                                 na,
                                 projectedNeckline,
                                 headPrice,
                                 patternBottom,
                                 patternHeight,
                                 patternQuality,
                                 na,
                                 headPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 1,
                                 leftShoulderBar,
                                 leftShoulderPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 2,
                                 firstNecklinePivot.pivotBar,
                                 firstNecklinePivot.pivotPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 3,
                                 headBar,
                                 headPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 4,
                                 secondNecklinePivot.pivotBar,
                                 secondNecklinePivot.pivotPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 5,
                                 rightShoulderBar,
                                 rightShoulderPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 6,
                                 bar_index,
                                 close
                            )

    result


// Detect a bullish Inverse Head and Shoulders.
//
// Stored geometry:
// Point 1 = left shoulder
// Point 2 = first neckline pivot
// Point 3 = head
// Point 4 = second neckline pivot
// Point 5 = right shoulder
// Point 6 = current developing or breakout leg
f_detectInverseHeadAndShoulders() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableLows =
         array.size(pivotLowPrices)

    if availableLows >= 3
        float leftShoulderPrice =
             f_pivotLow(2)

        int leftShoulderBar =
             f_pivotLowBar(2)

        float headPrice =
             f_pivotLow(1)

        int headBar =
             f_pivotLowBar(1)

        float rightShoulderPrice =
             f_pivotLow(0)

        int rightShoulderBar =
             f_pivotLowBar(0)

        bool pricesAvailable =
             not na(leftShoulderPrice) and
             not na(headPrice) and
             not na(rightShoulderPrice)

        bool barsAvailable =
             not na(leftShoulderBar) and
             not na(headBar) and
             not na(rightShoulderBar)

        if pricesAvailable and barsAvailable
            int firstArmBars =
                 headBar -
                 leftShoulderBar

            int secondArmBars =
                 rightShoulderBar -
                 headBar

            int completePatternBars =
                 rightShoulderBar -
                 leftShoulderBar

            bool pivotOrderValid =
                 leftShoulderBar <
                 headBar and
                 headBar <
                 rightShoulderBar

            bool timingValid =
                 firstArmBars >= minimumShoulderSeparationBars and
                 secondArmBars >= minimumShoulderSeparationBars and
                 completePatternBars <= maximumHeadShouldersBars

            float shoulderTolerance = math.max(
                 atrValue * shoulderToleranceATR,
                 syminfo.mintick
            )

            bool shouldersMatch =
                 math.abs(
                      leftShoulderPrice -
                      rightShoulderPrice
                 ) <= shoulderTolerance

            float lowestShoulder = math.min(
                 leftShoulderPrice,
                 rightShoulderPrice
            )

            float headProminence =
                 lowestShoulder -
                 headPrice

            bool headProminent =
                 headProminence >=
                 atrValue *
                 minimumHeadProminenceATR

            if pivotOrderValid and timingValid and shouldersMatch and headProminent
                PatternPivot firstNecklinePivot =
                     f_highestPivotHighBetween(
                          leftShoulderBar,
                          headBar
                     )

                PatternPivot secondNecklinePivot =
                     f_highestPivotHighBetween(
                          headBar,
                          rightShoulderBar
                     )

                bool necklinePivotsValid =
                     firstNecklinePivot.valid and
                     secondNecklinePivot.valid

                if necklinePivotsValid
                    float necklineAtHead = f_lineValue(
                         firstNecklinePivot.pivotBar,
                         firstNecklinePivot.pivotPrice,
                         secondNecklinePivot.pivotBar,
                         secondNecklinePivot.pivotPrice,
                         headBar
                    )

                    float projectedNeckline = f_lineValue(
                         firstNecklinePivot.pivotBar,
                         firstNecklinePivot.pivotPrice,
                         secondNecklinePivot.pivotBar,
                         secondNecklinePivot.pivotPrice,
                         bar_index
                    )

                    bool necklineValuesAvailable =
                         not na(necklineAtHead) and
                         not na(projectedNeckline)

                    if necklineValuesAvailable
                        float patternHeight =
                             necklineAtHead -
                             headPrice

                        float patternTop = math.max(
                             firstNecklinePivot.pivotPrice,
                             secondNecklinePivot.pivotPrice
                        )

                        bool heightValid =
                             f_patternHeightValid(
                                  necklineAtHead,
                                  headPrice
                             )

                        if heightValid
                            float patternQuality =
                                 f_headShouldersQuality(
                                      leftShoulderPrice,
                                      rightShoulderPrice,
                                      firstArmBars,
                                      secondArmBars,
                                      headProminence
                                 )

                            int patternReadyBar =
                                 rightShoulderBar +
                                 pivotLength

                            result := f_createCandidate(
                                 "INVERSE HEAD AND SHOULDERS",
                                 5,
                                 1,
                                 leftShoulderBar,
                                 patternReadyBar,
                                 projectedNeckline,
                                 na,
                                 patternTop,
                                 headPrice,
                                 patternHeight,
                                 patternQuality,
                                 headPrice,
                                 na
                            )

                            result := f_setPatternPoint(
                                 result,
                                 1,
                                 leftShoulderBar,
                                 leftShoulderPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 2,
                                 firstNecklinePivot.pivotBar,
                                 firstNecklinePivot.pivotPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 3,
                                 headBar,
                                 headPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 4,
                                 secondNecklinePivot.pivotBar,
                                 secondNecklinePivot.pivotPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                                                  5,
                                 rightShoulderBar,
                                 rightShoulderPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 6,
                                 bar_index,
                                 close
                            )

    result
    // =============================================================================
// SECTION 14 — FULL HEAD AND SHOULDERS VISUALS
// =============================================================================

headShouldersProjectionBars = input.int(
     20,
     "Head-and-Shoulders neckline projection",
     minval = 5,
     maxval = 100,
     group = GROUP_HEAD_SHOULDERS
)


// Draw the complete Head-and-Shoulders structure.
//
// Standard:
// LS → N1 → H → N2 → RS → Developing leg
//
// Inverse:
// LS → N1 → H → N2 → RS → Developing leg
f_drawHeadShouldersPattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedHeadShoulders =
         candidate.name == "HEAD AND SHOULDERS" or
         candidate.name == "INVERSE HEAD AND SHOULDERS"

    if candidate.valid and recognisedHeadShoulders
        color patternColour =
             f_candidateColour(candidate)

        // Draw the four confirmed structural legs.
        for pointNumber = 1 to 4
            int firstPointBar =
                 f_patternPointBar(
                      candidate,
                      pointNumber
                 )

            float firstPointPrice =
                 f_patternPointPrice(
                      candidate,
                      pointNumber
                 )

            int secondPointBar =
                 f_patternPointBar(
                      candidate,
                      pointNumber + 1
                 )

            float secondPointPrice =
                 f_patternPointPrice(
                      candidate,
                      pointNumber + 1
                 )

            line confirmedSegment = f_addPatternLine(
                 firstPointBar,
                 firstPointPrice,
                 secondPointBar,
                 secondPointPrice,
                 patternColour,
                 patternLineWidth,
                 line.style_solid
            )

            if not na(confirmedSegment)
                linesDrawn += 1

        // Draw the live leg from the right shoulder to current price.
        if showDevelopingLeg
            int rightShoulderBar =
                 f_patternPointBar(
                      candidate,
                      5
                 )

            float rightShoulderPrice =
                 f_patternPointPrice(
                      candidate,
                      5
                 )

            int developingBar =
                 f_patternPointBar(
                      candidate,
                      6
                 )

            float developingPrice =
                 f_patternPointPrice(
                      candidate,
                      6
                 )

            line developingSegment = f_addPatternLine(
                 rightShoulderBar,
                 rightShoulderPrice,
                 developingBar,
                 developingPrice,
                 patternColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(developingSegment)
                linesDrawn += 1

        // Draw the real neckline through the two confirmed neckline pivots.
        int firstNecklineBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float firstNecklinePrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int secondNecklineBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float secondNecklinePrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        int projectedNecklineBar =
             bar_index +
             headShouldersProjectionBars

        float projectedNecklinePrice = f_lineValue(
             firstNecklineBar,
             firstNecklinePrice,
             secondNecklineBar,
             secondNecklinePrice,
             projectedNecklineBar
        )

        line necklineLine = f_addPatternLine(
             firstNecklineBar,
             firstNecklinePrice,
             projectedNecklineBar,
             projectedNecklinePrice,
             necklineColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(necklineLine)
            linesDrawn += 1

        int leftShoulderBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float leftShoulderPrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int headBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float headPrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int rightShoulderBar =
             f_patternPointBar(
                  candidate,
                  5
             )

        float rightShoulderPrice =
             f_patternPointPrice(
                  candidate,
                  5
             )

        bool inversePattern =
             candidate.direction > 0

        bool shoulderLabelsAbove =
             not inversePattern

        bool necklineLabelsAbove =
             inversePattern

        string rightShoulderText =
             "RS" +
             "\n" +
             candidate.name +
             "\n" +
             f_currentPatternStatus(candidate)

        label leftShoulderLabel = f_addPatternPointLabel(
             leftShoulderBar,
             leftShoulderPrice,
             "LS",
             patternColour,
             shoulderLabelsAbove
        )

        label firstNecklineLabel = f_addPatternPointLabel(
             firstNecklineBar,
             firstNecklinePrice,
             "N1",
             necklineColour,
             necklineLabelsAbove
        )

        label headLabel = f_addPatternPointLabel(
             headBar,
             headPrice,
             "HEAD",
             patternColour,
             shoulderLabelsAbove
        )

        label secondNecklineLabel = f_addPatternPointLabel(
             secondNecklineBar,
             secondNecklinePrice,
             "N2",
             necklineColour,
             necklineLabelsAbove
        )

        label rightShoulderLabel = f_addPatternPointLabel(
             rightShoulderBar,
             rightShoulderPrice,
             rightShoulderText,
             patternColour,
             shoulderLabelsAbove
        )

    linesDrawn
    // =============================================================================
// SECTION 15 — RECTANGLE PATTERN DETECTION
// =============================================================================

string GROUP_RECTANGLES = "8. Rectangle Patterns"

minimumRectangleBars = input.int(
     10,
     "Minimum rectangle length",
     minval = 4,
     maxval = 200,
     group = GROUP_RECTANGLES
)

maximumRectangleBars = input.int(
     120,
     "Maximum rectangle length",
     minval = 20,
     maxval = 500,
     group = GROUP_RECTANGLES
)


// Calculate rectangle quality from both horizontal boundaries and its height.
f_rectangleQuality(
     float firstHighPrice,
     float secondHighPrice,
     float firstLowPrice,
     float secondLowPrice,
     float patternHeight
) =>
    float upperBoundaryQuality =
         f_doublePatternLevelQuality(
              firstHighPrice,
              secondHighPrice
         )

    float lowerBoundaryQuality =
         f_doublePatternLevelQuality(
              firstLowPrice,
              secondLowPrice
         )

    float safeHeightRequirement = math.max(
         minimumPatternHeight * 2.0,
         syminfo.mintick
    )

    float heightQuality = math.min(
         1.0,
         patternHeight /
         safeHeightRequirement
    )

    math.max(
         0.0,
         math.min(
              1.0,
              upperBoundaryQuality * 0.40 +
              lowerBoundaryQuality * 0.40 +
              heightQuality * 0.20
         )
    )


// Detect a genuine horizontal rectangle.
//
// Stored geometry:
// Point 1 = first resistance touch
// Point 2 = second resistance touch
// Point 3 = first support touch
// Point 4 = second support touch
//
// The renderer will draw two horizontal boundaries from these exact touches.
// It will not draw a flag, wedge or triangle.
f_detectRectangle() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    int availableLows =
         array.size(pivotLowPrices)

    if availableHighs >= 2 and availableLows >= 2
        float firstHighPrice =
             f_pivotHigh(1)

        int firstHighBar =
             f_pivotHighBar(1)

        float secondHighPrice =
             f_pivotHigh(0)

        int secondHighBar =
             f_pivotHighBar(0)

        float firstLowPrice =
             f_pivotLow(1)

        int firstLowBar =
             f_pivotLowBar(1)

        float secondLowPrice =
             f_pivotLow(0)

        int secondLowBar =
             f_pivotLowBar(0)

        bool pricesAvailable =
             not na(firstHighPrice) and
             not na(secondHighPrice) and
             not na(firstLowPrice) and
             not na(secondLowPrice)

        bool barsAvailable =
             not na(firstHighBar) and
             not na(secondHighBar) and
             not na(firstLowBar) and
             not na(secondLowBar)

        if pricesAvailable and barsAvailable
            bool highOrderValid =
                 firstHighBar <
                 secondHighBar

            bool lowOrderValid =
                 firstLowBar <
                 secondLowBar

            bool touchesOverlap =
                 secondHighBar >
                 firstLowBar and
                 secondLowBar >
                 firstHighBar

            int patternStartBar = math.min(
                 firstHighBar,
                 firstLowBar
            )

            int latestTouchBar = math.max(
                 secondHighBar,
                 secondLowBar
            )

            int completePatternBars =
                 latestTouchBar -
                 patternStartBar

            bool patternLengthValid =
                 completePatternBars >= minimumRectangleBars and
                 completePatternBars <= maximumRectangleBars

            bool resistanceTouchesMatch =
                 f_levelsEqual(
                      firstHighPrice,
                      secondHighPrice
                 )

            bool supportTouchesMatch =
                 f_levelsEqual(
                      firstLowPrice,
                      secondLowPrice
                 )

            float resistancePrice = math.max(
                 firstHighPrice,
                 secondHighPrice
            )

            float supportPrice = math.min(
                 firstLowPrice,
                 secondLowPrice
            )

            float patternHeight =
                 resistancePrice -
                 supportPrice

            bool heightValid =
                 f_patternHeightValid(
                      resistancePrice,
                      supportPrice
                 )

            bool rectangleValid =
                 highOrderValid and
                 lowOrderValid and
                 touchesOverlap and
                 patternLengthValid and
                 resistanceTouchesMatch and
                 supportTouchesMatch and
                 heightValid

            if rectangleValid
                int patternDirection = 0

                if close >
                     resistancePrice +
                     levelTolerance
                    patternDirection := 1
                else if close <
                     supportPrice -
                     levelTolerance
                    patternDirection := -1

                float patternQuality =
                     f_rectangleQuality(
                          firstHighPrice,
                          secondHighPrice,
                          firstLowPrice,
                          secondLowPrice,
                          patternHeight
                     )

                int patternReadyBar =
                     latestTouchBar +
                     pivotLength

                result := f_createCandidate(
                     "RECTANGLE",
                     3,
                     patternDirection,
                     patternStartBar,
                     patternReadyBar,
                     resistancePrice,
                     supportPrice,
                     resistancePrice,
                     supportPrice,
                     patternHeight,
                     patternQuality,
                     supportPrice,
                     resistancePrice
                )

                result := f_setPatternPoint(
                     result,
                     1,
                     firstHighBar,
                     firstHighPrice
                )

                result := f_setPatternPoint(
                     result,
                     2,
                     secondHighBar,
                     secondHighPrice
                )

                result := f_setPatternPoint(
                     result,
                     3,
                     firstLowBar,
                     firstLowPrice
                )

                result := f_setPatternPoint(
                     result,
                     4,
                     secondLowBar,
                     secondLowPrice
                )

    result
    // =============================================================================
// SECTION 16 — FULL RECTANGLE VISUALS
// =============================================================================

rectangleProjectionBars = input.int(
     20,
     "Rectangle boundary projection",
     minval = 5,
     maxval = 100,
     group = GROUP_RECTANGLES
)


// Draw and store a vertical pattern boundary.
f_addVerticalPatternLine(
     int boundaryBar,
     float upperPrice,
     float lowerPrice,
     color lineColour,
     int requestedWidth
) =>
    line createdLine = na

    bool boundaryValid =
         showPatternGeometry and
         not na(boundaryBar) and
         not na(upperPrice) and
         not na(lowerPrice) and
         upperPrice > lowerPrice

    if boundaryValid
        if array.size(patternGeometryLines) >= MAX_PATTERN_LINES
            line.delete(array.shift(patternGeometryLines))

        int safeLineWidth = math.max(
             1,
             math.min(
                  10,
                  requestedWidth
             )
        )

        createdLine := line.new(
             x1 = boundaryBar,
             y1 = upperPrice,
             x2 = boundaryBar,
             y2 = lowerPrice,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = lineColour,
             style = line.style_solid,
             width = safeLineWidth
        )

        array.push(
             patternGeometryLines,
             createdLine
        )

    createdLine


// Return the current Rectangle state.
f_rectangleStatus(
     PatternCandidate candidate
) =>
    string rectangleStatus = "FORMING"

    if close >
         candidate.upperTrigger +
         levelTolerance
        rectangleStatus := "BULLISH BREAKOUT"
    else if close <
         candidate.lowerTrigger -
         levelTolerance
        rectangleStatus := "BEARISH BREAKOUT"

    rectangleStatus


// Draw a Rectangle as a genuine rectangle.
//
// The actual resistance and support touches are labelled separately.
// No diagonal flag, wedge or triangle geometry is used here.
f_drawRectanglePattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedRectangle =
         candidate.name == "RECTANGLE"

    if candidate.valid and recognisedRectangle
        color rectangleColour =
             f_candidateColour(candidate)

        int rectangleStartBar =
             candidate.startBar

        int rectangleRightBar = math.max(
             bar_index,
             candidate.readyBar
        )

        int rectangleProjectionEnd =
             rectangleRightBar +
             rectangleProjectionBars

        float rectangleTop =
             candidate.zoneTop

        float rectangleBottom =
             candidate.zoneBottom

        // Solid upper resistance boundary.
        line upperBoundary = f_addPatternLevel(
             rectangleStartBar,
             rectangleRightBar,
             rectangleTop,
             rectangleColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(upperBoundary)
            linesDrawn += 1

        // Solid lower support boundary.
        line lowerBoundary = f_addPatternLevel(
             rectangleStartBar,
             rectangleRightBar,
             rectangleBottom,
             rectangleColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(lowerBoundary)
            linesDrawn += 1

        // Left side of the rectangle.
        line leftBoundary = f_addVerticalPatternLine(
             rectangleStartBar,
             rectangleTop,
             rectangleBottom,
             rectangleColour,
             patternLineWidth
        )

        if not na(leftBoundary)
            linesDrawn += 1

        // Current right side of the rectangle.
        line rightBoundary = f_addVerticalPatternLine(
             rectangleRightBar,
             rectangleTop,
             rectangleBottom,
             rectangleColour,
             patternLineWidth
        )

        if not na(rightBoundary)
            linesDrawn += 1

        // Dashed future resistance projection.
        line projectedUpperBoundary = f_addPatternLevel(
             rectangleRightBar,
             rectangleProjectionEnd,
             rectangleTop,
             rectangleColour,
             patternLineWidth,
             line.style_dashed
        )

        if not na(projectedUpperBoundary)
            linesDrawn += 1

        // Dashed future support projection.
        line projectedLowerBoundary = f_addPatternLevel(
             rectangleRightBar,
             rectangleProjectionEnd,
             rectangleBottom,
             rectangleColour,
             patternLineWidth,
             line.style_dashed
        )

        if not na(projectedLowerBoundary)
            linesDrawn += 1

        int firstResistanceBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float firstResistancePrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int secondResistanceBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float secondResistancePrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int firstSupportBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float firstSupportPrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int secondSupportBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float secondSupportPrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        string secondResistanceText =
             "R2" +
             "\n" +
             candidate.name +
             "\n" +
             f_rectangleStatus(candidate)

        label firstResistanceLabel = f_addPatternPointLabel(
             firstResistanceBar,
             firstResistancePrice,
             "R1",
             rectangleColour,
             true
        )

        label secondResistanceLabel = f_addPatternPointLabel(
             secondResistanceBar,
             secondResistancePrice,
             secondResistanceText,
             rectangleColour,
             true
        )

        label firstSupportLabel = f_addPatternPointLabel(
             firstSupportBar,
             firstSupportPrice,
             "S1",
             rectangleColour,
             false
        )

        label secondSupportLabel = f_addPatternPointLabel(
             secondSupportBar,
             secondSupportPrice,
             "S2",
             rectangleColour,
             false
        )

    linesDrawn
    // =============================================================================
// SECTION 17 — ASCENDING, DESCENDING AND SYMMETRICAL TRIANGLE DETECTION
// =============================================================================

string GROUP_TRIANGLES = "9. Triangle Patterns"

minimumTriangleBars = input.int(
     10,
     "Minimum triangle length",
     minval = 4,
     maxval = 200,
     group = GROUP_TRIANGLES
)

maximumTriangleBars = input.int(
     160,
     "Maximum triangle length",
     minval = 20,
     maxval = 500,
     group = GROUP_TRIANGLES
)

minimumTriangleSlopeATR = input.float(
     0.01,
     "Minimum boundary slope — ATR per bar",
     minval = 0.001,
     maxval = 0.50,
     step = 0.001,
     group = GROUP_TRIANGLES
)


// Calculate triangle quality from convergence and boundary shape.
f_triangleQuality(
     float startingGap,
     float endingGap,
     float boundaryShapeQuality
) =>
    float safeStartingGap = math.max(
         startingGap,
         syminfo.mintick
    )

    float convergenceQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              endingGap /
              safeStartingGap
         )
    )

    math.max(
         0.0,
         math.min(
              1.0,
              convergenceQuality * 0.55 +
              boundaryShapeQuality * 0.45
         )
    )


// Detect one of the three genuine Triangle structures.
//
// Stored geometry:
// Point 1 = first upper-boundary pivot
// Point 2 = second upper-boundary pivot
// Point 3 = first lower-boundary pivot
// Point 4 = second lower-boundary pivot
f_detectTriangle() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    int availableLows =
         array.size(pivotLowPrices)

    if availableHighs >= 2 and availableLows >= 2
        float firstHighPrice =
             f_pivotHigh(1)

        int firstHighBar =
             f_pivotHighBar(1)

        float secondHighPrice =
             f_pivotHigh(0)

        int secondHighBar =
             f_pivotHighBar(0)

        float firstLowPrice =
             f_pivotLow(1)

        int firstLowBar =
             f_pivotLowBar(1)

        float secondLowPrice =
             f_pivotLow(0)

        int secondLowBar =
             f_pivotLowBar(0)

        bool pricesAvailable =
             not na(firstHighPrice) and
             not na(secondHighPrice) and
             not na(firstLowPrice) and
             not na(secondLowPrice)

        bool barsAvailable =
             not na(firstHighBar) and
             not na(secondHighBar) and
             not na(firstLowBar) and
             not na(secondLowBar)

        if pricesAvailable and barsAvailable
            bool highOrderValid =
                 firstHighBar <
                 secondHighBar

            bool lowOrderValid =
                 firstLowBar <
                 secondLowBar

            bool boundaryPeriodsOverlap =
                 secondHighBar >
                 firstLowBar and
                 secondLowBar >
                 firstHighBar

            int patternStartBar = math.min(
                 firstHighBar,
                 firstLowBar
            )

            int commonCalculationStart = math.max(
                 firstHighBar,
                 firstLowBar
            )

            int latestBoundaryBar = math.max(
                 secondHighBar,
                 secondLowBar
            )

            int completePatternBars =
                 latestBoundaryBar -
                 patternStartBar

            bool patternLengthValid =
                 completePatternBars >= minimumTriangleBars and
                 completePatternBars <= maximumTriangleBars

            float upperSlope =
                 (
                      secondHighPrice -
                      firstHighPrice
                 ) /
                 math.max(
                      1.0,
                      float(
                           secondHighBar -
                           firstHighBar
                      )
                 )

            float lowerSlope =
                 (
                      secondLowPrice -
                      firstLowPrice
                 ) /
                 math.max(
                      1.0,
                      float(
                           secondLowBar -
                           firstLowBar
                      )
                 )

            float minimumSlope = math.max(
                 atrValue *
                 minimumTriangleSlopeATR,
                 syminfo.mintick *
                 0.01
            )

            bool upperBoundaryFlat =
                 math.abs(
                      secondHighPrice -
                      firstHighPrice
                 ) <= levelTolerance

            bool lowerBoundaryFlat =
                 math.abs(
                      secondLowPrice -
                      firstLowPrice
                 ) <= levelTolerance

            bool lowerBoundaryRising =
                 lowerSlope >
                 minimumSlope

            bool upperBoundaryFalling =
                 upperSlope <
                 -minimumSlope

            bool ascendingShape =
                 upperBoundaryFlat and
                 lowerBoundaryRising

            bool descendingShape =
                 upperBoundaryFalling and
                 lowerBoundaryFlat

            bool symmetricalShape =
                 upperBoundaryFalling and
                 lowerBoundaryRising

            float upperAtStart = f_lineValue(
                 firstHighBar,
                 firstHighPrice,
                 secondHighBar,
                 secondHighPrice,
                 commonCalculationStart
            )

            float lowerAtStart = f_lineValue(
                 firstLowBar,
                 firstLowPrice,
                 secondLowBar,
                 secondLowPrice,
                 commonCalculationStart
            )

            float upperAtLatestBar = f_lineValue(
                 firstHighBar,
                 firstHighPrice,
                 secondHighBar,
                 secondHighPrice,
                 latestBoundaryBar
            )

            float lowerAtLatestBar = f_lineValue(
                 firstLowBar,
                 firstLowPrice,
                 secondLowBar,
                 secondLowPrice,
                 latestBoundaryBar
            )

            float projectedUpperTrigger = f_lineValue(
                 firstHighBar,
                 firstHighPrice,
                 secondHighBar,
                 secondHighPrice,
                 bar_index
            )

            float projectedLowerTrigger = f_lineValue(
                 firstLowBar,
                 firstLowPrice,
                 secondLowBar,
                 secondLowPrice,
                 bar_index
            )

            bool boundaryValuesAvailable =
                 not na(upperAtStart) and
                 not na(lowerAtStart) and
                 not na(upperAtLatestBar) and
                 not na(lowerAtLatestBar) and
                 not na(projectedUpperTrigger) and
                 not na(projectedLowerTrigger)

            if boundaryValuesAvailable
                float startingGap =
                     upperAtStart -
                     lowerAtStart

                float endingGap =
                     upperAtLatestBar -
                     lowerAtLatestBar

                bool boundariesConverge =
                     startingGap > 0.0 and
                     endingGap > 0.0 and
                     endingGap < startingGap

                bool projectedBoundariesValid =
                     projectedUpperTrigger >
                     projectedLowerTrigger

                float patternTop = math.max(
                     firstHighPrice,
                     secondHighPrice
                )

                float patternBottom = math.min(
                     firstLowPrice,
                     secondLowPrice
                )

                float patternHeight =
                     patternTop -
                     patternBottom

                bool heightValid =
                     f_patternHeightValid(
                          patternTop,
                          patternBottom
                     )

                bool baseStructureValid =
                     highOrderValid and
                     lowOrderValid and
                     boundaryPeriodsOverlap and
                     patternLengthValid and
                     boundariesConverge and
                     projectedBoundariesValid and
                     heightValid

                if baseStructureValid
                    string patternName = ""
                    int patternRank = 0
                    int patternDirection = 0
                    float boundaryShapeQuality = 0.0
                    bool recognisedTriangle = false

                    float safeFlatTolerance = math.max(
                         levelTolerance,
                         syminfo.mintick
                    )

                    if ascendingShape and detectDirectionalTriangles
                        float flatTopQuality = math.max(
                             0.0,
                             1.0 -
                             math.abs(
                                  secondHighPrice -
                                  firstHighPrice
                             ) /
                             safeFlatTolerance
                        )

                        float risingSupportQuality = math.min(
                             1.0,
                             lowerSlope /
                             math.max(
                                  minimumSlope * 3.0,
                                  syminfo.mintick * 0.01
                             )
                        )

                        boundaryShapeQuality :=
                             flatTopQuality * 0.50 +
                             risingSupportQuality * 0.50

                        patternName := "ASCENDING TRIANGLE"
                        patternRank := 2
                        patternDirection := 1
                        recognisedTriangle := true

                    else if descendingShape and detectDirectionalTriangles
                        float flatBaseQuality = math.max(
                             0.0,
                             1.0 -
                             math.abs(
                                  secondLowPrice -
                                  firstLowPrice
                             ) /
                             safeFlatTolerance
                        )

                        float fallingResistanceQuality = math.min(
                             1.0,
                             math.abs(upperSlope) /
                             math.max(
                                  minimumSlope * 3.0,
                                  syminfo.mintick * 0.01
                             )
                        )

                        boundaryShapeQuality :=
                             flatBaseQuality * 0.50 +
                             fallingResistanceQuality * 0.50

                        patternName := "DESCENDING TRIANGLE"
                        patternRank := 2
                        patternDirection := -1
                        recognisedTriangle := true

                    else if symmetricalShape and detectSymmetricalTriangles
                        float largestSlope = math.max(
                             math.abs(upperSlope),
                             math.abs(lowerSlope)
                        )

                        float slopeDifference = math.abs(
                             math.abs(upperSlope) -
                             math.abs(lowerSlope)
                        )

                        float slopeBalanceQuality = math.max(
                             0.0,
                             1.0 -
                             slopeDifference /
                             math.max(
                                  largestSlope,
                                  syminfo.mintick * 0.01
                             )
                        )

                        boundaryShapeQuality :=
                             slopeBalanceQuality

                        patternName := "SYMMETRICAL TRIANGLE"
                        patternRank := 10

                        if close >
                             projectedUpperTrigger +
                             levelTolerance
                            patternDirection := 1
                        else if close <
                             projectedLowerTrigger -
                             levelTolerance
                            patternDirection := -1
                        else
                            patternDirection := 0

                        recognisedTriangle := true

                    if recognisedTriangle
                        float patternQuality =
                             f_triangleQuality(
                                  startingGap,
                                  endingGap,
                                  boundaryShapeQuality
                             )

                        int patternReadyBar =
                             latestBoundaryBar +
                             pivotLength

                        result := f_createCandidate(
                             patternName,
                             patternRank,
                             patternDirection,
                             patternStartBar,
                             patternReadyBar,
                             projectedUpperTrigger,
                             projectedLowerTrigger,
                             patternTop,
                             patternBottom,
                             patternHeight,
                             patternQuality,
                             projectedLowerTrigger,
                             projectedUpperTrigger
                        )

                        result := f_setPatternPoint(
                             result,
                             1,
                             firstHighBar,
                             firstHighPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             2,
                             secondHighBar,
                             secondHighPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             3,
                             firstLowBar,
                             firstLowPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             4,
                             secondLowBar,
                             secondLowPrice
                        )

    result
    // =============================================================================
// SECTION 18 — FULL TRIANGLE VISUALS
// =============================================================================

triangleProjectionBars = input.int(
     80,
     "Maximum triangle apex projection",
     minval = 10,
     maxval = 400,
     group = GROUP_TRIANGLES
)


// Calculate the bar where the upper and lower triangle boundaries intersect.
f_triangleApexBar(
     PatternCandidate candidate
) =>
    int calculatedApexBar = na

    int firstUpperBar =
         f_patternPointBar(
              candidate,
              1
         )

    float firstUpperPrice =
         f_patternPointPrice(
              candidate,
              1
         )

    int secondUpperBar =
         f_patternPointBar(
              candidate,
              2
         )

    float secondUpperPrice =
         f_patternPointPrice(
              candidate,
              2
         )

    int firstLowerBar =
         f_patternPointBar(
              candidate,
              3
         )

    float firstLowerPrice =
         f_patternPointPrice(
              candidate,
              3
         )

    int secondLowerBar =
         f_patternPointBar(
              candidate,
              4
         )

    float secondLowerPrice =
         f_patternPointPrice(
              candidate,
              4
         )

    bool pointsAvailable =
         f_patternPointExists(candidate, 1) and
         f_patternPointExists(candidate, 2) and
         f_patternPointExists(candidate, 3) and
         f_patternPointExists(candidate, 4)

    if pointsAvailable
        float upperSlope =
             (
                  secondUpperPrice -
                  firstUpperPrice
             ) /
             math.max(
                  1.0,
                  float(
                       secondUpperBar -
                       firstUpperBar
                  )
             )

        float lowerSlope =
             (
                  secondLowerPrice -
                  firstLowerPrice
             ) /
             math.max(
                  1.0,
                  float(
                       secondLowerBar -
                       firstLowerBar
                  )
             )

        float upperIntercept =
             firstUpperPrice -
             upperSlope *
             float(firstUpperBar)

        float lowerIntercept =
             firstLowerPrice -
             lowerSlope *
             float(firstLowerBar)

        float slopeDifference =
             upperSlope -
             lowerSlope

        if math.abs(slopeDifference) > 0.0000000001
            float apexBarValue =
                 (
                      lowerIntercept -
                      upperIntercept
                 ) /
                 slopeDifference

            calculatedApexBar :=
                 int(
                      math.round(
                           apexBarValue
                      )
                 )

    calculatedApexBar


// Return the current Triangle state.
f_triangleStatus(
     PatternCandidate candidate
) =>
    string triangleStatus = "FORMING"

    if close >
         candidate.upperTrigger +
         levelTolerance
        triangleStatus := "BULLISH BREAKOUT"
    else if close <
         candidate.lowerTrigger -
         levelTolerance
        triangleStatus := "BEARISH BREAKOUT"

    triangleStatus


// Draw a genuine Triangle.
//
// Solid lines connect the confirmed boundary pivots.
// Dashed lines project those same boundaries toward the calculated apex.
f_drawTrianglePattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedTriangle =
         candidate.name == "ASCENDING TRIANGLE" or
         candidate.name == "DESCENDING TRIANGLE" or
         candidate.name == "SYMMETRICAL TRIANGLE"

    if candidate.valid and recognisedTriangle
        color triangleColour =
             f_candidateColour(candidate)

        int firstUpperBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float firstUpperPrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int secondUpperBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float secondUpperPrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int firstLowerBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float firstLowerPrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int secondLowerBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float secondLowerPrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        // Confirmed upper boundary.
        line confirmedUpperBoundary = f_addPatternLine(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             triangleColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedUpperBoundary)
            linesDrawn += 1

        // Confirmed lower boundary.
        line confirmedLowerBoundary = f_addPatternLine(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             triangleColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedLowerBoundary)
            linesDrawn += 1

        int latestBoundaryBar = math.max(
             secondUpperBar,
             secondLowerBar
        )

        int maximumProjectionBar =
             bar_index +
             triangleProjectionBars

        int calculatedApexBar =
             f_triangleApexBar(candidate)

        int projectionEndBar =
             maximumProjectionBar

        bool apexAvailable =
             not na(calculatedApexBar) and
             calculatedApexBar >
             latestBoundaryBar

        if apexAvailable
            projectionEndBar := math.min(
                 calculatedApexBar,
                 maximumProjectionBar
            )

        float projectedUpperPrice = f_lineValue(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             projectionEndBar
        )

        float projectedLowerPrice = f_lineValue(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             projectionEndBar
        )

        if showDevelopingLeg
            line projectedUpperBoundary = f_addPatternLine(
                 secondUpperBar,
                 secondUpperPrice,
                 projectionEndBar,
                 projectedUpperPrice,
                 triangleColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedUpperBoundary)
                linesDrawn += 1

            line projectedLowerBoundary = f_addPatternLine(
                 secondLowerBar,
                 secondLowerPrice,
                 projectionEndBar,
                 projectedLowerPrice,
                 triangleColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedLowerBoundary)
                linesDrawn += 1

        string secondUpperText =
             "U2" +
             "\n" +
             candidate.name +
             "\n" +
             f_triangleStatus(candidate)

        label firstUpperLabel = f_addPatternPointLabel(
             firstUpperBar,
             firstUpperPrice,
             "U1",
             triangleColour,
             true
        )

        label secondUpperLabel = f_addPatternPointLabel(
             secondUpperBar,
             secondUpperPrice,
             secondUpperText,
             triangleColour,
             true
        )

        label firstLowerLabel = f_addPatternPointLabel(
             firstLowerBar,
             firstLowerPrice,
             "L1",
             triangleColour,
             false
        )

        label secondLowerLabel = f_addPatternPointLabel(
             secondLowerBar,
             secondLowerPrice,
             "L2",
             triangleColour,
             false
        )

        if apexAvailable and calculatedApexBar <= maximumProjectionBar
            float apexPrice = f_lineValue(
                 firstUpperBar,
                 firstUpperPrice,
                 secondUpperBar,
                 secondUpperPrice,
                 calculatedApexBar
            )

            label apexLabel = f_addPatternPointLabel(
                 calculatedApexBar,
                 apexPrice,
                 "APEX",
                 triangleColour,
                 true
            )

    linesDrawn
    // =============================================================================
// SECTION 19 — FLAG POLE AND CHANNEL VALIDATION TOOLS
// =============================================================================

string GROUP_FLAGS = "10. Bull and Bear Flags"

minimumFlagPoleATR = input.float(
     2.0,
     "Minimum flagpole height — ATR",
     minval = 0.5,
     maxval = 20.0,
     step = 0.25,
     group = GROUP_FLAGS
)

maximumFlagPoleBars = input.int(
     30,
     "Maximum flagpole length",
     minval = 3,
     maxval = 200,
     group = GROUP_FLAGS
)

minimumFlagChannelBars = input.int(
     5,
     "Minimum flag-channel length",
     minval = 3,
     maxval = 100,
     group = GROUP_FLAGS
)

maximumFlagChannelBars = input.int(
     50,
     "Maximum flag-channel length",
     minval = 10,
     maxval = 200,
     group = GROUP_FLAGS
)

maximumFlagRetracement = input.float(
     0.50,
     "Maximum flag retracement",
     minval = 0.10,
     maxval = 0.80,
     step = 0.05,
     group = GROUP_FLAGS
)

maximumFlagSlopeDifference = input.float(
     0.35,
     "Maximum channel slope difference",
     minval = 0.05,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_FLAGS
)

minimumFlagSlopeATR = input.float(
     0.003,
     "Minimum counter-trend slope — ATR per bar",
     minval = 0.001,
     maxval = 0.10,
     step = 0.001,
     group = GROUP_FLAGS
)


// Return the most recent confirmed pivot low before a specified bar.
f_latestPivotLowBefore(
     int targetBar
) =>
    PatternPivot result =
         f_emptyPatternPivot()

    int availableLows =
         array.size(pivotLowPrices)

    if not na(targetBar) and availableLows > 0
        for pivotIndex = 0 to availableLows - 1
            int currentPivotBar = array.get(
                 pivotLowBars,
                 pivotIndex
            )

            float currentPivotPrice = array.get(
                 pivotLowPrices,
                 pivotIndex
            )

            bool pivotQualifies =
                 currentPivotBar <
                 targetBar

            if pivotQualifies
                if not result.valid
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotBar > result.pivotBar
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )

    result


// Return the most recent confirmed pivot high before a specified bar.
f_latestPivotHighBefore(
     int targetBar
) =>
    PatternPivot result =
         f_emptyPatternPivot()

    int availableHighs =
         array.size(pivotHighPrices)

    if not na(targetBar) and availableHighs > 0
        for pivotIndex = 0 to availableHighs - 1
            int currentPivotBar = array.get(
                 pivotHighBars,
                 pivotIndex
            )

            float currentPivotPrice = array.get(
                 pivotHighPrices,
                 pivotIndex
            )

            bool pivotQualifies =
                 currentPivotBar <
                 targetBar

            if pivotQualifies
                if not result.valid
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )
                else if currentPivotBar > result.pivotBar
                    result := PatternPivot.new(
                         true,
                         currentPivotBar,
                         currentPivotPrice
                    )

    result


// Measure how closely the two flag-channel slopes match.
f_flagParallelQuality(
     float upperSlope,
     float lowerSlope
) =>
    float largestSlope = math.max(
         math.abs(upperSlope),
         math.abs(lowerSlope)
    )

    float slopeDifference = math.abs(
         upperSlope -
         lowerSlope
    )

    float differenceRatio =
         slopeDifference /
         math.max(
              largestSlope,
              syminfo.mintick * 0.01
         )

    math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              differenceRatio
         )
    )


// Confirm that the channel slopes against the direction of the flagpole.
//
// Bull Flag: both boundaries must slope down.
// Bear Flag: both boundaries must slope up.
//
// Therefore a horizontal Rectangle cannot pass this test.
f_flagChannelDirectionValid(
     int direction,
     float upperSlope,
     float lowerSlope
) =>
    float minimumSlope = math.max(
         atrValue *
         minimumFlagSlopeATR,
         syminfo.mintick *
         0.01
    )

    bool channelDirectionValid = false

    if direction > 0
        channelDirectionValid :=
             upperSlope < -minimumSlope and
             lowerSlope < -minimumSlope
    else if direction < 0
        channelDirectionValid :=
             upperSlope > minimumSlope and
             lowerSlope > minimumSlope

    channelDirectionValid


// Confirm that the two channel boundaries are sufficiently parallel.
//
// Therefore a converging Triangle cannot pass this test.
f_flagChannelParallelValid(
     float upperSlope,
     float lowerSlope
) =>
    float largestSlope = math.max(
         math.abs(upperSlope),
         math.abs(lowerSlope)
    )

    float slopeDifference = math.abs(
         upperSlope -
         lowerSlope
    )

    float differenceRatio =
         slopeDifference /
         math.max(
              largestSlope,
              syminfo.mintick * 0.01
         )

    differenceRatio <=
         maximumFlagSlopeDifference


// Calculate the final quality of a Flag candidate.
f_flagPatternQuality(
     float poleHeight,
     float retracement,
     float upperSlope,
     float lowerSlope
) =>
    float minimumPoleHeight = math.max(
         atrValue *
         minimumFlagPoleATR,
         syminfo.mintick
    )

    float poleQuality = math.min(
         1.0,
         poleHeight /
         math.max(
              minimumPoleHeight * 2.0,
              syminfo.mintick
         )
    )

    float retracementQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              retracement /
              math.max(
                   maximumFlagRetracement,
                   0.01
              )
         )
    )

    float parallelQuality =
         f_flagParallelQuality(
              upperSlope,
              lowerSlope
         )

    math.max(
         0.0,
         math.min(
              1.0,
              poleQuality * 0.35 +
              retracementQuality * 0.30 +
              parallelQuality * 0.35
         )
    )
    // =============================================================================
// SECTION 20 — BULL FLAG AND BEAR FLAG DETECTION
// =============================================================================

// Detect a Bull Flag or Bear Flag.
//
// direction:
//  1 = Bull Flag
// -1 = Bear Flag
//
// Stored geometry:
// Point 1 = beginning of the flagpole
// Point 2 = end of the flagpole
// Point 3 = first upper-channel pivot
// Point 4 = second upper-channel pivot
// Point 5 = first lower-channel pivot
// Point 6 = second lower-channel pivot
// Point 7 = current developing or breakout position
f_detectFlag(
     int direction
) =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    int availableLows =
         array.size(pivotLowPrices)

    bool directionValid =
         direction == 1 or
         direction == -1

    if detectFlags and directionValid and availableHighs >= 2 and availableLows >= 2
        float firstHighPrice =
             f_pivotHigh(1)

        int firstHighBar =
             f_pivotHighBar(1)

        float secondHighPrice =
             f_pivotHigh(0)

        int secondHighBar =
             f_pivotHighBar(0)

        float firstLowPrice =
             f_pivotLow(1)

        int firstLowBar =
             f_pivotLowBar(1)

        float secondLowPrice =
             f_pivotLow(0)

        int secondLowBar =
             f_pivotLowBar(0)

        bool pricesAvailable =
             not na(firstHighPrice) and
             not na(secondHighPrice) and
             not na(firstLowPrice) and
             not na(secondLowPrice)

        bool barsAvailable =
             not na(firstHighBar) and
             not na(secondHighBar) and
             not na(firstLowBar) and
             not na(secondLowBar)

        if pricesAvailable and barsAvailable
            bool highOrderValid =
                 firstHighBar <
                 secondHighBar

            bool lowOrderValid =
                 firstLowBar <
                 secondLowBar

            bool channelPeriodsOverlap =
                 secondHighBar >
                 firstLowBar and
                 secondLowBar >
                 firstHighBar

            float poleEndPrice =
                 direction > 0 ?
                 firstHighPrice :
                 firstLowPrice

            int poleEndBar =
                 direction > 0 ?
                 firstHighBar :
                 firstLowBar

            PatternPivot poleStart =
                 direction > 0 ?
                 f_latestPivotLowBefore(poleEndBar) :
                 f_latestPivotHighBefore(poleEndBar)

            if poleStart.valid
                float poleHeight =
                     direction > 0 ?
                     poleEndPrice - poleStart.pivotPrice :
                     poleStart.pivotPrice - poleEndPrice

                int poleBars =
                     poleEndBar -
                     poleStart.pivotBar

                int latestChannelBar = math.max(
                     secondHighBar,
                     secondLowBar
                )

                int channelBars =
                     latestChannelBar -
                     poleEndBar

                bool poleOrderValid =
                     poleStart.pivotBar <
                     poleEndBar

                bool poleHeightValid =
                     poleHeight >=
                     atrValue *
                     minimumFlagPoleATR

                bool poleLengthValid =
                     poleBars >= 1 and
                     poleBars <= maximumFlagPoleBars

                bool channelLengthValid =
                     channelBars >= minimumFlagChannelBars and
                     channelBars <= maximumFlagChannelBars

                bool channelStartsAfterPole = false

                if direction > 0
                    channelStartsAfterPole :=
                         firstHighBar == poleEndBar and
                         firstLowBar > poleEndBar and
                         secondHighBar > poleEndBar and
                         secondLowBar > poleEndBar
                else
                    channelStartsAfterPole :=
                         firstLowBar == poleEndBar and
                         firstHighBar > poleEndBar and
                         secondHighBar > poleEndBar and
                         secondLowBar > poleEndBar

                float upperSlope =
                     (
                          secondHighPrice -
                          firstHighPrice
                     ) /
                     math.max(
                          1.0,
                          float(
                               secondHighBar -
                               firstHighBar
                          )
                     )

                float lowerSlope =
                     (
                          secondLowPrice -
                          firstLowPrice
                     ) /
                     math.max(
                          1.0,
                          float(
                               secondLowBar -
                               firstLowBar
                          )
                     )

                bool channelDirectionValid =
                     f_flagChannelDirectionValid(
                          direction,
                          upperSlope,
                          lowerSlope
                     )

                bool channelParallelValid =
                     f_flagChannelParallelValid(
                          upperSlope,
                          lowerSlope
                     )

                float upperAtLatestBar = f_lineValue(
                     firstHighBar,
                     firstHighPrice,
                     secondHighBar,
                     secondHighPrice,
                     latestChannelBar
                )

                float lowerAtLatestBar = f_lineValue(
                     firstLowBar,
                     firstLowPrice,
                     secondLowBar,
                     secondLowPrice,
                     latestChannelBar
                )

                float projectedUpperTrigger = f_lineValue(
                     firstHighBar,
                     firstHighPrice,
                     secondHighBar,
                     secondHighPrice,
                     bar_index
                )

                float projectedLowerTrigger = f_lineValue(
                     firstLowBar,
                     firstLowPrice,
                     secondLowBar,
                     secondLowPrice,
                     bar_index
                )

                bool boundaryValuesAvailable =
                     not na(upperAtLatestBar) and
                     not na(lowerAtLatestBar) and
                     not na(projectedUpperTrigger) and
                     not na(projectedLowerTrigger)

                if boundaryValuesAvailable
                    float channelHeight =
                         upperAtLatestBar -
                         lowerAtLatestBar

                    bool channelHeightValid =
                         channelHeight > syminfo.mintick and
                         channelHeight <= poleHeight * 0.65

                    bool projectedChannelValid =
                         projectedUpperTrigger >
                         projectedLowerTrigger

                    float flagHighestPrice = math.max(
                         firstHighPrice,
                         secondHighPrice
                    )

                    float flagLowestPrice = math.min(
                         firstLowPrice,
                         secondLowPrice
                    )

                    float retracement =
                         direction > 0 ?
                         (
                              poleEndPrice -
                              flagLowestPrice
                         ) /
                         math.max(
                              poleHeight,
                              syminfo.mintick
                         ) :
                         (
                              flagHighestPrice -
                              poleEndPrice
                         ) /
                         math.max(
                              poleHeight,
                              syminfo.mintick
                         )

                    bool retracementValid =
                         retracement >= 0.05 and
                         retracement <= maximumFlagRetracement

                    bool completeFlagValid =
                         highOrderValid and
                         lowOrderValid and
                         channelPeriodsOverlap and
                         poleOrderValid and
                         poleHeightValid and
                         poleLengthValid and
                         channelLengthValid and
                         channelStartsAfterPole and
                         channelDirectionValid and
                         channelParallelValid and
                         channelHeightValid and
                         projectedChannelValid and
                         retracementValid

                    if completeFlagValid
                        float patternQuality =
                             f_flagPatternQuality(
                                  poleHeight,
                                  retracement,
                                  upperSlope,
                                  lowerSlope
                             )

                        int patternReadyBar =
                             latestChannelBar +
                             pivotLength

                        float bullishStopPrice = na
                        float bearishStopPrice = na

                        if direction > 0
                            bullishStopPrice := math.min(
                                 projectedLowerTrigger,
                                 flagLowestPrice
                            )
                        else
                            bearishStopPrice := math.max(
                                 projectedUpperTrigger,
                                 flagHighestPrice
                            )

                        string patternName =
                             direction > 0 ?
                             "BULL FLAG" :
                             "BEAR FLAG"

                        result := f_createCandidate(
                             patternName,
                             1,
                             direction,
                             poleStart.pivotBar,
                             patternReadyBar,
                             projectedUpperTrigger,
                             projectedLowerTrigger,
                             flagHighestPrice,
                             flagLowestPrice,
                             poleHeight,
                             patternQuality,
                             bullishStopPrice,
                             bearishStopPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             1,
                             poleStart.pivotBar,
                             poleStart.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             2,
                             poleEndBar,
                             poleEndPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             3,
                             firstHighBar,
                             firstHighPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             4,
                             secondHighBar,
                             secondHighPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             5,
                             firstLowBar,
                             firstLowPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             6,
                             secondLowBar,
                             secondLowPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             7,
                             bar_index,
                             close
                        )

    result
    // =============================================================================
// SECTION 21 — FULL BULL FLAG AND BEAR FLAG VISUALS
// =============================================================================

flagProjectionBars = input.int(
     20,
     "Flag-channel projection",
     minval = 5,
     maxval = 100,
     group = GROUP_FLAGS
)


// Return the current Bull Flag or Bear Flag state.
f_flagStatus(
     PatternCandidate candidate
) =>
    string flagStatus = "FORMING"

    if candidate.direction > 0
        if close >
             candidate.upperTrigger +
             levelTolerance
            flagStatus := "BULLISH BREAKOUT"
        else if close <
             candidate.lowerTrigger -
             levelTolerance
            flagStatus := "INVALIDATED"
    else if candidate.direction < 0
        if close <
             candidate.lowerTrigger -
             levelTolerance
            flagStatus := "BEARISH BREAKOUT"
        else if close >
             candidate.upperTrigger +
             levelTolerance
            flagStatus := "INVALIDATED"

    flagStatus


// Draw a genuine Flag.
//
// Point 1 → Point 2 draws the strong directional flagpole.
// Point 3 → Point 4 draws the upper counter-trend channel.
// Point 5 → Point 6 draws the lower counter-trend channel.
//
// The channel boundaries remain separate and parallel.
f_drawFlagPattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedFlag =
         candidate.name == "BULL FLAG" or
         candidate.name == "BEAR FLAG"

    if candidate.valid and recognisedFlag
        color flagColour =
             f_candidateColour(candidate)

        int poleStartBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float poleStartPrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int poleEndBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float poleEndPrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int firstUpperBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float firstUpperPrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int secondUpperBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float secondUpperPrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        int firstLowerBar =
             f_patternPointBar(
                  candidate,
                  5
             )

        float firstLowerPrice =
             f_patternPointPrice(
                  candidate,
                  5
             )

        int secondLowerBar =
             f_patternPointBar(
                  candidate,
                  6
             )

        float secondLowerPrice =
             f_patternPointPrice(
                  candidate,
                  6
             )

        int poleLineWidth = math.min(
             10,
             patternLineWidth + 1
        )

        // The directional flagpole.
        line flagPoleLine = f_addPatternLine(
             poleStartBar,
             poleStartPrice,
             poleEndBar,
             poleEndPrice,
             poleColour,
             poleLineWidth,
             line.style_solid
        )

        if not na(flagPoleLine)
            linesDrawn += 1

        // Confirmed upper channel boundary.
        line confirmedUpperChannel = f_addPatternLine(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             flagColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedUpperChannel)
            linesDrawn += 1

        // Confirmed lower channel boundary.
        line confirmedLowerChannel = f_addPatternLine(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             flagColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedLowerChannel)
            linesDrawn += 1

        int projectionEndBar =
             bar_index +
             flagProjectionBars

        float projectedUpperPrice = f_lineValue(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             projectionEndBar
        )

        float projectedLowerPrice = f_lineValue(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             projectionEndBar
        )

        // Continue both parallel channel boundaries into the future.
        if showDevelopingLeg
            line projectedUpperChannel = f_addPatternLine(
                 secondUpperBar,
                 secondUpperPrice,
                 projectionEndBar,
                 projectedUpperPrice,
                 flagColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedUpperChannel)
                linesDrawn += 1

            line projectedLowerChannel = f_addPatternLine(
                 secondLowerBar,
                 secondLowerPrice,
                 projectionEndBar,
                 projectedLowerPrice,
                 flagColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedLowerChannel)
                linesDrawn += 1

        bool bullishFlag =
             candidate.direction > 0

        bool poleStartLabelAbove =
             not bullishFlag

        bool poleEndLabelAbove =
             bullishFlag

        string secondUpperText =
             "U2" +
             "\n" +
             candidate.name +
             "\n" +
             f_flagStatus(candidate)

        label poleStartLabel = f_addPatternPointLabel(
             poleStartBar,
             poleStartPrice,
             "POLE START",
             poleColour,
             poleStartLabelAbove
        )

        label poleEndLabel = f_addPatternPointLabel(
             poleEndBar,
             poleEndPrice,
             "POLE END",
             poleColour,
             poleEndLabelAbove
        )

        label firstUpperLabel = f_addPatternPointLabel(
             firstUpperBar,
             firstUpperPrice,
             "U1",
             flagColour,
             true
        )

        label secondUpperLabel = f_addPatternPointLabel(
             secondUpperBar,
             secondUpperPrice,
             secondUpperText,
             flagColour,
             true
        )

        label firstLowerLabel = f_addPatternPointLabel(
             firstLowerBar,
             firstLowerPrice,
             "L1",
             flagColour,
             false
        )

        label secondLowerLabel = f_addPatternPointLabel(
             secondLowerBar,
             secondLowerPrice,
             "L2",
             flagColour,
             false
        )

    linesDrawn
    // =============================================================================
// SECTION 22 — PENNANT POLE AND CONVERGENCE VALIDATION
// =============================================================================

string GROUP_PENNANTS = "11. Bull and Bear Pennants"

minimumPennantPoleATR = input.float(
     2.0,
     "Minimum pennant pole height — ATR",
     minval = 0.5,
     maxval = 20.0,
     step = 0.25,
     group = GROUP_PENNANTS
)

maximumPennantPoleBars = input.int(
     30,
     "Maximum pennant pole length",
     minval = 3,
     maxval = 200,
     group = GROUP_PENNANTS
)

minimumPennantBars = input.int(
     5,
     "Minimum pennant length",
     minval = 3,
     maxval = 100,
     group = GROUP_PENNANTS
)

maximumPennantBars = input.int(
     40,
     "Maximum pennant length",
     minval = 10,
     maxval = 200,
     group = GROUP_PENNANTS
)

maximumPennantRetracement = input.float(
     0.50,
     "Maximum pennant retracement",
     minval = 0.10,
     maxval = 0.80,
     step = 0.05,
     group = GROUP_PENNANTS
)

minimumPennantConvergence = input.float(
     0.15,
     "Minimum pennant convergence",
     minval = 0.05,
     maxval = 0.80,
     step = 0.05,
     group = GROUP_PENNANTS
)

minimumPennantSlopeATR = input.float(
     0.003,
     "Minimum pennant slope — ATR per bar",
     minval = 0.001,
     maxval = 0.10,
     step = 0.001,
     group = GROUP_PENNANTS
)


// Confirm that the Pennant has one falling upper boundary and one rising
// lower boundary.
f_pennantSlopesValid(
     float upperSlope,
     float lowerSlope
) =>
    float minimumSlope = math.max(
         atrValue *
         minimumPennantSlopeATR,
         syminfo.mintick *
         0.01
    )

    upperSlope < -minimumSlope and
         lowerSlope > minimumSlope


// Confirm that the Pennant boundaries genuinely converge.
f_pennantConvergenceValid(
     float startingGap,
     float endingGap
) =>
    bool gapsValid =
         startingGap > 0.0 and
         endingGap > 0.0

    bool sufficientConvergence =
         endingGap <=
         startingGap *
         (
              1.0 -
              minimumPennantConvergence
         )

    gapsValid and
         sufficientConvergence


// Measure how evenly the two Pennant boundaries converge.
f_pennantSlopeBalanceQuality(
     float upperSlope,
     float lowerSlope
) =>
    float upperMagnitude =
         math.abs(upperSlope)

    float lowerMagnitude =
         math.abs(lowerSlope)

    float largestMagnitude = math.max(
         upperMagnitude,
         lowerMagnitude
    )

    float magnitudeDifference = math.abs(
         upperMagnitude -
         lowerMagnitude
    )

    math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              magnitudeDifference /
              math.max(
                   largestMagnitude,
                   syminfo.mintick * 0.01
              )
         )
    )


// Calculate the complete Pennant quality.
f_pennantPatternQuality(
     float poleHeight,
     float retracement,
     float startingGap,
     float endingGap,
     float upperSlope,
     float lowerSlope
) =>
    float minimumPoleHeight = math.max(
         atrValue *
         minimumPennantPoleATR,
         syminfo.mintick
    )

    float poleQuality = math.min(
         1.0,
         poleHeight /
         math.max(
              minimumPoleHeight * 2.0,
              syminfo.mintick
         )
    )

    float retracementQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              retracement /
              math.max(
                   maximumPennantRetracement,
                   0.01
              )
         )
    )

    float convergenceQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              endingGap /
              math.max(
                   startingGap,
                   syminfo.mintick
              )
         )
    )

    float slopeBalanceQuality =
         f_pennantSlopeBalanceQuality(
              upperSlope,
              lowerSlope
         )

    math.max(
         0.0,
         math.min(
              1.0,
              poleQuality * 0.30 +
              retracementQuality * 0.20 +
              convergenceQuality * 0.30 +
              slopeBalanceQuality * 0.20
         )
    )
    // =============================================================================
// SECTION 23 — BULL PENNANT AND BEAR PENNANT DETECTION
// =============================================================================

// Detect a Bull Pennant or Bear Pennant.
//
// direction:
//  1 = Bull Pennant
// -1 = Bear Pennant
//
// Stored geometry:
// Point 1 = beginning of the pole
// Point 2 = end of the pole
// Point 3 = first upper-boundary pivot
// Point 4 = second upper-boundary pivot
// Point 5 = first lower-boundary pivot
// Point 6 = second lower-boundary pivot
// Point 7 = current developing or breakout position
f_detectPennant(
     int direction
) =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    int availableLows =
         array.size(pivotLowPrices)

    bool directionValid =
         direction == 1 or
         direction == -1

    if detectPennants and directionValid and availableHighs >= 2 and availableLows >= 2
        float firstHighPrice =
             f_pivotHigh(1)

        int firstHighBar =
             f_pivotHighBar(1)

        float secondHighPrice =
             f_pivotHigh(0)

        int secondHighBar =
             f_pivotHighBar(0)

        float firstLowPrice =
             f_pivotLow(1)

        int firstLowBar =
             f_pivotLowBar(1)

        float secondLowPrice =
             f_pivotLow(0)

        int secondLowBar =
             f_pivotLowBar(0)

        bool pricesAvailable =
             not na(firstHighPrice) and
             not na(secondHighPrice) and
             not na(firstLowPrice) and
             not na(secondLowPrice)

        bool barsAvailable =
             not na(firstHighBar) and
             not na(secondHighBar) and
             not na(firstLowBar) and
             not na(secondLowBar)

        if pricesAvailable and barsAvailable
            bool highOrderValid =
                 firstHighBar <
                 secondHighBar

            bool lowOrderValid =
                 firstLowBar <
                 secondLowBar

            bool boundaryPeriodsOverlap =
                 secondHighBar >
                 firstLowBar and
                 secondLowBar >
                 firstHighBar

            float poleEndPrice =
                 direction > 0 ?
                 firstHighPrice :
                 firstLowPrice

            int poleEndBar =
                 direction > 0 ?
                 firstHighBar :
                 firstLowBar

            PatternPivot poleStart =
                 direction > 0 ?
                 f_latestPivotLowBefore(poleEndBar) :
                 f_latestPivotHighBefore(poleEndBar)

            if poleStart.valid
                float poleHeight =
                     direction > 0 ?
                     poleEndPrice - poleStart.pivotPrice :
                     poleStart.pivotPrice - poleEndPrice

                int poleBars =
                     poleEndBar -
                     poleStart.pivotBar

                int commonCalculationStart = math.max(
                     firstHighBar,
                     firstLowBar
                )

                int latestBoundaryBar = math.max(
                     secondHighBar,
                     secondLowBar
                )

                int pennantBars =
                     latestBoundaryBar -
                     poleEndBar

                bool poleOrderValid =
                     poleStart.pivotBar <
                     poleEndBar

                bool poleHeightValid =
                     poleHeight >=
                     atrValue *
                     minimumPennantPoleATR

                bool poleLengthValid =
                     poleBars >= 1 and
                     poleBars <= maximumPennantPoleBars

                bool pennantLengthValid =
                     pennantBars >= minimumPennantBars and
                     pennantBars <= maximumPennantBars

                bool pennantStartsAfterPole = false

                if direction > 0
                    pennantStartsAfterPole :=
                         firstHighBar == poleEndBar and
                         firstLowBar > poleEndBar and
                         secondHighBar > poleEndBar and
                         secondLowBar > poleEndBar
                else
                    pennantStartsAfterPole :=
                         firstLowBar == poleEndBar and
                         firstHighBar > poleEndBar and
                         secondHighBar > poleEndBar and
                         secondLowBar > poleEndBar

                float upperSlope =
                     (
                          secondHighPrice -
                          firstHighPrice
                     ) /
                     math.max(
                          1.0,
                          float(
                               secondHighBar -
                               firstHighBar
                          )
                     )

                float lowerSlope =
                     (
                          secondLowPrice -
                          firstLowPrice
                     ) /
                     math.max(
                          1.0,
                          float(
                               secondLowBar -
                               firstLowBar
                          )
                     )

                bool slopeStructureValid =
                     f_pennantSlopesValid(
                          upperSlope,
                          lowerSlope
                     )

                float upperAtStart = f_lineValue(
                     firstHighBar,
                     firstHighPrice,
                     secondHighBar,
                     secondHighPrice,
                     commonCalculationStart
                )

                float lowerAtStart = f_lineValue(
                     firstLowBar,
                     firstLowPrice,
                     secondLowBar,
                     secondLowPrice,
                     commonCalculationStart
                )

                float upperAtLatestBar = f_lineValue(
                     firstHighBar,
                     firstHighPrice,
                     secondHighBar,
                     secondHighPrice,
                     latestBoundaryBar
                )

                float lowerAtLatestBar = f_lineValue(
                     firstLowBar,
                     firstLowPrice,
                     secondLowBar,
                     secondLowPrice,
                     latestBoundaryBar
                )

                float projectedUpperTrigger = f_lineValue(
                     firstHighBar,
                     firstHighPrice,
                     secondHighBar,
                     secondHighPrice,
                     bar_index
                )

                float projectedLowerTrigger = f_lineValue(
                     firstLowBar,
                     firstLowPrice,
                     secondLowBar,
                     secondLowPrice,
                     bar_index
                )

                bool boundaryValuesAvailable =
                     not na(upperAtStart) and
                     not na(lowerAtStart) and
                     not na(upperAtLatestBar) and
                     not na(lowerAtLatestBar) and
                     not na(projectedUpperTrigger) and
                     not na(projectedLowerTrigger)

                if boundaryValuesAvailable
                    float startingGap =
                         upperAtStart -
                         lowerAtStart

                    float endingGap =
                         upperAtLatestBar -
                         lowerAtLatestBar

                    bool convergenceValid =
                         f_pennantConvergenceValid(
                              startingGap,
                              endingGap
                         )

                    bool projectedBoundariesValid =
                         projectedUpperTrigger >
                         projectedLowerTrigger

                    bool pennantSizeValid =
                         startingGap <=
                         poleHeight *
                         0.65

                    float pennantHighestPrice = math.max(
                         firstHighPrice,
                         secondHighPrice
                    )

                    float pennantLowestPrice = math.min(
                         firstLowPrice,
                         secondLowPrice
                    )

                    float retracement =
                         direction > 0 ?
                         (
                              poleEndPrice -
                              pennantLowestPrice
                         ) /
                         math.max(
                              poleHeight,
                              syminfo.mintick
                         ) :
                         (
                              pennantHighestPrice -
                              poleEndPrice
                         ) /
                         math.max(
                              poleHeight,
                              syminfo.mintick
                         )

                    bool retracementValid =
                         retracement >= 0.05 and
                         retracement <= maximumPennantRetracement

                    bool completePennantValid =
                         highOrderValid and
                         lowOrderValid and
                         boundaryPeriodsOverlap and
                         poleOrderValid and
                         poleHeightValid and
                         poleLengthValid and
                         pennantLengthValid and
                         pennantStartsAfterPole and
                         slopeStructureValid and
                         convergenceValid and
                         projectedBoundariesValid and
                         pennantSizeValid and
                         retracementValid

                    if completePennantValid
                        float patternQuality =
                             f_pennantPatternQuality(
                                  poleHeight,
                                  retracement,
                                  startingGap,
                                  endingGap,
                                  upperSlope,
                                  lowerSlope
                             )

                        int patternReadyBar =
                             latestBoundaryBar +
                             pivotLength

                        float bullishStopPrice = na
                        float bearishStopPrice = na

                        if direction > 0
                            bullishStopPrice := math.min(
                                 projectedLowerTrigger,
                                 pennantLowestPrice
                            )
                        else
                            bearishStopPrice := math.max(
                                 projectedUpperTrigger,
                                 pennantHighestPrice
                            )

                        string patternName =
                             direction > 0 ?
                             "BULL PENNANT" :
                             "BEAR PENNANT"

                        result := f_createCandidate(
                             patternName,
                             6,
                             direction,
                             poleStart.pivotBar,
                             patternReadyBar,
                             projectedUpperTrigger,
                             projectedLowerTrigger,
                             pennantHighestPrice,
                             pennantLowestPrice,
                             poleHeight,
                             patternQuality,
                             bullishStopPrice,
                             bearishStopPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             1,
                             poleStart.pivotBar,
                             poleStart.pivotPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             2,
                             poleEndBar,
                             poleEndPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             3,
                             firstHighBar,
                             firstHighPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             4,
                             secondHighBar,
                             secondHighPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             5,
                             firstLowBar,
                             firstLowPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             6,
                             secondLowBar,
                             secondLowPrice
                        )

                        result := f_setPatternPoint(
                             result,
                             7,
                             bar_index,
                             close
                        )

    result
    // =============================================================================
// SECTION 24 — FULL BULL PENNANT AND BEAR PENNANT VISUALS
// =============================================================================

pennantProjectionBars = input.int(
     60,
     "Maximum pennant apex projection",
     minval = 10,
     maxval = 300,
     group = GROUP_PENNANTS
)


// Calculate the bar where the two Pennant boundaries intersect.
f_pennantApexBar(
     PatternCandidate candidate
) =>
    int calculatedApexBar = na

    int firstUpperBar =
         f_patternPointBar(
              candidate,
              3
         )

    float firstUpperPrice =
         f_patternPointPrice(
              candidate,
              3
         )

    int secondUpperBar =
         f_patternPointBar(
              candidate,
              4
         )

    float secondUpperPrice =
         f_patternPointPrice(
              candidate,
              4
         )

    int firstLowerBar =
         f_patternPointBar(
              candidate,
              5
         )

    float firstLowerPrice =
         f_patternPointPrice(
              candidate,
              5
         )

    int secondLowerBar =
         f_patternPointBar(
              candidate,
              6
         )

    float secondLowerPrice =
         f_patternPointPrice(
              candidate,
              6
         )

    bool pointsAvailable =
         f_patternPointExists(candidate, 3) and
         f_patternPointExists(candidate, 4) and
         f_patternPointExists(candidate, 5) and
         f_patternPointExists(candidate, 6)

    if pointsAvailable
        float upperSlope =
             (
                  secondUpperPrice -
                  firstUpperPrice
             ) /
             math.max(
                  1.0,
                  float(
                       secondUpperBar -
                       firstUpperBar
                  )
             )

        float lowerSlope =
             (
                  secondLowerPrice -
                  firstLowerPrice
             ) /
             math.max(
                  1.0,
                  float(
                       secondLowerBar -
                       firstLowerBar
                  )
             )

        float upperIntercept =
             firstUpperPrice -
             upperSlope *
             float(firstUpperBar)

        float lowerIntercept =
             firstLowerPrice -
             lowerSlope *
             float(firstLowerBar)

        float slopeDifference =
             upperSlope -
             lowerSlope

        if math.abs(slopeDifference) > 0.0000000001
            float apexBarValue =
                 (
                      lowerIntercept -
                      upperIntercept
                 ) /
                 slopeDifference

            calculatedApexBar :=
                 int(
                      math.round(
                           apexBarValue
                      )
                 )

    calculatedApexBar


// Return the current Pennant state.
f_pennantStatus(
     PatternCandidate candidate
) =>
    string pennantStatus = "FORMING"

    if candidate.direction > 0
        if close >
             candidate.upperTrigger +
             levelTolerance
            pennantStatus := "BULLISH BREAKOUT"
        else if close <
             candidate.lowerTrigger -
             levelTolerance
            pennantStatus := "INVALIDATED"
    else if candidate.direction < 0
        if close <
             candidate.lowerTrigger -
             levelTolerance
            pennantStatus := "BEARISH BREAKOUT"
        else if close >
             candidate.upperTrigger +
             levelTolerance
            pennantStatus := "INVALIDATED"

    pennantStatus


// Draw the complete Bull Pennant or Bear Pennant.
//
// Point 1 → Point 2 is the directional pole.
// Point 3 → Point 4 is the confirmed upper boundary.
// Point 5 → Point 6 is the confirmed lower boundary.
// Dashed lines continue both boundaries toward their apex.
f_drawPennantPattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedPennant =
         candidate.name == "BULL PENNANT" or
         candidate.name == "BEAR PENNANT"

    if candidate.valid and recognisedPennant
        color pennantColour =
             f_candidateColour(candidate)

        int poleStartBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float poleStartPrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int poleEndBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float poleEndPrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int firstUpperBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float firstUpperPrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int secondUpperBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float secondUpperPrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        int firstLowerBar =
             f_patternPointBar(
                  candidate,
                  5
             )

        float firstLowerPrice =
             f_patternPointPrice(
                  candidate,
                  5
             )

        int secondLowerBar =
             f_patternPointBar(
                  candidate,
                  6
             )

        float secondLowerPrice =
             f_patternPointPrice(
                  candidate,
                  6
             )

        int poleLineWidth = math.min(
             10,
             patternLineWidth + 1
        )

        // Draw the directional pole.
        line pennantPoleLine = f_addPatternLine(
             poleStartBar,
             poleStartPrice,
             poleEndBar,
             poleEndPrice,
             poleColour,
             poleLineWidth,
             line.style_solid
        )

        if not na(pennantPoleLine)
            linesDrawn += 1

        // Draw the confirmed upper boundary.
        line confirmedUpperBoundary = f_addPatternLine(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             pennantColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedUpperBoundary)
            linesDrawn += 1

        // Draw the confirmed lower boundary.
        line confirmedLowerBoundary = f_addPatternLine(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             pennantColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedLowerBoundary)
            linesDrawn += 1

        int latestBoundaryBar = math.max(
             secondUpperBar,
             secondLowerBar
        )

        int maximumProjectionBar =
             bar_index +
             pennantProjectionBars

        int calculatedApexBar =
             f_pennantApexBar(candidate)

        int projectionEndBar =
             maximumProjectionBar

        bool apexAvailable =
             not na(calculatedApexBar) and
             calculatedApexBar >
             latestBoundaryBar

        if apexAvailable
            projectionEndBar := math.min(
                 calculatedApexBar,
                 maximumProjectionBar
            )

        float projectedUpperPrice = f_lineValue(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             projectionEndBar
        )

        float projectedLowerPrice = f_lineValue(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             projectionEndBar
        )

        if showDevelopingLeg
            line projectedUpperBoundary = f_addPatternLine(
                 secondUpperBar,
                 secondUpperPrice,
                 projectionEndBar,
                 projectedUpperPrice,
                 pennantColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedUpperBoundary)
                linesDrawn += 1

            line projectedLowerBoundary = f_addPatternLine(
                 secondLowerBar,
                 secondLowerPrice,
                 projectionEndBar,
                 projectedLowerPrice,
                 pennantColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedLowerBoundary)
                linesDrawn += 1

        bool bullishPennant =
             candidate.direction > 0

        bool poleStartLabelAbove =
             not bullishPennant

        bool poleEndLabelAbove =
             bullishPennant

        string secondUpperText =
             "U2" +
             "\n" +
             candidate.name +
             "\n" +
             f_pennantStatus(candidate)

        label poleStartLabel = f_addPatternPointLabel(
             poleStartBar,
             poleStartPrice,
             "POLE START",
             poleColour,
             poleStartLabelAbove
        )

        label poleEndLabel = f_addPatternPointLabel(
             poleEndBar,
             poleEndPrice,
             "POLE END",
             poleColour,
             poleEndLabelAbove
        )

        label firstUpperLabel = f_addPatternPointLabel(
             firstUpperBar,
             firstUpperPrice,
             "U1",
             pennantColour,
             true
        )

        label secondUpperLabel = f_addPatternPointLabel(
             secondUpperBar,
             secondUpperPrice,
             secondUpperText,
             pennantColour,
             true
        )

        label firstLowerLabel = f_addPatternPointLabel(
             firstLowerBar,
             firstLowerPrice,
             "L1",
             pennantColour,
             false
        )

        label secondLowerLabel = f_addPatternPointLabel(
             secondLowerBar,
             secondLowerPrice,
             "L2",
             pennantColour,
             false
        )

        if apexAvailable and calculatedApexBar <= maximumProjectionBar
            float apexPrice = f_lineValue(
                 firstUpperBar,
                 firstUpperPrice,
                 secondUpperBar,
                 secondUpperPrice,
                 calculatedApexBar
            )

            label apexLabel = f_addPatternPointLabel(
                 calculatedApexBar,
                 apexPrice,
                 "APEX",
                 pennantColour,
                 true
            )

    linesDrawn
    // =============================================================================
// SECTION 25 — RISING WEDGE AND FALLING WEDGE DETECTION
// =============================================================================

string GROUP_WEDGES = "12. Rising and Falling Wedges"

minimumWedgeBars = input.int(
     15,
     "Minimum wedge length",
     minval = 5,
     maxval = 200,
     group = GROUP_WEDGES
)

maximumWedgeBars = input.int(
     180,
     "Maximum wedge length",
     minval = 30,
     maxval = 500,
     group = GROUP_WEDGES
)

minimumWedgeSlopeATR = input.float(
     0.003,
     "Minimum wedge slope — ATR per bar",
     minval = 0.001,
     maxval = 0.10,
     step = 0.001,
     group = GROUP_WEDGES
)

minimumWedgeConvergence = input.float(
     0.15,
     "Minimum wedge convergence",
     minval = 0.05,
     maxval = 0.80,
     step = 0.05,
     group = GROUP_WEDGES
)


// Calculate Wedge quality from convergence, slope balance and pattern height.
f_wedgePatternQuality(
     float startingGap,
     float endingGap,
     float upperSlope,
     float lowerSlope,
     float patternHeight
) =>
    float convergenceQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              endingGap /
              math.max(
                   startingGap,
                   syminfo.mintick
              )
         )
    )

    float upperMagnitude =
         math.abs(upperSlope)

    float lowerMagnitude =
         math.abs(lowerSlope)

    float smallerMagnitude = math.min(
         upperMagnitude,
         lowerMagnitude
    )

    float largerMagnitude = math.max(
         upperMagnitude,
         lowerMagnitude
    )

    float slopeBalanceQuality =
         smallerMagnitude /
         math.max(
              largerMagnitude,
              syminfo.mintick * 0.01
         )

    float heightQuality = math.min(
         1.0,
         patternHeight /
         math.max(
              minimumPatternHeight * 2.0,
              syminfo.mintick
         )
    )

    math.max(
         0.0,
         math.min(
              1.0,
              convergenceQuality * 0.50 +
              slopeBalanceQuality * 0.30 +
              heightQuality * 0.20
         )
    )


// Detect a Rising Wedge or Falling Wedge.
//
// Rising Wedge:
// Both boundaries rise, but support rises faster.
// Expected direction is bearish.
//
// Falling Wedge:
// Both boundaries fall, but resistance falls faster.
// Expected direction is bullish.
//
// Stored geometry:
// Point 1 = first upper-boundary pivot
// Point 2 = second upper-boundary pivot
// Point 3 = first lower-boundary pivot
// Point 4 = second lower-boundary pivot
f_detectWedge() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    int availableLows =
         array.size(pivotLowPrices)

    if detectWedges and availableHighs >= 2 and availableLows >= 2
        float firstHighPrice =
             f_pivotHigh(1)

        int firstHighBar =
             f_pivotHighBar(1)

        float secondHighPrice =
             f_pivotHigh(0)

        int secondHighBar =
             f_pivotHighBar(0)

        float firstLowPrice =
             f_pivotLow(1)

        int firstLowBar =
             f_pivotLowBar(1)

        float secondLowPrice =
             f_pivotLow(0)

        int secondLowBar =
             f_pivotLowBar(0)

        bool pricesAvailable =
             not na(firstHighPrice) and
             not na(secondHighPrice) and
             not na(firstLowPrice) and
             not na(secondLowPrice)

        bool barsAvailable =
             not na(firstHighBar) and
             not na(secondHighBar) and
             not na(firstLowBar) and
             not na(secondLowBar)

        if pricesAvailable and barsAvailable
            bool highOrderValid =
                 firstHighBar <
                 secondHighBar

            bool lowOrderValid =
                 firstLowBar <
                 secondLowBar

            bool boundaryPeriodsOverlap =
                 secondHighBar >
                 firstLowBar and
                 secondLowBar >
                 firstHighBar

            int patternStartBar = math.min(
                 firstHighBar,
                 firstLowBar
            )

            int commonCalculationStart = math.max(
                 firstHighBar,
                 firstLowBar
            )

            int latestBoundaryBar = math.max(
                 secondHighBar,
                 secondLowBar
            )

            int completePatternBars =
                 latestBoundaryBar -
                 patternStartBar

            bool patternLengthValid =
                 completePatternBars >= minimumWedgeBars and
                 completePatternBars <= maximumWedgeBars

            float upperSlope =
                 (
                      secondHighPrice -
                      firstHighPrice
                 ) /
                 math.max(
                      1.0,
                      float(
                           secondHighBar -
                           firstHighBar
                      )
                 )

            float lowerSlope =
                 (
                      secondLowPrice -
                      firstLowPrice
                 ) /
                 math.max(
                      1.0,
                      float(
                           secondLowBar -
                           firstLowBar
                      )
                 )

            float minimumSlope = math.max(
                 atrValue *
                 minimumWedgeSlopeATR,
                 syminfo.mintick *
                 0.01
            )

            bool risingWedgeShape =
                 upperSlope > minimumSlope and
                 lowerSlope > minimumSlope and
                 lowerSlope > upperSlope

            bool fallingWedgeShape =
                 upperSlope < -minimumSlope and
                 lowerSlope < -minimumSlope and
                 upperSlope < lowerSlope

            float upperAtStart = f_lineValue(
                 firstHighBar,
                 firstHighPrice,
                 secondHighBar,
                 secondHighPrice,
                 commonCalculationStart
            )

            float lowerAtStart = f_lineValue(
                 firstLowBar,
                 firstLowPrice,
                 secondLowBar,
                 secondLowPrice,
                 commonCalculationStart
            )

            float upperAtLatestBar = f_lineValue(
                 firstHighBar,
                 firstHighPrice,
                 secondHighBar,
                 secondHighPrice,
                 latestBoundaryBar
            )

            float lowerAtLatestBar = f_lineValue(
                 firstLowBar,
                 firstLowPrice,
                 secondLowBar,
                 secondLowPrice,
                 latestBoundaryBar
            )

            float projectedUpperTrigger = f_lineValue(
                 firstHighBar,
                 firstHighPrice,
                 secondHighBar,
                 secondHighPrice,
                 bar_index
            )

            float projectedLowerTrigger = f_lineValue(
                 firstLowBar,
                 firstLowPrice,
                 secondLowBar,
                 secondLowPrice,
                 bar_index
            )

            bool boundaryValuesAvailable =
                 not na(upperAtStart) and
                 not na(lowerAtStart) and
                 not na(upperAtLatestBar) and
                 not na(lowerAtLatestBar) and
                 not na(projectedUpperTrigger) and
                 not na(projectedLowerTrigger)

            if boundaryValuesAvailable
                float startingGap =
                     upperAtStart -
                     lowerAtStart

                float endingGap =
                     upperAtLatestBar -
                     lowerAtLatestBar

                bool gapsValid =
                     startingGap > 0.0 and
                     endingGap > 0.0

                bool sufficientConvergence =
                     endingGap <=
                     startingGap *
                     (
                          1.0 -
                          minimumWedgeConvergence
                     )

                bool projectedBoundariesValid =
                     projectedUpperTrigger >
                     projectedLowerTrigger

                float patternTop = math.max(
                     firstHighPrice,
                     secondHighPrice
                )

                float patternBottom = math.min(
                     firstLowPrice,
                     secondLowPrice
                )

                float patternHeight =
                     patternTop -
                     patternBottom

                bool heightValid =
                     f_patternHeightValid(
                          patternTop,
                          patternBottom
                     )

                bool wedgeStructureValid =
                     highOrderValid and
                     lowOrderValid and
                     boundaryPeriodsOverlap and
                     patternLengthValid and
                     gapsValid and
                     sufficientConvergence and
                     projectedBoundariesValid and
                     heightValid

                bool recognisedWedge =
                     risingWedgeShape or
                     fallingWedgeShape

                if wedgeStructureValid and recognisedWedge
                    string patternName =
                         risingWedgeShape ?
                         "RISING WEDGE" :
                         "FALLING WEDGE"

                    int patternDirection =
                         risingWedgeShape ?
                         -1 :
                         1

                    float patternQuality =
                         f_wedgePatternQuality(
                              startingGap,
                              endingGap,
                              upperSlope,
                              lowerSlope,
                              patternHeight
                         )

                    int patternReadyBar =
                         latestBoundaryBar +
                         pivotLength

                    float bullishStopPrice = na
                    float bearishStopPrice = na

                    if patternDirection > 0
                        bullishStopPrice := math.min(
                             projectedLowerTrigger,
                             patternBottom
                        )
                    else
                        bearishStopPrice := math.max(
                             projectedUpperTrigger,
                             patternTop
                        )

                    result := f_createCandidate(
                         patternName,
                         7,
                         patternDirection,
                         patternStartBar,
                         patternReadyBar,
                         projectedUpperTrigger,
                         projectedLowerTrigger,
                         patternTop,
                         patternBottom,
                         patternHeight,
                         patternQuality,
                         bullishStopPrice,
                         bearishStopPrice
                    )

                    result := f_setPatternPoint(
                         result,
                         1,
                         firstHighBar,
                         firstHighPrice
                    )

                    result := f_setPatternPoint(
                         result,
                         2,
                         secondHighBar,
                         secondHighPrice
                    )

                    result := f_setPatternPoint(
                         result,
                         3,
                         firstLowBar,
                         firstLowPrice
                    )

                    result := f_setPatternPoint(
                         result,
                         4,
                         secondLowBar,
                         secondLowPrice
                    )

    result
    // =============================================================================
// SECTION 26 — FULL RISING WEDGE AND FALLING WEDGE VISUALS
// =============================================================================

wedgeProjectionBars = input.int(
     80,
     "Maximum wedge apex projection",
     minval = 10,
     maxval = 400,
     group = GROUP_WEDGES
)


// Return the current Wedge state.
f_wedgeStatus(
     PatternCandidate candidate
) =>
    string wedgeStatus = "FORMING"

    if candidate.direction > 0
        if close >
             candidate.upperTrigger +
             levelTolerance
            wedgeStatus := "BULLISH BREAKOUT"
        else if close <
             candidate.lowerTrigger -
             levelTolerance
            wedgeStatus := "INVALIDATED"
    else if candidate.direction < 0
        if close <
             candidate.lowerTrigger -
             levelTolerance
            wedgeStatus := "BEARISH BREAKOUT"
        else if close >
             candidate.upperTrigger +
             levelTolerance
            wedgeStatus := "INVALIDATED"

    wedgeStatus


// Draw a genuine Rising Wedge or Falling Wedge.
//
// Both boundaries travel in the same direction while converging.
// Solid sections connect confirmed pivots.
// Dashed sections project those boundaries toward the apex.
f_drawWedgePattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedWedge =
         candidate.name == "RISING WEDGE" or
         candidate.name == "FALLING WEDGE"

    if candidate.valid and recognisedWedge
        color wedgeColour =
             f_candidateColour(candidate)

        int firstUpperBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float firstUpperPrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int secondUpperBar =
             f_patternPointBar(
                  candidate,
                  2
             )

        float secondUpperPrice =
             f_patternPointPrice(
                  candidate,
                  2
             )

        int firstLowerBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float firstLowerPrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int secondLowerBar =
             f_patternPointBar(
                  candidate,
                  4
             )

        float secondLowerPrice =
             f_patternPointPrice(
                  candidate,
                  4
             )

        // Confirmed upper Wedge boundary.
        line confirmedUpperBoundary = f_addPatternLine(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             wedgeColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedUpperBoundary)
            linesDrawn += 1

        // Confirmed lower Wedge boundary.
        line confirmedLowerBoundary = f_addPatternLine(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             wedgeColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(confirmedLowerBoundary)
            linesDrawn += 1

        int latestBoundaryBar = math.max(
             secondUpperBar,
             secondLowerBar
        )

        int maximumProjectionBar =
             bar_index +
             wedgeProjectionBars

        // Wedges use the same four-point boundary intersection calculation.
        int calculatedApexBar =
             f_triangleApexBar(candidate)

        int projectionEndBar =
             maximumProjectionBar

        bool apexAvailable =
             not na(calculatedApexBar) and
             calculatedApexBar >
             latestBoundaryBar

        if apexAvailable
            projectionEndBar := math.min(
                 calculatedApexBar,
                 maximumProjectionBar
            )

        float projectedUpperPrice = f_lineValue(
             firstUpperBar,
             firstUpperPrice,
             secondUpperBar,
             secondUpperPrice,
             projectionEndBar
        )

        float projectedLowerPrice = f_lineValue(
             firstLowerBar,
             firstLowerPrice,
             secondLowerBar,
             secondLowerPrice,
             projectionEndBar
        )

        if showDevelopingLeg
            line projectedUpperBoundary = f_addPatternLine(
                 secondUpperBar,
                 secondUpperPrice,
                 projectionEndBar,
                 projectedUpperPrice,
                 wedgeColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedUpperBoundary)
                linesDrawn += 1

            line projectedLowerBoundary = f_addPatternLine(
                 secondLowerBar,
                 secondLowerPrice,
                 projectionEndBar,
                 projectedLowerPrice,
                 wedgeColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(projectedLowerBoundary)
                linesDrawn += 1

        string secondUpperText =
             "U2" +
             "\n" +
             candidate.name +
             "\n" +
             f_wedgeStatus(candidate)

        label firstUpperLabel = f_addPatternPointLabel(
             firstUpperBar,
             firstUpperPrice,
             "U1",
             wedgeColour,
             true
        )

        label secondUpperLabel = f_addPatternPointLabel(
             secondUpperBar,
             secondUpperPrice,
             secondUpperText,
             wedgeColour,
             true
        )

        label firstLowerLabel = f_addPatternPointLabel(
             firstLowerBar,
             firstLowerPrice,
             "L1",
             wedgeColour,
             false
        )

        label secondLowerLabel = f_addPatternPointLabel(
             secondLowerBar,
             secondLowerPrice,
             "L2",
             wedgeColour,
             false
        )

        if apexAvailable and calculatedApexBar <= maximumProjectionBar
            float apexPrice = f_lineValue(
                 firstUpperBar,
                 firstUpperPrice,
                 secondUpperBar,
                 secondUpperPrice,
                 calculatedApexBar
            )

            label apexLabel = f_addPatternPointLabel(
                 calculatedApexBar,
                 apexPrice,
                 "APEX",
                 wedgeColour,
                 true
            )

    linesDrawn
    // =============================================================================
// SECTION 27 — CUP AND HANDLE VALIDATION TOOLS
// =============================================================================

string GROUP_CUP_HANDLE = "13. Cup and Handle"

minimumCupBars = input.int(
     20,
     "Minimum cup length",
     minval = 10,
     maxval = 300,
     group = GROUP_CUP_HANDLE
)

maximumCupBars = input.int(
     200,
     "Maximum cup length",
     minval = 40,
     maxval = 500,
     group = GROUP_CUP_HANDLE
)

cupRimToleranceATR = input.float(
     0.40,
     "Cup rim tolerance — ATR",
     minval = 0.05,
     maxval = 2.0,
     step = 0.05,
     group = GROUP_CUP_HANDLE
)

minimumCupBasePosition = input.float(
     0.25,
     "Earliest cup-base position",
     minval = 0.10,
     maxval = 0.45,
     step = 0.05,
     group = GROUP_CUP_HANDLE
)

maximumCupBasePosition = input.float(
     0.75,
     "Latest cup-base position",
     minval = 0.55,
     maxval = 0.90,
     step = 0.05,
     group = GROUP_CUP_HANDLE
)

minimumHandleBars = input.int(
     3,
     "Minimum handle length",
     minval = 2,
     maxval = 50,
     group = GROUP_CUP_HANDLE
)

maximumHandleBars = input.int(
     40,
     "Maximum handle length",
     minval = 5,
     maxval = 150,
     group = GROUP_CUP_HANDLE
)

maximumHandleRetracement = input.float(
     0.50,
     "Maximum handle retracement",
     minval = 0.10,
     maxval = 0.80,
     step = 0.05,
     group = GROUP_CUP_HANDLE
)


// Confirm that the left and right rims occupy the same price area.
f_cupRimsMatch(
     float leftRimPrice,
     float rightRimPrice
) =>
    float rimTolerance = math.max(
         atrValue *
         cupRimToleranceATR,
         syminfo.mintick
    )

    math.abs(
         leftRimPrice -
         rightRimPrice
    ) <= rimTolerance


// Measure the price similarity of the two cup rims.
f_cupRimQuality(
     float leftRimPrice,
     float rightRimPrice
) =>
    float rimTolerance = math.max(
         atrValue *
         cupRimToleranceATR,
         syminfo.mintick
    )

    float rimDifference = math.abs(
         leftRimPrice -
         rightRimPrice
    )

    math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              rimDifference /
              rimTolerance
         )
    )


// Calculate the complete Cup-and-Handle quality.
f_cupHandleQuality(
     float leftRimPrice,
     float rightRimPrice,
     float cupDepth,
     float cupBasePosition,
     float handleRetracement
) =>
    float rimQuality =
         f_cupRimQuality(
              leftRimPrice,
              rightRimPrice
         )

    float basePositionQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              math.abs(
                   cupBasePosition -
                   0.50
              ) /
              0.50
         )
    )

    float depthQuality = math.min(
         1.0,
         cupDepth /
         math.max(
              minimumPatternHeight * 2.0,
              syminfo.mintick
         )
    )

    float handleQuality = math.max(
         0.0,
         math.min(
              1.0,
              1.0 -
              handleRetracement /
              math.max(
                   maximumHandleRetracement,
                   0.01
              )
         )
    )

    math.max(
         0.0,
         math.min(
              1.0,
              rimQuality * 0.35 +
              basePositionQuality * 0.25 +
              depthQuality * 0.20 +
              handleQuality * 0.20
         )
    )
    // =============================================================================
// SECTION 28 — CUP AND HANDLE DETECTION
// =============================================================================

// Detect a bullish Cup and Handle.
//
// Stored geometry:
// Point 1 = left rim
// Point 2 = left curved section
// Point 3 = cup base
// Point 4 = right curved section
// Point 5 = right rim
// Point 6 = handle low
// Point 7 = current developing or breakout position
f_detectCupAndHandle() =>
    PatternCandidate result =
         f_emptyCandidate()

    int availableHighs =
         array.size(pivotHighPrices)

    int availableLows =
         array.size(pivotLowPrices)

    if detectCupHandle and availableHighs >= 2 and availableLows >= 2
        float leftRimPrice =
             f_pivotHigh(1)

        int leftRimBar =
             f_pivotHighBar(1)

        float rightRimPrice =
             f_pivotHigh(0)

        int rightRimBar =
             f_pivotHighBar(0)

        bool rimPricesAvailable =
             not na(leftRimPrice) and
             not na(rightRimPrice)

        bool rimBarsAvailable =
             not na(leftRimBar) and
             not na(rightRimBar)

        if rimPricesAvailable and rimBarsAvailable
            int cupBars =
                 rightRimBar -
                 leftRimBar

            bool rimOrderValid =
                 leftRimBar <
                 rightRimBar

            bool cupLengthValid =
                 cupBars >= minimumCupBars and
                 cupBars <= maximumCupBars

            bool rimsMatch =
                 f_cupRimsMatch(
                      leftRimPrice,
                      rightRimPrice
                 )

            if rimOrderValid and cupLengthValid and rimsMatch
                PatternPivot cupBase =
                     f_lowestPivotLowBetween(
                          leftRimBar,
                          rightRimBar
                     )

                PatternPivot handleLow =
                     f_lowestPivotLowFrom(
                          rightRimBar + 1
                     )

                bool requiredLowsValid =
                     cupBase.valid and
                     handleLow.valid

                if requiredLowsValid
                    int handleBars =
                         handleLow.pivotBar -
                         rightRimBar

                    bool handleLengthValid =
                         handleBars >= minimumHandleBars and
                         handleBars <= maximumHandleBars

                    float cupBasePosition =
                         float(
                              cupBase.pivotBar -
                              leftRimBar
                         ) /
                         math.max(
                              1.0,
                              float(cupBars)
                         )

                    bool cupBasePositionValid =
                         cupBasePosition >= minimumCupBasePosition and
                         cupBasePosition <= maximumCupBasePosition

                    float averageRimPrice =
                         (
                              leftRimPrice +
                              rightRimPrice
                         ) /
                         2.0

                    float breakoutLevel = math.max(
                         leftRimPrice,
                         rightRimPrice
                    )

                    float cupDepth =
                         averageRimPrice -
                         cupBase.pivotPrice

                    bool cupDepthValid =
                         cupDepth >=
                         minimumPatternHeight

                    bool handleRemainsAboveBase =
                         handleLow.pivotPrice >
                         cupBase.pivotPrice

                    float handleRetracement =
                         (
                              breakoutLevel -
                              handleLow.pivotPrice
                         ) /
                         math.max(
                              cupDepth,
                              syminfo.mintick
                         )

                    bool handleRetracementValid =
                         handleRetracement >= 0.03 and
                         handleRetracement <= maximumHandleRetracement

                    bool completeCupHandleValid =
                         handleLengthValid and
                         cupBasePositionValid and
                         cupDepthValid and
                         handleRemainsAboveBase and
                         handleRetracementValid

                    if completeCupHandleValid
                        int leftCurveBar =
                             int(
                                  math.round(
                                       (
                                            float(leftRimBar) +
                                            float(cupBase.pivotBar)
                                       ) /
                                       2.0
                                  )
                             )

                        int rightCurveBar =
                             int(
                                  math.round(
                                       (
                                            float(cupBase.pivotBar) +
                                            float(rightRimBar)
                                       ) /
                                       2.0
                                  )
                             )

                        float leftCurvePrice =
                             cupBase.pivotPrice +
                             (
                                  leftRimPrice -
                                  cupBase.pivotPrice
                             ) *
                             0.35

                        float rightCurvePrice =
                             cupBase.pivotPrice +
                             (
                                  rightRimPrice -
                                  cupBase.pivotPrice
                             ) *
                             0.35

                        bool curveBarsValid =
                             leftCurveBar >
                             leftRimBar and
                             leftCurveBar <
                             cupBase.pivotBar and
                             rightCurveBar >
                             cupBase.pivotBar and
                             rightCurveBar <
                             rightRimBar

                        if curveBarsValid
                            float patternQuality =
                                 f_cupHandleQuality(
                                      leftRimPrice,
                                      rightRimPrice,
                                      cupDepth,
                                      cupBasePosition,
                                      handleRetracement
                                 )

                            int patternReadyBar =
                                 handleLow.pivotBar +
                                 pivotLength

                            result := f_createCandidate(
                                 "CUP AND HANDLE",
                                 8,
                                 1,
                                 leftRimBar,
                                 patternReadyBar,
                                 breakoutLevel,
                                 na,
                                 breakoutLevel,
                                 cupBase.pivotPrice,
                                 cupDepth,
                                 patternQuality,
                                 handleLow.pivotPrice,
                                 na
                            )

                            result := f_setPatternPoint(
                                 result,
                                 1,
                                 leftRimBar,
                                 leftRimPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 2,
                                 leftCurveBar,
                                 leftCurvePrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 3,
                                 cupBase.pivotBar,
                                 cupBase.pivotPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 4,
                                 rightCurveBar,
                                 rightCurvePrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 5,
                                 rightRimBar,
                                 rightRimPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 6,
                                 handleLow.pivotBar,
                                 handleLow.pivotPrice
                            )

                            result := f_setPatternPoint(
                                 result,
                                 7,
                                 bar_index,
                                 close
                            )

    result
    // =============================================================================
// SECTION 29 — FULL CUP AND HANDLE VISUALS
// =============================================================================

cupHandleProjectionBars = input.int(
     30,
     "Cup-and-Handle breakout projection",
     minval = 5,
     maxval = 150,
     group = GROUP_CUP_HANDLE
)


// Return the current Cup-and-Handle state.
f_cupHandleStatus(
     PatternCandidate candidate
) =>
    string cupStatus = "FORMING"

    if close >
         candidate.upperTrigger +
         levelTolerance
        cupStatus := "BULLISH BREAKOUT"
    else if close <
         candidate.bullishStop -
         levelTolerance
        cupStatus := "INVALIDATED"

    cupStatus


// Draw the complete Cup-and-Handle.
//
// Points 1–5 form the rounded cup.
// Point 5 → Point 6 forms the handle.
// Point 6 → Point 7 forms the developing or breakout leg.
f_drawCupHandlePattern(
     PatternCandidate candidate
) =>
    int linesDrawn = 0

    bool recognisedCupHandle =
         candidate.name == "CUP AND HANDLE"

    if candidate.valid and recognisedCupHandle
        color cupColour =
             f_candidateColour(candidate)

        // Draw the four connected sections forming the rounded cup.
        for pointNumber = 1 to 4
            int firstPointBar =
                 f_patternPointBar(
                      candidate,
                      pointNumber
                 )

            float firstPointPrice =
                 f_patternPointPrice(
                      candidate,
                      pointNumber
                 )

            int secondPointBar =
                 f_patternPointBar(
                      candidate,
                      pointNumber + 1
                 )

            float secondPointPrice =
                 f_patternPointPrice(
                      candidate,
                      pointNumber + 1
                 )

            line cupCurveSegment = f_addPatternLine(
                 firstPointBar,
                 firstPointPrice,
                 secondPointBar,
                 secondPointPrice,
                 cupColour,
                 patternLineWidth,
                 line.style_solid
            )

            if not na(cupCurveSegment)
                linesDrawn += 1

        int leftRimBar =
             f_patternPointBar(
                  candidate,
                  1
             )

        float leftRimPrice =
             f_patternPointPrice(
                  candidate,
                  1
             )

        int cupBaseBar =
             f_patternPointBar(
                  candidate,
                  3
             )

        float cupBasePrice =
             f_patternPointPrice(
                  candidate,
                  3
             )

        int rightRimBar =
             f_patternPointBar(
                  candidate,
                  5
             )

        float rightRimPrice =
             f_patternPointPrice(
                  candidate,
                  5
             )

        int handleLowBar =
             f_patternPointBar(
                  candidate,
                  6
             )

        float handleLowPrice =
             f_patternPointPrice(
                  candidate,
                  6
             )

        int developingBar =
             f_patternPointBar(
                  candidate,
                  7
             )

        float developingPrice =
             f_patternPointPrice(
                  candidate,
                  7
             )

        // Draw the handle from the right rim to the handle low.
        line handlePullbackLine = f_addPatternLine(
             rightRimBar,
             rightRimPrice,
             handleLowBar,
             handleLowPrice,
             cupColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(handlePullbackLine)
            linesDrawn += 1

        // Draw the live recovery or breakout leg.
        if showDevelopingLeg
            line developingBreakoutLine = f_addPatternLine(
                 handleLowBar,
                 handleLowPrice,
                 developingBar,
                 developingPrice,
                 cupColour,
                 patternLineWidth,
                 line.style_dashed
            )

            if not na(developingBreakoutLine)
                linesDrawn += 1

        int breakoutProjectionEnd =
             bar_index +
             cupHandleProjectionBars

        // Draw the rim breakout level.
        line breakoutLevelLine = f_addPatternLevel(
             leftRimBar,
             breakoutProjectionEnd,
             candidate.upperTrigger,
             necklineColour,
             patternLineWidth,
             line.style_solid
        )

        if not na(breakoutLevelLine)
            linesDrawn += 1

        string handleLabelText =
             "HANDLE" +
             "\n" +
             candidate.name +
             "\n" +
             f_cupHandleStatus(candidate)

        label leftRimLabel = f_addPatternPointLabel(
             leftRimBar,
             leftRimPrice,
             "LEFT RIM",
             cupColour,
             true
        )

        label cupBaseLabel = f_addPatternPointLabel(
             cupBaseBar,
             cupBasePrice,
             "CUP BASE",
             cupColour,
             false
        )

        label rightRimLabel = f_addPatternPointLabel(
             rightRimBar,
             rightRimPrice,
             "RIGHT RIM",
             cupColour,
             true
        )

        label handleLabel = f_addPatternPointLabel(
             handleLowBar,
             handleLowPrice,
             handleLabelText,
             cupColour,
             false
        )

    linesDrawn
    // =============================================================================

// =============================================================================
// SECTION 30 — FINAL PATTERN CONTROL, TRADE PLAN AND DASHBOARD
// =============================================================================

// -----------------------------------------------------------------------------
// SECTION 30 SETTINGS
// -----------------------------------------------------------------------------

int maximumVisiblePatterns = input.int(
     4,
     "Maximum visible chart patterns",
     minval = 1,
     maxval = 8,
     group = GROUP_VISUALS
)

bool showPatternDashboard = input.bool(
     true,
     "Show pattern dashboard",
     group = GROUP_VISUALS
)


// -----------------------------------------------------------------------------
// PERSISTENT PATTERN STORAGE
// -----------------------------------------------------------------------------

var array<PatternCandidate> storedPatternHistory =
     array.new<PatternCandidate>()

var array<string> storedPatternKeys =
     array.new_string()


// -----------------------------------------------------------------------------
// DASHBOARD
// The table must be declared before any function refers to it.
// -----------------------------------------------------------------------------

var table section30Dashboard =
     table.new(
          position.bottom_right,
          2,
          13,
          border_width = 1,
          border_color = color.rgb(80, 85, 95),
          frame_width = 1,
          frame_color = color.rgb(80, 85, 95)
     )


// -----------------------------------------------------------------------------
// PATTERN IDENTITY
// -----------------------------------------------------------------------------

f_section30PatternKey(
     PatternCandidate candidate
) =>
    candidate.name +
         "|" +
         str.tostring(candidate.startBar) +
         "|" +
         str.tostring(candidate.readyBar)


// -----------------------------------------------------------------------------
// PATTERN AGE CHECK
// -----------------------------------------------------------------------------

f_section30PatternCurrent(
     PatternCandidate candidate
) =>
    bool patternCurrent = false

    if (
         candidate.valid and
         not na(candidate.startBar) and
         not na(candidate.readyBar)
    )
        int patternAge =
             bar_index - candidate.readyBar

        patternCurrent :=
             patternAge >= 0 and
             patternAge <= maximumPatternAge

    patternCurrent


// -----------------------------------------------------------------------------
// STORE ONLY THE STRONGEST NON-DUPLICATE PATTERN
// -----------------------------------------------------------------------------

f_section30StorePattern(
     PatternCandidate candidate
) =>
    int storedCount =
         array.size(storedPatternHistory)

    if (
         candidate.valid and
         not na(candidate.startBar) and
         not na(candidate.readyBar)
    )
        string candidateKey =
             f_section30PatternKey(candidate)

        int exactIndex =
             array.indexof(
                  storedPatternKeys,
                  candidateKey
             )

        if exactIndex >= 0
            array.set(
                 storedPatternHistory,
                 exactIndex,
                 candidate
            )

        else
            bool candidateHandled = false

            if storedCount > 0
                int latestIndex =
                     storedCount - 1

                PatternCandidate latestCandidate =
                     array.get(
                          storedPatternHistory,
                          latestIndex
                     )

                bool sameFormationWindow =
                     candidate.startBar <=
                          latestCandidate.readyBar + pivotLength and
                     candidate.readyBar >=
                          latestCandidate.startBar - pivotLength

                bool samePatternType =
                     candidate.name ==
                          latestCandidate.name

                if sameFormationWindow
                    bool replaceLatest =
                         samePatternType or
                         candidate.quality >
                              latestCandidate.quality

                    if replaceLatest
                        array.set(
                             storedPatternHistory,
                             latestIndex,
                             candidate
                        )

                        array.set(
                             storedPatternKeys,
                             latestIndex,
                             candidateKey
                        )

                    candidateHandled := true

            if not candidateHandled
                array.push(
                     storedPatternHistory,
                     candidate
                )

                array.push(
                     storedPatternKeys,
                     candidateKey
                )

                if (
                     array.size(storedPatternHistory) >
                     maximumVisiblePatterns
                )
                    array.shift(storedPatternHistory)
                    array.shift(storedPatternKeys)

        storedCount :=
             array.size(storedPatternHistory)

    storedCount


// -----------------------------------------------------------------------------
// RETURN THE MOST RECENT STORED PATTERN
// -----------------------------------------------------------------------------

f_section30LatestStoredPattern() =>
    PatternCandidate latestPattern =
         f_emptyCandidate()

    int historyCount =
         array.size(storedPatternHistory)

    if historyCount > 0
        latestPattern :=
             array.get(
                  storedPatternHistory,
                  historyCount - 1
             )

    latestPattern


// -----------------------------------------------------------------------------
// ROUTE EACH PATTERN TO ITS CORRECT RENDERER
// -----------------------------------------------------------------------------

f_section30DrawPattern(
     PatternCandidate candidate
) =>
    int renderedObjects = 0

    if (
         candidate.name == "DOUBLE BOTTOM" or
         candidate.name == "DOUBLE TOP"
    )
        renderedObjects +=
             f_drawDoublePattern(candidate)

    else if (
         candidate.name == "TRIPLE BOTTOM" or
         candidate.name == "TRIPLE TOP"
    )
        renderedObjects +=
             f_drawTriplePattern(candidate)

    else if (
         candidate.name == "HEAD AND SHOULDERS" or
         candidate.name == "INVERSE HEAD AND SHOULDERS"
    )
        renderedObjects +=
             f_drawHeadShouldersPattern(candidate)

    else if candidate.name == "RECTANGLE"
        renderedObjects +=
             f_drawRectanglePattern(candidate)

    else if (
         candidate.name == "ASCENDING TRIANGLE" or
         candidate.name == "DESCENDING TRIANGLE" or
         candidate.name == "SYMMETRICAL TRIANGLE"
    )
        renderedObjects +=
             f_drawTrianglePattern(candidate)

    else if (
         candidate.name == "BULL FLAG" or
         candidate.name == "BEAR FLAG"
    )
        renderedObjects +=
             f_drawFlagPattern(candidate)

    else if (
         candidate.name == "BULL PENNANT" or
         candidate.name == "BEAR PENNANT"
    )
        renderedObjects +=
             f_drawPennantPattern(candidate)

    else if (
         candidate.name == "RISING WEDGE" or
         candidate.name == "FALLING WEDGE"
    )
        renderedObjects +=
             f_drawWedgePattern(candidate)

    else if candidate.name == "CUP AND HANDLE"
        renderedObjects +=
             f_drawCupHandlePattern(candidate)

    renderedObjects


// -----------------------------------------------------------------------------
// DASHBOARD TEXT HELPERS
// -----------------------------------------------------------------------------

f_section30PriceText(
     float priceValue
) =>
    na(priceValue) ?
         "-" :
         str.tostring(
              priceValue,
              format.mintick
         )


f_section30DirectionText(
     PatternCandidate candidate
) =>
    candidate.direction > 0 ?
         "BULLISH" :
         candidate.direction < 0 ?
              "BEARISH" :
              "WAITING FOR BREAKOUT"


f_section30StatusText(
     PatternCandidate candidate,
     PatternTradePlan tradePlan
) =>
    not candidate.valid ?
         "NO VALID SETUP" :
         tradePlan.valid ?
              "TRADE PLAN READY" :
              "PATTERN FORMING"


f_section30DashboardCell(
     int columnNumber,
     int rowNumber,
     string cellText,
     color backgroundColour,
     color textColour
) =>
    table.cell(
         section30Dashboard,
         columnNumber,
         rowNumber,
         cellText,
         bgcolor = backgroundColour,
         text_color = textColour,
         text_size = size.small
    )

    0


// -----------------------------------------------------------------------------
// RUN EVERY DETECTOR ON EVERY BAR
// -----------------------------------------------------------------------------

PatternCandidate doubleBottomCandidate =
     f_detectDoubleBottom()

PatternCandidate doubleTopCandidate =
     f_detectDoubleTop()

PatternCandidate tripleBottomCandidate =
     f_detectTripleBottom()

PatternCandidate tripleTopCandidate =
     f_detectTripleTop()

PatternCandidate headShouldersCandidate =
     f_detectHeadAndShoulders()

PatternCandidate inverseHeadShouldersCandidate =
     f_detectInverseHeadAndShoulders()

PatternCandidate rectangleCandidate =
     f_detectRectangle()

PatternCandidate triangleCandidate =
     f_detectTriangle()

PatternCandidate bullFlagCandidate =
     f_detectFlag(1)

PatternCandidate bearFlagCandidate =
     f_detectFlag(-1)

PatternCandidate bullPennantCandidate =
     f_detectPennant(1)

PatternCandidate bearPennantCandidate =
     f_detectPennant(-1)

PatternCandidate wedgeCandidate =
     f_detectWedge()

PatternCandidate cupHandleCandidate =
     f_detectCupAndHandle()


// -----------------------------------------------------------------------------
// CLEAR AND REBUILD THE CURRENT CANDIDATE REGISTRY
// -----------------------------------------------------------------------------

int clearedCandidateRegistry =
     f_clearCandidateRegistry(
          detectedCandidates
     )

int registeredDoubleBottom =
     f_registerCandidate(
          detectedCandidates,
          doubleBottomCandidate,
          detectDoublePatterns and
          f_section30PatternCurrent(doubleBottomCandidate)
     )

int registeredDoubleTop =
     f_registerCandidate(
          detectedCandidates,
          doubleTopCandidate,
          detectDoublePatterns and
          f_section30PatternCurrent(doubleTopCandidate)
     )

int registeredTripleBottom =
     f_registerCandidate(
          detectedCandidates,
          tripleBottomCandidate,
          detectTriplePatterns and
          f_section30PatternCurrent(tripleBottomCandidate)
     )

int registeredTripleTop =
     f_registerCandidate(
          detectedCandidates,
          tripleTopCandidate,
          detectTriplePatterns and
          f_section30PatternCurrent(tripleTopCandidate)
     )

int registeredHeadShoulders =
     f_registerCandidate(
          detectedCandidates,
          headShouldersCandidate,
          detectHeadShoulders and
          f_section30PatternCurrent(headShouldersCandidate)
     )

int registeredInverseHeadShoulders =
     f_registerCandidate(
          detectedCandidates,
          inverseHeadShouldersCandidate,
          detectHeadShoulders and
          f_section30PatternCurrent(inverseHeadShouldersCandidate)
     )

int registeredRectangle =
     f_registerCandidate(
          detectedCandidates,
          rectangleCandidate,
          detectRectangles and
          f_section30PatternCurrent(rectangleCandidate)
     )

int registeredTriangle =
     f_registerCandidate(
          detectedCandidates,
          triangleCandidate,
          (
               detectDirectionalTriangles or
               detectSymmetricalTriangles
          ) and
          f_section30PatternCurrent(triangleCandidate)
     )

int registeredBullFlag =
     f_registerCandidate(
          detectedCandidates,
          bullFlagCandidate,
          detectFlags and
          f_section30PatternCurrent(bullFlagCandidate)
     )

int registeredBearFlag =
     f_registerCandidate(
          detectedCandidates,
          bearFlagCandidate,
          detectFlags and
          f_section30PatternCurrent(bearFlagCandidate)
     )

int registeredBullPennant =
     f_registerCandidate(
          detectedCandidates,
          bullPennantCandidate,
          detectPennants and
          f_section30PatternCurrent(bullPennantCandidate)
     )

int registeredBearPennant =
     f_registerCandidate(
          detectedCandidates,
          bearPennantCandidate,
          detectPennants and
          f_section30PatternCurrent(bearPennantCandidate)
     )

int registeredWedge =
     f_registerCandidate(
          detectedCandidates,
          wedgeCandidate,
          detectWedges and
          f_section30PatternCurrent(wedgeCandidate)
     )

int registeredCupHandle =
     f_registerCandidate(
          detectedCandidates,
          cupHandleCandidate,
          detectCupHandle and
          f_section30PatternCurrent(cupHandleCandidate)
     )


// -----------------------------------------------------------------------------
// SELECT THE STRONGEST CURRENT PATTERN
// -----------------------------------------------------------------------------

PatternCandidate currentPrimaryCandidate =
     f_getStrongestCandidate(
          detectedCandidates
     )


// Store only the strongest current classification.
int storedPrimaryPattern =
     f_section30StorePattern(
          currentPrimaryCandidate
     )


// Use the strongest current candidate.
// If none exists, retain the most recent eligible stored candidate.
PatternCandidate displayedCandidate =
     currentPrimaryCandidate

if not displayedCandidate.valid
    PatternCandidate recentStoredCandidate =
         f_section30LatestStoredPattern()

    if f_section30PatternCurrent(recentStoredCandidate)
        displayedCandidate :=
             recentStoredCandidate


// -----------------------------------------------------------------------------
// BUILD ENTRY, STOP LOSS AND TARGETS
// -----------------------------------------------------------------------------

PatternTradePlan displayedTradePlan =
     f_buildTradePlan(
          displayedCandidate
     )


// -----------------------------------------------------------------------------
// FINAL CHART OUTPUT
// -----------------------------------------------------------------------------

if barstate.islast
    f_clearPatternGeometry()
    f_clearTradePlanGeometry()

    int renderedPatternObjects = 0

    int storedPatternCount =
         array.size(storedPatternHistory)

    if storedPatternCount > 0
        for patternIndex = 0 to storedPatternCount - 1
            PatternCandidate storedCandidate =
                 array.get(
                      storedPatternHistory,
                      patternIndex
                 )

            if f_section30PatternCurrent(storedCandidate)
                renderedPatternObjects +=
                     f_section30DrawPattern(
                          storedCandidate
                     )

    int renderedTradePlanObjects = 0

    if (
         displayedCandidate.valid and
         displayedTradePlan.valid
    )
        renderedTradePlanObjects +=
             f_drawTradePlan(
                  displayedCandidate,
                  displayedTradePlan
             )


// -----------------------------------------------------------------------------
// DASHBOARD OUTPUT
// -----------------------------------------------------------------------------

if barstate.islast
    if showPatternDashboard
        color headerColour =
             color.rgb(0, 188, 212)

        color labelColour =
             color.rgb(45, 50, 60)

        color valueColour =
             color.rgb(31, 35, 44)

        color positiveColour =
             color.rgb(0, 190, 100)

        color warningColour =
             color.rgb(255, 193, 7)

        color negativeColour =
             color.rgb(255, 45, 85)

        color statusColour =
             not displayedCandidate.valid ?
                  negativeColour :
                  displayedTradePlan.valid ?
                       positiveColour :
                       warningColour

        string displayedPatternName =
             displayedCandidate.valid ?
                  displayedCandidate.name :
                  "NONE"

        string displayedQuality =
             displayedCandidate.valid ?
                  str.tostring(
                       int(
                            math.round(
                                 displayedCandidate.quality * 100.0
                            )
                       )
                  ) + "%" :
                  "-"

        f_section30DashboardCell(
             0,
             0,
             "UNIVERSAL PATTERN ENGINE",
             headerColour,
             color.black
        )

        f_section30DashboardCell(
             1,
             0,
             timeframe.period,
             headerColour,
             color.black
        )

        f_section30DashboardCell(
             0,
             1,
             "VERDICT",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             1,
             f_section30StatusText(
                  displayedCandidate,
                  displayedTradePlan
             ),
             statusColour,
             color.white
        )

        f_section30DashboardCell(
             0,
             2,
             "PATTERN",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             2,
             displayedPatternName,
             valueColour,
             color.white
        )

        f_section30DashboardCell(
             0,
             3,
             "DIRECTION",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             3,
             displayedCandidate.valid ?
                  f_section30DirectionText(displayedCandidate) :
                  "-",
             valueColour,
             color.white
        )

        f_section30DashboardCell(
             0,
             4,
             "QUALITY",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             4,
             displayedQuality,
             valueColour,
             color.white
        )

        f_section30DashboardCell(
             0,
             5,
             "LIVE CANDIDATES",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             5,
             str.tostring(
                  array.size(detectedCandidates)
             ),
             valueColour,
             color.white
        )

        f_section30DashboardCell(
             0,
             6,
             "ENTRY",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             6,
             displayedTradePlan.valid ?
                  f_section30PriceText(displayedTradePlan.entry) :
                  "-",
             valueColour,
             color.rgb(70, 130, 255)
        )

        f_section30DashboardCell(
             0,
             7,
             "STOP LOSS",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             7,
             displayedTradePlan.valid ?
                  f_section30PriceText(displayedTradePlan.stop) :
                  "-",
             valueColour,
             negativeColour
        )

        f_section30DashboardCell(
             0,
             8,
             "TP1",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             8,
             displayedTradePlan.valid ?
                  f_section30PriceText(displayedTradePlan.target1) :
                  "-",
             valueColour,
             positiveColour
        )

        f_section30DashboardCell(
             0,
             9,
             "TP2",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             9,
             displayedTradePlan.valid ?
                  f_section30PriceText(displayedTradePlan.target2) :
                  "-",
             valueColour,
             positiveColour
        )

        f_section30DashboardCell(
             0,
             10,
             "TP3",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             10,
             displayedTradePlan.valid ?
                  f_section30PriceText(displayedTradePlan.target3) :
                  "-",
             valueColour,
             positiveColour
        )

        f_section30DashboardCell(
             0,
             11,
             "RISK",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             11,
             displayedTradePlan.valid ?
                  f_section30PriceText(displayedTradePlan.risk) :
                  "-",
             valueColour,
             color.white
        )

        f_section30DashboardCell(
             0,
             12,
             "STORED PATTERNS",
             labelColour,
             color.white
        )

        f_section30DashboardCell(
             1,
             12,
             str.tostring(
                  array.size(storedPatternHistory)
             ),
             valueColour,
             color.white
        )

    else
        table.clear(
             section30Dashboard,
             0,
             0,
             1,
             12
        )