     group = GROUP_VISUALS
)

entryColour = input.color(
     color.rgb(41, 98, 255),
     "Entry colour",
     group = GROUP_VISUALS
)

stopColour = input.color(
     color.rgb(255, 23, 68),
     "Stop-loss colour",
     group = GROUP_VISUALS
)

targetColour = input.color(
     color.rgb(0, 200, 83),
