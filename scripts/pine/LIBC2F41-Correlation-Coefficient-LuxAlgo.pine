//@version=6
indicator("Correlation Coefficient", "CC", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
PRIMARY_COLOR = #5b9cf6
NEUTRAL_COLOR = #787b86
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
symbolInput = input.symbol("SP:SPX", "Symbol", group = "Settings", tooltip = "Symbol whose correlation with the chart symbol is measured.")
lengthInput = input.int(20, "Length", minval = 2, group = "Settings", tooltip = "Number of bars in the rolling correlation window.")
srcInput    = input.source(close, "Source", group = "Settings", tooltip = "Price series used for both the chart symbol and the compared symbol.")
useLogInput = input.bool(false, "Use Log Returns", group = "Settings", tooltip = "Correlate bar-to-bar logarithmic returns instead of raw source values.")

corColorInput   = input.color(PRIMARY_COLOR, "Correlation", group = "Style", tooltip = "Color of the correlation line and its area fill.")
levelColorInput = input.color(NEUTRAL_COLOR, "Levels", group = "Style", tooltip = "Color of the +1, zero and -1 reference levels.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
otherSrc = request.security(symbolInput, timeframe.period, srcInput)

chartSeries = useLogInput ? math.log(srcInput / srcInput[1]) : srcInput
otherSeries = useLogInput ? math.log(otherSrc / otherSrc[1]) : otherSrc

correlation = ta.correlation(chartSeries, otherSeries, lengthInput)

crossUp   = ta.crossover(correlation, 0)
crossDown = ta.crossunder(correlation, 0)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(correlation, "Correlation Area", color.new(corColorInput, 80), 1, plot.style_area)
plot(correlation, "Correlation", corColorInput)

hline(1, "Upper Level", levelColorInput, hline.style_dotted)
hline(0, "Zero Level", levelColorInput, hline.style_dotted)
hline(-1, "Lower Level", levelColorInput, hline.style_dotted)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Zero Cross Up", "Correlation crossed above zero")
alertcondition(crossDown, "Zero Cross Down", "Correlation crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
