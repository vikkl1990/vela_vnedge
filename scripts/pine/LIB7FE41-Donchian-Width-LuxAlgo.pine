//@version=6
indicator("Donchian Width", "Donchian Width", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

BULL_COLOR    = #089981                 // compression - the screenable narrow that precedes expansions
BEAR_COLOR    = #f23645                 // extreme width - stretched trend context, worse initial risk
NEUTRAL_COLOR = #787b86                 // width ranking between the two percentiles
SLOW_COLOR    = color.new(#787b86, 40)  // slow width is a structural reference
COMP_COLOR    = #089981
WIDE_COLOR    = #f23645

NORM_NONE  = 'None (Price Units)'
NORM_MID   = 'Channel Midline (%)'
NORM_CLOSE = 'Close (%)'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

fastLengthInput = input.int(20, 'Fast Length', minval = 2, group = 'Donchian Width'
  , tooltip = 'Lookback of the fast Donchian channel. Width is the highest high minus the lowest low over this window. 20 bars is the classic tactical window.')

showSlowInput   = input.bool(true, 'Slow Width', inline = 'slow', group = 'Donchian Width')
slowLengthInput = input.int(55, '', minval = 2, inline = 'slow', group = 'Donchian Width'
  , tooltip = 'Optional second span from a longer lookback. 55 bars is the classic campaign window; fast and slow together give a two-speed view of the ground price has covered.')

normInput = input.string(NORM_MID, 'Normalization', options = [NORM_NONE, NORM_MID, NORM_CLOSE], group = 'Donchian Width'
  , tooltip = 'Raw width is in price units. Dividing it by the channel midline or by the close expresses width as a percentage of price, making readings comparable across instruments and across time.')

rankLengthInput = input.int(100, 'Percentile Lookback', minval = 10, group = 'Compression & Expansion'
  , tooltip = 'Number of past bars the current width is ranked against. Narrow and wide are judged relative to the instrument\'s own recent history, not by absolute levels.')

compThresholdInput = input.float(20, 'Compression Percentile', minval = 0, maxval = 100, step = 1, group = 'Compression & Expansion'
  , tooltip = 'Width ranking at or below this percentile of its recent history is flagged as compression — the screenable narrow that precedes many expansions, though it schedules none.')

wideThresholdInput = input.float(80, 'Extreme Width Percentile', minval = 0, maxval = 100, step = 1, group = 'Compression & Expansion'
  , tooltip = 'Width ranking at or above this percentile is flagged as unusually wide — late, stretched trend context where fresh breakout entries carry worse initial risk.')

//Style
widthColorInput = input.color(NEUTRAL_COLOR, 'Fast Width', group = 'Style'
  , tooltip = 'Neutral tone of the fast width line and of its vertical gradient fill down to 0 while the width ranks between the two percentiles. Toward the compression percentile the line blends into the compression color, toward the extreme percentile into the extreme width color.')

slowColorInput = input.color(SLOW_COLOR, 'Slow Width', group = 'Style'
  , tooltip = 'Color of the slow width line.')

compHighlightInput = input.bool(true, 'Compression Highlight', inline = 'comp', group = 'Style')
compColorInput     = input.color(COMP_COLOR, '', inline = 'comp', group = 'Style'
  , tooltip = 'Shade the pane background while width sits at or below the compression percentile of its recent history.')

wideHighlightInput = input.bool(false, 'Extreme Width Highlight', inline = 'wide', group = 'Style')
wideColorInput     = input.color(WIDE_COLOR, '', inline = 'wide', group = 'Style'
  , tooltip = 'Shade the pane background while width sits at or above the extreme width percentile of its recent history.')

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

//Express raw width in the user-selected unit: price units, % of channel midline, or % of close
normalize(float rawWidth, float midline) =>
    switch normInput
        NORM_MID   => midline != 0 ? rawWidth / math.abs(midline) * 100 : na
        NORM_CLOSE => close   != 0 ? rawWidth / math.abs(close)   * 100 : na
        =>            rawWidth

//---------------------------------------------------------------------------------------------------------------------}
// Donchian Width
//---------------------------------------------------------------------------------------------------------------------{

//Fast channel extremes and span
upperFast = ta.highest(high, fastLengthInput)
lowerFast = ta.lowest(low, fastLengthInput)
rawFast   = upperFast - lowerFast

//Slow channel extremes and span
upperSlow = ta.highest(high, slowLengthInput)
lowerSlow = ta.lowest(low, slowLengthInput)
rawSlow   = upperSlow - lowerSlow

//Displayed series
widthFast = normalize(rawFast, math.avg(upperFast, lowerFast))
widthSlow = normalize(rawSlow, math.avg(upperSlow, lowerSlow))

//Rank of the fast width against its own recent history (0-100)
widthRank = ta.percentrank(widthFast, rankLengthInput)

//Step events: a fresh extreme printing while the span is growing
newHighBreak = not na(upperFast[1]) and high > upperFast[1]
newLowBreak  = not na(lowerFast[1]) and low  < lowerFast[1]
widthRising  = not na(rawFast[1])   and rawFast > rawFast[1]

expansionUp   = widthRising and newHighBreak
expansionDown = widthRising and newLowBreak

//Regimes judged by rank
isCompressed = not na(widthRank) and widthRank <= compThresholdInput
isExtreme    = not na(widthRank) and widthRank >= wideThresholdInput

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{

//State coloring by rank - compression color at or below the compression percentile, extreme width color at or above
//the extreme percentile, the neutral tone midway between them
midRank   = (compThresholdInput + wideThresholdInput) / 2
fastColor = na(widthRank) ? widthColorInput : widthRank <= midRank ? color.from_gradient(widthRank, compThresholdInput, midRank, compColorInput, widthColorInput) : color.from_gradient(widthRank, midRank, wideThresholdInput, widthColorInput, wideColorInput)

zeroPlotId = plot(0, 'Zero Line', color.new(chart.fg_color, 100), editable = false)
fastPlotId = plot(widthFast, 'Fast Width', fastColor, 1)

plot(showSlowInput ? widthSlow : na, 'Slow Width', slowColorInput, 1)

//Vertical gradient fill, fully transparent at 0, 50% at the width value, following the line color
fill(zeroPlotId, fastPlotId, widthFast, 0, color.new(fastColor, 50), color.new(fastColor, 100))

//Regime highlights
bgcolor(compHighlightInput and isCompressed ? color.new(compColorInput, 90) : na, title = 'Compression Highlight')
bgcolor(wideHighlightInput and isExtreme    ? color.new(wideColorInput, 90) : na, title = 'Extreme Width Highlight')

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

compressionStart   = isCompressed and not isCompressed[1]
extremeStart       = isExtreme    and not isExtreme[1]
expansionUpStart   = expansionUp   and not expansionUp[1]
expansionDownStart = expansionDown and not expansionDown[1]

alertcondition(compressionStart, 'Compression Start', 'Donchian width fell into the low percentiles of its recent history on {{ticker}} ({{interval}}) — compression regime')
alertcondition(expansionUpStart, 'Confirmed Expansion Up', 'Donchian width turned up as price cleared the upper channel extreme on {{ticker}} ({{interval}})')
alertcondition(expansionDownStart, 'Confirmed Expansion Down', 'Donchian width turned up as price cleared the lower channel extreme on {{ticker}} ({{interval}})')
alertcondition(extremeStart, 'Extreme Width', 'Donchian width reached the top percentiles of its recent history on {{ticker}} ({{interval}}) — stretched trend context')

//---------------------------------------------------------------------------------------------------------------------}
