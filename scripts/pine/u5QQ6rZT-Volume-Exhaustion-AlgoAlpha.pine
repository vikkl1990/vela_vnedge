//@version=5
indicator("Volume Exhaustion [AlgoAlpha]", "AlgoAlpha - 🔶 Volume Exhaustion", precision = 2)
len = input(50, "Calculation Length")
len2 = input(8, "Signal Length")
col = input.color(color.white, "Indicator Color")
col1 = input.color(color.gray, "Backgeound Color")
sv = ta.hma(volume, len)
ssv = ta.hma(sv, len)
f = sv-ssv
ff = (f) / (ta.ema(ta.highest(f, len) - ta.lowest(f, len), len)) * 100
fff = ff > 0 ? ff : 0

transpcon1 = 30
chg1 = fff*0.80
chg2 = fff*0.60
chg3 = fff*0.40
chg4 = fff*0.20

signal = ta.wma(fff, len2)
boundary = ta.cum(fff)/bar_index

plotchar(ta.crossunder(fff, fff[1]) and fff > boundary ? fff * 1.3 : na, title="Release", char="◆", location=location.absolute, color=color.orange, size=size.tiny)

plot(fff, color = color.new(col, transpcon1+60), style = plot.style_columns, linewidth = 4)
plot(chg1, color = color.new(col, transpcon1+55), style = plot.style_columns, linewidth = 4)
plot(chg2, color = color.new(col, transpcon1+45), style = plot.style_columns, linewidth = 4)
plot(chg3, color = color.new(col, transpcon1+30), style = plot.style_columns, linewidth = 4)
plot(chg4, color = color.new(col, transpcon1+25), style = plot.style_columns, linewidth = 4)
plot(fff, color = color.new(col, transpcon1))

bound = plot(boundary, display = display.none)
zero = plot(0, display = display.none)

fill(bound, zero, color.new(col1, 60))
bgcolor(color.new(col1, 80))