//@version=6
indicator("Ease of Movement", "EOM", overlay = false, format = format.volume)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // positive readings - price advancing easily
BEAR_COLOR    = #f23645 // negative readings - price declining easily
NEUTRAL_COLOR = #787b86 // zero line and readings exactly at zero

FILL_LINE_TRANSP = 50  // gradient transparency at the oscillator
FILL_ZERO_TRANSP = 100 // gradient transparency at the zero line
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput  = input.int(14, "Length", minval = 1, group = "Settings", tooltip = "Number of bars in the simple moving average smoothing the 1-bar Ease of Movement values.")
divisorInput = input.int(10000, "Divisor", minval = 1, group = "Settings", tooltip = "Volume scaling constant of the box ratio, larger values scale the oscillator up. 10000 is the conventional default.")

eomColorInput  = input.color(NEUTRAL_COLOR, "EOM Line", group = "Style", tooltip = "Color of the Ease of Movement line when it sits exactly at zero. Above and below zero the line takes the bullish and bearish colors.")
bullColorInput = input.color(BULL_COLOR, "Above Zero", inline = "state", group = "Style", tooltip = "Color of the line and fill while Ease of Movement is positive.")
bearColorInput = input.color(BEAR_COLOR, "Below Zero", inline = "state", group = "Style", tooltip = "Color of the line and fill while Ease of Movement is negative.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
hl2Change = ta.change(hl2)
eomRaw    = volume == 0 ? 0.0 : divisorInput * hl2Change * (high - low) / volume
eom       = ta.sma(eomRaw, lengthInput)

crossUp   = ta.crossover(eom, 0)
crossDown = ta.crossunder(eom, 0)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish above zero, bearish below, neutral exactly at zero
eomColor = eom > 0 ? bullColorInput : eom < 0 ? bearColorInput : eomColorInput

eomPlotId  = plot(eom, "EOM", eomColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

// Vertical gradient fill toward zero following the line color
fill(eomPlotId, zeroPlotId, top_value = math.max(eom, 0), bottom_value = math.min(eom, 0), top_color = eom > 0 ? color.new(eomColor, FILL_LINE_TRANSP) : color.new(eomColor, FILL_ZERO_TRANSP), bottom_color = eom > 0 ? color.new(eomColor, FILL_ZERO_TRANSP) : color.new(eomColor, FILL_LINE_TRANSP), title = "EOM Gradient")

hline(0, "Zero Line", color = NEUTRAL_COLOR, linestyle = hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp, "Bullish Zero Cross", "Ease of Movement crossed above zero")
alertcondition(crossDown, "Bearish Zero Cross", "Ease of Movement crossed below zero")
//----------------------------------------------------------------------------------------------------------------------}
