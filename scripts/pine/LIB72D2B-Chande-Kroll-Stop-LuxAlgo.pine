//@version=6
indicator("Chande Kroll Stop", "CKS", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
pInput = input.int(10, "ATR Length (P)", minval = 1, group = "Settings"
  , tooltip = "Lookback used for both the ATR and the highest high / lowest low price extremes")

xInput = input.float(1.0, "ATR Multiplier (X)", minval = 0, step = 0.1, group = "Settings"
  , tooltip = "Multiplier applied to the ATR to offset the preliminary stops from the price extremes")

qInput = input.int(9, "Stop Length (Q)", minval = 1, group = "Settings"
  , tooltip = "Lookback over which the preliminary stops are extended into the final stop levels")

stopShortColorInput = input.color(#f23645, "Stop Short", group = "Style"
  , tooltip = "Color of the protective stop line for short positions")

stopLongColorInput = input.color(#089981, "Stop Long", group = "Style"
  , tooltip = "Color of the protective stop line for long positions")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
atrValue = ta.atr(pInput)

firstHighStop = ta.highest(high, pInput) - xInput * atrValue
firstLowStop = ta.lowest(low, pInput) + xInput * atrValue

stopShort = ta.highest(firstHighStop, qInput)
stopLong = ta.lowest(firstLowStop, qInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(stopShort, "Stop Short", stopShortColorInput)

plot(stopLong, "Stop Long", stopLongColorInput)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
closeUnderLong = ta.crossunder(close, stopLong)
closeOverShort = ta.crossover(close, stopShort)

alertcondition(closeUnderLong, "Long Stop Hit", "Close crossed under the Chande Kroll long stop")

alertcondition(closeOverShort, "Short Stop Hit", "Close crossed over the Chande Kroll short stop")
//----------------------------------------------------------------------------------------------------------------------}
