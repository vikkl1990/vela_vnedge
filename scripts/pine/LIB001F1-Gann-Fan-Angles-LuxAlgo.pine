//@version=6
indicator("Gann Fan & Angles", "Gann Fan & Angles", overlay = true, format = format.price, max_lines_count = 25, max_labels_count = 25)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
MAX_WINDOW   = 1000
LABEL_OFFSET = 5

BULL_COLOR = #089981
BEAR_COLOR = #f23645

DASH_BG     = #161616
DASH_FRAME  = #2E2E2E
DASH_HEADER = #808080
DASH_TEXT   = #DBDBDB

// Classical fan set ordered steep -> shallow, each ratio expressed as price units per bar (2x1 = two units per bar, 1x2 = one unit per two bars)
var ratiosArr = array.from(8.0, 4.0, 3.0, 2.0, 1.0, 0.5, 1.0 / 3.0, 0.25, 0.125)
var namesArr  = array.from("8×1", "4×1", "3×1", "2×1", "1×1", "1×2", "1×3", "1×4", "1×8")
var ranksArr  = array.from(4, 3, 2, 1, 0, 1, 2, 3, 4)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
anchorModeInput = input.string("Auto", "Anchor Mode", options = ["Auto", "Manual"], group = "Anchor"
  , tooltip = "Where the fan originates. Auto anchors at the dominant swing inside the lookback window — the lowest low for a rising fan, the highest high for a falling one. Manual anchors at the time/price point selected on the chart when the indicator is added (editable below).")

lookbackInput = input.int(200, "Auto Swing Lookback", minval = 20, maxval = MAX_WINDOW, group = "Anchor"
  , tooltip = "Number of bars inspected to locate the auto anchor swing. A well-scaled fan shows past reactions spread across several angles — if all price action hugs one extreme line, adjust this window or the scale settings.")

directionInput = input.string("Auto", "Fan Direction", options = ["Auto", "Rising", "Falling"], group = "Anchor"
  , tooltip = "Rising projects the fan upward from a low, Falling downward from a high. Auto infers it: with an Auto anchor, from whether the window's extreme low precedes its extreme high; with a Manual anchor, from whether the anchor sits below or above the current price.")

manualTimeInput = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Manual Anchor Time", group = "Anchor", confirm = true
  , tooltip = "Time coordinate of the manual anchor, set by clicking the chart when the indicator is loaded. Edit it here to move the anchor to another pivot.")

manualPriceInput = input.price(0.0, "Manual Anchor Price", group = "Anchor", confirm = true
  , tooltip = "Price coordinate of the manual anchor — typically the exact swing low (rising fan) or swing high (falling fan).")

scaleModeInput = input.string("Auto (ATR)", "Scale Mode", options = ["Auto (ATR)", "Manual"], group = "Scale (1×1 Units per Bar)"
  , tooltip = "The scaling decision every Gann fan requires: how many price units the 1×1 advances per bar. Auto (ATR) derives the unit from the Average True Range at the anchor, so the 1×1 reflects the instrument's typical range per bar. Manual uses a fixed points-per-bar figure. Note that angles are defined by this rate, not by screen degrees — the 1×1 renders at 45° only when the chart is zoomed so one price unit occupies the same distance as one bar, so the on-screen slope changes with zoom and scale type while the levels and alerts do not.")

atrLengthInput = input.int(14, "ATR Length", minval = 1, group = "Scale (1×1 Units per Bar)"
  , tooltip = "Average True Range length used to derive the unit in Auto (ATR) mode. The ATR is sampled at the anchor bar, so the fan does not drift as current volatility changes.")

atrMultInput = input.float(1.0, "ATR Multiplier", minval = 0.05, step = 0.25, group = "Scale (1×1 Units per Bar)"
  , tooltip = "Multiplier applied to the ATR-derived unit. Raise it to steepen the whole fan, lower it to flatten it; tune until historical reactions distribute across several angles rather than hugging one line.")

manualUnitInput = input.float(1.0, "Manual Units per Bar", minval = 0, group = "Scale (1×1 Units per Bar)"
  , tooltip = "Price units the 1×1 gains (or loses) per bar in Manual scale mode, e.g. 0.5 means the 1×1 advances half a point every bar. Keep it fixed per instrument and timeframe so the fan is reproducible across charts and platforms. Values ≤ 0 fall back to the ATR-derived unit.")

show1Input = input.bool(true, "1×1 (balance line)", group = "Angles"
  , tooltip = "The 1×1 balance line — one price unit per bar, Gann's equilibrium between price and time. A trend holding above it reads as strong, one below it as weak. Its alerts remain available even when the line is hidden.")

show2Input = input.bool(true, "2×1 & 1×2", group = "Angles"
  , tooltip = "The first pair around the balance line: 2×1 gains two units per bar (steeper), 1×2 gains one unit per two bars (shallower). Their alerts remain available even when hidden.")

show3Input = input.bool(false, "3×1 & 1×3", group = "Angles"
  , tooltip = "The 3×1 and 1×3 angles of the classical nine-line fan. Disabled by default for a cleaner chart.")

show4Input = input.bool(false, "4×1 & 1×4", group = "Angles"
  , tooltip = "The 4×1 (four units per bar) and 1×4 (one unit per four bars) pair.")

show8Input = input.bool(false, "8×1 & 1×8", group = "Angles"
  , tooltip = "The 8×1 and 1×8 angles — the extreme steep and shallow edges of the classical fan.")

bullColorInput = input.color(BULL_COLOR, "Rising", inline = "fan", group = "Style"
  , tooltip = "Fan color when the fan rises from a low anchor.")

bearColorInput = input.color(BEAR_COLOR, "Falling", inline = "fan", group = "Style"
  , tooltip = "Fan color when the fan falls from a high anchor. The 1×1 draws solid and thicker; angles further from it draw progressively lighter, dashed, then dotted.")

showLabelsInput = input.bool(true, "Angle Labels", group = "Style"
  , tooltip = "Labels each fan line with its ratio just right of the most recent bar.")

showAnchorInput = input.bool(true, "Anchor Marker", group = "Style"
  , tooltip = "Marks the pivot the fan is projected from.")

showPanelInput = input.bool(true, "Info Panel", inline = "panel", group = "Style"
  , tooltip = "Compact summary of the fan state: direction, anchor, the active 1×1 units-per-bar (the scaling that makes the fan reproducible), price position versus the 1×1, and the pair of angles currently containing price.")

panelPosInput = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "panel", group = "Style"
  , tooltip = "Chart corner where the info panel is drawn.")

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
// Price level of a fan angle `barsRun` bars away from the anchor
fanLevel(float aPrice, int sgn, float unitPerBar, float priceRatio, int barsRun) =>
    aPrice + sgn * unitPerBar * priceRatio * barsRun

// Line style, width and transparency graduate with the angle's distance from the 1×1
rankStyle(int rank) =>
    rank <= 1 ? line.style_solid : rank <= 3 ? line.style_dashed : line.style_dotted

rankWidth(int rank) =>
    rank == 0 ? 2 : 1

rankTransp(int rank) =>
    rank == 0 ? 0 : 15 + rank * 12

//---------------------------------------------------------------------------------------------------------------------}
// Anchor & Scale
//---------------------------------------------------------------------------------------------------------------------{
var showsArr = array.from(show8Input, show4Input, show3Input, show2Input, show1Input, show2Input, show3Input, show4Input, show8Input)

anchorIsManual = anchorModeInput == "Manual"
scaleIsManual  = scaleModeInput  == "Manual"

atrValue = ta.atr(atrLengthInput)
max_bars_back(atrValue, MAX_WINDOW)
trValue = ta.tr(true)

// Rolling-window extremes for the auto anchor, with expanding extremes while the window fills
lowestOff  = ta.lowestbars(low, lookbackInput)
highestOff = ta.highestbars(high, lookbackInput)
windowLow  = ta.lowest(low, lookbackInput)
windowHigh = ta.highest(high, lookbackInput)

var float runLow     = na
var int   runLowBar  = 0
var float runHigh    = na
var int   runHighBar = 0
if na(runLow) or low < runLow
    runLow    := low
    runLowBar := bar_index
if na(runHigh) or high > runHigh
    runHigh    := high
    runHighBar := bar_index

int   autoLowBar    = na(lowestOff)  ? runLowBar  : bar_index + lowestOff
float autoLowPrice  = na(lowestOff)  ? runLow     : windowLow
int   autoHighBar   = na(highestOff) ? runHighBar : bar_index + highestOff
float autoHighPrice = na(highestOff) ? runHigh    : windowHigh

// Manual anchor: capture the bar and the ATR prevailing at the selected time
var int   manualBar = na
var float manualAtr = na
if na(manualBar) and time >= manualTimeInput
    manualBar := bar_index
    manualAtr := nz(atrValue, trValue)

// Fan direction
bool autoRising = autoLowBar <= autoHighBar
bool risingFan = switch directionInput
    "Rising"  => true
    "Falling" => false
    => anchorIsManual ? manualPriceInput <= close : autoRising
int dirSign = risingFan ? 1 : -1

// Anchor point
int   anchorBar   = anchorIsManual ? (na(manualBar) ? bar_index : manualBar) : (risingFan ? autoLowBar : autoHighBar)
float anchorPrice = anchorIsManual ? manualPriceInput : (risingFan ? autoLowPrice : autoHighPrice)

// 1×1 unit — price units per bar
float unitRaw = na
if scaleIsManual
    unitRaw := manualUnitInput
else if anchorIsManual
    unitRaw := manualAtr * atrMultInput
else
    unitRaw := atrValue[bar_index - anchorBar] * atrMultInput

float unitFallback = nz(atrValue, math.max(trValue, syminfo.mintick))
float unit = na(unitRaw) or unitRaw <= 0 ? unitFallback : unitRaw

bool fanReady = not na(anchorBar) and not na(anchorPrice) and not na(unit) and unit > 0

//---------------------------------------------------------------------------------------------------------------------}
// Fan Levels & Crossings
//---------------------------------------------------------------------------------------------------------------------{
int barsRun = fanReady ? bar_index - anchorBar : 0

float lvl11 = fanReady ? fanLevel(anchorPrice, dirSign, unit, 1.0, barsRun) : na
float lvl21 = fanReady ? fanLevel(anchorPrice, dirSign, unit, 2.0, barsRun) : na
float lvl12 = fanReady ? fanLevel(anchorPrice, dirSign, unit, 0.5, barsRun) : na

// Crossings are only evaluated while the fan geometry is unchanged from the previous bar
bool stable = bar_index > 0 and fanReady and fanReady[1] and anchorBar == anchorBar[1] and dirSign == dirSign[1] and unit == unit[1]
bool prevOk = stable and not na(close[1])

bool crossUp11 = prevOk and not na(lvl11) and not na(lvl11[1]) and close[1] <= lvl11[1] and close > lvl11
bool crossDn11 = prevOk and not na(lvl11) and not na(lvl11[1]) and close[1] >= lvl11[1] and close < lvl11
bool crossUp21 = prevOk and not na(lvl21) and not na(lvl21[1]) and close[1] <= lvl21[1] and close > lvl21
bool crossDn21 = prevOk and not na(lvl21) and not na(lvl21[1]) and close[1] >= lvl21[1] and close < lvl21
bool crossUp12 = prevOk and not na(lvl12) and not na(lvl12[1]) and close[1] <= lvl12[1] and close > lvl12
bool crossDn12 = prevOk and not na(lvl12) and not na(lvl12[1]) and close[1] >= lvl12[1] and close < lvl12

var levelArr = array.new<float>(9, na)
bool anyCrossUp = false
bool anyCrossDn = false
for i = 0 to 8
    float lvlPrev = array.get(levelArr, i)
    float lvlNow  = fanReady ? fanLevel(anchorPrice, dirSign, unit, array.get(ratiosArr, i), barsRun) : na
    if prevOk and array.get(showsArr, i) and not na(lvlNow) and not na(lvlPrev)
        anyCrossUp := anyCrossUp or (close[1] <= lvlPrev and close > lvlNow)
        anyCrossDn := anyCrossDn or (close[1] >= lvlPrev and close < lvlNow)
    array.set(levelArr, i, lvlNow)

//---------------------------------------------------------------------------------------------------------------------}
// Fan Drawing
//---------------------------------------------------------------------------------------------------------------------{
var fanLinesArr  = array.new<line>(9)
var fanLabelsArr = array.new<label>(9)
var label anchorMarker = na

color fanColor = risingFan ? bullColorInput : bearColorInput

if barstate.islast and fanReady
    int x2 = math.max(bar_index, anchorBar + 1)
    for i = 0 to 8
        if not array.get(showsArr, i)
            continue
        int   rank      = array.get(ranksArr, i)
        float ratio     = array.get(ratiosArr, i)
        color lineColor = color.new(fanColor, rankTransp(rank))
        float y2        = fanLevel(anchorPrice, dirSign, unit, ratio, x2 - anchorBar)
        line ln = array.get(fanLinesArr, i)
        if na(ln)
            ln := line.new(anchorBar, anchorPrice, x2, y2, xloc.bar_index, extend.right, lineColor, rankStyle(rank), rankWidth(rank))
            array.set(fanLinesArr, i, ln)
        line.set_xy1(ln, anchorBar, anchorPrice)
        line.set_xy2(ln, x2, y2)
        line.set_color(ln, lineColor)
        if showLabelsInput
            int   labelX = bar_index + LABEL_OFFSET
            float labelY = fanLevel(anchorPrice, dirSign, unit, ratio, labelX - anchorBar)
            label lb = array.get(fanLabelsArr, i)
            if na(lb)
                lb := label.new(labelX, labelY, array.get(namesArr, i), xloc.bar_index, yloc.price, #00000000, label.style_label_left, lineColor, size.small)
                array.set(fanLabelsArr, i, lb)
            label.set_xy(lb, labelX, labelY)
            label.set_textcolor(lb, lineColor)
    if showAnchorInput
        if na(anchorMarker)
            anchorMarker := label.new(anchorBar, anchorPrice, "●", xloc.bar_index, yloc.price, #00000000, label.style_label_up, fanColor, size.tiny, tooltip = "Gann fan anchor")
        label.set_xy(anchorMarker, anchorBar, anchorPrice)
        label.set_style(anchorMarker, risingFan ? label.style_label_up : label.style_label_down)
        label.set_textcolor(anchorMarker, fanColor)

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{
panelPosition = switch panelPosInput
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right

var table infoPanel = na

if barstate.islast and showPanelInput and fanReady
    if na(infoPanel)
        infoPanel := table.new(panelPosition, 2, 5, bgcolor = DASH_BG, border_width = 0, frame_color = DASH_FRAME, frame_width = 1)
    // nearest enabled angles bracketing the current close
    float nearestAbove = na
    float nearestBelow = na
    string nameAbove   = na
    string nameBelow   = na
    for i = 0 to 8
        if not array.get(showsArr, i)
            continue
        float lvl = array.get(levelArr, i)
        if na(lvl)
            continue
        if lvl >= close and (na(nearestAbove) or lvl < nearestAbove)
            nearestAbove := lvl
            nameAbove    := array.get(namesArr, i)
        if lvl <= close and (na(nearestBelow) or lvl > nearestBelow)
            nearestBelow := lvl
            nameBelow    := array.get(namesArr, i)
    string zoneTxt = na(nameAbove) and na(nameBelow) ? "—" : na(nameAbove) ? "Above " + nameBelow : na(nameBelow) ? "Below " + nameAbove : nameBelow + " – " + nameAbove
    bool strongSide = risingFan ? close > lvl11 : close < lvl11
    string vs11Txt  = na(lvl11) ? "—" : (close > lvl11 ? "Above 1×1" : close < lvl11 ? "Below 1×1" : "At 1×1") + (strongSide ? " · strong" : " · weak")
    color vs11Color = strongSide ? fanColor : risingFan ? bearColorInput : bullColorInput
    string unitSrc  = scaleIsManual ? "manual" : "ATR " + str.tostring(atrLengthInput) + (atrMultInput == 1.0 ? "" : " × " + str.tostring(atrMultInput))
    color headColor = DASH_HEADER
    table.cell(infoPanel, 0, 0, "Fan",          text_color = headColor,      text_size = size.small, text_halign = text.align_left)
    table.cell(infoPanel, 1, 0, risingFan ? "Rising" : "Falling", text_color = fanColor, text_size = size.small, text_halign = text.align_right)
    table.cell(infoPanel, 0, 1, "Anchor",       text_color = headColor,      text_size = size.small, text_halign = text.align_left)
    table.cell(infoPanel, 1, 1, str.tostring(anchorPrice, format.mintick) + " · " + str.tostring(bar_index - anchorBar) + " bars ago", text_color = DASH_TEXT, text_size = size.small, text_halign = text.align_right)
    table.cell(infoPanel, 0, 2, "1×1 unit/bar", text_color = headColor,      text_size = size.small, text_halign = text.align_left)
    table.cell(infoPanel, 1, 2, str.tostring(unit, format.mintick) + " (" + unitSrc + ")", text_color = DASH_TEXT, text_size = size.small, text_halign = text.align_right)
    table.cell(infoPanel, 0, 3, "Price vs 1×1", text_color = headColor,      text_size = size.small, text_halign = text.align_left)
    table.cell(infoPanel, 1, 3, vs11Txt,        text_color = vs11Color,      text_size = size.small, text_halign = text.align_right)
    table.cell(infoPanel, 0, 4, "Zone",         text_color = headColor,      text_size = size.small, text_halign = text.align_left)
    table.cell(infoPanel, 1, 4, zoneTxt,        text_color = DASH_TEXT, text_size = size.small, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(crossUp11, "Price Crossed Above 1×1", "Gann Fan & Angles: price crossed above the 1×1 balance angle")
alertcondition(crossDn11, "Price Crossed Below 1×1", "Gann Fan & Angles: price crossed below the 1×1 balance angle")
alertcondition(crossUp21, "Price Crossed Above 2×1", "Gann Fan & Angles: price crossed above the steep-side 2×1 angle")
alertcondition(crossDn21, "Price Crossed Below 2×1", "Gann Fan & Angles: price crossed below the steep-side 2×1 angle")
alertcondition(crossUp12, "Price Crossed Above 1×2", "Gann Fan & Angles: price crossed above the shallow-side 1×2 angle")
alertcondition(crossDn12, "Price Crossed Below 1×2", "Gann Fan & Angles: price crossed below the shallow-side 1×2 angle")
alertcondition(anyCrossUp, "Price Crossed Above Any Angle", "Gann Fan & Angles: price crossed above an enabled fan angle — the next angle up becomes the working reference")
alertcondition(anyCrossDn, "Price Crossed Below Any Angle", "Gann Fan & Angles: price crossed below an enabled fan angle — the next angle down becomes the working reference")

//---------------------------------------------------------------------------------------------------------------------}
