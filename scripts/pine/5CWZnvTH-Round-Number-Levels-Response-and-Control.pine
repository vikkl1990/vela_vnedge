plot(responseMode == "Interval fraction" ? 0 : 1, "RN6_ResponseMode", display = display.data_window, editable = false, precision = 0)
plot(responseMode == "Interval fraction" ? responsePct / 100.0 : responseAtr, "RN6_ResponseArgument", display = display.data_window, editable = false, precision = 12)
