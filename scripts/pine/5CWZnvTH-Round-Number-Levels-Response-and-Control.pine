//@version=6
indicator("Round Number Levels - Response and Control", overlay = true, behind_chart = false, max_lines_count = 400, max_labels_count = 450, max_boxes_count = 2, max_bars_back = 5000)

// Display revision 8.0: compact, opaque round-price badges; research is unchanged.
// Research protocol 6001. One publication, three fixed grids, one matched sample.
// No other author's script code, imported libraries, order routing or network requests.
// Final outcomes are OBSERVATIONS, not simulated fills, win rates or causal effects.
// The full-horizon export emits at most ONE record per grid per bar, without collisions.
// Changing any input restarts Pine. Keep the recipe and the same OHLC feed for a replay.

const int PROTOCOL = 6001
const int HASH_MOD = 2147483629
const string G1 = "01  |  Fixed grid and reproducibility"
const string G2 = "02  |  Contact and outcome rules"
const string G3 = "03  |  Outcome-blind matching"
const string G4 = "04  |  Chart appearance"
const string G5 = "05  |  Research panel"
const string G6 = "06  |  Colors"

string spacingMode = input.string("Manual ticks", "Spacing mode", options = ["Manual ticks", "Manual price", "Auto preview (prior range)", "Auto preview (price %)"], group = G1, display = display.none, tooltip = "Default: a reproducible 200-tick interval. Check its price value for your symbol. Preview chooses a 1-2-5 interval ONCE from the first usable prior bar and is explicitly marked PREVIEW. Copy the displayed interval into Manual price to lock it; automatic preview is not a history-independent experiment.")
int manualTicks = input.int(200, "Fixed interval (minimum ticks)", minval = 1, maxval = 1000000000, group = G1, display = display.none)
float manualPrice = input.float(0.200, "Fixed interval (price units)", minval = 0.000000001, group = G1, display = display.none, tooltip = "Price units, not pips. Rounded to an integer number of minimum ticks. The zero-origin grid never moves to follow past reactions.")
int atrLength = input.int(50, "Prior mean true-range length", minval = 2, maxval = 500, group = G1, display = display.none, tooltip = "Finite simple mean of true range, not recursively seeded Wilder ATR. Research always uses the previous bar's value. Finite context prevents an arbitrary prehistory from changing later regime assignments.")
float autoAtr = input.float(3.0, "Preview interval / prior mean range", minval = 0.25, maxval = 30.0, step = 0.25, group = G1, display = display.none)
float autoPct = input.float(0.25, "Preview interval / prior price (%)", minval = 0.001, maxval = 20.0, step = 0.05, group = G1, display = display.none)
int majorEvery = input.int(5, "Major level every N intervals", minval = 2, maxval = 20, group = G1, display = display.none, tooltip = "Drawing emphasis only. Does not select observations or alter matching.")
int startDate = input.time(timestamp("01 Jan 2025 00:00 +0000"), "Study start (inclusive)", group = G1, display = display.none)
int endDate = input.time(timestamp("01 Jan 2100 00:00 +0000"), "Study end (exclusive)", group = G1, display = display.none, tooltip = "No new contacts at or after this time. Existing contacts still receive their full subsequent bar horizon. Only complete clock blocks inside the requested date interval enter the matched sample.")
bool strictCoverage = input.bool(false, "Require full start-date context", group = G1, display = display.none, tooltip = "When enabled, research stays off unless history crosses the requested start with enough preceding finite-range/trend context. When disabled, the first partial clock block is excluded and incomplete window coverage is reported. Grid drawings remain available.")

bool researchOn = input.bool(true, "Enable three-grid research", group = G2, display = display.none)
float touchPct = input.float(4.0, "Contact half-width (% of interval)", minval = 0.1, maxval = 10.0, step = 0.5, group = G2, display = display.none)
float approachPct = input.float(12.0, "Prior-close clearance (% of interval)", minval = 1.0, maxval = 45.0, step = 1.0, group = G2, display = display.none)
string responseMode = input.string("Interval fraction", "Response distance", options = ["Interval fraction", "Prior mean range"], group = G2, display = display.none)
float responsePct = input.float(20.0, "Response threshold (% of interval)", minval = 1.0, maxval = 200.0, step = 1.0, group = G2, display = display.none)
float responseAtr = input.float(0.6, "Response threshold / prior mean range", minval = 0.05, maxval = 10.0, step = 0.05, group = G2, display = display.none)
int confirmCloses = input.int(2, "Consecutive closes to confirm", minval = 1, maxval = 10, group = G2, display = display.none)
int horizonBars = input.int(12, "Full observation horizon (bars)", minval = 1, maxval = 100, group = G2, display = display.none, tooltip = "Contact bar excluded. Effective horizon is at least the confirmation count. Every eligible contact is tracked concurrently; no outcome-dependent cooldown or busy-state exclusion. Early results are frozen, but all records enter the comparison only after the entire horizon.")

float shiftFraction = input.float(0.37, "Reference A / interval", minval = 0.15, maxval = 0.85, step = 0.01, group = G3, display = display.none, tooltip = "Reference B is the exact tick complement. ROUND, A and B contact bands must all be separate. Neither reference is selected for a favorable result.")
int matchPeriods = input.int(128, "Clock block (chart periods)", minval = 16, maxval = 2048, group = G3, display = display.none, tooltip = "A fixed elapsed-time block anchored to the Unix epoch, not to the first loaded bar. Example: 128 periods on a 5-minute chart = 640 minutes. Not a session or a count of actually traded bars.")
float maxLagPct = input.float(50.0, "Maximum matched time spread (% of block)", minval = 1.0, maxval = 100.0, step = 5.0, group = G3, display = display.none, tooltip = "All three contacts in an ordinal triplet must be within this fixed time span. Failed triplets are not rematched to improve results. This filter uses contact times, never outcomes.")
string matchMode = input.string("Side + range + trend", "Match on prior context", options = ["Side only", "Side + range", "Side + range + trend"], group = G3, display = display.none, tooltip = "Inside each clock block and stratum, pair the first eligible ROUND/A/B contacts, then the second, and so on. Same approach side; optional prior range/interval bin and prior trend bin. Outcome-blind ordinal matching, not randomization or exact counterfactuals.")
float volatilityLow = input.float(0.25, "Range/interval: low boundary", minval = 0.01, maxval = 10.0, step = 0.05, group = G3, display = display.none)
float volatilityHigh = input.float(0.75, "Range/interval: high boundary", minval = 0.02, maxval = 20.0, step = 0.05, group = G3, display = display.none)
int trendLength = input.int(10, "Prior trend lookback (bars)", minval = 1, maxval = 500, group = G3, display = display.none)
float trendBoundary = input.float(0.5, "Prior trend neutral band / mean range", minval = 0.0, maxval = 20.0, step = 0.1, group = G3, display = display.none)
int windowBlocks = input.int(24, "Retained mature clock blocks", minval = 4, maxval = 64, group = G3, display = display.none, tooltip = "One common elapsed-time window for all three grids. Blocks cut by a date boundary or a missing initial history are excluded. Empty complete blocks are allowed and are not fabricated as trades.")
int perCellCap = input.int(8, "First contacts per grid / stratum / block", minval = 1, maxval = 12, group = G3, display = display.none, tooltip = "Fixed outcome-blind matching cap. Later contacts are still tracked and exported, and cap exclusions are counted. Increase the cap only as a declared research-setting change, not to search for a preferred result.")
int minimumN = input.int(30, "Minimum matched triplets for deltas", minval = 3, maxval = 1000, group = G3, display = display.none)
int minimumSideN = input.int(5, "Minimum triplets per approach side", minval = 1, maxval = 200, group = G3, display = display.none)
int minimumBlocks = input.int(3, "Minimum contributing clock blocks", minval = 1, maxval = 64, group = G3, display = display.none, tooltip = "Display guard only. More matches or blocks do not establish independence or statistical significance.")
int levelsEachSide = input.int(6, "Base levels on each side", minval = 2, maxval = 24, group = G4, display = display.none)
int drawBars = input.int(260, "Line length behind current bar", minval = 20, maxval = 4000, group = G4, display = display.none)
int rightBars = input.int(14, "Line end to the right (bars)", minval = 2, maxval = 100, group = G4, display = display.none)
string lineExtension = input.string("Segment", "Line extension", options = ["Segment", "Right", "Both"], group = G4, display = display.none, tooltip = "Extension is a visual projection of the selected fixed grid, not a historical signal. Research is independent of displayed lines.")
bool limitHeight = input.bool(true, "Reduce distant-line clutter", group = G4, display = display.none)
float heightAtr = input.float(12.0, "Drawing radius / current mean range", minval = 2.0, maxval = 100.0, step = 1.0, group = G4, display = display.none, tooltip = "Only affects drawing. The two enclosing base levels remain visible. It does not remove observations from the research.")
bool showLabels = input.bool(true, "Show level price badges", group = G4, display = display.none)
bool showHalf = input.bool(false, "Show half-interval guides", group = G4, display = display.none, tooltip = "Visual only; never researched. Hidden when the base interval contains an odd number of ticks, to avoid uneven subdivision.")
bool showShift = input.bool(false, "Show reference A lines", group = G4, display = display.none, tooltip = "Dotted reference-A lines. Research continues even when these lines are hidden.")
bool showMirror = input.bool(false, "Show reference B lines", group = G4, display = display.none, tooltip = "Dashed mirrored-reference lines. Visual only; the mirrored audit does not depend on showing them.")
bool showCell = input.bool(true, "Shade the current price cell", group = G4, display = display.none)
bool liveContext = input.bool(true, "Follow the live price for visual context", group = G4, display = display.none, tooltip = "The enclosing lines, distances and shading may move intrabar. Observations, outcomes and research statistics update only on confirmed bars.")
bool showActive = input.bool(true, "Show latest unresolved round-contact thresholds", group = G4, display = display.none, tooltip = "Shows only the most recent unresolved round contact to limit clutter. Other contacts continue independently. These are observation thresholds, not targets or stops.")
bool showMarkers = input.bool(true, "Mark completed round-grid outcomes", group = G4, display = display.none, tooltip = "R = return to the approach side; T = through to the opposite side; U = unresolved. Plotted on the outcome bar, never backdated to the contact bar.")
int markerCapacity = input.int(60, "Maximum outcome markers", minval = 0, maxval = 250, group = G4, display = display.none)
int baseWidth = input.int(1, "Base line width", minval = 1, maxval = 4, group = G4, display = display.none)
int majorWidth = input.int(2, "Major line width", minval = 1, maxval = 4, group = G4, display = display.none)
int nearestWidth = input.int(3, "Enclosing line width", minval = 1, maxval = 5, group = G4, display = display.none)
string badgeEdge = input.string("Left of segment", "Price badge placement", options = ["Left of segment", "Right of segment"], group = G4, display = display.none, tooltip = "Left placement keeps price badges away from the fixed right-side panel. This changes drawing only.")
bool showThresholdBadges = input.bool(false, "Show response-threshold captions", group = G4, display = display.none)
int markerGap = input.int(12, "Minimum marker gap at the same level", minval = 0, maxval = 100, group = G4, display = display.none, tooltip = "Drawing-only thinning against the most recently drawn marker. All outcomes remain in the full-horizon ledger even when not drawn. Multiple outcomes can confirm on the same bar. Markers never move back to contact bars.")
int badgeSize = input.int(13, "Round-number font size (points)", minval = 10, maxval = 36, group = G4, display = display.none, tooltip = "Actual numeric label size. Default: compact 13-point round-number badges. This setting affects base round-number badges only, not the panel, outcome markers or reference captions.")
int badgeEmphasisSize = input.int(14, "Major / enclosing font size (points)", minval = 10, maxval = 40, group = G4, display = display.none, tooltip = "Major and enclosing price labels use at least the base font size. Drawing only.")
string badgeTheme = input.string("Solid level color", "Round-number badge appearance", options = ["Solid level color", "Dark badge"], group = G4, display = display.none, tooltip = "Solid level color: an opaque badge matching the price line, with automatic black/white text contrast. Dark badge: white numbers on opaque navy. Does not recolor lines or the research panel.")
bool badgeDigitsOnly = input.bool(true, "Price digits only in round badges", group = G4, display = display.none, tooltip = "Removes L/U prefixes and decorative symbols from the price. Level roles remain in the colors, tooltips and unchanged panel. Turn off to restore the prefixes.")
bool badgeMonospace = input.bool(true, "Monospace round-number digits", group = G4, display = display.none)
int badgeHorizontalGap = input.int(12, "Round-badge horizontal gap (bars)", minval = 0, maxval = 150, group = G4, display = display.none, tooltip = "Moves only the round badge outward from its segment endpoint. Optional leaders still start on the exact level at the original endpoint. Left placement stays away from the right-side panel; right placement can overlap it depending on zoom and chart margin.")
int badgeOffsetTicks = input.int(2, "Price badge offset (ticks)", minval = 0, maxval = 100, group = G4, display = display.none, tooltip = "Vertical displacement of badge boxes only. The printed price and horizontal line remain exact. Lower/upper badges move outward; optional short leaders join the boxes to their true levels.")
bool staggerBadges = input.bool(true, "Alternate badge offset direction", group = G4, display = display.none, tooltip = "Alternates the displacement of non-enclosing badges. Lower badges move down and upper badges move up. Turning this off uses upward displacement for other levels.")
string markerPlacement = input.string("Above/Below bar", "Outcome marker placement", options = ["Above/Below bar", "On level"], group = G4, display = display.none, tooltip = "Above/Below bar places each badge outside the outcome bar and the selected preceding clearance bars. Its time stays on the outcome bar. On level restores the original placement. No future bars are used.")
float markerOffsetAtr = input.float(0.30, "Outcome marker offset / mean range", minval = 0.05, maxval = 3.0, step = 0.05, group = G4, display = display.none, tooltip = "Extra distance outside the clearance range. Fixed when the outcome is confirmed. Drawing only; it does not change any research threshold.")
int markerClearanceBars = input.int(3, "Marker clearance lookback (bars)", minval = 1, maxval = 25, group = G4, display = display.none, tooltip = "Includes the outcome bar and preceding bars only. Future candles are not known and may later enter the same area.")
string markerSize = input.string("Normal", "Outcome marker size", options = ["Small", "Normal", "Large"], group = G4, display = display.none)
