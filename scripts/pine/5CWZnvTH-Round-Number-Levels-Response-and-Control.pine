alertcondition(newRoundContact, "Round level: new contact", "{{ticker}} {{interval}}: a round-number contact was admitted on a confirmed bar. Observation only; not an entry signal.")
alertcondition(eventRCount > 0, "Round level: return confirmed", "{{ticker}} {{interval}}: one or more ROUND return outcomes were confirmed. Full-horizon records are exported separately at maturity. Not a trading recommendation.")
alertcondition(eventTCount > 0, "Round level: through confirmed", "{{ticker}} {{interval}}: one or more ROUND through outcomes were confirmed. Full-horizon records are exported separately at maturity. Not a trading recommendation.")
alertcondition(eventUCount > 0, "Round level: horizon unresolved", "{{ticker}} {{interval}}: one or more ROUND observations reached the full horizon without a return or through confirmation.")

// A public script remains self-describing through numeric exports. Logs below are
// a convenience for personal editor copies, never a required off-platform dependency.
if printRecipe and barstate.islastconfirmedhistory
    string recipe = "RNRC protocol=" + str.tostring(PROTOCOL) + "; ticker=" + syminfo.tickerid + "; timeframe=" + timeframe.period
    recipe += "\nUse fixed spacing ticks=" + str.tostring(lockedTicks) + "; minimum tick=" + str.tostring(tick, "0.################") + "; initialized_ms=" + str.tostring(initializedTime)
    recipe += "\nA_ticks=" + str.tostring(shiftedTicks, "0") + "; band_ticks=" + str.tostring(bandTicks, "0") + "; clearance_ticks=" + str.tostring(clearanceTicks, "0") + "; H=" + str.tostring(effectiveHorizon) + "; consecutive=" + str.tostring(confirmCloses)
    recipe += "\nblock_ms=" + str.tostring(blockMillis) + "; max_lag_ms=" + str.tostring(allowedLagMillis) + "; window_blocks=" + str.tostring(windowBlocks) + "; cell_cap=" + str.tostring(perCellCap) + "; mode=" + str.tostring(modeCode)
    recipe += "\nrange_length=" + str.tostring(atrLength) + "; trend_length=" + str.tostring(trendLength) + "; range_bins=" + str.tostring(volatilityLow) + "," + str.tostring(volatilityHigh) + "; trend_boundary=" + str.tostring(trendBoundary)
    recipe += "\nresponse_mode=" + responseMode + "; fraction=" + str.tostring(responsePct / 100.0) + "; range_multiple=" + str.tostring(responseAtr) + "; start_ms=" + str.tostring(startDate) + "; end_ms=" + str.tostring(endDate)
    recipe += "\nmin_N=" + str.tostring(minimumN) + "; min_side=" + str.tostring(minimumSideN) + "; min_blocks=" + str.tostring(minimumBlocks) + "; strict_start=" + str.tostring(strictCoverage) + "; preview=" + str.tostring(previewMode)
    recipe += "\nwindow_first_key=" + str.tostring(auditFirstKey) + "; window_last_key=" + str.tostring(auditLastKey) + "; matched_each=" + str.tostring(exportMatched.count) + "; delta_A=" + str.tostring(deltaA) + "; delta_B=" + str.tostring(deltaB) + "; mean=" + str.tostring(meanDelta)
    recipe += "\nOHLC_checksum=" + str.tostring(audit.checksum) + ". Keep the source, identical feed/session/adjustments, settings and loaded OHLC. This checksum is not cryptographic. No causal or performance certification."
    log.info(recipe)