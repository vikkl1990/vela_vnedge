plot(runFlags, "RN6_Flags", display = display.data_window, editable = false, precision = 0)
plot(snapshotRow ? auditFirstKey : na, "RN6_WindowFirst", display = display.data_window, editable = false, precision = 0)
plot(snapshotRow ? auditLastKey : na, "RN6_WindowLast", display = display.data_window, editable = false, precision = 0)
