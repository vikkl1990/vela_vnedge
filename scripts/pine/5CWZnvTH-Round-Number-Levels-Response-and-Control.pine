plot(snapshotRow ? deltaB : na, "RN6_DeltaB", display = display.data_window, editable = false, precision = 12)
plot(snapshotRow ? meanDelta : na, "RN6_MeanDelta", display = display.data_window, editable = false, precision = 12)
plot(snapshotRow ? agreement : na, "RN6_Agreement", display = display.data_window, editable = false, precision = 0)
plot(initializedTime, "RN6_InitializedTime", display = display.data_window, editable = false, precision = 0)
plot(snapshotRow ? audit.checksum : na, "RN6_DataChecksum", display = display.data_window, editable = false, precision = 0)
