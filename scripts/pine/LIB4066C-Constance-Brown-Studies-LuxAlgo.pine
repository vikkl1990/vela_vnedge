//@version=6
indicator("Constance Brown Studies", shorttitle = "Constance Brown Studies", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR     = #089981
BEAR_COLOR     = #f23645
NEUTRAL_COLOR  = #787b86
FAST_AVG_COLOR = #ff9800    // the trigger line
SLOW_AVG_COLOR = #ab47bc    // the slower context line - kept a distinct hue from the trigger

SCALE_TOP    = 100          // bounded RSI scale, anchors of the range-rule zone shading
SCALE_BOTTOM = 0

FILL_VALUE_TRANSP  = 50     // gradient transparency at the Composite Index value
FILL_CENTER_TRANSP = 100    // gradient transparency at the fast average
ZONE_TRANSP        = 90     // range-rule band shading
LEVEL_TRANSP       = 40     // range-rule level lines
HISTOGRAM_TRANSP   = 35     // Derivative Oscillator columns

RSI_GROUP        = "RSI"
COMPOSITE_GROUP  = "Composite Index"
DERIVATIVE_GROUP = "Derivative Oscillator"
RANGE_GROUP      = "RSI Range Rules"
STYLE_GROUP      = "Style"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source"
  , group   = RSI_GROUP
  , tooltip = "Price series the RSIs are computed on. Brown published the studies on closing prices.")

rsiLengthInput = input.int(14, "RSI Length", minval = 2
  , group   = RSI_GROUP
  , tooltip = "Length of the base RSI. It is the pane's RSI line and the raw material of both studies: the Composite Index takes its momentum and the Derivative Oscillator double-smooths it. Published default 14.")

showRsiInput = input.bool(true, "Show RSI"
  , group   = RSI_GROUP
  , tooltip = "Plots the base RSI next to the Composite Index. The Composite is read alongside RSI, not instead of it - a divergence at RSI's swing highs and lows that shows on one line but not the other is the warning, so both lines stay on by default.")

momentumLengthInput = input.int(9, "Momentum Length", minval = 1
  , group   = COMPOSITE_GROUP
  , tooltip = "Bars for the momentum term: base RSI minus its value this many bars back. Published default 9. The term carries no 0-100 bound, so the Composite can keep stretching where RSI flattens against its scale - removing the bound is the point of the study.")

fastRsiLengthInput = input.int(3, "Fast RSI", minval = 1, inline = "fastRsi"
  , group   = COMPOSITE_GROUP
  , tooltip = "Short RSI length of the smoothed term. Published default 3.")

fastRsiSmoothInput = input.int(3, "Smoothing", minval = 1, inline = "fastRsi"
  , group   = COMPOSITE_GROUP
  , tooltip = "Simple average applied to the short RSI. Published default 3, completing Brown's formula: the 9-bar momentum of a 14-period RSI plus a 3-bar simple average of a 3-period RSI.")

fastAvgLengthInput = input.int(13, "Fast Average", minval = 1, inline = "avgs"
  , group   = COMPOSITE_GROUP
  , tooltip = "Fast simple average of the Composite Index (Brown plotted 13). The Composite crossing this average is the mechanical trigger added to the divergence read.")

slowAvgLengthInput = input.int(33, "Slow Average", minval = 1, inline = "avgs"
  , group   = COMPOSITE_GROUP
  , tooltip = "Slow simple average of the Composite Index (Brown plotted 33) - the slower context line of the pair.")

showAveragesInput = input.bool(true, "Show Signal Averages"
  , group   = COMPOSITE_GROUP
  , tooltip = "Plots the two simple averages of the Composite Index. Brown plotted the studies with moving averages of themselves so that a study crossing its own average adds a mechanical trigger; the trigger alerts stay armed whether or not the lines are shown.")

showDerivativeInput = input.bool(false, "Show Histogram"
  , group   = DERIVATIVE_GROUP
  , tooltip = "Plots Brown's second study, the Derivative Oscillator, as a zero-based histogram below the RSI scale. Off by default to keep the pane on the Composite Index read - the zero-line cross alerts stay armed regardless.")

derivFirstEmaInput = input.int(5, "First EMA", minval = 1, inline = "derivEma"
  , group   = DERIVATIVE_GROUP
  , tooltip = "First exponential smoothing applied to the base RSI. Published default 5.")

derivSecondEmaInput = input.int(3, "Second EMA", minval = 1, inline = "derivEma"
  , group   = DERIVATIVE_GROUP
  , tooltip = "Second exponential smoothing. Published default 3.")

derivSignalInput = input.int(9, "Signal SMA", minval = 1
  , group   = DERIVATIVE_GROUP
  , tooltip = "Simple average subtracted from the double-smoothed RSI; the histogram is the remainder. Published default 9. Read it like a MACD histogram applied to smoothed RSI: zero-line crosses mark direction flips and shrinking bars warn that thrust is fading.")

showZonesInput = input.bool(true, "Range Zone Shading"
  , group   = RANGE_GROUP
  , tooltip = "Shades the ground that separates Brown's RSI operating ranges: bull markets hold RSI roughly 40-80 and bear markets 20-60, so the 60-80 band is bull-only territory and the 20-40 band bear-only. Which extreme band RSI can reach, and which floor it defends, is the regime tell.")

bullFloorInput = input.int(40, "Bull Floor", minval = 0, maxval = 100, inline = "bullRange"
  , group   = RANGE_GROUP
  , tooltip = "Bull-market operating range of RSI, published as 40 to 80. The floor is the support bull-market pullbacks defend - RSI losing it is the shift warning toward the bear range.")

bullCeilingInput = input.int(80, "Ceiling", minval = 0, maxval = 100, inline = "bullRange"
  , group   = RANGE_GROUP
  , tooltip = "Upper extreme RSI presses in bull markets.")

bearFloorInput = input.int(20, "Bear Floor", minval = 0, maxval = 100, inline = "bearRange"
  , group   = RANGE_GROUP
  , tooltip = "Bear-market operating range of RSI, published as 20 to 60. The floor is the extreme bear-market declines reach.")

bearCeilingInput = input.int(60, "Ceiling", minval = 0, maxval = 100, inline = "bearRange"
  , group   = RANGE_GROUP
  , tooltip = "Resistance bear-market rallies fail under - RSI clearing it is the shift warning toward the bull range.")

bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "direction"
  , group   = STYLE_GROUP
  , tooltip = "Composite Index, trigger gradient and bull-range shading while the Composite holds above its fast average.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "direction"
  , group   = STYLE_GROUP
  , tooltip = "Composite Index, trigger gradient and bear-range shading while the Composite holds below its fast average.")

rsiColorInput = input.color(NEUTRAL_COLOR, "RSI", inline = "lineColors"
  , group   = STYLE_GROUP
  , tooltip = "Base RSI line.")

fastAvgColorInput = input.color(FAST_AVG_COLOR, "Fast Avg", inline = "lineColors"
  , group   = STYLE_GROUP
  , tooltip = "Fast signal average of the Composite Index.")

slowAvgColorInput = input.color(SLOW_AVG_COLOR, "Slow Avg", inline = "lineColors"
  , group   = STYLE_GROUP
  , tooltip = "Slow signal average of the Composite Index.")

levelColorInput = input.color(NEUTRAL_COLOR, "Range Levels"
  , group   = STYLE_GROUP
  , tooltip = "Dashed reference lines at the bull-range floor and ceiling and the bear-range floor and ceiling.")

gradientFillInput = input.bool(true, "Trigger Gradient"
  , group   = STYLE_GROUP
  , tooltip = "Vertical gradient between the Composite Index and its fast average - fully transparent at the average, stronger at the value, bullish or bearish by the side the Composite is on.")

showMarkersInput = input.bool(false, "Trigger Markers"
  , group   = STYLE_GROUP
  , tooltip = "Small circle on the Composite Index when it crosses its fast average. Off by default to keep the pane clean - the trigger alerts fire regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Base RSI - shared by the pane line, the Composite momentum term and the Derivative Oscillator
rsiValue = ta.rsi(srcInput, rsiLengthInput)

// Composite Index, as published: the 9-bar momentum of a 14-period RSI added to a 3-bar simple
// average of a 3-period RSI. The unbounded momentum term lets the line keep stretching where
// RSI compresses near its extremes, so it can print divergences the bounded scale conceals
fastRsiValue   = ta.rsi(srcInput, fastRsiLengthInput)
momentumTerm   = rsiValue - rsiValue[momentumLengthInput]
smoothedTerm   = ta.sma(fastRsiValue, fastRsiSmoothInput)
compositeIndex = momentumTerm + smoothedTerm

// Brown plotted the studies with simple averages of themselves - the fast one is the trigger line
fastAverage = ta.sma(compositeIndex, fastAvgLengthInput)
slowAverage = ta.sma(compositeIndex, slowAvgLengthInput)

// Derivative Oscillator: the base RSI smoothed with 5- then 3-period exponential averages,
// minus a 9-period simple average of that double-smoothed line, plotted as a histogram
doubleSmoothedRsi    = ta.ema(ta.ema(rsiValue, derivFirstEmaInput), derivSecondEmaInput)
derivativeOscillator = doubleSmoothedRsi - ta.sma(doubleSmoothedRsi, derivSignalInput)

// Events: the mechanical trigger cross, the range-rule shifts and the histogram direction flips
aboveTrigger        = compositeIndex > fastAverage
bullishTriggerCross = ta.crossover(compositeIndex, fastAverage)
bearishTriggerCross = ta.crossunder(compositeIndex, fastAverage)

bullRangeShift = ta.crossover(rsiValue, bearCeilingInput)
bearRangeShift = ta.crossunder(rsiValue, bullFloorInput)

derivativeCrossUp   = ta.crossover(derivativeOscillator, 0)
derivativeCrossDown = ta.crossunder(derivativeOscillator, 0)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
compositeColor = aboveTrigger ? bullColorInput : bearColorInput

fillTopColor    = aboveTrigger ? color.new(bullColorInput, FILL_VALUE_TRANSP)  : color.new(bearColorInput, FILL_CENTER_TRANSP)
fillBottomColor = aboveTrigger ? color.new(bullColorInput, FILL_CENTER_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

histogramColor = derivativeOscillator >= 0 ? color.new(bullColorInput, HISTOGRAM_TRANSP) : color.new(bearColorInput, HISTOGRAM_TRANSP)

// Range-rule levels - dashed references, with the bands only one regime visits shaded:
// 60-80 belongs to bull-market RSI, 20-40 to bear-market RSI, 40-60 is common ground
bullCeilingLevel = hline(bullCeilingInput, "Bull Range Ceiling", color.new(levelColorInput, LEVEL_TRANSP), hline.style_dashed)
bearCeilingLevel = hline(bearCeilingInput, "Bear Range Ceiling", color.new(levelColorInput, LEVEL_TRANSP), hline.style_dashed)
bullFloorLevel   = hline(bullFloorInput, "Bull Range Floor", color.new(levelColorInput, LEVEL_TRANSP), hline.style_dashed)
bearFloorLevel   = hline(bearFloorInput, "Bear Range Floor", color.new(levelColorInput, LEVEL_TRANSP), hline.style_dashed)

// Zone shading anchored on hidden plots of the same levels
bullCeilingAnchorId = plot(bullCeilingInput, "Bull Ceiling Anchor", color(na), editable = false, display = display.none)
bearCeilingAnchorId = plot(bearCeilingInput, "Bear Ceiling Anchor", color(na), editable = false, display = display.none)
bullFloorAnchorId   = plot(bullFloorInput, "Bull Floor Anchor", color(na), editable = false, display = display.none)
bearFloorAnchorId   = plot(bearFloorInput, "Bear Floor Anchor", color(na), editable = false, display = display.none)

fill(bullCeilingAnchorId, bearCeilingAnchorId, showZonesInput ? color.new(bullColorInput, ZONE_TRANSP) : na, title = "Bull-Only Territory")
fill(bullFloorAnchorId, bearFloorAnchorId, showZonesInput ? color.new(bearColorInput, ZONE_TRANSP) : na, title = "Bear-Only Territory")

plot(showDerivativeInput ? derivativeOscillator : na, "Derivative Oscillator", histogramColor, 1, plot.style_columns)

fastAveragePlotId = plot(fastAverage, "Composite Fast Average", showAveragesInput ? fastAvgColorInput : na, 1)
plot(slowAverage, "Composite Slow Average", showAveragesInput ? slowAvgColorInput : na, 1)

plot(showRsiInput ? rsiValue : na, "RSI", rsiColorInput, 1)

compositePlotId = plot(compositeIndex, "Composite Index", compositeColor, 2)

fill(compositePlotId, fastAveragePlotId
  , math.max(compositeIndex, fastAverage)
  , math.min(compositeIndex, fastAverage)
  , gradientFillInput ? fillTopColor : na
  , gradientFillInput ? fillBottomColor : na
  , title = "Trigger Gradient")

plotshape(showMarkersInput and bullishTriggerCross ? compositeIndex : na, "Bullish Trigger Marker", shape.circle, location.absolute, bullColorInput, size = size.tiny)
plotshape(showMarkersInput and bearishTriggerCross ? compositeIndex : na, "Bearish Trigger Marker", shape.circle, location.absolute, bearColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullishTriggerCross, "Bullish Trigger Cross", "Constance Brown Studies: Composite Index crossed above its fast average on {{ticker}} - mechanical bullish trigger ({{interval}})")
alertcondition(bearishTriggerCross, "Bearish Trigger Cross", "Constance Brown Studies: Composite Index crossed below its fast average on {{ticker}} - mechanical bearish trigger ({{interval}})")
alertcondition(bullRangeShift, "RSI Bull Range Shift", "Constance Brown Studies: RSI cleared the bear-range ceiling on {{ticker}} - bull-market range behavior ({{interval}})")
alertcondition(bearRangeShift, "RSI Bear Range Shift", "Constance Brown Studies: RSI lost the bull-range floor on {{ticker}} - bear-market range behavior ({{interval}})")
alertcondition(derivativeCrossUp, "Derivative Oscillator Cross Up", "Constance Brown Studies: Derivative Oscillator crossed above zero on {{ticker}} - momentum flipped up ({{interval}})")
alertcondition(derivativeCrossDown, "Derivative Oscillator Cross Down", "Constance Brown Studies: Derivative Oscillator crossed below zero on {{ticker}} - momentum flipped down ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
