//@version=6
indicator("Waddah Attar Explosion", shorttitle = "Waddah Attar Explosion", overlay = false, format = format.price)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR      = #089981 // trend power columns, upward pressure
BEAR_COLOR      = #f23645 // trend power columns, downward pressure
EXPLOSION_COLOR = #ff9800 // explosion line, the non-directional volatility envelope - the one accent, the level columns must beat
DEADZONE_COLOR  = #787b86 // dead zone noise floor
DIM_TRANSP      = 65      // transparency of columns that fail the explosion / dead zone gate
GRAD_TOP_TRANSP = 75      // gradient fill transparency at the explosion line
GRAD_BOT_TRANSP = 100     // gradient fill transparency at the zero baseline

DZ_ATR   = "ATR Multiple"
DZ_FIXED = "Fixed (Ticks)"

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput = input.source(close, "Source"
  , group   = "Trend Power"
  , tooltip = "Price series feeding both the MACD line and the Bollinger Band width. Classic builds run the whole calculation on the close.")

fastLengthInput = input.int(20, "Fast EMA Length", minval = 1
  , group   = "Trend Power"
  , tooltip = "Fast EMA length of the MACD line whose bar-to-bar change drives the trend power columns. The classic default is 20.")

slowLengthInput = input.int(40, "Slow EMA Length", minval = 1
  , group   = "Trend Power"
  , tooltip = "Slow EMA length of the MACD line. The classic default is 40, twice the fast length.")

sensitivityInput = input.float(150, "Sensitivity", minval = 1, step = 5
  , group   = "Trend Power"
  , tooltip = "Multiplier scaling the bar-to-bar change of the MACD line into the trend power columns, so momentum can be read against the Bollinger width. 150 is the common default.")

bbLengthInput = input.int(20, "Bollinger Length", minval = 2
  , group   = "Explosion Line"
  , tooltip = "Lookback of the Bollinger Bands whose upper-to-lower width forms the explosion line. Default 20 periods.")

bbMultInput = input.float(2.0, "Bollinger Multiplier", minval = 0.1, step = 0.1
  , group   = "Explosion Line"
  , tooltip = "Standard deviation multiplier of the Bollinger Bands. Default 2 - the explosion line equals the full distance between the upper and lower bands.")

dzBasisInput = input.string(DZ_ATR, "Basis", options = [DZ_ATR, DZ_FIXED]
  , group   = "Dead Zone"
  , tooltip = "How the dead zone - the minimum threshold beneath which readings are treated as noise - is derived. 'ATR Multiple' scales the floor with recent true range; 'Fixed (Ticks)' keeps a constant height, as in fixed-threshold builds.")

dzAtrLengthInput = input.int(100, "ATR Length", minval = 1
  , group   = "Dead Zone"
  , tooltip = "Smoothing length of the ATR used while the basis is 'ATR Multiple'. The published ATR-derived construction averages true range over 100 bars.")

dzAtrMultInput = input.float(3.7, "ATR Multiplier", minval = 0, step = 0.1
  , group   = "Dead Zone"
  , tooltip = "Multiplier applied to the ATR to place the dead zone floor while the basis is 'ATR Multiple'. The published default is 3.7.")

dzFixedInput = input.float(20, "Fixed Size (Ticks)", minval = 0
  , group   = "Dead Zone"
  , tooltip = "Dead zone height, in ticks, while the basis is 'Fixed (Ticks)' - mirroring the fixed point threshold used by the original build.")

bullColorInput = input.color(BULL_COLOR, "Power Up", inline = "direction"
  , group   = "Style"
  , tooltip = "Column color while the bar-to-bar MACD change is positive. Green bars mark upward pressure and permit longs.")

bearColorInput = input.color(BEAR_COLOR, "Down", inline = "direction"
  , group   = "Style"
  , tooltip = "Column color while the bar-to-bar MACD change is negative. Red bars mark downward pressure and permit shorts.")

explosionColorInput = input.color(EXPLOSION_COLOR, "Explosion Line"
  , group   = "Style"
  , tooltip = "Color of the explosion line - the Bollinger Band width - and of its optional gradient fill.")

dzColorInput = input.color(DEADZONE_COLOR, "Dead Zone"
  , group   = "Style"
  , tooltip = "Color of the dead zone noise floor.")

dimFilteredInput = input.bool(true, "Dim Filtered Columns"
  , group   = "Style"
  , tooltip = "Prints trend power columns dimmed while they fail to clear the explosion line and the dead zone, reserving full color for bars where directional energy exceeds ambient churn.")

gradientInput = input.bool(true, "Explosion Gradient"
  , group   = "Style"
  , tooltip = "Shades the area beneath the explosion line with a vertical gradient, making the volatility envelope the columns must beat easy to see.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Trend power - the bar-to-bar change of the MACD line, scaled by the sensitivity multiplier.
// Columns show its magnitude; color carries its direction
fastEma  = ta.ema(srcInput, fastLengthInput)
slowEma  = ta.ema(srcInput, slowLengthInput)
macdLine = fastEma - slowEma

trendPower = sensitivityInput * (macdLine - macdLine[1])
powerValue = math.abs(trendPower)
direction  = nz(trendPower) >= 0 ? 1 : -1

// Explosion line - the width between the upper and lower Bollinger Bands
bbBasis   = ta.sma(srcInput, bbLengthInput)
bbDev     = bbMultInput * ta.stdev(srcInput, bbLengthInput)
upperBand = bbBasis + bbDev
lowerBand = bbBasis - bbDev

explosionValue = upperBand - lowerBand

// Dead zone - the noise floor beneath which trend power is treated as untradeable churn
atrValue      = ta.atr(dzAtrLengthInput)
deadZoneValue = dzBasisInput == DZ_ATR ? dzAtrMultInput * atrValue : dzFixedInput * syminfo.mintick

// Go / no-go gate - directional energy counts only above both the explosion line and the dead zone
dataReady = not (na(powerValue) or na(explosionValue) or na(deadZoneValue))
isActive  = dataReady and powerValue > explosionValue and powerValue > deadZoneValue

crossAboveExplosion = ta.crossover(powerValue, explosionValue)
crossBelowExplosion = ta.crossunder(powerValue, explosionValue)
crossAboveDeadZone  = ta.crossover(powerValue, deadZoneValue)

bullExplosion = isActive and crossAboveExplosion and direction == 1
bearExplosion = isActive and crossAboveExplosion and direction == -1
explosionEnd  = dataReady and crossBelowExplosion
deadZoneExit  = dataReady and crossAboveDeadZone
bullFlip      = dataReady and direction == 1 and direction[1] == -1
bearFlip      = dataReady and direction == -1 and direction[1] == 1

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
baseColor   = direction == 1 ? bullColorInput : bearColorInput
columnColor = isActive or not dimFilteredInput ? baseColor : color.new(baseColor, DIM_TRANSP)

zeroPlot      = plot(0, "Zero Baseline", color = na, editable = false, display = display.none)
plot(powerValue, "Trend Power", color = columnColor, linewidth = 1, style = plot.style_columns)
explosionPlot = plot(explosionValue, "Explosion Line", color = explosionColorInput, linewidth = 2)
plot(deadZoneValue, "Dead Zone", color = dzColorInput, linewidth = 1)

fill(zeroPlot, explosionPlot
  , top_value    = explosionValue
  , bottom_value = 0
  , top_color    = gradientInput ? color.new(explosionColorInput, GRAD_TOP_TRANSP) : na
  , bottom_color = gradientInput ? color.new(explosionColorInput, GRAD_BOT_TRANSP) : na
  , title        = "Explosion Gradient")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullExplosion, "Bullish Explosion", "Waddah Attar Explosion on {{ticker}}: trend power broke above the explosion line with upward pressure - bullish momentum exceeds the volatility envelope ({{interval}})")
alertcondition(bearExplosion, "Bearish Explosion", "Waddah Attar Explosion on {{ticker}}: trend power broke above the explosion line with downward pressure - bearish momentum exceeds the volatility envelope ({{interval}})")
alertcondition(explosionEnd, "Explosion End", "Waddah Attar Explosion on {{ticker}}: trend power fell back below the explosion line - momentum no longer clears ambient volatility ({{interval}})")
alertcondition(deadZoneExit, "Dead Zone Exit", "Waddah Attar Explosion on {{ticker}}: trend power climbed out of the dead zone - readings are no longer treated as noise ({{interval}})")
alertcondition(bullFlip, "Bullish Direction Flip", "Waddah Attar Explosion on {{ticker}}: trend power flipped to upward pressure - green columns permit longs ({{interval}})")
alertcondition(bearFlip, "Bearish Direction Flip", "Waddah Attar Explosion on {{ticker}}: trend power flipped to downward pressure - red columns permit shorts ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
