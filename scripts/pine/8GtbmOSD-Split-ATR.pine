//@version=6
// Generated by build.py from src/indicator.pine. Do not edit.
// Edit the sources under src/ and re-run: python3 build.py
indicator("Split ATR", "Split ATR", overlay = true, behind_chart = false, explicit_plot_zorder = true)

import alodis/OKLCh/1 as oklch

// Parent timeframe for parentBarAtr in core.pine. Bound here, before the
// include, so `time(chartTf)` is a simple string.
string chartTf = timeframe.period

// >>> begin core.pine (from indicator.pine:10)
// ===========================================================================
// core.pine -- pure logic shared by the indicator and the test harness.
//
// A fragment, not a standalone script: build.py splices it into
// src/indicator.pine and src/test.pine so both run identical code.
// ===========================================================================

// Quadrant identifiers for the sign combinations of the price and volume
// change against the previous same-side partial.
const int Q_UP_VOL_UP = 0
const int Q_DOWN_VOL_UP = 1
const int Q_UP_VOL_DOWN = 2
const int Q_DOWN_VOL_DOWN = 3

// Gradient modes. See gradientColor at the bottom of this file.
const int MODE_QUADRANT = 0
const int MODE_BILINEAR = 1
const int MODE_POLAR = 2
const int MODE_VOLUME_HUE = 3

// How a slice sits relative to the two ATR intervals
// I_open = [Open − OpenATR, Open + OpenATR] and
// I_close = [Close − CloseATR, Close + CloseATR]. Hybrid coloring reads
// surprise as chroma: the core is washed out, the gap and the excursion
// tails keep the full volume-hue chroma.
const int KIND_NONE = -1
const int KIND_CORE = 0
const int KIND_DEPARTED = 1
const int KIND_ARRIVED = 2
const int KIND_GAP = 3
const int KIND_EXCURSION = 4

// A vertical slice of a bar: bounds [l, h], the bar's open and close clamped
// into those bounds, and the slice's share of the bar's volume.
type Partial
    float l
    float h
    float o
    float c
    float v

// One of the candles a bar is drawn as. `band` is the price-ordered slice
// (0 = lowest); `kind` is which of the two ATR intervals contain it. -1 on
// either field means the slot is not drawn.
type Segment
    float o
    float h
    float l
    float c
    int band
    int kind = -1

type Palette
    color upVolUp
    color downVolUp
    color upVolDown
    color downVolDown
    color neutral
    int minTransp
    int maxTransp
    int mode
    float armWidth
    float responseRamp
    // Volume-hue anchors, and how far below them a price-down bar renders.
    // Hybrid coloring keeps that hue and lightness split, then scales chroma
    // by ATR surprise: chromaFloor is the fraction kept at surprise 0 on a
    // solid body. A hollow body uses 1 − 0.5·(1 − chromaFloor).
    color volFalling = na
    color volFlat = na
    color volRising = na
    float lightSpan = 0.0
    float chromaFloor = 0.4

clampToRange(float v_, float l_, float h_) =>
    math.max(l_, math.min(h_, v_))

undrawnSegment() =>
    Segment.new(na, na, na, na, -1, KIND_NONE)

isDrawn(Segment s) =>
    not na(s.o)

// Closed-interval membership of a slice, judged at its midpoint so a band
// between two cuts has one kind. A missing interval is not a split: the
// whole bar is the core. A zero-height slice has no kind.
//
// "In neither" splits in two. When the intervals are disjoint, the open
// range between them is the gap -- price the bar traversed that neither
// endpoint's volatility envelope accounts for. Everything else in neither
// is outside both, the excursion tails.
membershipKind(float sliceL, float sliceH, float openLo, float openHi, float closeLo, float closeHi) =>
    int kind = KIND_NONE
    if sliceH > sliceL
        if na(openLo) or na(openHi) or na(closeLo) or na(closeHi)
            kind := KIND_CORE
        else
            float oLo = math.min(openLo, openHi)
            float oHi = math.max(openLo, openHi)
            float cLo = math.min(closeLo, closeHi)
            float cHi = math.max(closeLo, closeHi)
            float m = (sliceL + sliceH) / 2.0
            bool inOpen = m >= oLo and m <= oHi
            bool inClose = m >= cLo and m <= cHi
            if inOpen and inClose
                kind := KIND_CORE
            else if inOpen
                kind := KIND_DEPARTED
            else if inClose
                kind := KIND_ARRIVED
            else
                float overlapLo = math.max(oLo, cLo)
                float overlapHi = math.min(oHi, cHi)
                kind := overlapLo > overlapHi and m > overlapHi and m < overlapLo ? KIND_GAP : KIND_EXCURSION
    kind

// How surprising a slice is, in [0, 1]. The consensus core is unsurprising;
// open-only / close-only is half a step; the gap and the excursion tails are
// the event. Hybrid coloring reads this as chroma, not hue: see
// surpriseChromaScale and hybridVolumeColor. Color must be taken from the
// measurement partial, not the stretched display segment: a wick-only dash
// reaches the body edge, which would pull its midpoint onto the wrong side
// of a cut.
kindSurprise(int kind) =>
    float surprise = 0.0
    if kind == KIND_DEPARTED or kind == KIND_ARRIVED
        surprise := 0.5
    else if kind == KIND_GAP or kind == KIND_EXCURSION
        surprise := 1.0
    surprise

sliceSurprise(float sliceL, float sliceH, float openLo, float openHi, float closeLo, float closeHi) =>
    kindSurprise(membershipKind(sliceL, sliceH, openLo, openHi, closeLo, closeHi))

// Fraction of the volume-hue chroma a slice keeps. Surprise 0 keeps
// `chromaFloor`; surprise 1 keeps the full chroma; in between is linear.
surpriseChromaScale(float surprise, float chromaFloor) =>
    float floor_ = clampToRange(nz(chromaFloor), 0.0, 1.0)
    float t = clampToRange(nz(surprise), 0.0, 1.0)
    floor_ + t * (1.0 - floor_)

// Hollow (up) bodies are fill-faded, so their quiet floor sits halfway from
// `chromaFloor` to full chroma: 1 − 0.5·(1 − chromaFloor).
hollowChromaFloor(float chromaFloor) =>
    float floor_ = clampToRange(nz(chromaFloor), 0.0, 1.0)
    1.0 - 0.5 * (1.0 - floor_)

bandColor(int band, color c0, color c1, color c2, color c3, color c4) =>
    color out = c0
    if band == 1
        out := c1
    else if band == 2
        out := c2
    else if band == 3
        out := c3
    else if band == 4
        out := c4
    out

bandFloat(int band, float v0, float v1, float v2, float v3, float v4) =>
    float out = v0
    if band == 1
        out := v1
    else if band == 2
        out := v2
    else if band == 3
        out := v3
    else if band == 4
        out := v4
    out

// Four floats in ascending order. Used both to place the ATR cuts and to
// keep the unit cases free of array literals.
sortedCuts4(float a, float b, float c, float d) =>
    array<float> cuts = array.new<float>()
    array.push(cuts, a)
    array.push(cuts, b)
    array.push(cuts, c)
    array.push(cuts, d)
    array.sort(cuts)
    [array.get(cuts, 0), array.get(cuts, 1), array.get(cuts, 2), array.get(cuts, 3)]

// True range of a bar. A missing previous close (first bar) is just the
// height. Matches `ta.tr(true)`.
trueRange(float h, float l, float prevClose) =>
    float range_ = h - l
    na(prevClose) ? range_ : math.max(range_, math.max(math.abs(h - prevClose), math.abs(l - prevClose)))

// One Wilder ATR step after the SMA seed: ATR = ((n-1)·prev + TR) / n.
wilderAtrStep(float prevAtr, float tr, int n) =>
    int len = n < 1 ? 1 : n
    na(prevAtr) ? float(na) : (prevAtr * (len - 1) + tr) / len

// Put a different true range into an already-computed ATR. Uses the
// identity n·ATR = (n−1)·ATR[1] + TR, so it holds for both the SMA seed
// bar and later Wilder bars. When newTr equals chartTr the result is atr.
atrWithTr(float atr, float chartTr, float newTr, int n) =>
    int len = n < 1 ? 1 : n
    na(atr) or na(chartTr) or na(newTr) ? float(na) : (atr * len - chartTr + newTr) / len

// Chart-bar ATR sampled on a lower timeframe. The parent window resets at
// each `chartTf` boundary and grows: TR is the envelope of this chart bar so
// far against the previous chart bar's close. Wilder length is `n` parent
// bars, same as `ta.atr(n)` on the chart. During a parent the committed ATR
// stays put and only the developing TR changes, so the last sub-bar equals
// the chart ATR and the first is that ATR after one sub-bar.
//
// Call this once per script. It keeps `var` state. The parent timeframe is
// the global `chartTf` (must be a simple string, not a function argument,
// because `time()` will not take a series).
parentBarAtr(int n) =>
    int len = n < 1 ? 1 : n
    int parentT = time(chartTf)
    bool newParent = na(parentT[1]) or parentT != parentT[1]

    var float runH = float(na)
    var float runL = float(na)
    var float prevParentClose = float(na)
    var float lastTr = float(na)
    var float trSum = 0.0
    var int trCount = 0
    var float atrCommitted = float(na)

    if newParent
        if not na(lastTr)
            if trCount < len
                trCount += 1
                trSum += lastTr
                if trCount == len
                    atrCommitted := trSum / len
            else
                atrCommitted := wilderAtrStep(atrCommitted, lastTr, len)
        prevParentClose := close[1]
        runH := high
        runL := low
    else
        runH := math.max(runH, high)
        runL := math.min(runL, low)

    float trDev = trueRange(runH, runL, prevParentClose)
    lastTr := trDev

    float atrOut = float(na)
    if trCount + 1 < len
        atrOut := float(na)
    else if trCount + 1 == len
        atrOut := (trSum + trDev) / len
    else
        atrOut := wilderAtrStep(atrCommitted, trDev, len)
    atrOut

// Chart-bar ATR length expressed in lower-timeframe bars, so a 14-period
// window on a 5-minute chart is 70 one-minute bars. Rounds to nearest and
// never drops below 1.
scaleAtrLength(int chartLength, int chartSeconds, int ltfSeconds) =>
    int out = math.max(1, chartLength)
    if ltfSeconds > 0
        out := math.max(1, int(math.round(chartLength * float(chartSeconds) / float(ltfSeconds))))
    out

// The four split prices, unsorted identity: open ± open ATR, close ± close ATR.
// Sorted into price order so the bar is always cut bottom to top. A missing
// ATR is not a split, so all four come back na rather than sorting na values.
atrCutLevels(float o_, float c_, float openAtr, float closeAtr) =>
    float loOpen = o_ - openAtr
    float hiOpen = o_ + openAtr
    float loClose = c_ - closeAtr
    float hiClose = c_ + closeAtr
    float x0 = float(na)
    float x1 = float(na)
    float x2 = float(na)
    float x3 = float(na)
    if not na(loOpen) and not na(hiOpen) and not na(loClose) and not na(hiClose)
        [s0, s1, s2, s3] = sortedCuts4(loOpen, hiOpen, loClose, hiClose)
        x0 := s0
        x1 := s1
        x2 := s2
        x3 := s3
    [x0, x1, x2, x3]

makePartial(float o_, float c_, float v_, float sliceL, float sliceH) =>
    Partial.new(sliceL, sliceH, clampToRange(o_, sliceL, sliceH), clampToRange(c_, sliceL, sliceH), v_)

// Cuts a bar at four prices. The prices are sorted and clamped into [low, high],
// so a cut past the bar collapses onto the near extreme and a missing cut
// (any of the four is na) is not a split at all: band 0 takes the whole bar
// and the others collapse at the high, matching splitForDisplay which draws
// that bar whole and colors it from band 0.
//
// Volume is attributed by slice height, and the top slice takes the remainder
// so the five always sum to the bar. A zero-height bar has no meaningful
// split, so it divides evenly.
splitAtCuts(float o_, float h_, float l_, float c_, float v_, float a, float b, float c2, float d) =>
    float vol = nz(v_)
    float e0 = l_
    float e1 = h_
    float e2 = h_
    float e3 = h_
    float e4 = h_
    float e5 = h_
    if not na(a) and not na(b) and not na(c2) and not na(d)
        [cut0, cut1, cut2, cut3] = sortedCuts4(a, b, c2, d)
        e1 := clampToRange(cut0, l_, h_)
        e2 := clampToRange(cut1, l_, h_)
        e3 := clampToRange(cut2, l_, h_)
        e4 := clampToRange(cut3, l_, h_)
    float span = h_ - l_
    float v0 = span > 0.0 ? vol * (e1 - e0) / span : vol * 0.2
    float v1 = span > 0.0 ? vol * (e2 - e1) / span : vol * 0.2
    float v2 = span > 0.0 ? vol * (e3 - e2) / span : vol * 0.2
    float v3 = span > 0.0 ? vol * (e4 - e3) / span : vol * 0.2
    float v4 = vol - v0 - v1 - v2 - v3
    Partial p0 = makePartial(o_, c_, v0, e0, e1)
    Partial p1 = makePartial(o_, c_, v1, e1, e2)
    Partial p2 = makePartial(o_, c_, v2, e2, e3)
    Partial p3 = makePartial(o_, c_, v3, e3, e4)
    Partial p4 = makePartial(o_, c_, v4, e4, e5)
    [p0, p1, p2, p3, p4]

splitAtAtrBands(float o_, float h_, float l_, float c_, float v_, float openAtr, float closeAtr) =>
    splitAtCuts(o_, h_, l_, c_, v_, o_ - openAtr, o_ + openAtr, c_ - closeAtr, c_ + closeAtr)

// Aligns `drawn` to five plot slots, padding unused slots at the start of
// the draw order so the last plotcandle is always the last real piece -- the
// one that carries the close.
segmentSlot(array<Segment> drawn, int slot) =>
    int n = array.size(drawn)
    Segment s = undrawnSegment()
    int first = 5 - n
    if n > 0 and slot >= first and slot - first < n
        s := array.get(drawn, slot - first)
    s

classifySlice(float o_, float c_, float bodyLo, float bodyHi, float lo, float hi, int band, float openLo, float openHi, float closeLo, float closeHi) =>
    Segment s = undrawnSegment()
    if hi > lo
        int kind = membershipKind(lo, hi, openLo, openHi, closeLo, closeHi)
        // Wick-only pieces stretch to the body edge as a dash so the body
        // slice drawn on top hides it. Neighbours that meet inside the body
        // tile. The close-carrying piece is still last in splitForDisplay.
        if hi <= bodyLo
            s := Segment.new(bodyLo, bodyLo, lo, bodyLo, band, kind)
        else if lo >= bodyHi
            s := Segment.new(bodyHi, hi, bodyHi, bodyHi, band, kind)
        else
            s := Segment.new(clampToRange(o_, lo, hi), hi, lo, clampToRange(c_, lo, hi), band, kind)
    s

// The five candles a bar is drawn as, in draw order (back to front), cut at
// the endpoints of I_open and I_close.
//
// Wick-only slices (hi <= body low, or lo >= body high) are a dash at the
// body edge with the wick under them, drawn first so the body covers the
// dash. Body slices run from the far side of the close toward the close so
// the close-carrying piece paints on top. That is the same overdraw as
// Split VWAP, applied from the outside in, and it is what stops a seam from
// showing in the middle of a wick.
//
// A bar with no intervals is drawn whole, as the last piece, as the core.
splitForDisplay(float o_, float h_, float l_, float c_, float openLo, float openHi, float closeLo, float closeHi) =>
    array<Segment> drawn = array.new<Segment>()
    if na(openLo) or na(openHi) or na(closeLo) or na(closeHi) or h_ <= l_
        array.push(drawn, Segment.new(o_, h_, l_, c_, 0, KIND_CORE))
    else
        [cut0, cut1, cut2, cut3] = sortedCuts4(openLo, openHi, closeLo, closeHi)
        float e0 = l_
        float e1 = clampToRange(cut0, l_, h_)
        float e2 = clampToRange(cut1, l_, h_)
        float e3 = clampToRange(cut2, l_, h_)
        float e4 = clampToRange(cut3, l_, h_)
        float e5 = h_
        float bodyLo = math.min(o_, c_)
        float bodyHi = math.max(o_, c_)
        array<Segment> below = array.new<Segment>()
        array<Segment> above = array.new<Segment>()
        array<Segment> body = array.new<Segment>()
        Segment sl0 = classifySlice(o_, c_, bodyLo, bodyHi, e0, e1, 0, openLo, openHi, closeLo, closeHi)
        Segment sl1 = classifySlice(o_, c_, bodyLo, bodyHi, e1, e2, 1, openLo, openHi, closeLo, closeHi)
        Segment sl2 = classifySlice(o_, c_, bodyLo, bodyHi, e2, e3, 2, openLo, openHi, closeLo, closeHi)
        Segment sl3 = classifySlice(o_, c_, bodyLo, bodyHi, e3, e4, 3, openLo, openHi, closeLo, closeHi)
        Segment sl4 = classifySlice(o_, c_, bodyLo, bodyHi, e4, e5, 4, openLo, openHi, closeLo, closeHi)
        if isDrawn(sl0)
            if e1 <= bodyLo
                array.push(below, sl0)
            else if e0 >= bodyHi
                array.push(above, sl0)
            else
                array.push(body, sl0)
        if isDrawn(sl1)
            if e2 <= bodyLo
                array.push(below, sl1)
            else if e1 >= bodyHi
                array.push(above, sl1)
            else
                array.push(body, sl1)
        if isDrawn(sl2)
            if e3 <= bodyLo
                array.push(below, sl2)
            else if e2 >= bodyHi
                array.push(above, sl2)
            else
                array.push(body, sl2)
        if isDrawn(sl3)
            if e4 <= bodyLo
                array.push(below, sl3)
            else if e3 >= bodyHi
                array.push(above, sl3)
            else
                array.push(body, sl3)
        if isDrawn(sl4)
            if e5 <= bodyLo
                array.push(below, sl4)
            else if e4 >= bodyHi
                array.push(above, sl4)
            else
                array.push(body, sl4)
        int nBelow = array.size(below)
        if nBelow > 0
            for i = 0 to nBelow - 1
                array.push(drawn, array.get(below, i))
        int nAbove = array.size(above)
        if nAbove > 0
            for i = nAbove - 1 to 0
                array.push(drawn, array.get(above, i))
        int nBody = array.size(body)
        if nBody > 0
            if c_ >= o_
                for i = 0 to nBody - 1
                    array.push(drawn, array.get(body, i))
            else
                for i = nBody - 1 to 0
                    array.push(drawn, array.get(body, i))
        if array.size(drawn) == 0
            array.push(drawn, Segment.new(o_, h_, l_, c_, 0, KIND_CORE))
    [segmentSlot(drawn, 0), segmentSlot(drawn, 1), segmentSlot(drawn, 2), segmentSlot(drawn, 3), segmentSlot(drawn, 4)]

splitForAtrDisplay(float o_, float h_, float l_, float c_, float openAtr, float closeAtr) =>
    splitForDisplay(o_, h_, l_, c_, o_ - openAtr, o_ + openAtr, c_ - closeAtr, c_ + closeAtr)

// An unchanged or missing delta counts as "down", matching the way an
// unchanged open and close renders as a solid body.
classifyQuadrant(float dP, float dV) =>
    bool priceUp = dP > 0
    bool volUp = dV > 0
    int quadrant = priceUp ? (volUp ? Q_UP_VOL_UP : Q_UP_VOL_DOWN) : (volUp ? Q_DOWN_VOL_UP : Q_DOWN_VOL_DOWN)
    quadrant

// Change in an accumulating series against the same fraction of the previous
// bar, where `pace` is the share of the forming bar that has run.
//
// Volume on an unconfirmed bar is a partial sum: it starts near zero and
// climbs, so a plain difference reads as a collapse for most of the bar's life
// and only becomes true at the close. Against a matching fraction of the
// previous bar, a bar accumulating at last bar's rate reads as no change
// instead. The result is the full-bar projection multiplied by `pace`, so it
// carries the right sign from early on but is damped by exactly the confidence
// there is in it, and the bar starts neutral and firms up rather than starting
// at the extreme and walking back.
//
// A pace of 1 leaves a plain difference, na propagation included, so every
// confirmed bar is untouched. Price needs none of this: a close is a real
// current price at every instant, not a partial sum.
pacedDelta(float current, float previous, float pace) =>
    current - clampToRange(nz(pace, 1.0), 0.0, 1.0) * previous

// Scale that maps a series of bar-to-bar changes onto [-1, 1]: 2.5x the mean
// absolute change, which is close to two standard deviations for a well
// behaved distribution but is far less sensitive to the occasional volume
// spike than ta.stdev would be.
//
// Each series must be measured against its own dispersion. A partial's close
// is clamped into its own slice of the bar and its volume is a fraction of the
// bar's, so scales borrowed from the whole bar leave both weights short of the
// ends of the range and waste most of the palette.
deltaScale(float delta, int length) =>
    2.5 * ta.sma(math.abs(nz(delta)), length)

// Normalizes the raw deltas onto [-1, 1] so color intensity is comparable
// across symbols. A missing or non-positive scale yields a neutral weight
// rather than an unbounded one.
blendWeights(float dP, float dV, float pScale, float vScale) =>
    float priceScale = nz(pScale)
    float volScale = nz(vScale)
    float priceWeight = priceScale > 0 ? math.max(-1.0, math.min(1.0, dP / priceScale)) : 0.0
    float volWeight = volScale > 0 ? math.max(-1.0, math.min(1.0, dV / volScale)) : 0.0
    [nz(priceWeight), nz(volWeight)]

// The price half of blendWeights, for a palette that does not read volume.
priceWeight(float dP, float pScale) =>
    float scale = nz(pScale)
    scale > 0.0 ? math.max(-1.0, math.min(1.0, nz(dP) / scale)) : 0.0

isHollow(float o_, float c_) =>
    c_ > o_

// Fades a body against the color it is drawn from. Transparency composes on
// the remaining opacity, so a body `transp` transparent over a color the
// gradient already faded stays the fainter of the two. `color.new` alone would
// set it absolutely and throw the gradient's own ramp away, leaving a quiet
// bar's fill more opaque than its own border.
fadeBody(color c, float transp) =>
    float base = color.t(c)
    color.new(c, base + (100.0 - base) * transp / 100.0)

cornerColor(Palette p, int q) =>
    switch q
        Q_UP_VOL_UP => p.upVolUp
        Q_DOWN_VOL_UP => p.downVolUp
        Q_UP_VOL_DOWN => p.upVolDown
        => p.downVolDown

// The corners bounding one 90-degree sector of the weight plane. Sector 0
// starts at the up/volume-up corner and they run anticlockwise from there,
// which is the order the corners sit in around the plane.
sectorCorners(Palette p, int sector) =>
    color from_ = switch sector
        0 => p.upVolUp
        1 => p.downVolUp
        2 => p.downVolDown
        => p.upVolDown
    color to_ = switch sector
        0 => p.downVolUp
        1 => p.downVolDown
        2 => p.upVolDown
        => p.upVolUp
    [from_, to_]

// Eases the sweep across a sector so more of it stays near the anchor hue and
// the transition between anchors is quicker. Widens the recognizable wedge of
// each quadrant without introducing a discontinuity. 1.0 is a plain linear
// sweep; lower values widen further.
armEase(float t, float width) =>
    float eased = t
    if width < 1.0
        float exponent = 1.0 / width
        float a = math.pow(t, exponent)
        float b = math.pow(1.0 - t, exponent)
        eased := a + b > 0.0 ? a / (a + b) : t
    eased

// Hue from the direction of the change, chroma and lightness from its size.
// The corner directions land on their palette color exactly: the sector
// parameter is zero there and the magnitude is one.
polarColor(Palette p, float priceWeight, float volWeight, float magnitude) =>
    float angle = oklch.wrapHue(oklch.atan2Degrees(volWeight, priceWeight) - 45.0)
    int sector = int(math.min(3.0, math.floor(angle / 90.0)))
    float t = armEase((angle - sector * 90.0) / 90.0, p.armWidth)
    [fromColor, toColor] = sectorCorners(p, sector)
    [fromL, fromC, fromH] = oklch.colorToOklch(fromColor)
    [toL, toC, toH] = oklch.colorToOklch(toColor)
    [neutralL, neutralC, neutralH] = oklch.colorToOklch(p.neutral)
    float hue = oklch.wrapHue(fromH + t * oklch.shortestHueArc(fromH, toH))
    float chroma = (fromC + t * (toC - fromC)) * math.pow(magnitude, p.responseRamp)
    float lightness = neutralL + magnitude * (fromL + t * (toL - fromL) - neutralL)
    oklch.oklchToColor(lightness, chroma, hue)

// Hue from the volume change, one of two lightness bands from the price
// change.
//
// The volume weight sweeps the hue along one continuum: the falling anchor at
// -1, the flat anchor at 0, the rising anchor at +1. Each arm is interpolated
// on its own, so the two need not cover the same distance around the wheel.
// The price change then picks a band: up renders at the anchors' own lightness,
// down a `lightSpan` below it. The split is deliberately binary. Direction is
// the thing being read here, and grading it by size only made small moves
// ambiguous while costing the anchors their exact color.
//
// Dropping below the anchors' lightness costs chroma, because sRGB is widest
// in the middle and narrows toward both ends. The chroma the anchors ask for is
// therefore fitted to what is available in the band the price lands in; the
// light band is the anchors' own, so it always holds what they ask for.
volumeHueParts(Palette p, float priceWeight, float volWeight) =>
    color endAnchor = volWeight >= 0.0 ? p.volRising : p.volFalling
    float t = math.min(1.0, math.abs(volWeight))
    [flatL, flatC, flatH] = oklch.colorToOklch(p.volFlat)
    [endL, endC, endH] = oklch.colorToOklch(endAnchor)
    float hue = oklch.wrapHue(flatH + t * oklch.shortestHueArc(flatH, endH))
    float chroma = flatC + t * (endC - flatC)
    float anchorL = flatL + t * (endL - flatL)
    // The price change picks one of two bands rather than sliding between
    // them. The anchors are the light band, so an up bar reproduces the input
    // color exactly and a down bar is the same hue a span darker. An
    // unchanged change counts as down, the convention the whole script uses --
    // see classifyQuadrant and isHollow. A missing one lands there too, since
    // gradientColor has already turned it into a zero weight.
    float lightness = clampToRange(priceWeight > 0.0 ? anchorL : anchorL - p.lightSpan, 0.0, 1.0)
    [lightness, chroma, hue]

volumeHueColor(Palette p, float priceWeight, float volWeight) =>
    [lightness, chroma, hue] = volumeHueParts(p, priceWeight, volWeight)
    oklch.oklchToColor(lightness, oklch.fitChroma(lightness, chroma, hue), hue)

// Hybrid: the volume-hue ramp's hue and lightness, with chroma scaled by
// ATR surprise. A surprising slice (gap, excursion) keeps the full chroma;
// an unsurprising core is multiplied down to `chromaFloor`, or to the
// hollow floor `1 − 0.5·(1 − chromaFloor)` on an up body. At surprise 1
// this is identical to volumeHueColor.
hybridVolumeColor(Palette p, float priceWeight, float volWeight, float surprise, bool hollow) =>
    [lightness, chroma, hue] = volumeHueParts(p, priceWeight, volWeight)
    float floor_ = hollow ? hollowChromaFloor(p.chromaFloor) : p.chromaFloor
    float scaled = chroma * surpriseChromaScale(surprise, floor_)
    oklch.oklchToColor(lightness, oklch.fitChroma(lightness, scaled, hue), hue)

// Quadrant mode keeps the four hues exact and lets magnitude drive saturation
// and opacity, so a quiet bar washes out toward neutral. Magnitude is
// Euclidean and scaled so only the true corners of the weight square reach
// full strength; a move on one axis alone stays off the vertex.
//
// Bilinear mode blends the four corners continuously along the shortest hue
// arc. It is kept for continuity, but the hue field it produces has two
// singular columns: one where the two rows share a hue and the whole column
// flattens, another where they are antipodal and the shortest arc flips.
// Neither sits at the center unless the corner hues are chosen to put it
// there.
//
// Polar mode reads the weights as an angle and a radius rather than as two
// independent axes, which is what they are. Angle picks the hue by
// interpolating around the four corners in OKLCh, radius drives chroma and
// lightness. The center is achromatic by construction, so there is no
// singular column and no collision between "no change" and a real corner.
//
// Volume-hue mode drops the four corners entirely and gives each axis its own
// visual channel: hue for the volume change, one of two lightness bands for the
// price change. Nothing is left for magnitude to fade toward, so "no change" is
// the flat anchor darkened rather than gray, and both axes stay readable at
// once instead of collapsing into a single direction-and-distance reading.
//
// The quadrant and polar ramps raise magnitude to `responseRamp` before it
// drives color, so an exponent below one reaches most of the corner's
// colorfulness earlier and only the genuinely quiet bars stay washed out. It
// deliberately does not touch the rim: at a shared lightness two of the four
// default hues already sit on the sRGB boundary, so pushing chroma past the
// corner value would clip them while the other two kept going. Volume-hue mode
// does not read it at all: its lightness split is binary, so there is nothing
// for an exponent to reshape. Transparency follows the raw magnitude in every
// mode, so a palette can use it as an independent lever -- or flatten it by
// setting both ends the same, which is what the split candles need, since a
// faded candle cannot hide the one it is drawn over.
gradientColor(Palette p, float pW, float vW) =>
    float priceWeight = nz(pW)
    float volWeight = nz(vW)
    float magnitude = math.min(1.0, math.sqrt(priceWeight * priceWeight + volWeight * volWeight) / math.sqrt(2.0))
    float ramp = p.maxTransp - magnitude * (p.maxTransp - p.minTransp)
    int transparency = int(math.round(math.max(0, math.min(100, ramp))))
    color result = na
    if p.mode == MODE_BILINEAR
        color volUpRow = oklch.mixHueGradient(priceWeight, -1.0, 1.0, p.downVolUp, p.upVolUp)
        color volDownRow = oklch.mixHueGradient(priceWeight, -1.0, 1.0, p.downVolDown, p.upVolDown)
        result := color.new(oklch.mixHueGradient(volWeight, -1.0, 1.0, volDownRow, volUpRow), p.minTransp)
    else if p.mode == MODE_POLAR
        result := color.new(polarColor(p, priceWeight, volWeight, magnitude), transparency)
    else if p.mode == MODE_VOLUME_HUE
        result := color.new(volumeHueColor(p, priceWeight, volWeight), transparency)
    else
        color corner = cornerColor(p, classifyQuadrant(priceWeight, volWeight))
        result := color.new(oklch.mixHueGradient(math.pow(magnitude, p.responseRamp), 0.0, 1.0, p.neutral, corner), transparency)
    result
// <<< end core.pine

const string LTF_AUTO = "Auto (1/5 of chart)"
const string LTF_CUSTOM = "Custom"

// ===========================================================================
// Inputs
//
// Everything here is `display.none`: the settings dialog is where these are
// read, and echoing them next to the script title only crowds the status line.
// input.bool and input.color already default to that, so only the
// value-bearing inputs have to say so.
// ===========================================================================

string ltfChoice = input.string(LTF_AUTO, "Lower timeframe", options = [LTF_AUTO, LTF_CUSTOM], tooltip = "ATR is read off a lower timeframe so each chart bar has an open ATR (first sub-bar) and a close ATR (last sub-bar). Auto uses one-fifth of the chart: 1 minute on a 5-minute chart, 3 minutes on a 15-minute chart, and so on. Custom is for pairing a specific sub-bar size by hand. The lower timeframe must be shorter than the chart.", group = "ATR", display = display.none)
string ltfCustom = input.timeframe("1", "Custom lower timeframe", tooltip = "Used when Lower timeframe is Custom. 1 minute on a 5-minute chart is the pairing this indicator is built around.", group = "ATR", display = display.none)
int atrLength = input.int(14, "ATR length", minval = 1, tooltip = "Wilder length in chart bars, the same n as ta.atr(n) on this chart. Close ATR is that value. Open ATR is the same average with this bar's true range replaced by the first sub-bar's true range.", group = "ATR", display = display.none)
float atrMult = input.float(0.5, "ATR multiplier", minval = 0.01, step = 0.05, tooltip = "Scales both ATR values before the cuts are placed. The two intervals are Open ± OpenATR and Close ± CloseATR.", group = "ATR", display = display.none)
bool showLevels = input.bool(false, "Mark the four ATR endpoints with dots", group = "ATR")
int levelSize = input.int(2, "Dot size", minval = 1, maxval = 4, group = "ATR", display = display.none)

int volumeScaleLength = input.int(20, "Volume change scale (bars)", minval = 2, tooltip = "Lookback for the average absolute change in the bar's volume. Hue is a whole-bar reading: every slice of this bar shares it.", group = "Volume hue ramp", display = display.none)
int minTransparency = input.int(0, "Split candle transparency", minval = 0, maxval = 100, tooltip = "Flat transparency for the five split candles. Wick-only pieces are drawn first as a dash at the body edge; the body on top has to be opaque to hide that dash. Anything above 0 lets the covered wick show through as a seam.", group = "Volume hue ramp", display = display.none)

// The volume-hue anchors, which are the colors an up slice of a fully
// surprising band renders in exactly. Falling is red on the orange side of
// the wheel (hue 29), rising is blue just shy of indigo (hue 274), and the
// flat anchor sits halfway between them at 151.5. All three sit at a shared
// lightness of 0.68, so a down slice drops the same distance whatever the
// volume did.
color colorVolFalling = input.color(#ea6c5c, "Falling volume", group = "Volume hue ramp")
color colorVolFlat = input.color(#36b364, "Unchanged volume", group = "Volume hue ramp")
color colorVolRising = input.color(#7b8efa, "Rising volume", group = "Volume hue ramp")
float lightnessSpan = input.float(0.16, "Price down darkening", minval = 0.02, maxval = 0.35, step = 0.01, tooltip = "How far below the anchor color a down bar renders, in OKLCh lightness. The anchors are the light band, so a bar whose close is at or above the previous close is the input color exactly and a down bar is the same hue this much darker. Every slice of the bar shares that lightness.", group = "Volume hue ramp", display = display.none)
float unsurprisingChroma = input.float(0.4, "Unsurprising chroma", minval = 0.0, maxval = 1.0, step = 0.05, tooltip = "Fraction of the volume-hue chroma kept at surprise 0 on a solid (down) body. 0 is gray at that lightness; 1 leaves chroma untouched so surprise does not read. A hollow (up) body uses a higher floor, halfway from this value to full chroma. Gap and excursion always keep the full chroma; departed and arrived sit halfway.", group = "Volume hue ramp", display = display.none)
int bodyTransparency = input.int(80, "Up-body fill transparency", minval = 0, maxval = 100, tooltip = "How much of an up body is filled. 100 is a fully hollow body, 0 fills it like a down body. The default leaves a faint wash so an up body reads as hollow while still hinting at its color. Wick and border stay opaque so the overdraw still hides the dash under a hollow middle.", group = "Volume hue ramp", display = display.none)

// Candle transparency is flat: the piece drawn on top only hides the dash
// beneath it if it is opaque. Unused quadrant fields are filled so the
// Palette constructor is complete; hybridVolumeColor does not read them.
var Palette candlePalette = Palette.new(colorVolRising, colorVolFalling, colorVolRising, colorVolFalling, #808080, minTransparency, minTransparency, MODE_VOLUME_HUE, 0.8, 1.0, colorVolFalling, colorVolFlat, colorVolRising, lightnessSpan, unsurprisingChroma)

// ===========================================================================
// Lower-timeframe ATR
// ===========================================================================

timeframeFromSeconds(int secs) =>
    int n = math.max(1, secs)
    string tf = str.tostring(n) + "S"
    if n % 86400 == 0
        tf := str.tostring(int(n / 86400)) + "D"
    else if n % 60 == 0
        tf := str.tostring(int(n / 60))
    tf

int chartSeconds = timeframe.in_seconds()
int autoLtfSeconds = math.max(1, int(math.round(chartSeconds / 5.0)))
string autoLtf = timeframeFromSeconds(autoLtfSeconds)
string ltf = ltfChoice == LTF_CUSTOM ? ltfCustom : autoLtf

int ltfSeconds = timeframe.in_seconds(ltf)
if barstate.islast and ltfSeconds >= chartSeconds
    runtime.error("Split ATR: the lower timeframe must be shorter than the chart timeframe (1 minute on a 5-minute chart). Pick a shorter Custom lower timeframe, or use Auto.")

// Close ATR is the chart's own ta.atr, so it matches a 14-period ATR on this
// pane. Open ATR is that same Wilder state with this bar's true range swapped
// for the first sub-bar's: (n·ATR − TR + TR_first) / n. Until a second
// sub-bar appears, those TRs are the same and the two ATRs match.
float chartAtr = ta.atr(atrLength)
float chartTr = ta.tr(true)
array<float> ltfHigh = request.security_lower_tf(syminfo.tickerid, ltf, high, ignore_invalid_timeframe = true)
array<float> ltfLow = request.security_lower_tf(syminfo.tickerid, ltf, low, ignore_invalid_timeframe = true)

float firstTr = float(na)
if not na(ltfHigh) and not na(ltfLow) and array.size(ltfHigh) > 0 and array.size(ltfLow) > 0
    firstTr := trueRange(array.first(ltfHigh), array.first(ltfLow), close[1])

float closeAtr = na(chartAtr) ? float(na) : chartAtr * atrMult
float openAtr = closeAtr
if not na(chartAtr) and not na(firstTr)
    openAtr := atrWithTr(chartAtr, chartTr, firstTr, atrLength) * atrMult

float openLo = open - openAtr
float openHi = open + openAtr
float closeLo = close - closeAtr
float closeHi = close + closeAtr

// Measurement partition: tiled [low, high], used for surprise (membership of
// the slice midpoint). Display geometry is a different partition -- wick-only
// pieces stretch to the body -- so color must not be read from the drawn
// candles.
[p0, p1, p2, p3, p4] = splitAtAtrBands(open, high, low, close, nz(volume), openAtr, closeAtr)
[s0, s1, s2, s3, s4] = splitForAtrDisplay(open, high, low, close, openAtr, closeAtr)

// Volume is a whole-bar reading. Only the volume delta is paced, because
// only it accumulates; see pacedDelta in core.pine. Missing volume (an
// index, a cash contract) is treated as zero, so hue sits on the
// unchanged-volume anchor and the ATR split still draws.
float barSpan = time_close - time
bool paceReadable = not barstate.isconfirmed and chart.is_standard and not timeframe.isticks and nz(barSpan) > 0
float barPace = paceReadable ? clampToRange((timenow - time) / barSpan, 0.0, 1.0) : 1.0
float barVolume = nz(volume)
float barVolumeDelta = pacedDelta(barVolume, barVolume[1], barPace)
float barVolumeScale = deltaScale(barVolumeDelta, volumeScaleLength)
float barVolumeWeight = priceWeight(barVolumeDelta, barVolumeScale)

// Lightness is a whole-bar bit: close at or above the previous close is
// the light band, otherwise the dark band. Every slice shares it.
float barPriceWeight = close >= nz(close[1], close) ? 1.0 : -1.0

float p0Surprise = sliceSurprise(p0.l, p0.h, openLo, openHi, closeLo, closeHi)
float p1Surprise = sliceSurprise(p1.l, p1.h, openLo, openHi, closeLo, closeHi)
float p2Surprise = sliceSurprise(p2.l, p2.h, openLo, openHi, closeLo, closeHi)
float p3Surprise = sliceSurprise(p3.l, p3.h, openLo, openHi, closeLo, closeHi)
float p4Surprise = sliceSurprise(p4.l, p4.h, openLo, openHi, closeLo, closeHi)

// Hue is the bar's volume change; lightness is the bar's close versus the
// previous close; chroma is each slice's ATR surprise, with a higher floor
// on hollow (up) bodies so the faded fill still reads.
sliceColor(Segment s, float s0, float s1, float s2, float s3, float s4) =>
    float surprise = bandFloat(s.band, s0, s1, s2, s3, s4)
    bool hollow = isHollow(s.o, s.c)
    color.new(hybridVolumeColor(candlePalette, barPriceWeight, barVolumeWeight, surprise, hollow), minTransparency)

color s0Color = sliceColor(s0, p0Surprise, p1Surprise, p2Surprise, p3Surprise, p4Surprise)
color s1Color = sliceColor(s1, p0Surprise, p1Surprise, p2Surprise, p3Surprise, p4Surprise)
color s2Color = sliceColor(s2, p0Surprise, p1Surprise, p2Surprise, p3Surprise, p4Surprise)
color s3Color = sliceColor(s3, p0Surprise, p1Surprise, p2Surprise, p3Surprise, p4Surprise)
color s4Color = sliceColor(s4, p0Surprise, p1Surprise, p2Surprise, p3Surprise, p4Surprise)
color barColor = color.new(hybridVolumeColor(candlePalette, barPriceWeight, barVolumeWeight, 1.0, false), minTransparency)

// Hollow-up applies to every real body, including the core in the middle.
// Wick and border stay the opaque band color so a hollow fill does not let
// the dash underneath show through.
color s0Body = isHollow(s0.o, s0.c) ? fadeBody(s0Color, bodyTransparency) : s0Color
color s1Body = isHollow(s1.o, s1.c) ? fadeBody(s1Color, bodyTransparency) : s1Color
color s2Body = isHollow(s2.o, s2.c) ? fadeBody(s2Color, bodyTransparency) : s2Color
color s3Body = isHollow(s3.o, s3.c) ? fadeBody(s3Color, bodyTransparency) : s3Color
color s4Body = isHollow(s4.o, s4.c) ? fadeBody(s4Color, bodyTransparency) : s4Color

// ===========================================================================
// Plots
// ===========================================================================

// Pine cannot hide the chart symbol itself. `barcolor` can only clear the
// native body; wicks and borders stay. The split candles sit in front
// (`behind_chart = false`), and the cover candle paints the rest with the
// chart background so hollow bodies do not show the native candle through
// them.
//
// The candle plots are `display.pane`. Open ATR and close ATR keep
// status-line and Data Window display, so those two values are what the
// title reports. `barcolor` cannot be quietened: its `display` takes only
// display.none or display.all, and display.none would stop it clearing the
// native body. It takes the closing segment's color so the status-line
// swatch matches the piece drawn on top.
barcolor(s4Color, title = "Hide chart body", editable = false)
plotcandle(open, high, low, close, title = "Hide chart bars", color = chart.bg_color, wickcolor = chart.bg_color, bordercolor = chart.bg_color, display = display.pane, editable = false)
plotcandle(s0.o, s0.h, s0.l, s0.c, title = "Split candle 1", color = s0Body, wickcolor = s0Color, bordercolor = s0Color, display = display.pane)
plotcandle(s1.o, s1.h, s1.l, s1.c, title = "Split candle 2", color = s1Body, wickcolor = s1Color, bordercolor = s1Color, display = display.pane)
plotcandle(s2.o, s2.h, s2.l, s2.c, title = "Split candle 3", color = s2Body, wickcolor = s2Color, bordercolor = s2Color, display = display.pane)
plotcandle(s3.o, s3.h, s3.l, s3.c, title = "Split candle 4", color = s3Body, wickcolor = s3Color, bordercolor = s3Color, display = display.pane)
plotcandle(s4.o, s4.h, s4.l, s4.c, title = "Split candle 5, closing side", color = s4Body, wickcolor = s4Color, bordercolor = s4Color, display = display.pane)
plot(showLevels ? openLo : na, "Open − Open ATR", color = barColor, style = plot.style_circles, linewidth = levelSize, display = display.pane)
plot(showLevels ? openHi : na, "Open + Open ATR", color = barColor, style = plot.style_circles, linewidth = levelSize, display = display.pane)
plot(showLevels ? closeLo : na, "Close − Close ATR", color = barColor, style = plot.style_circles, linewidth = levelSize, display = display.pane)
plot(showLevels ? closeHi : na, "Close + Close ATR", color = barColor, style = plot.style_circles, linewidth = levelSize, display = display.pane)
plot(openAtr, "Open ATR", display = display.status_line + display.data_window)
plot(closeAtr, "Close ATR", display = display.status_line + display.data_window)
