indicator("Sector Rotation (Zeiierman)", overlay=false, max_labels_count=500, max_boxes_count=20, max_lines_count=500, dynamic_requests=true)
//}

// ~~ Tooltips {
var string t1  = "Benchmark symbol every sector is measured against. Each sector's price is divided by this to compute relative strength. Use a broad index (e.g. VTI, SPY) for US sectors. Changing it re-bases the whole chart."
var string t2  = "Timeframe used for all calculations. Leave blank to use the chart's timeframe. Set a higher TF (e.g. 'W') to see longer-term rotation regardless of the chart you're viewing."
var string t3  = "Lookback (in samples) for normalizing RS-Ratio into a z-score around 100. Higher = smoother, slower-moving tails that reflect longer trends. Lower = more reactive but noisier. ~60 suits swing/position views."
var string t4  = "Lookback for the rate-of-change used to build RS-Momentum (the Y axis). Higher = smoother momentum that lags turns; lower = faster but choppier. Controls how quickly a sector swings up/down between quadrants."
var string t5  = "Number of past samples kept in each sector's trail. Longer tails show more rotation history but add clutter and more drawing objects. Shorter tails keep the chart clean and focus on recent movement."
var string t6  = "Spacing between recorded points, in bars. A new tail point is captured every N confirmed bars. Larger values spread the tail over a longer period (less noise); smaller values capture finer movement."
var string t7  = "Show the summary table (top-right) listing each visible sector's phase, heading, RS and momentum values. Turn off for a cleaner chart. The table always clears when a sector is hidden."
var string t8  = "When on, only the highest-scoring sectors are drawn (others are hidden). Useful to focus on the most actionable rotations. Combine with 'Rank By' and 'Top X' to define what 'best' means."
var string t9  = "How many sectors to keep when ranking is enabled. e.g. 5 shows only the top 5 by the selected ranking mode. Ignored when 'Only Show Top Ranked' is off."
var string t10 = "Defines the ranking score. 'Fastest movement' favors sectors moving the most between samples. 'Toward X' favors sectors moving most directly toward that quadrant — useful for spotting early rotations into Leading/Recovering."
var string t11 = "Toggle this sector on/off. Hidden sectors are excluded from the chart, the table, ranking and axis auto-scaling."
var string t12 = "Symbol (ETF or ticker) representing this sector. Swap to track a different sector, country or asset against the same benchmark."
var string t13 = "Color used for this sector's tail and head marker. Pick distinct colors so overlapping trails stay readable."
var string t14 = "Marker/line thickness for this sector (1–5). Larger emphasizes the sector; the tail also fades from thin/faint (old) to thick/solid (newest)."
var string t15 = "Horizontal width of the plotting canvas, in bars. Wider spreads sectors out for easier reading; narrower compresses them. Visual only — does not affect calculations."
var string t16 = "Vertical height of the plotting canvas, in price units. Larger stretches the chart vertically. Visual only — does not affect calculations."
var string t17 = "When on, axes are centered symmetrically around the 100 baseline so the four quadrants stay balanced. When off, axes auto-fit tightly to the data range, which can off-center the cross."
var string t18 = "Minimum span each axis is allowed to cover. Prevents the chart from zooming in so far that tiny movements look huge. Raise it to dampen sensitivity when sectors are tightly clustered."
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Inputs {
benchmark = input.symbol("VTI", "Benchmark", group="Data", tooltip=t1)
tfOpt     = input.timeframe("", "Calculation Timeframe", group="Data", tooltip=t2)

rsLen       = input.int(60, "RS-Ratio Lookback",   minval=5, group="Calculation", tooltip=t3)
momLen      = input.int(10, "RS-Momentum Lookback", minval=1, group="Calculation", tooltip=t4)
tailLen     = input.int(6, "Tail Length (samples)", minval=2, maxval=40, group="Calculation", tooltip=t5)
sampleEvery = input.int(5,  "Sample Every N Bars",  minval=1, group="Calculation", tooltip=t6)

showTable = input.bool(true,  "Show Sector Table", group="Table", tooltip=t7)

useRanking = input.bool(false, "Only Show Top Ranked", group="Ranking", tooltip=t8)
topRankN   = input.int(5, "Top X", minval=1, maxval=11, group="Ranking", tooltip=t9)
rankMode   = input.string("Fastest movement", "Rank By", options=["Fastest movement","Toward Leading","Toward Recovering","Toward Lagging","Toward Weakening"], group="Ranking", tooltip=t10)

show1  = input.bool(true,"Energy",group="Sectors",inline="s1",tooltip=t11)
sym1   = input.symbol("XLE","",group="Sectors",inline="s1",tooltip=t12)
col1   = input.color(color.rgb(255,87,34),"",group="Sectors",inline="s1",tooltip=t13)
sz1    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s1",tooltip=t14)
show2  = input.bool(true,"Materials",group="Sectors",inline="s2",tooltip=t11)
sym2   = input.symbol("XLB","",group="Sectors",inline="s2",tooltip=t12)
col2   = input.color(color.rgb(121,85,72),"",group="Sectors",inline="s2",tooltip=t13)
sz2    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s2",tooltip=t14)
show3  = input.bool(true,"Industrials",group="Sectors",inline="s3",tooltip=t11)
sym3   = input.symbol("XLI","",group="Sectors",inline="s3",tooltip=t12)
col3   = input.color(color.rgb(96,125,139),"",group="Sectors",inline="s3",tooltip=t13)
sz3    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s3",tooltip=t14)
show4  = input.bool(true,"Consumer Discretionary",group="Sectors",inline="s4",tooltip=t11)
sym4   = input.symbol("XLY","",group="Sectors",inline="s4",tooltip=t12)
col4   = input.color(color.orange,"",group="Sectors",inline="s4",tooltip=t13)
sz4    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s4",tooltip=t14)
show5  = input.bool(true,"Consumer Staples",group="Sectors",inline="s5",tooltip=t11)
sym5   = input.symbol("XLP","",group="Sectors",inline="s5",tooltip=t12)
col5   = input.color(color.green,"",group="Sectors",inline="s5",tooltip=t13)
sz5    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s5",tooltip=t14)
show6  = input.bool(true,"Health Care",group="Sectors",inline="s6",tooltip=t11)
sym6   = input.symbol("XLV","",group="Sectors",inline="s6",tooltip=t12)
col6   = input.color(color.red,"",group="Sectors",inline="s6",tooltip=t13)
sz6    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s6",tooltip=t14)
show7  = input.bool(true,"Financials",group="Sectors",inline="s7",tooltip=t11)
sym7   = input.symbol("XLF","",group="Sectors",inline="s7",tooltip=t12)
col7   = input.color(color.blue,"",group="Sectors",inline="s7",tooltip=t13)
sz7    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s7",tooltip=t14)
show8  = input.bool(true,"Technology",group="Sectors",inline="s8",tooltip=t11)
sym8   = input.symbol("XLK","",group="Sectors",inline="s8",tooltip=t12)
col8   = input.color(color.aqua,"",group="Sectors",inline="s8",tooltip=t13)
sz8    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s8",tooltip=t14)
show9  = input.bool(true,"Communication",group="Sectors",inline="s9",tooltip=t11)
sym9   = input.symbol("XLC","",group="Sectors",inline="s9",tooltip=t12)
col9   = input.color(color.fuchsia,"",group="Sectors",inline="s9",tooltip=t13)
sz9    = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s9",tooltip=t14)
show10 = input.bool(true,"Utilities",group="Sectors",inline="s10",tooltip=t11)
sym10  = input.symbol("XLU","",group="Sectors",inline="s10",tooltip=t12)
col10  = input.color(color.rgb(99,102,241),"",group="Sectors",inline="s10",tooltip=t13)
sz10   = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s10",tooltip=t14)
show11 = input.bool(true,"Real Estate",group="Sectors",inline="s11",tooltip=t11)
sym11  = input.symbol("XLRE","",group="Sectors",inline="s11",tooltip=t12)
col11  = input.color(color.teal,"",group="Sectors",inline="s11",tooltip=t13)
sz11   = input.int(4,"",minval=1,maxval=5,group="Sectors",inline="s11",tooltip=t14)

chartBars    = input.int(160,   "Canvas Width (bars)",   minval=60, maxval=300, group="Canvas", tooltip=t15)
canvasHeight = input.float(100, "Canvas Height (units)", minval=10, group="Canvas", tooltip=t16)
symBounds    = input.bool(true, "Symmetric Bounds Around 100", group="Canvas", tooltip=t17)
minSpan      = input.float(2.0, "Minimum Axis Span", minval=0.5, group="Canvas", tooltip=t18)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Data + Normalized RS / Momentum {
benchClose = request.security(benchmark, tfOpt, close)

// Returns [RS-Ratio, RS-Momentum], both z-scored around 100.
metrics(string _sym) =>
    sc    = request.security(_sym, tfOpt, close)
    ratio = (not na(sc) and not na(benchClose) and benchClose != 0) ? sc / benchClose : na
    basis = ta.sma(ratio, rsLen)
    sd    = ta.stdev(ratio, rsLen)
    rsr   = (not na(sd) and sd != 0) ? 100.0 + (ratio - basis) / sd : na
    roc   = rsr - rsr[momLen]
    mb    = ta.sma(roc, rsLen)
    msd   = ta.stdev(roc, rsLen)
    rsm   = (not na(msd) and msd != 0) ? 100.0 + (roc - mb) / msd : na
    [rsr, rsm]

[rs1,mom1]   = metrics(sym1)
[rs2,mom2]   = metrics(sym2)
[rs3,mom3]   = metrics(sym3)
[rs4,mom4]   = metrics(sym4)
[rs5,mom5]   = metrics(sym5)
[rs6,mom6]   = metrics(sym6)
[rs7,mom7]   = metrics(sym7)
[rs8,mom8]   = metrics(sym8)
[rs9,mom9]   = metrics(sym9)
[rs10,mom10] = metrics(sym10)
[rs11,mom11] = metrics(sym11)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Synchronized history (newest at index 0) {
mkArr() => array.new_float()
var rsA1  = mkArr()
var mA1   = mkArr()
var rsA2  = mkArr()
var mA2   = mkArr()
var rsA3  = mkArr()
var mA3   = mkArr()
var rsA4  = mkArr()
var mA4   = mkArr()
var rsA5  = mkArr()
var mA5   = mkArr()
var rsA6  = mkArr()
var mA6   = mkArr()
var rsA7  = mkArr()
var mA7   = mkArr()
var rsA8  = mkArr()
var mA8   = mkArr()
var rsA9  = mkArr()
var mA9   = mkArr()
var rsA10 = mkArr()
var mA10  = mkArr()
var rsA11 = mkArr()
var mA11  = mkArr()

sampleNow = barstate.isconfirmed and (bar_index % sampleEvery == 0)

push(array<float> ax, array<float> ay, float x, float y) =>
    if sampleNow and not na(x) and not na(y)
        ax.unshift(x)
        ay.unshift(y)
        if ax.size() > tailLen
            ax.pop()
            ay.pop()

push(rsA1,mA1,rs1,mom1)
push(rsA2,mA2,rs2,mom2)
push(rsA3,mA3,rs3,mom3)
push(rsA4,mA4,rs4,mom4)
push(rsA5,mA5,rs5,mom5)
push(rsA6,mA6,rs6,mom6)
push(rsA7,mA7,rs7,mom7)
push(rsA8,mA8,rs8,mom8)
push(rsA9,mA9,rs9,mom9)
push(rsA10,mA10,rs10,mom10)
push(rsA11,mA11,rs11,mom11)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Data bounds (enabled sectors only) {
minArr(array<float> a) =>
    float m = na
    if a.size() > 0
        for i = 0 to a.size() - 1
            v = a.get(i)
            m := na(m) ? v : math.min(m, v)
    m
maxArr(array<float> a) =>
    float m = na
    if a.size() > 0
        for i = 0 to a.size() - 1
            v = a.get(i)
            m := na(m) ? v : math.max(m, v)
    m
mn(float c, float v) => na(v) ? c : (na(c) ? v : math.min(c, v))
mx(float c, float v) => na(v) ? c : (na(c) ? v : math.max(c, v))

float xMnR = na
float xMxR = na
float yMnR = na
float yMxR = na
foldX(bool en, array<float> a) =>
    [en ? minArr(a) : na, en ? maxArr(a) : na]
[a1,b1]   = foldX(show1,rsA1)
[a2,b2]   = foldX(show2,rsA2)
[a3,b3]   = foldX(show3,rsA3)
[a4,b4]   = foldX(show4,rsA4)
[a5,b5]   = foldX(show5,rsA5)
[a6,b6]   = foldX(show6,rsA6)
[a7,b7]   = foldX(show7,rsA7)
[a8,b8]   = foldX(show8,rsA8)
[a9,b9]   = foldX(show9,rsA9)
[a10,b10] = foldX(show10,rsA10)
[a11,b11] = foldX(show11,rsA11)
xMnR := mn(mn(mn(mn(mn(mn(mn(mn(mn(mn(mn(na,a1),a2),a3),a4),a5),a6),a7),a8),a9),a10),a11)
xMxR := mx(mx(mx(mx(mx(mx(mx(mx(mx(mx(mx(na,b1),b2),b3),b4),b5),b6),b7),b8),b9),b10),b11)
[c1,d1]   = foldX(show1,mA1)
[c2,d2]   = foldX(show2,mA2)
[c3,d3]   = foldX(show3,mA3)
[c4,d4]   = foldX(show4,mA4)
[c5,d5]   = foldX(show5,mA5)
[c6,d6]   = foldX(show6,mA6)
[c7,d7]   = foldX(show7,mA7)
[c8,d8]   = foldX(show8,mA8)
[c9,d9]   = foldX(show9,mA9)
[c10,d10] = foldX(show10,mA10)
[c11,d11] = foldX(show11,mA11)
yMnR := mn(mn(mn(mn(mn(mn(mn(mn(mn(mn(mn(na,c1),c2),c3),c4),c5),c6),c7),c8),c9),c10),c11)
yMxR := mx(mx(mx(mx(mx(mx(mx(mx(mx(mx(mx(na,d1),d2),d3),d4),d5),d6),d7),d8),d9),d10),d11)

xMnR := nz(xMnR, 99.0)
xMxR := nz(xMxR, 101.0)
yMnR := nz(yMnR, 99.0)
yMxR := nz(yMxR, 101.0)

bounds(float lo, float hi) =>
    float dMin = na
    float dMax = na
    if symBounds
        half = math.max(math.max(math.abs(hi - 100.0), math.abs(100.0 - lo)), minSpan / 2.0)
        dMin := 100.0 - half
        dMax := 100.0 + half
    else
        pad = math.max(hi - lo, minSpan) * 0.15
        dMin := lo - pad
        dMax := hi + pad
    [dMin, dMax]
[dataXMin, dataXMax] = bounds(xMnR, xMxR)
[dataYMin, dataYMax] = bounds(yMnR, yMxR)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Canvas mapping {
leftX        = bar_index - chartBars
rightX       = bar_index
canvasBottom = 0.0
canvasTop    = canvasHeight

mapX(float v) => leftX + int(math.round((v - dataXMin) / math.max(dataXMax - dataXMin, 1e-9) * chartBars))
mapY(float v) => canvasBottom + (v - dataYMin) / math.max(dataYMax - dataYMin, 1e-9) * (canvasTop - canvasBottom)

baseX = mapX(100.0)
baseY = mapY(100.0)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Phase (true 100 baseline) {
phase(float x, float y) =>
    x >= 100 and y >= 100 ? "Leading" : x < 100 and y >= 100 ? "Recovering" : x < 100 and y < 100 ? "Lagging" : "Weakening"
phaseColor(string p) =>
    p == "Leading" ? color.new(color.lime, 20) : p == "Recovering" ? color.new(color.blue, 35) : p == "Lagging" ? color.new(color.red, 25) : color.new(color.orange, 25)
direction(array<float> ax, array<float> ay) =>
    out = "N/A"
    if ax.size() >= 2
        dx = ax.get(0) - ax.get(1)
        dy = ay.get(0) - ay.get(1)
        out := math.abs(dx) > math.abs(dy) ? (dx > 0 ? "RS improving" : "RS weakening") : (dy > 0 ? "Mom rising" : "Mom falling")
    out
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Ranking {
type RankItem
    float score
    int   id
speed(array<float> ax, array<float> ay) =>
    float s = na
    if ax.size() >= 2
        dx = (ax.get(0)-ax.get(1)) / math.max(dataXMax-dataXMin,1e-9)
        dy = (ay.get(0)-ay.get(1)) / math.max(dataYMax-dataYMin,1e-9)
        s := math.sqrt(dx*dx + dy*dy)
    s
target(array<float> ax, array<float> ay, string m) =>
    float s = na
    if ax.size() >= 2
        tx = (m=="Toward Leading" or m=="Toward Weakening") ? dataXMax : dataXMin
        ty = (m=="Toward Leading" or m=="Toward Recovering") ? dataYMax : dataYMin
        p = math.sqrt(math.pow((ax.get(1)-tx)/math.max(dataXMax-dataXMin,1e-9),2) + math.pow((ay.get(1)-ty)/math.max(dataYMax-dataYMin,1e-9),2))
        c = math.sqrt(math.pow((ax.get(0)-tx)/math.max(dataXMax-dataXMin,1e-9),2) + math.pow((ay.get(0)-ty)/math.max(dataYMax-dataYMin,1e-9),2))
        s := p - c
    s
score(array<float> ax, array<float> ay) => rankMode == "Fastest movement" ? speed(ax,ay) : target(ax,ay,rankMode)

var array<RankItem> rankItems = array.new<RankItem>()
addRank(int id, bool en, array<float> ax, array<float> ay) =>
    if en
        sc = score(ax, ay)
        if not na(sc)
            rankItems.push(RankItem.new(sc, id))
rankOf(int id) =>
    int r = na
    if rankItems.size() > 0
        for i = 0 to rankItems.size() - 1
            if rankItems.get(i).id == id
                r := i + 1
    r
selected(int id, bool en) =>
    en and (not useRanking or (not na(rankOf(id)) and rankOf(id) <= topRankN))
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Drawing objects {
var array<label> labels    = array.new<label>()
var array<box>   boxes     = array.new_box()
var array<line>  axes      = array.new_line()
var array<line>  tailLines = array.new_line()
var table rotTable = table.new(position.top_right, 5, 13, frame_color=color.gray, frame_width=1, border_color=color.gray, border_width=1)
var table dbgTable = table.new(position.bottom_left, 2, 8, frame_color=color.gray, frame_width=1)

clear() =>
    for x in labels
        label.delete(x)
    for b in boxes
        box.delete(b)
    for a in axes
        line.delete(a)
    for t in tailLines
        line.delete(t)
    labels.clear()
    boxes.clear()
    axes.clear()
    tailLines.clear()

tail(int x1,float y1,int x2,float y2,color c,int w) => tailLines.push(line.new(x1,y1,x2,y2, xloc=xloc.bar_index, color=c, width=w))
axis(int x1,float y1,int x2,float y2,color c) => axes.push(line.new(x1,y1,x2,y2, xloc=xloc.bar_index, color=c, width=2, style=line.style_dashed))
lbl(int x,float y,string t,color tc,string st,string sz) => labels.push(label.new(x,y,t, xloc=xloc.bar_index, yloc=yloc.price, style=st, color=color.new(color.black,100), textcolor=tc, size=sz))

szStr(int s) =>
    s <= 1 ? size.small : s == 2 ? size.normal : s == 3 ? size.large : size.huge

drawTail(bool en, int id, string name, array<float> xa, array<float> ya, color c, int baseW) =>
    if selected(id, en) and xa.size() >= 2
        sz = xa.size()
        for j = 0 to sz - 2
            iOld = sz - 1 - j
            iNew = sz - 2 - j
            age   = float(j + 1) / float(sz - 1)
            transp = int(80 - age * 55)
            w      = int(math.max(1, (baseW - 1) + age * 2))
            tail(mapX(xa.get(iOld)), mapY(ya.get(iOld)), mapX(xa.get(iNew)), mapY(ya.get(iNew)), color.new(c, transp), w)
        hx = mapX(xa.get(0))
        hy = mapY(ya.get(0))
        rk = rankOf(id)
        pfx = useRanking and not na(rk) ? "#" + str.tostring(rk) + " " : ""
        offset = (canvasTop - canvasBottom) * 0.02 * (((id - 1) % 3) - 1)
        lbl(hx, hy, "●", c, label.style_label_center, szStr(baseW))
        lbl(hx + 2, hy + offset, pfx + name, c, label.style_none, size.normal)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Render {
rankItems.clear()
addRank(1,show1,rsA1,mA1)
addRank(2,show2,rsA2,mA2)
addRank(3,show3,rsA3,mA3)
addRank(4,show4,rsA4,mA4)
addRank(5,show5,rsA5,mA5)
addRank(6,show6,rsA6,mA6)
addRank(7,show7,rsA7,mA7)
addRank(8,show8,rsA8,mA8)
addRank(9,show9,rsA9,mA9)
addRank(10,show10,rsA10,mA10)
addRank(11,show11,rsA11,mA11)
rankItems.sort(order.descending, sort_field="score")

row(int rowN, bool en, int id, string name, array<float> ax, array<float> ay) =>
    int nr = rowN
    if en and ax.size() > 0 and selected(id, en)
        x = ax.get(0)
        y = ay.get(0)
        ph = phase(x,y)
        table.cell(rotTable,0,rowN,name,text_color=color.white,bgcolor=color.new(color.gray,70))
        table.cell(rotTable,1,rowN,ph,text_color=color.white,bgcolor=phaseColor(ph))
        table.cell(rotTable,2,rowN,direction(ax,ay),text_color=color.white,bgcolor=color.new(color.gray,80))
        table.cell(rotTable,3,rowN,str.tostring(x,"#.##"),text_color=color.white,bgcolor=color.new(color.gray,85))
        table.cell(rotTable,4,rowN,str.tostring(y,"#.##"),text_color=color.white,bgcolor=color.new(color.gray,85))
        nr += 1
    nr

if barstate.islast
    clear()
    // Quadrants anchored to the 100 baseline (mapped)
    boxes.push(box.new(leftX, canvasTop, baseX, baseY, xloc=xloc.bar_index, bgcolor=color.new(color.blue,90),  border_color=color.new(color.gray,100))) // Recovering
    boxes.push(box.new(baseX, canvasTop, rightX, baseY, xloc=xloc.bar_index, bgcolor=color.new(color.lime,88), border_color=color.new(color.gray,100))) // Leading
    boxes.push(box.new(leftX, baseY, baseX, canvasBottom, xloc=xloc.bar_index, bgcolor=color.new(color.red,88), border_color=color.new(color.gray,100))) // Lagging
    boxes.push(box.new(baseX, baseY, rightX, canvasBottom, xloc=xloc.bar_index, bgcolor=color.new(color.orange,88), border_color=color.new(color.gray,100))) // Weakening
    axis(baseX, canvasBottom, baseX, canvasTop, color.new(color.gray,35))
    axis(leftX, baseY, rightX, baseY, color.new(color.gray,35))
    lbl(leftX + 12, canvasTop - 6, "Recovering", color.blue,  label.style_none, size.huge)
    lbl(rightX - 10, canvasTop - 6, "Leading",   color.lime,  label.style_none, size.huge)
    lbl(leftX + 10, canvasBottom + 6, "Lagging",  color.red,   label.style_none, size.huge)
    lbl(rightX - 12, canvasBottom + 6, "Weakening", color.orange, label.style_none, size.huge)

    drawTail(show1,1,"Energy",rsA1,mA1,col1,sz1)
    drawTail(show2,2,"Materials",rsA2,mA2,col2,sz2)
    drawTail(show3,3,"Industrials",rsA3,mA3,col3,sz3)
    drawTail(show4,4,"Discretionary",rsA4,mA4,col4,sz4)
    drawTail(show5,5,"Staples",rsA5,mA5,col5,sz5)
    drawTail(show6,6,"Health Care",rsA6,mA6,col6,sz6)
    drawTail(show7,7,"Financials",rsA7,mA7,col7,sz7)
    drawTail(show8,8,"Technology",rsA8,mA8,col8,sz8)
    drawTail(show9,9,"Communication",rsA9,mA9,col9,sz9)
    drawTail(show10,10,"Utilities",rsA10,mA10,col10,sz10)
    drawTail(show11,11,"Real Estate",rsA11,mA11,col11,sz11)

    // Table (always cleared so toggling off removes stale data)
    table.clear(rotTable, 0, 0, 4, 12)
    if showTable
        table.cell(rotTable,0,0,"Sector",text_color=color.white,bgcolor=color.gray)
        table.cell(rotTable,1,0,"Phase",text_color=color.white,bgcolor=color.gray)
        table.cell(rotTable,2,0,"Heading",text_color=color.white,bgcolor=color.gray)
        table.cell(rotTable,3,0,"RS",text_color=color.white,bgcolor=color.gray)
        table.cell(rotTable,4,0,"Mom",text_color=color.white,bgcolor=color.gray)
        int r = 1
        r := row(r,show1,1,"Energy",rsA1,mA1)
        r := row(r,show2,2,"Materials",rsA2,mA2)
        r := row(r,show3,3,"Industrials",rsA3,mA3)
        r := row(r,show4,4,"Discretionary",rsA4,mA4)
        r := row(r,show5,5,"Staples",rsA5,mA5)
        r := row(r,show6,6,"Health Care",rsA6,mA6)
        r := row(r,show7,7,"Financials",rsA7,mA7)
        r := row(r,show8,8,"Technology",rsA8,mA8)
        r := row(r,show9,9,"Communication",rsA9,mA9)
        r := row(r,show10,10,"Utilities",rsA10,mA10)
        r := row(r,show11,11,"Real Estate",rsA11,mA11)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}    