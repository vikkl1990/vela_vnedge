//@version=6
indicator("Forward-Backward Exponential Oscillator [LuxAlgo]", "LuxAlgo - FBE Oscillator")
//---------------------------------------------------------------------------------------------------------------------}
//Inputs
//---------------------------------------------------------------------------------------------------------------------{

//Params
length = input.int(20, title = "Length")
smooth = input.int(10, title = "Smoothing")
src = input(close, title = "Source")

//Style
bull_css = input.color(#5b9cf6, title = "Bullish Color")
bear_css = input.color(#9598a1, title = "Bearish Color")

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
backward()=>
    ema1 = ta.ema(src,smooth)
    ema2 = ta.ema(ema1,smooth)
    
    num = math.sum(ema2 - ema2[1],length)
    den = math.sum(math.abs(ema2 - ema2[1]),length) 
    
    num/den*50 + 50

var polyline pl = na
points = array.new<chart.point>()

forward_backward()=>
    float num = 0
    float den = 0
    
    ema1 = ta.ema(src,smooth)
    ema2 = ema1
    prev = ema2

    for i = 1 to length-1
        ema2 += 2/(smooth+1)*(ema1[i] - ema2)
        dt = prev - ema2
        num += dt
        den += math.abs(dt)
        points.push(chart.point.from_index((bar_index+length-1)-i,num/den*50 + 50))
        prev := ema2

    num/den*50 + 50

//---------------------------------------------------------------------------------------------------------------------}
//Calculations
//---------------------------------------------------------------------------------------------------------------------{
fb = forward_backward()
bwrd = backward()
hist = (fb - bwrd)/4 + 50

//Points for forecast
if barstate.islast
    pl.delete()
    pl := polyline.new(points, line_color = bull_css, line_style = line.style_dotted)

//---------------------------------------------------------------------------------------------------------------------}
//Display
//---------------------------------------------------------------------------------------------------------------------{
plot0 = plot(fb,'Forward-Backward',bull_css)
plot1 = plot(bwrd,'Backward',bear_css)

int os = 0
os := fb > bwrd ? 1 : fb < bwrd ? 0 : os[1]
css = os == 1 ? 
  color.from_gradient(fb,0,100,color.new(bear_css,100),color.new(bull_css,80)) :
  color.from_gradient(fb,0,100,color.new(bear_css,80),color.new(bull_css,100))

fill(plot0,plot1,css)

plot(hist, 'Histogram', css, 1, plot.style_histogram, histbase=50)

hline(80)
hline(20)

//---------------------------------------------------------------------------------------------------------------------}