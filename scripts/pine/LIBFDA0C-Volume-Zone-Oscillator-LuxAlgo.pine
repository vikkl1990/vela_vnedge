//@version=6
indicator("Volume Zone Oscillator", "Volume Zone Oscillator", overlay = false, format = format.price, precision = 2)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 1, group = "Settings", tooltip = "EMA length applied to both signed volume and total volume. 14 is the common default; longer settings favor the regime-filter read, shorter settings make overbought/oversold visits more frequent.")

bullRegimeInput = input.float( 5, "Bullish Regime", step = 0.5, inline = "regime", group = "Levels")
bearRegimeInput = input.float(-5, "Bearish Regime", step = 0.5, inline = "regime", group = "Levels", tooltip = "Regime boundaries around zero. VZO holding above the bullish level marks a buyer-controlled tape, holding below the bearish level a seller-controlled one; the band between them is neutral churn.")
obInput         = input.float( 40, "Overbought", step = 1, inline = "obos", group = "Levels")
osInput         = input.float(-40, "Oversold",   step = 1, inline = "obos", group = "Levels", tooltip = "Overbought/oversold levels, most meaningful in ranging markets where visits beyond them flag stretched volume pressure that tends to fade. In strong trends the oscillator can sit beyond them for extended stretches.")
extUpInput      = input.float( 60, "Extreme Overbought", step = 1, inline = "ext", group = "Levels")
extDnInput      = input.float(-60, "Extreme Oversold",   step = 1, inline = "ext", group = "Levels", tooltip = "Extreme readings. Volume flow this one-sided is rarely sustained and often precedes exhaustion of the move that produced it.")

bullColorInput       = input.color(#089981, "Bullish", inline = "col", group = "Style", tooltip = "Oscillator color when VZO is above zero. The gradient fill toward the zero line uses the same color.")
bearColorInput       = input.color(#f23645, "Bearish", inline = "col", group = "Style", tooltip = "Oscillator color when VZO is below zero. The gradient fill toward the zero line uses the same color.")
regimeBullColorInput = input.color(color.new(#089981, 60), "Regime Levels  Bullish", inline = "rcol", group = "Style")
regimeBearColorInput = input.color(color.new(#f23645, 60), "Bearish", inline = "rcol", group = "Style", tooltip = "Colors of the bullish/bearish regime boundary lines around zero.")
levelColorInput      = input.color(color.new(#787b86, 30), "Overbought/Oversold Lines", group = "Style", tooltip = "Color of the overbought/oversold lines (dashed) and the extreme lines (dotted).")
zeroColorInput       = input.color(color.new(#787b86, 50), "Zero Line", group = "Style", tooltip = "Color of the zero line separating net buying from net selling volume flow.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Volume with na-guard so symbols with sparse data don't contaminate the averages
vol = nz(volume)

//Signed volume: the full bar volume credited to buyers on up closes, to sellers on down closes
signedVolume = close > close[1] ? vol : close < close[1] ? -vol : 0

//Smoothed signed and total activity
signedEma = ta.ema(signedVolume, lengthInput)
totalEma  = ta.ema(vol, lengthInput)

//VZO: net directional share of total volume, bounded to the -100..+100 range
vzo = totalEma > 0 ? 100 * signedEma / totalEma : na

//Regime boundary crosses
bullRegimeStart = ta.crossover(vzo, bullRegimeInput)
bearRegimeStart = ta.crossunder(vzo, bearRegimeInput)

//Overbought/oversold entries and the fades back out of them
obReached = ta.crossover(vzo, obInput)
osReached = ta.crossunder(vzo, osInput)
obFade    = ta.crossunder(vzo, obInput)
osFade    = ta.crossover(vzo, osInput)

//Extreme one-sided readings
extUpHit = ta.crossover(vzo, extUpInput)
extDnHit = ta.crossunder(vzo, extDnInput)

//Cumulative volume, to detect symbols with no volume data at all
var float cumVol = 0.0
cumVol += vol

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
vzoColor = vzo >= 0 ? bullColorInput : bearColorInput

hline(0, "Zero Line", zeroColorInput, hline.style_dotted)
hline(bullRegimeInput, "Bullish Regime Level", regimeBullColorInput, hline.style_dotted)
hline(bearRegimeInput, "Bearish Regime Level", regimeBearColorInput, hline.style_dotted)
hline(obInput,    "Overbought Level",         levelColorInput, hline.style_dashed)
hline(osInput,    "Oversold Level",           levelColorInput, hline.style_dashed)
hline(extUpInput, "Extreme Overbought Level", levelColorInput, hline.style_dotted)
hline(extDnInput, "Extreme Oversold Level",   levelColorInput, hline.style_dotted)

vzoPlot  = plot(vzo, "VZO", vzoColor, 1, plot.style_linebr)
zeroPlot = plot(0, "Zero Anchor", color = na, editable = false, display = display.none)

//Centered gradient fill: fully transparent at the zero line, 50% at the oscillator value
fill(vzoPlot, zeroPlot, math.max(vzo, 0), math.min(vzo, 0), vzo >= 0 ? color.new(bullColorInput, 50) : color.new(bearColorInput, 100), vzo >= 0 ? color.new(bullColorInput, 100) : color.new(bearColorInput, 50))

//One-time notice on symbols without volume data
if barstate.islast and cumVol == 0
    var table warnTable = table.new(position.middle_center, 1, 1)
    table.cell(warnTable, 0, 0, "No volume data is available for this symbol", text_color = chart.fg_color, text_size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullRegimeStart, "Bullish Regime",     "VZO crossed above its bullish regime level, buyers taking control of volume flow on {{ticker}} - {{interval}}")
alertcondition(bearRegimeStart, "Bearish Regime",     "VZO crossed below its bearish regime level, sellers taking control of volume flow on {{ticker}} - {{interval}}")
alertcondition(obReached,       "Overbought",         "VZO entered its overbought zone on {{ticker}} - {{interval}}")
alertcondition(osReached,       "Oversold",           "VZO entered its oversold zone on {{ticker}} - {{interval}}")
alertcondition(obFade,          "Overbought Fade",    "VZO crossed back under its overbought level, stretched buying pressure fading on {{ticker}} - {{interval}}")
alertcondition(osFade,          "Oversold Fade",      "VZO crossed back above its oversold level, stretched selling pressure fading on {{ticker}} - {{interval}}")
alertcondition(extUpHit,        "Extreme Overbought", "VZO reached its extreme overbought level, one-sided buying rarely sustained on {{ticker}} - {{interval}}")
alertcondition(extDnHit,        "Extreme Oversold",   "VZO reached its extreme oversold level, one-sided selling rarely sustained on {{ticker}} - {{interval}}")

//---------------------------------------------------------------------------------------------------------------------}
