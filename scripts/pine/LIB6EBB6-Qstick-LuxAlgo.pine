//@version=6
indicator("Qstick", shorttitle = "Qstick", overlay = false, format = format.price)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR   = #089981
BEAR_COLOR   = #f23645
SIGNAL_COLOR = #ff9800 // the one accent - the signal line
ZERO_COLOR   = color.new(#787b86, 50)

FADE_TRANSP       = 60      // transparency of the fading line states
FILL_VALUE_TRANSP = 50      // gradient transparency at the Qstick value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(8, "Qstick Length", minval = 1
  , group   = "Settings"
  , tooltip = "Number of bars in the simple moving average of close minus open - Chande's quantified candlestick body. There is no universal default: published examples commonly use short lookbacks of around 8 bars for timing, while longer settings smooth the line into a bias filter.")

showSignalInput = input.bool(true, "Signal Line", inline = "signal"
  , group   = "Settings"
  , tooltip = "Plots a moving-average signal line on top of Qstick, echoing the MACD signal-line convention. Crossings between Qstick and this average give a faster trigger than the zero-line cross.")

signalLengthInput = input.int(9, "Length", minval = 1, inline = "signal"
  , group   = "Settings"
  , tooltip = "EMA length of the signal line. 9 mirrors the classic MACD signal-line setting.")

bullGrowInput = input.color(BULL_COLOR, "Bullish  Growing", inline = "bull", group = "Style")
bullFadeInput = input.color(color.new(BULL_COLOR, FADE_TRANSP), "Fading", inline = "bull"
  , group   = "Style"
  , tooltip = "Colors of the Qstick line above zero: growing segments extend away from zero (average bodies turning more bullish), fading segments roll back toward it. The bullish color also drives the gradient fill above zero.")

bearGrowInput = input.color(BEAR_COLOR, "Bearish  Growing", inline = "bear", group = "Style")
bearFadeInput = input.color(color.new(BEAR_COLOR, FADE_TRANSP), "Fading", inline = "bear"
  , group   = "Style"
  , tooltip = "Colors of the Qstick line below zero: growing segments extend away from zero (average bodies turning more bearish), fading segments roll back toward it. The bearish color also drives the gradient fill below zero.")

signalColorInput = input.color(SIGNAL_COLOR, "Signal Line"
  , group   = "Style"
  , tooltip = "Color of the EMA signal line.")

zeroColorInput = input.color(ZERO_COLOR, "Zero Line"
  , group   = "Style"
  , tooltip = "Color of the dotted zero reference line - the boundary between net-bullish and net-bearish average candle bodies.")

gradientFillInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between Qstick and the zero line - fully transparent at zero, more opaque at the value - so the strength of body pressure reads at a glance. Green above zero, red below.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Chande's quantified candlestick: the average body, close minus open, over the lookback. Gaps between bars never enter it
qstickValue = ta.sma(close - open, lengthInput)

//EMA signal line on Qstick, per the MACD signal-line convention
signalValue = ta.ema(qstickValue, signalLengthInput)

//Bar-to-bar change, na-guarded over the warmup bars
delta = qstickValue - nz(qstickValue[1], qstickValue)

//4-state line color: side of zero x growing/fading, so accelerating and stalling body pressure read apart
qstickColor = qstickValue >= 0 ? (delta >= 0 ? bullGrowInput : bullFadeInput) : (delta <= 0 ? bearGrowInput : bearFadeInput)

//Zero-line crosses - the flip between net-bullish and net-bearish candle bodies
zeroCrossUp   = ta.crossover(qstickValue, 0)
zeroCrossDown = ta.crossunder(qstickValue, 0)

//Signal-line crosses - the earlier trigger when the signal line is used
signalCrossUp   = ta.crossover(qstickValue, signalValue)
signalCrossDown = ta.crossunder(qstickValue, signalValue)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
//Vertical gradient anchored at zero: fully transparent at the zero line, more opaque at the value
fillTopColor    = qstickValue >= 0 ? color.new(bullGrowInput, FILL_VALUE_TRANSP) : color.new(bearGrowInput, FILL_ZERO_TRANSP)
fillBottomColor = qstickValue >= 0 ? color.new(bullGrowInput, FILL_ZERO_TRANSP) : color.new(bearGrowInput, FILL_VALUE_TRANSP)

hline(0, "Zero Line", zeroColorInput, hline.style_dotted)

qstickPlotId = plot(qstickValue, "Qstick", qstickColor, 2)

plot(showSignalInput ? signalValue : na, "Signal Line", signalColorInput, 1)

zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

fill(qstickPlotId, zeroPlotId
  , math.max(qstickValue, 0)
  , math.min(qstickValue, 0)
  , gradientFillInput ? fillTopColor : na
  , gradientFillInput ? fillBottomColor : na
  , title = "Body Pressure Gradient")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(zeroCrossUp,   "Bullish Zero Cross", "Qstick crossed above zero on {{ticker}} - {{interval}}: recent candle bodies are net bullish - intrabar buying has taken over")
alertcondition(zeroCrossDown, "Bearish Zero Cross", "Qstick crossed below zero on {{ticker}} - {{interval}}: recent candle bodies are net bearish - intrabar selling has taken over")

alertcondition(signalCrossUp,   "Bullish Signal Line Cross", "Qstick crossed above its signal line on {{ticker}} - {{interval}} - the faster bullish trigger ahead of the zero cross")
alertcondition(signalCrossDown, "Bearish Signal Line Cross", "Qstick crossed below its signal line on {{ticker}} - {{interval}} - the faster bearish trigger ahead of the zero cross")

//---------------------------------------------------------------------------------------------------------------------}
