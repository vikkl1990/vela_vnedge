// ═══════════════════════════════════════════════════════════════
// Trding R-Multiple Trade Log · v1.0.0
// Educational trade-journaling tool. Plots your closed trades as
// W/L markers directly on the chart with R-multiple labels, plus a
// running scorecard (win rate · total R · avg R · best · worst).
// Enter your log once in the settings string · the script parses
// it, computes R for each trade, and paints the results at each
// trade's date.
// No buy/sell signals. Not financial advice.
// ═══════════════════════════════════════════════════════════════
//
// v1.2.0 (2026-09-05) — Marker anchoring polish. Auto-fit now uses
//   Pine's yloc.abovebar / yloc.belowbar so wins hover just above the
//   bar's high and losses hover just below the bar's low at the exact
//   trade timestamp — markers follow the candles instead of floating
//   at global chart high/low.
// v1.1.0 (2026-09-05) — Chart visibility upgrade. Auto-fit markers to
//   the actual bar's high/low so they always appear on-screen regardless
//   of trade price vs chart price scale. Vertical trade lines at each
//   trade timestamp for scan-ability at any zoom level. Trade numbers
//   in labels (#1, #2, ...) for cross-reference with journal notes.
//   Sample defaults rebased to QQQ scale.
// v1.0.0 (2026-09-05) — Initial Wave 3 release. Trding_AI publisher.
//   Companion to ATR Stop & Target Visualizer + Risk-Sizing
//   Calculator. Free public educational script. Palette locked to
//   Trding v5 family (electric lime wins · electric blue losses ·
//   deep navy tables · slate mutes).
//
// ═══════════════════════════════════════════════════════════════

//@version=6
indicator("Trding R-Multiple Trade Log", shorttitle="TRDING R-LOG",
     overlay=true, max_labels_count=100, max_lines_count=50)

// ═══════════════════════════════════════════════════════════════
// PALETTE (Trding_AI brand · locked with ATR SL/TP + Score + Fire)
// ═══════════════════════════════════════════════════════════════
color C_WIN   = #5EE33E   // electric lime · winning trade role
color C_LOSS  = #3B82F6   // electric blue · losing trade role
color C_NAVY  = #0B1220   // deep navy · card background
color C_MUTE  = #94A3B8   // slate · muted labels
color C_HEAD  = #131A2E   // panel header background
color C_GOLD  = #C9A84C   // gold · header accent

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

// ─── Trade Log ───
grpL = "Trade Log"
trade_log = input.string(
     "2026-08-01,LONG,703.50,715.00,700.00|2026-08-05,SHORT,731.00,720.00,733.50|2026-08-12,LONG,731.00,737.00,728.00",
     "Trades", group=grpL,
     tooltip="Format per trade: DATE,DIR,ENTRY,EXIT,STOP\n" +
             "  DATE  = YYYY-MM-DD\n" +
             "  DIR   = LONG or SHORT\n" +
             "  ENTRY = fill price\n" +
             "  EXIT  = close price\n" +
             "  STOP  = original stop price\n" +
             "Separate trades with pipe |  ·  cap 20 trades  ·  no spaces needed.")

// ─── Display ───
grpD = "Display"
show_wins       = input.bool(true,  "Show wins",   group=grpD, inline="wl")
show_losses     = input.bool(true,  "Show losses", group=grpD, inline="wl")
show_r_labels   = input.bool(true,  "Show R multiple labels on markers", group=grpD)
show_trade_nums = input.bool(true,  "Show trade numbers (#1, #2, …)",     group=grpD)
show_card       = input.bool(true,  "Show scorecard", group=grpD)
auto_fit        = input.bool(true,  "Auto-fit markers to bar high/low (always on chart)",
     group=grpD, tooltip="ON  = markers anchor above/below the matched bar so they're always visible even when your trade prices differ from the chart's price scale.\nOFF = markers plot at the actual entry price (best when your log matches the chart symbol exactly).")
show_v_lines    = input.bool(true,  "Show vertical trade lines",
     group=grpD, tooltip="Draws a colored vertical line at each trade's date. Makes trades findable at any zoom level.")
marker_size     = input.string("Normal", "Marker size",
     options=["Tiny", "Small", "Normal", "Large"], group=grpD)
card_position   = input.string("Bottom Right", "Scorecard position",
     options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=grpD)

// ─── Colors ───
grpC = "Colors"
col_win       = input.color(C_WIN,        "Win",       group=grpC, inline="wl")
col_loss      = input.color(C_LOSS,       "Loss",      group=grpC, inline="wl")
col_card_bg   = input.color(C_NAVY,       "Card BG",   group=grpC, inline="card")
col_card_text = input.color(color.white,  "Card text", group=grpC, inline="card")

// ═══════════════════════════════════════════════════════════════
// STORAGE (initialized once, populated on first bar)
// ═══════════════════════════════════════════════════════════════
var arr_ts    = array.new<int>()
var arr_dir   = array.new<string>()
var arr_entry = array.new<float>()
var arr_exit  = array.new<float>()
var arr_stop  = array.new<float>()
var arr_r     = array.new<float>()
var arr_win   = array.new<bool>()
var arr_err   = array.new<string>()

// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════

// Strip spaces from a token (Pine v6 has no str.trim)
clean(string s) =>
    str.replace_all(s, " ", "")

// Parse YYYY-MM-DD → unix ms (noon UTC to sidestep DST edges)
// Returns na on any parse failure.
parseDate(string s) =>
    parts = str.split(s, "-")
    int result = na
    if array.size(parts) == 3
        y = str.tonumber(array.get(parts, 0))
        m = str.tonumber(array.get(parts, 1))
        d = str.tonumber(array.get(parts, 2))
        if not na(y) and not na(m) and not na(d)
            result := timestamp(int(y), int(m), int(d), 12, 0)
    result

// Format an R value with sign: 2.3 → "+2.3R" · -1.0 → "-1.0R"
f_r(float r, string fmt) =>
    (r > 0 ? "+" : "") + str.tostring(r, fmt) + "R"

// ═══════════════════════════════════════════════════════════════
// PARSE TRADE LOG (one-time, on first bar)
// ═══════════════════════════════════════════════════════════════
if barstate.isfirst
    trades = str.split(trade_log, "|")
    tcount = math.min(array.size(trades), 20)
    if tcount > 0
        for i = 0 to tcount - 1
            raw = clean(array.get(trades, i))
            if str.length(raw) > 0
                fields = str.split(raw, ",")
                if array.size(fields) == 5
                    dstr = array.get(fields, 0)
                    dir  = str.upper(array.get(fields, 1))
                    en   = str.tonumber(array.get(fields, 2))
                    ex   = str.tonumber(array.get(fields, 3))
                    st   = str.tonumber(array.get(fields, 4))
                    ts   = parseDate(dstr)
                    bad_parse = na(en) or na(ex) or na(st) or na(ts) or
                         (dir != "LONG" and dir != "SHORT")
                    if bad_parse
                        array.push(arr_err, "Trade " + str.tostring(i + 1) +
                             ": parse error (check DATE/DIR/numbers)")
                    else
                        float r = na
                        bool valid = false
                        if dir == "LONG"
                            if en > st
                                r := (ex - en) / (en - st)
                                valid := true
                        else  // SHORT
                            if st > en
                                r := (en - ex) / (st - en)
                                valid := true
                        if valid
                            r := math.round(r * 10) / 10.0     // 1-decimal R
                            array.push(arr_ts,    ts)
                            array.push(arr_dir,   dir)
                            array.push(arr_entry, en)
                            array.push(arr_exit,  ex)
                            array.push(arr_stop,  st)
                            array.push(arr_r,     r)
                            array.push(arr_win,   r > 0)
                        else
                            array.push(arr_err, "Trade " + str.tostring(i + 1) +
                                 ": stop on wrong side of entry")
                else
                    array.push(arr_err, "Trade " + str.tostring(i + 1) +
                         ": expected 5 fields (got " + str.tostring(array.size(fields)) + ")")

// ═══════════════════════════════════════════════════════════════
// STYLE MAPPING
// ═══════════════════════════════════════════════════════════════
sizeVal = marker_size == "Tiny"  ? size.tiny  :
         marker_size == "Small" ? size.small :
         marker_size == "Large" ? size.large : size.normal

posVal = card_position == "Top Left"     ? position.top_left     :
         card_position == "Top Right"    ? position.top_right    :
         card_position == "Bottom Left"  ? position.bottom_left  :
                                           position.bottom_right

// ═══════════════════════════════════════════════════════════════
// AUTO-FIT ANCHOR TRACKING (per-bar highest/lowest cache · needed
// for auto-fit Y placement · runs every bar not just islast)
// ═══════════════════════════════════════════════════════════════
// Track chart's high/low over recent window as fallback anchors when
// no bar exactly matches a trade timestamp. Also cache high/low at
// each visible bar for exact-match anchoring.
var float chart_high = na
var float chart_low  = na
chart_high := na(chart_high) ? high : math.max(chart_high, high)
chart_low  := na(chart_low)  ? low  : math.min(chart_low,  low)

// ═══════════════════════════════════════════════════════════════
// DRAW TRADE MARKERS + VERTICAL LINES
// (recreated each islast tick so toggles apply live)
// ═══════════════════════════════════════════════════════════════
var array<label> label_refs = array.new<label>()
var array<line>  line_refs  = array.new<line>()

if barstate.islast
    // Clear previous markers
    if array.size(label_refs) > 0
        for lbl in label_refs
            label.delete(lbl)
        array.clear(label_refs)
    // Clear previous vertical lines
    if array.size(line_refs) > 0
        for ln in line_refs
            line.delete(ln)
        array.clear(line_refs)

    // Auto-fit anchor bands (5% above chart high · 5% below chart low)
    // Provides always-visible Y even when no trade timestamp matches
    // a bar exactly.
    float anchor_high = chart_high * 1.005
    float anchor_low  = chart_low  * 0.995
    // Line extents: use very wide Y so lines cover the full visible
    // range at any zoom. Pine clips to visible chart edges.
    float line_y_top = chart_high * 10
    float line_y_bot = chart_low  * 0.1

    n = array.size(arr_ts)
    if n > 0
        for i = 0 to n - 1
            isWin = array.get(arr_win, i)
            if (isWin and show_wins) or (not isWin and show_losses)
                ts     = array.get(arr_ts,    i)
                entry  = array.get(arr_entry, i)
                exitP  = array.get(arr_exit,  i)
                stopP  = array.get(arr_stop,  i)
                dir    = array.get(arr_dir,   i)
                r      = array.get(arr_r,     i)
                col    = isWin ? col_win : col_loss
                sty    = isWin ? label.style_triangleup : label.style_triangledown
                // Compose label text: [#N ] [+R]
                num_str = show_trade_nums ? "#" + str.tostring(i + 1) : ""
                r_str   = show_r_labels   ? f_r(r, "#.#") : ""
                txt     = num_str + (str.length(num_str) > 0 and str.length(r_str) > 0 ? "  " : "") + r_str
                txtcol  = isWin ? color.black : color.white
                // Marker positioning: auto-fit uses yloc.abovebar/belowbar
                // so wins hover just above the bar's high and losses just
                // below the bar's low at the exact trade timestamp — markers
                // follow the candles. When auto_fit is OFF, marker anchors
                // at the actual entry price (yloc.price).
                float marker_y = auto_fit ? na : entry
                y_loc = auto_fit ? (isWin ? yloc.abovebar : yloc.belowbar) : yloc.price
                tt = "Trade #" + str.tostring(i + 1) + "  ·  " + dir + "  ·  " + f_r(r, "#.#") +
                     "\nEntry: " + str.tostring(entry, format.mintick) +
                     "\nExit:  " + str.tostring(exitP, format.mintick) +
                     "\nStop:  " + str.tostring(stopP, format.mintick)
                lbl = label.new(x=ts, y=marker_y, text=txt,
                     xloc=xloc.bar_time, yloc=y_loc,
                     style=sty, color=col, textcolor=txtcol, size=sizeVal,
                     tooltip=tt)
                array.push(label_refs, lbl)

                // Vertical trade line — spans full visible chart at trade timestamp
                if show_v_lines
                    ln = line.new(x1=ts, y1=line_y_bot, x2=ts, y2=line_y_top,
                         xloc=xloc.bar_time, style=line.style_dashed,
                         color=color.new(col, 65), width=1)
                    array.push(line_refs, ln)

// ═══════════════════════════════════════════════════════════════
// SCORECARD (destroyed + recreated each islast tick so inputs apply)
// ═══════════════════════════════════════════════════════════════
var table tbl = na

if show_card and barstate.islast
    if not na(tbl)
        table.delete(tbl)
    tbl := table.new(posVal, 2, 10, border_width=1,
         border_color=color.new(C_MUTE, 60))

    // Aggregate
    n       = array.size(arr_ts)
    wins    = 0
    losses  = 0
    totalR  = 0.0
    bestR   = -1e10
    worstR  =  1e10
    if n > 0
        for i = 0 to n - 1
            r = array.get(arr_r, i)
            w = array.get(arr_win, i)
            if w
                wins   += 1
            else
                losses += 1
            totalR += r
            bestR  := math.max(bestR,  r)
            worstR := math.min(worstR, r)
    winRate = n > 0 ? wins / float(n) * 100.0 : 0.0
    avgR    = n > 0 ? totalR / n : 0.0
    errCount = array.size(arr_err)

    // Styling
    hdr = color.new(C_HEAD, 0)
    row = color.new(col_card_bg, 15)

    // Header
    table.cell(tbl, 0, 0, "TRDING R-LOG", text_color=C_GOLD,
         text_size=size.small, bgcolor=hdr)
    table.cell(tbl, 1, 0, "v1.2", text_color=C_MUTE,
         text_size=size.small, bgcolor=hdr)

    // Rows
    table.cell(tbl, 0, 1, "Trades",   text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 1, str.tostring(n), text_color=col_card_text,
         text_size=size.small, bgcolor=row)

    table.cell(tbl, 0, 2, "Wins",     text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 2, str.tostring(wins), text_color=col_win,
         text_size=size.small, bgcolor=row)

    table.cell(tbl, 0, 3, "Losses",   text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 3, str.tostring(losses), text_color=col_loss,
         text_size=size.small, bgcolor=row)

    table.cell(tbl, 0, 4, "Win rate", text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 4, n > 0 ? str.tostring(winRate, "#.#") + "%" : "—",
         text_color=col_card_text, text_size=size.small, bgcolor=row)

    table.cell(tbl, 0, 5, "Total R",  text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 5, n > 0 ? f_r(totalR, "#.#") : "—",
         text_color=totalR >= 0 ? col_win : col_loss,
         text_size=size.small, bgcolor=row)

    table.cell(tbl, 0, 6, "Avg R",    text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 6, n > 0 ? f_r(avgR, "#.##") : "—",
         text_color=avgR >= 0 ? col_win : col_loss,
         text_size=size.small, bgcolor=row)

    table.cell(tbl, 0, 7, "Best",     text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 7, n > 0 ? f_r(bestR, "#.#") : "—",
         text_color=col_win, text_size=size.small, bgcolor=row)

    table.cell(tbl, 0, 8, "Worst",    text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 8, n > 0 ? f_r(worstR, "#.#") : "—",
         text_color=col_loss, text_size=size.small, bgcolor=row)

    // Parse-error footer (only if any bad rows)
    table.cell(tbl, 0, 9, "Errors",   text_color=C_MUTE, text_size=size.small, bgcolor=row)
    table.cell(tbl, 1, 9, errCount > 0 ? str.tostring(errCount) + " skipped" : "0",
         text_color=errCount > 0 ? col_loss : C_MUTE,
         text_size=size.small, bgcolor=row)

// ═══════════════════════════════════════════════════════════════
// ERROR DETAIL LABEL (top-left · only when there are parse errors)
// ═══════════════════════════════════════════════════════════════
var label err_lbl = na

if barstate.islast
    if not na(err_lbl)
        label.delete(err_lbl)
        err_lbl := na
    if array.size(arr_err) > 0
        string msg = "⚠ R-LOG parse errors:"
        for j = 0 to array.size(arr_err) - 1
            msg := msg + "\n• " + array.get(arr_err, j)
        err_lbl := label.new(x=bar_index, y=high, text=msg,
             xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_down, color=color.new(C_LOSS, 20),
             textcolor=color.white, size=size.small)
