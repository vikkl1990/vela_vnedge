//@version=6

strategy(
     title = "Fractional EMA Cross Backtest",
     shorttitle = "EMA X BT",
     overlay = true,
     initial_capital = 3000,
     currency = currency.USD,
     pyramiding = 0,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type = strategy.commission.cash_per_order,
     commission_value = 0.10,
     process_orders_on_close = false,
     calc_on_order_fills = true,
     calc_on_every_tick = true,
     max_labels_count = 500
)

//=============================================================================
// 01. EMA CROSS — ENTRY LOGIC
//=============================================================================

fastEmaLength = input.float(
     13.0,
     "Fast EMA Length",
     minval = 1.0,
     step = 0.1,
     group = "01. EMA Cross"
)

slowEmaLength = input.float(
     48.5,
     "Intermediate EMA Length",
     minval = 1.0,
     step = 0.1,
     group = "01. EMA Cross"
)

enableEma3 = input.bool(
     false,
     "Enable EMA 3",
     group = "01. EMA Cross"
)

ema3Length = input.float(
     200.0,
     "Slow EMA Length",
     minval = 1.0,
     step = 0.1,
     group = "01. EMA Cross"
)

enableLongs = input.bool(
     true,
     "Enable Longs",
     group = "01. EMA Cross"
)

enableShorts = input.bool(
     true,
     "Enable Shorts",
     group = "01. EMA Cross"
)

//=============================================================================
// 02. RISK MANAGEMENT — FIXED STRATEGY ENGINE
//=============================================================================

riskPct = input.float(
     1.0,
     "Risk per Trade (% Total Capital)",
     minval = 0.01,
     maxval = 2.0,
     step = 0.1,
     group = "02. Risk Management"
)

rewardRisk = input.float(
     3.5,
     "Target R:R",
     minval = 2.0,
     step = 0.5,
     group = "02. Risk Management"
)

//=============================================================================
// 03. TRIM — FIXED STRATEGY ENGINE
//=============================================================================

showTrimLabel = input.bool(
     true,
     "Show TRIM Label",
     group = "03. TRIM"
)

trimPct = input.float(
     75.0,
     "TRIM Level (% Entry to Target)",
     minval = 1.0,
     maxval = 99.0,
     step = 1.0,
     group = "03. TRIM"
)

trimLabelColor = input.color(
     #673AB7,
     "TRIM Label Color",
     group = "03. TRIM"
)

trimTextColor = input.color(
     color.white,
     "TRIM Text Color",
     group = "03. TRIM"
)

trimLabelSizeInput = input.string(
     "Small",
     "TRIM Label Size",
     options = [
         "Tiny",
         "Small",
         "Normal",
         "Large",
         "Huge"
     ],
     group = "03. TRIM"
)

trimLabelTransparency = input.int(
     18,
     "TRIM Label Transparency",
     minval = 0,
     maxval = 90,
     step = 1,
     group = "03. TRIM"
)

trimLabelBarOffset = input.int(
     1,
     "TRIM Label Bar Offset",
     minval = 0,
     maxval = 5,
     step = 1,
     group = "03. TRIM"
)

//=============================================================================
// 04. MAXIMUM HOLDING TIME — FIXED STRATEGY ENGINE
//=============================================================================

maxSessions = input.int(
     30,
     "Maximum Sessions",
     minval = 1,
     group = "04. Maximum Holding Time"
)

//=============================================================================
// 05. SAMPLE CONFIDENCE — FIXED STRATEGY ENGINE
//=============================================================================

sampleLowThreshold = input.int(
     50,
     "Preliminary Threshold",
     minval = 1,
     group = "05. Sample Confidence"
)

sampleValidThreshold = input.int(
     100,
     "Valid Threshold",
     minval = 1,
     group = "05. Sample Confidence"
)

//=============================================================================
// 06. BACKTEST TABLE — FIXED STRATEGY ENGINE
//=============================================================================

showTable = input.bool(
     true,
     "Show Backtest Table",
     group = "06. Backtest Table"
)

tablePositionInput = input.string(
     "Middle Right",
     "Table Position",
     options = [
         "Top Left",
         "Top Center",
         "Top Right",
         "Middle Left",
         "Middle Center",
         "Middle Right",
         "Bottom Left",
         "Bottom Center",
         "Bottom Right"
     ],
     group = "06. Backtest Table"
)

tableSizeInput = input.string(
     "Normal",
     "Font Size",
     options = [
         "Tiny",
         "Small",
         "Normal",
         "Large",
         "Huge"
     ],
     group = "06. Backtest Table"
)

tableFontInput = input.string(
     "Monospace",
     "Font",
     options = [
         "Default",
         "Monospace"
     ],
     group = "06. Backtest Table"
)

tableRightOffset = input.int(
     3,
     "Right Offset (% pane width)",
     minval = 0,
     maxval = 20,
     step = 1,
     group = "06. Backtest Table"
)

tableTopOffset = input.int(
     2,
     "Top Offset (% pane height)",
     minval = 0,
     maxval = 20,
     step = 1,
     group = "06. Backtest Table"
)

//=============================================================================
// 07. TABLE COLORS — FIXED STRATEGY ENGINE
//=============================================================================

headerBg = input.color(
     #2E2E2E,
     "Header Background",
     group = "07. Table Colors"
)

headerText = input.color(
     color.white,
     "Header Text",
     group = "07. Table Colors"
)

bodyBg = input.color(
     #0C3299,
     "Body Background",
     group = "07. Table Colors"
)

bodyText = input.color(
     color.white,
     "Body Text",
     group = "07. Table Colors"
)

positiveBg = input.color(
     #089981,
     "Positive",
     group = "07. Table Colors"
)

warningBg = input.color(
     #FBC02D,
     "Warning",
     group = "07. Table Colors"
)

negativeBg = input.color(
     #F7525F,
     "Negative",
     group = "07. Table Colors"
)

neutralBg = input.color(
     color.rgb(90, 92, 100),
     "Neutral",
     group = "07. Table Colors"
)

borderColor = input.color(
     #F7EEE1,
     "Border",
     group = "07. Table Colors"
)

spacerColor = color.new(
     color.black,
     100
)

//=============================================================================
// 08. EMA STYLE — ENTRY LOGIC VISUALS
//=============================================================================

fastEmaColor = input.color(
     #2962FF,
     "Fast EMA Color",
     group = "08. EMA Style"
)

slowEmaColor = input.color(
     #FF6D00,
     "Intermediate EMA Color",
     group = "08. EMA Style"
)

ema3Color = input.color(
     #F7525F,
     "Slow EMA Color",
     group = "08. EMA Style"
)

emaLineWidth = input.int(
     1,
     "EMA Line Width",
     minval = 1,
     maxval = 5,
     group = "08. EMA Style"
)

//=============================================================================
// FUNCTIONS
//=============================================================================

f_tablePosition(string value) =>
    switch value
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.middle_right

f_textSize(string value) =>
    switch value
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

f_font(string value) =>
    value == "Monospace" ? font.family_monospace : font.family_default

f_pct(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.##") + "%"

f_num(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.##")

f_money(float value) =>
    na(value) ? "N/A" : "$" + str.tostring(value, "#.##")

f_price(float value) =>
    na(value) ? "N/A" : "$" + str.tostring(value, format.mintick)

f_r(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.##") + "R"

f_bucketPct(int count, int total) =>
    total > 0 ? str.tostring(count * 100.0 / total, "#.##") + "%" : "0.00%"

f_lengthText(float value) =>
    math.abs(value - math.round(value)) < 0.0000001 ? str.tostring(value, "#") : str.tostring(value, "#.###")

f_fractionalEma(float source, float length) =>
    float alpha = 2.0 / (length + 1.0)
    float result = na
    result := na(result[1]) ? source : alpha * source + (1.0 - alpha) * result[1]
    result

//=============================================================================
// TIMEFRAME
//
// No timeframe restriction.
// EMA calculations use the active chart timeframe.
//=============================================================================

//=============================================================================
// EMA CALCULATIONS — ENTRY LOGIC
//=============================================================================

emaFast = f_fractionalEma(
     close,
     fastEmaLength
)

emaIntermediate = f_fractionalEma(
     close,
     slowEmaLength
)

emaSlow = f_fractionalEma(
     close,
     ema3Length
)

emaPairLabel = enableEma3 ? "EMA " + f_lengthText(fastEmaLength) + "/" + f_lengthText(slowEmaLength) + "/" + f_lengthText(ema3Length) : "EMA " + f_lengthText(fastEmaLength) + "/" + f_lengthText(slowEmaLength)

plot(
     emaFast,
     title = "Fast EMA",
     color = fastEmaColor,
     linewidth = emaLineWidth
)

plot(
     emaIntermediate,
     title = "Intermediate EMA",
     color = slowEmaColor,
     linewidth = emaLineWidth
)

plot(
     enableEma3 ? emaSlow : na,
     title = "Slow EMA",
     color = ema3Color,
     linewidth = emaLineWidth
)

//=============================================================================
// ENTRY SIGNAL COMPONENTS — ENTRY LOGIC
//=============================================================================

fastCrossUpIntermediate = ta.crossover(
     emaFast,
     emaIntermediate
) and barstate.isconfirmed

fastCrossDownIntermediate = ta.crossunder(
     emaFast,
     emaIntermediate
) and barstate.isconfirmed

intermediateCrossUpSlow = ta.crossover(
     emaIntermediate,
     emaSlow
) and barstate.isconfirmed

intermediateCrossDownSlow = ta.crossunder(
     emaIntermediate,
     emaSlow
) and barstate.isconfirmed

//=============================================================================
// THREE EMA SEQUENCE STATE — ENTRY LOGIC
//
// LONG SEQUENCE
// 1. Fast crosses above Intermediate.
// 2. Long setup becomes ARMED.
// 3. Intermediate later crosses above Slow.
// 4. Final Long signal occurs on that second crossover.
// 5. If Fast crosses back below Intermediate before completion,
//    the Long setup is cancelled.
//
// SHORT SEQUENCE
// 1. Fast crosses below Intermediate.
// 2. Short setup becomes ARMED.
// 3. Intermediate later crosses below Slow.
// 4. Final Short signal occurs on that second crossover.
// 5. If Fast crosses back above Intermediate before completion,
//    the Short setup is cancelled.
//=============================================================================

var bool longSequenceArmed = false
var bool shortSequenceArmed = false

threeEmaLongSignal =
     enableEma3 and
     longSequenceArmed and
     intermediateCrossUpSlow and
     emaFast > emaIntermediate

threeEmaShortSignal =
     enableEma3 and
     shortSequenceArmed and
     intermediateCrossDownSlow and
     emaFast < emaIntermediate

//-----------------------------------------------------------------------------
// Update sequence state AFTER evaluating the final trigger.
//-----------------------------------------------------------------------------

if enableEma3

    if fastCrossUpIntermediate
        longSequenceArmed := emaIntermediate <= emaSlow
        shortSequenceArmed := false

    if fastCrossDownIntermediate
        shortSequenceArmed := emaIntermediate >= emaSlow
        longSequenceArmed := false

    if threeEmaLongSignal
        longSequenceArmed := false
        shortSequenceArmed := false

    if threeEmaShortSignal
        shortSequenceArmed := false
        longSequenceArmed := false

else
    longSequenceArmed := false
    shortSequenceArmed := false

//=============================================================================
// FINAL TECHNICAL SIGNALS — ENTRY LOGIC
//
// These signals describe valid EMA setups.
// They do NOT yet guarantee that an order can be opened.
//=============================================================================

twoEmaLongSignal =
     not enableEma3 and
     fastCrossUpIntermediate

twoEmaShortSignal =
     not enableEma3 and
     fastCrossDownIntermediate

longSignal =
     twoEmaLongSignal or
     threeEmaLongSignal

shortSignal =
     twoEmaShortSignal or
     threeEmaShortSignal

//=============================================================================
// EXECUTABLE ENTRY SIGNALS — ENTRY LOGIC
//
// IMPORTANT:
// Cross 01, strategy.entry() and alerts use THESE signals.
//
// Therefore:
// Every visible Cross 01 corresponds to an actual order submission.
// A technical cross occurring while another trade is open is NOT plotted
// as Cross 01 and is NOT counted as a new backtest trade.
//=============================================================================

entryLongSignal =
     longSignal and
     enableLongs and
     strategy.position_size == 0

entryShortSignal =
     shortSignal and
     enableShorts and
     strategy.position_size == 0

//=============================================================================
// CROSS VISUAL
//
// 2 EMA MODE:
// Cross 01 = executable Fast / Intermediate crossover.
//
// 3 EMA MODE:
// Cross 01 = executable second-stage crossover:
// Intermediate / Slow.
//
// Green = Long.
// Red   = Short.
//=============================================================================

twoEmaCrossPrice = (
     emaFast +
     emaIntermediate
) / 2.0

threeEmaCrossPrice = (
     emaIntermediate +
     emaSlow
) / 2.0

effectiveCrossPrice =
     enableEma3
     ? threeEmaCrossPrice
     : twoEmaCrossPrice

crossPrice =
     entryLongSignal or entryShortSignal
     ? effectiveCrossPrice
     : na

crossColor =
     entryLongSignal
     ? #00FF00
     : entryShortSignal
     ? #FF4D4D
     : na

plot(
     crossPrice,
     title = "Cross 01",
     color = crossColor,
     linewidth = 3,
     style = plot.style_cross
)

//=============================================================================
// ENTRIES — ENTRY LOGIC
//
// Cross 01 = order submission bar.
//
// Because process_orders_on_close = false:
// Historical market orders are normally filled at the next available tick,
// which is usually the OPEN of the following chart bar.
//
// This preserves the fixed strategy engine.
//=============================================================================

if entryLongSignal
    strategy.entry(
         "Long",
         strategy.long,
         comment = "Entry Long"
    )

else if entryShortSignal
    strategy.entry(
         "Short",
         strategy.short,
         comment = "Entry Short"
    )

//=============================================================================
// ACTIVE TRADE STATE — FIXED STRATEGY ENGINE
//=============================================================================

var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var float activeTrim = na
var float activeInitialRiskCash = na

var bool trimTriggered = false

var int entryBarIndex = na
var int activeDirection = 0
var int activeHoldingSessions = 0
var int activeTradingDay = na

//=============================================================================
// DETECT NEW POSITION — FIXED STRATEGY ENGINE
//=============================================================================

newLong =
     strategy.position_size > 0 and
     strategy.position_size[1] <= 0

newShort =
     strategy.position_size < 0 and
     strategy.position_size[1] >= 0

//=============================================================================
// NEW LONG POSITION
//=============================================================================

if newLong

    activeDirection := 1

    activeEntry :=
         strategy.position_avg_price

    activeInitialRiskCash :=
         strategy.equity *
         (
             riskPct /
             100.0
         )

    riskPerShare =
         activeInitialRiskCash /
         math.abs(
             strategy.position_size
         )

    activeStop :=
         activeEntry -
         riskPerShare

    activeTarget :=
         activeEntry +
         (
             riskPerShare *
             rewardRisk
         )

    activeTrim :=
         activeEntry +
         (
             activeTarget -
             activeEntry
         ) *
         (
             trimPct /
             100.0
         )

    trimTriggered := false

    entryBarIndex := bar_index

    activeHoldingSessions := 1

    activeTradingDay := time_tradingday

//=============================================================================
// NEW SHORT POSITION
//=============================================================================

if newShort

    activeDirection := -1

    activeEntry :=
         strategy.position_avg_price

    activeInitialRiskCash :=
         strategy.equity *
         (
             riskPct /
             100.0
         )

    riskPerShare =
         activeInitialRiskCash /
         math.abs(
             strategy.position_size
         )

    activeStop :=
         activeEntry +
         riskPerShare

    activeTarget :=
         activeEntry -
         (
             riskPerShare *
             rewardRisk
         )

    activeTrim :=
         activeEntry -
         (
             activeEntry -
             activeTarget
         ) *
         (
             trimPct /
             100.0
         )

    trimTriggered := false

    entryBarIndex := bar_index

    activeHoldingSessions := 1

    activeTradingDay := time_tradingday

//=============================================================================
// TRIM DETECTION — FIXED STRATEGY ENGINE
//
// TRIM is visual only.
// It does NOT reduce or close the position.
//
// GAP:
// Long  -> if OPEN >= TRIM, visual execution = OPEN.
// Short -> if OPEN <= TRIM, visual execution = OPEN.
//=============================================================================

longTrimGapHit =
     showTrimLabel and
     activeDirection == 1 and
     not trimTriggered and
     not na(activeTrim) and
     open >= activeTrim

longTrimNormalHit =
     showTrimLabel and
     activeDirection == 1 and
     not trimTriggered and
     not na(activeTrim) and
     open < activeTrim and
     high >= activeTrim

shortTrimGapHit =
     showTrimLabel and
     activeDirection == -1 and
     not trimTriggered and
     not na(activeTrim) and
     open <= activeTrim

shortTrimNormalHit =
     showTrimLabel and
     activeDirection == -1 and
     not trimTriggered and
     not na(activeTrim) and
     open > activeTrim and
     low <= activeTrim

if longTrimGapHit or longTrimNormalHit

    trimExecutionPrice =
         longTrimGapHit
         ? open
         : activeTrim

    trimLabelText =
         "TRIM " +
         str.tostring(
             trimPct,
             "#"
         ) +
         "% · " +
         f_price(
             trimExecutionPrice
         )

    label.new(
         bar_index + trimLabelBarOffset,
         trimExecutionPrice,
         trimLabelText,
         style = label.style_label_left,
         color = color.new(
             trimLabelColor,
             trimLabelTransparency
         ),
         textcolor = trimTextColor,
         size = f_textSize(
             trimLabelSizeInput
         )
    )

    trimTriggered := true

if shortTrimGapHit or shortTrimNormalHit

    trimExecutionPrice =
         shortTrimGapHit
         ? open
         : activeTrim

    trimLabelText =
         "TRIM " +
         str.tostring(
             trimPct,
             "#"
         ) +
         "% · " +
         f_price(
             trimExecutionPrice
         )

    label.new(
         bar_index + trimLabelBarOffset,
         trimExecutionPrice,
         trimLabelText,
         style = label.style_label_left,
         color = color.new(
             trimLabelColor,
             trimLabelTransparency
         ),
         textcolor = trimTextColor,
         size = f_textSize(
             trimLabelSizeInput
         )
    )

    trimTriggered := true

//=============================================================================
// STOP + TARGET — FIXED STRATEGY ENGINE
//=============================================================================

if strategy.position_size > 0 and
   not na(activeStop) and
   not na(activeTarget)

    strategy.exit(
         "Long Risk Exit",
         from_entry = "Long",
         stop = activeStop,
         limit = activeTarget,
         comment_loss = "STOP",
         comment_profit = "TARGET"
    )

if strategy.position_size < 0 and
   not na(activeStop) and
   not na(activeTarget)

    strategy.exit(
         "Short Risk Exit",
         from_entry = "Short",
         stop = activeStop,
         limit = activeTarget,
         comment_loss = "STOP",
         comment_profit = "TARGET"
    )

//=============================================================================
// HOLDING SESSION COUNTER — FIXED STRATEGY ENGINE
//=============================================================================

newTradingSession =
     strategy.position_size != 0 and
     not na(activeTradingDay) and
     time_tradingday != activeTradingDay

if newTradingSession

    activeHoldingSessions += 1

    activeTradingDay := time_tradingday

//=============================================================================
// TIME EXIT — FIXED STRATEGY ENGINE
//=============================================================================

timeExitReady = false

if strategy.position_size != 0

    if timeframe.isintraday

        endOfMaximumSession =
             activeHoldingSessions >= maxSessions and
             session.islastbar

        fallbackNextSession =
             activeHoldingSessions > maxSessions

        timeExitReady :=
             endOfMaximumSession or
             fallbackNextSession

    else

        timeExitReady :=
             activeHoldingSessions >= maxSessions

if strategy.position_size > 0 and
   timeExitReady

    strategy.close(
         "Long",
         comment = "TIME EXIT",
         immediately = true
    )

if strategy.position_size < 0 and
   timeExitReady

    strategy.close(
         "Short",
         comment = "TIME EXIT",
         immediately = true
    )

//=============================================================================
// R DISTRIBUTION STORAGE — FIXED STRATEGY ENGINE
//=============================================================================

var float sumR = 0.0
var float sumRSquared = 0.0

var int rTradeCount = 0

var int bucketNeg1 = 0
var int bucketNeg05 = 0
var int bucketZero = 0
var int bucketPos05 = 0
var int bucketPos10 = 0
var int bucketPos15 = 0
var int bucketPos20 = 0
var int bucketPos25 = 0
var int bucketPos30 = 0
var int bucketPos35 = 0

var int stopExitCount = 0
var int targetExitCount = 0
var int timeExitCount = 0

var float totalHoldingSessions = 0.0

//=============================================================================
// CLOSED TRADE EVENT — FIXED STRATEGY ENGINE
//=============================================================================

closedTradeEvent =
     strategy.closedtrades >
     nz(
         strategy.closedtrades[1],
         0
     )

if closedTradeEvent

    lastTradeIndex =
         strategy.closedtrades -
         1

    tradeProfit =
         strategy.closedtrades.profit(
             lastTradeIndex
         )

    exitComment =
         strategy.closedtrades.exit_comment(
             lastTradeIndex
         )

    realizedR =
         not na(activeInitialRiskCash) and
         activeInitialRiskCash > 0
         ? tradeProfit /
           activeInitialRiskCash
         : na

    //=========================================================================
    // TARGET → TRIM FALLBACK
    //=========================================================================

    if exitComment == "TARGET" and
       showTrimLabel and
       not trimTriggered and
       not na(activeTrim)

        if activeDirection == 1

            reconstructedTrimPrice =
                 open >= activeTrim
                 ? open
                 : activeTrim

            reconstructedTrimText =
                 "TRIM " +
                 str.tostring(
                     trimPct,
                     "#"
                 ) +
                 "% · " +
                 f_price(
                     reconstructedTrimPrice
                 )

            label.new(
                 bar_index + trimLabelBarOffset,
                 reconstructedTrimPrice,
                 reconstructedTrimText,
                 style = label.style_label_left,
                 color = color.new(
                     trimLabelColor,
                     trimLabelTransparency
                 ),
                 textcolor = trimTextColor,
                 size = f_textSize(
                     trimLabelSizeInput
                 )
            )

            trimTriggered := true

        if activeDirection == -1

            reconstructedTrimPrice =
                 open <= activeTrim
                 ? open
                 : activeTrim

            reconstructedTrimText =
                 "TRIM " +
                 str.tostring(
                     trimPct,
                     "#"
                 ) +
                 "% · " +
                 f_price(
                     reconstructedTrimPrice
                 )

            label.new(
                 bar_index + trimLabelBarOffset,
                 reconstructedTrimPrice,
                 reconstructedTrimText,
                 style = label.style_label_left,
                 color = color.new(
                     trimLabelColor,
                     trimLabelTransparency
                 ),
                 textcolor = trimTextColor,
                 size = f_textSize(
                     trimLabelSizeInput
                 )
            )

            trimTriggered := true

    //=========================================================================
    // R STATISTICS
    //=========================================================================

    if not na(realizedR)

        sumR += realizedR

        sumRSquared +=
             realizedR *
             realizedR

        rTradeCount += 1

        tradeHoldingSessions =
             activeHoldingSessions > 0
             ? activeHoldingSessions
             : 0

        totalHoldingSessions +=
             tradeHoldingSessions

        if exitComment == "TARGET"

            targetExitCount += 1

        else if exitComment == "STOP"

            stopExitCount += 1

        else

            timeExitCount += 1

        roundedR =
             math.round(
                 realizedR *
                 2.0
             ) /
             2.0

        if roundedR <= -1.0

            bucketNeg1 += 1

        else if roundedR <= -0.5

            bucketNeg05 += 1

        else if roundedR < 0.5

            bucketZero += 1

        else if roundedR < 1.0

            bucketPos05 += 1

        else if roundedR < 1.5

            bucketPos10 += 1

        else if roundedR < 2.0

            bucketPos15 += 1

        else if roundedR < 2.5

            bucketPos20 += 1

        else if roundedR < 3.0

            bucketPos25 += 1

        else if roundedR < 3.5

            bucketPos30 += 1

        else

            bucketPos35 += 1

//=============================================================================
// RESET ACTIVE TRADE — FIXED STRATEGY ENGINE
//=============================================================================

positionClosed =
     strategy.position_size == 0 and
     strategy.position_size[1] != 0

if positionClosed

    activeEntry := na

    activeStop := na

    activeTarget := na

    activeTrim := na

    activeInitialRiskCash := na

    trimTriggered := false

    entryBarIndex := na

    activeDirection := 0

    activeHoldingSessions := 0

    activeTradingDay := na

//=============================================================================
// STANDARD BACKTEST METRICS — FIXED STRATEGY ENGINE
//=============================================================================

closedTrades =
     strategy.closedtrades

wins =
     strategy.wintrades

losses =
     strategy.losstrades

winRate =
     closedTrades > 0
     ? wins *
       100.0 /
       closedTrades
     : na

profitFactor =
     math.abs(
         strategy.grossloss
     ) > 0
     ? strategy.grossprofit /
       math.abs(
           strategy.grossloss
       )
     : na

netProfit =
     strategy.netprofit

netROI =
     netProfit /
     3000.0 *
     100.0

//=============================================================================
// R STATISTICS — FIXED STRATEGY ENGINE
//=============================================================================

meanR =
     rTradeCount > 0
     ? sumR /
       rTradeCount
     : na

varianceR =
     rTradeCount > 1
     ? (
         sumRSquared -
         (
             rTradeCount *
             meanR *
             meanR
         )
       ) /
       (
           rTradeCount -
           1
       )
     : na

stdR =
     not na(varianceR)
     ? math.sqrt(
         math.max(
             varianceR,
             0.0
         )
       )
     : na

expectancyR =
     meanR

avgHoldingSessions =
     rTradeCount > 0
     ? totalHoldingSessions /
       rTradeCount
     : na

//=============================================================================
// MAX DRAWDOWN — FIXED STRATEGY ENGINE
//=============================================================================

var float peakEquity =
     3000.0

var float maxDD =
     0.0

peakEquity :=
     math.max(
         peakEquity,
         strategy.equity
     )

currentDD =
     peakEquity > 0
     ? (
         peakEquity -
         strategy.equity
       ) /
       peakEquity *
       100.0
     : 0.0

maxDD :=
     math.max(
         maxDD,
         currentDD
     )

//=============================================================================
// SAMPLE CONFIDENCE — FIXED STRATEGY ENGINE
//=============================================================================

sampleStatus =
     closedTrades >= sampleValidThreshold
     ? "VALID"
     : closedTrades >= sampleLowThreshold
     ? "PRELIM."
     : "LOW"

sampleBg =
     closedTrades >= sampleValidThreshold
     ? positiveBg
     : closedTrades >= sampleLowThreshold
     ? warningBg
     : negativeBg

//=============================================================================
// BACKTEST TABLE — FIXED STRATEGY ENGINE
//
// Column 3 = invisible right-side spacer.
// Row 0    = invisible top-side spacer.
//=============================================================================

var table stats =
     table.new(
         position.middle_right,
         4,
         27,
         bgcolor = spacerColor,
         frame_color = spacerColor,
         frame_width = 0,
         border_color = borderColor,
         border_width = 1
     )

//=============================================================================
// TABLE UPDATE
//=============================================================================

if barstate.islast and
   showTable

    table.set_position(
         stats,
         f_tablePosition(
             tablePositionInput
         )
    )

    txtSize =
         f_textSize(
             tableSizeInput
         )

    txtFont =
         f_font(
             tableFontInput
         )

    //=========================================================================
    // INVISIBLE TOP OFFSET ROW
    //=========================================================================

    table.cell(
         stats,
         0,
         0,
         "",
         height = tableTopOffset,
         bgcolor = spacerColor
    )

    table.cell(
         stats,
         1,
         0,
         "",
         height = tableTopOffset,
         bgcolor = spacerColor
    )

    table.cell(
         stats,
         2,
         0,
         "",
         height = tableTopOffset,
         bgcolor = spacerColor
    )

    table.cell(
         stats,
         3,
         0,
         "",
         width = tableRightOffset,
         height = tableTopOffset,
         bgcolor = spacerColor
    )

    //=========================================================================
    // INVISIBLE RIGHT OFFSET COLUMN
    //=========================================================================

    for rowIndex = 1 to 26

        table.cell(
             stats,
             3,
             rowIndex,
             "",
             width = tableRightOffset,
             bgcolor = spacerColor
        )

    //=========================================================================
    // HEADER
    //=========================================================================

    table.cell(
         stats,
         0,
         1,
         emaPairLabel,
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         1,
         "BACKTEST",
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         1,
         timeframe.period,
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // TRADES
    //=========================================================================

    table.cell(
         stats,
         0,
         2,
         "Trades",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         2,
         str.tostring(
             closedTrades
         ),
         bgcolor = sampleBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         2,
         sampleStatus,
         bgcolor = sampleBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // WINS
    //=========================================================================

    table.cell(
         stats,
         0,
         3,
         "Wins",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         3,
         str.tostring(
             wins
         ),
         bgcolor = positiveBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         3,
         f_pct(
             closedTrades > 0
             ? wins *
               100.0 /
               closedTrades
             : na
         ),
         bgcolor = positiveBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // LOSSES
    //=========================================================================

    table.cell(
         stats,
         0,
         4,
         "Losses",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         4,
         str.tostring(
             losses
         ),
         bgcolor = negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         4,
         f_pct(
             closedTrades > 0
             ? losses *
               100.0 /
               closedTrades
             : na
         ),
         bgcolor = negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // WIN RATE
    //=========================================================================

    table.cell(
         stats,
         0,
         5,
         "Win Rate",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         5,
         f_pct(
             winRate
         ),
         bgcolor = na(winRate)
             ? neutralBg
             : winRate >= 50
             ? positiveBg
             : negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         5,
         "",
         bgcolor = neutralBg
    )

    //=========================================================================
    // PROFIT FACTOR
    //=========================================================================

    table.cell(
         stats,
         0,
         6,
         "Profit Factor",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         6,
         f_num(
             profitFactor
         ),
         bgcolor = na(profitFactor)
             ? neutralBg
             : profitFactor > 1
             ? positiveBg
             : negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         6,
         "",
         bgcolor = neutralBg
    )

    //=========================================================================
    // EXPECTANCY
    //=========================================================================

    table.cell(
         stats,
         0,
         7,
         "Expectancy",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         7,
         f_r(
             expectancyR
         ),
         bgcolor = na(expectancyR)
             ? neutralBg
             : expectancyR > 0
             ? positiveBg
             : negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         7,
         "per trade",
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // NET P&L + ROI
    //=========================================================================

    table.cell(
         stats,
         0,
         8,
         "Net P&L",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         8,
         f_money(
             netProfit
         ),
         bgcolor = netProfit > 0
             ? positiveBg
             : netProfit < 0
             ? negativeBg
             : neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         8,
         f_pct(
             netROI
         ),
         bgcolor = netROI > 0
             ? positiveBg
             : netROI < 0
             ? negativeBg
             : neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // MAX DRAWDOWN
    //=========================================================================

    table.cell(
         stats,
         0,
         9,
         "Max DD",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         9,
         f_pct(
             maxDD
         ),
         bgcolor = maxDD > 0
             ? negativeBg
             : neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         9,
         "",
         bgcolor = neutralBg
    )

    //=========================================================================
    // AVERAGE HOLDING TIME
    //=========================================================================

    table.cell(
         stats,
         0,
         10,
         "Avg Hold",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         10,
         na(avgHoldingSessions)
             ? "N/A"
             : str.tostring(
                 avgHoldingSessions,
                 "#.##"
               ),
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         10,
         "Max " +
         str.tostring(
             maxSessions
         ),
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // TARGET EXITS
    //=========================================================================

    table.cell(
         stats,
         0,
         11,
         "Target Exits",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         11,
         str.tostring(
             targetExitCount
         ),
         bgcolor = positiveBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         11,
         f_pct(
             rTradeCount > 0
             ? targetExitCount *
               100.0 /
               rTradeCount
             : na
         ),
         bgcolor = positiveBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // STOP EXITS
    //=========================================================================

    table.cell(
         stats,
         0,
         12,
         "Stop Exits",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         12,
         str.tostring(
             stopExitCount
         ),
         bgcolor = negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         12,
         f_pct(
             rTradeCount > 0
             ? stopExitCount *
               100.0 /
               rTradeCount
             : na
         ),
         bgcolor = negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // TIME EXITS
    //=========================================================================

    table.cell(
         stats,
         0,
         13,
         "Time Exits",
         bgcolor = bodyBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         13,
         str.tostring(
             timeExitCount
         ),
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         13,
         f_pct(
             rTradeCount > 0
             ? timeExitCount *
               100.0 /
               rTradeCount
             : na
         ),
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // R DISTRIBUTION HEADER
    //=========================================================================

    table.cell(
         stats,
         0,
         14,
         "R DIST.",
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         14,
         "TRADES",
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         14,
         "%",
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // R DISTRIBUTION
    //=========================================================================

    table.cell(stats, 0, 15, "<= -1.0R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 15, str.tostring(bucketNeg1), bgcolor = negativeBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 15, f_bucketPct(bucketNeg1, rTradeCount), bgcolor = negativeBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 16, "-0.5R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 16, str.tostring(bucketNeg05), bgcolor = negativeBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 16, f_bucketPct(bucketNeg05, rTradeCount), bgcolor = negativeBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 17, "0.0R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 17, str.tostring(bucketZero), bgcolor = neutralBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 17, f_bucketPct(bucketZero, rTradeCount), bgcolor = neutralBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 18, "+0.5R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 18, str.tostring(bucketPos05), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 18, f_bucketPct(bucketPos05, rTradeCount), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 19, "+1.0R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 19, str.tostring(bucketPos10), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 19, f_bucketPct(bucketPos10, rTradeCount), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 20, "+1.5R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 20, str.tostring(bucketPos15), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 20, f_bucketPct(bucketPos15, rTradeCount), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 21, "+2.0R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 21, str.tostring(bucketPos20), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 21, f_bucketPct(bucketPos20, rTradeCount), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 22, "+2.5R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 22, str.tostring(bucketPos25), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 22, f_bucketPct(bucketPos25, rTradeCount), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 23, "+3.0R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 23, str.tostring(bucketPos30), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 23, f_bucketPct(bucketPos30, rTradeCount), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    table.cell(stats, 0, 24, ">= +3.5R", bgcolor = bodyBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 1, 24, str.tostring(bucketPos35), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)
    table.cell(stats, 2, 24, f_bucketPct(bucketPos35, rTradeCount), bgcolor = positiveBg, text_color = bodyText, text_size = txtSize, text_font_family = txtFont)

    //=========================================================================
    // MEAN R
    //=========================================================================

    table.cell(
         stats,
         0,
         25,
         "Mean R",
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         25,
         f_r(
             meanR
         ),
         bgcolor = na(meanR)
             ? neutralBg
             : meanR > 0
             ? positiveBg
             : negativeBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         25,
         "Expectancy",
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    //=========================================================================
    // STANDARD DEVIATION
    //=========================================================================

    table.cell(
         stats,
         0,
         26,
         "Std Dev",
         bgcolor = headerBg,
         text_color = headerText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         1,
         26,
         f_r(
             stdR
         ),
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

    table.cell(
         stats,
         2,
         26,
         "Dispersion",
         bgcolor = neutralBg,
         text_color = bodyText,
         text_size = txtSize,
         text_font_family = txtFont
    )

//=============================================================================
// CLEAR TABLE WHEN DISABLED
//=============================================================================

if barstate.islast and
   not showTable

    table.clear(
         stats,
         0,
         0,
         3,
         26
    )

//=============================================================================
// ALERTS
//
// Alerts match executable strategy entries,
// not merely technical EMA crosses.
//=============================================================================

alertcondition(
     entryLongSignal,
     title = "EMA Long Setup",
     message = "Valid executable EMA Long cross sequence."
)

alertcondition(
     entryShortSignal,
     title = "EMA Short Setup",
     message = "Valid executable EMA Short cross sequence."
)