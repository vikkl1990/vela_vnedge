if array.size(_gapsboxesbe) > 0 and extendgapbox and barstate.isconfirmed and gapmitigationtype == 'Rebalance'
    for i = array.size(_gapsboxesbe) - 1 to 0
        box   _box      = array.get(_gapsboxesbe, i)
