//@version=6
indicator("Mass Index", "MI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
NEUTRAL_COLOR = #787b86 // line while no reversal bulge is armed, and the levels
ACCENT_COLOR  = #ff9800 // line while a reversal bulge is armed - the one accent

ZONE_TRANSP = 90 // transparency of the trigger-to-setup band shading
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
sumLengthInput     = input.int(25, "Sum Length", minval = 1, group = "Settings", tooltip = "Number of bars over which the single/double EMA ratio is summed.")
emaLengthInput     = input.int(9, "EMA Length", minval = 1, group = "Settings", tooltip = "Length of the single EMA of the high-low range and of its double smoothing.")
setupLevelInput    = input.float(27.0, "Setup Level", step = 0.1, group = "Settings", tooltip = "Reversal bulge set-up level, a rise above it arms the pattern.")
triggerLevelInput  = input.float(26.5, "Trigger Level", step = 0.1, group = "Settings", tooltip = "Reversal bulge trigger level, a decline below it after a set-up completes the pattern.")

miColorInput       = input.color(NEUTRAL_COLOR, "Mass Index", inline = "line", group = "Style", tooltip = "Mass Index line color while no reversal bulge is armed.")
armedColorInput    = input.color(ACCENT_COLOR, "Armed", inline = "line", group = "Style", tooltip = "Mass Index line color from the rise above the setup level until the decline below the trigger level.")
levelsColorInput   = input.color(NEUTRAL_COLOR, "Levels", group = "Style", tooltip = "Reversal bulge levels color.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
singleEma = ta.ema(high - low, emaLengthInput)
doubleEma = ta.ema(singleEma, emaLengthInput)

// Flat-market guard: a zero double EMA yields the neutral ratio 1 instead of na
emaRatio  = doubleEma == 0 ? 1.0 : singleEma / doubleEma
massIndex = math.sum(emaRatio, sumLengthInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// Armed state for coloring only - set by the rise above the setup level, cleared by the decline below the trigger level
var bool bulgeArmed = false
bulgeArmed := massIndex > setupLevelInput ? true : massIndex < triggerLevelInput ? false : bulgeArmed

plot(massIndex, "Mass Index", bulgeArmed ? armedColorInput : miColorInput)

hline(setupLevelInput, "Setup Level", levelsColorInput, hline.style_dashed)
hline(triggerLevelInput, "Trigger Level", levelsColorInput, hline.style_dashed)

setupAnchorId   = plot(setupLevelInput, "Setup Anchor", color(na), editable = false, display = display.none)
triggerAnchorId = plot(triggerLevelInput, "Trigger Anchor", color(na), editable = false, display = display.none)

fill(setupAnchorId, triggerAnchorId, color.new(armedColorInput, ZONE_TRANSP), title = "Bulge Band")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
bulgeSetup   = ta.crossover(massIndex, setupLevelInput)
bulgeTrigger = ta.crossunder(massIndex, triggerLevelInput)

alertcondition(bulgeSetup, "Bulge Setup", "Mass Index crossed above 27")
alertcondition(bulgeTrigger, "Bulge Trigger", "Mass Index crossed below 26.5")
//----------------------------------------------------------------------------------------------------------------------}
