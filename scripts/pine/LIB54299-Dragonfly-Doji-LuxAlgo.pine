//@version=6
indicator("Dragonfly Doji", "Dragonfly Doji", overlay = true, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
PATTERN_TXT = 'Dragonfly'
BULL_TIP    = 'Dragonfly doji: the entire session traded below the open, was rejected, and returned. Potential demand response at lower prices - wait for a confirming close above the body.'
WARN_TIP    = 'Dragonfly doji after an advance: probing, indecisive trade that can precede a top.'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
bodyPctInput        = input.float(5., 'Maximum Body Size %', minval = 0, maxval = 25, step = 0.5, group = 'Pattern', tooltip = 'Maximum real body height as a percentage of the bar range. Open and close must sit this close together for the bar to qualify as a doji.')
upperPctInput       = input.float(10., 'Maximum Upper Shadow %', minval = 0, maxval = 50, step = 0.5, group = 'Pattern', tooltip = 'Maximum upper shadow as a percentage of the bar range. Keeps open, close and high together at the top of the bar, preserving the T shape.')
shadowBodyMultInput = input.float(2., 'Minimum Shadow / Body Ratio', minval = 0, step = 0.5, group = 'Pattern', tooltip = 'Minimum lower shadow length as a multiple of the real body height. At least two to three times the body is the common requirement.')
shadowAtrMultInput  = input.float(1., 'Minimum Shadow Length', minval = 0, step = 0.25, inline = 'atr', group = 'Pattern', tooltip = 'ATR multiple the lower shadow must reach.')
atrLenInput         = input.int(14, 'x ATR', minval = 1, inline = 'atr', group = 'Pattern', tooltip = 'Minimum lower shadow length as a multiple of the Average True Range, so the shadow is long relative to recent bars rather than only relative to a tiny body.')

requireDeclineInput = input.bool(true, 'Require Prior Decline', group = 'Context', tooltip = 'Only flag dragonflies closing below the trend average, i.e. printing after a decline into lower prices. In the middle of a range the shape is mostly noise.')
trendLenInput       = input.int(50, 'Trend SMA Length', minval = 2, group = 'Context', tooltip = 'Simple moving average length used to classify the prior trend as a decline or an advance.')
advanceWarnInput    = input.bool(false, 'Flag Dragonflies After An Advance', group = 'Context', tooltip = 'Additionally flag dragonflies printing above the trend average. Some treatments read the probing, indecisive trade after an advance as a warning that can precede a top.')
volumeFilterInput   = input.bool(false, 'Require Elevated Volume', group = 'Context', tooltip = 'Require elevated volume on the pattern bar; an active recovery supports the demand-response reading. Disable on symbols without volume data.')
volMultInput        = input.float(1.5, 'Minimum Volume', minval = 0, step = 0.1, inline = 'vol', group = 'Context', tooltip = 'Multiple of average volume the pattern bar must exceed.')
volLenInput         = input.int(20, 'x SMA', minval = 1, inline = 'vol', group = 'Context', tooltip = 'Volume must exceed this multiple of its simple moving average for the session to count as elevated.')

confirmBarsInput    = input.int(3, 'Confirmation Window (Bars)', minval = 1, maxval = 50, group = 'Confirmation', tooltip = 'Number of bars allowed for a close above the dragonfly body to confirm the reversal reading. A close back below the shadow low before confirmation invalidates the pattern.')

showLevelsInput = input.bool(true, 'Trigger & Stop Levels', group = 'Style', tooltip = 'Draw the confirmation trigger at the dragonfly body top and the natural stop at the shadow low while the pattern awaits confirmation.')
bullColorInput  = input.color(#089981, 'Bullish Dragonfly', group = 'Style')
warnColorInput  = input.color(#f23645, 'Top Warning / Invalidation', group = 'Style')

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{
barRange    = high - low
body        = math.abs(close - open)
bodyTop     = math.max(close, open)
upperShadow = high - bodyTop
lowerShadow = math.min(close, open) - low

atrValue = ta.atr(atrLenInput)
trendSma = ta.sma(close, trendLenInput)
volSma   = ta.sma(volume, volLenInput)

// T shape: negligible body at the top of the range, little or no upper shadow, long lower shadow
dojiBody    = barRange > 0 and body <= barRange * bodyPctInput / 100
smallUpper  = barRange > 0 and upperShadow <= barRange * upperPctInput / 100
longShadow  = lowerShadow > 0 and lowerShadow >= body * shadowBodyMultInput and not na(atrValue) and lowerShadow >= atrValue * shadowAtrMultInput
elevatedVol = not volumeFilterInput or not na(volSma) and volume > volSma * volMultInput

isDragonfly = dojiBody and smallUpper and longShadow and elevatedVol

// Context: after a decline the shape reads as rejection of lower prices, after an advance as a possible warning
decline = not na(trendSma) and close < trendSma
advance = not na(trendSma) and close > trendSma

warnSignal = isDragonfly and advanceWarnInput and advance
bullSignal = isDragonfly and not warnSignal and (not requireDeclineInput or decline)

//---------------------------------------------------------------------------------------------------------------------}
// Confirmation Tracking
//---------------------------------------------------------------------------------------------------------------------{
var float pendingTrigger = na
var float pendingStop    = na
var int   pendingBar     = na
var line  triggerLine    = na
var line  stopLine       = na

confirmEvent = false
invalidEvent = false

// Resolve any pending dragonfly with this bar's close
if not na(pendingBar) and bar_index > pendingBar
    if close > pendingTrigger
        confirmEvent := true
    else if close < pendingStop
        invalidEvent := true

    if not na(triggerLine)
        line.set_x2(triggerLine, bar_index)
        line.set_x2(stopLine, bar_index)

    if confirmEvent or invalidEvent or bar_index - pendingBar >= confirmBarsInput
        pendingTrigger := na
        pendingStop    := na
        pendingBar     := na
        triggerLine    := na
        stopLine       := na

// A new bullish dragonfly starts (or replaces) the pending pattern
if bullSignal
    pendingTrigger := bodyTop
    pendingStop    := low
    pendingBar     := bar_index

    if showLevelsInput
        triggerLine := line.new(bar_index, bodyTop, bar_index + 1, bodyTop, color = bullColorInput, style = line.style_dashed)
        stopLine    := line.new(bar_index, low, bar_index + 1, low, color = warnColorInput, style = line.style_dashed)
    else
        triggerLine := na
        stopLine    := na

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
if bullSignal
    label.new(bar_index, low, PATTERN_TXT, style = label.style_label_up, color = #00000000, textcolor = bullColorInput, size = size.small, tooltip = BULL_TIP)

if warnSignal
    label.new(bar_index, high, PATTERN_TXT, style = label.style_label_down, color = #00000000, textcolor = warnColorInput, size = size.small, tooltip = WARN_TIP)

plotshape(confirmEvent, 'Confirmation', shape.triangleup, location.belowbar, color = bullColorInput, size = size.tiny)
plotshape(invalidEvent, 'Invalidation', shape.xcross, location.belowbar, color = warnColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullSignal, 'Dragonfly Doji Detected', 'Dragonfly doji detected - the full round trip to lower prices was rejected. Watch for a confirming close above the body.')
alertcondition(warnSignal, 'Dragonfly Doji After Advance', 'Dragonfly doji after an advance - probing, indecisive trade that can precede a top.')
alertcondition(confirmEvent, 'Dragonfly Doji Confirmed', 'Confirming close above the dragonfly body - bullish reversal reading confirmed.')
alertcondition(invalidEvent, 'Dragonfly Doji Invalidated', 'Close back below the dragonfly shadow low - rejected prices have been accepted, pattern invalidated.')

//---------------------------------------------------------------------------------------------------------------------}
