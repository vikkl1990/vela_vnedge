//@version=6
indicator("Center of Gravity", shorttitle = "Center of Gravity", overlay = false, format = format.price, precision = 2, max_bars_back = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
TRIGGER_COLOR     = #ff9800 // one-bar-delayed trigger line color
MIDLINE_COLOR     = #787b86 // balance reference midline color
FILL_VALUE_TRANSP = 50      // gradient transparency at the oscillator value
FILL_MID_TRANSP   = 100     // gradient transparency at the midline

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(10, "Length", minval = 2, maxval = 500
  , group   = "Settings"
  , tooltip = "Number of bars N in the window whose balance point is measured - the oscillator's only parameter. Ehlers's published examples use around 10, and the tool behaves best near half the length of the dominant cycle. Because the centroid is recomputed from the whole window each bar, changing N changes both the smoothness and the timing of every crossing.")

srcInput = input.source(hl2, "Source"
  , group   = "Settings"
  , tooltip = "Price series the window is built from. Ehlers's original construction uses the median price - the average of high and low (HL2).")

centerInput = input.bool(true, "Center on Zero"
  , group   = "Settings"
  , tooltip = "Adds the constant (N + 1) / 2 offset used in published versions so the line swings around zero. Disable for the raw negated centroid, which rests around -(N + 1) / 2 instead; the midline and gradient follow either convention.")

//---------------------------------------------------------------------------------------------------------------------}
// Style
//---------------------------------------------------------------------------------------------------------------------{
bullColorInput = input.color(BULL_COLOR, "Bullish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of the oscillator and of the gradient fill while the CG holds above its one-bar trigger line.")

bearColorInput = input.color(BEAR_COLOR, "Bearish", inline = "direction"
  , group   = "Style"
  , tooltip = "Color of the oscillator and of the gradient fill while the CG holds below its one-bar trigger line.")

triggerColorInput = input.color(TRIGGER_COLOR, "Trigger Line"
  , group   = "Style"
  , tooltip = "Color of the trigger line - the one-bar-delayed copy of the oscillator whose crossings mark cycle turns.")

midlineColorInput = input.color(MIDLINE_COLOR, "Midline"
  , group   = "Style"
  , tooltip = "Color of the balance reference line the gradient is anchored to - zero when centering is on, the raw resting level -(N + 1) / 2 otherwise.")

gradientInput = input.bool(true, "Gradient Fill"
  , group   = "Style"
  , tooltip = "Vertical gradient between the oscillator and the midline, fully transparent at the midline and strongest at the oscillator value, colored by the trigger cross state.")

showMarkersInput = input.bool(false, "Trigger Cross Markers"
  , group   = "Style"
  , tooltip = "Displays a circle on the trigger line wherever the oscillator crosses it. Off by default to keep the pane clean - the crossing alerts work regardless.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Centroid of the window - each bar's price is weighted by its position, the newest bar counting as one and the
// oldest as N; the negated ratio of the weighted-price sum to the plain price sum is the window's balance point
// measured in bar positions. When rising prices load the front of the window the centroid shifts toward the
// newest bars and the line turns up; when the oldest bars carry the weight, it turns down
float centroid = na

if bar_index >= lengthInput - 1
    float weightedSum = 0.0
    float priceSum    = 0.0
    bool  windowFull  = true
    for i = 0 to lengthInput - 1
        float sample = srcInput[i]
        if na(sample)
            windowFull := false
            break
        weightedSum += (i + 1) * sample
        priceSum    += sample
    if windowFull and priceSum != 0
        centroid := -weightedSum / priceSum

// Perfectly flat prices weigh every bar equally and rest the centroid exactly mid-window at -(N + 1) / 2, so the
// published zero-centering offset simply re-bases that resting level to zero. The trigger is the standard
// one-bar-delayed copy of the oscillator
float balanceLevel = -(lengthInput + 1) / 2.0

float cg      = centerInput ? centroid - balanceLevel : centroid
float trigger = cg[1]
float midline = centerInput ? 0.0 : balanceLevel

// Trigger crossings - the CG signal grammar. An upward cross is a cycle-trough cue and a downward cross a crest
// cue, read against the oscillator's own recent envelope since the line carries no fixed bounds, and meant to be
// traded while price is ranging rather than trending
bullCross = ta.crossover(cg, trigger)
bearCross = ta.crossunder(cg, trigger)

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// The oscillator carries the cross state - bullish while it holds above its one-bar trigger, bearish while below.
// Pinning shows up as one color hugging one side of the pane, the cue to stand counter-trend signals down
crossStateColor = cg >= trigger ? bullColorInput : bearColorInput

// Centered-oscillator gradient - fully transparent at the midline, strongest at the oscillator value, sharing the
// line's cross-state color
fillTopColor    = cg >= midline ? color.new(crossStateColor, FILL_VALUE_TRANSP) : color.new(crossStateColor, FILL_MID_TRANSP)
fillBottomColor = cg >= midline ? color.new(crossStateColor, FILL_MID_TRANSP) : color.new(crossStateColor, FILL_VALUE_TRANSP)

cgPlotId = plot(cg, "CG", crossStateColor, 2)

plot(trigger, "Trigger Line", triggerColorInput, 1)

midlinePlotId = plot(midline, "Midline", color.new(midlineColorInput, 50), 1)

fill(cgPlotId, midlinePlotId
  , math.max(cg, midline)
  , math.min(cg, midline)
  , gradientInput ? fillTopColor : na
  , gradientInput ? fillBottomColor : na
  , title = "Midline Gradient Fill")

// Optional markers for the trigger crossings, drawn on the trigger line where the cross fired
plot(showMarkersInput and bullCross ? trigger : na, "Bullish Cross Marker", color = bullColorInput, linewidth = 2, style = plot.style_circles)
plot(showMarkersInput and bearCross ? trigger : na, "Bearish Cross Marker", color = bearColorInput, linewidth = 2, style = plot.style_circles)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullCross, "Bullish Trigger Cross", "Center of Gravity crossed above its one-bar trigger on {{ticker}} - cycle-trough cue, strongest near the bottom of the oscillator's recent envelope while price is ranging ({{interval}})")
alertcondition(bearCross, "Bearish Trigger Cross", "Center of Gravity crossed below its one-bar trigger on {{ticker}} - cycle-crest cue, strongest near the top of the oscillator's recent envelope while price is ranging ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
