//@version=6
indicator("Double-bottom Base", shorttitle = "Double-bottom Base", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 250)

//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{

int MAX_SWINGS = 12

color BULL_COLOR        = #089981
color BEAR_COLOR        = #f23645
color NEUTRAL_COLOR     = #787b86
color TRANSPARENT_COLOR = #00000000

int ZONE_FILL_TRANSP       = 88
int ZONE_BORDER_TRANSP     = 40
int SHAKEOUT_FILL_TRANSP   = 92
int SHAKEOUT_BORDER_TRANSP = 60
int DIM_TRANSP             = 65

// A handle on the right side of the W must form in the upper half of the base to shift the buy point
float HANDLE_MIN_POS_PCT = 50.0

color DIM_COLOR = color.new(NEUTRAL_COLOR, DIM_TRANSP)

string STRUCTURE_GROUP = 'Structure'
string UPTREND_GROUP   = 'Prior Uptrend'
string BREAKOUT_GROUP  = 'Breakout'
string RISK_GROUP      = 'Trade Levels'
string DASH_GROUP      = 'Dashboard'
string STYLE_GROUP     = 'Style'

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{

swingLengthInput = input.int(5, 'Swing Detection Length', minval = 2, maxval = 50, group = STRUCTURE_GROUP, tooltip = 'Bars required on each side of a pivot before a swing high or swing low is confirmed. The two sell-offs and the interim rally of the W are traced from these swings; larger values return wider, cleaner legs but confirm them later.')

minLengthInput = input.int(35, 'Base Length (bars)', minval = 5, maxval = 500, inline = 'length', group = STRUCTURE_GROUP, tooltip = 'Minimum number of bars from the left-side high to the pivot breakout for the base to qualify. The specification expects at least about seven weeks: roughly 35 daily bars, or 7 bars on a weekly chart.')
maxLengthInput = input.int(250, '', minval = 20, maxval = 500, inline = 'length', group = STRUCTURE_GROUP, tooltip = 'Maximum age of the structure, measured from the left-side high. A pending W older than this is dropped as stale rather than kept waiting for a breakout indefinitely.')

minDepthInput = input.float(10.0, 'Base Depth (%)', minval = 0.1, maxval = 80, step = 0.5, inline = 'depth', group = STRUCTURE_GROUP, tooltip = 'Minimum correction from the left-side high to the undercut low. Shallow sideways drifts with no dramatic lows are a different, flat structure rather than a two-legged correction.')
maxDepthInput = input.float(40.0, '', minval = 0.1, maxval = 90, step = 0.5, inline = 'depth', group = STRUCTURE_GROUP, tooltip = 'Maximum correction from the left-side high to the undercut low, keeping depth in the range of other intermediate corrections rather than extreme. Corrections far beyond this usually indicate a damaged stock rather than a base.')

midPeakPosInput = input.float(50.0, 'Minimum Mid-Peak Position (%)', minval = 0, maxval = 95, step = 1, group = STRUCTURE_GROUP, tooltip = 'Lowest allowed position of the middle peak of the W inside the base range, where 0% is the lows and 100% is the left-side high. The middle peak should sit in the upper portion of the structure rather than barely off the lows.')

maxUndercutInput = input.float(8.0, 'Maximum Undercut (%)', minval = 0.5, maxval = 50, step = 0.5, group = STRUCTURE_GROUP, tooltip = 'How far below the first low the second low may print, as a percent of the first low. The undercut shakeout is required - even a slight one - but a second leg collapsing far beneath the first low is a decline, not a W.')

uptrendFilterInput = input.bool(true, 'Prior Uptrend Filter', group = UPTREND_GROUP, tooltip = 'Require an advance worth basing after before the left-side high, as the pattern is defined for stocks correcting within an uptrend.')
uptrendLengthInput = input.int(100, 'Uptrend Window (bars)', minval = 10, maxval = 500, group = UPTREND_GROUP, tooltip = 'Number of bars before the left-side high inspected for the prior advance.')
uptrendGainInput   = input.float(25.0, 'Minimum Prior Advance (%)', minval = 0, maxval = 500, step = 1, group = UPTREND_GROUP, tooltip = 'Minimum rise from the lowest low of the uptrend window to the left-side high for the preceding move to count as an uptrend worth basing after.')
leftHighTolInput   = input.float(2.0, 'Left High Tolerance (%)', minval = 0, maxval = 25, step = 0.5, group = UPTREND_GROUP, tooltip = 'The left-side high must be within this percentage of the highest high of the uptrend window, so the correction starts from the top of the advance instead of partway down an established decline.')

pivotMarginInput = input.float(0.1, 'Pivot Margin (%)', minval = 0, maxval = 5, step = 0.05, group = BREAKOUT_GROUP, tooltip = 'Small margin added above the middle peak of the W (or above the handle high) to form the buy point, so the entry triggers on a decisive push through the pivot rather than an exact touch.')

volConfirmInput = input.bool(true, 'Breakout Volume Confirmation', group = BREAKOUT_GROUP, tooltip = 'Require the breakout close above the buy point to occur on volume well above average. A close through the pivot without this expansion leaves the base pending and fires a caution alert instead. Disable on symbols without volume data.')
volLengthInput  = input.int(50, 'Volume Average Length', minval = 1, maxval = 200, group = BREAKOUT_GROUP, tooltip = 'Length of the simple moving average of volume used as the reference for breakout expansion and for the volume-character readings of the base.')
volMultInput    = input.float(1.4, 'Breakout Volume Multiplier', minval = 1, maxval = 10, step = 0.1, group = BREAKOUT_GROUP, tooltip = 'The breakout bar volume must exceed the volume average multiplied by this factor, consistent with the guideline of volume at least 40 percent above average on a valid breakout.')

handleEnableInput = input.bool(true, 'Detect Handle Variant', group = BREAKOUT_GROUP, tooltip = 'Some double bottoms add a small handle after the right side forms. When a swing high prints in the upper half of the base after the undercut low, the buy point shifts to that handle high plus the pivot margin, often tightening the entry.')

buyZoneInput = input.float(5.0, 'Buy Zone (%)', minval = 0.5, maxval = 25, step = 0.5, group = RISK_GROUP, tooltip = 'Extent of the buy zone above the buy point. The standard play buys the push through the pivot within a small zone; chasing beyond it gives up the early-entry edge of the pattern.')

stopEnableInput  = input.bool(true, 'Fixed Stop After Breakout', inline = 'stop', group = RISK_GROUP, tooltip = 'Track a fixed percentage stop below the buy point once the breakout confirms, capping losses per the standard practice.')
stopPercentInput = input.float(7.0, '', minval = 0.5, maxval = 30, step = 0.5, inline = 'stop', group = RISK_GROUP, tooltip = 'Distance of the fixed percentage stop below the buy point. A close below the undercut low also ends the trade watch, as the undercut serves as the structural invalidation for the whole base.')

monitorLengthInput = input.int(125, 'Post-Breakout Watch (bars)', minval = 5, maxval = 500, group = RISK_GROUP, tooltip = 'Number of bars the buy zone and stop are tracked after a confirmed breakout. The watch also ends early when price regains the left-side high or breaks the protective levels.')

showDashInput     = input.bool(true, 'Show Dashboard', group = DASH_GROUP, tooltip = 'Display a summary of the active base: status, buy point, proportions, and the volume character of the sell-offs and the right-side recovery.')
dashLocationInput = input.string('Top Right', 'Location', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left', 'Middle Right'], group = DASH_GROUP, tooltip = 'Position of the dashboard on the chart.')
dashSizeInput     = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal'], group = DASH_GROUP, tooltip = 'Text size of the dashboard.')

bullColorInput    = input.color(BULL_COLOR, 'Confirmed', inline = 'colors', group = STYLE_GROUP)
bearColorInput    = input.color(BEAR_COLOR, 'Shakeout', inline = 'colors', group = STYLE_GROUP)
neutralColorInput = input.color(NEUTRAL_COLOR, 'Pending', inline = 'colors', group = STYLE_GROUP)

showStructureInput   = input.bool(true, 'Show W Structure', group = STYLE_GROUP)
showShakeoutInput    = input.bool(true, 'Show Undercut Shakeout Zone', group = STYLE_GROUP)
showLevelsInput      = input.bool(true, 'Show Buy Level & Buy Zone', group = STYLE_GROUP)
showInvalidatedInput = input.bool(true, 'Keep Invalidated Bases', group = STYLE_GROUP, tooltip = 'Keep the drawings of invalidated bases on the chart, dimmed, instead of removing them.')

float effMaxDepth  = math.max(minDepthInput, maxDepthInput)
int   effMaxLength = math.max(minLengthInput, maxLengthInput)

//---------------------------------------------------------------------------------------------------------------------}
// Variables
//---------------------------------------------------------------------------------------------------------------------{

var array<bool>  swingIsHighArray  = array.new_bool()
var array<float> swingPriceArray   = array.new_float()
var array<int>   swingBarArray     = array.new_int()
var array<float> swingCumVolArray  = array.new_float()
var array<float> swingCumUpArray   = array.new_float()
var array<float> swingCumDnArray   = array.new_float()
var array<float> swingVolAvgArray  = array.new_float()
var array<bool>  swingUptrendArray = array.new_bool()

var bool  patternActive  = false
var float baseHighPrice  = na
var int   baseHighBar    = na
var float firstLowPrice  = na
var int   firstLowBar    = na
var float midPeakPrice   = na
var int   midPeakBar     = na
var float secondLowPrice = na
var int   secondLowBar   = na

var float buyLevel      = na
var bool  handleActive  = false
var float handlePrice   = na
var int   handleBar     = na
var bool  reclaimed     = false
var bool  wasAbovePivot = false

var float lowsVolRatio    = na
var float rightUpBaseline = na
var float rightDnBaseline = na
var float rightSideRatio  = na

var bool  riskActive    = false
var float riskBuyLevel  = na
var float riskStopLevel = na
var float riskUndercut  = na
var float riskPriorHigh = na
var int   riskStartBar  = na

var line  wLine1Id        = na
var line  wLine2Id        = na
var line  wLine3Id        = na
var line  buyLineId       = na
var label buyLabelId      = na
var label titleLabelId    = na
var label undercutLabelId = na
var label reclaimLabelId  = na
var label handleLabelId   = na
var box   shakeoutBoxId   = na
var box   zoneBoxId       = na
var line  stopLineId      = na
var label stopLabelId     = na

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{

// Appends a confirmed swing to the alternating swing series, or extends the last swing when two same-direction
// pivots occur in a row (the more extreme one is kept). Returns true when the stored swings changed.
addSwing(bool isHigh, float price, int barIdx, float cumVol, float cumUp, float cumDn, float volAvg, bool uptrendFlag) =>
    int  swingCount = array.size(swingPriceArray)
    bool changed    = false

    if swingCount > 0 and array.get(swingIsHighArray, swingCount - 1) == isHigh
        float lastPrice = array.get(swingPriceArray, swingCount - 1)

        if (isHigh and price >= lastPrice) or (not isHigh and price <= lastPrice)
            array.set(swingPriceArray, swingCount - 1, price)
            array.set(swingBarArray, swingCount - 1, barIdx)
            array.set(swingCumVolArray, swingCount - 1, cumVol)
            array.set(swingCumUpArray, swingCount - 1, cumUp)
            array.set(swingCumDnArray, swingCount - 1, cumDn)
            array.set(swingVolAvgArray, swingCount - 1, volAvg)
            array.set(swingUptrendArray, swingCount - 1, uptrendFlag)
            changed := true
    else
        array.push(swingIsHighArray, isHigh)
        array.push(swingPriceArray, price)
        array.push(swingBarArray, barIdx)
        array.push(swingCumVolArray, cumVol)
        array.push(swingCumUpArray, cumUp)
        array.push(swingCumDnArray, cumDn)
        array.push(swingVolAvgArray, volAvg)
        array.push(swingUptrendArray, uptrendFlag)
        changed := true

        if array.size(swingPriceArray) > MAX_SWINGS
            array.shift(swingIsHighArray)
            array.shift(swingPriceArray)
            array.shift(swingBarArray)
            array.shift(swingCumVolArray)
            array.shift(swingCumUpArray)
            array.shift(swingCumDnArray)
            array.shift(swingVolAvgArray)
            array.shift(swingUptrendArray)

    changed

// Removes a drawing when its base is dismissed, or dims it in place when invalidated history is kept.
cleanupLine(line lineId, bool keepDimmed) =>
    if not na(lineId)
        if keepDimmed
            line.set_color(lineId, DIM_COLOR)
        else
            line.delete(lineId)
    line(na)

cleanupLabel(label labelId, bool keepDimmed) =>
    if not na(labelId)
        if keepDimmed
            label.set_textcolor(labelId, DIM_COLOR)
        else
            label.delete(labelId)
    label(na)

cleanupBox(box boxId, bool keepDimmed) =>
    if not na(boxId)
        if keepDimmed
            box.set_border_color(boxId, DIM_COLOR)
            box.set_bgcolor(boxId, color.new(NEUTRAL_COLOR, 95))
        else
            box.delete(boxId)
    box(na)

getTablePosition(string positionText) =>
    switch positionText
        'Top Left'     => position.top_left
        'Bottom Right' => position.bottom_right
        'Bottom Left'  => position.bottom_left
        'Middle Right' => position.middle_right
        =>                position.top_right

getTableSize(string sizeText) =>
    switch sizeText
        'Tiny'   => size.tiny
        'Normal' => size.normal
        =>          size.small

//---------------------------------------------------------------------------------------------------------------------}
// Swing Detection
//---------------------------------------------------------------------------------------------------------------------{

float volSma = ta.sma(nz(volume), volLengthInput)

float pivotHighPrice = ta.pivothigh(high, swingLengthInput, swingLengthInput)
float pivotLowPrice  = ta.pivotlow(low, swingLengthInput, swingLengthInput)

var float cumVolume   = 0.0
var float cumUpVolume = 0.0
var float cumDnVolume = 0.0

bool upBar = close > nz(close[1], close)
bool dnBar = close < nz(close[1], close)

cumVolume   += nz(volume)
cumUpVolume += upBar ? nz(volume) : 0
cumDnVolume += dnBar ? nz(volume) : 0

// Prior-advance measurements taken over the window that ends just before the candidate left-side high
float windowHigh = ta.highest(high, uptrendLengthInput)
float windowLow  = ta.lowest(low, uptrendLengthInput)

float priorWindowHigh = windowHigh[swingLengthInput + 1]
float priorWindowLow  = windowLow[swingLengthInput + 1]

bool pivotUptrendOk = not uptrendFilterInput or (not na(priorWindowHigh) and not na(priorWindowLow) and priorWindowLow > 0 and high[swingLengthInput] >= priorWindowHigh * (1 - leftHighTolInput / 100) and (high[swingLengthInput] / priorWindowLow - 1) * 100 >= uptrendGainInput)

int   pivotBar    = bar_index - swingLengthInput
float pivotCumVol = cumVolume[swingLengthInput]
float pivotCumUp  = cumUpVolume[swingLengthInput]
float pivotCumDn  = cumDnVolume[swingLengthInput]
float pivotVolAvg = volSma[swingLengthInput]

bool highSwingEvent = false
bool lowSwingEvent  = false

if not na(pivotHighPrice)
    highSwingEvent := addSwing(true, pivotHighPrice, pivotBar, pivotCumVol, pivotCumUp, pivotCumDn, pivotVolAvg, pivotUptrendOk)

if not na(pivotLowPrice)
    lowSwingEvent := addSwing(false, pivotLowPrice, pivotBar, pivotCumVol, pivotCumUp, pivotCumDn, pivotVolAvg, pivotUptrendOk)

bool detectedEvent     = false
bool reclaimEvent      = false
bool handleFormedEvent = false
bool breakoutEvent     = false
bool weakVolumeEvent   = false
bool invalidatedEvent  = false
bool stopHitEvent      = false

//---------------------------------------------------------------------------------------------------------------------}
// Handle Variant
//---------------------------------------------------------------------------------------------------------------------{

if patternActive and handleEnableInput and highSwingEvent
    int   swingCount = array.size(swingPriceArray)
    float lastHigh   = array.get(swingPriceArray, swingCount - 1)
    int   lastBar    = array.get(swingBarArray, swingCount - 1)

    if lastBar > secondLowBar and lastHigh < baseHighPrice
        float handlePosPct = 100 * (lastHigh - secondLowPrice) / (baseHighPrice - secondLowPrice)

        if handlePosPct >= HANDLE_MIN_POS_PCT
            float newBuyLevel = lastHigh * (1 + pivotMarginInput / 100)

            handleFormedEvent := newBuyLevel != buyLevel
            handleActive      := true
            handlePrice       := lastHigh
            handleBar         := lastBar
            buyLevel          := newBuyLevel

            if not na(buyLineId)
                line.set_xy1(buyLineId, handleBar, buyLevel)
                line.set_xy2(buyLineId, bar_index, buyLevel)
                label.set_xy(buyLabelId, bar_index, buyLevel)
                label.set_text(buyLabelId, 'Buy ' + str.tostring(buyLevel, format.mintick))

            if na(handleLabelId)
                handleLabelId := label.new(handleBar, handlePrice, 'Handle', style = label.style_label_down, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.tiny)
            else
                label.set_xy(handleLabelId, handleBar, handlePrice)

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Management
//---------------------------------------------------------------------------------------------------------------------{

if patternActive
    if not na(buyLineId)
        line.set_x2(buyLineId, bar_index)
        label.set_x(buyLabelId, bar_index)

    if not na(shakeoutBoxId) and not reclaimed
        box.set_right(shakeoutBoxId, bar_index)

    // Volume character of the right-side recovery: supportive up-volume versus down-volume since the undercut low
    float rightUpVol = cumUpVolume - rightUpBaseline
    float rightDnVol = cumDnVolume - rightDnBaseline
    rightSideRatio := rightDnVol > 0 ? rightUpVol / rightDnVol : na

    // Fast reclaim of the first low is the early tell that the shakeout is working
    if not reclaimed and close > firstLowPrice
        reclaimed      := true
        reclaimEvent   := true
        reclaimLabelId := label.new(bar_index, low, 'Reclaim', style = label.style_label_up, color = TRANSPARENT_COLOR, textcolor = bullColorInput, size = size.tiny)

    int  swingCount       = array.size(swingPriceArray)
    bool rightSideStarted = swingCount > 0 and array.get(swingIsHighArray, swingCount - 1) and array.get(swingBarArray, swingCount - 1) > secondLowBar

    bool undercutBroken = low < secondLowPrice
    bool thirdTrip      = rightSideStarted and low < firstLowPrice
    bool timedOut       = bar_index - baseHighBar > effMaxLength

    bool nowAbove   = close > buyLevel
    bool crossedUp  = nowAbove and not wasAbovePivot
    wasAbovePivot  := nowAbove

    bool volumeOk   = not volConfirmInput or nz(volume) > volMultInput * volSma
    bool longEnough = bar_index - baseHighBar >= minLengthInput

    if undercutBroken or thirdTrip or timedOut
        invalidatedEvent := true
    else if crossedUp
        if not longEnough
            invalidatedEvent := true
        else if volumeOk
            breakoutEvent := true
        else
            weakVolumeEvent := true

            if close > baseHighPrice
                invalidatedEvent := true
    else if close > baseHighPrice
        invalidatedEvent := true

    if breakoutEvent
        patternActive := false

        if not na(wLine1Id)
            line.set_color(wLine1Id, bullColorInput)
            line.set_color(wLine2Id, bullColorInput)
            line.set_color(wLine3Id, bullColorInput)

        if not na(titleLabelId)
            label.set_textcolor(titleLabelId, bullColorInput)

        if showStructureInput
            line.new(secondLowBar, secondLowPrice, bar_index, close, color = bullColorInput)

        if not na(buyLineId)
            line.set_color(buyLineId, bullColorInput)
            line.set_x2(buyLineId, bar_index)
            label.set_textcolor(buyLabelId, bullColorInput)
            label.set_x(buyLabelId, bar_index)

        label.new(bar_index, low, 'Breakout', style = label.style_label_up, color = bullColorInput, textcolor = chart.bg_color, size = size.small)

        riskActive    := true
        riskBuyLevel  := buyLevel
        riskStopLevel := buyLevel * (1 - stopPercentInput / 100)
        riskUndercut  := secondLowPrice
        riskPriorHigh := baseHighPrice
        riskStartBar  := bar_index

        if showLevelsInput
            zoneBoxId := box.new(bar_index, riskBuyLevel * (1 + buyZoneInput / 100), bar_index, riskBuyLevel, border_color = color.new(bullColorInput, ZONE_BORDER_TRANSP), border_width = 1, bgcolor = color.new(bullColorInput, ZONE_FILL_TRANSP))

        if stopEnableInput
            stopLineId  := line.new(bar_index, riskStopLevel, bar_index, riskStopLevel, color = bearColorInput, style = line.style_dotted)
            stopLabelId := label.new(bar_index, riskStopLevel, 'Stop ' + str.tostring(riskStopLevel, format.mintick), style = label.style_label_left, color = TRANSPARENT_COLOR, textcolor = bearColorInput, size = size.small)

        // Release references so the confirmed pattern's drawings persist as history
        wLine1Id        := na
        wLine2Id        := na
        wLine3Id        := na
        buyLineId       := na
        buyLabelId      := na
        titleLabelId    := na
        undercutLabelId := na
        reclaimLabelId  := na
        handleLabelId   := na
        shakeoutBoxId   := na
    else if invalidatedEvent
        patternActive := false

        wLine1Id        := cleanupLine(wLine1Id, showInvalidatedInput)
        wLine2Id        := cleanupLine(wLine2Id, showInvalidatedInput)
        wLine3Id        := cleanupLine(wLine3Id, showInvalidatedInput)
        buyLineId       := cleanupLine(buyLineId, showInvalidatedInput)
        buyLabelId      := cleanupLabel(buyLabelId, showInvalidatedInput)
        titleLabelId    := cleanupLabel(titleLabelId, showInvalidatedInput)
        undercutLabelId := cleanupLabel(undercutLabelId, showInvalidatedInput)
        reclaimLabelId  := cleanupLabel(reclaimLabelId, showInvalidatedInput)
        handleLabelId   := cleanupLabel(handleLabelId, showInvalidatedInput)
        shakeoutBoxId   := cleanupBox(shakeoutBoxId, showInvalidatedInput)

        if showInvalidatedInput
            label.new(bar_index, high, 'Invalidated', style = label.style_label_down, color = bearColorInput, textcolor = chart.bg_color, size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
// Pattern Detection
//---------------------------------------------------------------------------------------------------------------------{

if lowSwingEvent and array.size(swingPriceArray) >= 4
    int n = array.size(swingPriceArray)

    // The window must alternate high, low, high, low (guaranteed by construction, checked for safety)
    bool typesOk = array.get(swingIsHighArray, n - 4) and not array.get(swingIsHighArray, n - 3) and array.get(swingIsHighArray, n - 2) and not array.get(swingIsHighArray, n - 1)

    if typesOk
        float wHigh = array.get(swingPriceArray, n - 4)
        float wLow1 = array.get(swingPriceArray, n - 3)
        float wPeak = array.get(swingPriceArray, n - 2)
        float wLow2 = array.get(swingPriceArray, n - 1)

        int wHighBar = array.get(swingBarArray, n - 4)
        int wLow1Bar = array.get(swingBarArray, n - 3)
        int wPeakBar = array.get(swingBarArray, n - 2)
        int wLow2Bar = array.get(swingBarArray, n - 1)

        float undercutPct = wLow1 > 0 ? 100 * (wLow1 - wLow2) / wLow1 : na
        float depthPct    = wHigh > 0 ? 100 * (wHigh - wLow2) / wHigh : na
        float midPosPct   = wHigh - wLow2 > 0 ? 100 * (wPeak - wLow2) / (wHigh - wLow2) : na

        // The defining twist: the second low must undercut the first, even slightly, without collapsing far beneath it
        bool undercutOk = wLow2 < wLow1 and not na(undercutPct) and undercutPct <= maxUndercutInput

        // Depth in the range of intermediate corrections, mid-peak in the upper portion, below the left-side high
        bool depthOk = not na(depthPct) and depthPct >= minDepthInput and depthPct <= effMaxDepth
        bool shapeOk = wPeak < wHigh and not na(midPosPct) and midPosPct >= midPeakPosInput
        bool spanOk  = wLow2Bar - wHighBar <= effMaxLength

        // Prior uptrend worth basing after, measured into the left-side high
        bool uptrendOk = array.get(swingUptrendArray, n - 4)

        if undercutOk and depthOk and shapeOk and spanOk and uptrendOk
            // A newer valid structure replaces an unresolved active one
            if patternActive
                wLine1Id        := cleanupLine(wLine1Id, showInvalidatedInput)
                wLine2Id        := cleanupLine(wLine2Id, showInvalidatedInput)
                wLine3Id        := cleanupLine(wLine3Id, showInvalidatedInput)
                buyLineId       := cleanupLine(buyLineId, showInvalidatedInput)
                buyLabelId      := cleanupLabel(buyLabelId, showInvalidatedInput)
                titleLabelId    := cleanupLabel(titleLabelId, showInvalidatedInput)
                undercutLabelId := cleanupLabel(undercutLabelId, showInvalidatedInput)
                reclaimLabelId  := cleanupLabel(reclaimLabelId, showInvalidatedInput)
                handleLabelId   := cleanupLabel(handleLabelId, showInvalidatedInput)
                shakeoutBoxId   := cleanupBox(shakeoutBoxId, showInvalidatedInput)

            detectedEvent  := true
            patternActive  := true
            baseHighPrice  := wHigh
            baseHighBar    := wHighBar
            firstLowPrice  := wLow1
            firstLowBar    := wLow1Bar
            midPeakPrice   := wPeak
            midPeakBar     := wPeakBar
            secondLowPrice := wLow2
            secondLowBar   := wLow2Bar

            buyLevel      := wPeak * (1 + pivotMarginInput / 100)
            handleActive  := false
            handlePrice   := na
            handleBar     := na
            reclaimed     := false
            wasAbovePivot := close > buyLevel

            // Volume character: heavy selling into the lows graded against the average, right side accumulated live
            float legVolume   = array.get(swingCumVolArray, n - 3) - array.get(swingCumVolArray, n - 4) + array.get(swingCumVolArray, n - 1) - array.get(swingCumVolArray, n - 2)
            int   legBarCount = wLow1Bar - wHighBar + wLow2Bar - wPeakBar
            float refVolAvg   = array.get(swingVolAvgArray, n - 1)

            lowsVolRatio    := legBarCount > 0 and not na(refVolAvg) and refVolAvg > 0 ? legVolume / legBarCount / refVolAvg : na
            rightUpBaseline := array.get(swingCumUpArray, n - 1)
            rightDnBaseline := array.get(swingCumDnArray, n - 1)

            float rightUpVol = cumUpVolume - rightUpBaseline
            float rightDnVol = cumDnVolume - rightDnBaseline
            rightSideRatio  := rightDnVol > 0 ? rightUpVol / rightDnVol : na

            if showStructureInput
                wLine1Id        := line.new(wHighBar, wHigh, wLow1Bar, wLow1, color = neutralColorInput)
                wLine2Id        := line.new(wLow1Bar, wLow1, wPeakBar, wPeak, color = neutralColorInput)
                wLine3Id        := line.new(wPeakBar, wPeak, wLow2Bar, wLow2, color = neutralColorInput)
                titleLabelId    := label.new(wPeakBar, wPeak, 'Double-Bottom Base', style = label.style_label_down, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.small)
                undercutLabelId := label.new(wLow2Bar, wLow2, 'Undercut -' + str.tostring(undercutPct, '#.##') + '%', style = label.style_label_up, color = TRANSPARENT_COLOR, textcolor = bearColorInput, size = size.tiny)

            if showShakeoutInput
                shakeoutBoxId := box.new(wLow1Bar, wLow1, bar_index, wLow2, border_color = color.new(bearColorInput, SHAKEOUT_BORDER_TRANSP), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(bearColorInput, SHAKEOUT_FILL_TRANSP))

            if showLevelsInput
                buyLineId  := line.new(wPeakBar, buyLevel, bar_index, buyLevel, color = neutralColorInput, style = line.style_dashed)
                buyLabelId := label.new(bar_index, buyLevel, 'Buy ' + str.tostring(buyLevel, format.mintick), style = label.style_label_left, color = TRANSPARENT_COLOR, textcolor = neutralColorInput, size = size.small)

            // The undercut may already be reclaimed by the time the second low confirms
            if close > firstLowPrice
                reclaimed      := true
                reclaimEvent   := true
                reclaimLabelId := label.new(bar_index, low, 'Reclaim', style = label.style_label_up, color = TRANSPARENT_COLOR, textcolor = bullColorInput, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// Breakout Risk Management
//---------------------------------------------------------------------------------------------------------------------{

if riskActive
    if not na(zoneBoxId)
        box.set_right(zoneBoxId, bar_index)

    if not na(stopLineId)
        line.set_x2(stopLineId, bar_index)
        label.set_x(stopLabelId, bar_index)

    if bar_index > riskStartBar
        bool stopBroken      = stopEnableInput and close < riskStopLevel
        bool structureBroken = close < riskUndercut
        bool resolvedUp      = close > riskPriorHigh
        bool watchOver       = bar_index - riskStartBar > monitorLengthInput

        if stopBroken or structureBroken
            stopHitEvent := true
            riskActive   := false
            label.new(bar_index, high, 'Stop Hit', style = label.style_label_down, color = bearColorInput, textcolor = chart.bg_color, size = size.small)
        else if resolvedUp or watchOver
            riskActive := false

        if not riskActive
            zoneBoxId   := na
            stopLineId  := na
            stopLabelId := na

//---------------------------------------------------------------------------------------------------------------------}
// Dashboard
//---------------------------------------------------------------------------------------------------------------------{

var table dashTable = table.new(getTablePosition(dashLocationInput), 2, 9, bgcolor = color.new(chart.bg_color, 30), frame_color = color.new(chart.fg_color, 85), frame_width = 1)

if showDashInput and barstate.islast
    string dashSize = getTableSize(dashSizeInput)

    bool  baseLive  = patternActive or riskActive
    float shownBuy  = patternActive ? buyLevel : riskBuyLevel
    color fadedText = color.new(chart.fg_color, 40)

    string statusText  = patternActive ? (handleActive ? 'Handle set' : 'W pending') : riskActive ? 'Breakout watch' : 'Scanning'
    color  statusColor = patternActive ? neutralColorInput : riskActive ? bullColorInput : fadedText

    float depthPct    = baseLive and baseHighPrice > 0 ? 100 * (baseHighPrice - secondLowPrice) / baseHighPrice : na
    float undercutPct = baseLive and firstLowPrice > 0 ? 100 * (firstLowPrice - secondLowPrice) / firstLowPrice : na
    float midPosPct   = baseLive and baseHighPrice - secondLowPrice > 0 ? 100 * (midPeakPrice - secondLowPrice) / (baseHighPrice - secondLowPrice) : na

    string buyText      = baseLive and not na(shownBuy) ? str.tostring(shownBuy, format.mintick) : '-'
    string depthText    = not na(depthPct) ? '-' + str.tostring(depthPct, '#.##') + '%' : '-'
    string undercutText = not na(undercutPct) ? '-' + str.tostring(undercutPct, '#.##') + '%' : '-'
    string midPosText   = not na(midPosPct) ? str.tostring(midPosPct, '#.#') + '%' : '-'
    string ageText      = baseLive ? str.tostring(bar_index - baseHighBar) + ' bars' : '-'
    string lowsVolText  = baseLive and not na(lowsVolRatio) ? str.tostring(lowsVolRatio, '#.##') + 'x avg' : '-'
    string rightText    = baseLive and not na(rightSideRatio) ? str.tostring(rightSideRatio, '#.##') + (rightSideRatio >= 1 ? ' supportive' : ' weak') : '-'
    color  rightColor   = baseLive and not na(rightSideRatio) ? (rightSideRatio >= 1 ? bullColorInput : bearColorInput) : fadedText

    table.cell(dashTable, 0, 0, 'Double-Bottom Base', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 0, '', text_size = dashSize)
    table.cell(dashTable, 0, 1, 'Status', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 1, statusText, text_color = statusColor, text_size = dashSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 2, 'Buy point', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 2, buyText, text_color = baseLive ? chart.fg_color : fadedText, text_size = dashSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 3, 'Base depth', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 3, depthText, text_color = baseLive ? chart.fg_color : fadedText, text_size = dashSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 4, 'Undercut', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 4, undercutText, text_color = baseLive ? bearColorInput : fadedText, text_size = dashSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 5, 'Mid-peak position', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 5, midPosText, text_color = baseLive ? chart.fg_color : fadedText, text_size = dashSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 6, 'Base age', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 6, ageText, text_color = baseLive ? chart.fg_color : fadedText, text_size = dashSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 7, 'Lows-leg volume', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 7, lowsVolText, text_color = baseLive ? chart.fg_color : fadedText, text_size = dashSize, text_halign = text.align_right)
    table.cell(dashTable, 0, 8, 'Right-side U/D volume', text_color = chart.fg_color, text_size = dashSize, text_halign = text.align_left)
    table.cell(dashTable, 1, 8, rightText, text_color = rightColor, text_size = dashSize, text_halign = text.align_right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(detectedEvent, 'Double-Bottom W Detected', 'A W-shaped double-bottom base completed: the second low undercut the first and the structure passed depth, mid-peak and prior-uptrend checks. Buy point set above the middle peak.')
alertcondition(reclaimEvent, 'Undercut Reclaimed', 'Price closed back above the first low after the undercut shakeout - the early tell that the double-bottom base is working.')
alertcondition(handleFormedEvent, 'Handle Formed', 'A handle formed on the right side of the double-bottom base; the buy point shifted to the handle high plus the pivot margin.')
alertcondition(breakoutEvent, 'Breakout Confirmed', 'Price closed above the double-bottom base buy point on qualifying volume - valid pivot breakout within the buy zone.')
alertcondition(weakVolumeEvent, 'Pivot Cleared Without Volume', 'Price closed above the double-bottom base buy point but volume did not expand above the required multiple of average; the breakout is unconfirmed.')
alertcondition(invalidatedEvent, 'Base Invalidated', 'The double-bottom base was invalidated: undercut low broken, a third trip to the lows, a premature or volume-less resolution, or the structure timed out.')
alertcondition(stopHitEvent, 'Stop Hit', 'Price closed below the protective level after the double-bottom breakout - the fixed percentage stop under the buy point or the undercut low that invalidates the whole base.')

//---------------------------------------------------------------------------------------------------------------------}
