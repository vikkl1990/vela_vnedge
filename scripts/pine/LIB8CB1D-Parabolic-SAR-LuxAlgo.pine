//@version=6
indicator("Parabolic SAR", "SAR", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
startInput     = input.float(0.02, "Start", minval = 0, step = 0.01, group = "Settings", tooltip = "Initial acceleration factor applied when a new trend begins.")
incrementInput = input.float(0.02, "Increment", minval = 0, step = 0.01, group = "Settings", tooltip = "Amount added to the acceleration factor each time the trend makes a new extreme point.")
maxInput       = input.float(0.2, "Maximum", minval = 0.01, step = 0.01, group = "Settings", tooltip = "Upper cap on the acceleration factor.")

bullColorInput = input.color(#089981, "Bullish", inline = "sar", group = "Style", tooltip = "Color of the SAR crosses while they trail below price - uptrend, the stop sits under the market.")
bearColorInput = input.color(#f23645, "Bearish", inline = "sar", group = "Style", tooltip = "Color of the SAR crosses while they sit above price - downtrend, the stop sits over the market.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
sarValue = ta.sar(startInput, incrementInput, maxInput)

bullishFlip = ta.crossunder(sarValue, close)
bearishFlip = ta.crossover(sarValue, close)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
sarColor = sarValue < close ? bullColorInput : bearColorInput

plot(sarValue, "SAR", sarColor, 1, plot.style_cross)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(bullishFlip, "Bullish SAR Flip", "Parabolic SAR flipped below price (uptrend start)")
alertcondition(bearishFlip, "Bearish SAR Flip", "Parabolic SAR flipped above price (downtrend start)")
//----------------------------------------------------------------------------------------------------------------------}
