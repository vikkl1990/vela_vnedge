//@version=6
indicator("Moving Average", "MA", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
// KAMA smoothing constants: alphas of the classic 2 period fast and 30 period slow EMAs
KAMA_FAST_ALPHA = 2.0 / 3.0
KAMA_SLOW_ALPHA = 2.0 / 31.0

// Hamming window coefficients
HAMMING_A0 = 0.54
HAMMING_A1 = 0.46
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
ma1TypeInput   = input.string('SMA', 'MA 1 Type', options = ['SMA', 'EMA', 'WMA', 'RMA (SMMA)', 'HMA', 'ALMA', 'VWMA', 'DEMA', 'TEMA', 'KAMA', 'LSMA', 'McGinley', 'Hamming'], group = 'Settings', tooltip = 'Moving average calculation used for MA 1.')
ma1LengthInput = input.int(20, 'MA 1 Length', minval = 1, group = 'Settings', tooltip = 'Number of bars used in the MA 1 calculation.')
ma1SourceInput = input.source(close, 'MA 1 Source', group = 'Settings', tooltip = 'Price series MA 1 is calculated on.')

showMa2Input   = input.bool(false, 'Show MA 2', group = 'Settings', tooltip = 'Displays the optional second moving average.')
ma2TypeInput   = input.string('SMA', 'MA 2 Type', options = ['SMA', 'EMA', 'WMA', 'RMA (SMMA)', 'HMA', 'ALMA', 'VWMA', 'DEMA', 'TEMA', 'KAMA', 'LSMA', 'McGinley', 'Hamming'], group = 'Settings', tooltip = 'Moving average calculation used for MA 2.')
ma2LengthInput = input.int(50, 'MA 2 Length', minval = 1, group = 'Settings', tooltip = 'Number of bars used in the MA 2 calculation.')
ma2SourceInput = input.source(close, 'MA 2 Source', group = 'Settings', tooltip = 'Price series MA 2 is calculated on.')

almaOffsetInput = input.float(0.85, 'ALMA Offset', minval = 0, maxval = 1, step = 0.05, group = 'Settings', tooltip = 'ALMA type only. Values near 1 make the average more responsive, values near 0 make it smoother.')
almaSigmaInput  = input.float(6, 'ALMA Sigma', minval = 0.1, step = 0.5, group = 'Settings', tooltip = 'ALMA type only. Larger values widen the Gaussian window for a smoother average.')
lsmaOffsetInput = input.int(0, 'LSMA Offset', group = 'Settings', tooltip = 'LSMA type only. Bar offset applied to the linear regression value.')

ma1ColorInput = input.color(#5b9cf6, 'MA 1', group = 'Style', tooltip = 'MA 1 line color.')
ma2ColorInput = input.color(#ff9800, 'MA 2', group = 'Style', tooltip = 'MA 2 line color.')
//----------------------------------------------------------------------------------------------------------------------}
// Functions
//----------------------------------------------------------------------------------------------------------------------{
// Computes every supported moving average unconditionally, then selects one, keeping ta.* call counts consistent
maValue(series float src, simple int len, simple string typeStr, simple float almaOffset, simple float almaSigma, simple int lsmaOffset) =>
    smaValue  = ta.sma(src, len)
    emaValue  = ta.ema(src, len)
    ema2Value = ta.ema(emaValue, len)
    ema3Value = ta.ema(ema2Value, len)
    wmaValue  = ta.wma(src, len)
    rmaValue  = ta.rma(src, len)
    hmaValue  = ta.hma(src, math.max(2, len))
    almaValue = ta.alma(src, len, almaOffset, almaSigma)
    vwmaValue = ta.vwma(src, len)
    lsmaValue = ta.linreg(src, len, lsmaOffset)
    demaValue = 2 * emaValue - ema2Value
    temaValue = 3 * emaValue - 3 * ema2Value + ema3Value
    erNum = math.abs(ta.change(src, len))
    erDen = math.sum(math.abs(ta.change(src)), len)
    er    = erDen == 0 ? 0.0 : erNum / erDen
    sc    = math.pow(er * (KAMA_FAST_ALPHA - KAMA_SLOW_ALPHA) + KAMA_SLOW_ALPHA, 2)
    var float kamaValue = na
    kamaPrev   = nz(kamaValue[1], src)
    kamaValue := kamaPrev + sc * (src - kamaPrev)
    var float mcginleyValue = na
    mgPrev  = mcginleyValue[1]
    mgDenom = len * math.pow(src / nz(mgPrev, src), 4)
    mgStep  = mgDenom == 0 or na(mgDenom) ? 0.0 : (src - mgPrev) / mgDenom
    mcginleyValue := na(mgPrev) ? emaValue : mgPrev + mgStep
    float hammingValue = na
    if len == 1
        hammingValue := src
    else
        float weightedSum = 0.0
        float weightSum   = 0.0
        for i = 0 to len - 1
            hammingWeight = HAMMING_A0 - HAMMING_A1 * math.cos(2.0 * math.pi * i / (len - 1))
            weightedSum += hammingWeight * src[i]
            weightSum   += hammingWeight
        hammingValue := weightedSum / weightSum
    switch typeStr
        'SMA'        => smaValue
        'EMA'        => emaValue
        'WMA'        => wmaValue
        'RMA (SMMA)' => rmaValue
        'HMA'        => hmaValue
        'ALMA'       => almaValue
        'VWMA'       => vwmaValue
        'DEMA'       => demaValue
        'TEMA'       => temaValue
        'KAMA'       => kamaValue
        'LSMA'       => lsmaValue
        'McGinley'   => mcginleyValue
        'Hamming'    => hammingValue
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
ma1 = maValue(ma1SourceInput, ma1LengthInput, ma1TypeInput, almaOffsetInput, almaSigmaInput, lsmaOffsetInput)
ma2 = maValue(ma2SourceInput, ma2LengthInput, ma2TypeInput, almaOffsetInput, almaSigmaInput, lsmaOffsetInput)

priceCrossUp   = ta.crossover(ma1SourceInput, ma1)
priceCrossDown = ta.crossunder(ma1SourceInput, ma1)
maCrossUp      = ta.crossover(ma1, ma2)
maCrossDown    = ta.crossunder(ma1, ma2)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
plot(ma1, 'MA 1', ma1ColorInput)
plot(showMa2Input ? ma2 : na, 'MA 2', ma2ColorInput)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
alertcondition(priceCrossUp,   'Price Cross Above MA 1', 'Price crossed above MA 1')
alertcondition(priceCrossDown, 'Price Cross Below MA 1', 'Price crossed below MA 1')
alertcondition(maCrossUp,      'MA 1 Cross Above MA 2',  'MA 1 crossed above MA 2')
alertcondition(maCrossDown,    'MA 1 Cross Below MA 2',  'MA 1 crossed below MA 2')
//----------------------------------------------------------------------------------------------------------------------}
