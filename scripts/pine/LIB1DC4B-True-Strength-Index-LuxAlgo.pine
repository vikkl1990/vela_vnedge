//@version=6
indicator("True Strength Index", "TSI", overlay = false, precision = 2)
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
longInput   = input.int(25, "Long Length",   minval = 1, group = "Settings", tooltip = "Length of the first (long) EMA applied to the 1-bar price change.")
shortInput  = input.int(13, "Short Length",  minval = 1, group = "Settings", tooltip = "Length of the second (short) EMA applied to the long-smoothed price change.")
signalInput = input.int(13, "Signal Length", minval = 1, group = "Settings", tooltip = "Length of the EMA of TSI used as the signal line.")

tsiColorInput    = input.color(#787b86, "TSI",    group = "Style", tooltip = "Color of the TSI line.")
signalColorInput = input.color(#ff9800, "Signal", group = "Style", tooltip = "Color of the signal line.")
bullColorInput   = input.color(#089981, "Bullish", inline = "state", group = "Style", tooltip = "Color of the TSI line and its gradient fill while TSI holds above zero.")
bearColorInput   = input.color(#f23645, "Bearish", inline = "state", group = "Style", tooltip = "Color of the TSI line and its gradient fill while TSI holds below zero.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
tsi        = 100 * ta.tsi(close, shortInput, longInput)
signalLine = ta.ema(tsi, signalInput)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
// State coloring - bullish above zero, bearish below, the neutral color exactly on zero
tsiColor = tsi > 0 ? bullColorInput : tsi < 0 ? bearColorInput : tsiColorInput

tsiPlotId  = plot(tsi,        "TSI",    tsiColor)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)
plot(signalLine, "Signal", signalColorInput)

// Centered gradient - fully transparent at zero, stronger toward the reading
fill(tsiPlotId, zeroPlotId, math.max(tsi, 0), math.min(tsi, 0), tsi > 0 ? color.new(tsiColor, 50) : color.new(tsiColor, 100), tsi > 0 ? color.new(tsiColor, 100) : color.new(tsiColor, 50), title = "TSI Gradient")

hline(0, "Zero Line", #787b86, hline.style_dashed)
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
signalCrossUp   = ta.crossover(tsi, signalLine)
signalCrossDown = ta.crossunder(tsi, signalLine)
zeroCrossUp     = ta.crossover(tsi, 0)
zeroCrossDown   = ta.crossunder(tsi, 0)

alertcondition(signalCrossUp,   "Signal Line Cross Up",   "TSI crossed above its signal line")
alertcondition(signalCrossDown, "Signal Line Cross Down", "TSI crossed below its signal line")
alertcondition(zeroCrossUp,     "Zero Line Cross Up",     "TSI crossed above the zero line")
alertcondition(zeroCrossDown,   "Zero Line Cross Down",   "TSI crossed below the zero line")
//----------------------------------------------------------------------------------------------------------------------}
