//@version=6
indicator("Donchian Channels", "DC", overlay = true, format = format.price)
//----------------------------------------------------------------------------------------------------------------------}
// Constants
//----------------------------------------------------------------------------------------------------------------------{
BULL_COLOR    = #089981 // lower channel - the support side of the range
BEAR_COLOR    = #f23645 // upper channel - the resistance side of the range
NEUTRAL_COLOR = #787b86 // midline and the channel interior

FILL_TRANSP = 92
//----------------------------------------------------------------------------------------------------------------------}
// Settings
//----------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(20, "Length", minval = 1, group = "Settings", tooltip = "Lookback length. The upper and lower channels are the highest high and lowest low over this many bars.")

upperColorInput  = input.color(BEAR_COLOR, "Upper", group = "Style", tooltip = "Color of the upper channel line.")
middleColorInput = input.color(NEUTRAL_COLOR, "Middle", group = "Style", tooltip = "Color of the channel midline.")
lowerColorInput  = input.color(BULL_COLOR, "Lower", group = "Style", tooltip = "Color of the lower channel line.")
fillColorInput   = input.color(color.new(NEUTRAL_COLOR, FILL_TRANSP), "Fill", group = "Style", tooltip = "Color of the channel interior fill.")
//----------------------------------------------------------------------------------------------------------------------}
// Calculations
//----------------------------------------------------------------------------------------------------------------------{
upper  = ta.highest(high, lengthInput)
lower  = ta.lowest(low, lengthInput)
middle = math.avg(upper, lower)
//----------------------------------------------------------------------------------------------------------------------}
// Plots
//----------------------------------------------------------------------------------------------------------------------{
upperPlotId = plot(upper, "Upper", upperColorInput)
plot(middle, "Middle", middleColorInput, style = plot.style_circles)
lowerPlotId = plot(lower, "Lower", lowerColorInput)

fill(upperPlotId, lowerPlotId, fillColorInput, title = "Channel Fill")
//----------------------------------------------------------------------------------------------------------------------}
// Alerts
//----------------------------------------------------------------------------------------------------------------------{
// Breakouts are evaluated against the previous bar channel, the current bar extremes are inside the channel by construction
breakoutUp   = ta.crossover(close, upper[1])
breakoutDown = ta.crossunder(close, lower[1])

alertcondition(breakoutUp, "Breakout Up", "Close crossed above the upper Donchian channel")
alertcondition(breakoutDown, "Breakout Down", "Close crossed below the lower Donchian channel")
//----------------------------------------------------------------------------------------------------------------------}
