// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © StrixEDGE

//@version=6
indicator("Liquidity Absorption Engine [StrixEDGE]", shorttitle="Liquidity Absorption Engine [StrixEDGE]", overlay=true, max_labels_count=300)

// Generated by StrixEDGE Indicator Lab
// Engine #01: Liquidity Absorption Engine
// Combination profile: CORE BALANCE
// Core engine formula + optional 28% user DNA modifier.
// No future-bar references. Confirmed HTF requests use a one-bar offset.

int len = input.int(24, "Core lookback", minval=5, maxval=200, group="StrixEDGE Engine")
int atrLen = input.int(14, "ATR lookback", minval=3, maxval=100, group="StrixEDGE Engine")
int smoothLen = input.int(5, "Flow smoothing", minval=1, maxval=50, group="StrixEDGE Engine")
float signalThreshold = input.float(72.0, "Signal threshold", minval=51.0, maxval=95.0, group="StrixEDGE Engine")
bool requireClose = input.bool(true, "Require confirmed bar close", group="StrixEDGE Engine")

clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

// ---- Shared market primitives ----
float eps = math.max(syminfo.mintick, 0.0000001)
float atr = ta.atr(atrLen)
float avgAtr = ta.sma(atr, len)
float atrRatio = atr / math.max(avgAtr, eps)
float cleanVol = nz(volume, 0.0)
float avgVol = ta.sma(cleanVol, len)
float rvol = avgVol > eps ? cleanVol / avgVol : 1.0
float barRange = math.max(high - low, eps)
float body = close - open
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float priorHigh = ta.highest(high[1], len)
float priorLow = ta.lowest(low[1], len)
float rollHigh = ta.highest(high, len)
float rollLow = ta.lowest(low, len)
float structurePos = (close - rollLow) / math.max(rollHigh - rollLow, eps)
float travel = ta.sma(math.abs(close - close[1]), len) * len
float trendEfficiency = clamp((close - close[len]) / math.max(travel, eps), -1.0, 1.0)
float rawFlowDiag = ((close - close[1]) / math.max(atr, eps)) * math.min(rvol, 3.0)
float flowDiag = clamp(ta.ema(rawFlowDiag, smoothLen), -1.0, 1.0)
float sessionVwapDiag = ta.vwap(hlc3)
float vwapDiag = clamp((close - sessionVwapDiag) / math.max(atr * 2.0, eps), -1.0, 1.0)

// Wick Absorption Pressure
float wickBalance = (lowerWick - upperWick) / barRange
float mAbsorption = clamp(wickBalance * math.min(rvol, 2.5) / 1.4, -1.0, 1.0)

// Liquidity Sweep Rejection
bool bullSweep = low < priorLow and close > priorLow
bool bearSweep = high > priorHigh and close < priorHigh
float mSweep = bullSweep ? 1.0 : bearSweep ? -1.0 : 0.0

// Normalized Flow Acceleration
float mFlow = flowDiag

// ---- Engine core: #01 Liquidity Absorption Engine ----
float engineCore = clamp(mAbsorption * 0.45 + mSweep * 0.30 + mFlow * 0.25, -1.0, 1.0)

// ---- Optional custom DNA modifier ----
float dnaWeighted = mAbsorption * 22.0 + mSweep * 20.0 + mFlow * 18.0
float dnaComposite = dnaWeighted / 60.0
float composite = clamp(engineCore * 0.72 + dnaComposite * 0.28, -1.0, 1.0)
float rawScore = 50.0 + 50.0 * composite
float score = ta.ema(rawScore, smoothLen)

bool stable = not requireClose or barstate.isconfirmed
bool rawLongSignal = stable and score >= signalThreshold and score[1] < signalThreshold
bool rawShortSignal = stable and score <= (100.0 - signalThreshold) and score[1] > (100.0 - signalThreshold)

// ---- Shared StrixEDGE trade-plan engine (applies to every one of the 50 engines) ----
// Only one setup can be active at a time. A fresh engine signal can open a new plan only
// after the prior plan is finished by TP3 or SL. This keeps TP/DCA/SL lifecycle consistent.
// ---- Trade plan state ----
bool showTradePlan = input.bool(true, "Show trade plan", group="StrixEDGE Trade Plan")
int projectionBars = input.int(35, "Projection bars", minval=5, maxval=300, group="StrixEDGE Trade Plan")
float dcaAtrMult = input.float(0.75, "DCA ATR multiplier", minval=0.10, maxval=10.0, step=0.05, group="StrixEDGE Trade Plan")
float slAtrMult = input.float(1.50, "SL ATR multiplier", minval=0.10, maxval=10.0, step=0.05, group="StrixEDGE Trade Plan")
float tp1AtrMult = input.float(1.00, "TP1 ATR multiplier", minval=0.10, maxval=10.0, step=0.05, group="StrixEDGE Trade Plan")
float tp2AtrMult = input.float(2.00, "TP2 ATR multiplier", minval=0.10, maxval=10.0, step=0.05, group="StrixEDGE Trade Plan")
float tp3AtrMult = input.float(3.00, "TP3 ATR multiplier", minval=0.10, maxval=10.0, step=0.05, group="StrixEDGE Trade Plan")

var int activeSide = 0
var int activeBar = na
var float planEntry = na
var float planDca = na
var float planSl = na
var float planTp1 = na
var float planTp2 = na
var float planTp3 = na
var bool hitDca = false
var bool hitTp1 = false
var bool hitTp2 = false
var bool hitTp3 = false
var bool hitSl = false
var bool setupClosed = false
var int setupOutcome = 0 // 0=open, 1=TP3 complete, -1=SL

bool canOpenSetup = activeSide == 0 or setupClosed
bool longSignal = rawLongSignal and canOpenSetup
bool shortSignal = rawShortSignal and canOpenSetup

if longSignal
    activeSide := 1
    activeBar := bar_index
    planEntry := close
    planDca := close - atr * dcaAtrMult
    planSl := close - atr * slAtrMult
    planTp1 := close + atr * tp1AtrMult
    planTp2 := close + atr * tp2AtrMult
    planTp3 := close + atr * tp3AtrMult
    hitDca := false
    hitTp1 := false
    hitTp2 := false
    hitTp3 := false
    hitSl := false
    setupClosed := false
    setupOutcome := 0

if shortSignal
    activeSide := -1
    activeBar := bar_index
    planEntry := close
    planDca := close + atr * dcaAtrMult
    planSl := close + atr * slAtrMult
    planTp1 := close - atr * tp1AtrMult
    planTp2 := close - atr * tp2AtrMult
    planTp3 := close - atr * tp3AtrMult
    hitDca := false
    hitTp1 := false
    hitTp2 := false
    hitTp3 := false
    hitSl := false
    setupClosed := false
    setupOutcome := 0

bool setupCanUpdate = activeSide != 0 and not setupClosed and not na(activeBar) and bar_index > activeBar
bool rawDcaTouch = setupCanUpdate and not na(planDca) and ((activeSide == 1 and low <= planDca) or (activeSide == -1 and high >= planDca))
bool rawTp1Touch = setupCanUpdate and not na(planTp1) and ((activeSide == 1 and high >= planTp1) or (activeSide == -1 and low <= planTp1))
bool rawTp2Touch = setupCanUpdate and not na(planTp2) and ((activeSide == 1 and high >= planTp2) or (activeSide == -1 and low <= planTp2))
bool rawTp3Touch = setupCanUpdate and not na(planTp3) and ((activeSide == 1 and high >= planTp3) or (activeSide == -1 and low <= planTp3))
bool rawSlTouch = setupCanUpdate and not na(planSl) and ((activeSide == 1 and low <= planSl) or (activeSide == -1 and high >= planSl))

// Terminal outcomes are mutually exclusive. If TP and SL are both inside the same candle,
// StrixEDGE uses conservative sequencing: SL wins because OHLC data cannot prove intrabar order.
bool slHitNow = rawSlTouch
bool tp3HitNow = not rawSlTouch and rawTp3Touch
bool tp2HitNow = not rawSlTouch and not rawTp3Touch and rawTp2Touch and not hitTp2
bool tp1HitNow = not rawSlTouch and not rawTp3Touch and not rawTp2Touch and rawTp1Touch and not hitTp1
bool dcaHitNow = not rawSlTouch and not rawTp3Touch and rawDcaTouch and not hitDca

if slHitNow
    hitSl := true
    // Preserve targets that were genuinely reached on earlier bars.
    // If TP and SL are first touched on the same candle, SL still has priority,
    // so no new TP hit is registered on that candle.
    hitDca := hitDca or rawDcaTouch or (activeSide == 1 ? planSl < planDca : planSl > planDca)
    setupClosed := true
    setupOutcome := -1
else if tp3HitNow
    hitTp1 := true
    hitTp2 := true
    hitTp3 := true
    hitSl := false
    setupClosed := true
    setupOutcome := 1
else
    if tp2HitNow
        hitTp1 := true
        hitTp2 := true
    else if tp1HitNow
        hitTp1 := true
    if dcaHitNow
        hitDca := true

float riskDistance = not na(planEntry) and not na(planSl) ? math.abs(planEntry - planSl) : na
float rrTp1 = not na(riskDistance) and riskDistance > eps ? math.abs(planTp1 - planEntry) / riskDistance : na
float rrTp2 = not na(riskDistance) and riskDistance > eps ? math.abs(planTp2 - planEntry) / riskDistance : na
float rrTp3 = not na(riskDistance) and riskDistance > eps ? math.abs(planTp3 - planEntry) / riskDistance : na
int signalAge = activeSide != 0 and not na(activeBar) ? bar_index - activeBar : na
float dcaPct = not na(planEntry) and planEntry != 0 and activeSide != 0 ? ((planDca - planEntry) / planEntry) * 100.0 * activeSide : na
float tp1Pct = not na(planEntry) and planEntry != 0 and activeSide != 0 ? ((planTp1 - planEntry) / planEntry) * 100.0 * activeSide : na
float tp2Pct = not na(planEntry) and planEntry != 0 and activeSide != 0 ? ((planTp2 - planEntry) / planEntry) * 100.0 * activeSide : na
float tp3Pct = not na(planEntry) and planEntry != 0 and activeSide != 0 ? ((planTp3 - planEntry) / planEntry) * 100.0 * activeSide : na
float slPct = not na(planEntry) and planEntry != 0 and activeSide != 0 ? ((planSl - planEntry) / planEntry) * 100.0 * activeSide : na
string dcaPctText = na(dcaPct) ? "—" : (dcaPct > 0 ? "+" : "") + str.tostring(dcaPct, "#.##") + "%"
string tp1PctText = na(tp1Pct) ? "—" : (tp1Pct > 0 ? "+" : "") + str.tostring(tp1Pct, "#.##") + "%"
string tp2PctText = na(tp2Pct) ? "—" : (tp2Pct > 0 ? "+" : "") + str.tostring(tp2Pct, "#.##") + "%"
string tp3PctText = na(tp3Pct) ? "—" : (tp3Pct > 0 ? "+" : "") + str.tostring(tp3Pct, "#.##") + "%"
string slPctText = na(slPct) ? "—" : (slPct > 0 ? "+" : "") + str.tostring(slPct, "#.##") + "%"

// ---- Overlay visuals ----
// The main position label is drawn by sideLabel below, so no extra LONG/SHORT signal label is plotted here.
bgcolor(score >= signalThreshold ? color.new(color.green, 94) : score <= 100.0 - signalThreshold ? color.new(color.red, 94) : na)

color entryC = color.rgb(37, 99, 235)
color dcaC = color.rgb(124, 58, 237)
color tpC = color.rgb(22, 163, 74)
color stopC = color.rgb(220, 38, 38)

var line entryLine = na
var line dcaLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line slLine = na
var label entryLabel = na
var label dcaLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na
var label slLabel = na
var label sideLabel = na

if showTradePlan and (longSignal or shortSignal)
    if not na(entryLine)
        line.delete(entryLine)
    if not na(dcaLine)
        line.delete(dcaLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(tp3Line)
        line.delete(tp3Line)
    if not na(slLine)
        line.delete(slLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(dcaLabel)
        label.delete(dcaLabel)
    if not na(tp1Label)
        label.delete(tp1Label)
    if not na(tp2Label)
        label.delete(tp2Label)
    if not na(tp3Label)
        label.delete(tp3Label)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(sideLabel)
        label.delete(sideLabel)
    int rightBar = bar_index + projectionBars
    sideLabel := label.new(bar_index, longSignal ? low : high, longSignal ? "LONG POSITION" : "SHORT POSITION", xloc=xloc.bar_index, style=longSignal ? label.style_label_up : label.style_label_down, color=longSignal ? tpC : stopC, textcolor=color.white, size=size.small)
    entryLine := line.new(bar_index, planEntry, rightBar, planEntry, xloc=xloc.bar_index, extend=extend.none, color=entryC, width=2)
    dcaLine := line.new(bar_index, planDca, rightBar, planDca, xloc=xloc.bar_index, extend=extend.none, color=dcaC, width=2)
    tp1Line := line.new(bar_index, planTp1, rightBar, planTp1, xloc=xloc.bar_index, extend=extend.none, color=tpC, width=2)
    tp2Line := line.new(bar_index, planTp2, rightBar, planTp2, xloc=xloc.bar_index, extend=extend.none, color=tpC, width=2)
    tp3Line := line.new(bar_index, planTp3, rightBar, planTp3, xloc=xloc.bar_index, extend=extend.none, color=tpC, width=2)
    slLine := line.new(bar_index, planSl, rightBar, planSl, xloc=xloc.bar_index, extend=extend.none, color=stopC, width=2)
    entryLabel := label.new(rightBar, planEntry, "ENTRY  " + str.tostring(planEntry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=entryC, textcolor=color.white, size=size.small)
    dcaLabel := label.new(rightBar, planDca, "DCA  " + str.tostring(planDca, format.mintick) + "  (" + dcaPctText + ")", xloc=xloc.bar_index, style=label.style_label_left, color=dcaC, textcolor=color.white, size=size.small)
    tp1Label := label.new(rightBar, planTp1, "TP1  " + str.tostring(planTp1, format.mintick) + "  (" + tp1PctText + ")", xloc=xloc.bar_index, style=label.style_label_left, color=tpC, textcolor=color.white, size=size.small)
    tp2Label := label.new(rightBar, planTp2, "TP2  " + str.tostring(planTp2, format.mintick) + "  (" + tp2PctText + ")", xloc=xloc.bar_index, style=label.style_label_left, color=tpC, textcolor=color.white, size=size.small)
    tp3Label := label.new(rightBar, planTp3, "TP3  " + str.tostring(planTp3, format.mintick) + "  (" + tp3PctText + ")", xloc=xloc.bar_index, style=label.style_label_left, color=tpC, textcolor=color.white, size=size.small)
    slLabel := label.new(rightBar, planSl, "SL  " + str.tostring(planSl, format.mintick) + "  (" + slPctText + ")", xloc=xloc.bar_index, style=label.style_label_left, color=stopC, textcolor=color.white, size=size.small)

if showTradePlan and not na(dcaLabel)
    label.set_text(dcaLabel, (hitDca ? "✓ DCA  " : "DCA  ") + str.tostring(planDca, format.mintick) + "  (" + dcaPctText + ")")
if showTradePlan and not na(tp1Label)
    label.set_text(tp1Label, (hitTp1 ? "✓ TP1  " : "TP1  ") + str.tostring(planTp1, format.mintick) + "  (" + tp1PctText + ")")
if showTradePlan and not na(tp2Label)
    label.set_text(tp2Label, (hitTp2 ? "✓ TP2  " : "TP2  ") + str.tostring(planTp2, format.mintick) + "  (" + tp2PctText + ")")
if showTradePlan and not na(tp3Label)
    label.set_text(tp3Label, (hitTp3 ? "✓ TP3  " : "TP3  ") + str.tostring(planTp3, format.mintick) + "  (" + tp3PctText + ")")
if showTradePlan and not na(slLabel)
    label.set_text(slLabel, (hitSl ? "✓ SL  " : "SL  ") + str.tostring(planSl, format.mintick) + "  (" + slPctText + ")")

// Keep all projected levels visible for review after the setup closes.
// The mutually exclusive outcome logic above controls only the ✓ hit-state, not line visibility.

// ---- StrixEDGE Professional Indicator Table ----
bool showStrixTable = input.bool(true, "Show professional table", group="StrixEDGE Dashboard")
string tableSizeOpt = input.string("Small", "Table size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="StrixEDGE Dashboard")
string tableTextSize = tableSizeOpt == "Tiny" ? size.tiny : tableSizeOpt == "Small" ? size.small : tableSizeOpt == "Large" ? size.large : tableSizeOpt == "Huge" ? size.huge : size.normal
string biasText = score >= signalThreshold ? "BULLISH" : score <= (100.0 - signalThreshold) ? "BEARISH" : score > 55 ? "BULLISH LEAN" : score < 45 ? "BEARISH LEAN" : "NEUTRAL"
string signalText = longSignal ? "LONG TRIGGER" : shortSignal ? "SHORT TRIGGER" : stable ? "WAIT" : "LIVE"
string regimeText = math.abs(trendEfficiency) >= 0.55 ? "TREND" : atrRatio <= 0.80 ? "COMPRESSION" : atrRatio >= 1.35 ? "EXPANSION" : "BALANCED"
float trendQuality = math.abs(trendEfficiency) * 100.0
float flowPressure = 50.0 + 50.0 * flowDiag
float structureScore = structurePos * 100.0
float vwapScore = 50.0 + 50.0 * vwapDiag
string sideText = activeSide == 1 ? "LONG POSITION" : activeSide == -1 ? "SHORT POSITION" : "NO ACTIVE SETUP"
string ageText = activeSide == 0 or na(signalAge) ? "—" : str.tostring(signalAge) + " bars"
string entryText = na(planEntry) ? "—" : str.tostring(planEntry, format.mintick)
string dcaText = na(planDca) ? "—" : str.tostring(planDca, format.mintick)
string slText = na(planSl) ? "—" : str.tostring(planSl, format.mintick)
string tp1Text = na(planTp1) ? "—" : str.tostring(planTp1, format.mintick)
string tp2Text = na(planTp2) ? "—" : str.tostring(planTp2, format.mintick)
string tp3Text = na(planTp3) ? "—" : str.tostring(planTp3, format.mintick)
string hitSummary = "DCA " + (hitDca ? "✓" : "—") + " • T1 " + (hitTp1 ? "✓" : "—") + " • T2 " + (hitTp2 ? "✓" : "—") + " • T3 " + (hitTp3 ? "✓" : "—") + " • SL " + (hitSl ? "✓" : "—")
string stoppedDetail = hitTp2 ? "STOPPED AFTER TP2" : hitTp1 ? "STOPPED AFTER TP1" : hitDca ? "STOPPED AFTER DCA" : "STOPPED"
string setupStatus = activeSide == 0 ? "WAITING" : setupOutcome == -1 ? stoppedDetail : setupOutcome == 1 ? "TP3 COMPLETE" : hitTp2 ? "✓ TP2" : hitTp1 ? "✓ TP1" : hitDca ? "✓ DCA" : stable ? "OPEN" : "LIVE"
color bullC = color.rgb(13, 148, 136)
color bearC = color.rgb(220, 38, 38)
color neutralC = color.rgb(71, 85, 105)
color accentC = color.rgb(37, 99, 235)
color violetC = color.rgb(109, 40, 217)
color stateC = score >= signalThreshold ? bullC : score <= (100.0 - signalThreshold) ? bearC : neutralC
color planC = activeSide == 1 ? bullC : activeSide == -1 ? bearC : neutralC
color headerBg = color.rgb(15, 23, 42)
color labelBg = color.rgb(248, 250, 252)
color valueBg = color.rgb(255, 255, 255)
color softBlue = color.rgb(239, 246, 255)
color lineC = color.rgb(226, 232, 240)
var table strixDash = table.new(position.top_right, 2, 12, frame_color=lineC, frame_width=1, border_color=lineC, border_width=1)
if barstate.isfirst
    table.merge_cells(strixDash, 0, 0, 1, 0)
if not showStrixTable and barstate.islast
    table.clear(strixDash, 0, 0, 1, 11)
if showStrixTable and barstate.islast
    table.cell(strixDash, 0, 0, "STRIXEDGE • Liquidity Absorption Engine", text_color=color.white, bgcolor=headerBg, text_size=tableTextSize)
    table.cell(strixDash, 0, 1, "ENGINE", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 1, "#01 • Liquidity", text_color=accentC, bgcolor=valueBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 2, "STRIX CORE", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 2, str.tostring(score, "#.0") + "/100 • " + biasText, text_color=stateC, bgcolor=color.new(stateC, 92), text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 3, "SIGNAL / REGIME", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 3, signalText + " • " + regimeText, text_color=longSignal ? bullC : shortSignal ? bearC : neutralC, bgcolor=valueBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 4, "FLOW / TREND", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 4, str.tostring(flowPressure, "#.0") + "/100 • TQ " + str.tostring(trendQuality, "#.0") + "%", text_color=neutralC, bgcolor=valueBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 5, "RVOL / ATR", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 5, str.tostring(rvol, "#.00") + "x • ATR " + str.tostring(atrRatio, "#.00") + "x", text_color=neutralC, bgcolor=valueBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 6, "STRUCT / VWAP", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 6, str.tostring(structureScore, "#.0") + "% • VWAP " + str.tostring(vwapScore, "#.1") + " • L" + str.tostring(signalThreshold, "#.0") + "/S" + str.tostring(100.0 - signalThreshold, "#.0"), text_color=neutralC, bgcolor=valueBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 7, "SETUP", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 7, sideText + " • " + ageText, text_color=planC, bgcolor=color.new(planC, 93), text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 8, "ENTRY / DCA", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 8, entryText + " • " + dcaText + " (" + dcaPctText + ")", text_color=accentC, bgcolor=softBlue, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 9, "TP1 / TP2", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 9, tp1Text + " (" + tp1PctText + ") • " + tp2Text + " (" + tp2PctText + ")", text_color=bullC, bgcolor=valueBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 10, "TP3 / SL", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 10, tp3Text + " (" + tp3PctText + ") • " + slText + " (" + slPctText + ")", text_color=neutralC, bgcolor=valueBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 0, 11, "HITS / STATUS", text_color=neutralC, bgcolor=labelBg, text_halign=text.align_left, text_size=tableTextSize)
    table.cell(strixDash, 1, 11, hitSummary + " | " + setupStatus, text_color=planC, bgcolor=color.new(planC, 94), text_halign=text.align_left, text_size=tableTextSize)

// ---- Alerts ----
alertcondition(longSignal, "StrixEDGE long state shift", "StrixEDGE: long state shift confirmed")
alertcondition(shortSignal, "StrixEDGE short state shift", "StrixEDGE: short state shift confirmed")
alertcondition(dcaHitNow, "StrixEDGE DCA hit", "StrixEDGE: DCA level reached")
