//@version=6
indicator("PPO", shorttitle = "PPO", overlay = false, format = format.percent, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR        = #089981 // directional bullish color
BEAR_COLOR        = #f23645 // directional bearish color
SIGNAL_COLOR      = #ff9800 // signal line color
ZERO_LINE_TRANSP  = 90      // zero line transparency
FILL_VALUE_TRANSP = 50      // gradient transparency at the PPO value
FILL_ZERO_TRANSP  = 100     // gradient transparency at the zero line
HIST_GROW_TRANSP  = 40      // histogram transparency while the average spread widens
HIST_FADE_TRANSP  = 70      // histogram transparency once the average spread narrows

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
srcInput          = input.source(close, "Source", group = "Settings",
     tooltip = "Price series fed into the fast and slow averages. Closing prices are the standard choice.")

fastLengthInput   = input.int(12, "Fast Length", minval = 1, group = "Settings",
     tooltip = "Length of the fast moving average. The default of 12 is inherited from MACD.")

slowLengthInput   = input.int(26, "Slow Length", minval = 1, group = "Settings",
     tooltip = "Length of the slow moving average. The PPO subtracts this average from the fast one, divides by it and multiplies by 100, stating the spread as a percentage of price - a reading of +2 means the fast average sits 2% above the slow one whether the instrument trades at $5 or $50,000. The default of 26 is inherited from MACD.")

maTypeInput       = input.string("EMA", "Average Type", options = ["EMA", "SMA"], group = "Settings",
     tooltip = "Moving average type used for the fast and slow averages. Exponential averages are the standard PPO recipe; simple averages support fast relatives of the same family such as the 3-10 pairing.")

signalLengthInput = input.int(9, "Signal Smoothing", minval = 1, inline = "signal", group = "Settings",
     tooltip = "Length of the signal line that smooths the PPO line. A 9-period EMA is the standard choice inherited from MACD.")

signalTypeInput   = input.string("EMA", "", options = ["EMA", "SMA"], inline = "signal", group = "Settings",
     tooltip = "Moving average type used for the signal line.")

bullColorInput    = input.color(BULL_COLOR, "Bullish", inline = "direction", group = "Style",
     tooltip = "Color of the PPO line, gradient fill and histogram above the zero line.")

bearColorInput    = input.color(BEAR_COLOR, "Bearish", inline = "direction", group = "Style",
     tooltip = "Color of the PPO line, gradient fill and histogram below the zero line.")

signalColorInput  = input.color(SIGNAL_COLOR, "Signal Line", group = "Style",
     tooltip = "Color of the signal line.")

showHistInput     = input.bool(true, "Show Histogram", group = "Style",
     tooltip = "Displays the histogram (PPO minus signal line) as columns. Bright columns mark a spread between the averages that is still widening, faded columns mark a spread already narrowing back toward the signal line.")

gradientInput     = input.bool(true, "Gradient Fill", group = "Style",
     tooltip = "Fills the area between the zero line and the PPO line with a vertical gradient, fully transparent at zero and strongest at the current value.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
// Fast and slow averages - both smoothings are computed on every bar, the input selects which one is used
emaFast = ta.ema(srcInput, fastLengthInput)
smaFast = ta.sma(srcInput, fastLengthInput)
emaSlow = ta.ema(srcInput, slowLengthInput)
smaSlow = ta.sma(srcInput, slowLengthInput)

fastMa = maTypeInput == "EMA" ? emaFast : smaFast
slowMa = maTypeInput == "EMA" ? emaSlow : smaSlow

// PPO line - the two-average spread divided by the slow average and scaled to percent, so readings are comparable
// across symbols, watchlists and long histories where raw-unit oscillators drift with the price level. Guarded
// against a zero denominator on exotic series
ppoValue = slowMa != 0 ? 100 * (fastMa - slowMa) / slowMa : na

// Signal line - both smoothings are computed on every bar, the input selects which one is used
emaSignal  = ta.ema(ppoValue, signalLengthInput)
smaSignal  = ta.sma(ppoValue, signalLengthInput)
signalLine = signalTypeInput == "EMA" ? emaSignal : smaSignal

// Histogram - PPO minus its signal line, in percentage points
histogram = ppoValue - signalLine

// MACD-inherited signal grammar - the signal-line crossover is the early, noisier trigger; the zero-line cross is
// the slower confirmation that the underlying averages themselves have crossed; histogram turns read the spread
bullCross     = ta.crossover(ppoValue, signalLine)
bearCross     = ta.crossunder(ppoValue, signalLine)
zeroCrossUp   = ta.crossover(ppoValue, 0)
zeroCrossDown = ta.crossunder(ppoValue, 0)
histTurnUp    = histogram > histogram[1] and histogram[1] <= histogram[2]
histTurnDown  = histogram < histogram[1] and histogram[1] >= histogram[2]

//---------------------------------------------------------------------------------------------------------------------}
// Visual Elements
//---------------------------------------------------------------------------------------------------------------------{
// Histogram shading encodes spread direction - bright while the averages pull apart, faded once they converge again
histExpanding   = histogram >= 0 ? histogram > histogram[1] : histogram < histogram[1]
histStrongColor = histogram >= 0 ? color.new(bullColorInput, HIST_GROW_TRANSP) : color.new(bearColorInput, HIST_GROW_TRANSP)
histSoftColor   = histogram >= 0 ? color.new(bullColorInput, HIST_FADE_TRANSP) : color.new(bearColorInput, HIST_FADE_TRANSP)
histColor       = histExpanding ? histStrongColor : histSoftColor

plot(showHistInput ? histogram : na, "Histogram", style = plot.style_columns, color = histColor)

zeroPlotId = plot(0, "Zero Line", color = color.new(chart.fg_color, ZERO_LINE_TRANSP), linewidth = 1)

plot(signalLine, "Signal Line", color = signalColorInput, linewidth = 1)

ppoPlotId = plot(ppoValue, "PPO Line", color = ppoValue > 0 ? bullColorInput : bearColorInput, linewidth = 1)

// Centered-oscillator gradient - fully transparent at the zero line, strongest at the PPO value
fillTopColor    = ppoValue > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_ZERO_TRANSP)
fillBottomColor = ppoValue > 0 ? color.new(bullColorInput, FILL_ZERO_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)

fill(ppoPlotId, zeroPlotId, top_value = math.max(ppoValue, 0), bottom_value = math.min(ppoValue, 0), top_color = gradientInput ? fillTopColor : na, bottom_color = gradientInput ? fillBottomColor : na, title = "Zero-line Gradient Fill")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullCross, "Bullish Signal Cross", "PPO crossed above its signal line on {{ticker}} - early percentage-momentum trigger to the upside ({{interval}})")
alertcondition(bearCross, "Bearish Signal Cross", "PPO crossed below its signal line on {{ticker}} - early percentage-momentum trigger to the downside ({{interval}})")
alertcondition(zeroCrossUp, "Zero-line Cross Up", "PPO crossed above zero on {{ticker}} - the fast average is back above the slow one, bullish regime ({{interval}})")
alertcondition(zeroCrossDown, "Zero-line Cross Down", "PPO crossed below zero on {{ticker}} - the fast average dropped under the slow one, bearish regime ({{interval}})")
alertcondition(histTurnUp, "Histogram Turn Up", "PPO histogram turned up on {{ticker}} - the spread between the averages is swinging back in favor of buyers ({{interval}})")
alertcondition(histTurnDown, "Histogram Turn Down", "PPO histogram turned down on {{ticker}} - the spread between the averages is swinging back in favor of sellers ({{interval}})")

//---------------------------------------------------------------------------------------------------------------------}
