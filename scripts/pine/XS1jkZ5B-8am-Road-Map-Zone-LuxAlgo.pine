//@version=6
indicator("8am Road Map Zone", overlay = true)

// Constants
BULL_COLOR    = #089981  // close above the opening range at the open - look for buys
BEAR_COLOR    = #f23645  // close below the opening range at the open - look for sells
NEUTRAL_COLOR = #787b86  // pre-open range, midline, open line and the neutral read

// Inputs
in_or_session = input.session("0800-0815", "OR Session", group="Time Settings")
in_tz = input.string("America/New_York", "Timezone", group="Time Settings")

// State variables
var float or_high = na
var float or_low = na
var float or_mid = na
var int or_start_bar = na

var box initial_grey_box = na
var line initial_grey_line = na

var box colored_box = na
var line colored_line = na
var label or_label = na

var bool has_opened = false

// Time checks
is_or = not na(time(timeframe.period, in_or_session, in_tz))
is_new_or = is_or and not is_or[1]
is_end_or = not is_or and is_or[1]

// Calculate OR High, Low, Mid
if is_new_or
    or_high := high
    or_low := low
    or_start_bar := bar_index
    has_opened := false
else if is_or
    or_high := math.max(or_high, high)
    or_low := math.min(or_low, low)

or_mid := (or_high + or_low) / 2

// Draw initial grey elements at end of OR (Wait till open phase)
if is_end_or
    initial_grey_box := box.new(left = or_start_bar, top = or_high, right = bar_index, bottom = or_low, border_color = NEUTRAL_COLOR, bgcolor = color.new(NEUTRAL_COLOR, 85))
    initial_grey_line := line.new(x1 = or_start_bar, y1 = or_mid, x2 = bar_index, y2 = or_mid, color = NEUTRAL_COLOR, style = line.style_dashed)
    or_label := label.new(x = bar_index + 5, y = or_high, text = "Wait till open", color = #00000000, textcolor = NEUTRAL_COLOR, style = label.style_label_down, size = size.small)

// Market Open check (trigger at or after 9:30 AM EST)
market_open_bar = not has_opened and not is_or and ((hour(time, in_tz) == 9 and minute(time, in_tz) >= 30) or hour(time, in_tz) > 9)

if market_open_bar
    has_opened := true
    
    // Draw vertical dotted line
    line.new(x1 = bar_index, y1 = low - ta.tr * 2, x2 = bar_index, y2 = high + ta.tr * 2, color = NEUTRAL_COLOR, style = line.style_dashed, extend = extend.both)
    
    // Create new colored box and line starting from 9:30 based on current timeframe close
    box_color = NEUTRAL_COLOR
    if close > or_high
        box_color := BULL_COLOR
        label.set_text(or_label, "Look for buys")
    else if close < or_low
        box_color := BEAR_COLOR
        label.set_text(or_label, "Look for sells")
    else
        box_color := NEUTRAL_COLOR
        label.set_text(or_label, "Neutral")
        
    label.set_textcolor(or_label, box_color)
    
    colored_box := box.new(left = bar_index, top = or_high, right = bar_index + 5, bottom = or_low, border_color = box_color, bgcolor = color.new(box_color, 85))
    colored_line := line.new(x1 = bar_index, y1 = or_mid, x2 = bar_index + 5, y2 = or_mid, color = box_color, style = line.style_dashed)

// Extend drawings forward appropriately
is_active_day = (hour(time, in_tz) >= 8 and hour(time, in_tz) < 16) or (hour(time, in_tz) == 16 and minute(time, in_tz) == 0)

if is_active_day and not is_or
    if not has_opened
        // Before 9:30, extend the grey box
        if not na(initial_grey_box)
            box.set_right(initial_grey_box, bar_index)
        if not na(initial_grey_line)
            line.set_x2(initial_grey_line, bar_index)
        if not na(or_label)
            label.set_x(or_label, bar_index + 5)
    else
        // After 9:30, extend the colored box
        if not na(colored_box)
            box.set_right(colored_box, bar_index + 5)
        if not na(colored_line)
            line.set_x2(colored_line, bar_index + 5)
        if not na(or_label)
            label.set_x(or_label, bar_index + 5)