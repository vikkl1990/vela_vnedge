//@version=6
indicator("Smart SafeZone Stops [MarkitTick]", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// -----------------------------------------------------------------------------
// 1. Constants & Configuration
// -----------------------------------------------------------------------------

color COL_BULL_MAIN = #00E676 
color COL_BEAR_MAIN = #FF5252 
color COL_NEUTRAL   = #9598A1 
color COL_TEXT      = #FFFFFF 
color COL_BG        = #131722 
color COL_WARN      = #FF9800 

// -----------------------------------------------------------------------------
// 2. User Inputs 
// -----------------------------------------------------------------------------

grp_trend   = "Trend Definitions"
grp_noise   = "Noise Calculation"
grp_adx     = "Dynamic Multiplier (ADX)"
grp_mtf     = "Multi-Timeframe Consensus"
grp_warn    = "Exhaustion Warning"
grp_viz     = "Dashboard & Alerts"

int trend_ema_len = input.int(22, "Trend Filter (EMA Length)", minval=5, group=grp_trend, tooltip="Defines the baseline trend. Close > EMA = Uptrend.")

int lookback_len  = input.int(10, "Noise Lookback Period", minval=2, group=grp_noise, tooltip="Window to calculate average directional noise (10-20 days standard).")
float mult_factor = input.float(2.5, "Base Safety Coefficient", minval=1.0, step=0.1, group=grp_noise, tooltip="Standard multiplier if Dynamic ADX is disabled or ADX is neutral.")
bool use_smoothing = input.bool(true, "Use 3-Day Smoothing", group=grp_noise, tooltip="Prevents stop from moving too aggressively by taking the worst-case of the last 3 calculated stops.")

bool use_vol_weight = input.bool(false, "Use Volume Weighting", group=grp_noise, tooltip="If enabled, multiplies noise penetration by Relative Volume (Vol/AvgVol).")
int  vol_avg_len    = input.int(20, "Volume Avg Length", minval=5, group=grp_noise)

bool use_atr_floor  = input.bool(false, "Enable Safety Cushion (ATR Floor)", group=grp_noise, tooltip="Prevents stops from getting too tight during squeezes. Uses Max(Noise, ATR * Coeff).")
int  atr_floor_len  = input.int(14, "ATR Floor Length", minval=5, group=grp_noise)
float atr_floor_mult = input.float(0.5, "ATR Floor Coeff", minval=0.1, step=0.1, group=grp_noise)

bool use_adx_dynamic = input.bool(false, "Enable Dynamic ADX Multiplier", group=grp_adx, tooltip="Adjusts the multiplier based on trend strength.")
int  adx_len         = input.int(14, "ADX Length", minval=5, group=grp_adx)
int  adx_strong      = input.int(30, "Strong Trend Threshold (>)", group=grp_adx)
int  adx_weak        = input.int(20, "Weak Trend Threshold (<)", group=grp_adx)
float mult_aggr      = input.float(1.5, "Aggressive Multiplier", minval=0.5, step=0.1, group=grp_adx)
float mult_cons      = input.float(3.5, "Conservative Multiplier", minval=1.0, step=0.1, group=grp_adx)

bool use_mtf_cloud  = input.bool(false, "Show MTF Consensus Clouds", group=grp_mtf, tooltip="Colors background based on alignment with Higher Timeframe trend.")
string mtf_tf       = input.timeframe("D", "Higher Timeframe", group=grp_mtf)
int mtf_ema_len     = input.int(50, "HTF EMA Length", minval=5, group=grp_mtf)

bool use_exhaust    = input.bool(true, "Show Exhaustion Warnings", group=grp_warn, tooltip="Signals when price has extended too far from the stop (Mean Reversion Risk).")
int  exhaust_len    = input.int(14, "ATR Length", minval=1, group=grp_warn)
float exhaust_mult  = input.float(3.0, "ATR Multiplier", minval=1.0, step=0.1, group=grp_warn, tooltip="Trigger warning if Price - Stop > ATR * Multiplier.")

// Dashboard
bool show_table = input.bool(true, "Show Quant Dashboard", group=grp_viz)

// -----------------------------------------------------------------------------
// 3. Pre-calculated Common Values 
// -----------------------------------------------------------------------------

float ema_trend = ta.ema(close, trend_ema_len)
bool is_uptrend = close > ema_trend

bool trend_switch_up   = is_uptrend and not is_uptrend[1]
bool trend_switch_down = not is_uptrend and is_uptrend[1]

float vol_ratio = 1.0
if use_vol_weight
    float avg_vol = ta.sma(volume, vol_avg_len)
    vol_ratio := avg_vol > 0 ? volume / avg_vol : 1.0

float noise_floor = 0.0
if use_atr_floor
    noise_floor := ta.atr(atr_floor_len) * atr_floor_mult

float adx_value = na
if use_adx_dynamic or show_table
    [_, _, adx_calc] = ta.dmi(adx_len, adx_len)
    adx_value := adx_calc

// -----------------------------------------------------------------------------
// 4. Noise Calculation 
// -----------------------------------------------------------------------------

float downside_pen = math.max(low[1] - low, 0.0) * vol_ratio
float upside_pen   = math.max(high - high[1], 0.0) * vol_ratio

float avg_noise_down = ta.sma(downside_pen, lookback_len)
float avg_noise_up   = ta.sma(upside_pen, lookback_len)

if use_atr_floor
    avg_noise_down := math.max(avg_noise_down, noise_floor)
    avg_noise_up   := math.max(avg_noise_up, noise_floor)

// -----------------------------------------------------------------------------
// 5. Dynamic Multiplier Calculation 
// -----------------------------------------------------------------------------

float final_mult = mult_factor 

if use_adx_dynamic and not na(adx_value)
    final_mult := adx_value >= adx_strong ? mult_aggr : 
                  adx_value <= adx_weak ? mult_cons : 
                  mult_factor

// -----------------------------------------------------------------------------
// 6. Calculate Raw Stop Targets
// -----------------------------------------------------------------------------

float raw_stop_long  = low[1] - (avg_noise_down * final_mult)
float raw_stop_short = high[1] + (avg_noise_up * final_mult)

// -----------------------------------------------------------------------------
// 7. The Ratchet Mechanism with Proper 3-Day Smoothing 
// -----------------------------------------------------------------------------

var float stop_long_final  = na
var float stop_short_final = na

if trend_switch_up
    stop_long_final := raw_stop_long
else if is_uptrend
    if use_smoothing
        float smooth_stop = math.max(raw_stop_long, 
                           math.max(nz(stop_long_final[0], raw_stop_long), 
                                   nz(stop_long_final[1], raw_stop_long)))
        stop_long_final := smooth_stop
    else
        stop_long_final := math.max(raw_stop_long, nz(stop_long_final, raw_stop_long))
else
    stop_long_final := na

if trend_switch_down
    stop_short_final := raw_stop_short
else if not is_uptrend
    if use_smoothing
        float smooth_stop = math.min(raw_stop_short, 
                           math.min(nz(stop_short_final[0], raw_stop_short), 
                                   nz(stop_short_final[1], raw_stop_short)))
        stop_short_final := smooth_stop
    else
        stop_short_final := math.min(raw_stop_short, nz(stop_short_final, raw_stop_short))
else
    stop_short_final := na

// -----------------------------------------------------------------------------
// 8. Visualization
// -----------------------------------------------------------------------------

plot(ema_trend, "Trend Baseline", color=color.new(COL_NEUTRAL, 50))

plot(is_uptrend ? stop_long_final : na, "SafeZone Long", 
     color=COL_BULL_MAIN, style=plot.style_linebr, linewidth=2)
plot(not is_uptrend ? stop_short_final : na, "SafeZone Short", 
     color=COL_BEAR_MAIN, style=plot.style_linebr, linewidth=2)

plotshape(trend_switch_up, "Bull Start", shape.triangleup, location.belowbar, 
          COL_BULL_MAIN, size=size.small)
plotshape(trend_switch_down, "Bear Start", shape.triangledown, location.abovebar, 
          COL_BEAR_MAIN, size=size.small)

bool htf_uptrend = use_mtf_cloud ? request.security(syminfo.tickerid, mtf_tf, 
                                    close > ta.ema(close, mtf_ema_len), 
                                    lookahead = barmerge.lookahead_off) : false

color cloud_color = use_mtf_cloud ? (is_uptrend and htf_uptrend ? color.new(COL_BULL_MAIN, 90) : 
                     not is_uptrend and not htf_uptrend ? color.new(COL_BEAR_MAIN, 90) : 
                     color.new(color.gray, 85)) : na

bgcolor(cloud_color, title="MTF Consensus Cloud")

bool is_exhausted_long  = false
bool is_exhausted_short = false

if use_exhaust
    float exhaust_atr = ta.atr(exhaust_len)
    float active_stop = is_uptrend ? stop_long_final : stop_short_final
    
    if not na(active_stop) and not na(exhaust_atr)
        float stop_dist = math.abs(close - active_stop)
        bool is_exhausted = stop_dist > (exhaust_atr * exhaust_mult)
        
        is_exhausted_long  := is_uptrend and is_exhausted
        is_exhausted_short := not is_uptrend and is_exhausted

plotshape(is_exhausted_long, "Exhaustion Long", shape.labeldown, location.abovebar, 
          color.new(COL_WARN, 0), text="⚠️", textcolor=color.white, size=size.tiny)
plotshape(is_exhausted_short, "Exhaustion Short", shape.labelup, location.belowbar, 
          color.new(COL_WARN, 0), text="⚠️", textcolor=color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// 9. Dashboard & Analytics 
// -----------------------------------------------------------------------------

int bars_since_bull = ta.barssince(trend_switch_up)
int bars_since_bear = ta.barssince(trend_switch_down)

var table dashboard = table.new(position.top_right, 2, 7, bgcolor=COL_BG, 
                                border_color=COL_NEUTRAL, border_width=1, 
                                frame_color=COL_NEUTRAL, frame_width=1)

if show_table and barstate.islast
    float current_stop = is_uptrend ? stop_long_final : stop_short_final
    float dist_pct     = not na(current_stop) ? math.abs(close - current_stop) / close * 100 : 0.0
    int trend_age      = is_uptrend ? bars_since_bull : bars_since_bear

    table.cell(dashboard, 0, 0, "MARKET SITUATION", text_color=COL_TEXT, 
               text_size=size.small, bgcolor=COL_NEUTRAL)
    table.merge_cells(dashboard, 0, 0, 1, 0)

    table.cell(dashboard, 0, 1, "Trend", text_color=COL_TEXT, text_size=size.small)
    table.cell(dashboard, 1, 1, is_uptrend ? "BULLISH" : "BEARISH", 
               text_color=COL_BG, text_size=size.small, 
               bgcolor=is_uptrend ? COL_BULL_MAIN : COL_BEAR_MAIN)
    
    string age_str = na(trend_age) ? "N/A" : str.tostring(trend_age) + " Bars"
    table.cell(dashboard, 0, 2, "Age", text_color=COL_TEXT, text_size=size.small)
    table.cell(dashboard, 1, 2, age_str, text_color=COL_NEUTRAL, text_size=size.small)
    
    table.cell(dashboard, 0, 3, "Stop Price", text_color=COL_TEXT, text_size=size.small)
    table.cell(dashboard, 1, 3, str.tostring(current_stop, format.mintick), 
               text_color=COL_TEXT, text_size=size.small)
    
    table.cell(dashboard, 0, 4, "Risk %", text_color=COL_TEXT, text_size=size.small)
    table.cell(dashboard, 1, 4, str.tostring(dist_pct, "#.##") + "%", 
               text_color=dist_pct > 3.0 ? COL_BEAR_MAIN : COL_NEUTRAL, text_size=size.small)
    
    table.cell(dashboard, 0, 5, "Active Mult", text_color=COL_TEXT, text_size=size.small)
    table.cell(dashboard, 1, 5, str.tostring(final_mult, "#.##") + "x", 
               text_color=COL_NEUTRAL, text_size=size.small)

    if use_adx_dynamic and not na(adx_value)
        string adx_state = adx_value >= adx_strong ? "STRONG" : 
                          adx_value <= adx_weak ? "WEAK" : "NORMAL"
        table.cell(dashboard, 0, 6, "ADX State", text_color=COL_TEXT, text_size=size.small)
        table.cell(dashboard, 1, 6, adx_state + " (" + str.tostring(adx_value, "#.0") + ")", 
                   text_color=COL_NEUTRAL, text_size=size.small)

// -----------------------------------------------------------------------------
// 10. Alerts 
// -----------------------------------------------------------------------------

bool exit_long  = is_uptrend and not na(stop_long_final) and close < stop_long_final
bool exit_short = not is_uptrend and not na(stop_short_final) and close > stop_short_final

if exit_long or exit_short
    string action = exit_long ? "EXIT_LONG" : "EXIT_SHORT"
    float stop_level = exit_long ? stop_long_final : stop_short_final
    
    string json_alert = '{"ticker": "' + syminfo.ticker + 
                       '", "action": "' + action + 
                       '", "price": ' + str.tostring(close, format.mintick) + 
                       ', "stop_level": ' + str.tostring(stop_level, format.mintick) + '}'
    
    alert(json_alert, alert.freq_once_per_bar_close)

if trend_switch_up
    alert('{"action": "TREND_FLIP_LONG", "ticker": "' + syminfo.ticker + '"}', 
          alert.freq_once_per_bar_close)

if trend_switch_down
    alert('{"action": "TREND_FLIP_SHORT", "ticker": "' + syminfo.ticker + '"}', 
          alert.freq_once_per_bar_close)
