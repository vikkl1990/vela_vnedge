//@version=6
indicator("Wide-range Bar", "Wide-range Bar", overlay = true, max_labels_count = 500, max_lines_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
METHOD_WIDEST   = "Widest of Last N Bars"
METHOD_MULTIPLE = "Multiple of Average Range / ATR"
BASE_RANGE      = "Average Range"
BASE_ATR        = "ATR"
LABEL_BG        = #00000000

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
methodInput = input.string(METHOD_WIDEST, "Detection Method", options = [METHOD_WIDEST, METHOD_MULTIPLE], group = "Detection",
  tooltip = "How a bar qualifies as wide-range. 'Widest of Last N Bars' flags a bar whose high-to-low span exceeds every span within the previous N - 1 bars, the expansion mirror of narrow-range patterns such as NR7. 'Multiple of Average Range / ATR' flags a bar whose span exceeds the trailing baseline times the range multiple. Both thresholds float with the instrument's own volatility, so they transfer across symbols and timeframes.")

widestLengthInput = input.int(7, "Widest of Last (N) Bars", minval = 2, group = "Detection",
  tooltip = "Window for the 'Widest of Last N Bars' method: a bar qualifies when its high-to-low span is the largest of the last N bars. 7 is the common convention, mirroring NR7.")

rangeMultInput = input.float(1.5, "Range Multiple", minval = 0.1, step = 0.1, group = "Detection",
  tooltip = "Multiple used by the 'Multiple of Average Range / ATR' method: a bar qualifies when its high-to-low span exceeds baseline x multiple.")

baselineInput = input.string(BASE_RANGE, "Baseline", options = [BASE_RANGE, BASE_ATR], group = "Detection",
  tooltip = "Trailing volatility baseline for the multiple test. 'Average Range' averages the raw high-to-low spans; 'ATR' uses the average true range, which also accounts for gaps between bars. The baseline is taken one bar back so the tested bar does not inflate its own threshold.")

baselineLengthInput = input.int(14, "Baseline Length", minval = 1, group = "Detection",
  tooltip = "Number of bars in the trailing baseline average. Also used to report each flagged bar's range expansion ratio in its label tooltip.")

closeZoneInput = input.float(33, "Extreme Close Zone (%)", minval = 0, maxval = 50, step = 1, group = "Close Location",
  tooltip = "Portion of the bar's span, measured from each extreme, that counts as a one-sided close. With 33, a close located in the top third of the span reads as bullish conviction, a close in the bottom third as bearish conviction, and anything between as a mid-range (two-sided) close.")

volumeFilterInput = input.bool(false, "Require Volume Expansion", group = "Volume Filter",
  tooltip = "Only flag wide-range bars whose volume exceeds its trailing average: range expansion on expanding volume reads as genuine initiative on session markets. Automatically bypassed when the symbol reports no volume data.")

volumeLengthInput = input.int(20, "Volume Average Length", minval = 1, group = "Volume Filter",
  tooltip = "Number of bars in the trailing volume average used by the volume expansion filter.")

showLabelsInput = input.bool(true, "Show WRB Labels", group = "Style",
  tooltip = "Mark qualifying bars with a small WRB tag, below the bar for a bullish close and above it otherwise. Each tag's tooltip reports the bar's range expansion ratio and the close's location within the span.")

colorBarsInput = input.bool(true, "Color Wide-range Bars", group = "Style",
  tooltip = "Color qualifying bars by their close location read: bullish near the high, bearish near the low, mid-range otherwise.")

showMidpointInput = input.bool(false, "Midpoint of Latest WRB", group = "Style",
  tooltip = "Draw a dotted level at the midpoint of the most recent wide-range bar, a common retracement reference for traders who prefer not to chase the bar's close.")

bullColorInput = input.color(#089981, "Bullish Close", group = "Style",
  tooltip = "Color used when a wide-range bar closes near its high, reading as one-sided initiative buying.")

bearColorInput = input.color(#f23645, "Bearish Close", group = "Style",
  tooltip = "Color used when a wide-range bar closes near its low, reading as one-sided initiative selling.")

midColorInput = input.color(#787b86, "Mid-range Close", group = "Style",
  tooltip = "Color used when a wide-range bar closes mid-range, recording a two-sided fight rather than a winner.")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
barRange = high - low

//Trailing context series, computed unconditionally on every bar
averageRange  = ta.sma(barRange, baselineLengthInput)
atrValue      = ta.atr(baselineLengthInput)
priorWidest   = ta.highest(barRange, widestLengthInput - 1)[1]
volumeAverage = ta.sma(volume, volumeLengthInput)

//Baseline taken one bar back so the tested bar does not inflate its own threshold
baselineValue = baselineInput == BASE_ATR ? atrValue : averageRange
baselinePrev  = baselineValue[1]

//Wide-range test under the selected convention
isWidestOfN = not na(priorWidest)  and barRange > priorWidest
isAboveMult = not na(baselinePrev) and barRange > rangeMultInput * baselinePrev
rangeIsWide = barRange > 0 and (methodInput == METHOD_WIDEST ? isWidestOfN : isAboveMult)

//Optional volume expansion filter, bypassed when the symbol reports no volume
volumeAveragePrev = volumeAverage[1]
hasVolumeData     = not na(volume) and not na(volumeAveragePrev)
volumeOk          = not volumeFilterInput or not hasVolumeData or volume > volumeAveragePrev

//Close-location value within the bar's low-to-high span
closePosition = barRange > 0 ? (close - low) / barRange * 100 : 50.
clvValue      = barRange > 0 ? ((close - low) - (high - close)) / barRange : 0.

//Directional read from the close location, evaluated on confirmed bars only
wrbEvent = rangeIsWide and volumeOk and barstate.isconfirmed

nearHigh = closePosition >= 100 - closeZoneInput
nearLow  = closePosition <= closeZoneInput

bullWrb = wrbEvent and nearHigh
bearWrb = wrbEvent and nearLow and not nearHigh
midWrb  = wrbEvent and not nearHigh and not nearLow
anyWrb  = bullWrb or bearWrb or midWrb

//Range expansion ratio reported in label tooltips
averageRangePrev = averageRange[1]
rangeRatio       = not na(averageRangePrev) and averageRangePrev > 0 ? barRange / averageRangePrev : na

//---------------------------------------------------------------------------------------------------------------------}
// Visuals
//---------------------------------------------------------------------------------------------------------------------{
eventColor = bullWrb ? bullColorInput : bearWrb ? bearColorInput : midColorInput

//Bar coloring by close location read
barcolor(colorBarsInput and anyWrb ? eventColor : na, title = "Wide-range Bars")

//Subtle WRB marks
if showLabelsInput and anyWrb
    tooltipText = (na(rangeRatio) ? "" : "Range " + str.tostring(rangeRatio, "#.##") + "x its " + str.tostring(baselineLengthInput) + "-bar average, ")
      + "close at " + str.tostring(closePosition, "#") + "% of the span (CLV " + str.tostring(clvValue, "#.##") + ")"

    label.new(bar_index, na, "WRB"
      , yloc      = bullWrb ? yloc.belowbar : yloc.abovebar
      , style     = bullWrb ? label.style_label_up : label.style_label_down
      , color     = LABEL_BG
      , textcolor = eventColor
      , size      = size.tiny
      , tooltip   = tooltipText)

//Midpoint of the most recent wide-range bar, a common retracement reference
var line midpointLine = na

if showMidpointInput and anyWrb
    line.delete(midpointLine)
    midpointLine := line.new(bar_index, math.avg(high, low), bar_index + 1, math.avg(high, low), color = eventColor, style = line.style_dotted, extend = extend.right)

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(bullWrb, "Bullish Wide-range Bar", "Wide-range bar closing near its high - one-sided initiative buying, breakout validation candidate")
alertcondition(bearWrb, "Bearish Wide-range Bar", "Wide-range bar closing near its low - one-sided initiative selling, breakdown validation candidate")
alertcondition(midWrb, "Mid-range Close Wide-range Bar", "Wide-range bar closing mid-range - two-sided fight at unusual intensity")
alertcondition(anyWrb, "Any Wide-range Bar", "Wide-range bar detected - unusual range expansion for the recent context")

//---------------------------------------------------------------------------------------------------------------------}
