//@version=6
indicator("HTF Swing Structure Signals", overlay = true, max_lines_count = 500, max_labels_count = 500)

// --- Inputs ---
grp_ema = "EMA Settings"
htf     = input.timeframe("D", "Higher Timeframe", group = grp_ema)
emaLen  = input.int(50, "EMA Length", group = grp_ema)

grp_ms    = "Market Structure Settings"
prd       = input.int(5, "MS Pivot Period", group = grp_ms)
fibPrd    = input.int(15, "Fib Pivot Period", tooltip = "Use a higher number to find more significant swing points for the Fibonacci retracements", group = grp_ms)
fibMaxBars= input.int(100, "Max Bars for Fib to Disappear", group = grp_ms)
requireCtBos = input.bool(true, "Require Counter-Trend BOS for Setup", tooltip = "If enabled, a trend-aligned 50% retrace setup will only plot if a counter-trend BOS previously formed.", group = grp_ms)
bullColor = input.color(#089981, "Bullish Structure Color", group = grp_ms)
bearColor = input.color(#f23645, "Bearish Structure Color", group = grp_ms)

// --- Logic ---
// Calculate the EMA on the higher timeframe
htfEma = request.security(syminfo.tickerid, htf, ta.ema(close, emaLen), gaps = barmerge.gaps_off)
emaTrend = close > htfEma ? 1 : close < htfEma ? -1 : 0

// --- Plotting EMA ---
emaColor = emaTrend == 1 ? bullColor : bearColor
plot(htfEma, title = "HTF EMA", color = emaColor, linewidth = 2)

// --- Label ---
var label emaLabel = label.new(na, na, "", style = label.style_label_left, size = size.normal)
displayTf = htf == "" ? timeframe.period : htf

if barstate.islast
    label.set_xy(emaLabel, bar_index + 2, htfEma)
    label.set_text(emaLabel, displayTf + " " + str.tostring(emaLen) + " EMA")
    label.set_color(emaLabel, color.new(emaColor, 100))
    label.set_textcolor(emaLabel, emaColor)

// --- Market Structure (SMC) Logic ---
float ph = ta.pivothigh(high, prd, prd)
float pl = ta.pivotlow(low, prd, prd)

// Fib pivots
float fibPh = ta.pivothigh(high, fibPrd, fibPrd)
float fibPl = ta.pivotlow(low, fibPrd, fibPrd)

var float lastPh = na
var float lastPl = na
var int   lastPhIndex = na
var int   lastPlIndex = na

// Track the most recent pivot for drawing fibs
var float recentPh = na
var float recentPl = na
var int   recentPhIndex = na
var int   recentPlIndex = na

if not na(ph)
    lastPh := ph
    lastPhIndex := bar_index[prd]

if not na(pl)
    lastPl := pl
    lastPlIndex := bar_index[prd]

if not na(fibPh)
    recentPh := fibPh
    recentPhIndex := bar_index[fibPrd]

if not na(fibPl)
    recentPl := fibPl
    recentPlIndex := bar_index[fibPrd]

var int msTrend = 0

bool bullBreak = false
bool bearBreak = false

if not na(lastPh) and close > lastPh
    bullBreak := true
    lastPh := na

if not na(lastPl) and close < lastPl
    bearBreak := true
    lastPl := na

// Filter breaks by EMA trend
// User requested to show both bullish and bearish structure regardless of the EMA trend
validBullBreak = bullBreak
validBearBreak = bearBreak

// Track active Fib lines
var line activeFibLine = na
var label activeFibLabel = na
var float activeFibLevel = na
var int activeFibDir = 0 // 1 for bull, -1 for bear
var int activeFibStartIndex = na

// State tracker for Counter-Trend BOS
var bool hasCtBos = false

if validBullBreak
    c_bull = emaTrend == 1 ? bullColor : color.gray
    
    // Check if it's a BOS against a bearish HTF trend
    if msTrend == 1 and emaTrend == -1
        hasCtBos := true
        
    if msTrend == -1 // CHoCH
        line.new(lastPhIndex, high[bar_index - lastPhIndex], bar_index, high[bar_index - lastPhIndex], color = c_bull, style = line.style_dashed)
        label.new(int(math.avg(lastPhIndex, bar_index)), high[bar_index - lastPhIndex], "CHoCH", color = color.new(color.white, 100), textcolor = c_bull, style = label.style_label_down, size = size.tiny)
        
        // Draw Fib if trend aligned and CT BOS requirement is met
        bool setupValid = (emaTrend == 1) and (not requireCtBos or hasCtBos)
        if setupValid
            // Find the lowest point since the broken high
            barsBack = bar_index - lastPhIndex
            float originLow = low
            int originIndex = bar_index
            if barsBack > 0
                for i = 0 to barsBack
                    if low[i] < originLow
                        originLow := low[i]
                        originIndex := bar_index[i]
            
            line.new(originIndex, originLow, bar_index, high, color = bullColor, style = line.style_dotted)
            fib50 = math.avg(originLow, high)
            
            // Set active fib
            activeFibLine := line.new(originIndex, fib50, bar_index, fib50, color = bullColor, style = line.style_solid)
            activeFibLabel := label.new(bar_index, fib50, "50%", color = color.new(color.white, 100), textcolor = bullColor, style = label.style_label_left, size = size.tiny)
            activeFibLevel := fib50
            activeFibDir := 1
            activeFibStartIndex := bar_index
            
            // Reset state
            hasCtBos := false
            
    else // BOS
        line.new(lastPhIndex, high[bar_index - lastPhIndex], bar_index, high[bar_index - lastPhIndex], color = c_bull, style = line.style_dashed)
        label.new(int(math.avg(lastPhIndex, bar_index)), high[bar_index - lastPhIndex], "BOS", color = color.new(color.white, 100), textcolor = c_bull, style = label.style_label_down, size = size.tiny)
    msTrend := 1

if validBearBreak
    c_bear = emaTrend == -1 ? bearColor : color.gray
    
    // Check if it's a BOS against a bullish HTF trend
    if msTrend == -1 and emaTrend == 1
        hasCtBos := true
        
    if msTrend == 1 // CHoCH
        line.new(lastPlIndex, low[bar_index - lastPlIndex], bar_index, low[bar_index - lastPlIndex], color = c_bear, style = line.style_dashed)
        label.new(int(math.avg(lastPlIndex, bar_index)), low[bar_index - lastPlIndex], "CHoCH", color = color.new(color.white, 100), textcolor = c_bear, style = label.style_label_up, size = size.tiny)
        
        // Draw Fib if trend aligned and CT BOS requirement is met
        bool setupValid = (emaTrend == -1) and (not requireCtBos or hasCtBos)
        if setupValid
            // Find the highest point since the broken low
            barsBack = bar_index - lastPlIndex
            float originHigh = high
            int originIndex = bar_index
            if barsBack > 0
                for i = 0 to barsBack
                    if high[i] > originHigh
                        originHigh := high[i]
                        originIndex := bar_index[i]
                        
            line.new(originIndex, originHigh, bar_index, low, color = bearColor, style = line.style_dotted)
            fib50 = math.avg(originHigh, low)
            
            // Set active fib
            activeFibLine := line.new(originIndex, fib50, bar_index, fib50, color = bearColor, style = line.style_solid)
            activeFibLabel := label.new(bar_index, fib50, "50%", color = color.new(color.white, 100), textcolor = bearColor, style = label.style_label_left, size = size.tiny)
            activeFibLevel := fib50
            activeFibDir := -1
            activeFibStartIndex := bar_index
            
            // Reset state
            hasCtBos := false
            
    else // BOS
        line.new(lastPlIndex, low[bar_index - lastPlIndex], bar_index, low[bar_index - lastPlIndex], color = c_bear, style = line.style_dashed)
        label.new(int(math.avg(lastPlIndex, bar_index)), low[bar_index - lastPlIndex], "BOS", color = color.new(color.white, 100), textcolor = c_bear, style = label.style_label_up, size = size.tiny)
    msTrend := -1

// Track if a touch just happened for signaling
bool justTouchedBull = false
bool justTouchedBear = false

// Extend active Fib line until touched or max bars pass
if not na(activeFibLine)
    bool touched = false
    bool expired = (bar_index - activeFibStartIndex) >= fibMaxBars
    
    // Only check for touch on bars AFTER the line is plotted
    if bar_index > activeFibStartIndex
        if activeFibDir == 1 // Bullish Fib, waiting for price to retrace down to it
            if low <= activeFibLevel
                touched := true
                justTouchedBull := true
        else if activeFibDir == -1 // Bearish Fib, waiting for price to retrace up to it
            if high >= activeFibLevel
                touched := true
                justTouchedBear := true
            
    if touched or expired
        // Stop extending
        activeFibLine := na
        activeFibLabel := na
        activeFibLevel := na
        activeFibDir := 0
        activeFibStartIndex := na
    else
        // Keep extending
        line.set_x2(activeFibLine, bar_index + 1)
        label.set_x(activeFibLabel, bar_index + 1)

// --- Signals ---
plotshape(justTouchedBull, title = "Bullish Fib Touch", style = shape.triangleup, location = location.belowbar, color = bullColor, size = size.small)
plotshape(justTouchedBear, title = "Bearish Fib Touch", style = shape.triangledown, location = location.abovebar, color = bearColor, size = size.small)
