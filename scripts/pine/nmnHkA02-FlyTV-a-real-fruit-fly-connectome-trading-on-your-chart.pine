// groups: 0 GF · 1 DNp09 · 2 MDN · 3 DNa · 4 DNg11 · 5 looming · 6 KC · 7 MBON · 8 PAM · 9 PPL1 · A APL/DPM

// ── Helpers ──────────────────────────────────────────────────────────────────
dec1(string s, int i) => nz(str.pos(ALPHA, str.substring(s, i, i + 1)), 0)
dec2(string s, int i) => dec1(s, i) * 64 + dec1(s, i + 1)
tanh(float x) =>
    xx = math.max(-20.0, math.min(20.0, x))
    e2 = math.exp(2.0 * xx)
    (e2 - 1.0) / (e2 + 1.0)
var int[] rngA = array.new_int(1, 42)
nextRnd() =>
    s = (array.get(rngA, 0) * 48271) % 2147483647
    array.set(rngA, 0, s)
    s
rndInt(int m) => nextRnd() % m

// ── Network state ────────────────────────────────────────────────────────────
var int[]   grp     = array.new_int(N_NEUR, 0)
var int[]   deg     = array.new_int(N_NEUR, 0)
var int[]   dstA    = array.new_int(0)
var float[] wA      = array.new_float(0)          // current: sign × contacts / wScale
var float[] wRaw    = array.new_float(0)          // |contacts| for the mushroom body
var float[] mA      = array.new_float(0)          // plastic multiplier (KC→MBON only)
var int[]   off     = array.new_int(N_NEUR + 1, 0)
var float[] v       = array.new_float(N_NEUR, 0.0)
var int[]   lastT   = array.new_int(N_NEUR, 0)
var int[]   firedAt = array.new_int(N_NEUR, -9)
var int[]   cur     = array.new_int(0)
var int[]   nxt     = array.new_int(0)
var int[]   loomIdx = array.new_int(0)
var float[] loomG   = array.new_float(0)
var int[]   gfIdx   = array.new_int(0)
var int[]   kcIdx   = array.new_int(0)            // global indices of KCs (projection order)
var int[]   mbonOf  = array.new_int(N_NEUR, -1)   // global → local MBON index
var float[] valence = array.new_float(N_MBON, 0.0)
var float[] dPam    = array.new_float(N_MBON, 0.0)
var float[] dPpl    = array.new_float(N_MBON, 0.0)
var float[] normM   = array.new_float(N_MBON, 1e-9)
var float[] projP   = array.new_float(N_KC * 10, 0.0)
var int[]   kmEdges = array.new_int(0)            // all KC→MBON edges (recovery)
var int[]   actEdges = array.new_int(0)           // KC→MBON edges of KCs active on the previous bar
var float[] kcDrive = array.new_float(N_KC, 0.0)
var int[]   grpSpk  = array.new_int(11, 0)        // spikes per group this bar (brain window)
var int[]   grpSize = array.new_int(11, 0)
var float[] mbonAct = array.new_float(N_MBON, 0.0)
var int phase = 1
var int builtEdges = 0
var int E = 0
var int gstep = 0
var int cooldown = 0
var int barsReady = 0
var int parseSrc = 0
var int parseLeft = 0
var int escTotal = 0
varip int tick = 0      // ticks inside the live bar (animation)
varip int vseed = 12345
if barstate.isnew
    tick := 0
tick += 1
var int gf3Total = 0

// ── Phase 1: build the graph (spread over bars) ──────────────────────────────
if phase == 1
    if builtEdges == 0
        i = 0
        kcK = 0
        mbK = 0
        while i < N_NEUR
            g = dec1(GROUPS, i)
            array.set(grp, i, g)
            array.set(grpSize, g, array.get(grpSize, g) + 1)
            array.set(deg, i, dec2(DEGREES, i * 2))
            if g == 0
                array.push(gfIdx, i)
            if g == 5
                array.push(loomIdx, i)
                array.push(loomG, 0.5 + dec1(LOOM_GAIN, array.size(loomIdx) - 1) / 63.0)
            if g == 6
                array.push(kcIdx, i)
                kcK += 1
            if g == 7
                array.set(mbonOf, i, mbK)
                array.set(valence, mbK, str.substring(VALENCE, mbK, mbK + 1) == "+" ? 1.0 : str.substring(VALENCE, mbK, mbK + 1) == "-" ? -1.0 : 0.0)
                array.set(dPam, mbK, dec1(DAN_PAM, mbK) / 63.0)
                array.set(dPpl, mbK, dec1(DAN_PPL, mbK) / 63.0)
                mbK += 1
            i += 1
        j = 0
        while j < N_KC * 10
            part = math.floor(j / 1000)
            inner = j % 1000
            array.set(projP, j, dec1(array.get(PROJ_PARTS, part), inner) / 63.0 * 6.3 - 3.15)
            j += 1
        parseSrc := 0
        parseLeft := dec2(DEGREES, 0)
    blobE = (array.size(EDGE_PARTS) - 1) * EDGE_PART_EDGES + math.floor(str.length(array.get(EDGE_PARTS, array.size(EDGE_PARTS) - 1)) / 3)
    e = builtEdges
    stop = math.min(builtEdges + chunkIn, blobE)
    while e < stop
        while parseLeft == 0 and parseSrc < N_NEUR - 1
            parseSrc += 1
            parseLeft := dec2(DEGREES, parseSrc * 2)
        part = math.floor(e / EDGE_PART_EDGES)
        inner = (e % EDGE_PART_EDGES) * 3
        tok = str.substring(array.get(EDGE_PARTS, part), inner, inner + 3)
        d = dec2(tok, 0)
        w = (dec1(tok, 2) - 32) * W_STEP
        array.push(dstA, d)
        array.push(wA, w / wScale)
        array.push(wRaw, math.abs(w))
        array.push(mA, 1.0)
        parseLeft -= 1
        e += 1
    builtEdges := e
    if builtEdges >= blobE
        phase := 2
if phase == 2
    i = 0
    acc = 0
    while i < N_NEUR
        array.set(off, i, acc)
        acc += array.get(deg, i)
        i += 1
    array.set(off, N_NEUR, acc)
    E := acc
    k = 0
    while k < array.size(kcIdx)
        n = array.get(kcIdx, k)
        ee = array.get(off, n)
        eEnd = array.get(off, n + 1)
        while ee < eEnd
            d = array.get(dstA, ee)
            if array.get(grp, d) == 7
                array.push(kmEdges, ee)
                mj = array.get(mbonOf, d)
                array.set(normM, mj, array.get(normM, mj) + array.get(wRaw, ee))
            ee += 1
        k += 1
    phase := 3

// ── Neuron (leaky integrate-and-fire, event-driven) ──────────────────────────
touch(int i, int t) =>
    dt = t - array.get(lastT, i)
    if dt > 0
        array.set(v, i, array.get(v, i) * math.pow(decayIn, dt))
        array.set(lastT, i, t)
inject(int i, float amt, int t) =>
    touch(i, t)
    fired = false
    fa = array.get(firedAt, i)
    if fa != t
        nv = array.get(v, i) + amt
        if nv >= thIn and fa < t - 1
            array.set(v, i, 0.0)
            array.set(firedAt, i, t)
            array.push(nxt, i)
            fired := true
        else
            array.set(v, i, nv)
    fired

// ── Market quantities ────────────────────────────────────────────────────────
retBar = close / nz(close[1], close) - 1.0
vol72  = nz(ta.stdev(retBar, 72), 0.0) + 1e-6
rngRel = (high - low) / nz(close[1], close)
retK(int k) => nz(close / close[k] - 1.0, 0.0)
// intrabar sensory preview: the eyes react to the bar as it forms; trading decisions still happen on bar close
liveMove = nz(close / open - 1.0, 0.0)
liveRange = nz((high - low) / nz(close[1], close), 0.0)
liveStim = (downIn * math.max(0.0, -liveMove) + upIn * math.max(0.0, liveMove) + rngIn * math.max(0.0, liveRange)) * gainIn
// crowd sense: long/short ratio of accounts on the perpetual (one-bar lag)
perpSym = perpIn != "" ? perpIn : "BINANCE:" + syminfo.basecurrency + "USDT.P"
lsRaw = crowdIn != 0 ? req.cryptoDerivativeMetric(perpSym, "Long/Short Ratio Accounts", timeframe.period, false, true) : na
crowd = crowdIn != 0 and not na(lsRaw[1]) ? tanh(math.log(math.max(0.2, math.min(5.0, lsRaw[1])))) : 0.0

// ── Bar step ─────────────────────────────────────────────────────────────────
useReflex = modeIn == "reflexes" or modeIn == "reflexes+MB"
useMB     = modeIn == "reflexes+MB" or modeIn == "MB only"
gfSpikes = 0
mbBias   = 0.0
pamNow   = 0.0
pplNow   = 0.0
posPrev  = strategy.position_size > 0 ? 1.0 : 0.0
upnl     = strategy.position_size > 0 ? (close / strategy.position_avg_price - 1.0) : 0.0
if phase == 3 and barstate.isconfirmed
    barsReady += 1
    // 1) dopamine for the previous decision: realized P&L of this bar in volatility units
    if useMB and array.size(actEdges) > 0
        r = math.max(-3.0, math.min(3.0, posPrev * retBar / vol72))
        pamNow := math.max(0.0, r)
        pplNow := math.max(0.0, -r)
        q = 0
        na_ = array.size(actEdges)
        while q < na_
            ee = array.get(actEdges, q)
            mj = array.get(mbonOf, array.get(dstA, ee))
            dd = pamNow * array.get(dPam, mj) + pplNow * array.get(dPpl, mj)
            array.set(mA, ee, math.max(0.1, math.min(1.0, array.get(mA, ee) - etaIn * dd)))
            q += 1
        q := 0
        nk = array.size(kmEdges)
        while q < nk
            ee = array.get(kmEdges, q)
            array.set(mA, ee, array.get(mA, ee) + gammaIn * (1.0 - array.get(mA, ee)))
            q += 1
    // 2) reflex: looming current → network → GF spikes
    if useReflex
        array.fill(grpSpk, 0)
        stim = (downIn * math.max(0.0, -retBar) + upIn * math.max(0.0, retBar) + rngIn * math.max(0.0, rngRel)) * gainIn
        s = 0
        while s < stepsIn
            gstep += 1
            t = gstep
            array.clear(nxt)
            if stim > 0
                i = 0
                nl = array.size(loomIdx)
                while i < nl
                    inject(array.get(loomIdx, i), stim * array.get(loomG, i), t)
                    i += 1
            k = 0
            while k < noiseN
                inject(rndInt(N_NEUR), noiseA, t)
                k += 1
            c = 0
            nc = array.size(cur)
            while c < nc
                src = array.get(cur, c)
                ee = array.get(off, src)
                eEnd = array.get(off, src + 1)
                while ee < eEnd
                    inject(array.get(dstA, ee), array.get(wA, ee), t)
                    ee += 1
                c += 1
            array.clear(cur)
            q = 0
            nn = array.size(nxt)
            while q < nn
                id = array.get(nxt, q)
                array.push(cur, id)
                gq = array.get(grp, id)
                array.set(grpSpk, gq, array.get(grpSpk, gq) + 1)
                if gq == 0
                    gfSpikes += 1
                q += 1
            s += 1
        if gfSpikes >= gfMinIn
            gf3Total += 1
            if cooldown == 0
                escTotal += 1
            cooldown := cdIn
    // 3) mushroom body: features → KC code → MBON → bias
    if useMB
        f0 = tanh(retK(1) / vol72 / 3.0)
        f1 = tanh(retK(4) / vol72 / 3.0)
        f2 = tanh(retK(12) / vol72 / 3.0)
        f3 = tanh(retK(24) / vol72 / 3.0)
        f4 = tanh(retK(72) / vol72 / 3.0)
        f5 = tanh(rngRel / vol72 / 3.0)
        f6 = posPrev
        f7 = tanh(upnl / vol72 / 3.0)
        f8 = 1.0
        f9 = tanh(retK(1) / vol72)
        k = 0
        while k < N_KC
            b = k * 10
            array.set(kcDrive, k, f0 * array.get(projP, b) + f1 * array.get(projP, b + 1) + f2 * array.get(projP, b + 2) + f3 * array.get(projP, b + 3) + f4 * array.get(projP, b + 4) + f5 * array.get(projP, b + 5) + f6 * array.get(projP, b + 6) + f7 * array.get(projP, b + 7) + f8 * array.get(projP, b + 8) + f9 * array.get(projP, b + 9))
            k += 1
        tmp = array.copy(kcDrive)
        array.sort(tmp, order.descending)
        kAct = math.max(1, math.round(0.05 * N_KC))
        thr = array.get(tmp, kAct - 1)
        array.fill(mbonAct, 0.0)
        array.clear(actEdges)
        k := 0
        while k < N_KC
            if array.get(kcDrive, k) >= thr
                n = array.get(kcIdx, k)
                ee = array.get(off, n)
                eEnd = array.get(off, n + 1)
                while ee < eEnd
                    d = array.get(dstA, ee)
                    if array.get(grp, d) == 7
                        mj = array.get(mbonOf, d)
                        array.set(mbonAct, mj, array.get(mbonAct, mj) + array.get(wRaw, ee) * array.get(mA, ee) / array.get(normM, mj))
                        array.push(actEdges, ee)
                    ee += 1
            k += 1
        num = 0.0
        den = 0.0
        j = 0
        while j < N_MBON
            num += array.get(valence, j) * array.get(mbonAct, j)
            den += math.abs(array.get(valence, j))
            j += 1
        mbBias := num / math.max(1.0, den) - crowdIn * 0.003 * crowd
    cooldown := math.max(0, cooldown - 1)

// ── Decision and orders ──────────────────────────────────────────────────────
biasSer = phase == 3 ? mbBias : na
zBias = (biasSer - ta.sma(biasSer, zWinIn)) / (ta.stdev(biasSer, zWinIn) + 1e-9)
var bool mbLong = true
if useMB and barsReady > 50 and not na(zBias) and barstate.isconfirmed
    // hysteresis: enter when z > zEnter, exit when z < zExit (fewer flips; layer 2)
    mbLong := mbLong ? zBias >= zExit : zBias > zEnter
wantLong = true
if useMB
    wantLong := barsReady > 50 ? mbLong : true
if useReflex and cooldown > 0
    wantLong := false
if phase == 3 and barstate.isconfirmed
    if wantLong and strategy.position_size == 0
        strategy.entry("L", strategy.long, comment = "in")
    if not wantLong and strategy.position_size > 0
        strategy.close("L", comment = cooldown > 0 ? "escape" : "out")

// ── Panel plots ──────────────────────────────────────────────────────────────
plot(math.min(4.0, gfSpikes / gfMinIn), "DNp01 (Giant Fiber) spikes, in threshold units", color.new(color.red, 0), style = plot.style_columns)
hline(1, "escape threshold", color.new(color.red, 60), hline.style_dotted)
plot(zBias, "MB bias (z)", color.new(color.yellow, 0), linewidth = 2)
plot(pamNow, "dopamine PAM (reward)", color.new(color.green, 30), style = plot.style_histogram)
plot(-pplNow, "dopamine PPL1 (punishment)", color.new(color.orange, 30), style = plot.style_histogram)
bgcolor(phase < 3 ? color.new(color.gray, 85) : cooldown > 0 ? color.new(color.red, 80) : strategy.position_size > 0 ? color.new(color.green, 92) : na)

// ── FlyTV avatar: one fly, see-through head; the circuits that fire light up in brain and body ──
// Two RLE pixel layers generated by tools/design/gen_avatar.py: AV_STATIC (body art) and AV_DYN (live circuits).
// A pulse travels head → neck → wings so activity reads as a wave, not noise.
//__AVATAR__
AV_W = 88
AV_H = 84
AV_STATIC = array.from("0U62e271610I61e2620T", "0S62e26272620E627261e2620R", "0R61e2620261736B026173610162e2610Q", "0S620463724A62726204620R", "0V6344724A7242630V", "0T6247517251477246620T", "0R62435G4B620R", "0N6442537A594A640N", "0K68517G5847680K", "0J64b5637G574363b5640J", "0I63b9627986745562b9630I", "0H63b7a3b16275829882725362b1a3b7630H", "0G63b7a5b16272829C827262b1a5b7630G", "0G62b8a5b272819G8172b2a5b8620G", "0F62b9a5b172819I8172b1a5b9620F", "0F62bAa3b271819K8171b2a3bA620F", "0E63bE71829K8271bE630E", "0E62bF71819M8171bF620E", "0E62bE72819M8172bE620E", "0E62bE71829M8271bE620E", "0E62bE71829M8271bE620E", "0E62bE72819M8172bE620E", "0E63bD72819M8172bD630E", "0F62b4e1b971819M8171b9e1b4620F", "0F62b3e3b872819K8172b8e3b3620F", "0G62b2e3b971829I8271b9e3b2620G", "0G63bD6171829G827161bD630G", "0H63bB625171829E82714162bB630H", "0I63b9624372829A82724362b9630I", "0J64b56247728A724762b5640J", "0L674B7A4B670L", "0N624c620N", "0P624Y620P", "0R614W610R", "0S624S620S", "0U634M630U", "0X634G630X", "0a624C630Z", "0Z61e1614C62e1610Y", "0Z62e25546e2610Z", "0W61016154e15742e1436102610V", "0V61e1615278554562e1610U", "0V6151e27A5544e2610V", "0S6101615371e17A5542e1436102610R", "0R61e161547C564662e1610Q", "0S61e2537C5646e2610R", "0S614151e1527C5645e141610S", "0S6141557A5747610S", "0S614158745A47610S", "0S61425K48610S", "0S61435I49610S", "0S61445G4A610S", "0T61445E4A610T", "0T6147554G610T", "0U6149524F610U", "0V6145584Bc1610U", "0U61c2d14152765447d2c2610T", "0T61c2d1c1d12Id2c1d1c2610S", "0S61c2d1c1d12Kc1d1c1d1c2610R", "0R61c2d1c1d1517C5346c1d1c1d1c2610Q", "0Q61c2d1c1d12Oc1d1c1d1c2610P", "0Q61c1d1c2d11Oc1d1c2d1c1610P", "0O62c2d1c1d1527E5446c1d1c1d1c2620N", "0N61c3d1c1d1c12Qd1c1d1c1d1c3610M", "0M61c3d1c1d1c22Qd1c2d1c1d1c3610L", "0M61c2d1c2d1c141537C5547d1c1d1c2d1c2610L", "0L61c2d1c2d1c1d12Sc1d1c1d1c2d1c2610K", "0K61c3d1c1d1c2d11Sc1d1c2d1c1d1c3610J", "0J61c3d1c1d1c2d1c1415K47c2d1c2d1c1d1c3610I", "0Pd1c1d1c22Sc3d1c1d1c2d1c2610I", "02a902a303a501c1d1c32S61c3d1c1d1c2d1c2610H", "02a901a501a502c1d1c261425I4862c2d1c2d1c1d1c3610G", "02a901a501a501662S61016C0G", "02a901a501a501c1d1c26101611Q610261c2d1c2d1c1d1c3610F", "06a502a301a502d1c3610161435E49610261c3d1c1d1c2d1c2610F", "06a506a501d1c26202612Q610362c2d1c1d1c1d1c2610F", "06a505a502c26105612O610661c2d1c1d1c1d1c2610E", "06a505a501c261066147544D610761c2d1c1d2c3610D", "06a504a502c16108612M610961c2d2c1d1c1610E", "06a504a5016209611M610A62c1d3c1610E", "06a504a50D614K610D650F", "0Y612I610Y", "0Z612G610Z", "0a624C620a")
AV_DYN = array.from("0XN20KN20V", "0YN20IN20W", "0ZN30EN30X", "0bN20CN20Z", "0cN20AN20a", "0dN208N20b", "0.0P", "0.0P", "0.0P", "0.0P", "0ME70UE70M", "0LE90SE90L", "0KEB0QEB0K", "0JED04Q102K304K302Q104ED0J", "0IEF03Q101K502K501Q103EF0I", "0IEF02L1Q1L1K502K5L1Q1L102EF0I", "0IEF01L2Q1L1K404K4L1Q1L201EF0I", "0HEGL3Q1L201K205K2L2Q1L3EG0H", "0HEGL3Q1L3K205K2L2Q1L3EG0H", "0HEGL7K205K2L6EG0H", "0HEGL701K203K2L7EG0H", "0HEGL701K203K2L7EG0H", "0IEFL7C8L7EF0I", "0IEF01L5CAL501EF0I", "0JED02L4P1CA01P1L302ED0J", "0JED06P102C2G2C203P105ED0J", "0KEB07P104G205P106EB0K", "0LE908P104G205P107E90L", "01X90DE50AP104G205P109E50EX9", "01XC0PP104G205P10PXC", "03XD0MP104G205P10MXD02", "04XE0KP104G205P10KXE03", "06XB130IP104G205P10IX113XA05", "08X713X1130GP104G205P10GX113X113X607", "03M205X214X5130JG20KX113X514X106M201", "0A13XA12X10HG20IX212XA1308", "081303XA13X10FG20GX213X9041306", "061307XA13X10DG20EX213X9081304", "0JX9130CG20DX113X80I", "0LX912X10AG20BX212X80K", "0NX813X108G209X213X70M", "0QX6011307G20913X60P", "0SX4031204G8041201X50R", "0bG506G504X10U", "0XG50EG50V", "0E250BG40MG40B250C", "05M2052303280c28032305M203", "0B220C280O280C2209", "092306XB03250G2501XC072307", "082201XH0XXH022206", "04X322XC0lXD22X203", "X523X60NW309W30NX723X3", "04220TW509W50U2202", "02230UW509W50V23", "01220VW50BW50W21", "0WW332W20BW332W20V", "0VW134W205A206W3340U", "0V32W502A803W6320T", "0S34W501AC02W6340Q", "07M20I32W8AE01W9320IM205", "0O34W8A506A501W9340M", "0N3202W9A30AA301W903320L", "0K3402W9A30CA301W903340I", "0J3204W901A20EA202W905320H", "0I3204W901A30EA302W905320G", "0H3205W901A20GA202W906320F", "0G3205W902A20GA203W906320E", "0F3205W903A20GA204W906320D", "0E3205W904A20GA205W906320C", "0PW603A20GA204WB06320B", "0PW405A20GA206W907320A", "0PW306A30EA307W9073209", "0YA30EA30O3208", "0OW307A40CA408W9083207", "0OW307A40CA408W9093206", "0NW309A40AA40AW90G", "0NW20AA606A60BW90F", "0MW20CAG0DW90E", "0MW10EAE0FW70F", "0cAC0IW50F", "0dAA0d", "0fA60f", "0.0P", "0.0P")
avPal(string ch) => ch == "1" ? #141821 : ch == "2" ? #1B1F29 : ch == "3" ? #232834 : ch == "4" ? #2C3340 : ch == "5" ? #39414F : ch == "6" ? #495265 : ch == "7" ? #6A7285 : ch == "8" ? #0C0F15 : ch == "9" ? #171D29 : ch == "a" ? #D1D4DC : ch == "b" ? #3A1418 : ch == "c" ? #44648A : ch == "d" ? #9CC4E4 : ch == "e" ? #8892A4 : #0B0E14
//__END_AVATAR__
actOf(int g) => array.get(grpSize, g) > 0 ? array.get(grpSpk, g) / (array.get(grpSize, g) * stepsIn) : 0.0
avDim(string ch) => ch == "E" ? #8E2026 : ch == "L" ? #1B6C80 : ch == "K" ? #8A6B12 : ch == "C" ? #21398C : ch == "G" ? #7A1A20 : ch == "P" ? #106B4C : ch == "Q" ? #7A2080 : ch == "N" ? #6B5AA0 : ch == "A" ? #10402F : #8A5A16
avBright(string ch) => ch == "E" ? #FF4757 : ch == "L" ? #4DD0E1 : ch == "K" ? #FFD54F : ch == "C" ? #2962FF : ch == "G" ? #FF5252 : ch == "P" ? #19D49B : ch == "Q" ? #E040FB : ch == "N" ? #B388FF : ch == "A" ? #19D49B : #FFA726
expandRLE(string enc) =>
    out = ""
    i = 0
    n = str.length(enc)
    while i < n
        ch = str.substring(enc, i, i + 1)
        cnt = nz(str.pos(ALPHA, str.substring(enc, i + 1, i + 2)), 0)
        out := out + str.repeat(ch, cnt)
        i += 2
    out
spark(float[] h) =>
    s = ""
    i = 0
    while i < array.size(h)
        sv = array.get(h, i)
        k = math.min(7, math.max(0, math.round(sv * 7)))
        s := s + (k == 0 ? "▁" : k == 1 ? "▂" : k == 2 ? "▃" : k == 3 ? "▄" : k == 4 ? "▅" : k == 5 ? "▆" : k == 6 ? "▇" : "█")
        i += 1
    s
CELL_W = cellWIn
CELL_H = cellHIn
PAD = 1
ROW_TITLE = 0
ROW_SUB1 = 1
ROW_SUB2 = 2
ROW_PADT = 3
ROW_AV = ROW_PADT + PAD
ROW_CAP = ROW_AV + AV_H
NCALL = 6                      // five readout rows plus one empty row as the gap before the footer
ROW_HEAD = ROW_CAP + 1
ROW_CALL = ROW_HEAD + 1
ROW_SESSION = ROW_CALL + NCALL
ROW_BRAND = ROW_SESSION + 1
ROW_PADB = ROW_BRAND + 1
N_ROWS = ROW_PADB + PAD
var table av = na
padR(string s, int n) => s + str.repeat(" ", math.max(0, n - str.length(s)))
padL(string s, int n) => str.repeat(" ", math.max(0, n - str.length(s))) + s
// One merged cell per row. Splitting a row into column groups would let the longest
// string stretch only those columns, and the fly's pixel grid is those same columns.
avLine(string label, string circuit, string value, string note) =>
    "  " + padR(label, 11) + padR(circuit, 21) + padL(value, 13) + "  " + note
avRow(int i, string label, string circuit, string value, string note, color cl) =>
    table.cell(av, 0, ROW_CALL + i, avLine(label, circuit, value, note), text_color = cl, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)

var int[] dynX = array.new_int(0)
var int[] dynY = array.new_int(0)
var string[] dynK = array.new_string(0)
var string[] dynBase = array.new_string(0)
var float[] loomHist = array.new_float(10, 0.0)
var float mmStart = na
var float firstClose = na
if na(firstClose) and barstate.isconfirmed
    firstClose := close
brainPos = placeIn == "top left" ? position.top_left : placeIn == "top center" ? position.top_center : placeIn == "top right" ? position.top_right : placeIn == "middle left" ? position.middle_left : placeIn == "middle right" ? position.middle_right : placeIn == "bottom left" ? position.bottom_left : placeIn == "bottom center" ? position.bottom_center : position.bottom_right
if useReflex and barstate.isconfirmed and phase == 3
    array.shift(loomHist)
    array.push(loomHist, math.min(1.0, actOf(5) * 25.0))
if showBrain and barstate.islast
    if na(av)
        av := table.new(brainPos, AV_W, N_ROWS, bgcolor = color.new(#05070A, 0), border_width = 0, frame_color = color.new(#2962FF, 88), frame_width = 1, force_overlay = true)
        table.cell(av, 0, ROW_TITLE, "THE FLY THAT TRADES", text_color = color.new(#D1D4DC, 0), text_size = size.large, text_halign = text.align_center)
        table.merge_cells(av, 0, ROW_TITLE, AV_W - 1, ROW_TITLE)
        table.cell(av, 0, ROW_SUB1, "160,000,000 synapses of a real fly brain,", text_color = color.new(#787B86, 0), text_size = size.small, text_halign = text.align_center)
        table.merge_cells(av, 0, ROW_SUB1, AV_W - 1, ROW_SUB1)
        table.cell(av, 0, ROW_SUB2, "distilled to the " + str.tostring(E) + " connections that fit inside Pine Script.", text_color = color.new(#787B86, 0), text_size = size.small, text_halign = text.align_center)
        table.merge_cells(av, 0, ROW_SUB2, AV_W - 1, ROW_SUB2)
        table.merge_cells(av, 0, ROW_CAP, AV_W - 1, ROW_CAP)
        table.merge_cells(av, 0, ROW_SESSION, AV_W - 1, ROW_SESSION)
        table.merge_cells(av, 0, ROW_BRAND, AV_W - 1, ROW_BRAND)
        // readout as a real table: four aligned columns, no grid lines
        table.merge_cells(av, 0, ROW_HEAD, AV_W - 1, ROW_HEAD)
        table.cell(av, 0, ROW_HEAD, avLine("CIRCUIT", "NEURONS", "SIGNAL", "STATE"), text_color = color.new(#5D606B, 0), text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        rr = 0
        while rr < NCALL
            table.merge_cells(av, 0, ROW_CALL + rr, AV_W - 1, ROW_CALL + rr)
            rr += 1
        pr = 0
        while pr < PAD
            table.merge_cells(av, 0, ROW_PADT + pr, AV_W - 1, ROW_PADT + pr)
            table.merge_cells(av, 0, ROW_PADB + pr, AV_W - 1, ROW_PADB + pr)
            table.cell(av, 0, ROW_PADT + pr, "", height = CELL_H)
            table.cell(av, 0, ROW_PADB + pr, "", height = CELL_H)
            pr += 1
        r = 0
        while r < AV_H
            rs = expandRLE(array.get(AV_STATIC, r))
            rd = expandRLE(array.get(AV_DYN, r))
            c = 0
            while c < AV_W
                sc = str.substring(rs, c, c + 1)
                table.cell(av, c, ROW_AV + r, "", width = CELL_W, height = CELL_H, bgcolor = sc == "0" ? color.new(#05070A, 100) : color.new(avPal(sc), 0))
                dk = str.substring(rd, c, c + 1)
                if dk != "0"
                    array.push(dynX, c)
                    array.push(dynY, r)
                    array.push(dynK, dk)
                    array.push(dynBase, sc)
                c += 1
            r += 1
    // ── live state → intensities ──
    escaping = cooldown > 0
    walking = strategy.position_size > 0 and not escaping
    liveLoom = math.min(1.0, liveStim * 0.9)
    loomLvl = math.max(liveLoom, math.min(1.0, actOf(5) * 25.0))
    eyeLvl  = math.max(loomLvl, escaping ? 1.0 : 0.12)
    kcLvl   = useMB ? math.max(0.25, math.min(1.0, math.abs(nz(zBias)) / 3.0)) : 0.1
    cxLvl   = math.max(0.15, math.min(1.0, actOf(3) * 25.0))
    gfLvl   = escaping or gfSpikes >= gfMinIn ? 1.0 : math.max(0.10, math.min(1.0, actOf(0) * 25.0))
    pamLvl  = math.min(1.0, pamNow / 1.5)
    pplLvl  = math.min(1.0, pplNow / 1.5)
    // a pulse sweeps head → abdomen; faster while escaping. On history it advances per bar, live it advances per tick.
    speed = escaping ? 5.0 : 11.0
    wave = ((tick + bar_index) % math.round(speed * 4)) / (speed * 4)
    breath = 0.55 + 0.45 * math.sin((tick + bar_index) / 5.0)
    i = 0
    nd = array.size(dynX)
    while i < nd
        k = array.get(dynK, i)
        x = array.get(dynX, i)
        y = array.get(dynY, i)
        col = color.new(avPal(array.get(dynBase, i)), array.get(dynBase, i) == "0" ? 100 : 0)
        if k == "W"
            // blend, never replace: a flat overlay here wipes out the wing art underneath
            col := escaping ? col : color.from_gradient(0.14 + 0.18 * breath, 0.0, 1.0, col, #CFE6FF)
        else if k == "X"
            col := escaping ? color.new(#FFB74D, 25 + math.round(20 * (1 - breath))) : col
        else if k == "M"
            col := escaping ? color.new(#FFB74D, math.round(60 * (1 - breath))) : col
        else if k == "1" or k == "2" or k == "3"
            step = walking and ((k == "1" or k == "3") == (tick % 2 == 0))
            col := step ? color.new(#FFA726, 0) : color.new(#B26A18, 12)
        else
            lv = k == "E" ? eyeLvl : k == "L" ? loomLvl : k == "K" ? kcLvl : k == "C" ? cxLvl : k == "G" ? gfLvl : k == "P" ? pamLvl : k == "Q" ? pplLvl : k == "A" ? math.max(pamLvl, pplLvl) : k == "N" ? (crowdIn != 0 and crowd > 0.2 ? 1.0 : 0.2) : 0.2
            ph = y / AV_H
            d = math.abs(ph - wave)
            pulse = d < 0.14 ? 1.0 - d / 0.14 : 0.0
            // the circuit is always drawn in its own colour; activity and the travelling pulse only brighten it
            hot = math.min(1.0, 0.55 + 0.30 * lv + 0.15 * pulse * (0.4 + lv))
            col := k == "A" ? color.new(avBright(k), 82 - math.round(math.min(1.0, lv) * 62)) : color.new(color.from_gradient(hot, 0.0, 1.0, avDim(k), avBright(k)), 0)
        table.cell(av, x, ROW_AV + y, "", width = CELL_W, height = CELL_H, bgcolor = col)
        i += 1
    // ── caption + lab-style readout ──
    st = escaping ? 2 : strategy.position_size > 0 ? 1 : 0
    table.cell(av, 0, ROW_CAP, st == 2 ? "💨  ESCAPING — flat " + str.tostring(cooldown) + " bars" : st == 1 ? "🚶  WALKING — long" : "🧼  GROOMING — out", text_color = st == 2 ? color.new(#F23645, 0) : st == 1 ? color.new(#089981, 0) : color.new(#D1D4DC, 0), text_size = size.large, text_halign = text.align_center)
    dimC = color.new(#787B86, 0)
    onC  = color.new(#D1D4DC, 0)
    mm = 0.0
    q = 0
    nk = array.size(kmEdges)
    while q < nk
        mm += array.get(mA, array.get(kmEdges, q))
        q += 1
    mm := nk > 0 ? mm / nk : 1.0
    if na(mmStart)
        mmStart := mm
    loomPct = actOf(5) * 100.0
    zTxt = na(zBias) ? "—" : str.tostring(zBias, "#.##")
    avRow(0, "vision", "LC4 / LPLC2 · " + str.tostring(N_LOOM), str.tostring(math.max(loomPct, liveLoom * 100), "#.#") + " %", (liveLoom > 0.02 or loomPct > 2 ? "looming" : "quiet") + "  " + spark(loomHist), liveLoom > 0.02 or loomPct > 2 ? onC : dimC)
    avRow(1, "escape", "DNp01 giant fiber", str.tostring(gfSpikes) + " / " + str.tostring(gfMinIn) + " spikes", gfSpikes >= gfMinIn ? "FIRED — selling" : escaping ? "hiding " + str.tostring(cooldown) + " bars" : "armed", gfSpikes >= gfMinIn or escaping ? color.new(#F23645, 0) : dimC)
    avRow(2, "memory", "Kenyon → MBON", "z " + zTxt, na(zBias) ? "learning" : zBias > zEnter ? "smells good → long" : zBias < zExit ? "smells bad → out" : "undecided", not na(zBias) and math.abs(zBias) > 0.5 ? onC : dimC)
    avRow(3, "dopamine", "PAM / PPL1 dopamine", str.tostring(pamNow, "#.##") + " / " + str.tostring(pplNow, "#.##"), pamNow > 0.5 ? "trade paid off" : pplNow > 0.5 ? "that one hurt" : "—", pamNow > 0.5 ? color.new(#089981, 0) : pplNow > 0.5 ? color.new(#E040FB, 0) : dimC)
    avRow(4, "plasticity", "KC→MBON · " + str.tostring(array.size(kmEdges)), str.tostring(mm * 100, "#.#") + " %", "−" + str.tostring((1 - mm) * 100, "#.#") + " % eaten", mm < 0.995 ? onC : dimC)
    table.cell(av, 0, ROW_SESSION, "male D. melanogaster · " + str.tostring(stepsIn) + " steps/bar  ·  REAL wiring, MODELED firing  ·  not advice", text_color = color.new(#5D606B, 0), text_size = size.tiny, text_halign = text.align_center)
    table.cell(av, 0, ROW_BRAND, "TradingView  ·  MaleCNS v1.0", text_color = color.new(#2962FF, 0), text_size = size.normal, text_halign = text.align_center)
