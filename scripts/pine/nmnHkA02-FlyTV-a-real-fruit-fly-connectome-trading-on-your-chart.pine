//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © gsoloviev
//
// FlyTV — The Fly That Trades
// A real fruit-fly connectome, running live on a chart.
//
// The 160,000,000 measured synapses of an adult male Drosophila melanogaster (MaleCNS v1.0) resolve into
// connections between neurons; 17,000 of them fit inside Pine Script, and they are wired into a strategy:
//   · LC4 / LPLC2 looming detectors see a falling candle as an object rushing at the fly
//   · DNp01 (the giant fiber) fires the escape reflex → the strategy goes flat
//   · Kenyon cells → MBON form the memory; PAM / PPL1 dopamine depresses the synapses that misled her
// The panel draws one fly with a see-through head: every circuit that fires lights up in brain and body.
//
// REAL: the wiring, synapse counts, neurotransmitter signs and MBON valence come from the connectome.
// MODELED: spiking dynamics, how a candle becomes a visual stimulus, and how P&L becomes dopamine.
// This is a visualization of measured neuroscience, not a validation of fly physiology — and not financial advice.
//
// Data: MaleCNS v1.0, CC BY 4.0 — FlyEM/HHMI Janelia, University of Cambridge, MRC LMB, Google Research.
// Berg et al., doi:10.1101/2025.10.09.680999
strategy("FlyTV - a real fruit fly connectome trading on your chart", "FlyTV", overlay = false, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.02, process_orders_on_close = false, calc_on_every_tick = true, calc_bars_count = 4000)
import TradingView/Request/3 as req

// ── Inputs ───────────────────────────────────────────────────────────────────
gMode   = "Mode"
modeIn  = input.string("reflexes+MB", "Version", options = ["buy&hold", "reflexes", "reflexes+MB", "MB only"], group = gMode, display = display.none)
gBody   = "Layer 2 — body interface (the only tuned numbers)"
gainIn  = input.float(2.0, "Looming: gain", step = 0.5, group = gBody, display = display.none)
downIn  = input.float(1.0, "Looming: weight of a drop", step = 0.1, group = gBody, display = display.none)
upIn    = input.float(0.3, "Looming: weight of a rise", step = 0.1, group = gBody, display = display.none)
rngIn   = input.float(0.5, "Looming: weight of bar range", step = 0.1, group = gBody, display = display.none)
stepsIn = input.int(20, "Network steps per bar", minval = 1, maxval = 60, group = gBody, display = display.none)
gfMinIn = input.int(3, "GF spikes to escape", minval = 1, group = gBody, display = display.none)
cdIn    = input.int(24, "Escape: bars out of market", minval = 1, group = gBody, display = display.none)
etaIn   = input.float(0.05, "MB: depression rate (eta)", step = 0.01, group = gBody, display = display.none)
gammaIn = input.float(0.002, "MB: recovery per bar (gamma)", step = 0.001, group = gBody, display = display.none)
zWinIn  = input.int(500, "MB: bias centering window (bars)", minval = 50, group = gBody, display = display.none)
crowdIn = input.float(0.0, "Crowd sense: avoidance drive (in bias std; 0 = off)", step = 0.5, group = gBody, tooltip = "Long/short ratio of accounts on the Binance perpetual (Request/3 library). Crowd long → the fly avoids. Protocol result: train 17/18, holdout 6/18 — non-stationary, hence off by default.", display = display.none)
perpIn  = input.string("", "Perp symbol for crowd sense (empty = BINANCE:<base>USDT.P)", group = gBody, display = display.none)
zEnter  = input.float(0.5, "MB: enter long when z >", step = 0.1, group = gBody, display = display.none)
zExit   = input.float(-0.5, "MB: exit when z <", step = 0.1, group = gBody, display = display.none)
gLif    = "Neuron model"
decayIn = input.float(0.90, "Potential decay per step", step = 0.01, group = gLif, display = display.none)
thIn    = input.float(1.0, "Firing threshold", step = 0.1, group = gLif, display = display.none)
wScale  = input.float(2000.0, "Synaptic contacts → current: divisor", step = 100, group = gLif, display = display.none)
noiseN  = input.int(20, "Noise injections per step", group = gLif, display = display.none)
noiseA  = input.float(0.30, "Noise amplitude", step = 0.05, group = gLif, display = display.none)
chunkIn = input.int(2000, "Build: edges parsed per bar", minval = 100, group = gLif, display = display.none)
gView   = "View"
showBrain = input.bool(true, "Brain window on the price chart (animates on the live bar)", group = gView, display = display.none)
cellWIn   = input.float(0.27, "Pixel width (% of chart width)", step = 0.02, minval = 0.05, group = gView, display = display.none)
cellHIn   = input.float(0.72, "Pixel height (% of pane height) — raise it if the fly looks flattened, lower it if stretched", step = 0.02, minval = 0.1, group = gView, display = display.none)
placeIn   = input.string("middle right", "Brain placement", options = ["top left", "top center", "top right", "middle left", "middle right", "bottom left", "bottom center", "bottom right"], group = gView, tooltip = "Middle right sits in the empty space right of the last bar — leave a right margin on the chart (drag the time axis).", display = display.none)

// ── Embedded data (written by the generator) ─────────────────────────────────
ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_."
var string[] EDGE_PARTS = array.new_string(0)   // edge = 3 chars: dst(2) w(1); edges ordered by source, degrees in DEGREES; w = (idx−32)·W_STEP
var string[] PROJ_PARTS = array.new_string(0)   // feature→KC projection: 10 chars per KC, idx → normal in [−3.15, 3.15]
//__DATA__
N_NEUR = 995
N_KC = 485
N_MBON = 97
N_LOOM = 311
EDGE_PART_EDGES = 333
