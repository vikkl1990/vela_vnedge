// =====================================================================================================================
//  Market Structure & Momentum [India Chart School]
//  -------------------------------------------------------------------------------------------------------------------
//  An original market-structure engine (BOS / CHoCH / order blocks / fair value gaps / equal highs & lows) combined
//  with an NSE session engine on IST clock time, overnight-gap tracking, and a momentum panel (RSI, MACD, EMA 5/20/50)
//  read on the chart timeframe. The momentum readings exist to gate structure breaks, not to generate signals of
//  their own: a break that disagrees with the higher timeframe, the EMA stack and MACD is a weaker break than one
//  that agrees with all three, and the dashboard makes that visible as a count.
//
//  CREDITS
//  The visual language of modern market-structure indicators on TradingView was popularised by LuxAlgo's open-source
//  "Smart Money Concepts" publication, which served as the reference for how this class of tool is presented on a
//  chart. No code from that script is reused here. The structure engine in this script is written from scratch on
//  TradingView's built-in ta.pivothigh() / ta.pivotlow() primitives, and the order-block definition used below
//  (last opposing candle before the displacement leg) differs from that publication's approach.
//
//  This script is licensed under the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//  © indiachartschool
//
//  NOTE ON DATA HONESTY
//  - Only one request.security() call exists (higher-timeframe bias). It is offset by one bar and uses lookahead_off,
//    so it does not repaint. RSI, MACD, EMAs, FVGs and VWAP are all computed on the chart timeframe directly.
//  - Structure pivots are confirmed pivots. A swing is only recognised after `Swing Length` bars have closed beyond
//    it. This is an inherent lag, not a bug.
//  - VWAP requires volume. On symbols without it, such as spot indices, the dashboard reports "no volume" rather
//    than printing a misleading number.
// =====================================================================================================================

//@version=6
indicator("Market Structure & Momentum [India Chart School]", "MS Momentum", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// =====================================================================================================================
//  CONSTANTS
// =====================================================================================================================
const string IST            = "Asia/Kolkata"
const int    MKT_OPEN_MIN   = 555      // 09:15 IST in minutes from midnight
const int    MKT_CLOSE_MIN  = 930      // 15:30 IST
const int    PREOPEN_MIN    = 540      // 09:00 IST

const int    BULL           = 1
const int    BEAR           = -1

const string G_STRUCT       = "1 - Market Structure"
const string G_ZONES        = "2 - Order Blocks & Fair Value Gaps"
const string G_EQ           = "3 - Equal Highs / Lows"
const string G_SESSION      = "4 - NSE Session Engine (IST)"
const string G_GAP          = "5 - Overnight Gap"
const string G_MOM          = "6 - Momentum Panel (chart timeframe)"
const string G_DASH         = "7 - Dashboard"

// =====================================================================================================================
//  INPUTS
// =====================================================================================================================
// --- 1 - Structure -----------------------------------------------------------------------------------------------------
swingLenIn      = input.int(10,   "Swing Length",            group = G_STRUCT, minval = 3, maxval = 50,
     tooltip = "Bars either side of a pivot required to confirm a major swing. Higher = fewer, more significant swings.")
intLenIn        = input.int(5,    "Internal Length",         group = G_STRUCT, minval = 2, maxval = 20,
     tooltip = "Same idea, but for minor structure inside the major swings. Must be lower than Swing Length.")
showSwingStruct = input.bool(true,  "Show Swing BOS / CHoCH",    group = G_STRUCT)
showIntStruct   = input.bool(true,  "Show Internal BOS / CHoCH", group = G_STRUCT)
showPoints      = input.bool(false, "Label Swing Points (HH/HL/LH/LL)", group = G_STRUCT)
maxStructDraw   = input.int(12,   "Max Structure Lines Kept", group = G_STRUCT, minval = 2, maxval = 60)
htfBiasTf       = input.timeframe("60", "Higher Timeframe for Bias", group = G_STRUCT,
     tooltip = "Requested with lookahead_off and a one-bar offset, so it does not repaint.")
htfEmaLen       = input.int(50,   "HTF EMA Length",          group = G_STRUCT, minval = 5)
colBull         = input.color(#089981, "Bullish", group = G_STRUCT, inline = "sc")
colBear         = input.color(#f23645, "Bearish", group = G_STRUCT, inline = "sc")
colAccent       = input.color(#ff9800, "Accent",  group = G_STRUCT, inline = "sc")

// --- 2 - Zones ---------------------------------------------------------------------------------------------------------
showOB          = input.bool(true, "Show Order Blocks",       group = G_ZONES)
maxOB           = input.int(5,     "Max Order Blocks",        group = G_ZONES, minval = 1, maxval = 20)
obMitigation    = input.string("Wick", "Order Block Invalidated By", group = G_ZONES, options = ["Wick", "Close"],
     tooltip = "Wick = the zone dies the moment price trades through it. Close = it survives a wick and dies on a close beyond it.")
obSearchDepth   = input.int(60,    "Order Block Search Depth (bars)", group = G_ZONES, minval = 10, maxval = 120,
     tooltip = "How far back from the break to look for the last opposing candle that forms the order block.")
showFVG         = input.bool(true, "Show Fair Value Gaps",    group = G_ZONES)
maxFVG          = input.int(5,     "Max Fair Value Gaps",     group = G_ZONES, minval = 1, maxval = 20)
fvgMinAtr       = input.float(0.25, "Min FVG Size (x ATR)",   group = G_ZONES, minval = 0.0, step = 0.05,
     tooltip = "Filters out trivial gaps. 0 disables the filter.")
colOBBull       = input.color(color.new(#089981, 82), "Bullish Zone", group = G_ZONES, inline = "zc")
colOBBear       = input.color(color.new(#f23645, 82), "Bearish Zone", group = G_ZONES, inline = "zc")

// --- 3 - Equal highs / lows ---------------------------------------------------------------------------------------------
showEq          = input.bool(true,  "Show Equal Highs / Lows", group = G_EQ)
eqThresh        = input.float(0.10, "Tolerance (x ATR)",       group = G_EQ, minval = 0.01, maxval = 1.0, step = 0.01)
maxEqDraw       = input.int(6,      "Max Equal Levels Kept",   group = G_EQ, minval = 1, maxval = 20)

// --- 4 - Sessions -------------------------------------------------------------------------------------------------------
showSessions    = input.bool(true,  "Tint NSE Sessions",       group = G_SESSION,
     tooltip = "Intraday charts only. All boundaries are IST clock times, not exchange session strings.")
showPreOpen     = input.bool(true,  "Include 09:00-09:15 Pre-Open", group = G_SESSION,
     tooltip = "Pre-open data is not available for every symbol. Where it is missing, nothing is drawn.")
showORB         = input.bool(true,  "Plot Opening Range",      group = G_SESSION, inline = "orb")
orbMinutes      = input.int(15,     "min",                     group = G_SESSION, inline = "orb", minval = 5, maxval = 120)
colOpenDrive    = input.color(color.new(#2962ff, 92), "Opening Drive 09:15-09:45", group = G_SESSION)
colMorning      = input.color(color.new(#089981, 94), "Morning Trend 09:45-11:30", group = G_SESSION)
colLunch        = input.color(color.new(#787b86, 93), "Lunch Drift 11:30-13:30",   group = G_SESSION)
colAfternoon    = input.color(color.new(#089981, 96), "Afternoon 13:30-14:30",     group = G_SESSION)
colPowerHour    = input.color(color.new(#ff9800, 92), "Power Hour 14:30-15:30",    group = G_SESSION)

// --- 5 - Overnight gap ---------------------------------------------------------------------------------------------------
showGap         = input.bool(true,  "Show Overnight Gap Zone", group = G_GAP)
maxGapDraw      = input.int(3,      "Max Gap Zones Kept",  group = G_GAP, minval = 1, maxval = 10)
colGapUnfilled  = input.color(color.new(#ff9800, 80), "Unfilled Gap", group = G_GAP, inline = "gc")
colGapFilled    = input.color(color.new(#787b86, 90), "Filled Gap",   group = G_GAP, inline = "gc")

// --- 6 - Momentum panel --------------------------------------------------------------------------------------------------
rsiLen          = input.int(14,  "RSI Length",        group = G_MOM, minval = 2)
rsiOB           = input.int(70,  "RSI Overbought",    group = G_MOM, minval = 50, maxval = 95, inline = "rl")
rsiOS           = input.int(30,  "RSI Oversold",      group = G_MOM, minval = 5,  maxval = 50, inline = "rl")
macdFast        = input.int(12,  "MACD Fast",         group = G_MOM, minval = 2, inline = "mm")
macdSlow        = input.int(26,  "MACD Slow",         group = G_MOM, minval = 3, inline = "mm")
macdSig         = input.int(9,   "MACD Signal",       group = G_MOM, minval = 1, inline = "mm")
emaLen1         = input.int(5,   "EMA 1",             group = G_MOM, minval = 1, inline = "ee")
emaLen2         = input.int(20,  "EMA 2",             group = G_MOM, minval = 1, inline = "ee")
emaLen3         = input.int(50,  "EMA 3",             group = G_MOM, minval = 1, inline = "ee")
plotEmas        = input.bool(false, "Plot EMAs on Chart", group = G_MOM)

// --- 7 - Dashboard -------------------------------------------------------------------------------------------------------
showDash        = input.bool(true,  "Show Dashboard",      group = G_DASH)
dashPos         = input.string("Top Right", "Position",    group = G_DASH,
     options = ["Top Right", "Middle Right", "Bottom Right", "Top Left", "Bottom Left"])
dashSize        = input.string("Small", "Text Size",       group = G_DASH, options = ["Tiny", "Small", "Normal"])
dashBg          = input.color(color.new(#131722, 10), "Background", group = G_DASH, inline = "dc")
dashText        = input.color(#d1d4dc, "Text",             group = G_DASH, inline = "dc")

// =====================================================================================================================
//  TYPES
// =====================================================================================================================
type Piv
    float price = na
    float prev  = na
    int   t     = na
    int   bidx  = na
    bool  used  = false

type Zone
    float top  = na
    float bot  = na
    int   t1   = na
    int   bias = 0
    box   bx   = na

// =====================================================================================================================
//  STATE
// =====================================================================================================================
var Piv swHigh = Piv.new()
var Piv swLow  = Piv.new()
var Piv inHigh = Piv.new()
var Piv inLow  = Piv.new()

var int swTrend = 0
var int inTrend = 0

var array<Zone>  obZones    = array.new<Zone>()
var array<Zone>  fvgZones   = array.new<Zone>()
var array<line>  structLn   = array.new<line>()
var array<label> structLb   = array.new<label>()
var array<line>  eqLn       = array.new<line>()
var array<label> eqLb       = array.new<label>()
var array<box>   gapBoxes   = array.new<box>()

var string lastEvent     = "none yet"
var color  lastEventCol  = color.gray

bool aBullBOS   = false
bool aBearBOS   = false
bool aBullCHoCH = false
bool aBearCHoCH = false
bool aGapFill   = false

atrVal = ta.atr(200)

// =====================================================================================================================
//  MOMENTUM PANEL — all on the chart timeframe, no requests, nothing repaints
// =====================================================================================================================
rsiVal = ta.rsi(close, rsiLen)
[macdLine, macdSignalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
macdBull = macdLine > macdSignalLine

ema1 = ta.ema(close, emaLen1)
ema2 = ta.ema(close, emaLen2)
ema3 = ta.ema(close, emaLen3)

emaAllBull = close > ema1 and close > ema2 and close > ema3
emaAllBear = close < ema1 and close < ema2 and close < ema3

plot(plotEmas ? ema1 : na, "EMA 1", color.new(#2962ff, 20), 1)
plot(plotEmas ? ema2 : na, "EMA 2", color.new(#ff9800, 20), 1)
plot(plotEmas ? ema3 : na, "EMA 3", color.new(#787b86, 20), 2)

// =====================================================================================================================
//  TIME AND SESSIONS
// =====================================================================================================================
istHour   = hour(time, IST)
istMin    = minute(time, IST)
minOfDay  = istHour * 60 + istMin

isIntra   = timeframe.isintraday
inMarket  = isIntra and minOfDay >= MKT_OPEN_MIN and minOfDay < MKT_CLOSE_MIN

sPreOpen  = isIntra and minOfDay >= PREOPEN_MIN   and minOfDay < MKT_OPEN_MIN
sDrive    = isIntra and minOfDay >= MKT_OPEN_MIN  and minOfDay < 585
sMorning  = isIntra and minOfDay >= 585           and minOfDay < 690
sLunch    = isIntra and minOfDay >= 690           and minOfDay < 810
sAfternoon= isIntra and minOfDay >= 810           and minOfDay < 870
sPower    = isIntra and minOfDay >= 870           and minOfDay < MKT_CLOSE_MIN

sessionName = sPreOpen ? "Pre-Open" : sDrive ? "Opening Drive" : sMorning ? "Morning Trend" :
     sLunch ? "Lunch Drift" : sAfternoon ? "Afternoon" : sPower ? "Power Hour" :
     isIntra ? "Closed" : "n/a (HTF)"

// Lunch drift is the one session where structure breaks are routinely noise.
highConvictionSession = not isIntra or (inMarket and not sLunch)

isNewDay = ta.change(time("D")) != 0

// =====================================================================================================================
//  OPENING RANGE
// =====================================================================================================================
inORB = isIntra and minOfDay >= MKT_OPEN_MIN and minOfDay < MKT_OPEN_MIN + orbMinutes

var float orbHigh = na
var float orbLow  = na
if isNewDay
    orbHigh := na
    orbLow  := na
if inORB
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow,  low)

plot(showORB and isIntra and inMarket ? orbHigh : na, "Opening Range High", colBull, 1, plot.style_linebr)
plot(showORB and isIntra and inMarket ? orbLow  : na, "Opening Range Low",  colBear, 1, plot.style_linebr)

// =====================================================================================================================
//  ANCHORED VWAP (computed manually so it never errors on non-intraday charts)
// =====================================================================================================================
var float cumPV = 0.0
var float cumVol = 0.0
if isNewDay
    cumPV  := 0.0
    cumVol := 0.0
cumPV  += hlc3 * nz(volume)
cumVol += nz(volume)
vwapVal = cumVol > 0 ? cumPV / cumVol : na

// =====================================================================================================================
//  OVERNIGHT GAP
// =====================================================================================================================
var float gapFrom   = na
var float gapTo     = na
var bool  gapFilled = true
var int   gapT1     = na
var box   gapBox    = na

if isNewDay
    float prevClose = nz(close[1], open)
    gapFrom   := prevClose
    gapTo     := open
    gapT1     := time
    gapFilled := math.abs(open - prevClose) / prevClose * 100.0 < 0.03
    if showGap and not gapFilled
        gapBox := box.new(gapT1, math.max(gapFrom, gapTo), time, math.min(gapFrom, gapTo), xloc = xloc.bar_time,
             border_color = color.new(colGapUnfilled, 40), bgcolor = colGapUnfilled,
             text = "GAP", text_size = size.tiny, text_color = dashText, text_halign = text.align_left)
        gapBoxes.push(gapBox)
        if gapBoxes.size() > maxGapDraw
            box.delete(gapBoxes.shift())

if not gapFilled and not na(gapFrom)
    bool wasUp = gapTo > gapFrom
    if (wasUp and low <= gapFrom) or (not wasUp and high >= gapFrom)
        gapFilled := true
        aGapFill  := true
        if not na(gapBox)
            gapBox.set_bgcolor(colGapFilled)
            gapBox.set_border_color(color.new(colGapFilled, 40))
    else if not na(gapBox)
        gapBox.set_right(time)

gapPct   = na(gapFrom) or gapFrom == 0 ? na : (gapTo - gapFrom) / gapFrom * 100.0
gapState = na(gapPct) ? "n/a" : gapFilled ? str.format("{0,number,#.##}% filled", gapPct) :
     str.format("{0,number,#.##}% open", gapPct)

// =====================================================================================================================
//  HIGHER TIMEFRAME BIAS
// =====================================================================================================================
[htfC, htfE] = request.security(syminfo.tickerid, htfBiasTf, [close[1], ta.ema(close, htfEmaLen)[1]],
     lookahead = barmerge.lookahead_off)
htfBias = na(htfC) or na(htfE) ? 0 : htfC > htfE ? BULL : BEAR

// =====================================================================================================================
//  DRAWING HELPERS
// =====================================================================================================================
drawStructure(int t1, float price, string tag, color col, bool internal) =>
    line ln = line.new(t1, price, time, price, xloc = xloc.bar_time, color = col,
         style = internal ? line.style_dashed : line.style_solid, width = internal ? 1 : 2)
    label lb = label.new(int(math.avg(t1, time)), price, tag, xloc = xloc.bar_time, color = color(na),
         textcolor = col, style = label.style_label_down, size = internal ? size.tiny : size.small)
    structLn.push(ln)
    structLb.push(lb)
    if structLn.size() > maxStructDraw
        line.delete(structLn.shift())
        label.delete(structLb.shift())

drawEqual(int t1, float p1, int t2, float p2, bool isHigh) =>
    color col = isHigh ? colBear : colBull
    line ln = line.new(t1, p1, t2, p2, xloc = xloc.bar_time, color = col, style = line.style_dotted)
    label lb = label.new(t2, p2, isHigh ? "EQH" : "EQL", xloc = xloc.bar_time, color = color(na), textcolor = col,
         style = isHigh ? label.style_label_down : label.style_label_up, size = size.tiny)
    eqLn.push(ln)
    eqLb.push(lb)
    if eqLn.size() > maxEqDraw
        line.delete(eqLn.shift())
        label.delete(eqLb.shift())

drawPoint(int t1, float price, string tag, color col, bool isHigh) =>
    label.new(t1, price, tag, xloc = xloc.bar_time, color = color(na), textcolor = col,
         style = isHigh ? label.style_label_down : label.style_label_up, size = size.tiny)

updatePiv(Piv p, float newPrice, int off) =>
    p.prev  := p.price
    p.price := newPrice
    p.t     := time[off]
    p.bidx  := bar_index - off
    p.used  := false

// Our order-block definition: walk back from the breakout bar to the origin pivot and take the most recent
// candle that closed against the direction of the break. That candle's full range is the zone.
findOpposingCandle(int maxBack, bool bull) =>
    int found = na
    int lim = int(math.max(1, math.min(maxBack, obSearchDepth)))
    for i = 0 to lim
        bool opposing = bull ? close[i] < open[i] : close[i] > open[i]
        if opposing
            found := i
            break
    found

addZone(array<Zone> store, float top, float bot, int t1, int bias, int maxKeep, color fill) =>
    box bx = box.new(t1, top, time, bot, xloc = xloc.bar_time,
         border_color = color.new(fill, 40), border_width = 1, bgcolor = fill)
    Zone z = Zone.new(top, bot, t1, bias, bx)
    store.unshift(z)
    if store.size() > maxKeep
        Zone old = store.pop()
        box.delete(old.bx)

// =====================================================================================================================
//  STRUCTURE ENGINE
// =====================================================================================================================
phS = ta.pivothigh(high, swingLenIn, swingLenIn)
plS = ta.pivotlow(low,  swingLenIn, swingLenIn)
phI = ta.pivothigh(high, intLenIn,   intLenIn)
plI = ta.pivotlow(low,  intLenIn,    intLenIn)

if not na(phS)
    if showEq and not na(swHigh.price) and math.abs(phS - swHigh.price) <= eqThresh * atrVal
        drawEqual(swHigh.t, swHigh.price, time[swingLenIn], phS, true)
    updatePiv(swHigh, phS, swingLenIn)
    if showPoints
        drawPoint(swHigh.t, swHigh.price, na(swHigh.prev) or swHigh.price > swHigh.prev ? "HH" : "LH", colBear, true)

if not na(plS)
    if showEq and not na(swLow.price) and math.abs(plS - swLow.price) <= eqThresh * atrVal
        drawEqual(swLow.t, swLow.price, time[swingLenIn], plS, false)
    updatePiv(swLow, plS, swingLenIn)
    if showPoints
        drawPoint(swLow.t, swLow.price, na(swLow.prev) or swLow.price < swLow.prev ? "LL" : "HL", colBull, false)

if not na(phI)
    updatePiv(inHigh, phI, intLenIn)
if not na(plI)
    updatePiv(inLow, plI, intLenIn)

if not na(swHigh.price) and not swHigh.used and close > swHigh.price
    string tag = swTrend == BEAR ? "CHoCH" : "BOS"
    swHigh.used := true
    swTrend := BULL
    lastEvent    := "Swing Bull " + tag
    lastEventCol := colBull
    aBullCHoCH := tag == "CHoCH"
    aBullBOS   := tag == "BOS"
    if showSwingStruct
        drawStructure(swHigh.t, swHigh.price, tag, colBull, false)
    if showOB
        int off = findOpposingCandle(bar_index - nz(swHigh.bidx, bar_index), true)
        if not na(off)
            addZone(obZones, high[off], low[off], time[off], BULL, maxOB, colOBBull)

if not na(swLow.price) and not swLow.used and close < swLow.price
    string tag = swTrend == BULL ? "CHoCH" : "BOS"
    swLow.used := true
    swTrend := BEAR
    lastEvent    := "Swing Bear " + tag
    lastEventCol := colBear
    aBearCHoCH := tag == "CHoCH"
    aBearBOS   := tag == "BOS"
    if showSwingStruct
        drawStructure(swLow.t, swLow.price, tag, colBear, false)
    if showOB
        int off = findOpposingCandle(bar_index - nz(swLow.bidx, bar_index), false)
        if not na(off)
            addZone(obZones, high[off], low[off], time[off], BEAR, maxOB, colOBBear)

if not na(inHigh.price) and not inHigh.used and close > inHigh.price and inHigh.price != swHigh.price
    string tag = inTrend == BEAR ? "CHoCH" : "BOS"
    inHigh.used := true
    inTrend := BULL
    if showIntStruct
        drawStructure(inHigh.t, inHigh.price, tag, color.new(colBull, 40), true)

if not na(inLow.price) and not inLow.used and close < inLow.price and inLow.price != swLow.price
    string tag = inTrend == BULL ? "CHoCH" : "BOS"
    inLow.used := true
    inTrend := BEAR
    if showIntStruct
        drawStructure(inLow.t, inLow.price, tag, color.new(colBear, 40), true)

// =====================================================================================================================
//  FAIR VALUE GAPS (chart timeframe only)
// =====================================================================================================================
if showFVG and bar_index > 2
    float minSize = fvgMinAtr * atrVal
    bool bullFvg = low > high[2] and close[1] > high[2] and (low - high[2]) >= minSize
    bool bearFvg = high < low[2] and close[1] < low[2] and (low[2] - high) >= minSize
    if bullFvg
        addZone(fvgZones, low, high[2], time[2], BULL, maxFVG, color.new(colOBBull, 88))
    if bearFvg
        addZone(fvgZones, low[2], high, time[2], BEAR, maxFVG, color.new(colOBBear, 88))

// =====================================================================================================================
//  ZONE MAINTENANCE
// =====================================================================================================================
maintainZones(array<Zone> store) =>
    if store.size() > 0
        for i = store.size() - 1 to 0
            Zone z = store.get(i)
            float bullTest = obMitigation == "Close" ? close : low
            float bearTest = obMitigation == "Close" ? close : high
            bool dead = z.bias == BULL ? bullTest < z.bot : bearTest > z.top
            if dead
                Zone gone = store.remove(i)
                box.delete(z.bx)
            if not dead
                z.bx.set_right(time)

maintainZones(obZones)
maintainZones(fvgZones)

countAligned(array<Zone> store, int bias) =>
    int n = 0
    if store.size() > 0
        for i = 0 to store.size() - 1
            Zone z = store.get(i)
            if z.bias == bias
                n += 1
    n

obAligned  = countAligned(obZones, swTrend)
fvgAligned = countAligned(fvgZones, swTrend)

// =====================================================================================================================
//  SESSION TINT
// =====================================================================================================================
sessionTint = not showSessions or not isIntra ? na :
     sPreOpen and showPreOpen ? color.new(colLunch, 96) :
     sDrive     ? colOpenDrive :
     sMorning   ? colMorning :
     sLunch     ? colLunch :
     sAfternoon ? colAfternoon :
     sPower     ? colPowerHour : na
bgcolor(sessionTint, title = "NSE Session Tint")

// =====================================================================================================================
//  CONFLUENCE — a count of conditions met, not a probability and not a win rate
// =====================================================================================================================
confTotal = 8
confMet = 0
confMet += (swTrend != 0 and htfBias == swTrend) ? 1 : 0
confMet += (swTrend != 0 and inTrend == swTrend) ? 1 : 0
confMet += ((swTrend == BULL and emaAllBull) or (swTrend == BEAR and emaAllBear)) ? 1 : 0
confMet += ((swTrend == BULL and rsiVal > 50) or (swTrend == BEAR and rsiVal < 50)) ? 1 : 0
confMet += ((swTrend == BULL and macdBull) or (swTrend == BEAR and not macdBull)) ? 1 : 0
confMet += na(vwapVal) ? 0 : (((swTrend == BULL and close > vwapVal) or (swTrend == BEAR and close < vwapVal)) ? 1 : 0)
confMet += obAligned > 0 ? 1 : 0
confMet += highConvictionSession ? 1 : 0

// =====================================================================================================================
//  DASHBOARD — tall, two columns, label left and value right
// =====================================================================================================================
dashTextSize = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small

dashPosition = dashPos == "Top Right"    ? position.top_right    :
     dashPos == "Middle Right" ? position.middle_right :
     dashPos == "Bottom Right" ? position.bottom_right :
     dashPos == "Top Left"     ? position.top_left     : position.bottom_left

var table dash = table.new(dashPosition, 2, 17, bgcolor = dashBg, border_width = 1,
     border_color = color.new(dashText, 85), frame_width = 1, frame_color = color.new(dashText, 70))

dashRow(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(dashText, 35), text_size = dashTextSize,
         text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = dashTextSize, text_halign = text.align_right)

trendWord(int t) => t == BULL ? "Bullish" : t == BEAR ? "Bearish" : "Neutral"
trendCol(int t)  => t == BULL ? colBull   : t == BEAR ? colBear   : color.gray

emaWord(float e) => close > e ? "Bullish" : "Bearish"
emaCol(float e)  => close > e ? colBull   : colBear

if showDash and barstate.islast
    table.cell(dash, 0, 0, "STRUCTURE MAP", text_color = dashText, text_size = dashTextSize,
         text_halign = text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.new(dashText, 40),
         text_size = dashTextSize, text_halign = text.align_right)

    dashRow(1,  "Swing trend",   trendWord(swTrend), trendCol(swTrend))
    dashRow(2,  "Internal",      trendWord(inTrend), trendCol(inTrend))
    dashRow(3,  "HTF bias",      trendWord(htfBias) + " " + htfBiasTf, trendCol(htfBias))
    dashRow(4,  "Last event",    lastEvent, lastEventCol)
    dashRow(5,  "Session",       sessionName, sLunch ? color.gray : sPower or sDrive ? colAccent : dashText)
    dashRow(6,  "RSI " + str.tostring(rsiLen),
         str.tostring(rsiVal, "#.#") + (rsiVal >= rsiOB ? "  OB" : rsiVal <= rsiOS ? "  OS" : ""),
         rsiVal >= rsiOB or rsiVal <= rsiOS ? colAccent : rsiVal > 50 ? colBull : colBear)
    dashRow(7,  "MACD",          macdBull ? "Bullish" : "Bearish", macdBull ? colBull : colBear)
    dashRow(8,  "EMA " + str.tostring(emaLen1), emaWord(ema1), emaCol(ema1))
    dashRow(9,  "EMA " + str.tostring(emaLen2), emaWord(ema2), emaCol(ema2))
    dashRow(10, "EMA " + str.tostring(emaLen3), emaWord(ema3), emaCol(ema3))
    dashRow(11, "VWAP",          na(vwapVal) ? "no volume" : close > vwapVal ? "Bullish" : "Bearish",
         na(vwapVal) ? color.gray : close > vwapVal ? colBull : colBear)
    dashRow(12, "Overnight gap", gapState, gapFilled ? color.new(dashText, 40) : colAccent)
    dashRow(13, "Opening range", na(orbHigh) ? "n/a" : str.tostring(orbLow, format.mintick) + " - " +
         str.tostring(orbHigh, format.mintick), color.new(dashText, 20))
    dashRow(14, "Live OBs",      str.tostring(obAligned) + " aligned", color.new(dashText, 20))
    dashRow(15, "Live FVGs",     str.tostring(fvgAligned) + " aligned", color.new(dashText, 20))
    dashRow(16, "Conditions met", str.tostring(confMet) + " of " + str.tostring(confTotal),
         confMet >= 6 ? colBull : confMet <= 3 ? colBear : color.new(dashText, 20))

// =====================================================================================================================
//  ALERTS
// =====================================================================================================================
alertcondition(aBullBOS,   "Bullish BOS",          "Bullish break of structure")
alertcondition(aBearBOS,   "Bearish BOS",          "Bearish break of structure")
alertcondition(aBullCHoCH, "Bullish CHoCH",        "Bullish change of character")
alertcondition(aBearCHoCH, "Bearish CHoCH",        "Bearish change of character")
alertcondition(aGapFill,   "Overnight Gap Filled", "Price has traded back through the previous close")