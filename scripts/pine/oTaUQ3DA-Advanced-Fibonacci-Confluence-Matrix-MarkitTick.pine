//@version=6
indicator("Advanced Fibonacci Confluence Matrix [MarkitTick]", overlay = true, max_lines_count = 500, max_labels_count = 300, max_boxes_count = 50)

// ═══════════════════════════════════════════════════
// USER-DEFINED TYPES & ARCHITECTURE
// ═══════════════════════════════════════════════════

type FibLevel
    float   ratio           
    string  label           
    color   col   
    int     lineStyle       
    int     lineWidth
    bool    isActive        

type SwingAnchor
    float   hi              
    float   lo              
    int     hiBar           
    int     loBar   
    int     hiTime
    int     loTime
    bool    isDownMove      

type OTEState
    bool    inZone          
    bool    justEntered     
    bool    justExited      
    float   zoneHi          
    float   zoneLo        
    int     touchCount
    bool    hasPrimeFVG     

type HTFData
    float   hi              
    float   lo              
    bool    isDownMove      
    float   fib236
    float   fib382
    float   fib500
    float   fib618
    float   fib786
    float   smc620
    float   smc705
    float   smc790

type DashState
    string  direction       
    string  oteStatus       
    int     touchCount
    float   confluenceScore 
    bool    htfAligned
    bool    mssConfirmed   

// ═══════════════════════════════════════════════════
// INPUTS & CONFIGURATION
// ═══════════════════════════════════════════════════

var string GRP_CORE = "⚙️ Core Settings"
bool showIndicatorfib = input.bool(true,  "Show Fibonacci Levels",       group = GRP_CORE)
string fibMode        = input.string("Classic Fibs", "Fibonacci Mode", options = ["Classic Fibs", "SMC OTE Levels"], group = GRP_CORE)
bool reverseFibs      = input.bool(false, "Reverse Fib Levels (Flip 0/1)", group = GRP_CORE)
int lookback          = input.int(50,  "Swing Lookback Period", minval = 5, maxval = 200, group = GRP_CORE)
int pivotLen          = input.int(50,   "Pivot Detection Length", minval = 5, maxval = 200, group = GRP_CORE)

var string GRP_SMART = "🧠 Smart Money & Filters"
bool opt_mss          = input.bool(false, "Require Market Structure Shift (MSS)", group = GRP_SMART)
bool opt_fvg          = input.bool(false, "Detect FVG inside OTE (Prime Entry)",  group = GRP_SMART)
bool opt_vol          = input.bool(false, "Volume-Validated Anchors",             group = GRP_SMART)

var string GRP_EXT = "📐 Fibonacci Extensions"
bool showExtensions   = input.bool(false,  "Show Extension Levels",    group = GRP_EXT)
bool showExt1272      = input.bool(true,  "Show 1.272",               group = GRP_EXT)
bool showExt1618      = input.bool(true,  "Show 1.618",               group = GRP_EXT)
bool showExt2000      = input.bool(false, "Show 2.000",               group = GRP_EXT)

var string GRP_HTF = "🔭 HTF Fibonacci Overlay"
bool showHTF          = input.bool(true,  "Show HTF Fibonacci",       group = GRP_HTF)
string htfTimeframe   = input.timeframe("D", "HTF Timeframe",         group = GRP_HTF)

var string GRP_CON = "🤝 Confluence Engine (CTF & HTF)"
bool showConfluence   = input.bool(true,  "Highlight Confluence Zones",   group = GRP_CON)
float confTolerance   = input.float(0.15, "Confluence Tolerance %", minval = 0.01, step = 0.01, group = GRP_CON)

var string GRP_OTE = "🎯 OTE Zone Engine"
bool showOTEZone      = input.bool(true,  "Show OTE Zone",            group = GRP_OTE)

var string GRP_DASH = "📊 Institutional Dashboard"
bool showDashboard    = input.bool(true,  "Show Dashboard",           group = GRP_DASH)
string dashPos        = input.string("Top Right", "Dashboard Position", options = ["Top Right","Top Left","Bottom Right","Bottom Left"], group = GRP_DASH)

var string GRP_COL = "🎨 Colors"
color c_highlow       = input.color(color.gray,              "High/Low Lines",      group = GRP_COL)
color c_gold          = input.color(color.orange,            "Golden Level",        group = GRP_COL)
color c_purple        = input.color(color.purple,            "Secondary Fibs",      group = GRP_COL)
color c_yellow        = input.color(color.yellow,            "Mid Fibs (0.382/0.5)",group = GRP_COL)
color c_ote           = input.color(#00BCD4,                 "Sweet Spot (0.705)",  group = GRP_COL)
color c_ext           = input.color(color.new(#FF6B6B, 0),   "Extension Levels",    group = GRP_COL)
color c_confBox       = input.color(color.new(color.white, 85), "Confluence Box Color", group = GRP_COL)
color c_confText      = input.color(color.white, "Confluence Text Color", group = GRP_COL)

var string GRP_ALT = "🔔 Alerts & Webhooks"
bool enableAlerts             = input.bool(true,  "Enable Alerts",            group = GRP_ALT)
bool opt_risk                 = input.bool(false, "Calculate Position Size",  group = GRP_ALT)
float risk_pct                = input.float(1.0,  "Risk Per Trade (%)",       group = GRP_ALT)
float acc_size                = input.float(10000,"Account Size ($)",         group = GRP_ALT)
string webhookAction_Long     = input.string("long",       "Webhook: Long Action",  group = GRP_ALT)
string webhookAction_Short    = input.string("short",      "Webhook: Short Action", group = GRP_ALT)
string webhookAction_Close    = input.string("closelong",  "Webhook: Close Action", group = GRP_ALT)

// ═══════════════════════════════════════════════════
// GLOBAL FILTERS & PIPELINE
// ═══════════════════════════════════════════════════

float vol_ma = ta.sma(volume, 20)
bool vol_ok = opt_vol ? (volume > vol_ma) : true

f_pivotHigh(series float src, series bool v_ok, simple int leftLen, simple int rightLen) =>
    float candidate = src[rightLen]
    bool  isValid   = true
    if na(candidate)
        isValid := false
    else
        for i = 0 to leftLen + rightLen
            if i != rightLen and src[i] >= candidate
                isValid := false
    (isValid and v_ok[rightLen]) ? candidate : na

f_pivotLow(series float src, series bool v_ok, simple int leftLen, simple int rightLen) =>
    float candidate = src[rightLen]
    bool  isValid   = true
    if na(candidate)
        isValid := false
    else
        for i = 0 to leftLen + rightLen
            if i != rightLen and src[i] <= candidate
                isValid := false
    (isValid and v_ok[rightLen]) ? candidate : na

// ═══════════════════════════════════════════════════
// SWING ANCHOR ENGINE (Trailing Structure)
// ═══════════════════════════════════════════════════

var SwingAnchor anchor = SwingAnchor.new(na, na, 0, 0, 0, 0, false)

float rollingHi = ta.highest(high, lookback)
float rollingLo = ta.lowest(low,   lookback)

float ph = f_pivotHigh(high, vol_ok, pivotLen, 0)
float pl = f_pivotLow(low,   vol_ok, pivotLen, 0)

if na(anchor.hi) or na(anchor.lo)
    anchor.hi         := rollingHi
    anchor.hiBar      := bar_index - lookback
    anchor.hiTime     := bar_index >= lookback ? time[lookback] : time
    anchor.lo         := rollingLo
    anchor.loBar      := bar_index - lookback
    anchor.loTime     := bar_index >= lookback ? time[lookback] : time
    anchor.isDownMove := anchor.loBar > anchor.hiBar

if anchor.isDownMove
    if close > anchor.hi
        anchor.isDownMove := false
else
    if close < anchor.lo
        anchor.isDownMove := true

if not na(ph)
    anchor.hi    := ph
    anchor.hiBar := bar_index
    anchor.hiTime:= time

if not na(pl)
    anchor.lo    := pl
    anchor.loBar := bar_index
    anchor.loTime:= time

float swingRange = anchor.hi - anchor.lo

// ═══════════════════════════════════════════════════
// HTF DATA PIPELINE (Strict Anti-Repaint)
// ═══════════════════════════════════════════════════

f_htfHigh() => ta.highest(high, lookback)
f_htfLow()  => ta.lowest(low,   lookback)

float htfHi = request.security(syminfo.tickerid, htfTimeframe, f_htfHigh()[1], lookahead = barmerge.lookahead_on)
float htfLo = request.security(syminfo.tickerid, htfTimeframe, f_htfLow()[1],  lookahead = barmerge.lookahead_on)

float htfPH = request.security(syminfo.tickerid, htfTimeframe, f_pivotHigh(high, true, pivotLen, 0)[1], lookahead = barmerge.lookahead_on)
float htfPL = request.security(syminfo.tickerid, htfTimeframe, f_pivotLow(low,   true, pivotLen, 0)[1], lookahead = barmerge.lookahead_on)

var HTFData htf = HTFData.new(na, na, false, na, na, na, na, na, na, na, na)

if not na(htfHi)
    htf.hi := htfHi
if not na(htfLo)
    htf.lo := htfLo

var int htfHiBar = 0
var int htfLoBar = 0

if not na(htfPH)
    htfHiBar := bar_index
if not na(htfPL)
    htfLoBar := bar_index

htf.isDownMove := htfLoBar > htfHiBar
float htfRange = htf.hi - htf.lo

bool htfIsDown = reverseFibs ? not htf.isDownMove : htf.isDownMove

htf.fib236 := htfIsDown ? htf.lo + htfRange * 0.236 : htf.hi - htfRange * 0.236
htf.fib382 := htfIsDown ? htf.lo + htfRange * 0.382 : htf.hi - htfRange * 0.382
htf.fib500 := htfIsDown ? htf.lo + htfRange * 0.500 : htf.hi - htfRange * 0.500
htf.fib618 := htfIsDown ? htf.lo + htfRange * 0.618 : htf.hi - htfRange * 0.618
htf.fib786 := htfIsDown ? htf.lo + htfRange * 0.786 : htf.hi - htfRange * 0.786

htf.smc620 := htfIsDown ? htf.lo + htfRange * 0.620 : htf.hi - htfRange * 0.620
htf.smc705 := htfIsDown ? htf.lo + htfRange * 0.705 : htf.hi - htfRange * 0.705
htf.smc790 := htfIsDown ? htf.lo + htfRange * 0.790 : htf.hi - htfRange * 0.790

// ═══════════════════════════════════════════════════
// DYNAMIC FIBONACCI RATIO MATRIX
// ═══════════════════════════════════════════════════

bool isSMC = fibMode == "SMC OTE Levels"

f_fibPrice(float ratio) =>
    if na(ratio)
        na
    else
        bool isDown = reverseFibs ? not anchor.isDownMove : anchor.isDownMove
        isDown ? anchor.lo + swingRange * ratio : anchor.hi - swingRange * ratio

bool isDownDir = reverseFibs ? not anchor.isDownMove : anchor.isDownMove

float fib_0    = isDownDir ? anchor.lo : anchor.hi
float fib_100  = isDownDir ? anchor.hi : anchor.lo

float fib_236  = f_fibPrice(0.236)
float fib_382  = f_fibPrice(0.382)
float fib_500  = f_fibPrice(0.500)
float fib_618  = f_fibPrice(0.618)
float fib_786  = f_fibPrice(0.786)

float smc_620  = f_fibPrice(0.620)
float smc_705  = f_fibPrice(0.705)
float smc_790  = f_fibPrice(0.790)

float ext_1272 = showExt1272 ? f_fibPrice(1.272) : na
float ext_1618 = showExt1618 ? f_fibPrice(1.618) : na
float ext_2000 = showExt2000 ? f_fibPrice(2.000) : na

array<float>  ctfPrices = isSMC ? array.from(smc_620, smc_705, smc_790) : array.from(fib_236, fib_382, fib_500, fib_618, fib_786)
array<string> ctfNames  = isSMC ? array.from("0.620", "0.705", "0.790") : array.from("0.236", "0.382", "0.500", "0.618", "0.786")

array<float>  htfPrices = isSMC ? array.from(htf.smc620, htf.smc705, htf.smc790) : array.from(htf.fib236, htf.fib382, htf.fib500, htf.fib618, htf.fib786)
array<string> htfNames  = isSMC ? array.from("0.620", "0.705", "0.790") : array.from("0.236", "0.382", "0.500", "0.618", "0.786")

// ═══════════════════════════════════════════════════
// OTE ZONE ENGINE & SMART FILTERS
// ═══════════════════════════════════════════════════

var OTEState ote = OTEState.new(false, false, false, na, na, 0, false)

ote.zoneHi := isSMC ? math.max(smc_790, smc_620) : math.max(fib_786, fib_618)
ote.zoneLo := isSMC ? math.min(smc_790, smc_620) : math.min(fib_786, fib_618)

bool priceInZone = close[1] >= ote.zoneLo and close[1] <= ote.zoneHi
bool wasInZone   = ote.inZone

ote.justEntered := priceInZone and not wasInZone
ote.justExited  := not priceInZone and wasInZone
ote.inZone      := priceInZone

if ote.justEntered
    ote.touchCount += 1

bool hasFVG = false
if opt_fvg and priceInZone
    for i = 1 to 10
        bool bullGap = low[i] > high[i+2]
        bool bearGap = high[i] < low[i+2]
    
        if bullGap and not anchor.isDownMove
            if high[i+2] <= ote.zoneHi and low[i] >= ote.zoneLo
                hasFVG := true
        if bearGap and anchor.isDownMove
            if low[i+2] >= ote.zoneLo and high[i] <= ote.zoneHi
                hasFVG := true
ote.hasPrimeFVG := hasFVG

bool isMSS = false
if opt_mss
    isMSS := anchor.isDownMove ? close < anchor.lo : close > anchor.hi

float proxThresh = close[1] * 0.0015
f_near(float lvl) => not na(lvl) and math.abs(close[1] - lvl) <= proxThresh

int confluenceCount = 0
int maxConfluence   = (isSMC ? 3 : 5) + 1 

for i = 0 to array.size(ctfPrices) - 1
    if f_near(array.get(ctfPrices, i))
        confluenceCount += 1

float primaryHTF = isSMC ? htf.smc705 : htf.fib618
if f_near(primaryHTF)
    confluenceCount += 1

float confluenceScore = confluenceCount / maxConfluence
bool htfAligned = htf.isDownMove == anchor.isDownMove

var DashState dash = DashState.new("—", "—", 0, 0.0, false, false)

dash.direction       := anchor.isDownMove ? "Bearish ▼" : "Bullish ▲"
dash.oteStatus       := ote.inZone ? (opt_fvg and ote.hasPrimeFVG ? "★ Prime OTE" : "● In OTE") : close[1] > ote.zoneHi ? "↑ Above OTE" : "↓ Below OTE"
dash.touchCount      := ote.touchCount
dash.confluenceScore := confluenceScore
dash.htfAligned      := htfAligned
dash.mssConfirmed    := isMSS

// ═══════════════════════════════════════════════════
// VISUALIZATION ENGINE 
// ═══════════════════════════════════════════════════

var line[]  a_lines  = array.new_line()
var label[] a_labels = array.new_label()
var box[]   a_boxes  = array.new_box()

var table dashTable = table.new(
     dashPos == "Top Right" ? position.top_right : 
     dashPos == "Top Left" ? position.top_left : 
     dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left, 
     2, 6, bgcolor = color.new(color.black, 80), border_color = color.gray, border_width = 1)

if array.size(a_lines) > 0
    for i = 0 to array.size(a_lines) - 1
        line.delete(array.get(a_lines, i))
array.clear(a_lines)

if array.size(a_labels) > 0
    for i = 0 to array.size(a_labels) - 1
        label.delete(array.get(a_labels, i))
array.clear(a_labels)

if array.size(a_boxes) > 0
    for i = 0 to array.size(a_boxes) - 1
        box.delete(array.get(a_boxes, i))
array.clear(a_boxes)

int startTime = math.min(anchor.hiTime, anchor.loTime)

f_drawLvl(float px, color c, string txt) =>
    if not na(px)
        array.push(a_lines,  line.new(startTime, px, time, px, xloc = xloc.bar_time, color = c))
        array.push(a_labels, label.new(time, px, txt, xloc = xloc.bar_time, textcolor = c, color = color.new(color.black, 100), style = label.style_label_left))

if showIndicatorfib
    f_drawLvl(fib_0,   c_highlow, "0.000")
    f_drawLvl(fib_100, c_highlow, "1.000")
    
    if isSMC
        f_drawLvl(smc_620, c_gold,   "0.620")
        f_drawLvl(smc_705, c_ote,    "0.705")
        f_drawLvl(smc_790, c_purple, "0.790")
    else
        f_drawLvl(fib_236, c_purple, "0.236")
        f_drawLvl(fib_382, c_yellow, "0.382")
        f_drawLvl(fib_500, c_yellow, "0.500")
        f_drawLvl(fib_618, c_gold,   "0.618")
        f_drawLvl(fib_786, c_purple, "0.786")
    
    if showExtensions
        f_drawLvl(ext_1272, c_ext, "1.272")
        f_drawLvl(ext_1618, c_ext, "1.618")
        f_drawLvl(ext_2000, c_ext, "2.000")

if showOTEZone and not na(ote.zoneHi)
    array.push(a_boxes, box.new(startTime, ote.zoneHi, time, ote.zoneLo, xloc = xloc.bar_time, border_color = na, bgcolor = color.new(c_ote, 85)))

if showConfluence and showHTF
    float tol = close[1] * (confTolerance / 100)
    int midTime = int(startTime + (time - startTime) / 2)

    for i = 0 to array.size(ctfPrices) - 1
        float cPrice = array.get(ctfPrices, i)
        string cName = array.get(ctfNames, i)
        for j = 0 to array.size(htfPrices) - 1
            float hPrice = array.get(htfPrices, j)
            string hName = array.get(htfNames, j)
            
            if not na(cPrice) and not na(hPrice)
                if math.abs(cPrice - hPrice) <= tol
                    float top = math.max(cPrice, hPrice)
                    float bot = math.min(cPrice, hPrice)
                    float midY = (top + bot) / 2
                    string lblTxt = "CTF " + cName + " + HTF " + hName
                    
                    array.push(a_boxes, box.new(startTime, top, time, bot, xloc = xloc.bar_time, border_color = na, bgcolor = c_confBox))
                    array.push(a_labels, label.new(midTime, midY, lblTxt, xloc = xloc.bar_time, textcolor = c_confText, style = label.style_none, size = size.small))

if showDashboard
    table.cell(dashTable, 0, 0, "Direction", text_color = color.white)
    table.cell(dashTable, 1, 0, dash.direction, text_color = anchor.isDownMove ? color.red : color.green)
    
    table.cell(dashTable, 0, 1, "OTE Status", text_color = color.white)
    table.cell(dashTable, 1, 1, dash.oteStatus, text_color = ote.inZone ? c_ote : color.gray)
    
    table.cell(dashTable, 0, 2, "Confluence", text_color = color.white)
    table.cell(dashTable, 1, 2, str.tostring(dash.confluenceScore * 100, "#.1") + "%", text_color = color.yellow)
    
    table.cell(dashTable, 0, 3, "HTF Aligned", text_color = color.white)
    table.cell(dashTable, 1, 3, dash.htfAligned ? "YES" : "NO", text_color = dash.htfAligned ? color.green : color.red)
    
    if opt_mss
        table.cell(dashTable, 0, 4, "MSS Valid", text_color = color.white)
        table.cell(dashTable, 1, 4, dash.mssConfirmed ? "YES" : "NO", text_color = dash.mssConfirmed ? color.green : color.red)

// ═══════════════════════════════════════════════════
// STRICT JSON WEBHOOK ALERTS & DYNAMIC RISK
// ═══════════════════════════════════════════════════

bool longEntry  = dash.direction == "Bullish ▲" and ote.justEntered
bool shortEntry = dash.direction == "Bearish ▼" and ote.justEntered
bool closeLong  = dash.direction == "Bullish ▲" and close[1] < anchor.lo
bool closeShort = dash.direction == "Bearish ▼" and close[1] > anchor.hi

float entryPx = close[1]
float slPx    = anchor.isDownMove ? anchor.hi : anchor.lo
float tpPx    = anchor.isDownMove ? anchor.lo : anchor.hi
float dist    = math.abs(entryPx - slPx)

float riskAmt = acc_size * (risk_pct / 100)
float qtyCalc = (opt_risk and dist > 0) ? (riskAmt / dist) : 1.0

string jsonTemp = '"action": "{0}", "ticker": "{1}", "price": "{2}", "sl": "{3}", "tp": "{4}", "qty": "{5}"'

if enableAlerts and barstate.isconfirmed
    string pxStr  = str.tostring(entryPx, format.mintick)
    string qtyStr = str.tostring(qtyCalc, "#.###")
    
    if longEntry
        string slStr = str.tostring(slPx, format.mintick)
        string tpStr = str.tostring(tpPx, format.mintick)
        string inner = str.format(jsonTemp, webhookAction_Long, syminfo.tickerid, pxStr, slStr, tpStr, qtyStr)
        alert("{" + inner + "}", alert.freq_once_per_bar_close)

    if shortEntry
        string slStr = str.tostring(slPx, format.mintick)
        string tpStr = str.tostring(tpPx, format.mintick)
        string inner = str.format(jsonTemp, webhookAction_Short, syminfo.tickerid, pxStr, slStr, tpStr, qtyStr)
        alert("{" + inner + "}", alert.freq_once_per_bar_close)

    if closeLong
        string inner = str.format(jsonTemp, webhookAction_Close, syminfo.tickerid, pxStr, "0", "0", "0")
        alert("{" + inner + "}", alert.freq_once_per_bar_close)
        
    if closeShort
        string inner = str.format(jsonTemp, webhookAction_Close, syminfo.tickerid, pxStr, "0", "0", "0")
        alert("{" + inner + "}", alert.freq_once_per_bar_close)