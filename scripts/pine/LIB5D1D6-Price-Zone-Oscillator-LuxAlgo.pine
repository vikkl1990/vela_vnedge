//@version=6
indicator("Price Zone Oscillator", "Price Zone Oscillator", overlay = false, format = format.price, precision = 2)
//---------------------------------------------------------------------------------------------------------------------}
// Constants
//---------------------------------------------------------------------------------------------------------------------{
BULL_COLOR  = #089981
BEAR_COLOR  = #f23645
LEVEL_COLOR = #787b86

FILL_VALUE_TRANSP   = 50
FILL_CENTER_TRANSP  = 100
NEUTRAL_FILL_TRANSP = 90

PCT_SCALE = 100

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
lengthInput = input.int(14, "Length", minval = 1, group = "Settings", tooltip = "Period of the exponential moving averages applied to both the signed close series and the raw close series. Khalil and Steckler's default is 14, shorter lengths make the zones trip more often with more noise, longer lengths suit position trading but delay zone crossings.")

sourceInput = input.source(close, "Source", group = "Settings", tooltip = "Series the oscillator is computed on, the original definition uses the close. Each bar counts positive when this series rises above its prior value and negative otherwise, an unchanged value counts negative, so a string of small up closes weighs as strongly as a few large ones.")

obLevelInput = input.float(60, "Overbought Level", minval = 0, maxval = 100, step = 1, group = "Levels", tooltip = "Reading beyond which the oscillator flags a stretched upside condition, +60 in the authors' work. Used for profit taking or countertrend fades mainly in range-bound markets, strong trends can hold extreme readings for long stretches.")

osLevelInput = input.float(-60, "Oversold Level", minval = -100, maxval = 0, step = 1, group = "Levels", tooltip = "Reading beyond which the oscillator flags a stretched downside condition, -60 in the authors' work. Used for profit taking or countertrend fades mainly in range-bound markets, strong trends can hold extreme readings for long stretches.")

bullThresholdInput = input.float(40, "Bullish Threshold", minval = 0, maxval = 100, step = 1, group = "Levels", tooltip = "Level the authors described as marking significant bullish directional pressure, +40. A push above it indicates persistently up closes. The fixed zone levels were calibrated on the authors' test markets and deserve verification on the instrument at hand.")

bearThresholdInput = input.float(-40, "Bearish Threshold", minval = -100, maxval = 0, step = 1, group = "Levels", tooltip = "Level the authors described as marking significant bearish directional pressure, -40. A push below it indicates persistently down closes. The fixed zone levels were calibrated on the authors' test markets and deserve verification on the instrument at hand.")

neutralUpperInput = input.float(15, "Neutral Zone Upper", minval = -100, maxval = 100, step = 1, group = "Levels", tooltip = "Upper bound of the neutral territory around zero, +15 in the authors' work. Readings inside this area carry little directional information on their own, their meaning depends on the prevailing trend, established first with a separate filter.")

neutralLowerInput = input.float(-5, "Neutral Zone Lower", minval = -100, maxval = 100, step = 1, group = "Levels", tooltip = "Lower bound of the neutral territory around zero, -5 in the authors' work. Readings inside this area carry little directional information on their own, their meaning depends on the prevailing trend, established first with a separate filter.")

//Style
bullColorInput = input.color(BULL_COLOR, "Bullish Color", group = "Style")

bearColorInput = input.color(BEAR_COLOR, "Bearish Color", group = "Style")

levelColorInput = input.color(LEVEL_COLOR, "Levels Color", group = "Style")

gradientFillInput = input.bool(true, "Gradient Fill", group = "Style")

neutralZoneInput = input.bool(true, "Neutral Zone Fill", group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Calculations
//---------------------------------------------------------------------------------------------------------------------{
//Sign each bar's close by its direction of change, up closes keep their value, down or unchanged closes count negative
//The first bar has no prior close and is treated as unchanged, following the original description
signedSource = sourceInput > nz(sourceInput[1], sourceInput) ? sourceInput : -sourceInput

//CP, exponential average of the signed close series, captures directional persistence weighted by price level and recency
cp = ta.ema(signedSource, lengthInput)

//TC, exponential average of the raw close series, normalizes the signed average by the prevailing price level
tc = ta.ema(sourceInput, lengthInput)

//Ratio in percent, oscillating around zero and theoretically bounded near +/-100, in practice rarely beyond +/-60 to +/-80
pzo = tc != 0 ? PCT_SCALE * cp / tc : na

//---------------------------------------------------------------------------------------------------------------------}
// Plots
//---------------------------------------------------------------------------------------------------------------------{
oscColor = pzo > 0 ? bullColorInput : bearColorInput

oscPlotId  = plot(pzo, "PZO", oscColor, 1)
zeroPlotId = plot(0, "Zero Anchor", color(na), editable = false, display = display.none)

//Vertical gradient fill from the zero center line to the oscillator value, fully transparent at the center
topFillColor    = gradientFillInput ? (pzo > 0 ? color.new(bullColorInput, FILL_VALUE_TRANSP) : color.new(bearColorInput, FILL_CENTER_TRANSP)) : color(na)
bottomFillColor = gradientFillInput ? (pzo > 0 ? color.new(bullColorInput, FILL_CENTER_TRANSP) : color.new(bearColorInput, FILL_VALUE_TRANSP)) : color(na)

fill(oscPlotId, zeroPlotId, top_value = math.max(pzo, 0), bottom_value = math.min(pzo, 0), top_color = topFillColor, bottom_color = bottomFillColor, title = "Oscillator Gradient")

//Interpretive zone levels, dashed overbought and oversold extremes, dotted trend thresholds and zero reference
hline(obLevelInput, "Overbought", levelColorInput, hline.style_dashed)
hline(osLevelInput, "Oversold", levelColorInput, hline.style_dashed)
hline(bullThresholdInput, "Bullish Threshold", levelColorInput, hline.style_dotted)
hline(bearThresholdInput, "Bearish Threshold", levelColorInput, hline.style_dotted)
hline(0, "Zero Line", levelColorInput, hline.style_dotted)

//Neutral territory band around zero, shaded between hidden anchor plots
neutralUpperPlotId = plot(neutralUpperInput, "Neutral Zone Upper", color(na), editable = false, display = display.none)
neutralLowerPlotId = plot(neutralLowerInput, "Neutral Zone Lower", color(na), editable = false, display = display.none)

fill(neutralUpperPlotId, neutralLowerPlotId, color = neutralZoneInput ? color.new(levelColorInput, NEUTRAL_FILL_TRANSP) : color(na), title = "Neutral Zone")

//---------------------------------------------------------------------------------------------------------------------}
// Alerts
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(ta.crossover(pzo, 0), "Bullish Zero Cross", "Price Zone Oscillator crossed above the zero line")
alertcondition(ta.crossunder(pzo, 0), "Bearish Zero Cross", "Price Zone Oscillator crossed below the zero line")
alertcondition(ta.crossover(pzo, bullThresholdInput), "Bullish Threshold Cross", "Price Zone Oscillator crossed above its bullish threshold, persistent upside pressure")
alertcondition(ta.crossunder(pzo, bearThresholdInput), "Bearish Threshold Cross", "Price Zone Oscillator crossed below its bearish threshold, persistent downside pressure")
alertcondition(ta.crossover(pzo, obLevelInput), "Overbought", "Price Zone Oscillator entered its overbought zone")
alertcondition(ta.crossunder(pzo, osLevelInput), "Oversold", "Price Zone Oscillator entered its oversold zone")
alertcondition(ta.crossunder(pzo, obLevelInput), "Overbought Fade", "Price Zone Oscillator turned back below its overbought level")
alertcondition(ta.crossover(pzo, osLevelInput), "Oversold Fade", "Price Zone Oscillator turned back above its oversold level")

//---------------------------------------------------------------------------------------------------------------------}
