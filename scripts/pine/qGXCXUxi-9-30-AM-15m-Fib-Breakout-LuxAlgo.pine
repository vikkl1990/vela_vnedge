//@version=6
indicator("9:30 AM 15m Fib Breakout", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// --- Inputs ---
timezoneInput = input.string("America/New_York", "Timezone", options = ["America/New_York", "America/Chicago", "UTC"])
atrLengthInput = input.int(14, "ATR Length")
atrMultInput = input.float(1.0, "ATR Multiplier", step = 0.1)
fibColorsInput = input.color(#f57f17, "Fib Levels Color")

// --- ATR Calculation on 15m ---
atr15 = request.security(syminfo.tickerid, "15", ta.atr(atrLengthInput))

// --- Detect 9:30 - 9:45 AM Session ---
// time() returns non-na when the bar is within the session
inSession = not na(time("15", "0930-0945", timezoneInput))
sessionStart = inSession and not inSession[1]
sessionEnd = not inSession and inSession[1]

var float sessionHigh = na
var float sessionLow = na
var float sessionOpen = na
var float sessionClose = na
var int startBarTime = na

if sessionStart
    sessionHigh := high
    sessionLow := low
    sessionOpen := open
    startBarTime := time

if inSession
    sessionHigh := math.max(sessionHigh, high)
    sessionLow := math.min(sessionLow, low)
    sessionClose := close

var box highlightBox = na
var line[] fibLines = array.new_line()
var label[] fibLabels = array.new_label()

if sessionEnd
    candleRange = sessionHigh - sessionLow
    // Check if candle breaks ATR
    if candleRange > atr15[1] * atrMultInput
        y = year(startBarTime, timezoneInput)
        m = month(startBarTime, timezoneInput)
        d = dayofmonth(startBarTime, timezoneInput)
        middayTime = timestamp(timezoneInput, y, m, d, 12, 0, 0)
        
        boxColor = sessionClose > sessionOpen ? color.new(#089981, 80) : color.new(#f23645, 80)
        boxBorder = sessionClose > sessionOpen ? color.new(#089981, 40) : color.new(#f23645, 40)
        
        highlightBox := box.new(left = startBarTime, top = sessionHigh, right = time[1], bottom = sessionLow, xloc = xloc.bar_time, border_color = boxBorder, border_width = 1, border_style = line.style_solid, bgcolor = boxColor)
        
        fibLevels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
        isBullish = sessionClose > sessionOpen
        
        for fib in fibLevels
            levelPrice = isBullish ? sessionLow + candleRange * fib : sessionHigh - candleRange * fib
            
            levelColor = fibColorsInput
            if fib == 0.0 or fib == 1.0
                levelColor := color.new(color.gray, 50)
            else if fib == 0.5
                levelColor := color.new(#ff9800, 0)
            else if fib == 0.618
                levelColor := color.new(#ffb74d, 0)
            else if fib == 0.382
                levelColor := color.new(#f44336, 0)
                
            fibLine = line.new(x1 = time[1], y1 = levelPrice, x2 = middayTime, y2 = levelPrice, xloc = xloc.bar_time, extend = extend.none, color = levelColor, style = line.style_solid, width = 1)
            fibLabel = label.new(x = middayTime, y = levelPrice, text = str.tostring(fib * 100, "#.##") + "%", xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_left, textcolor = levelColor, size = size.small)
            
            array.push(fibLines, fibLine)
            array.push(fibLabels, fibLabel)

if array.size(fibLines) > 400
    line.delete(array.shift(fibLines))
    label.delete(array.shift(fibLabels))
