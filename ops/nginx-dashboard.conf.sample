# Sample site for the dashboard. The bot listens on 127.0.0.1:8787.
# Replace the server name and certificate paths before using this file.
#
# X-Forwarded-For is only the address nginx itself saw. The app reads the rightmost
# entry, so a client-supplied list must not be forwarded.
server {
  listen 443 ssl;
  server_name vnedge.example;

  # ssl_certificate     /etc/ssl/vnedge.crt;
  # ssl_certificate_key /etc/ssl/vnedge.key;

  # First-run administrator setup is reachable only through the SSH tunnel.
  location = /api/auth/setup {
    return 403;
  }

  location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }
}
